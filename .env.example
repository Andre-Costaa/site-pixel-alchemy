# ============================================================
# Pixel Alchemy — Variaveis de Ambiente (EXEMPLO)
# ============================================================
# Copie este arquivo para .env e preencha com seus valores Reais.
# NUNCA faca commit do .env (ja esta no .gitignore).
#
# Como obter cada token:
#   NOTION_API_TOKEN    -> https://www.notion.so/my-integrations
#   NOTION_DATABASE_ID  -> ID do banco Notion (ultimos 32 chars da URL)
#   SERP_API_KEY        -> https://serper.dev (50k credits)
#   GITHUB_PAT          -> GitHub Settings > Developer settings > Personal access tokens
#   VERCEL_TOKEN        -> https://vercel.com/account/tokens
#   TELEGRAM_BOT_TOKEN  -> @BotFather no Telegram
#   TELEGRAM_CHAT_ID    -> @userinfobot no Telegram
#   MAILGUN_API_KEY     -> https://app.mailgun.com/settings/api
#   WHATSAPP_BRIDGE_URL -> URL do seu WhatsApp bridge (baileys/baileys-http)
# ============================================================

# --- Notion ---
NOTION_API_TOKEN=COLAR_TOKEN_AQUI_OBTENHA_EM_notion.so/my-integrations
NOTION_DATABASE_ID=2f76f51e-b8a5-8088-a52c-db29fc3c1f81

# --- SERP (Google Search API - 50k credits) ---
SERP_API_KEY=COLAR_API_KEY_AQUI_OBTENHA_EM_serper.dev

# --- GitHub ---
GITHUB_PAT=ghp_COLAR_TOKEN_AQUI

# --- Vercel ---
VERCEL_TOKEN=vcp_COLAR_TOKEN_AQUI

# --- Telegram (para notificacoes) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=1297935135

# --- Mailgun (email outreach) ---
MAILGUN_API_KEY=COLAR_API_KEY_AQUI
MAILGUN_DOMAIN=mg.pixelalchemy.com.br

# --- WhatsApp Bridge (opcional - se usar automacao WhatsApp) ---
WHATSAPP_BRIDGE_URL=http://localhost:8080
