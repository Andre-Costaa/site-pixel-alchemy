   366→            font-size: 1.15rem;\n   367→            color: var(--color-charcoal-light);\n   368→            margin-bottom: 2.5rem;\n   369→            max-width: 500px;\n   370→            animation: fade-up 1s ease-out 0.6s both;\n   371→        }\n   372→\n   373→        .hero-ctas {\n   374→            display: flex;\n   375→            gap: 1rem;\n   376→            flex-wrap: wrap;\n   377→            animation: fade-up 1s ease-out 0.8s both;\n   378→        }\n   379→\n   380→        .btn {\n   381→            display: inline-flex;\n   382→            align-items: center;\n   383→            gap: 0.5rem;\n   384→            padding: 1rem 2rem;\n   385→            border-radius: var(--radius-pill);\n   386→            font-weight: 600;\n   387→            font-size: 1rem;\n   388→            cursor: pointer;\n   389→            transition: all var(--transition-fast);\n   390→            border: none;\n   391→            position: relative;\n   392→            overflow: hidden;\n   393→        }\n   394→\n   395→        .btn-primary {\n   396→            background: var(--color-rose);\n   397→            color: white;\n   398→            box-shadow: var(--shadow-soft);\n   399→        }\n   400→\n   401→        .btn-primary:hover {\n   402→            background: var(--color-rose-dark);\n   403→            transform: translateY(-3px);\n   404→            box-shadow: var(--shadow-floating);\n   405→        }\n   406→\n   407→        .btn-secondary {\n   408→            background: transparent;\n   409→            color: var(--color-charcoal);\n   410→            border: 2px solid var(--color-taupe);\n   411→        }\n   412→\n   413→        .btn-secondary:hover {\n   414→            background: var(--color-rose);\n   415→            color: white;\n   416→            border-color: var(--color-rose);\n   417→            transform: translateY(-3px);\n   418→        }\n   419→\n   420→        .btn svg {\n   421→            width: 18px;\n   422→            hei