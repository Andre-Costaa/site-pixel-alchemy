{"type":"assistant","message":{"id":"msg_202602090032586c09148b805c4de5","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"text","text":"Now I'll create the complete site with the Amber & Bronze Noir aesthetic - a warm, sophisticated palette with amber tones, bronze accents on ivory backgrounds, using distinctive \"flame\" shapes for the blobmorphism."}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"d28f2741-3a2f-4bf2-9cc0-f2a7092fb23d","uuid":"901d67a8-6b22-491c-9aa1-1362840c4b8d"}
{"type":"assistant","message":{"id":"msg_202602090032586c09148b805c4de5","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_5f3c373e5aaf4aa0afbd4d13","name":"Write","input":{"file_path":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-nayara-nubia/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Nayara Nubia | Harmonização Facial e Estética Avançada em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Nayara Nubia - Especialista em harmonização facial e estética avançada em Ribeirão Preto. Transforme sua beleza natural com tratamentos personalizados. Agende: (16) 99302-4664\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ========================================\n           CSS VARIABLES & ROOT STYLES\n        ======================================== */\n        :root {\n            /* Colors - Amber & Bronze Noir Palette */\n            --color-amber: #D48A3A;\n            --color-amber-light: #E5A856;\n            --color-amber-dark: #B86F1A;\n            --color-amber-glow: #F5C87A;\n            --color-amber-mist: #FFF5E8;\n            --color-bronze: #A67C42;\n            --color-bronze-light: #C49A5C;\n            --color-bronze-dark: #8B5E2A;\n            --color-ivory: #FAF7F2;\n            --color-ivory-warm: #F5F0E8;\n            --color-cream: #F8F3EB;\n            --color-charcoal: #1A1A1A;\n            --color-charcoal-light: #4A4A4A;\n            --color-taupe: #7A7570;\n            --color-taupe-light: #9A958F;\n\n            /* Gradients */\n            --gradient-amber: linear-gradient(135deg, #D48A3A 0%, #E5A856 100%);\n            --gradient-amber-soft: linear-gradient(135deg, #F5C87A 0%, #FFF5E8 100%);\n            --gradient-bronze: linear-gradient(135deg, #A67C42 0%, #C49A5C 100%);\n            --gradient-golden: linear-gradient(135deg, #D48A3A 0%, #C49A5C 100%);\n            --gradient-fade: linear-gradient(180deg, rgba(250,247,242,0) 0%, rgba(250,247,242,1) 100%);\n            --gradient-warm: linear-gradient(135deg, #FFF5E8 0%, #F8F3EB 100%);\n\n            /* Typography */\n            --font-display: 'Crimson Pro', Georgia, serif;\n            --font-body: 'DM Sans', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n            --spacing-xxl: 8rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 16px;\n            --radius-lg: 24px;\n            --radius-pill: 100px;\n            --radius-flame: 65% 35% 45% 55% / 55% 45% 55% 45%;\n            --radius-flame-2: 45% 55% 65% 35% / 35% 65% 45% 55%;\n            --radius-flame-3: 55% 45% 35% 65% / 65% 35% 55% 45%;\n\n            /* Shadows */\n            --shadow-soft: 0 8px 32px rgba(212, 138, 58, 0.15);\n            --shadow-glow: 0 8px 48px rgba(212, 138, 58, 0.25);\n            --shadow-elegant: 0 16px 64px rgba(26, 26, 26, 0.08);\n            --shadow-floating: 0 20px 60px rgba(212, 138, 58, 0.2);\n\n            /* Transitions */\n            --transition-fast: 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-base: 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-slow: 0.8s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n\n        /* ========================================\n           RESET & BASE STYLES\n        ======================================== */\n        *, *::before, *::after {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        html {\n            scroll-behavior: smooth;\n            font-size: 16px;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background: var(--color-ivory);\n            color: var(--color-charcoal);\n            line-height: 1.7;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        img {\n            max-width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-fast);\n        }\n\n        ul {\n            list-style: none;\n        }\n\n        /* ========================================\n           TYPOGRAPHY\n        ======================================== */\n        h1, h2, h3, h4 {\n            font-family: var(--font-display);\n            font-weight: 500;\n            line-height: 1.2;\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 8vw, 5rem);\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 5vw, 3.5rem);\n            letter-spacing: -0.01em;\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 3vw, 2rem);\n        }\n\n        .text-amber { color: var(--color-amber); }\n        .text-bronze { color: var(--color-bronze); }\n\n        /* ========================================\n           NAVIGATION\n        ======================================== */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            background: rgba(250, 247, 242, 0.95);\n            backdrop-filter: blur(20px);\n            z-index: 1000;\n            transition: transform var(--transition-base);\n            box-shadow: 0 1px 0 rgba(212, 138, 58, 0.1);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 1rem 2rem;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            color: var(--color-charcoal);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: 2rem;\n            align-items: center;\n        }\n\n        .nav-link {\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-charcoal-light);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-amber);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.75rem 1.5rem;\n            background: var(--color-amber);\n            color: white;\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: all var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            background: var(--color-amber-dark);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .mobile-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            cursor: pointer;\n            padding: 5px;\n        }\n\n        .mobile-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-charcoal);\n            transition: var(--transition-fast);\n        }\n\n        /* ========================================\n           HERO SECTION\n        ======================================== */\n        .hero {\n            position: relative;\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            overflow: hidden;\n            background: var(--gradient-warm);\n        }\n\n        .hero-flames {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            overflow: hidden;\n            z-index: 1;\n        }\n\n        .flame {\n            position: absolute;\n            border-radius: var(--radius-flame);\n            filter: blur(60px);\n            opacity: 0.5;\n            animation: flame-flicker 18s ease-in-out infinite;\n        }\n\n        .flame-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-amber);\n            top: -10%;\n            right: -5%;\n            animation-delay: 0s;\n        }\n\n        .flame-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-amber-soft);\n            bottom: -5%;\n            left: -10%;\n            animation-delay: -5s;\n            border-radius: var(--radius-flame-2);\n        }\n\n        .flame-3 {\n            width: 350px;\n            height: 350px;\n            background: var(--gradient-bronze);\n            top: 40%;\n            left: 30%;\n            animation-delay: -10s;\n            opacity: 0.35;\n            border-radius: var(--radius-flame-3);\n        }\n\n        .flame-4 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(135deg, #F5C87A 0%, #FFF5E8 100%);\n            bottom: 20%;\n            right: 20%;\n            animation-delay: -15s;\n            opacity: 0.25;\n            border-radius: var(--radius-flame);\n        }\n\n        @keyframes flame-flicker {\n            0%, 100% {\n                transform: translate(0, 0) scale(1) rotate(0deg);\n            }\n            25% {\n                transform: translate(30px, -30px) scale(1.05) rotate(5deg);\n            }\n            50% {\n                transform: translate(-20px, 20px) scale(0.95) rotate(-5deg);\n            }\n            75% {\n                transform: translate(-30px, -20px) scale(1.02) rotate(3deg);\n            }\n        }\n\n        .hero-container {\n            position: relative;\n            z-index: 10;\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 6rem 2rem 4rem;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: center;\n        }\n\n        .hero-content {\n            animation: fade-up 1s ease-out;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 0.5rem 1rem;\n            background: rgba(212, 138, 58, 0.15);\n            border-radius: var(--radius-pill);\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-amber);\n            margin-bottom: 1.5rem;\n            animation: fade-up 1s ease-out 0.2s both;\n        }\n\n        .hero-badge svg {\n            width: 16px;\n            height: 16px;\n        }\n\n        .hero-title {\n            color: var(--color-charcoal);\n            margin-bottom: 1.5rem;\n            animation: fade-up 1s ease-out 0.4s both;\n        }\n\n        .hero-title span {\n            color: var(--color-amber);\n        }\n\n        .hero-description {\n            font-size: 1.15rem;\n            color: var(--color-charcoal-light);\n            margin-bottom: 2.5rem;\n            max-width: 500px;\n            animation: fade-up 1s ease-out 0.6s both;\n        }\n\n        .hero-ctas {\n            display: flex;\n            gap: 1rem;\n            flex-wrap: wrap;\n            animation: fade-up 1s ease-out 0.8s both;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: all var(--transition-fast);\n            border: none;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .btn-primary {\n            background: var(--color-amber);\n            color: white;\n            box-shadow: var(--shadow-soft);\n        }\n\n        .btn-primary:hover {\n            background: var(--color-amber-dark);\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-floating);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-charcoal);\n            border: 2px solid var(--color-taupe);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-amber);\n            color: white;\n            border-color: var(--color-amber);\n            transform: translateY(-3px);\n        }\n\n        .btn svg {\n            width: 18px;\n            height: 18px;\n        }\n\n        .hero-image {\n            position: relative;\n            animation: fade-up 1s ease-out 0.4s both;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            border-radius: var(--radius-lg);\n            overflow: hidden;\n            box-shadow: var(--shadow-elegant);\n        }\n\n        .hero-image-wrapper::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            background: var(--gradient-amber);\n            opacity: 0.15;\n            z-index: 1;\n        }\n\n        .hero-image img {\n            width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        .hero-floating-card {\n            position: absolute;\n            background: white;\n            padding: 1rem 1.5rem;\n            border-radius: var(--radius-md);\n            box-shadow: var(--shadow-floating);\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n            z-index: 10;\n            animation: card-float 6s ease-in-out infinite;\n        }\n\n        .hero-floating-card.card-1 {\n            top: 10%;\n            left: -20px;\n        }\n\n        .hero-floating-card.card-2 {\n            bottom: 15%;\n            right: -20px;\n            animation-delay: -3s;\n        }\n\n        .card-icon {\n            width: 40px;\n            height: 40px;\n            background: var(--gradient-amber);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n        }\n\n        .card-icon svg {\n            width: 20px;\n            height: 20px;\n            color: white;\n        }\n\n        .card-text {\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-charcoal);\n        }\n\n        @keyframes card-float {\n            0%, 100% {\n                transform: translateY(0);\n            }\n            50% {\n                transform: translateY(-15px);\n            }\n        }\n\n        @keyframes fade-up {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        /* ========================================\n           PROBLEM/SOLUTION SECTION\n        ======================================== */\n        .problem-solution {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-ivory);\n        }\n\n        .problem-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .problem-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .problem-header h2 {\n            color: var(--color-charcoal);\n            margin-bottom: 1rem;\n        }\n\n        .problem-header p {\n            font-size: 1.1rem;\n            color: var(--color-charcoal-light);\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        .problem-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 2rem;\n        }\n\n        .problem-card {\n            background: white;\n            padding: 2rem;\n            border-radius: var(--radius-lg);\n            border-left: 4px solid var(--color-taupe);\n            transition: all var(--transition-base);\n        }\n\n        .problem-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-elegant);\n            border-left-color: var(--color-amber);\n        }\n\n        .problem-card.solution {\n            background: var(--gradient-amber);\n            border-left-color: transparent;\n        }\n\n        .problem-card.solution h3,\n        .problem-card.solution p {\n            color: white;\n        }\n\n        .problem-card h3 {\n            margin-bottom: 1rem;\n            display: flex;\n            align-items: center;\n            gap: 0.75rem;\n        }\n\n        .problem-card h3 svg {\n            width: 24px;\n            height: 24px;\n            color: var(--color-amber);\n        }\n\n        .problem-card.solution h3 svg {\n            color: white;\n        }\n\n        .problem-card p {\n            color: var(--color-charcoal-light);\n            line-height: 1.8;\n        }\n\n        /* ========================================\n           SERVICES SECTION\n        ======================================== */\n        .services {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-cream);\n        }\n\n        .services-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .section-header h2 {\n            color: var(--color-charcoal);\n            margin-bottom: 1rem;\n        }\n\n        .section-header p {\n            font-size: 1.1rem;\n            color: var(--color-charcoal-light);\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .service-card {\n            background: white;\n            padding: 2rem;\n            border-radius: var(--radius-lg);\n            text-align: center;\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-amber);\n            transform: scaleX(0);\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-elegant);\n        }\n\n        .service-icon {\n            width: 70px;\n            height: 70px;\n            margin: 0 auto 1.5rem;\n            background: var(--gradient-amber-soft);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .service-icon svg {\n            width: 32px;\n            height: 32px;\n            color: var(--color-amber);\n        }\n\n        .service-card h3 {\n            margin-bottom: 1rem;\n            color: var(--color-charcoal);\n        }\n\n        .service-card p {\n            color: var(--color-charcoal-light);\n            font-size: 0.95rem;\n            line-height: 1.7;\n        }\n\n        /* ========================================\n           TESTIMONIALS SECTION\n        ======================================== */\n        .testimonials {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--gradient-amber);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .testimonials::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            opacity: 0.1;\n            background-image: url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.4'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\");\n        }\n\n        .testimonials-container {\n            position: relative;\n            z-index: 2;\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .testimonials-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .testimonials-header h2 {\n            color: white;\n            margin-bottom: 1rem;\n        }\n\n        .testimonials-header p {\n            font-size: 1.1rem;\n            color: rgba(255, 255, 255, 0.9);\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.95);\n            padding: 2rem;\n            border-radius: var(--radius-lg);\n            text-align: center;\n        }\n\n        .testimonial-stars {\n            display: flex;\n            justify-content: center;\n            gap: 0.25rem;\n            margin-bottom: 1rem;\n        }\n\n        .testimonial-stars svg {\n            width: 18px;\n            height: 18px;\n            color: var(--color-amber);\n        }\n\n        .testimonial-text {\n            font-style: italic;\n            color: var(--color-charcoal-light);\n            margin-bottom: 1.5rem;\n            line-height: 1.8;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-amber);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-weight: 600;\n            font-family: var(--font-display);\n        }\n\n        .testimonial-info h4 {\n            font-size: 1rem;\n            color: var(--color-charcoal);\n            margin-bottom: 0.25rem;\n        }\n\n        .testimonial-info p {\n            font-size: 0.85rem;\n            color: var(--color-taupe);\n        }\n\n        /* ========================================\n           DIFFERENTIALS SECTION\n        ======================================== */\n        .differentials {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-ivory);\n        }\n\n        .differentials-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .differential-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n            padding: 1.5rem;\n            background: white;\n            border-radius: var(--radius-md);\n            transition: all var(--transition-base);\n        }\n\n        .differential-item:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-elegant);\n        }\n\n        .differential-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-amber-soft);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n            position: relative;\n        }\n\n        .differential-icon::before {\n            content: '';\n            position: absolute;\n            top: -4px;\n            left: -4px;\n            right: -4px;\n            bottom: -4px;\n            border-radius: 50%;\n            border: 2px solid var(--color-amber);\n            opacity: 0;\n            animation: pulse-ring 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse-ring {\n            0% {\n                transform: scale(1);\n                opacity: 0.5;\n            }\n            100% {\n                transform: scale(1.3);\n                opacity: 0;\n            }\n        }\n\n        .differential-icon svg {\n            width: 24px;\n            height: 24px;\n            color: var(--color-amber);\n        }\n\n        .differential-content h3 {\n            font-size: 1.1rem;\n            color: var(--color-charcoal);\n            margin-bottom: 0.5rem;\n        }\n\n        .differential-content p {\n            font-size: 0.9rem;\n            color: var(--color-charcoal-light);\n            line-height: 1.6;\n        }\n\n        /* ========================================\n           CONTACT SECTION\n        ======================================== */\n        .contact {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-cream);\n        }\n\n        .contact-container {\n            max-width: 1000px;\n            margin: 0 auto;\n        }\n\n        .contact-wrapper {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            background: white;\n            border-radius: var(--radius-lg);\n            overflow: hidden;\n            box-shadow: var(--shadow-elegant);\n        }\n\n        .contact-info {\n            background: var(--gradient-amber);\n            padding: 3rem;\n            color: white;\n        }\n\n        .contact-info h3 {\n            color: white;\n            margin-bottom: 1.5rem;\n            font-size: 1.8rem;\n        }\n\n        .contact-info p {\n            margin-bottom: 2rem;\n            opacity: 0.95;\n        }\n\n        .contact-details {\n            display: flex;\n            flex-direction: column;\n            gap: 1.5rem;\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .contact-item-icon {\n            width: 45px;\n            height: 45px;\n            background: rgba(255, 255, 255, 0.2);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .contact-item-icon svg {\n            width: 20px;\n            height: 20px;\n            color: white;\n        }\n\n        .contact-item-text h4 {\n            font-size: 0.9rem;\n            font-weight: 600;\n            margin-bottom: 0.25rem;\n        }\n\n        .contact-item-text p {\n            font-size: 0.9rem;\n            margin-bottom: 0;\n            opacity: 0.95;\n        }\n\n        .contact-form {\n            padding: 3rem;\n        }\n\n        .contact-form h3 {\n            color: var(--color-charcoal);\n            margin-bottom: 1.5rem;\n            font-size: 1.8rem;\n        }\n\n        .form-group {\n            margin-bottom: 1.5rem;\n        }\n\n        .form-label {\n            display: block;\n            font-weight: 500;\n            color: var(--color-charcoal);\n            margin-bottom: 0.5rem;\n        }\n\n        .form-input,\n        .form-select,\n        .form-textarea {\n            width: 100%;\n            padding: 0.875rem 1rem;\n            border: 2px solid var(--color-taupe-light);\n            border-radius: var(--radius-sm);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            color: var(--color-charcoal);\n            transition: all var(--transition-fast);\n            background: white;\n        }\n\n        .form-input:focus,\n        .form-select:focus,\n        .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-amber);\n            box-shadow: 0 0 0 3px rgba(212, 138, 58, 0.15);\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1rem 2rem;\n            background: var(--color-amber);\n            color: white;\n            border: none;\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: all var(--transition-fast);\n        }\n\n        .form-submit:hover {\n            background: var(--color-amber-dark);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-soft);\n        }\n\n        /* ========================================\n           FOOTER\n        ======================================== */\n        .footer {\n            background: var(--color-charcoal);\n            color: white;\n            padding: 3rem 2rem;\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: 3rem;\n            margin-bottom: 2rem;\n        }\n\n        .footer-brand h4 {\n            font-size: 1.5rem;\n            margin-bottom: 1rem;\n        }\n\n        .footer-brand p {\n            color: var(--color-taupe-light);\n            font-size: 0.9rem;\n            line-height: 1.7;\n        }\n\n        .footer-links h5 {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 600;\n            margin-bottom: 1rem;\n            text-transform: uppercase;\n            letter-spacing: 0.05em;\n        }\n\n        .footer-links ul {\n            display: flex;\n            flex-direction: column;\n            gap: 0.5rem;\n        }\n\n        .footer-links a {\n            color: var(--color-taupe-light);\n            font-size: 0.9rem;\n        }\n\n        .footer-links a:hover {\n            color: var(--color-amber);\n        }\n\n        .footer-bottom {\n            padding-top: 2rem;\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            text-align: center;\n        }\n\n        .footer-bottom p {\n            color: var(--color-taupe);\n            font-size: 0.85rem;\n        }\n\n        /* ========================================\n           SCROLL ANIMATIONS\n        ======================================== */\n        .wow {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: all 0.8s ease-out;\n        }\n\n        .wow.wow-visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(40px);\n            transition: all 0.8s ease-out;\n        }\n\n        .wow-fade-up.wow-visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        /* ========================================\n           RESPONSIVE DESIGN\n        ======================================== */\n        @media (max-width: 1024px) {\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-ctas {\n                justify-content: center;\n            }\n\n            .hero-floating-card {\n                display: none;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .contact-wrapper {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-content {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                display: none;\n            }\n\n            .mobile-toggle {\n                display: flex;\n            }\n\n            .problem-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .contact-form,\n            .contact-info {\n                padding: 2rem;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .hero-ctas {\n                flex-direction: column;\n            }\n\n            .btn {\n                width: 100%;\n                justify-content: center;\n            }\n        }\n\n        /* ========================================\n           ACCESSIBILITY\n        ======================================== */\n        @media (prefers-reduced-motion: reduce) {\n            *,\n            *::before,\n            *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        .btn:focus-visible,\n        .nav-link:focus-visible,\n        .form-input:focus-visible,\n        .form-select:focus-visible,\n        .form-textarea:focus-visible {\n            outline: 3px solid var(--color-amber);\n            outline-offset: 2px;\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Nayara Nubia</a>\n            <div class=\"nav-menu\">\n                <a href=\"#servicos\" class=\"nav-link\">Serviços</a>\n                <a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a>\n                <a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a>\n                <a href=\"#contato\" class=\"nav-cta\">Agendar Consulta</a>\n            </div>\n            <div class=\"mobile-toggle\" id=\"mobileToggle\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-flames\">\n            <div class=\"flame flame-1\"></div>\n            <div class=\"flame flame-2\"></div>\n            <div class=\"flame flame-3\"></div>\n            <div class=\"flame flame-4\"></div>\n        </div>\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n                        <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                    </svg>\n                    Estética Avançada em Ribeirão Preto\n                </div>\n                <h1 class=\"hero-title\">\n                    Harmonização Facial que Realça sua <span class=\"text-amber\">Beleza Natural</span>\n                </h1>\n                <p class=\"hero-description\">\n                    Transforme sua autoestima com tratamentos personalizados de harmonização facial e estética avançada. Resultados naturais e seguros com a Dra. Nayara Nubia.\n                </p>\n                <div class=\"hero-ctas\">\n                    <a href=\"#contato\" class=\"btn btn-primary\">\n                        Agendar Consulta\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\"/>\n                        </svg>\n                    </a>\n                    <a href=\"#servicos\" class=\"btn btn-secondary\">\n                        Conhecer Serviços\n                    </a>\n                </div>\n            </div>\n            <div class=\"hero-image\">\n                <div class=\"hero-image-wrapper\">\n                    <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=800&q=80\" alt=\"Dra. Nayara Nubia - Harmonização Facial\">\n                </div>\n                <div class=\"hero-floating-card card-1\">\n                    <div class=\"card-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 13l4 4L19 7\"/>\n                        </svg>\n                    </div>\n                    <div class=\"card-text\">+5.000<br>Atendimentos</div>\n                </div>\n                <div class=\"hero-floating-card card-2\">\n                    <div class=\"card-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"card-text\">Satisfação<br>Garantida</div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"problem-solution\">\n        <div class=\"problem-container\">\n            <div class=\"problem-header wow-fade-up\">\n                <h2>Sua Beleza Natural Potencializada</h2>\n                <p>Compreendemos suas preocupações e oferecemos soluções que realçam seus traços únicos</p>\n            </div>\n            <div class=\"problem-grid\">\n                <div class=\"problem-card wow-fade-up\" style=\"animation-delay: 0.2s\">\n                    <h3>\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"/>\n                        </svg>\n                        O Desafio\n                    </h3>\n                    <p>Sinais de envelhecimento, perda de volume facial e assimetrias podem afetar sua autoestima. Muitas pessoas buscam soluções que proporcionem resultados naturais sem perder sua identidade.</p>\n                </div>\n                <div class=\"problem-card solution wow-fade-up\" style=\"animation-delay: 0.4s\">\n                    <h3>\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"/>\n                        </svg>\n                        A Solução\n                    </h3>\n                    <p>Protocolos personalizados de harmonização facial que respeitam sua anatomia e realçam sua beleza natural. Técnicas avançadas com resultados sutis e elegantes.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"services\" id=\"servicos\">\n        <div class=\"services-container\">\n            <div class=\"section-header wow-fade-up\">\n                <h2>Tratamentos Especializados</h2>\n                <p>Procedimentos estéticos avançados para realçar sua beleza natural</p>\n            </div>\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\" style=\"animation-delay: 0.1s\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"/>\n                        </svg>\n                    </div>\n                    <h3>Harmonização Facial</h3>\n                    <p>Equilíbrio dos traços faciais com técnicas avançadas para resultados naturais e harmônicos</p>\n                </div>\n                <div class=\"service-card wow-fade-up\" style=\"animation-delay: 0.2s\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z\"/>\n                        </svg>\n                    </div>\n                    <h3>Toxina Botulínica</h3>\n                    <p>Suavização de rugas e linhas de expressão com aplicação precisa e natural</p>\n                </div>\n                <div class=\"service-card wow-fade-up\" style=\"animation-delay: 0.3s\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4\"/>\n                        </svg>\n                    </div>\n                    <h3>Preenchedores Faciais</h3>\n                    <p>Restauração de volume e contorno facial com ácido hialurônico de alta qualidade</p>\n                </div>\n                <div class=\"service-card wow-fade-up\" style=\"animation-delay: 0.4s\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z\"/>\n                        </svg>\n                    </div>\n                    <h3>Preenchimento Labial</h3>\n                    <p>Contorno e volume labial com técnicas que preservam a naturalidade</p>\n                </div>\n                <div class=\"service-card wow-fade-up\" style=\"animation-delay: 0.5s\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z\"/>\n                        </svg>\n                    </div>\n                    <h3>Bioestimuladores</h3>\n                    <p>Estímulo de colágeno para rejuvenescimento progressivo e duradouro</p>\n                </div>\n                <div class=\"service-card wow-fade-up\" style=\"animation-delay: 0.6s\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z\"/>\n                        </svg>\n                    </div>\n                    <h3>Protocolos Exclusivos</h3>\n                    <p>Tratamentos personalizados desenvolvidos para suas necessidades específicas</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"testimonials\" id=\"depoimentos\">\n        <div class=\"testimonials-container\"