{"type":"assistant","message":{"id":"msg_20260209030738867ee210f23944b6","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_ef5484f5cff04d1db0883dae","name":"Write","input":{"file_path":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-isabelle-marchi-rinomodelacao-estruturada/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Isabelle Marchi | Rinomodelação Estruturada em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Isabelle Marchi - Rinomodelação estruturada especializada em Ribeirão Preto. Atendimento personalizado com técnicas avançadas de harmonização nasal.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           CSS VARIABLES - Platinum Noir & Rose Gold\n           ============================================ */\n        :root {\n            /* Primary Palette - Platinum Metallic */\n            --color-platinum: #B8B8C0;\n            --color-platinum-light: #C8C8D0;\n            --color-platinum-mid: #D8D8E0;\n            --color-platinum-dark: #A8A8B0;\n            --color-platinum-deep: #888890;\n            --color-platinum-shimmer: #E8E8F0;\n\n            /* Accent Palette - Rose Gold */\n            --color-rose-gold: #C9A088;\n            --color-rose-gold-light: #D9B098;\n            --color-rose-gold-mid: #E0C0A8;\n            --color-rose-gold-dark: #B89078;\n            --color-rose-gold-deep: #A87860;\n            --color-rose-gold-shimmer: #E8D0C0;\n\n            /* Dark Palette - Soft Noir */\n            --color-noir: #1A1A1A;\n            --color-noir-charcoal: #2A2A2A;\n            --color-noir-deep: #0F0F12;\n\n            /* Warmth Accent - Alabaster */\n            --color-alabaster: #FAFAF8;\n            --color-alabaster-warm: #F5F5F2;\n            --color-cream: #F0ECE8;\n\n            /* Text Colors */\n            --color-text-primary: #1A1A1A;\n            --color-text-secondary: #4A4A4A;\n            --color-text-muted: #7A7A7A;\n            --color-text-on-dark: #F5F5F2;\n\n            /* Gradients */\n            --gradient-platinum: linear-gradient(135deg, var(--color-platinum) 0%, var(--color-platinum-light) 100%);\n            --gradient-rose-gold: linear-gradient(135deg, var(--color-rose-gold) 0%, var(--color-rose-gold-light) 100%);\n            --gradient-noir: linear-gradient(135deg, var(--color-noir) 0%, var(--color-noir-charcoal) 100%);\n            --gradient-hero: linear-gradient(135deg, #FAFAF8 0%, #F0ECE8 50%, #E8E4E0 100%);\n            --gradient-platinum-rose: linear-gradient(135deg, var(--color-platinum) 0%, var(--color-rose-gold) 100%);\n\n            /* Structural Border Radius Shapes - Nasal Architecture */\n            --radius-struct-1: 68% 32% 48% 52% / 52% 38% 62% 48%;\n            --radius-struct-2: 48% 52% 68% 32% / 38% 62% 38% 62%;\n            --radius-struct-3: 62% 38% 42% 58% / 58% 42% 52% 48%;\n            --radius-struct-4: 38% 62% 52% 48% / 42% 58% 48% 52%;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Typography */\n            --font-display: 'Libre Baskerville', Georgia, serif;\n            --font-body: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(26, 26, 26, 0.08);\n            --shadow-medium: 0 8px 30px rgba(26, 26, 26, 0.12);\n            --shadow-strong: 0 12px 40px rgba(26, 26, 26, 0.16);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.7;\n            color: var(--color-text-primary);\n            background: var(--color-alabaster);\n            overflow-x: hidden;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-noir);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-secondary);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-sm) var(--spacing-md);\n            background: rgba(250, 250, 248, 0.95);\n            backdrop-filter: blur(20px);\n            transition: transform 0.3s ease;\n            box-shadow: 0 2px 20px rgba(26, 26, 26, 0.06);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-noir);\n            text-decoration: none;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-secondary);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-platinum-rose);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover {\n            color: var(--color-noir);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--gradient-rose-gold);\n            color: white !important;\n            padding: 0.75rem 1.5rem;\n            border-radius: 50px;\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 8px 20px rgba(201, 160, 136, 0.3);\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-noir);\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-struct-1);\n            opacity: 0.15;\n            filter: blur(60px);\n            animation: float 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-platinum);\n            top: -200px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .blob-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-rose-gold);\n            bottom: -150px;\n            left: -100px;\n            animation-delay: -5s;\n            border-radius: var(--radius-struct-2);\n        }\n\n        .blob-3 {\n            width: 300px;\n            height: 300px;\n            background: var(--gradient-platinum-rose);\n            top: 50%;\n            left: 20%;\n            animation-delay: -10s;\n            border-radius: var(--radius-struct-3);\n            opacity: 0.1;\n        }\n\n        .blob-4 {\n            width: 250px;\n            height: 250px;\n            background: linear-gradient(135deg, var(--color-platinum-light) 0%, var(--color-rose-gold-light) 100%);\n            bottom: 20%;\n            right: 15%;\n            animation-delay: -15s;\n            border-radius: var(--radius-struct-4);\n            opacity: 0.12;\n        }\n\n        @keyframes float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg) scale(1.05);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg) scale(0.95);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(3deg) scale(1.02);\n            }\n        }\n\n        .hero-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            position: relative;\n            z-index: 10;\n        }\n\n        .hero-content {\n            text-align: center;\n            max-width: 800px;\n            margin: 0 auto;\n        }\n\n        .hero-badge {\n            display: inline-block;\n            background: var(--gradient-rose-gold);\n            color: white;\n            padding: 0.5rem 1.5rem;\n            border-radius: 50px;\n            font-size: 0.85rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-md);\n            text-transform: uppercase;\n            letter-spacing: 0.1em;\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            color: var(--color-noir);\n        }\n\n        .hero-title span {\n            background: var(--gradient-platinum-rose);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-description {\n            font-size: clamp(1.1rem, 2vw, 1.3rem);\n            color: var(--color-text-secondary);\n            margin-bottom: var(--spacing-lg);\n            line-height: 1.8;\n        }\n\n        .hero-cta {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            background: var(--gradient-rose-gold);\n            color: white;\n            padding: 1rem 2.5rem;\n            border-radius: 50px;\n            font-size: 1.1rem;\n            font-weight: 600;\n            text-decoration: none;\n            transition: all var(--transition-base);\n            box-shadow: 0 4px 15px rgba(201, 160, 136, 0.3);\n        }\n\n        .hero-cta:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 8px 25px rgba(201, 160, 136, 0.4);\n        }\n\n        .hero-secondary {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-noir);\n            padding: 1rem 2rem;\n            font-size: 1.1rem;\n            font-weight: 600;\n            text-decoration: none;\n            margin-left: var(--spacing-sm);\n            transition: color var(--transition-fast);\n        }\n\n        .hero-secondary:hover {\n            color: var(--color-rose-gold);\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-alabaster);\n        }\n\n        .section-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-xl);\n        }\n\n        .section-label {\n            display: inline-block;\n            color: var(--color-rose-gold);\n            font-size: 0.85rem;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 0.15em;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: var(--spacing-md);\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .problem-card, .solution-card {\n            background: white;\n            padding: var(--spacing-md);\n            border-radius: 20px;\n            border-left: 4px solid var(--color-rose-gold);\n            box-shadow: var(--shadow-soft);\n            transition: all var(--transition-base);\n        }\n\n        .solution-card {\n            background: var(--color-noir);\n            border-left-color: var(--color-platinum);\n        }\n\n        .solution-card h3,\n        .solution-card p {\n            color: var(--color-text-on-dark);\n        }\n\n        .problem-card:hover,\n        .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .card-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-rose-gold);\n            border-radius: 12px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .solution-card .card-icon {\n            background: var(--gradient-platinum);\n        }\n\n        .card-icon svg {\n            width: 24px;\n            height: 24px;\n            fill: white;\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-cream);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .service-card {\n            background: var(--color-alabaster);\n            padding: var(--spacing-md);\n            border-radius: 24px;\n            box-shadow: var(--shadow-soft);\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-platinum-rose);\n            opacity: 0;\n            transition: opacity var(--transition-fast);\n        }\n\n        .service-card:hover::before {\n            opacity: 1;\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-strong);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-rose-gold);\n            border-radius: 16px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-icon svg {\n            width: 28px;\n            height: 28px;\n            fill: white;\n        }\n\n        .service-title {\n            font-size: 1.4rem;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-noir);\n        }\n\n        .service-description {\n            color: var(--color-text-secondary);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-rose-gold);\n            text-decoration: none;\n            font-weight: 600;\n            transition: gap var(--transition-fast);\n        }\n\n        .service-link:hover {\n            gap: 0.75rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-noir);\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonials h2,\n        .testimonials h3,\n        .testimonials p {\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .testimonial-card {\n            background: var(--color-noir-charcoal);\n            padding: var(--spacing-md);\n            border-radius: 24px;\n            box-shadow: var(--shadow-medium);\n            transition: all var(--transition-base);\n        }\n\n        .testimonial-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-strong);\n        }\n\n        .testimonial-stars {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .testimonial-stars svg {\n            width: 20px;\n            height: 20px;\n            fill: var(--color-rose-gold);\n        }\n\n        .testimonial-text {\n            font-size: 1.05rem;\n            line-height: 1.8;\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: var(--gradient-platinum-rose);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 700;\n            color: white;\n        }\n\n        .testimonial-info h4 {\n            font-size: 1rem;\n            margin-bottom: 0.2rem;\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonial-info span {\n            font-size: 0.85rem;\n            color: var(--color-platinum-light);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-alabaster);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            width: 80px;\n            height: 80px;\n            margin: 0 auto var(--spacing-sm);\n        }\n\n        .differential-icon {\n            width: 80px;\n            height: 80px;\n            background: var(--gradient-rose-gold);\n            border-radius: 20px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            z-index: 2;\n        }\n\n        .differential-icon svg {\n            width: 36px;\n            height: 36px;\n            fill: white;\n        }\n\n        .differential-icon-ring {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 80px;\n            height: 80px;\n            border: 2px solid var(--color-rose-gold);\n            border-radius: 20px;\n            animation: pulse-ring 2s ease-in-out infinite;\n            z-index: 1;\n        }\n\n        @keyframes pulse-ring {\n            0%, 100% {\n                transform: translate(-50%, -50%) scale(1);\n                opacity: 1;\n            }\n            50% {\n                transform: translate(-50%, -50%) scale(1.2);\n                opacity: 0;\n            }\n        }\n\n        .differential-title {\n            font-size: 1.2rem;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-noir);\n        }\n\n        .differential-description {\n            font-size: 0.95rem;\n            color: var(--color-text-secondary);\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-cream);\n        }\n\n        .contact-container {\n            max-width: 800px;\n            margin: 0 auto;\n        }\n\n        .contact-card {\n            background: var(--color-alabaster);\n            padding: var(--spacing-lg);\n            border-radius: 30px;\n            box-shadow: var(--shadow-strong);\n        }\n\n        .contact-info {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-md);\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-sm);\n        }\n\n        .contact-item-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-platinum-rose);\n            border-radius: 12px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n        }\n\n        .contact-item-icon svg {\n            width: 24px;\n            height: 24px;\n            fill: white;\n        }\n\n        .contact-item-content h4 {\n            font-size: 1rem;\n            margin-bottom: 0.3rem;\n            color: var(--color-noir);\n        }\n\n        .contact-item-content p {\n            font-size: 0.9rem;\n            color: var(--color-text-secondary);\n        }\n\n        .contact-form {\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-sm);\n        }\n\n        .form-row {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-sm);\n        }\n\n        .form-group {\n            display: flex;\n            flex-direction: column;\n            gap: 0.5rem;\n        }\n\n        .form-group label {\n            font-size: 0.9rem;\n            font-weight: 600;\n            color: var(--color-noir);\n        }\n\n        .form-group input,\n        .form-group select,\n        .form-group textarea {\n            padding: 1rem;\n            border: 2px solid var(--color-platinum-dark);\n            border-radius: 12px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: all var(--transition-fast);\n            background: white;\n        }\n\n        .form-group input:focus,\n        .form-group select:focus,\n        .form-group textarea:focus {\n            outline: none;\n            border-color: var(--color-rose-gold);\n            box-shadow: 0 0 0 4px rgba(201, 160, 136, 0.1);\n        }\n\n        .form-group textarea {\n            min-height: 150px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            background: var(--gradient-rose-gold);\n            color: white;\n            padding: 1rem 2rem;\n            border: none;\n            border-radius: 50px;\n            font-size: 1.1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all var(--transition-base);\n            box-shadow: 0 4px 15px rgba(201, 160, 136, 0.3);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 8px 25px rgba(201, 160, 136, 0.4);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            padding: var(--spacing-lg) var(--spacing-md);\n            background: var(--color-noir);\n            color: var(--color-text-on-dark);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-lg);\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .footer-section h4 {\n            font-size: 1.2rem;\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-on-dark);\n        }\n\n        .footer-section p {\n            color: var(--color-platinum-light);\n            font-size: 0.95rem;\n        }\n\n        .footer-links {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-links a {\n            color: var(--color-platinum-light);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-rose-gold);\n        }\n\n        .footer-bottom {\n            padding-top: var(--spacing-md);\n            border-top: 1px solid var(--color-noir-charcoal);\n            text-align: center;\n        }\n\n        .footer-bottom p {\n            color: var(--color-platinum-dark);\n            font-size: 0.9rem;\n        }\n\n        /* ============================================\n           ANIMATION CLASSES\n           ============================================ */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.6s ease;\n        }\n\n        .wow-fade-in.visible {\n            opacity: 1;\n        }\n\n        /* Stagger delays */\n        .delay-100 { transition-delay: 0.1s; }\n        .delay-200 { transition-delay: 0.2s; }\n        .delay-300 { transition-delay: 0.3s; }\n        .delay-400 { transition-delay: 0.4s; }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                right: 0;\n                flex-direction: column;\n                background: var(--color-alabaster);\n                padding: var(--spacing-md);\n                gap: var(--spacing-sm);\n                transform: translateY(-100%);\n                opacity: 0;\n                transition: all var(--transition-base);\n                box-shadow: var(--shadow-medium);\n            }\n\n            .nav-menu.active {\n                transform: translateY(0);\n                opacity: 1;\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n\n            .nav-cta {\n                width: 100%;\n                text-align: center;\n            }\n\n            .hero-secondary {\n                display: flex;\n                margin-top: var(--spacing-sm);\n                margin-left: 0;\n            }\n\n            .problem-solution-grid,\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .contact-info {\n                grid-template-columns: 1fr;\n            }\n\n            .form-row {\n                grid-template-columns: 1fr;\n            }\n\n            .blob-1, .blob-2, .blob-3, .blob-4 {\n                width: 200px;\n                height: 200px;\n            }\n        }\n\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Isabelle Marchi</a>\n            <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Toggle menu\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#home\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contato\" class=\"nav-link\">Contato</a></li>\n                <li><a href=\"#contato\" class=\"nav-cta\">Agendar Consulta</a></li>\n            </ul>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-blob blob-1\"></div>\n        <div class=\"hero-blob blob-2\"></div>\n        <div class=\"hero-blob blob-3\"></div>\n        <div class=\"hero-blob blob-4\"></div>\n\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <span class=\"hero-badge wow-fade-up\">Rinomodelação Estruturada</span>\n                <h1 class=\"hero-title wow-fade-up delay-100\">\n                    Harmonização Nasal com <span>Naturalidade</span> e Precisão\n                </h1>\n                <p class=\"hero-description wow-fade-up delay-200\">\n                    Transforme sua aparência com rinomodelação estruturada avançada.\n                    Resultados naturais que realçam sua beleza única sem cirurgia.\n                </p>\n                <div class=\"hero-cta-container wow-fade-up delay-300\">\n                    <a href=\"#contato\" class=\"hero-cta\">\n                        Agendar Consulta\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                    <a href=\"#servicos\" class=\"hero-secondary\">Conhecer Procedimentos</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"problem-solution\" id=\"problema-solucao\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-label\">Transformação Real</span>\n                <h2>Sua Melhor Versão</h2>\n            </div>\n\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card wow-fade-up delay-100\">\n                    <div class=\"card-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>\n                    </div>\n                    <h3>Seu Desafio</h3>\n                    <p>Insatisfação com a aparência do nariz que afeta sua autoestima e confiança, mas você busca alternativas à cirurgia plástica tradicional.</p>\n                </div>\n\n                <div class=\"solution-card wow-fade-up delay-200\">\n                    <div class=\"card-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                    </div>\n                    <h3>Nossa Solução</h3>\n                    <p>Rinomodelação estruturada com técnicas minimamente invasivas que proporcionam resultados naturais e harmoniosos, valorizando seus traços únicos.</p>\n                </div>\n\n                <div class=\"solution-card wow-fade-up delay-300\">\n                    <div class=\"card-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z\"/></svg>\n                    </div>\n                    <h3>Resultado</h3>\n                    <p>Aparência harmônica e natural com recuperação rápida, sem os riscos e tempo de recuperação da cirurgia convencional.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"services\" id=\"servicos\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-label\">Procedimentos</span>\n                <h2>Serviços Especializados</h2>\n                <p>Técnicas avançadas de rinomodelação estruturada para resultados naturais</p>\n            </div>\n\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up delay-100\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C8.69 2 6 4.69 6 8c0 2.86 1.92 5.25 4.53 5.91L12 22l1.47-8.09C16.08 13.25 18 10.86 18 8c0-3.31-2.69-6-6-6z\"/></svg>\n                    </div>\n                    <h3 class=\"service-title\">Rinomodelação Estruturada</h3>\n                    <p class=\"service-description\">Técnica avançada de remodelação nasal com preenchedores para corrigir assimetrias e harmonizar o rosto.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up delay-200\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14h-2v-4H6v-2h4V7h2v4h4v2h-4v4z\"/></svg>\n                    </div>\n                    <h3 class=\"service-title\">Harmonização Nasal</h3>\n                    <p class=\"service-description\">Procedimentos combinados para equilibrar proporcões e realçar a beleza natural do seu nariz.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up delay-300\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                    </div>\n                    <h3 class=\"service-title\">Preenchimento Nasal</h3>\n                    <p class=\"service-description\">Correção de depressões e irregularidades com ácido hialurônico de alta qualidade.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up delay-100\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M20.5 11H3.5C2.67 11 2 11.67 2 12.5v9c0 .83.67 1.5 1.5 1.5h5v-3h4v3h5c.83 0 1.5-.67 1.5-1.5v-9c0-.83-.67-1.5-1.5-1.5zM13 3v6h8v6l-2-3-2 3-2-3-2 3V3h-2z\"/></svg>\n                    </div>\n                    <h3 class=\"service-title\">Ponta Nasal</h3>\n                    <p class=\"service-description\">Refinamento e projeção da ponta nasal para um resultado mais elegante e harmonioso.</p>\n                    </div>\n\n                <div class=\"service-card wow-fade-up delay-200\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>\n                    </div>\n                    <h3 class=\"service-title\">Correção de Giba</h3>\n                    <p class=\"service-description\">Suavização da giba nasal para um perfil mais suave e natural.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up delay-300\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1zm0 13.5c-1.1-.35-2.3-.5-3.5-.5-1.7 0-4.15.65-5.5 1.5V8c1.35-.85 3.8-1.5 5.5-1.5 1.2 0 2.4.15 3.5.5v11.5z\"/></svg>\n                    </div>\n                    <h3 class=\"service-title\">Protocolos Exclusivos</h3>\n                    <p class=\"service-description\">Técnicas personalizadas desenvolvidas para resultados únicos e naturais.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"testimonials\" id=\"depoimentos\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-label\">Depoimentos</span>\n                <h2>O Que Dizem Nossas Pacientes</h2>\n                <p>Histórias reais de transformação e satisfação</p>\n            </div>\n\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up delay-100\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"Resultado incrível! A Dra. Isabelle tem mãos de fada. Meu nariz ficou perfeito, natural e eu me sinto muito mais confiante. Recomendo de olhos fechados!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Maria Clara Silva</h4>\n                            <span>Empresária, 32 anos</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up delay-200\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"Era apaixonada por fazer rinoplastia, mas tinha medo da cirurgia. A rinomodelação mudou minha vida! O resultado superou minhas expectativas.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AF</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Ana Ferreira</h4>\n                            <span>Advogada, 28 anos</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up delay-300\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"Profissional excelente! A Dra. Isabelle me explicou todo o processo, me deixou tranquila e o resultado foi exatamente como eu sonhava. Muito grata!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">JO</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Juliana Oliveira</h4>\n                            <span>Arquiteta, 35 anos</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"differentials\" id=\"diferenciais\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-label\">Por Que Nos Escolher</span>\n                <h2>Nossos Diferenciais</h2>\n                <p>Compromisso com excelência e resultados naturais</p>\n            </div>\n\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up delay-100\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>\n                        </div>\n                        <div class=\"differential-icon-ring\"></div>\n                    </div>\n                    <h3 class=\"differential-title\">Técnicas Avançadas</h3>\n                    <p class=\"differential-description\">Metodologia atualizada com as mais modernas técnicas de rinomodelação estruturada.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up delay-200\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"/></svg>\n                        </div>\n                        <div class=\"differential-icon-ring\"></div>\n                    </div>\n                    <h3 class=\"differential-title\">Atendimento Personalizado</h3>\n                    <p class=\"differential-description\">Cada paciente é única. Protocolos personalizados para suas necessidades específicas.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up delay-300\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C8.69 2 6 4.69 6 8c0 2.86 1.92 5.25 4.53 5.91L12 22l1.47-8.09C16.08 13.25 18 10.86 18 8c0-3.31-2.69-6-6-6z\"/></svg>\n                        </div>\n                        <div class=\"differential-icon-ring\"></div>\n                    </div>\n                    <h3 class=\"differential-title\">Resultados Naturais</h3>\n                    <p class=\"differential-description\">Foco em naturalidade e harmonia com seus traços faciais originais.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up delay-100\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z\"/></svg>\n                        </div>\n                        <div class=\"differential-icon-ring\"></div>\n                    </div>\n                    <h3 class=\"differential-title\">Recuperação Rápida</h3>\n                    <p class=\"differential-description\">Procedimento minimamente invasivo com retorno rápido às atividades normais.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up delay-200\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z\"/></svg>\n                        </div>\n                        <div class=\"differential-icon-ring\"></div>\n                    </div>\n                    <h3 class=\"differential-title\">Segurança Primeiro</h3>\n                    <p class=\"differential-description\">Produtos de alta qualidade e ambiente estéril para sua segurança.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up delay-300\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M20 2H4c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8 17.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 10.5 12 10.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5zm0-5.5c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z\"/></svg>\n                        </div>\n                        <div class=\"differential-icon-ring\"></div>\n                    </div>\n                    <h3 class=\"differential-title\">Acompanhamento Completo</h3>\n                    <p class=\"differential-description\">Suporte total antes, durante e depois do procedimento.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"contact\" id=\"contato\">\n        <div class=\"contact-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-label\">Agende Sua Consulta</span>\n                <h2>Entre em Contato</h2>\n                <p>Primeira avaliação gratuita para conhecer suas necessidades</p>\n            </div>\n\n            <div class=\"contact-card wow-fade-up\">\n                <div class=\"contact-info\">\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z\"/></svg>\n                        </div>\n                        <div class=\"contact-item-content\">\n                            <h4>Endereço</h4>\n                            <p>Av. Cel. Fernando Ferreira Leite, 1520 - sala 1605 - Nova Aliança, Ribeirão Preto - SP, 14026-020</p>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z\"/></svg>\n                        </div>\n                        <div class=\"contact-item-content\">\n                            <h4>Telefone</h4>\n                            <p>(16) 99179-8230</p>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z\"/></svg>\n                        </div>\n                        <div class=\"contact-item-content\">\n                            <h4>Email</h4>\n                            <p>contato@draisellemarchi.com.br</p>\n                        </div>\n                    </div>\n                </div>\n\n                <form class=\"contact-form\" id=\"contactForm\">\n                    <div class=\"form-row\">\n                        <div class=\"form-group\">\n                            <label for=\"name\">Nome completo</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" placeholder=\"Seu nome\" required>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"phone\">Telefone</label>\n                            <input type=\"tel\" id=\"phone\" name=\"phone\" placeholder=\"(00) 00000-0000\" required>\n                        </div>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label for=\"service\">Serviço de interesse</label>\n                        <select id=\"service\" name=\"service\" required>\n                            <option value=\"\">Selecione um serviço</option>\n                            <option value=\"rinomodelacao\">Rinomodelação Estruturada</option>\n                            <option value=\"harmonizacao\">Harmonização Nasal</option>\n                            <option value=\"preenchimento\">Preenchimento Nasal</option>\n                            <option value=\"ponta\">Ponta Nasal</option>\n                            <option value=\"giba\">Correção de Giba</option>\n                            <option value=\"outro\">Outro Procedimento</option>\n                        </select>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label for=\"message\">Mensagem</label>\n                        <textarea id=\"message\" name=\"message\" placeholder=\"Conte-nos sobre suas expectativas...\" required></textarea>\n                    </div>\n\n                    <button type=\"submit\" class=\"form-submit\">Agendar Consulta Gratuita</button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-section\">\n                    <h4>Dra. Isabelle Marchi</h4>\n                    <p>Rinomodelação estruturada especializada em Ribeirão Preto. Transformando vidas com resultados naturais e seguros.</p>\n                </div>\n\n                <div class=\"footer-section\">\n                    <h4>Links Rápidos</h4>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#home\">Início</a></li>\n                        <li><a href=\"#servicos\">Serviços</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                        <li><a href=\"#diferenciais\">Diferenciais</a></li>\n                        <li><a href=\"#contato\">Contato</a></li>\n                    </ul>\n                </div>\n\n                <div class=\"footer-section\">\n                    <h4>Horário de Atendimento</h4>\n                    <p>Segunda a Sexta: 9h às 18h</p>\n                    <p>Sábados: 9h às 13h</p>\n                </div>\n            </div>\n\n            <div class=\"footer-bottom\">\n                <p>&copy; 2024 Dra. Isabelle Marchi. Todos os direitos reservados | Rinomodelação Estruturada em Ribeirão Preto</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // Navigation\n        // ============================================\n        const nav = document.getElementById('nav');\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n        let lastScroll = 0;\n\n        // Auto-hide navigation on scroll\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                } else {\n                    nav.classList.remove('hidden');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Mobile menu toggle\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close menu on link click\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // Smooth Scroll\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const offset = 80;\n                    const targetPosition = target.offsetTop - offset;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // WoW Animations (Intersection Observer)\n        // ============================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('visible');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // Parallax Effect on Hero Blobs\n        // ============================================\n        const hero = document.querySelector('.hero');\n        const blobs = document.querySelectorAll('.hero-blob');\n\n        hero.addEventListener('mousemove', (e) => {\n            const x = (e.clientX / window.innerWidth - 0.5) * 2;\n            const y = (e.clientY / window.innerHeight - 0.5) * 2;\n\n            blobs.forEach((blob, index) => {\n                const speed = (index + 1) * 10;\n                blob.style.transform = `translate(${x * speed}px, ${y * speed}px)`;\n            });\n        });\n\n        // ============================================\n        // Contact Form - WhatsApp Integration\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n        const whatsappNumber = '5516991798230';\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceNames = {\n                'rinomodelacao': 'Rinomodelação Estruturada',\n                'harmonizacao': 'Harmonização Nasal',\n                'preenchimento': 'Preenchimento Nasal',\n                'ponta': 'Ponta Nasal',\n                'giba': 'Correção de Giba',\n                'outro': 'Outro Procedimento'\n            };\n\n            const whatsappMessage = `Olá Dra. Isabelle Marchi! Meu nome é ${name}.\n\nGostaria de agendar uma consulta para: ${serviceNames[service]}\n\nTelefone: ${phone}\n\nMensagem: ${message}`;\n\n            const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;\n            window.open(whatsappUrl, '_blank');\n\n            // Reset form\n            contactForm.reset();\n        });\n\n        // ============================================\n        // Initial Page Load Animations\n        // ============================================\n        window.addEventListener('load', () => {\n            document.querySelectorAll('.hero .wow-fade-up').forEach((el, index) => {\n                setTimeout(() => {\n                    el.classList.add('visible');\n                }, index * 100);\n            });\n        });\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"c28b0a14-6f5e-46c7-a152-5f0926e9e561","uuid":"2ce690ed-9f71-48e0-acb4-da6bfd61c6bb"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ef5484f5cff04d1db0883dae","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-isabelle-marchi-rinomodelacao-estruturada/index.html"}]},"parent_tool_use_id":null,"session_id":"c28b0a14-6f5e-46c7-a152-5f0926e9e561","uuid":"687aa7e0-2e0c-46e4-8768-646753d1b5d6","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-isabelle-marchi-rinomodelacao-estruturada/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Isabelle Marchi | Rinomodelação Estruturada em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Isabelle Marchi - Rinomodelação estruturada especializada em Ribeirão Preto. Atendimento personalizado com técnicas avançadas de harmonização nasal.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           CSS VARIABLES - Platinum Noir & Rose Gold\n           ============================================ */\n        :root {\n            /* Primary Palette - Platinum Metallic */\n            --color-platinum: #B8B8C0;\n            --color-platinum-light: #C8C8D0;\n            --color-platinum-mid: #D8D8E0;\n            --color-platinum-dark: #A8A8B0;\n            --color-platinum-deep: #888890;\n            --color-platinum-shimmer: #E8E8F0;\n\n            /* Accent Palette - Rose Gold */\n            --color-rose-gold: #C9A088;\n            --color-rose-gold-light: #D9B098;\n            --color-rose-gold-mid: #E0C0A8;\n            --color-rose-gold-dark: #B89078;\n            --color-rose-gold-deep: #A87860;\n            --color-rose-gold-shimmer: #E8D0C0;\n\n            /* Dark Palette - Soft Noir */\n            --color-noir: #1A1A1A;\n            --color-noir-charcoal: #2A2A2A;\n            --color-noir-deep: #0F0F12;\n\n            /* Warmth Accent - Alabaster */\n            --color-alabaster: #FAFAF8;\n            --color-alabaster-warm: #F5F5F2;\n            --color-cream: #F0ECE8;\n\n            /* Text Colors */\n            --color-text-primary: #1A1A1A;\n            --color-text-secondary: #4A4A4A;\n            --color-text-muted: #7A7A7A;\n            --color-text-on-dark: #F5F5F2;\n\n            /* Gradients */\n            --gradient-platinum: linear-gradient(135deg, var(--color-platinum) 0%, var(--color-platinum-light) 100%);\n            --gradient-rose-gold: linear-gradient(135deg, var(--color-rose-gold) 0%, var(--color-rose-gold-light) 100%);\n            --gradient-noir: linear-gradient(135deg, var(--color-noir) 0%, var(--color-noir-charcoal) 100%);\n            --gradient-hero: linear-gradient(135deg, #FAFAF8 0%, #F0ECE8 50%, #E8E4E0 100%);\n            --gradient-platinum-rose: linear-gradient(135deg, var(--color-platinum) 0%, var(--color-rose-gold) 100%);\n\n            /* Structural Border Radius Shapes - Nasal Architecture */\n            --radius-struct-1: 68% 32% 48% 52% / 52% 38% 62% 48%;\n            --radius-struct-2: 48% 52% 68% 32% / 38% 62% 38% 62%;\n            --radius-struct-3: 62% 38% 42% 58% / 58% 42% 52% 48%;\n            --radius-struct-4: 38% 62% 52% 48% / 42% 58% 48% 52%;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Typography */\n            --font-display: 'Libre Baskerville', Georgia, serif;\n            --font-body: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(26, 26, 26, 0.08);\n            --shadow-medium: 0 8px 30px rgba(26, 26, 26, 0.12);\n            --shadow-strong: 0 12px 40px rgba(26, 26, 26, 0.16);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.7;\n            color: var(--color-text-primary);\n            background: var(--color-alabaster);\n            overflow-x: hidden;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-noir);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-secondary);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-sm) var(--spacing-md);\n            background: rgba(250, 250, 248, 0.95);\n            backdrop-filter: blur(20px);\n            transition: transform 0.3s ease;\n            box-shadow: 0 2px 20px rgba(26, 26, 26, 0.06);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-noir);\n            text-decoration: none;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-secondary);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-platinum-rose);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover {\n            color: var(--color-noir);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--gradient-rose-gold);\n            color: white !important;\n            padding: 0.75rem 1.5rem;\n            border-radius: 50px;\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 8px 20px rgba(201, 160, 136, 0.3);\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-noir);\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-struct-1);\n            opacity: 0.15;\n            filter: blur(60px);\n            animation: float 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-platinum);\n            top: -200px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .blob-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-rose-gold);\n            bottom: -150px;\n            left: -100px;\n            animation-delay: -5s;\n            border-radius: var(--radius-struct-2);\n        }\n\n        .blob-3 {\n            width: 300px;\n            height: 300px;\n            background: var(--gradient-platinum-rose);\n            top: 50%;\n            left: 20%;\n            animation-delay: -10s;\n            border-radius: var(--radius-struct-3);\n            opacity: 0.1;\n        }\n\n        .blob-4 {\n            width: 250px;\n            height: 250px;\n            background: linear-gradient(135deg, var(--color-platinum-light) 0%, var(--color-rose-gold-light) 100%);\n            bottom: 20%;\n            right: 15%;\n            animation-delay: -15s;\n            border-radius: var(--radius-struct-4);\n            opacity: 0.12;\n        }\n\n        @keyframes float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg) scale(1.05);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg) scale(0.95);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(3deg) scale(1.02);\n            }\n        }\n\n        .hero-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            position: relative;\n            z-index: 10;\n        }\n\n        .hero-content {\n            text-align: center;\n            max-width: 800px;\n            margin: 0 auto;\n        }\n\n        .hero-badge {\n            display: inline-block;\n            background: var(--gradient-rose-gold);\n            color: white;\n            padding: 0.5rem 1.5rem;\n            border-radius: 50px;\n            font-size: 0.85rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-md);\n            text-transform: uppercase;\n            letter-spacing: 0.1em;\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            color: var(--color-noir);\n        }\n\n        .hero-title span {\n            background: var(--gradient-platinum-rose);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-description {\n            font-size: clamp(1.1rem, 2vw, 1.3rem);\n            color: var(--color-text-secondary);\n            margin-bottom: var(--spacing-lg);\n            line-height: 1.8;\n        }\n\n        .hero-cta {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            background: var(--gradient-rose-gold);\n            color: white;\n            padding: 1rem 2.5rem;\n            border-radius: 50px;\n            font-size: 1.1rem;\n            font-weight: 600;\n            text-decoration: none;\n            transition: all var(--transition-base);\n            box-shadow: 0 4px 15px rgba(201, 160, 136, 0.3);\n        }\n\n        .hero-cta:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 8px 25px rgba(201, 160, 136, 0.4);\n        }\n\n        .hero-secondary {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-noir);\n            padding: 1rem 2rem;\n            font-size: 1.1rem;\n            font-weight: 600;\n            text-decoration: none;\n            margin-left: var(--spacing-sm);\n            transition: color var(--transition-fast);\n        }\n\n        .hero-secondary:hover {\n            color: var(--color-rose-gold);\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-alabaster);\n        }\n\n        .section-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-xl);\n        }\n\n        .section-label {\n            display: inline-block;\n            color: var(--color-rose-gold);\n            font-size: 0.85rem;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 0.15em;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: var(--spacing-md);\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .problem-card, .solution-card {\n            background: white;\n            padding: var(--spacing-md);\n            border-radius: 20px;\n            border-left: 4px solid var(--color-rose-gold);\n            box-shadow: var(--shadow-soft);\n            transition: all var(--transition-base);\n        }\n\n        .solution-card {\n            background: var(--color-noir);\n            border-left-color: var(--color-platinum);\n        }\n\n        .solution-card h3,\n        .solution-card p {\n            color: var(--color-text-on-dark);\n        }\n\n        .problem-card:hover,\n        .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .card-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-rose-gold);\n            border-radius: 12px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .solution-card .card-icon {\n            background: var(--gradient-platinum);\n        }\n\n        .card-icon svg {\n            width: 24px;\n            height: 24px;\n            fill: white;\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-cream);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .service-card {\n            background: var(--color-alabaster);\n            padding: var(--spacing-md);\n            border-radius: 24px;\n            box-shadow: var(--shadow-soft);\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-platinum-rose);\n            opacity: 0;\n            transition: opacity var(--transition-fast);\n        }\n\n        .service-card:hover::before {\n            opacity: 1;\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-strong);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-rose-gold);\n            border-radius: 16px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-icon svg {\n            width: 28px;\n            height: 28px;\n            fill: white;\n        }\n\n        .service-title {\n            font-size: 1.4rem;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-noir);\n        }\n\n        .service-description {\n            color: var(--color-text-secondary);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-rose-gold);\n            text-decoration: none;\n            font-weight: 600;\n            transition: gap var(--transition-fast);\n        }\n\n        .service-link:hover {\n            gap: 0.75rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-noir);\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonials h2,\n        .testimonials h3,\n        .testimonials p {\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .testimonial-card {\n            background: var(--color-noir-charcoal);\n            padding: var(--spacing-md);\n            border-radius: 24px;\n            box-shadow: var(--shadow-medium);\n            transition: all var(--transition-base);\n        }\n\n        .testimonial-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-strong);\n        }\n\n        .testimonial-stars {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .testimonial-stars svg {\n            width: 20px;\n            height: 20px;\n            fill: var(--color-rose-gold);\n        }\n\n        .testimonial-text {\n            font-size: 1.05rem;\n            line-height: 1.8;\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: var(--gradient-platinum-rose);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 700;\n            color: white;\n        }\n\n        .testimonial-info h4 {\n            font-size: 1rem;\n            margin-bottom: 0.2rem;\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonial-info span {\n            font-size: 0.85rem;\n            color: var(--color-platinum-light);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-alabaster);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            width: 80px;\n            height: 80px;\n            margin: 0 auto var(--spacing-sm);\n        }\n\n        .differential-icon {\n            width: 80px;\n            height: 80px;\n            background: var(--gradient-rose-gold);\n            border-radius: 20px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            z-index: 2;\n        }\n\n        .differential-icon svg {\n            width: 36px;\n            height: 36px;\n            fill: white;\n        }\n\n        .differential-icon-ring {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 80px;\n            height: 80px;\n            border: 2px solid var(--color-rose-gold);\n            border-radius: 20px;\n            animation: pulse-ring 2s ease-in-out infinite;\n            z-index: 1;\n        }\n\n        @keyframes pulse-ring {\n            0%, 100% {\n                transform: translate(-50%, -50%) scale(1);\n                opacity: 1;\n            }\n            50% {\n                transform: translate(-50%, -50%) scale(1.2);\n                opacity: 0;\n            }\n        }\n\n        .differential-title {\n            font-size: 1.2rem;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-noir);\n        }\n\n        .differential-description {\n            font-size: 0.95rem;\n            color: var(--color-text-secondary);\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-cream);\n        }\n\n        .contact-container {\n            max-width: 800px;\n            margin: 0 auto;\n        }\n\n        .contact-card {\n            background: var(--color-alabaster);\n            padding: var(--spacing-lg);\n            border-radius: 30px;\n            box-shadow: var(--shadow-strong);\n        }\n\n        .contact-info {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-md);\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-sm);\n        }\n\n        .contact-item-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-platinum-rose);\n            border-radius: 12px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n        }\n\n        .contact-item-icon svg {\n            width: 24px;\n            height: 24px;\n            fill: white;\n        }\n\n        .contact-item-content h4 {\n            font-size: 1rem;\n            margin-bottom: 0.3rem;\n            color: var(--color-noir);\n        }\n\n        .contact-item-content p {\n            font-size: 0.9rem;\n            color: var(--color-text-secondary);\n        }\n\n        .contact-form {\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-sm);\n        }\n\n        .form-row {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-sm);\n        }\n\n        .form-group {\n            display: flex;\n            flex-direction: column;\n            gap: 0.5rem;\n        }\n\n        .form-group label {\n            font-size: 0.9rem;\n            font-weight: 600;\n            color: var(--color-noir);\n        }\n\n        .form-group input,\n        .form-group select,\n        .form-group textarea {\n            padding: 1rem;\n            border: 2px solid var(--color-platinum-dark);\n            border-radius: 12px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: all var(--transition-fast);\n            background: white;\n        }\n\n        .form-group input:focus,\n        .form-group select:focus,\n        .form-group textarea:focus {\n            outline: none;\n            border-color: var(--color-rose-gold);\n            box-shadow: 0 0 0 4px rgba(201, 160, 136, 0.1);\n        }\n\n        .form-group textarea {\n            min-height: 150px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            background: var(--gradient-rose-gold);\n            color: white;\n            padding: 1rem 2rem;\n            border: none;\n            border-radius: 50px;\n            font-size: 1.1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all var(--transition-base);\n            box-shadow: 0 4px 15px rgba(201, 160, 136, 0.3);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 8px 25px rgba(201, 160, 136, 0.4);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            padding: var(--spacing-lg) var(--spacing-md);\n            background: var(--color-noir);\n            color: var(--color-text-on-dark);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-lg);\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .footer-section h4 {\n            font-size: 1.2rem;\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-on-dark);\n        }\n\n        .footer-section p {\n            color: var(--color-platinum-light);\n            font-size: 0.95rem;\n        }\n\n        .footer-links {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-links a {\n            color: var(--color-platinum-light);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-rose-gold);\n        }\n\n        .footer-bottom {\n            padding-top: var(--spacing-md);\n            border-top: 1px solid var(--color-noir-charcoal);\n            text-align: center;\n        }\n\n        .footer-bottom p {\n            color: var(--color-platinum-dark);\n            font-size: 0.9rem;\n        }\n\n        /* ============================================\n           ANIMATION CLASSES\n           ============================================ */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.6s ease;\n        }\n\n        .wow-fade-in.visible {\n            opacity: 1;\n        }\n\n        /* Stagger delays */\n        .delay-100 { transition-delay: 0.1s; }\n        .delay-200 { transition-delay: 0.2s; }\n        .delay-300 { transition-delay: 0.3s; }\n        .delay-400 { transition-delay: 0.4s; }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                right: 0;\n                flex-direction: column;\n                background: var(--color-alabaster);\n                padding: var(--spacing-md);\n                gap: var(--spacing-sm);\n                transform: translateY(-100%);\n                opacity: 0;\n                transition: all var(--transition-base);\n                box-shadow: var(--shadow-medium);\n            }\n\n            .nav-menu.active {\n                transform: translateY(0);\n                opacity: 1;\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n\n            .nav-cta {\n                width: 100%;\n                text-align: center;\n            }\n\n            .hero-secondary {\n                display: flex;\n                margin-top: var(--spacing-sm);\n                margin-left: 0;\n            }\n\n            .problem-solution-grid,\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .contact-info {\n                grid-template-columns: 1fr;\n            }\n\n            .form-row {\n                grid-template-columns: 1fr;\n            }\n\n            .blob-1, .blob-2, .blob-3, .blob-4 {\n                width: 200px;\n                height: 200px;\n            }\n        }\n\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Isabelle Marchi</a>\n            <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Toggle menu\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#home\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contato\" class=\"nav-link\">Contato</a></li>\n                <li><a href=\"#contato\" class=\"nav-cta\">Agendar Consulta</a></li>\n            </ul>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-blob blob-1\"></div>\n        <div class=\"hero-blob blob-2\"></div>\n        <div class=\"hero-blob blob-3\"></div>\n        <div class=\"hero-blob blob-4\"></div>\n\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <span class=\"hero-badge wow-fade-up\">Rinomodelação Estruturada</span>\n                <h1 class=\"hero-title wow-fade-up delay-100\">\n                    Harmonização Nasal com <span>Naturalidade</span> e Precisão\n                </h1>\n                <p class=\"hero-description wow-fade-up delay-200\">\n                    Transforme sua aparência com rinomodelação estruturada avançada.\n                    Resultados naturais que realçam sua beleza única sem cirurgia.\n                </p>\n                <div class=\"hero-cta-container wow-fade-up delay-300\">\n                    <a href=\"#contato\" class=\"hero-cta\">\n                        Agendar Consulta\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                    <a href=\"#servicos\" class=\"hero-secondary\">Conhecer Procedimentos</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"problem-solution\" id=\"problema-solucao\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-label\">Transformação Real</span>\n                <h2>Sua Melhor Versão</h2>\n            </div>\n\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card wow-fade-up delay-100\">\n                    <div class=\"card-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>\n                    </div>\n                    <h3>Seu Desafio</h3>\n                    <p>Insatisfação com a aparência do nariz que afeta sua autoestima e confiança, mas você busca alternativas à cirurgia plástica tradicional.</p>\n                </div>\n\n                <div class=\"solution-card wow-fade-up delay-200\">\n                    <div class=\"card-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                    </div>\n                    <h3>Nossa Solução</h3>\n                    <p>Rinomodelação estruturada com técnicas minimamente invasivas que proporcionam resultados naturais e harmoniosos, valorizando seus traços únicos.</p>\n                </div>\n\n                <div class=\"solution-card wow-fade-up delay-300\">\n                    <div class=\"card-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z\"/></svg>\n                    </div>\n                    <h3>Resultado</h3>\n                    <p>Aparência harmônica e natural com recuperação rápida, sem os riscos e tempo de recuperação da cirurgia convencional.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"services\" id=\"servicos\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-label\">Procedimentos</span>\n                <h2>Serviços Especializados</h2>\n                <p>Técnicas avançadas de rinomodelação estruturada para resultados naturais</p>\n            </div>\n\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up delay-100\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C8.69 2 6 4.69 6 8c0 2.86 1.92 5.25 4.53 5.91L12 22l1.47-8.09C16.08 13.25 18 10.86 18 8c0-3.31-2.69-6-6-6z\"/></svg>\n                    </div>\n                    <h3 class=\"service-title\">Rinomodelação Estruturada</h3>\n                    <p class=\"service-description\">Técnica avançada de remodelação nasal com preenchedores para corrigir assimetrias e harmonizar o rosto.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up delay-200\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14h-2v-4H6v-2h4V7h2v4h4v2h-4v4z\"/></svg>\n                    </div>\n                    <h3 class=\"service-title\">Harmonização Nasal</h3>\n                    <p class=\"service-description\">Procedimentos combinados para equilibrar proporcões e realçar a beleza natural do seu nariz.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up delay-300\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                    </div>\n                    <h3 class=\"service-title\">Preenchimento Nasal</h3>\n                    <p class=\"service-description\">Correção de depressões e irregularidades com ácido hialurônico de alta qualidade.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up delay-100\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M20.5 11H3.5C2.67 11 2 11.67 2 12.5v9c0 .83.67 1.5 1.5 1.5h5v-3h4v3h5c.83 0 1.5-.67 1.5-1.5v-9c0-.83-.67-1.5-1.5-1.5zM13 3v6h8v6l-2-3-2 3-2-3-2 3V3h-2z\"/></svg>\n                    </div>\n                    <h3 class=\"service-title\">Ponta Nasal</h3>\n                    <p class=\"service-description\">Refinamento e projeção da ponta nasal para um resultado mais elegante e harmonioso.</p>\n                    </div>\n\n                <div class=\"service-card wow-fade-up delay-200\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>\n                    </div>\n                    <h3 class=\"service-title\">Correção de Giba</h3>\n                    <p class=\"service-description\">Suavização da giba nasal para um perfil mais suave e natural.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up delay-300\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1zm0 13.5c-1.1-.35-2.3-.5-3.5-.5-1.7 0-4.15.65-5.5 1.5V8c1.35-.85 3.8-1.5 5.5-1.5 1.2 0 2.4.15 3.5.5v11.5z\"/></svg>\n                    </div>\n                    <h3 class=\"service-title\">Protocolos Exclusivos</h3>\n                    <p class=\"service-description\">Técnicas personalizadas desenvolvidas para resultados únicos e naturais.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"testimonials\" id=\"depoimentos\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-label\">Depoimentos</span>\n                <h2>O Que Dizem Nossas Pacientes</h2>\n                <p>Histórias reais de transformação e satisfação</p>\n            </div>\n\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up delay-100\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"Resultado incrível! A Dra. Isabelle tem mãos de fada. Meu nariz ficou perfeito, natural e eu me sinto muito mais confiante. Recomendo de olhos fechados!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Maria Clara Silva</h4>\n                            <span>Empresária, 32 anos</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up delay-200\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"Era apaixonada por fazer rinoplastia, mas tinha medo da cirurgia. A rinomodelação mudou minha vida! O resultado superou minhas expectativas.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AF</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Ana Ferreira</h4>\n                            <span>Advogada, 28 anos</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up delay-300\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"Profissional excelente! A Dra. Isabelle me explicou todo o processo, me deixou tranquila e o resultado foi exatamente como eu sonhava. Muito grata!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">JO</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Juliana Oliveira</h4>\n                            <span>Arquiteta, 35 anos</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"differentials\" id=\"diferenciais\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-label\">Por Que Nos Escolher</span>\n                <h2>Nossos Diferenciais</h2>\n                <p>Compromisso com excelência e resultados naturais</p>\n            </div>\n\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up delay-100\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>\n                        </div>\n                        <div class=\"differential-icon-ring\"></div>\n                    </div>\n                    <h3 class=\"differential-title\">Técnicas Avançadas</h3>\n                    <p class=\"differential-description\">Metodologia atualizada com as mais modernas técnicas de rinomodelação estruturada.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up delay-200\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"/></svg>\n                        </div>\n                        <div class=\"differential-icon-ring\"></div>\n                    </div>\n                    <h3 class=\"differential-title\">Atendimento Personalizado</h3>\n                    <p class=\"differential-description\">Cada paciente é única. Protocolos personalizados para suas necessidades específicas.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up delay-300\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C8.69 2 6 4.69 6 8c0 2.86 1.92 5.25 4.53 5.91L12 22l1.47-8.09C16.08 13.25 18 10.86 18 8c0-3.31-2.69-6-6-6z\"/></svg>\n                        </div>\n                        <div class=\"differential-icon-ring\"></div>\n                    </div>\n                    <h3 class=\"differential-title\">Resultados Naturais</h3>\n                    <p class=\"differential-description\">Foco em naturalidade e harmonia com seus traços faciais originais.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up delay-100\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z\"/></svg>\n                        </div>\n                        <div class=\"differential-icon-ring\"></div>\n                    </div>\n                    <h3 class=\"differential-title\">Recuperação Rápida</h3>\n                    <p class=\"differential-description\">Procedimento minimamente invasivo com retorno rápido às atividades normais.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up delay-200\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z\"/></svg>\n                        </div>\n                        <div class=\"differential-icon-ring\"></div>\n                    </div>\n                    <h3 class=\"differential-title\">Segurança Primeiro</h3>\n                    <p class=\"differential-description\">Produtos de alta qualidade e ambiente estéril para sua segurança.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up delay-300\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M20 2H4c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8 17.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 10.5 12 10.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5zm0-5.5c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z\"/></svg>\n                        </div>\n                        <div class=\"differential-icon-ring\"></div>\n                    </div>\n                    <h3 class=\"differential-title\">Acompanhamento Completo</h3>\n                    <p class=\"differential-description\">Suporte total antes, durante e depois do procedimento.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"contact\" id=\"contato\">\n        <div class=\"contact-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-label\">Agende Sua Consulta</span>\n                <h2>Entre em Contato</h2>\n                <p>Primeira avaliação gratuita para conhecer suas necessidades</p>\n            </div>\n\n            <div class=\"contact-card wow-fade-up\">\n                <div class=\"contact-info\">\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z\"/></svg>\n                        </div>\n                        <div class=\"contact-item-content\">\n                            <h4>Endereço</h4>\n                            <p>Av. Cel. Fernando Ferreira Leite, 1520 - sala 1605 - Nova Aliança, Ribeirão Preto - SP, 14026-020</p>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z\"/></svg>\n                        </div>\n                        <div class=\"contact-item-content\">\n                            <h4>Telefone</h4>\n                            <p>(16) 99179-8230</p>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">\n                            <svg viewBox=\"0 0 24 24\"><path d=\"M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z\"/></svg>\n                        </div>\n                        <div class=\"contact-item-content\">\n                            <h4>Email</h4>\n                            <p>contato@draisellemarchi.com.br</p>\n                        </div>\n                    </div>\n                </div>\n\n                <form class=\"contact-form\" id=\"contactForm\">\n                    <div class=\"form-row\">\n                        <div class=\"form-group\">\n                            <label for=\"name\">Nome completo</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" placeholder=\"Seu nome\" required>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"phone\">Telefone</label>\n                            <input type=\"tel\" id=\"phone\" name=\"phone\" placeholder=\"(00) 00000-0000\" required>\n                        </div>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label for=\"service\">Serviço de interesse</label>\n                        <select id=\"service\" name=\"service\" required>\n                            <option value=\"\">Selecione um serviço</option>\n                            <option value=\"rinomodelacao\">Rinomodelação Estruturada</option>\n                            <option value=\"harmonizacao\">Harmonização Nasal</option>\n                            <option value=\"preenchimento\">Preenchimento Nasal</option>\n                            <option value=\"ponta\">Ponta Nasal</option>\n                            <option value=\"giba\">Correção de Giba</option>\n                            <option value=\"outro\">Outro Procedimento</option>\n                        </select>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label for=\"message\">Mensagem</label>\n                        <textarea id=\"message\" name=\"message\" placeholder=\"Conte-nos sobre suas expectativas...\" required></textarea>\n                    </div>\n\n                    <button type=\"submit\" class=\"form-submit\">Agendar Consulta Gratuita</button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-section\">\n                    <h4>Dra. Isabelle Marchi</h4>\n                    <p>Rinomodelação estruturada especializada em Ribeirão Preto. Transformando vidas com resultados naturais e seguros.</p>\n                </div>\n\n                <div class=\"footer-section\">\n                    <h4>Links Rápidos</h4>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#home\">Início</a></li>\n                        <li><a href=\"#servicos\">Serviços</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                        <li><a href=\"#diferenciais\">Diferenciais</a></li>\n                        <li><a href=\"#contato\">Contato</a></li>\n                    </ul>\n                </div>\n\n                <div class=\"footer-section\">\n                    <h4>Horário de Atendimento</h4>\n                    <p>Segunda a Sexta: 9h às 18h</p>\n                    <p>Sábados: 9h às 13h</p>\n                </div>\n            </div>\n\n            <div class=\"footer-bottom\">\n                <p>&copy; 2024 Dra. Isabelle Marchi. Todos os direitos reservados | Rinomodelação Estruturada em Ribeirão Preto</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // Navigation\n        // ============================================\n        const nav = document.getElementById('nav');\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n        let lastScroll = 0;\n\n        // Auto-hide navigation on scroll\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                } else {\n                    nav.classList.remove('hidden');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Mobile menu toggle\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close menu on link click\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // Smooth Scroll\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const offset = 80;\n                    const targetPosition = target.offsetTop - offset;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // WoW Animations (Intersection Observer)\n        // ============================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('visible');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // Parallax Effect on Hero Blobs\n        // ============================================\n        const hero = document.querySelector('.hero');\n        const blobs = document.querySelectorAll('.hero-blob');\n\n        hero.addEventListener('mousemove', (e) => {\n            const x = (e.clientX / window.innerWidth - 0.5) * 2;\n            const y = (e.clientY / window.innerHeight - 0.5) * 2;\n\n            blobs.forEach((blob, index) => {\n                const speed = (index + 1) * 10;\n                blob.style.transform = `translate(${x * speed}px, ${y * speed}px)`;\n            });\n        });\n\n        // ============================================\n        // Contact Form - WhatsApp Integration\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n        const whatsappNumber = '5516991798230';\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceNames = {\n                'rinomodelacao': 'Rinomodelação Estruturada',\n                'harmonizacao': 'Harmonização Nasal',\n                'preenchimento': 'Preenchimento Nasal',\n                'ponta': 'Ponta Nasal',\n                'giba': 'Correção de Giba',\n                'outro': 'Outro Procedimento'\n            };\n\n            const whatsappMessage = `Olá Dra. Isabelle Marchi! Meu nome é ${name}.\n\nGostaria de agendar uma consulta para: ${serviceNames[service]}\n\nTelefone: ${phone}\n\nMensagem: ${message}`;\n\n            const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;\n            window.open(whatsappUrl, '_blank');\n\n            // Reset form\n            contactForm.reset();\n        });\n\n        // ============================================\n        // Initial Page Load Animations\n        // ============================================\n        window.addEventListener('load', () => {\n            document.querySelectorAll('.hero .wow-fade-up').forEach((el, index) => {\n                setTimeout(() => {\n                    el.classList.add('visible');\n                }, index * 100);\n            });\n        });\n    </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null}}
