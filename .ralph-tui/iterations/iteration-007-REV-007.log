onitoramento avançado.\n          - link \"Saiba mais\" [ref=e143] [cursor=pointer]:\n            - /url: \"#contato\"\n            - text: Saiba mais\n            - img [ref=e144]\n      - generic [ref=e146]:\n        - generic [ref=e147]:\n          - img \"UTI Veterinária\" [ref=e148]\n          - generic [ref=e149]: \"3\"\n        - generic [ref=e150]:\n          - img [ref=e152]\n          - heading \"UTI e Internação\" [level=3] [ref=e154]\n          - paragraph [ref=e155]: Unidade de Terapia Intensiva com monitoramento contínuo 24h para casos graves.\n          - link \"Saiba mais\" [ref=e156] [cursor=pointer]:\n            - /url: \"#contato\"\n            - text: Saiba mais\n            - img [ref=e157]\n      - generic [ref=e159]:\n        - generic [ref=e160]:\n          - img \"Exames Diagnósticos\" [ref=e161]\n          - generic [ref=e162]: \"4\"\n        - generic [ref=e163]:\n          - img [ref=e165]\n          - heading \"Exames Diagnósticos\" [level=3] [ref=e167]\n          - paragraph [ref=e168]: \"Laboratório próprio para resultados rápidos: hemograma, bioquímica, urinálise e raio-X digital.\"\n          - link \"Agendar\" [ref=e169] [cursor=pointer]:\n            - /url: \"#contato\"\n            - text: Agendar\n            - img [ref=e170]\n      - generic [ref=e172]:\n        - generic [ref=e173]:\n          - img \"Cardiologia Veterinária\" [ref=e174]\n          - generic [ref=e175]: \"5\"\n        - generic [ref=e176]:\n          - img [ref=e178]\n          - heading \"Cardiologia\" [level=3] [ref=e180]\n          - paragraph [ref=e181]: Eletrocardiograma, ecocardiograma e tratamento de doenças cardíacas em pets.\n          - link \"Agendar\" [ref=e182] [cursor=pointer]:\n            - /url: \"#contato\"\n            - text: Agendar\n            - img [ref=e183]\n      - generic [ref=e185]:\n        - generic [ref=e186]:\n          - img \"Vacinação e Prevenção\" [ref=e187]\n          - generic [ref=e188]: \"6\"\n        - generic [ref=e1