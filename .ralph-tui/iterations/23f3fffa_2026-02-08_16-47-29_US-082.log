act-info-content\">\n                            <h4>Instagram</h4>\n                            <p><a href=\"https://instagram.com/clinicabeclin\" target=\"_blank\">@clinicabeclin</a></p>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-info-item wow-fade-up\" data-delay=\"800\">\n                        <div class=\"contact-info-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"></rect>\n                                <path d=\"M10 8h4\"></path>\n                                <path d=\"M10 12h4\"></path>\n                                <path d=\"M10 16h4\"></path>\n                            </svg>\n                        </div>\n                        <div class=\"contact-info-content\">\n                            <h4>Horário de Atendimento</h4>\n                            <p>Segunda a Sexta: 9h às 18h</p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"contact-form-wrapper wow-fade-up\" data-delay=\"400\">\n                    <form class=\"contact-form\" id=\"contactForm\">\n                        <div class=\"form-group\">\n                            <label for=\"name\" class=\"form-label\">Nome Completo</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" class=\"form-input\" placeholder=\"Seu nome\" required>\n                        </div>\n\n                        <div class=\"form-group\">\n                            <label for=\"email\" class=\"form-label\">E-mail</label>\n                            <input type=\"email\" id=\"email\" name=\"email\" class=\"form-input\" placeholder=\"seu@email.com\" required>\n                        </div>\n\n                        <div class=\"form-group\">\n                            <label for=\"phone\" class=\"form-label\">Telefone / WhatsApp</label>\n                            <input type=\"tel\" id=\"phone\" name=\"phone\" class=\"form-input\" placeholder=\"(16) 99999-9999\" required>\n                        </div>\n\n                        <div class=\"form-group\">\n                            <label for=\"service\" class=\"form-label\">Tratamento de Interesse</label>\n                            <select id=\"service\" name=\"service\" class=\"form-select\" required>\n                                <option value=\"\">Selecione uma opção</option>\n                                <option value=\"facelifting\">Protocolo Facelifting®</option>\n                                <option value=\"harmonizacao\">Harmonização Facial</option>\n                                <option value=\"fullface\">Full Face</option>\n                                <option value=\"temporal\">Lifting Temporal</option>\n                                <option value=\"bioestimuladores\">Bioestimuladores</option>\n                                <option value=\"consultoria\">Consultoria Facial</option>\n                                <option value=\"outro\">Outro</option>\n                            </select>\n                        </div>\n\n                        <div class=\"form-group\">\n                            <label for=\"message\" class=\"form-label\">Mensagem</label>\n                            <textarea id=\"message\" name=\"message\" class=\"form-textarea\" placeholder=\"Conte-nos mais sobre suas expectativas...\"></textarea>\n                        </div>\n\n                        <button type=\"submit\" class=\"form-submit\">Agendar Consulta</button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-grid\">\n                <div class=\"footer-brand\">\n                    <div class=\"footer-logo\">Be<span>clin</span></div>\n                    <p>Clínica de estética especializada em Protocolo Facelifting® e harmonização facial em Ribeirão Preto.</p>\n                </div>\n\n                <div>\n                    <h4 class=\"footer-title\">Links Rápidos</h4>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#inicio\">Início</a></li>\n                        <li><a href=\"#servicos\">Protocolo</a></li>\n                        <li><a href=\"#diferenciais\">Diferenciais</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                        <li><a href=\"#contato\">Contato</a></li>\n                    </ul>\n                </div>\n\n                <div>\n                    <h4 class=\"footer-title\">Redes Sociais</h4>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"https://instagram.com/clinicabeclin\" target=\"_blank\">Instagram</a></li>\n                        <li><a href=\"https://facebook.com/clinicabeclin\" target=\"_blank\">Facebook</a></li>\n                        <li><a href=\"https://wa.me/5516999999999\">WhatsApp</a></li>\n                    </ul>\n                </div>\n            </div>\n\n            <div class=\"footer-bottom\">\n                <p>&copy; 2024 Beclin Clínica. Todos os direitos reservados. | Desenvolvido por <a href=\"https://pixelalchemy.com.br\" target=\"_blank\">Pixel Alchemy</a></p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION SCROLL EFFECT\n        // ============================================\n        const nav = document.querySelector('.nav');\n        let lastScrollY = window.scrollY;\n\n        window.addEventListener('scroll', () => {\n            if (window.scrollY > 100) {\n                nav.classList.add('scrolled');\n            } else {\n                nav.classList.remove('scrolled');\n            }\n\n            if (window.scrollY > lastScrollY && window.scrollY > 200) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n\n            lastScrollY = window.scrollY;\n        });\n\n        // ============================================\n        // MOBILE MENU TOGGLE\n        // ============================================\n        const navToggle = document.querySelector('.nav-toggle');\n        const navMenu = document.querySelector('.nav-menu');\n\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close menu when clicking on a link\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER FOR SCROLL ANIMATIONS\n        // ============================================\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const fadeInUpObserver = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || 0;\n                    setTimeout(() => {\n                        entry.target.classList.add('visible');\n                    }, delay);\n                    fadeInUpObserver.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        const fadeInObserver = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('visible');\n                    fadeInObserver.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        // Observe elements\n        document.querySelectorAll('.wow-fade-up').forEach(el => {\n            fadeInUpObserver.observe(el);\n        });\n\n        document.querySelectorAll('.wow-fade-in').forEach(el => {\n            fadeInObserver.observe(el);\n        });\n\n        // ============================================\n        // CONTACT FORM HANDLING\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const formData = new FormData(contactForm);\n            const data = Object.fromEntries(formData);\n\n            // Here you would typically send the data to your backend\n            console.log('Form submitted:', data);\n\n            // Show success message\n            alert('Obrigado pelo contato! Em breve entraremos em contato.');\n            contactForm.reset();\n        });\n\n        // ============================================\n        // PARALLAX EFFECT FOR CONTOURS\n        // ============================================\n        const contours = document.querySelectorAll('.hero-contour');\n\n        window.addEventListener('scroll', () => {\n            const scrolled = window.scrollY;\n            contours.forEach((contour, index) => {\n                const speed = (index + 1) * 0.05;\n                contour.style.transform = `translateY(${scrolled * speed}px)`;\n            });\n        });\n\n        // ============================================\n        // PREFERS REDUCED MOTION\n        // ============================================\n        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n            // Disable all animations for users who prefer reduced motion\n            document.documentElement.style.setProperty('--transition-fast', '0s');\n            document.documentElement.style.setProperty('--transition-base', '0s');\n            document.documentElement.style.setProperty('--transition-slow', '0s');\n        }\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"baa36dbd-648f-4f8c-8614-8024e9abc230","uuid":"f6f5f777-1966-4df7-95dd-c7c5d0053d33"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_bad489ea5bce416b8744136f","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/beclin-clinica/index.html"}]},"parent_tool_use_id":null,"session_id":"baa36dbd-648f-4f8c-8614-8024e9abc230","uuid":"d35f09b7-691f-40fb-92a0-dc249f3d0260","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/beclin-clinica/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Beclin Clínica | Protocolo Facelifting® em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Beclin Clínica - Protocolo Facelifting® exclusivo com Dra. Francine Bianchini. Harmonização facial e estética avançada em Ribeirão Preto.\">\n    <meta name=\"keywords\" content=\"protocolo facelifting, harmonização facial, estética facial, Ribeirão Preto, Dra Francine Bianchini\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=Outfit:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           CSS VARIABLES - PORCELAIN & GOLD NOIR\n           ============================================ */\n        :root {\n            /* Primary Palette - Porcelain */\n            --color-porcelain: #F5F3F0;\n            --color-porcelain-light: #FAF8F6;\n            --color-porcelain-warm: #F0EDE8;\n            --color-porcelain-soft: #E8E6E2;\n            --color-ivory: #EDEAE6;\n\n            /* Accent Palette - Champagne Gold */\n            --color-gold: #C9A962;\n            --color-gold-light: #D4B878;\n            --color-gold-mid: #E8D4A0;\n            --color-gold-champagne: #DBC89A;\n            --color-gold-shimmer: #F0E6CC;\n\n            /* Secondary Accent - Soft Rose */\n            --color-rose: #D4A098;\n            --color-rose-light: #E8C4BC;\n            --color-rose-soft: #F0D8D2;\n\n            /* Dark Palette - Noir */\n            --color-noir: #0F0E0D;\n            --color-noir-charcoal: #1A1918;\n            --color-noir-deep: #080706;\n            --color-noir-mid: #242220;\n            --color-espresso: #1C1B1A;\n\n            /* Text Colors */\n            --color-text-primary: #0F0E0D;\n            --color-text-secondary: #4A4846;\n            --color-text-muted: #8A8886;\n            --color-text-gold: #A88A4A;\n            --color-text-on-dark: #F5F3F0;\n\n            /* Gradients */\n            --gradient-gold: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-light) 100%);\n            --gradient-noir: linear-gradient(135deg, var(--color-noir) 0%, var(--color-noir-charcoal) 100%);\n            --gradient-porcelain: linear-gradient(135deg, #FAF8F6 0%, #F0EDE8 50%, #E8E6E2 100%);\n            --gradient-hero: linear-gradient(165deg, #FAF8F6 0%, #F5F0EA 40%, #EDE6DE 100%);\n            --gradient-gold-rose: linear-gradient(135deg, var(--color-gold) 0%, var(--color-rose) 100%);\n            --gradient-shimmer: linear-gradient(90deg, transparent, rgba(201, 169, 98, 0.1), transparent);\n\n            /* Facial Contour Wave Border Radius */\n            --radius-contour-1: 72% 28% 48% 52% / 52% 48% 72% 28%;\n            --radius-contour-2: 48% 52% 72% 28% / 28% 72% 48% 52%;\n            --radius-contour-3: 56% 44% 52% 48% / 48% 52% 56% 44%;\n            --radius-contour-4: 44% 56% 48% 52% / 52% 48% 44% 56%;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 8rem;\n            --spacing-xxl: 10rem;\n\n            /* Typography */\n            --font-display: 'Playfair Display', Georgia, serif;\n            --font-body: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n            --transition-slower: 0.8s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 24px rgba(15, 14, 13, 0.06);\n            --shadow-medium: 0 8px 40px rgba(15, 14, 13, 0.1);\n            --shadow-strong: 0 16px 60px rgba(15, 14, 13, 0.14);\n            --shadow-gold: 0 8px 40px rgba(201, 169, 98, 0.2);\n            --shadow-gold-strong: 0 16px 60px rgba(201, 169, 98, 0.3);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.7;\n            color: var(--color-text-primary);\n            background: var(--color-porcelain-light);\n            overflow-x: hidden;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-noir);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 5rem);\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3.2rem);\n            margin-bottom: var(--spacing-md);\n            font-weight: 600;\n        }\n\n        h3 {\n            font-size: clamp(1.4rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n            font-weight: 600;\n        }\n\n        h4 {\n            font-size: clamp(1.1rem, 1.5vw, 1.3rem);\n            margin-bottom: var(--spacing-xs);\n            font-weight: 500;\n        }\n\n        p {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-secondary);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-sm) var(--spacing-md);\n            background: rgba(250, 248, 246, 0.92);\n            backdrop-filter: blur(20px);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n            box-shadow: 0 2px 24px rgba(15, 14, 13, 0.04);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav.scrolled {\n            box-shadow: 0 4px 30px rgba(15, 14, 13, 0.08);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.6rem;\n            font-weight: 700;\n            color: var(--color-noir);\n            text-decoration: none;\n            letter-spacing: -0.01em;\n        }\n\n        .nav-logo span {\n            color: var(--color-gold);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-secondary);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n            position: relative;\n            letter-spacing: 0.02em;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 50%;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-gold);\n            transition: width var(--transition-fast), left var(--transition-fast);\n        }\n\n        .nav-link:hover {\n            color: var(--color-noir);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n            left: 0;\n        }\n\n        .nav-cta {\n            background: var(--gradient-gold);\n            color: var(--color-noir) !important;\n            padding: 0.8rem 1.8rem;\n            border-radius: 50px;\n            font-weight: 600;\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-gold);\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-noir);\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            padding: var(--spacing-xl) var(--spacing-md) var(--spacing-xl);\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        .hero-shimmer {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            top: 0;\n            left: -100%;\n            background: var(--gradient-shimmer);\n            animation: shimmer 8s ease-in-out infinite;\n            pointer-events: none;\n        }\n\n        @keyframes shimmer {\n            0% { left: -100%; }\n            100% { left: 200%; }\n        }\n\n        .hero-particle {\n            position: absolute;\n            border-radius: 50%;\n            background: var(--color-gold);\n            opacity: 0.08;\n            animation: particle-float 15s ease-in-out infinite;\n        }\n\n        @keyframes particle-float {\n            0%, 100% { transform: translateY(0) rotate(0deg); }\n            50% { transform: translateY(-30px) rotate(180deg); }\n        }\n\n        .particle-1 { width: 6px; height: 6px; top: 15%; left: 10%; animation-delay: 0s; }\n        .particle-2 { width: 4px; height: 4px; top: 25%; right: 15%; animation-delay: -2s; }\n        .particle-3 { width: 8px; height: 8px; top: 60%; left: 20%; animation-delay: -4s; }\n        .particle-4 { width: 5px; height: 5px; top: 70%; right: 25%; animation-delay: -6s; }\n        .particle-5 { width: 7px; height: 7px; bottom: 20%; left: 40%; animation-delay: -8s; }\n        .particle-6 { width: 4px; height: 4px; bottom: 30%; right: 10%; animation-delay: -10s; }\n\n        .hero-contour {\n            position: absolute;\n            border-radius: var(--radius-contour-1);\n            opacity: 0.12;\n            filter: blur(80px);\n            animation: contour-breathe 18s ease-in-out infinite;\n        }\n\n        @keyframes contour-breathe {\n            0%, 100% { transform: scale(1) rotate(0deg); }\n            50% { transform: scale(1.1) rotate(5deg); }\n        }\n\n        .contour-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-gold);\n            top: -200px;\n            right: -150px;\n            animation-delay: 0s;\n        }\n\n        .contour-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--color-rose);\n            bottom: -150px;\n            left: -100px;\n            animation-delay: -6s;\n            border-radius: var(--radius-contour-2);\n        }\n\n        .contour-3 {\n            width: 350px;\n            height: 350px;\n            background: var(--gradient-gold-rose);\n            top: 40%;\n            left: 10%;\n            animation-delay: -12s;\n            border-radius: var(--radius-contour-3);\n            opacity: 0.08;\n        }\n\n        .hero-container {\n            max-width: 1100px;\n            margin: 0 auto;\n            text-align: center;\n            position: relative;\n            z-index: 10;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 0.6rem 1.4rem;\n            background: rgba(201, 169, 98, 0.1);\n            border: 1px solid rgba(201, 169, 98, 0.2);\n            border-radius: 50px;\n            margin-bottom: var(--spacing-md);\n            animation: fade-in-up 0.8s ease forwards;\n            animation-delay: 0ms;\n            opacity: 0;\n        }\n\n        .hero-badge-dot {\n            width: 6px;\n            height: 6px;\n            background: var(--color-gold);\n            border-radius: 50%;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; transform: scale(1); }\n            50% { opacity: 0.5; transform: scale(1.2); }\n        }\n\n        .hero-badge-text {\n            font-family: var(--font-body);\n            font-size: 0.85rem;\n            font-weight: 500;\n            color: var(--color-text-gold);\n            letter-spacing: 0.05em;\n            text-transform: uppercase;\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            animation: fade-in-up 0.8s ease forwards;\n            animation-delay: 200ms;\n            opacity: 0;\n        }\n\n        .hero-title-line {\n            display: block;\n        }\n\n        .hero-title-accent {\n            color: var(--color-gold);\n            font-style: italic;\n            position: relative;\n        }\n\n        .hero-title-accent::after {\n            content: '';\n            position: absolute;\n            bottom: 8px;\n            left: 0;\n            right: 0;\n            height: 12px;\n            background: linear-gradient(90deg, transparent 30%, rgba(201, 169, 98, 0.15) 50%, transparent 70%);\n            z-index: -1;\n        }\n\n        .hero-description {\n            font-size: clamp(1rem, 2vw, 1.2rem);\n            max-width: 600px;\n            margin: 0 auto var(--spacing-md);\n            color: var(--color-text-secondary);\n            animation: fade-in-up 0.8s ease forwards;\n            animation-delay: 400ms;\n            opacity: 0;\n        }\n\n        .hero-cta-group {\n            display: flex;\n            gap: var(--spacing-sm);\n            justify-content: center;\n            flex-wrap: wrap;\n            animation: fade-in-up 0.8s ease forwards;\n            animation-delay: 600ms;\n            opacity: 0;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 1rem 2rem;\n            font-family: var(--font-body);\n            font-size: 0.95rem;\n            font-weight: 600;\n            text-decoration: none;\n            border-radius: 50px;\n            transition: all var(--transition-base);\n            cursor: pointer;\n            border: none;\n            letter-spacing: 0.02em;\n        }\n\n        .btn-primary {\n            background: var(--gradient-gold);\n            color: var(--color-noir);\n            box-shadow: var(--shadow-gold);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-gold-strong);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-noir);\n            border: 2px solid var(--color-noir-charcoal);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-noir);\n            color: var(--color-porcelain-light);\n        }\n\n        .hero-trust {\n            display: flex;\n            gap: var(--spacing-lg);\n            justify-content: center;\n            margin-top: var(--spacing-lg);\n            animation: fade-in-up 0.8s ease forwards;\n            animation-delay: 800ms;\n            opacity: 0;\n        }\n\n        .hero-trust-item {\n            text-align: center;\n        }\n\n        .hero-trust-number {\n            font-family: var(--font-display);\n            font-size: 2rem;\n            font-weight: 700;\n            color: var(--color-gold);\n        }\n\n        .hero-trust-label {\n            font-size: 0.8rem;\n            color: var(--color-text-muted);\n            text-transform: uppercase;\n            letter-spacing: 0.05em;\n        }\n\n        /* ============================================\n           SECTIONS COMMON\n           ============================================ */\n        .section {\n            padding: var(--spacing-xl) var(--spacing-md);\n            position: relative;\n        }\n\n        .section-container {\n            max-width: 1100px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .section-label {\n            display: inline-block;\n            font-family: var(--font-body);\n            font-size: 0.8rem;\n            font-weight: 600;\n            color: var(--color-gold);\n            text-transform: uppercase;\n            letter-spacing: 0.1em;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .section-title {\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .section-description {\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-section {\n            background: var(--color-porcelain);\n        }\n\n        .problem-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n            align-items: center;\n        }\n\n        .problem-visual {\n            position: relative;\n            height: 500px;\n            border-radius: var(--radius-contour-1);\n            overflow: hidden;\n            background: var(--gradient-noir);\n        }\n\n        .problem-visual img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            opacity: 0.85;\n        }\n\n        .problem-visual-overlay {\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            right: 0;\n            padding: var(--spacing-md);\n            background: linear-gradient(transparent, rgba(15, 14, 13, 0.8));\n        }\n\n        .problem-visual-quote {\n            font-family: var(--font-display);\n            font-size: 1.2rem;\n            font-style: italic;\n            color: var(--color-text-on-dark);\n        }\n\n        .problem-content {\n            padding: var(--spacing-md);\n        }\n\n        .problem-item {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .problem-item-label {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            font-size: 0.8rem;\n            font-weight: 600;\n            color: var(--color-rose);\n            text-transform: uppercase;\n            letter-spacing: 0.05em;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        .problem-item-label svg {\n            width: 16px;\n            height: 16px;\n        }\n\n        .problem-item-title {\n            font-size: 1.5rem;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        .solution-box {\n            background: rgba(201, 169, 98, 0.08);\n            border-left: 3px solid var(--color-gold);\n            padding: var(--spacing-md);\n            border-radius: 0 var(--radius-contour-3) var(--radius-contour-3) 0;\n            margin-top: var(--spacing-md);\n        }\n\n        .solution-box-title {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            font-family: var(--font-display);\n            font-size: 1.3rem;\n            color: var(--color-gold);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services-section {\n            background: var(--color-porcelain-light);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .service-card {\n            background: white;\n            padding: var(--spacing-md);\n            border-radius: var(--radius-contour-1);\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-gold);\n            transform: scaleX(0);\n            transform-origin: left;\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: rgba(201, 169, 98, 0.1);\n            border-radius: var(--radius-contour-2);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .service-icon svg {\n            width: 30px;\n            height: 30px;\n            stroke: var(--color-gold);\n        }\n\n        .service-card-title {\n            font-size: 1.4rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-card-description {\n            font-size: 0.95rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .service-card-link {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            color: var(--color-gold);\n            font-weight: 600;\n            text-decoration: none;\n            font-size: 0.9rem;\n            transition: gap var(--transition-fast);\n        }\n\n        .service-card-link:hover {\n            gap: var(--spacing-sm);\n        }\n\n        .service-card-link svg {\n            width: 16px;\n            height: 16px;\n            transition: transform var(--transition-fast);\n        }\n\n        .service-card-link:hover svg {\n            transform: translateX(4px);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials-section {\n            background: var(--color-noir);\n            color: var(--color-text-on-dark);\n        }\n\n        .differentials-section .section-title,\n        .differentials-section h3,\n        .differentials-section p {\n            color: var(--color-text-on-dark);\n        }\n\n        .differentials-section .section-label {\n            color: var(--color-gold-champagne);\n        }\n\n        .differentials-section .section-description {\n            color: rgba(245, 243, 240, 0.7);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .differential-card {\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-number {\n            font-family: var(--font-display);\n            font-size: 4rem;\n            font-weight: 700;\n            color: var(--color-gold);\n            opacity: 0.3;\n            line-height: 1;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .differential-title {\n            font-size: 1.3rem;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        .differential-description {\n            color: rgba(245, 243, 240, 0.7);\n            font-size: 0.95rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials-section {\n            background: var(--color-porcelain-warm);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .testimonial-card {\n            background: white;\n            padding: var(--spacing-md);\n            border-radius: var(--radius-contour-1);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .testimonial-stars {\n            display: flex;\n            gap: 4px;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .testimonial-stars svg {\n            width: 18px;\n            height: 18px;\n            fill: var(--color-gold);\n        }\n\n        .testimonial-quote {\n            font-family: var(--font-display);\n            font-size: 1.1rem;\n            font-style: italic;\n            margin-bottom: var(--spacing-md);\n            color: var(--color-text-primary);\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-porcelain);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-family: var(--font-display);\n            font-weight: 700;\n            color: var(--color-gold);\n        }\n\n        .testimonial-info-name {\n            font-weight: 600;\n            color: var(--color-noir);\n        }\n\n        .testimonial-info-role {\n            font-size: 0.85rem;\n            color: var(--color-text-muted);\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact-section {\n            background: var(--color-porcelain-light);\n        }\n\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-xl);\n        }\n\n        .contact-info {\n            padding: var(--spacing-md);\n        }\n\n        .contact-info-item {\n            display: flex;\n            gap: var(--spacing-md);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-info-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-gold);\n            border-radius: var(--radius-contour-2);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n        }\n\n        .contact-info-icon svg {\n            width: 24px;\n            height: 24px;\n            stroke: var(--color-noir);\n        }\n\n        .contact-info-content h4 {\n            margin-bottom: var(--spacing-xs);\n            font-size: 1.1rem;\n        }\n\n        .contact-info-content p {\n            color: var(--color-text-secondary);\n        }\n\n        .contact-info-content a {\n            color: var(--color-gold);\n            text-decoration: none;\n            font-weight: 500;\n        }\n\n        .contact-form-wrapper {\n            background: white;\n            padding: var(--spacing-md);\n            border-radius: var(--radius-contour-1);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .contact-form {\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-sm);\n        }\n\n        .form-group {\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-xs);\n        }\n\n        .form-label {\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-primary);\n        }\n\n        .form-input,\n        .form-select,\n        .form-textarea {\n            padding: 1rem;\n            border: 1px solid var(--color-porcelain-soft);\n            border-radius: var(--radius-contour-3);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            background: var(--color-porcelain-light);\n            transition: border-color var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .form-input:focus,\n        .form-select:focus,\n        .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-gold);\n            box-shadow: 0 0 0 3px rgba(201, 169, 98, 0.1);\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            background: var(--gradient-gold);\n            color: var(--color-noir);\n            padding: 1rem 2rem;\n            border: none;\n            border-radius: 50px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all var(--transition-base);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-gold);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--color-noir-deep);\n            color: var(--color-text-on-dark);\n            padding: var(--spacing-lg) var(--spacing-md) var(--spacing-md);\n        }\n\n        .footer-container {\n            max-width: 1100px;\n            margin: 0 auto;\n        }\n\n        .footer-grid {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: var(--spacing-lg);\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .footer-brand .footer-logo {\n            font-family: var(--font-display);\n            font-size: 1.8rem;\n            font-weight: 700;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-brand .footer-logo span {\n            color: var(--color-gold);\n        }\n\n        .footer-brand p {\n            color: rgba(245, 243, 240, 0.7);\n            max-width: 300px;\n        }\n\n        .footer-title {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 0.1em;\n            margin-bottom: var(--spacing-md);\n            color: var(--color-gold-champagne);\n        }\n\n        .footer-links {\n            list-style: none;\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-xs);\n        }\n\n        .footer-links a {\n            color: rgba(245, 243, 240, 0.8);\n            text-decoration: none;\n            font-size: 0.95rem;\n            transition: color var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-gold-champagne);\n        }\n\n        .footer-bottom {\n            padding-top: var(--spacing-md);\n            border-top: 1px solid rgba(245, 243, 240, 0.1);\n            text-align: center;\n            font-size: 0.85rem;\n            color: rgba(245, 243, 240, 0.5);\n        }\n\n        .footer-bottom a {\n            color: var(--color-gold);\n            text-decoration: none;\n        }\n\n        /* ============================================\n           ANIMATIONS\n           ============================================ */\n        @keyframes fade-in-up {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fade-in {\n            from { opacity: 0; }\n            to { opacity: 1; }\n        }\n\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(40px);\n            transition: opacity 0.8s ease, transform 0.8s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 1s ease;\n        }\n\n        .wow-fade-in.visible {\n            opacity: 1;\n        }\n\n        /* ============================================\n           RESPONSIVE\n           ============================================ */\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 0;\n                right: -100%;\n                width: 80%;\n                max-width: 300px;\n                height: 100vh;\n                background: white;\n                flex-direction: column;\n                padding: var(--spacing-lg);\n                box-shadow: -10px 0 30px rgba(0, 0, 0, 0.1);\n                transition: right var(--transition-base);\n            }\n\n            .nav-menu.active {\n                right: 0;\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n\n            .problem-grid,\n            .contact-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .problem-visual {\n                height: 300px;\n            }\n\n            .hero-cta-group {\n                flex-direction: column;\n                align-items: center;\n            }\n\n            .hero-trust {\n                flex-direction: column;\n                gap: var(--spacing-md);\n            }\n\n            .footer-grid {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .footer-brand p {\n                margin: 0 auto;\n            }\n\n            .section {\n                padding: var(--spacing-lg) var(--spacing-md);\n            }\n        }\n\n        @media (max-width: 480px) {\n            h1 {\n                font-size: 2.2rem;\n            }\n\n            .hero {\n                padding: var(--spacing-lg) var(--spacing-sm);\n            }\n\n            .services-grid,\n            .differentials-grid,\n            .testimonials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .btn {\n                width: 100%;\n                justify-content: center;\n            }\n        }\n\n        /* ============================================\n           PREFERS REDUCED MOTION\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *,\n            *::before,\n            *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n\n            .wow-fade-up,\n            .wow-fade-in {\n                opacity: 1;\n                transform: none;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Be<span>clin</span></a>\n            <ul class=\"nav-menu\">\n                <li><a href=\"#inicio\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Protocolo</a></li>\n                <li><a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#contato\" class=\"nav-link nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <button class=\"nav-toggle\" aria-label=\"Menu\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-shimmer\"></div>\n\n        <!-- Gold Particles -->\n        <div class=\"hero-particle particle-1\"></div>\n        <div class=\"hero-particle particle-2\"></div>\n        <div class=\"hero-particle particle-3\"></div>\n        <div class=\"hero-particle particle-4\"></div>\n        <div class=\"hero-particle particle-5\"></div>\n        <div class=\"hero-particle particle-6\"></div>\n\n        <!-- Contour Blobs -->\n        <div class=\"hero-contour contour-1\"></div>\n        <div class=\"hero-contour contour-2\"></div>\n        <div class=\"hero-contour contour-3\"></div>\n\n        <div class=\"hero-container\">\n            <div class=\"hero-badge\">\n                <span class=\"hero-badge-dot\"></span>\n                <span class=\"hero-badge-text\">Exclusivo em Ribeirão Preto</span>\n            </div>\n\n            <h1 class=\"hero-title\">\n                <span class=\"hero-title-line\">Transforme seu rosto</span>\n                <span class=\"hero-title-line\">com o <span class=\"hero-title-accent\">Protocolo Facelifting®</span></span>\n            </h1>\n\n            <p class=\"hero-description\">\n                O único tratamento não cirúrgico que reposiciona os tecidos faciais e proporciona um lifting natural e duradouro, sem cortes ou downtime.\n            </p>\n\n            <div class=\"hero-cta-group\">\n                <a href=\"#contato\" class=\"btn btn-primary\">\n                    Agendar Avaliação\n                    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                        <polyline points=\"12 5 19 12 12 19\"></polyline>\n                    </svg>\n                </a>\n                <a href=\"#servicos\" class=\"btn btn-secondary\">\n                    Conhecer o Protocolo\n                </a>\n            </div>\n\n            <div class=\"hero-trust\">\n                <div class=\"hero-trust-item\">\n                    <div class=\"hero-trust-number\">11+</div>\n                    <div class=\"hero-trust-label\">Anos de Experiência</div>\n                </div>\n                <div class=\"hero-trust-item\">\n                    <div class=\"hero-trust-number\">1000+</div>\n                    <div class=\"hero-trust-label\">Pacientes Atendidos</div>\n                </div>\n                <div class=\"hero-trust-item\">\n                    <div class=\"hero-trust-number\">USP</div>\n                    <div class=\"hero-trust-label\">Formação Acadêmica</div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-section\" id=\"problema\">\n        <div class=\"section-container\">\n            <div class=\"problem-grid\">\n                <div class=\"problem-visual wow-fade-up\">\n                    <img src=\"https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=600&h=800&fit=crop&crop=faces\" alt=\"Mulher com aparência rejuvenescida e natural após tratamento facial\">\n                    <div class=\"problem-visual-overlay\">\n                        <p class=\"problem-visual-quote\">\"Não é mágica e não é filtro, é resultado de técnica\"</p>\n                    </div>\n                </div>\n\n                <div class=\"problem-content\">\n                    <div class=\"problem-item wow-fade-up\" data-delay=\"200\">\n                        <span class=\"problem-item-label\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line>\n                                <line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line>\n                            </svg>\n                            O Desafio\n                        </span>\n                        <h3 class=\"problem-item-title\">A flacidez facial pode afetar sua autoestima</h3>\n                        <p>O tempo, a gravidade e os fatores ambientais deixam marcas visíveis no rosto. O contorno facial perde definição, os tecidos se deslocam e a aparência cansada instala-se progressivamente.</p>\n                    </div>\n\n                    <div class=\"problem-item wow-fade-up\" data-delay=\"400\">\n                        <span class=\"problem-item-label\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <polyline points=\"20 6 9 17 4 12\"></polyline>\n                            </svg>\n                            A Solução\n                        </span>\n                        <h3 class=\"problem-item-title\">Protocolo Facelifting®: reposicionamento real</h3>\n                        <p>Técnica exclusiva que utiliza pontos estratégicos de ácido hialurônico para suspender e reposicionar os tecidos da face, proporcionando um efeito lifting natural e duradouro.</p>\n                    </div>\n\n                    <div class=\"solution-box wow-fade-up\" data-delay=\"600\">\n                        <h4 class=\"solution-box-title\">\n                            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path>\n                            </svg>\n                            Resultados Comprovados\n                        </h4>\n                        <p>Melhora do contorno facial, suavização da flacidez, rejuvenescimento harmonioso e resultados que podem postponer ou até evitar cirurgias plásticas.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services-section\" id=\"servicos\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label wow-fade-up\">Tratamentos Exclusivos</span>\n                <h2 class=\"section-title wow-fade-up\" data-delay=\"200\">Protocolo Facelifting®</h2>\n                <p class=\"section-description wow-fade-up\" data-delay=\"400\">Tecnologia avançada associada ao conhecimento em anatomia facial para resultados naturais e personalizados.</p>\n            </div>\n\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path>\n                        </svg>\n                    </div>\n                    <h3 class=\"service-card-title\">Protocolo Facelifting®</h3>\n                    <p class=\"service-card-description\">Reposicionamento não cirúrgico dos tecidos faciais com técnicas exclusivas e ácido hialurônico de alta qualidade.</p>\n                    <a href=\"#contato\" class=\"service-card-link\">\n                        Agendar\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                            <polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                            <path d=\"M8 14s1.5 2 4 2 4-2 4-2\"></path>\n                            <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"></