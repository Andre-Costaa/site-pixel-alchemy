polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials-section\" id=\"diferenciais\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label wow-fade-up\">Por Que Escolher a Beclin</span>\n                <h2 class=\"section-title wow-fade-up\" data-delay=\"200\">Diferenciais Exclusivos</h2>\n                <p class=\"section-description wow-fade-up\" data-delay=\"400\">Excelência em cada detalhe para sua segurança e satisfação.</p>\n            </div>\n\n            <div class=\"differentials-grid\">\n                <div class=\"differential-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"differential-number\">01</div>\n                    <h3 class=\"differential-title\">Protocolo Exclusivo</h3>\n                    <p class=\"differential-description\">O único Protocolo Facelifting® da região, desenvolvido com técnica proprietária e resultados comprovados.</p>\n                </div>\n\n                <div class=\"differential-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"differential-number\">02</div>\n                    <h3 class=\"differential-title\">Formação USP</h3>\n                    <p class=\"differential-description\">Dra. Francine Bianchini: 11 anos de experiência, formada pela USP com especialização em lifting temporal não cirúrgico.</p>\n                </div>\n\n                <div class=\"differential-card wow-fade-up\" data-delay=\"600\">\n                    <div class=\"differential-number\">03</div>\n                    <h3 class=\"differential-title\">Resultados Naturais</h3>\n                    <p class=\"differential-description\">Técnica que respeita sua anatomia e proporciona transformações harmônic