21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path></svg>\n                    </div>\n                    <p class=\"testimonial-quote\">\"Fiz o Protocolo Facelifting® e o resultado superou minhas expectativas. As pessoas dizem que estou com aparência descansada, ninguém diz que fiz algo. Exatamente o que eu queria!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div class=\"testimonial-info\">\n                            <div class=\"testimonial-info-name\">Maria Carolina</div>\n                            <div class=\"testimonial-info-role\">Advogada, 38 anos</div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path></svg>\n                    </div>\n                    <p class=\"testimonial-quote\">\"A Dra. Francine é extremamente profissional e atenciosa. Ela explicou todo o processo e o resultado foi muito natural. Recomendo de olhos fechados!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AS</div>\n                        <div class=\"testimonial-info\">\n                            <div class=\"testimonial-info-name\">Amanda Silva</div>\n                            <div class=\"testimonial-info-role\">Empresária, 42 anos</div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"600\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"><