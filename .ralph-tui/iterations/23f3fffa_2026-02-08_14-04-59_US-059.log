s://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        /* ============================================\n           CSS RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        :root {\n            /* Coral Noir & Seafoam Palette */\n            --color-coral: #E87A7A;\n            --color-coral-light: #F5A3A3;\n            --color-coral-dark: #D65A5A;\n            --color-coral-deep: #B84040;\n\n            --color-seafoam: #7DB4B8;\n            --color-seafoam-light: #A8D4D8;\n            --color-seafoam-dark: #5A9A9E;\n            --color-seafoam-mid: #6AA8AC;\n\n            --color-sand: #F5F0E8;\n            --color-sand-light: #FAF7F2;\n            --color-sand-warm: #E8DFD0;\n\n            --color-coral-black: #1F1A1A;\n            --color-coral-charcoal: #2A2525;\n            --color-coral-stone: #3A3535;\n\n            --color-text-dark: #1F1A1A;\n            --color-text-muted: #6A6058;\n            --color-text-light: #F5F0E8;\n\n            /* Gradients */\n            --gradient-coral: linear-gradient(135deg, #E87A7A 0%, #D65A5A 100%);\n            --gradient-seafoam: linear-gradient(135deg, #7DB4B8 0%, #5A9A9E 100%);\n            --gradient-sand: linear-gradient(135deg, #F5F0E8 0%, #E8DFD0 100%);\n            --gradient-shimmer: linear-gradient(90deg, transparent, rgba(232, 122, 122, 0.3), transparent);\n\n            /* Typography */\n            --font-display: 'Playfair Display', Georgia, serif;\n            --font-body: 'Outfit', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Border Radius - Wave Shapes */\n            --radius-wave-1: 63% 37% 54% 46% / 55% 48% 52% 45%;\n            --radius-wave-2: 47% 53% 38% 62% / 43% 57% 43% 57%;\n            --radius-wave-3: 58% 42% 63% 37% / 48% 52% 48% 52%;\n            --radius-wave-4: 42% 58% 37% 63% / 52% 48% 52% 48%;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(31, 26, 26, 0.08);\n            --shadow-md: 0 8px 24px rgba(31, 26, 26, 0.12);\n            --shadow-lg: 0 16px 48px rgba(31, 26, 26, 0.16);\n            --shadow-coral: 0 8px 32px rgba(232, 122, 122, 0.3);\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.6;\n            color: var(--color-text-dark);\n            background-color: var(--color-sand-light);\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 700;","numLines":100,"startLine":1,"totalLines":1696}}}
