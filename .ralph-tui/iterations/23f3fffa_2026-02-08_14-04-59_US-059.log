ete index.html"},{"content":"Test desktop and mobile responsiveness","status":"pending","activeForm":"Testing desktop and mobile responsiveness"},{"content":"Test WhatsApp form integration","status":"pending","activeForm":"Testing WhatsApp form integration"},{"content":"Update progress.md with learnings","status":"pending","activeForm":"Updating progress.md with learnings"},{"content":"Update checkpoint.md with completion status","status":"pending","activeForm":"Updating checkpoint.md with completion status"}]}}
{"type":"assistant","message":{"id":"msg_202602090105586b0021e3ae5e469c","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_7b267e2d1f624182b9ffc606","name":"Write","input":{"file_path":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/royal-face-ribeirao-preto/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Royal Face Ribeirão Preto | Harmonização Facial e Estética Avançada</title>\n    <meta name=\"description\" content=\"Royal Face Ribeirão Preto - Atendimento especializado em harmonização facial e estética avançada em Ribeirão Preto. Agende sua consulta.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n    <style>\n        /* ============================================\n           CSS RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        :root {\n            /* Regal Burgundy & Gold Noir Palette */\n            --color-burgundy: #7B2A3E;\n            --color-burgundy-light: #9B3A52;\n            --color-burgundy-dark: #5B1A2E;\n            --color-burgundy-deep: #3B0A1E;\n\n            --color-gold: #C9A86C;\n            --color-gold-light: #DCC0A8;\n            --color-gold-dark: #A88A6E;\n            --color-gold-shimmer: #E8DCC8;\n\n            --color-cream: #FAF7F2;\n            --color-cream-warm: #F5EFE4;\n            --color-ivory: #FFFEFA;\n\n            --color-burgundy-black: #1A1518;\n            --color-burgundy-charcoal: #2A2025;\n            --color-burgundy-stone: #3A3035;\n\n            --color-text-dark: #1A1518;\n            --color-text-muted: #6A5558;\n            --color-text-light: #FAF7F2;\n\n            /* Gradients */\n            --gradient-burgundy: linear-gradient(135deg, #7B2A3E 0%, #5B1A2E 100%);\n            --gradient-burgundy-rich: linear-gradient(135deg, #9B3A52 0%, #7B2A3E 50%, #5B1A2E 100%);\n            --gradient-gold: linear-gradient(135deg, #C9A86C 0%, #A88A6E 100%);\n            --gradient-royal: linear-gradient(135deg, #7B2A3E 0%, #C9A86C 100%);\n            --gradient-cream: linear-gradient(135deg, #FAF7F2 0%, #F5EFE4 100%);\n            --gradient-shimmer: linear-gradient(90deg, transparent, rgba(201, 168, 108, 0.4), transparent);\n\n            /* Typography */\n            --font-display: 'Crimson Pro', Georgia, serif;\n            --font-body: 'Manrope', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Border Radius - Crown Shapes */\n            --radius-crown-1: 65% 35% 45% 55% / 50% 45% 55% 50%;\n            --radius-crown-2: 50% 50% 40% 60% / 45% 55% 45% 55%;\n            --radius-crown-3: 55% 45% 55% 45% / 40% 60% 40% 60%;\n            --radius-crown-4: 40% 60% 50% 50% / 55% 45% 55% 45%;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(26, 21, 24, 0.08);\n            --shadow-md: 0 8px 24px rgba(26, 21, 24, 0.12);\n            --shadow-lg: 0 16px 48px rgba(26, 21, 24, 0.16);\n            --shadow-gold: 0 8px 32px rgba(201, 168, 108, 0.35);\n            --shadow-burgundy: 0 8px 32px rgba(123, 42, 62, 0.35);\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.6;\n            color: var(--color-text-dark);\n            background-color: var(--color-cream);\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 700;\n            line-height: 1.2;\n            color: var(--color-burgundy-black);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            letter-spacing: -0.01em;\n        }\n\n        h3 {\n            font-size: clamp(1.25rem, 2.5vw, 1.75rem);\n        }\n\n        p {\n            font-size: 1rem;\n            line-height: 1.7;\n            color: var(--color-text-muted);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            background: rgba(250, 247, 242, 0.95);\n            backdrop-filter: blur(20px);\n            border-bottom: 1px solid rgba(123, 42, 62, 0.1);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav.scrolled {\n            box-shadow: 0 4px 20px rgba(26, 21, 24, 0.1);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 1rem 2rem;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-burgundy);\n            letter-spacing: -0.02em;\n        }\n\n        .nav-logo span {\n            color: var(--color-gold);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: 2rem;\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-dark);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-burgundy);\n            transition: width 0.3s ease;\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.75rem 1.5rem;\n            background: var(--gradient-burgundy);\n            color: var(--color-ivory) !important;\n            border-radius: 50px;\n            font-weight: 600;\n            box-shadow: var(--shadow-burgundy);\n            transition: all 0.3s ease;\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 12px 40px rgba(123, 42, 62, 0.4);\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            cursor: pointer;\n            padding: 10px;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-burgundy);\n            transition: 0.3s ease;\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                right: 0;\n                flex-direction: column;\n                background: var(--color-cream);\n                padding: 2rem;\n                gap: 1.5rem;\n                transform: translateX(100%);\n                transition: transform 0.3s ease;\n                border-top: 1px solid rgba(123, 42, 62, 0.1);\n            }\n\n            .nav-menu.active {\n                transform: translateX(0);\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            position: relative;\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            padding: 120px 2rem 4rem;\n            overflow: hidden;\n        }\n\n        .hero-blobs {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            z-index: 0;\n            pointer-events: none;\n        }\n\n        .hero-blob {\n            position: absolute;\n            opacity: 0.15;\n            filter: blur(80px);\n            animation: crownFloat 20s ease-in-out infinite;\n        }\n\n        .hero-blob-1 {\n            width: 600px;\n            height: 600px;\n            background: var(--gradient-burgundy-rich);\n            border-radius: var(--radius-crown-1);\n            top: -100px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .hero-blob-2 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-gold);\n            border-radius: var(--radius-crown-2);\n            bottom: -50px;\n            left: -100px;\n            animation-delay: -5s;\n        }\n\n        .hero-blob-3 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-burgundy);\n            border-radius: var(--radius-crown-3);\n            top: 50%;\n            left: 30%;\n            transform: translateY(-50%);\n            animation-delay: -10s;\n        }\n\n        .hero-blob-4 {\n            width: 350px;\n            height: 350px;\n            background: var(--gradient-royal);\n            border-radius: var(--radius-crown-4);\n            top: 20%;\n            right: 20%;\n            animation-delay: -15s;\n        }\n\n        @keyframes crownFloat {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg) scale(1.05);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg) scale(0.95);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(3deg) scale(1.02);\n            }\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 1;\n            max-width: 900px;\n            text-align: center;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 0.5rem 1.25rem;\n            background: rgba(123, 42, 62, 0.08);\n            border: 1px solid rgba(123, 42, 62, 0.2);\n            border-radius: 50px;\n            margin-bottom: 2rem;\n            animation: fadeInUp 0.8s ease forwards;\n            opacity: 0;\n        }\n\n        .hero-badge-dot {\n            width: 8px;\n            height: 8px;\n            background: var(--color-gold);\n            border-radius: 50%;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; transform: scale(1); }\n            50% { opacity: 0.6; transform: scale(1.2); }\n        }\n\n        .hero-badge span {\n            font-family: var(--font-body);\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-burgundy);\n            letter-spacing: 0.05em;\n            text-transform: uppercase;\n        }\n\n        .hero-title {\n            margin-bottom: 1.5rem;\n            animation: fadeInUp 0.8s ease 0.2s forwards;\n            opacity: 0;\n        }\n\n        .hero-title-line {\n            display: block;\n        }\n\n        .hero-title-accent {\n            background: var(--gradient-burgundy);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: 1.25rem;\n            color: var(--color-text-muted);\n            margin-bottom: 2.5rem;\n            max-width: 600px;\n            margin-left: auto;\n            margin-right: auto;\n            animation: fadeInUp 0.8s ease 0.4s forwards;\n            opacity: 0;\n        }\n\n        .hero-cta {\n            display: flex;\n            flex-direction: column;\n            gap: 1rem;\n            align-items: center;\n            animation: fadeInUp 0.8s ease 0.6s forwards;\n            opacity: 0;\n        }\n\n        @media (min-width: 480px) {\n            .hero-cta {\n                flex-direction: row;\n                justify-content: center;\n            }\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            border-radius: 50px;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .btn-primary {\n            background: var(--gradient-burgundy);\n            color: var(--color-ivory);\n            border: none;\n            box-shadow: var(--shadow-burgundy);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 12px 40px rgba(123, 42, 62, 0.4);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-burgundy);\n            border: 2px solid var(--color-burgundy);\n        }\n\n        .btn-secondary:hover {\n            background: rgba(123, 42, 62, 0.05);\n            transform: translateY(-3px);\n        }\n\n        .btn-icon {\n            width: 20px;\n            height: 20px;\n            transition: transform 0.3s ease;\n        }\n\n        .btn:hover .btn-icon {\n            transform: translateX(5px);\n        }\n\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        /* ============================================\n           SECTIONS\n           ============================================ */\n        .section {\n            padding: 5rem 2rem;\n            position: relative;\n        }\n\n        .section-header {\n            text-align: center;\n            max-width: 700px;\n            margin: 0 auto 4rem;\n        }\n\n        .section-badge {\n            display: inline-block;\n            font-family: var(--font-body);\n            font-size: 0.8rem;\n            font-weight: 600;\n            color: var(--color-gold);\n            letter-spacing: 0.15em;\n            text-transform: uppercase;\n            margin-bottom: 1rem;\n        }\n\n        .section-title {\n            margin-bottom: 1rem;\n        }\n\n        .section-subtitle {\n            font-size: 1.1rem;\n            color: var(--color-text-muted);\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            background: var(--color-cream-warm);\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: 1fr;\n            gap: 2rem;\n            max-width: 1000px;\n            margin: 0 auto;\n        }\n\n        @media (min-width: 768px) {\n            .problem-solution-grid {\n                grid-template-columns: 1fr 1fr;\n            }\n        }\n\n        .problem-card, .solution-card {\n            background: var(--color-ivory);\n            padding: 2.5rem;\n            border-radius: 24px;\n            position: relative;\n            overflow: hidden;\n            transition: all 0.4s ease;\n        }\n\n        .problem-card {\n            border-left: 4px solid var(--color-burgundy);\n        }\n\n        .solution-card {\n            border-left: 4px solid var(--color-gold);\n        }\n\n        .problem-card:hover, .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .card-icon {\n            width: 60px;\n            height: 60px;\n            border-radius: 16px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n        }\n\n        .problem-card .card-icon {\n            background: rgba(123, 42, 62, 0.1);\n        }\n\n        .solution-card .card-icon {\n            background: rgba(201, 168, 108, 0.15);\n        }\n\n        .card-icon svg {\n            width: 30px;\n            height: 30px;\n        }\n\n        .problem-card .card-icon svg {\n            stroke: var(--color-burgundy);\n        }\n\n        .solution-card .card-icon svg {\n            stroke: var(--color-gold-dark);\n        }\n\n        .problem-card h3, .solution-card h3 {\n            margin-bottom: 1rem;\n            font-size: 1.5rem;\n        }\n\n        .problem-card h3 {\n            color: var(--color-burgundy);\n        }\n\n        .solution-card h3 {\n            color: var(--color-gold-dark);\n        }\n\n        .problem-card ul, .solution-card ul {\n            list-style: none;\n            margin-top: 1.5rem;\n        }\n\n        .problem-card li, .solution-card li {\n            display: flex;\n            align-items: flex-start;\n            gap: 0.75rem;\n            margin-bottom: 0.75rem;\n            font-size: 0.95rem;\n            color: var(--color-text-muted);\n        }\n\n        .problem-card li::before, .solution-card li::before {\n            content: '';\n            width: 6px;\n            height: 6px;\n            border-radius: 50%;\n            margin-top: 8px;\n            flex-shrink: 0;\n        }\n\n        .problem-card li::before {\n            background: var(--color-burgundy);\n        }\n\n        .solution-card li::before {\n            background: var(--color-gold);\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            background: var(--color-ivory);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: 1fr;\n            gap: 1.5rem;\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        @media (min-width: 480px) {\n            .services-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n        }\n\n        @media (min-width: 1024px) {\n            .services-grid {\n                grid-template-columns: repeat(3, 1fr);\n            }\n        }\n\n        .service-card {\n            background: var(--color-cream);\n            padding: 2rem;\n            border-radius: 20px;\n            position: relative;\n            overflow: hidden;\n            transition: all 0.4s ease;\n            border: 1px solid rgba(123, 42, 62, 0.08);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-lg);\n            border-color: rgba(123, 42, 62, 0.2);\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: var(--gradient-burgundy);\n            transform: scaleX(0);\n            transform-origin: left;\n            transition: transform 0.4s ease;\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-icon {\n            width: 55px;\n            height: 55px;\n            background: var(--gradient-burgundy);\n            border-radius: 14px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.25rem;\n        }\n\n        .service-icon svg {\n            width: 28px;\n            height: 28px;\n            stroke: var(--color-ivory);\n        }\n\n        .service-card h3 {\n            margin-bottom: 0.75rem;\n            color: var(--color-burgundy);\n            font-size: 1.25rem;\n        }\n\n        .service-card p {\n            font-size: 0.9rem;\n            margin-bottom: 1.25rem;\n            line-height: 1.6;\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 600;\n            color: var(--color-burgundy);\n            transition: gap 0.3s ease;\n        }\n\n        .service-link:hover {\n            gap: 0.75rem;\n        }\n\n        .service-link svg {\n            width: 16px;\n            height: 16px;\n            stroke: currentColor;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            background: var(--color-burgundy-black);\n            color: var(--color-ivory);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .testimonials::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background: radial-gradient(ellipse at top right, rgba(123, 42, 62, 0.3), transparent 50%);\n            pointer-events: none;\n        }\n\n        .testimonials .section-badge {\n            color: var(--color-gold);\n        }\n\n        .testimonials .section-title {\n            color: var(--color-ivory);\n        }\n\n        .testimonials .section-subtitle {\n            color: rgba(250, 247, 242, 0.7);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: 1fr;\n            gap: 2rem;\n            max-width: 1000px;\n            margin: 0 auto;\n            position: relative;\n            z-index: 1;\n        }\n\n        @media (min-width: 768px) {\n            .testimonials-grid {\n                grid-template-columns: repeat(3, 1fr);\n            }\n        }\n\n        .testimonial-card {\n            background: rgba(42, 32, 37, 0.6);\n            backdrop-filter: blur(10px);\n            padding: 2rem;\n            border-radius: 20px;\n            border: 1px solid rgba(201, 168, 108, 0.15);\n            transition: all 0.4s ease;\n        }\n\n        .testimonial-card:hover {\n            transform: translateY(-5px);\n            border-color: rgba(201, 168, 108, 0.3);\n            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);\n        }\n\n        .testimonial-stars {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: 1rem;\n        }\n\n        .testimonial-stars svg {\n            width: 18px;\n            height: 18px;\n            fill: var(--color-gold);\n        }\n\n        .testimonial-text {\n            font-size: 0.95rem;\n            color: rgba(250, 247, 242, 0.85);\n            margin-bottom: 1.5rem;\n            line-height: 1.7;\n            font-style: italic;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: var(--gradient-burgundy);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-family: var(--font-display);\n            font-weight: 700;\n            font-size: 1.25rem;\n            color: var(--color-ivory);\n        }\n\n        .testimonial-info h4 {\n            font-size: 0.95rem;\n            color: var(--color-ivory);\n            margin-bottom: 0.1rem;\n        }\n\n        .testimonial-info p {\n            font-size: 0.8rem;\n            color: rgba(250, 247, 242, 0.6);\n            margin: 0;\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            background: var(--color-cream-warm);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: 1fr;\n            gap: 1.5rem;\n            max-width: 1000px;\n            margin: 0 auto;\n        }\n\n        @media (min-width: 480px) {\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n        }\n\n        @media (min-width: 768px) {\n            .differentials-grid {\n                grid-template-columns: repeat(3, 1fr);\n            }\n        }\n\n        .differential-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n            padding: 1.5rem;\n            background: var(--color-ivory);\n            border-radius: 16px;\n            transition: all 0.3s ease;\n        }\n\n        .differential-item:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-md);\n        }\n\n        .differential-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-gold);\n            border-radius: 12px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n            position: relative;\n        }\n\n        .differential-icon::before {\n            content: '';\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            border-radius: 12px;\n            border: 2px solid var(--color-gold);\n            opacity: 0.3;\n            animation: ringPulse 2s ease-in-out infinite;\n        }\n\n        @keyframes ringPulse {\n            0%, 100% {\n                transform: scale(1);\n                opacity: 0.3;\n            }\n            50% {\n                transform: scale(1.15);\n                opacity: 0;\n            }\n        }\n\n        .differential-icon svg {\n            width: 24px;\n            height: 24px;\n            stroke: var(--color-burgundy-deep);\n            position: relative;\n            z-index: 1;\n        }\n\n        .differential-content h4 {\n            margin-bottom: 0.5rem;\n            color: var(--color-burgundy);\n            font-size: 1.1rem;\n        }\n\n        .differential-content p {\n            font-size: 0.9rem;\n            margin: 0;\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            background: var(--color-ivory);\n        }\n\n        .contact-container {\n            display: grid;\n            grid-template-columns: 1fr;\n            gap: 3rem;\n            max-width: 1000px;\n            margin: 0 auto;\n        }\n\n        @media (min-width: 768px) {\n            .contact-container {\n                grid-template-columns: 1fr 1.5fr;\n            }\n        }\n\n        .contact-info {\n            padding: 2rem;\n        }\n\n        .contact-info h3 {\n            margin-bottom: 1.5rem;\n            color: var(--color-burgundy);\n        }\n\n        .contact-info-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n            margin-bottom: 1.5rem;\n        }\n\n        .contact-info-item svg {\n            width: 22px;\n            height: 22px;\n            stroke: var(--color-burgundy);\n            flex-shrink: 0;\n            margin-top: 2px;\n        }\n\n        .contact-info-item h4 {\n            font-size: 0.95rem;\n            margin-bottom: 0.25rem;\n            color: var(--color-burgundy);\n        }\n\n        .contact-info-item p {\n            font-size: 0.9rem;\n            margin: 0;\n        }\n\n        .contact-form {\n            background: var(--color-cream);\n            padding: 2.5rem;\n            border-radius: 24px;\n            box-shadow: var(--shadow-md);\n        }\n\n        .form-group {\n            margin-bottom: 1.5rem;\n        }\n\n        .form-label {\n            display: block;\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 600;\n            color: var(--color-burgundy);\n            margin-bottom: 0.5rem;\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 0.9rem 1.25rem;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            color: var(--color-text-dark);\n            background: var(--color-ivory);\n            border: 2px solid rgba(123, 42, 62, 0.1);\n            border-radius: 12px;\n            transition: all 0.3s ease;\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-burgundy);\n            box-shadow: 0 0 0 4px rgba(123, 42, 62, 0.1);\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1rem 2rem;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            color: var(--color-ivory);\n            background: var(--gradient-burgundy);\n            border: none;\n            border-radius: 50px;\n            cursor: pointer;\n            transition: all 0.3s ease;\n        }\n\n        .form-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-burgundy);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--color-burgundy-black);\n            color: var(--color-ivory);\n            padding: 4rem 2rem 2rem;\n        }\n\n        .footer-content {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr;\n            gap: 3rem;\n            padding-bottom: 3rem;\n            border-bottom: 1px solid rgba(201, 168, 108, 0.15);\n        }\n\n        @media (min-width: 768px) {\n            .footer-content {\n                grid-template-columns: 2fr 1fr 1fr;\n            }\n        }\n\n        .footer-brand h2 {\n            color: var(--color-ivory);\n            margin-bottom: 0.5rem;\n            font-size: 1.75rem;\n        }\n\n        .footer-brand span {\n            color: var(--color-gold);\n        }\n\n        .footer-brand p {\n            color: rgba(250, 247, 242, 0.7);\n            font-size: 0.95rem;\n            margin-bottom: 1.5rem;\n        }\n\n        .footer-social {\n            display: flex;\n            gap: 1rem;\n        }\n\n        .footer-social a {\n            width: 40px;\n            height: 40px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: rgba(201, 168, 108, 0.15);\n            border-radius: 50%;\n            transition: all 0.3s ease;\n        }\n\n        .footer-social a:hover {\n            background: var(--color-gold);\n            transform: translateY(-3px);\n        }\n\n        .footer-social a svg {\n            width: 18px;\n            height: 18px;\n            stroke: var(--color-gold);\n            transition: stroke 0.3s ease;\n        }\n\n        .footer-social a:hover svg {\n            stroke: var(--color-burgundy-deep);\n        }\n\n        .footer-column h3 {\n            color: var(--color-gold);\n            font-size: 1rem;\n            margin-bottom: 1.25rem;\n        }\n\n        .footer-links {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.75rem;\n        }\n\n        .footer-links a {\n            color: rgba(250, 247, 242, 0.7);\n            font-size: 0.95rem;\n            transition: color 0.3s ease;\n        }\n\n        .footer-links a:hover {\n            color: var(--color-gold);\n        }\n\n        .footer-bottom {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding-top: 2rem;\n            text-align: center;\n        }\n\n        .footer-bottom p {\n            color: rgba(250, 247, 242, 0.5);\n            font-size: 0.85rem;\n            margin: 0;\n        }\n\n        /* ============================================\n           SCROLL ANIMATIONS\n           ============================================ */\n        .wow {\n            opacity: 0;\n            transform: translateY(40px);\n            transition: all 0.8s ease;\n        }\n\n        .wow.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-delay-1 { transition-delay: 0.1s; }\n        .wow-delay-2 { transition-delay: 0.2s; }\n        .wow-delay-3 { transition-delay: 0.3s; }\n        .wow-delay-4 { transition-delay: 0.4s; }\n        .wow-delay-5 { transition-delay: 0.5s; }\n        .wow-delay-6 { transition-delay: 0.6s; }\n\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        /* ============================================\n           RESPONSIVE ADJUSTMENTS\n           ============================================ */\n        @media (max-width: 768px) {\n            .section {\n                padding: 3.5rem 1.5rem;\n            }\n\n            .section-header {\n                margin-bottom: 2.5rem;\n            }\n\n            .problem-card, .solution-card {\n                padding: 1.75rem;\n            }\n\n            .contact-form {\n                padding: 1.75rem;\n            }\n\n            .service-card, .testimonial-card, .differential-item {\n                padding: 1.5rem;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Royal<span>Face</span></a>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#inicio\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#contato\" class=\"nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <div class=\"nav-toggle\" id=\"navToggle\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-blobs\">\n            <div class=\"hero-blob hero-blob-1\"></div>\n            <div class=\"hero-blob hero-blob-2\"></div>\n            <div class=\"hero-blob hero-blob-3\"></div>\n            <div class=\"hero-blob hero-blob-4\"></div>\n        </div>\n        <div class=\"hero-content\">\n            <div class=\"hero-badge\">\n                <span class=\"hero-badge-dot\"></span>\n                <span>Estética Avançada em Ribeirão Preto</span>\n            </div>\n            <h1 class=\"hero-title\">\n                <span class=\"hero-title-line\">Sua Beleza Real</span>\n                <span class=\"hero-title-line hero-title-accent\">Revelada com Elegância</span>\n            </h1>\n            <p class=\"hero-subtitle\">\n                Harmonização facial e estética avançada com resultados naturais e sofisticados. Descubra a melhor versão de si mesma com tratamentos personalizados.\n            </p>\n            <div class=\"hero-cta\">\n                <a href=\"#contato\" class=\"btn btn-primary\">\n                    Agendar Avaliação\n                    <svg class=\"btn-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                    </svg>\n                </a>\n                <a href=\"#servicos\" class=\"btn btn-secondary\">\n                    Conhecer Tratamentos\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\" id=\"problema-solucao\">\n        <div class=\"section-header wow\">\n            <span class=\"section-badge\">Transformação Real</span>\n            <h2 class=\"section-title\">Sua Jornada de Beleza</h2>\n            <p class=\"section-subtitle\">Entendemos suas preocupações e oferecemos soluções que realçam sua beleza natural.</p>\n        </div>\n        <div class=\"problem-solution-grid\">\n            <div class=\"problem-card wow wow-delay-1\">\n                <div class=\"card-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                        <path d=\"M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01\"/>\n                    </svg>\n                </div>\n                <h3>Desafios que Compreendemos</h3>\n                <p>Envelhecimento facial, perda de contorno, linhas de expressão e assimetrias podem afetar sua autoestima. Sabemos que cada rosto é único.</p>\n                <ul>\n                    <li>Sinais de envelhecimento precoce</li>\n                    <li>Perda de volume e definição</li>\n                    <li>Rugas e linhas de expressão</li>\n                    <li>Desejo de harmonia facial</li>\n                </ul>\n            </div>\n            <div class=\"solution-card wow wow-delay-2\">\n                <div class=\"card-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\">\n                        <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                    </svg>\n                </div>\n                <h3>Soluções que Encantam</h3>\n                <p>Protocolos personalizados com tecnologia avançada e produtos premium para resultados naturais e duradouros.</p>\n                <ul>\n                    <li>Harmonização facial integrada</li>\n                    <li>Resultados naturais e sutis</li>\n                    <li>Técnicas minimamente invasivas</li>\n                    <li>Acompanhamento personalizado</li>\n                </ul>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"section-header wow\">\n            <span class=\"section-badge\">Tratamentos Exclusivos</span>\n            <h2 class=\"section-title\">Nossos Serviços</h2>\n            <p class=\"section-subtitle\">Procedimentos estéticos avançados para realçar sua beleza com naturalidade.</p>\n        </div>\n        <div class=\"services-grid\">\n            <div class=\"service-card wow wow-delay-1\">\n                <div class=\"service-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\">\n                        <circle cx=\"12\" cy=\"8\" r=\"5\"/>\n                        <path d=\"M3 21c0-5 4-9 9-9s9 4 9 9\"/>\n                    </svg>\n                </div>\n                <h3>Harmonização Facial</h3>\n                <p>Equilibre seus traços faciais com produtos de alta qualidade para uma aparência harmônica e natural.</p>\n                <a href=\"#contato\" class=\"service-link\">\n                    Saiba mais\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\">\n                        <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                    </svg>\n                </a>\n            </div>\n            <div class=\"service-card wow wow-delay-2\">\n                <div class=\"service-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\">\n                        <path d=\"M9 12h6M12 9v6M3 12a9 9 0 1 1 18 0 9 9 0 0 1-18 0z\"/>\n                    </svg>\n                </div>\n                <h3>Toxina Botulínica</h3>\n                <p>Suavize linhas de expressão e previna novas rugas com aplicação precisa e personalizada.</p>\n                <a href=\"#contato\" class=\"service-link\">\n                    Saiba mais\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\">\n                        <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                    </svg>\n                </a>\n            </div>\n            <div class=\"service-card wow wow-delay-3\">\n                <div class=\"service-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\">\n                        <path d=\"M12 2L15 8L21 9L17 14L18 20L12 17L6 20L7 14L3 9L9 8L12 2Z\"/>\n                    </svg>\n                </div>\n                <h3>Preenchedores Faciais</h3>\n                <p>Restaure volume e contorno facial com ácido hialurônico de alta densidade e longa duração.</p>\n                <a href=\"#contato\" class=\"service-link\">\n                    Saiba mais\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\">\n                        <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                    </svg>\n                </a>\n            </div>\n            <div class=\"service-card wow wow-delay-4\">\n                <div class=\"service-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\">\n                        <path d=\"M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16z\"/>\n                        <path d=\"M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z\"/>\n                        <path d=\"M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41\"/>\n                    </svg>\n                </div>\n                <h3>Bioestimuladores</h3>\n                <p>Estimule o colágeno natural para uma pele mais firme, jovem e com brilho saudável.</p>\n                <a href=\"#contato\" class=\"service-link\">\n                    Saiba mais\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2\">\n                