        <button type=\"submit\" class=\"form-submit\">Enviar Mensagem</button>\n            </form>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-brand\">\n                <h4>Dra. Camila Barcellos</h4>\n                <p>Medicina e Autoestima - Transformando vidas através da harmonização facial e estética avançada em Ribeirão Preto.</p>\n            </div>\n            <div class=\"footer-links\">\n                <h5>Links Rápidos</h5>\n                <ul>\n                    <li><a href=\"#inicio\">Início</a></li>\n                    <li><a href=\"#servicos\">Serviços</a></li>\n                    <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                    <li><a href=\"#contato\">Contato</a></li>\n                </ul>\n            </div>\n            <div class=\"footer-links\">\n                <h5>Serviços</h5>\n                <ul>\n                    <li><a href=\"#servicos\">Harmonização Facial</a></li>\n                    <li><a href=\"#servicos\">Toxina Botulínica</a></li>\n                    <li><a href=\"#servicos\">Preenchedores</a></li>\n                    <li><a href=\"#servicos\">Bioestimuladores</a></li>\n                </ul>\n            </div>\n        </div>\n        <div class=\"footer-bottom\">\n            <p>© 2024 Dra. Camila Barcellos - Medicina e Autoestima. Todos os direitos reservados.</p>\n        </div>\n    </footer>\n\n    <script>\n        // Navigation scroll behavior\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > lastScroll && currentScroll > 100) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Mobile menu\n        const navMenuBtn = document.getElementById('navMenuBtn');\n        const navMobile = document.getElementById('navMobile');\n\n        navMenuBtn.addEventListener('click', () => {\n            navMobile.classList.toggle('active');\n            navMenuBtn.textContent = navMobile.classList.contains('active') ? '✕' : '☰';\n        });\n\n        // Close mobile menu on link click\n        navMobile.querySelectorAll('a').forEach(link => {\n            link.addEventListener('click', () => {\n                navMobile.classList.remove('active');\n                navMenuBtn.textContent = '☰';\n            });\n        });\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // Intersection Observer for scroll animations\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('animated');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow').forEach(el => {\n            observer.observe(el);\n        });\n\n        // Contact form submission to WhatsApp\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const email = document.getElementById('email').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceNames = {\n                'harmonizacao': 'Harmonização Facial',\n                'botox': 'Toxina Botulínica',\n                'preenchedores': 'Preenchedores Faciais',\n                'labios': 'Preenchimento Labial',\n                'bioestimuladores': 'Bioestimuladores',\n                'protocolos': 'Protocolos Exclusivos'\n            };\n\n            const whatsappMessage = encodeURIComponent(\n                `Olá! Meu nome é ${name}.\\n\\n` +\n                `Gostaria de agendar uma consulta para: ${serviceNames[service]}\\n\\n` +\n                `Mensagem: ${message}\\n\\n` +\n                `E-mail: ${email}`\n            );\n\n            window.open(`https://wa.me/5514997934138?text=${whatsappMessage}`, '_blank');\n        });\n\n        // Parallax effect for hero blobs (only on desktop)\n        if (window.matchMedia('(min-width: 1024px)').matches) {\n            document.addEventListener('mousemove', (e) => {\n                const moveX = (e.clientX - window.innerWidth / 2) * 0.01;\n                const moveY = (e.clientY - window.innerHeight / 2) * 0.01;\n\n                document.querySelectorAll('.hero-blob').forEach((blob, index) => {\n                    const speed = (index + 1) * 0.5;\n                    blob.style.transform = `translate(${moveX * speed}px, ${moveY * speed}px)`;\n                });\n            });\n        }\n\n        // Respect reduced motion preference\n        window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', () => {\n            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n                document.querySelectorAll('.hero-blob').forEach(blob => {\n                    blob.style.animation = 'none';\n                });\n            }\n        });\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"6a3d7433-f995-4a39-bf73-25f0440177be","uuid":"8ac0acbc-6a0d-4d30-897b-d3412d3a3491"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_20e078d98f4e4ff7b6868ee5","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-camila-barcellos/index.html"}]},"parent_tool_use_id":null,"session_id":"6a3d7433-f995-4a39-bf73-25f0440177be","uuid":"a4b301d3-63d9-4bf0-ba89-1988c28e3bee","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-camila-barcellos/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Camila Barcellos | Medicina e Autoestima - Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Camila Barcellos - Medicina e Autoestima. Harmonização facial e estética avançada em Ribeirão Preto. Transforme sua autoestima com tratamentos personalizados.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            /* Orchid Noir & Antique Brass Palette */\n            --color-orchid: #8B5A8A;\n            --color-orchid-light: #A87AA8;\n            --color-orchid-mid: #986A98;\n            --color-orchid-dark: #6B3A6B;\n            --color-orchid-deep: #4B2A4B;\n            --color-orchid-mist: #F0E8F0;\n\n            --color-brass: #A87848;\n            --color-brass-light: #B88858;\n            --color-brass-mid: #C89868;\n            --color-brass-dark: #986838;\n            --color-brass-deep: #784828;\n            --color-brass-shimmer: #D8A878;\n\n            --color-porcelain: #FAFAF8;\n            --color-porcelain-warm: #F5F5F2;\n            --color-porcelain-soft: #F0F0EC;\n            --color-ivory: #F8F6F4;\n\n            --color-charcoal: #2A2828;\n            --color-charcoal-dark: #1A1818;\n            --color-ink: #1A1A1A;\n            --color-ink-deep: #0F0F12;\n\n            /* Gradients */\n            --gradient-orchid: linear-gradient(135deg, var(--color-orchid) 0%, var(--color-orchid-light) 50%, var(--color-brass) 100%);\n            --gradient-orchid-soft: linear-gradient(135deg, var(--color-orchid-mist) 0%, var(--color-porcelain) 100%);\n            --gradient-brass: linear-gradient(135deg, var(--color-brass) 0%, var(--color-brass-mid) 100%);\n\n            /* Typography */\n            --font-display: 'Crimson Pro', Georgia, serif;\n            --font-body: 'Plus Jakarta Sans', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 1.5rem;\n            --spacing-lg: 2rem;\n            --spacing-xl: 3rem;\n            --spacing-2xl: 4rem;\n            --spacing-3xl: 6rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 12px;\n            --radius-lg: 20px;\n            --radius-orchid-1: 68% 32% 52% 48% / 52% 38% 62% 48%;\n            --radius-orchid-2: 48% 52% 62% 38% / 42% 58% 42% 58%;\n            --radius-orchid-3: 58% 42% 48% 52% / 52% 48% 52% 48%;\n            --radius-orchid-4: 42% 58% 52% 48% / 48% 52% 48% 52%;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.3s ease;\n            --transition-slow: 0.5s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(139, 90, 138, 0.08);\n            --shadow-md: 0 4px 16px rgba(139, 90, 138, 0.12);\n            --shadow-lg: 0 8px 32px rgba(139, 90, 138, 0.16);\n            --shadow-brass: 0 4px 20px rgba(168, 120, 72, 0.15);\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background-color: var(--color-porcelain);\n            color: var(--color-charcoal);\n            line-height: 1.6;\n            overflow-x: hidden;\n        }\n\n        /* Typography */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-charcoal-dark);\n        }\n\n        h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); }\n        h2 { font-size: clamp(2rem, 4vw, 3rem); }\n        h3 { font-size: clamp(1.25rem, 2.5vw, 1.75rem); }\n\n        p {\n            font-size: clamp(0.95rem, 1.2vw, 1.1rem);\n            color: var(--color-charcoal);\n            opacity: 0.85;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* Navigation */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-md) var(--spacing-lg);\n            background: rgba(250, 250, 248, 0.95);\n            backdrop-filter: blur(10px);\n            border-bottom: 1px solid rgba(139, 90, 138, 0.1);\n            transition: transform 0.3s ease, padding 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-orchid-dark);\n        }\n\n        .nav-links {\n            display: flex;\n            gap: var(--spacing-lg);\n            list-style: none;\n        }\n\n        .nav-links a {\n            font-weight: 500;\n            font-size: 0.95rem;\n            color: var(--color-charcoal);\n            position: relative;\n        }\n\n        .nav-links a::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-orchid);\n            transition: width var(--transition-base);\n        }\n\n        .nav-links a:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.6rem 1.4rem;\n            background: var(--gradient-orchid);\n            color: white;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            transition: var(--transition-base);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-brass);\n        }\n\n        .nav-menu-btn {\n            display: none;\n            background: none;\n            border: none;\n            font-size: 1.5rem;\n            cursor: pointer;\n            color: var(--color-orchid-dark);\n        }\n\n        /* Mobile Menu */\n        .nav-mobile {\n            display: none;\n            position: fixed;\n            top: 70px;\n            left: 0;\n            right: 0;\n            background: var(--color-porcelain);\n            padding: var(--spacing-lg);\n            border-bottom: 1px solid rgba(139, 90, 138, 0.1);\n            z-index: 999;\n        }\n\n        .nav-mobile.active {\n            display: block;\n        }\n\n        .nav-mobile-links {\n            list-style: none;\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-md);\n        }\n\n        .nav-mobile-links a {\n            font-weight: 500;\n            padding: var(--spacing-sm) 0;\n            border-bottom: 1px solid rgba(139, 90, 138, 0.1);\n        }\n\n        /* Hero Section */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            padding: var(--spacing-3xl) var(--spacing-lg);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .hero-blobs {\n            position: absolute;\n            inset: 0;\n            overflow: hidden;\n            z-index: 0;\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-orchid-1);\n            filter: blur(60px);\n            opacity: 0.4;\n            animation: orchidFloat 20s ease-in-out infinite;\n        }\n\n        .hero-blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-orchid);\n            top: -150px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .hero-blob-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-brass);\n            bottom: -100px;\n            left: -100px;\n            animation-delay: 5s;\n        }\n\n        .hero-blob-3 {\n            width: 300px;\n            height: 300px;\n            background: var(--color-orchid-mist);\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: 10s;\n        }\n\n        .hero-blob-4 {\n            width: 350px;\n            height: 350px;\n            background: linear-gradient(135deg, var(--color-brass-shimmer) 0%, var(--color-orchid-light) 100%);\n            bottom: 20%;\n            right: 10%;\n            animation-delay: 15s;\n        }\n\n        @keyframes orchidFloat {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n                border-radius: var(--radius-orchid-1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg) scale(1.05);\n                border-radius: var(--radius-orchid-2);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg) scale(0.95);\n                border-radius: var(--radius-orchid-3);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(3deg) scale(1.02);\n                border-radius: var(--radius-orchid-4);\n            }\n        }\n\n        .hero-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-3xl);\n            align-items: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .hero-content {\n            opacity: 0;\n            animation: fadeUp 0.8s ease forwards;\n            animation-delay: 0ms;\n        }\n\n        .hero-badge {\n            display: inline-block;\n            padding: 0.5rem 1rem;\n            background: var(--gradient-orchid-soft);\n            color: var(--color-orchid-dark);\n            border-radius: var(--radius-lg);\n            font-weight: 600;\n            font-size: 0.85rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            color: var(--color-orchid-deep);\n        }\n\n        .hero-title span {\n            background: var(--gradient-orchid);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: 1.25rem;\n            margin-bottom: var(--spacing-lg);\n            color: var(--color-charcoal);\n        }\n\n        .hero-description {\n            margin-bottom: var(--spacing-xl);\n            max-width: 500px;\n        }\n\n        .hero-ctas {\n            display: flex;\n            gap: var(--spacing-md);\n            flex-wrap: wrap;\n        }\n\n        .btn-primary {\n            padding: 1rem 2rem;\n            background: var(--gradient-orchid);\n            color: white;\n            border: none;\n            border-radius: var(--radius-lg);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .btn-primary::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            background: var(--gradient-brass);\n            opacity: 0;\n            transition: var(--transition-base);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-brass);\n        }\n\n        .btn-primary:hover::before {\n            opacity: 1;\n        }\n\n        .btn-primary span {\n            position: relative;\n            z-index: 1;\n        }\n\n        .btn-secondary {\n            padding: 1rem 2rem;\n            background: transparent;\n            color: var(--color-orchid-dark);\n            border: 2px solid var(--color-orchid);\n            border-radius: var(--radius-lg);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-orchid-mist);\n            transform: translateY(-2px);\n        }\n\n        .hero-visual {\n            position: relative;\n            opacity: 0;\n            animation: fadeUp 0.8s ease forwards;\n            animation-delay: 200ms;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            border-radius: var(--radius-lg);\n            overflow: hidden;\n        }\n\n        .hero-image {\n            width: 100%;\n            height: auto;\n            display: block;\n            border-radius: var(--radius-lg);\n        }\n\n        .hero-floating-card {\n            position: absolute;\n            background: white;\n            padding: var(--spacing-md);\n            border-radius: var(--radius-md);\n            box-shadow: var(--shadow-lg);\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n            animation: floatCard 6s ease-in-out infinite;\n        }\n\n        .hero-floating-card-1 {\n            top: 10%;\n            left: -20px;\n        }\n\n        .hero-floating-card-2 {\n            bottom: 15%;\n            right: -20px;\n            animation-delay: 3s;\n        }\n\n        .floating-card-icon {\n            width: 40px;\n            height: 40px;\n            background: var(--gradient-orchid);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            flex-shrink: 0;\n        }\n\n        .floating-card-text strong {\n            display: block;\n            font-size: 0.9rem;\n            color: var(--color-orchid-dark);\n        }\n\n        .floating-card-text span {\n            font-size: 0.75rem;\n            color: var(--color-charcoal);\n        }\n\n        @keyframes floatCard {\n            0%, 100% { transform: translateY(0); }\n            50% { transform: translateY(-10px); }\n        }\n\n        @keyframes fadeUp {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        /* Sections */\n        .section {\n            padding: var(--spacing-3xl) var(--spacing-lg);\n        }\n\n        .section-header {\n            text-align: center;\n            max-width: 700px;\n            margin: 0 auto var(--spacing-2xl);\n        }\n\n        .section-tag {\n            display: inline-block;\n            padding: 0.4rem 1rem;\n            background: var(--gradient-orchid-soft);\n            color: var(--color-orchid-dark);\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 0.85rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .section-title {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .section-description {\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        /* Problem/Solution Section */\n        .problem-section {\n            background: var(--color-ivory);\n        }\n\n        .problem-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: var(--spacing-xl);\n        }\n\n        .problem-card {\n            background: white;\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            border-left: 4px solid;\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .problem-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            right: 0;\n            width: 100px;\n            height: 100px;\n            border-radius: 50%;\n            filter: blur(40px);\n            opacity: 0.3;\n        }\n\n        .problem-card.problem {\n            border-color: var(--color-orchid);\n        }\n\n        .problem-card.problem::before {\n            background: var(--color-orchid);\n        }\n\n        .problem-card.solution {\n            border-color: var(--color-brass);\n        }\n\n        .problem-card.solution::before {\n            background: var(--color-brass);\n        }\n\n        .problem-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-md);\n        }\n\n        .problem-icon {\n            width: 60px;\n            height: 60px;\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .problem .problem-icon {\n            background: var(--color-orchid-mist);\n            color: var(--color-orchid-dark);\n        }\n\n        .solution .problem-icon {\n            background: var(--color-brass-shimmer);\n            color: var(--color-brass-dark);\n        }\n\n        .problem-card h3 {\n            margin-bottom: var(--spacing-sm);\n        }\n\n        /* Services Section */\n        .services-section {\n            background: var(--color-porcelain);\n        }\n\n        .services-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .service-card {\n            background: white;\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            text-align: center;\n            transition: var(--transition-base);\n            border: 1px solid rgba(139, 90, 138, 0.1);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-orchid);\n            transform: scaleX(0);\n            transform-origin: left;\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-icon {\n            width: 80px;\n            height: 80px;\n            margin: 0 auto var(--spacing-md);\n            background: var(--gradient-orchid-soft);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-orchid-dark);\n        }\n\n        .service-card h3 {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-orchid-deep);\n        }\n\n        .service-card p {\n            font-size: 0.95rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-brass);\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: var(--transition-base);\n        }\n\n        .service-link:hover {\n            gap: 0.75rem;\n            color: var(--color-brass-dark);\n        }\n\n        /* Testimonials Section */\n        .testimonials-section {\n            background: var(--color-orchid-deep);\n            color: white;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .testimonials-section .section-tag {\n            background: rgba(255, 255, 255, 0.15);\n            color: white;\n        }\n\n        .testimonials-section .section-title,\n        .testimonials-section .section-description {\n            color: white;\n        }\n\n        .testimonials-section .section-description {\n            opacity: 0.9;\n        }\n\n        .testimonials-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.1);\n            backdrop-filter: blur(10px);\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            border: 1px solid rgba(255, 255, 255, 0.15);\n            transition: var(--transition-base);\n        }\n\n        .testimonial-card:hover {\n            transform: translateY(-5px);\n            background: rgba(255, 255, 255, 0.15);\n        }\n\n        .testimonial-stars {\n            color: var(--color-brass-mid);\n            margin-bottom: var(--spacing-md);\n            font-size: 1.1rem;\n        }\n\n        .testimonial-text {\n            color: white;\n            opacity: 0.95;\n            margin-bottom: var(--spacing-md);\n            font-style: italic;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: var(--gradient-orchid);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-weight: 600;\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n            color: white;\n        }\n\n        .testimonial-role {\n            font-size: 0.85rem;\n            color: rgba(255, 255, 255, 0.7);\n        }\n\n        /* Differentials Section */\n        .differentials-section {\n            background: var(--color-porcelain-warm);\n        }\n\n        .differentials-grid {\n            max-width: 1000px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .differential-item {\n            display: flex;\n            gap: var(--spacing-md);\n            align-items: flex-start;\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            flex-shrink: 0;\n        }\n\n        .differential-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-orchid);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            position: relative;\n            z-index: 1;\n        }\n\n        .differential-icon-wrapper::before {\n            content: '';\n            position: absolute;\n            inset: -5px;\n            border-radius: var(--radius-md);\n            background: var(--gradient-orchid);\n            opacity: 0.3;\n            animation: pulseRing 2s ease-in-out infinite;\n        }\n\n        @keyframes pulseRing {\n            0%, 100% { transform: scale(1); opacity: 0.3; }\n            50% { transform: scale(1.1); opacity: 0.1; }\n        }\n\n        .differential-content h4 {\n            margin-bottom: 0.3rem;\n            color: var(--color-orchid-deep);\n        }\n\n        .differential-content p {\n            font-size: 0.9rem;\n        }\n\n        /* Contact Section */\n        .contact-section {\n            background: var(--color-ivory);\n        }\n\n        .contact-container {\n            max-width: 1000px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-2xl);\n            align-items: start;\n        }\n\n        .contact-info h3 {\n            margin-bottom: var(--spacing-md);\n            color: var(--color-orchid-deep);\n        }\n\n        .contact-info p {\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .contact-details {\n            list-style: none;\n        }\n\n        .contact-details li {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n            margin-bottom: var(--spacing-md);\n            padding: var(--spacing-sm);\n            background: white;\n            border-radius: var(--radius-md);\n            transition: var(--transition-base);\n        }\n\n        .contact-details li:hover {\n            transform: translateX(5px);\n            box-shadow: var(--shadow-sm);\n        }\n\n        .contact-details-icon {\n            width: 40px;\n            height: 40px;\n            background: var(--gradient-orchid-soft);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-orchid-dark);\n            flex-shrink: 0;\n        }\n\n        .contact-details-text strong {\n            display: block;\n            font-size: 0.9rem;\n            color: var(--color-charcoal-dark);\n        }\n\n        .contact-details-text span {\n            font-size: 0.85rem;\n            color: var(--color-charcoal);\n        }\n\n        .contact-form {\n            background: white;\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-md);\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-group label {\n            display: block;\n            font-weight: 600;\n            margin-bottom: 0.5rem;\n            color: var(--color-charcoal-dark);\n        }\n\n        .form-group input,\n        .form-group select,\n        .form-group textarea {\n            width: 100%;\n            padding: 0.8rem 1rem;\n            border: 2px solid rgba(139, 90, 138, 0.2);\n            border-radius: var(--radius-md);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: var(--transition-base);\n            background: var(--color-porcelain);\n        }\n\n        .form-group input:focus,\n        .form-group select:focus,\n        .form-group textarea:focus {\n            outline: none;\n            border-color: var(--color-orchid);\n            background: white;\n        }\n\n        .form-group textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1rem;\n            background: var(--gradient-orchid);\n            color: white;\n            border: none;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-brass);\n        }\n\n        /* Footer */\n        .footer {\n            background: var(--color-ink-deep);\n            color: white;\n            padding: var(--spacing-2xl) var(--spacing-lg) var(--spacing-lg);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: var(--spacing-2xl);\n            margin-bottom: var(--spacing-xl);\n        }\n\n        .footer-brand h4 {\n            font-size: 1.5rem;\n            margin-bottom: var(--spacing-sm);\n            color: white;\n        }\n\n        .footer-brand p {\n            color: rgba(255, 255, 255, 0.7);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .footer-links h5 {\n            margin-bottom: var(--spacing-md);\n            color: var(--color-brass-mid);\n        }\n\n        .footer-links ul {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-links a {\n            color: rgba(255, 255, 255, 0.7);\n            transition: var(--transition-base);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-brass-mid);\n            padding-left: 5px;\n        }\n\n        .footer-bottom {\n            text-align: center;\n            padding-top: var(--spacing-lg);\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n        }\n\n        .footer-bottom p {\n            color: rgba(255, 255, 255, 0.5);\n            font-size: 0.9rem;\n        }\n\n        /* Scroll Animations */\n        .wow {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow.animated {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-delay-1 { transition-delay: 0.1s; }\n        .wow-delay-2 { transition-delay: 0.2s; }\n        .wow-delay-3 { transition-delay: 0.3s; }\n        .wow-delay-4 { transition-delay: 0.4s; }\n        .wow-delay-5 { transition-delay: 0.5s; }\n        .wow-delay-6 { transition-delay: 0.6s; }\n\n        /* Responsive */\n        @media (max-width: 1024px) {\n            .services-grid,\n            .testimonials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .hero-floating-card {\n                display: none;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-links,\n            .nav-cta {\n                display: none;\n            }\n\n            .nav-menu-btn {\n                display: block;\n            }\n\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-ctas {\n                justify-content: center;\n            }\n\n            .hero-visual {\n                order: -1;\n            }\n\n            .problem-grid,\n            .contact-container {\n                grid-template-columns: 1fr;\n            }\n\n            .services-grid,\n            .testimonials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .section {\n                padding: var(--spacing-2xl) var(--spacing-md);\n            }\n        }\n\n        @media (max-width: 480px) {\n            h1 { font-size: 2rem; }\n            h2 { font-size: 1.75rem; }\n\n            .hero-ctas {\n                flex-direction: column;\n            }\n\n            .btn-primary,\n            .btn-secondary {\n                width: 100%;\n            }\n        }\n\n        /* Reduced Motion */\n        @media (prefers-reduced-motion: reduce) {\n            *,\n            *::before,\n            *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Camila Barcellos</a>\n            <ul class=\"nav-links\">\n                <li><a href=\"#inicio\">Início</a></li>\n                <li><a href=\"#servicos\">Serviços</a></li>\n                <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                <li><a href=\"#diferenciais\">Diferenciais</a></li>\n                <li><a href=\"#contato\">Contato</a></li>\n            </ul>\n            <a href=\"#contato\" class=\"nav-cta\">Agendar Consulta</a>\n            <button class=\"nav-menu-btn\" id=\"navMenuBtn\">☰</button>\n        </div>\n    </nav>\n\n    <div class=\"nav-mobile\" id=\"navMobile\">\n        <ul class=\"nav-mobile-links\">\n            <li><a href=\"#inicio\">Início</a></li>\n            <li><a href=\"#servicos\">Serviços</a></li>\n            <li><a href=\"#depoimentos\">Depoimentos</a></li>\n            <li><a href=\"#diferenciais\">Diferenciais</a></li>\n            <li><a href=\"#contato\">Contato</a></li>\n            <li><a href=\"#contato\" class=\"nav-cta\">Agendar Consulta</a></li>\n        </ul>\n    </div>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-blobs\">\n            <div class=\"hero-blob hero-blob-1\"></div>\n            <div class=\"hero-blob hero-blob-2\"></div>\n            <div class=\"hero-blob hero-blob-3\"></div>\n            <div class=\"hero-blob hero-blob-4\"></div>\n        </div>\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <span class=\"hero-badge\">Medicina e Autoestima</span>\n                <h1 class=\"hero-title\">Transforme sua <span>Autoestima</span> com a Dra. Camila Barcellos</h1>\n                <p class=\"hero-subtitle\">Harmonização Facial e Estética Avançada em Ribeirão Preto</p>\n                <p class=\"hero-description\">Descubra uma versão mais confiante e radiante de si mesma. Procedimentos personalizados que realçam sua beleza natural com segurança e excelência.</p>\n                <div class=\"hero-ctas\">\n                    <a href=\"#contato\" class=\"btn-primary\">\n                        <span>Agendar Consulta</span>\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                    <a href=\"#servicos\" class=\"btn-secondary\">Conhecer Serviços</a>\n                </div>\n            </div>\n            <div class=\"hero-visual\">\n                <div class=\"hero-image-wrapper\">\n                    <img src=\"https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=800&h=1000&fit=crop&crop=faces\" alt=\"Dra. Camila Barcellos - Harmonização Facial\" class=\"hero-image\">\n                </div>\n                <div class=\"hero-floating-card hero-floating-card-1\">\n                    <div class=\"floating-card-icon\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"floating-card-text\">\n                        <strong>+5.000</strong>\n                        <span>Clientes satisfeitas</span>\n                    </div>\n                </div>\n                <div class=\"hero-floating-card hero-floating-card-2\">\n                    <div class=\"floating-card-icon\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"floating-card-text\">\n                        <strong>10+ Anos</strong>\n                        <span>De experiência</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-section\">\n        <div class=\"section-header wow\">\n            <span class=\"section-tag\">Sua Jornada</span>\n            <h2 class=\"section-title\">Supere as Inseguranças, Redescubra sua Beleza</h2>\n            <p class=\"section-description\">Entendemos os desafios que você enfrenta e estamos aqui para ajudá-la a transformá-los em confiança.</p>\n        </div>\n        <div class=\"problem-grid\">\n            <div class=\"problem-card problem wow wow-delay-1\">\n                <div class=\"problem-icon\">\n                    <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                        <path d=\"M8 14s1.5 2 4 2 4-2 4-2\"/>\n                        <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"/>\n                        <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"/>\n                    </svg>\n                </div>\n                <h3>O Desafio</h3>\n                <p>Sinais de envelhecimento, assimetrias faciais ou características que te deixam insegura podem impactar diretamente sua autoestima e forma como você se vê no espelho.</p>\n            </div>\n            <div class=\"problem-card solution wow wow-delay-2\">\n                <div class=\"problem-icon\">\n                    <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z\"/>\n                    </svg>\n                </div>\n                <h3>A Solução</h3>\n                <p>Com a Dra. Camila Barcellos, você encontra tratamentos personalizados que harmonizam seus traços, realçam sua beleza natural e devolvem a confiança que você merece.</p>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services-section\" id=\"servicos\">\n        <div class=\"section-header wow\">\n            <span class=\"section-tag\">Tratamentos</span>\n            <h2 class=\"section-title\">Serviços Especializados</h2>\n            <p class=\"section-description\">Procedimentos estéticos avançados com foco em resultados naturais e sua satisfação.</p>\n        </div>\n        <div class=\"services-grid\">\n            <div class=\"service-card wow wow-delay-1\">\n                <div class=\"service-icon\">\n                    <svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M12 2L2 7l10 5 10-5-10-5z\"/>\n                        <path d=\"M2 17l10 5 10-5\"/>\n                        <path d=\"M2 12l10 5 10-5\"/>\n                    </svg>\n                </div>\n                <h3>Harmonização Facial</h3>\n                <p>Equilibre seus traços faciais com técnicas avançadas para um resultado natural e harmônico.</p>\n                <a href=\"#contato\" class=\"service-link\">\n                    Saiba mais\n                    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                    </svg>\n                </a>\n            </div>\n            <div class=\"service-card wow wow-delay-2\">\n                <div class=\"service-icon\">\n                    <svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M9 12l2 2 4-4\"/>\n                        <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                    </svg>\n                </div>\n                <h3>Toxina Botulínica</h3>\n                <p>Suavize linhas de expressão e previna novos sinais de envelhecimento com aplicação precisa.</p>\n                <a href=\"#contato\" class=\"service-link\">\n                    Saiba mais\n                    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                    </svg>\n                </a>\n            </div>\n            <div class=\"service-card wow wow-delay-3\">\n                <div class=\"service-icon\">\n                    <svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M12 19l7-7 3 3-7 7-3-3z\"/>\n                        <path d=\"M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z\"/>\n                        <path d=\"M2 2l7.586 7.586\"/>\n                        <circle cx=\"11\" cy=\"11\" r=\"2\"/>\n                    </svg>\n                </div>\n                <h3>Preenchedores Faciais</h3>\n                <p>Restaure volume e contorno facial com ácido hialurônico de alta qualidade.</p>\n                <a href=\"#contato\" class=\"service-link\">\n                    Saiba mais\n                    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                    </svg>\n                </a>\n            </div>\n            <div class=\"service-card wow wow-delay-4\">\n                <div class=\"service-icon\">\n                    <svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/>\n                    </svg>\n                </div>\n                <h3>Preenchimento Labial</h3>\n                <p>Realce a beleza dos seus lábios com aumento de volume e contorno natural.</p>\n                <a href=\"#contato\" class=\"service-link\">\n                    Saiba mais\n                    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                    </svg>\n                </a>\n            </div>\n            <div class=\"service-card wow wow-delay-5\">\n                <div class=\"service-icon\">\n                    <svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\"/>\n                    </svg>\n                </div>\n                <h3>Bioestimuladores</h3>\n                <p>Estimule o colágeno natural da sua pele para um rejuvenescimento progressivo e duradouro.</p>\n                <a href=\"#contato\" class=\"service-link\">\n                    Saiba mais\n                    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                    </svg>\n                </a>\n            </div>\n            <div class=\"service-card wow wow-delay-6\">\n                <div class=\"service-icon\">\n                    <svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/>\n                    </svg>\n                </div>\n                <h3>Protocolos Exclusivos</h3>\n                <p>Tratamentos personalizados combinando as melhores técnicas para suas necessidades únicas.</p>\n                <a href=\"#contato\" class=\"service-link\">\n                    Saiba mais\n                    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                    </svg>\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials-section\" id=\"depoimentos\">\n        <div class=\"section-header wow\">\n            <span class=\"section-tag\">Depoimentos</span>\n            <h2 class=\"section-title\">O Que Nossas Clientes Dizem</h2>\n            <p class=\"section-description\">Histórias reais de transformação e satisfação.</p>\n        </div>\n        <div class=\"testimonials-grid\">\n            <div class=\"testimonial-card wow wow-delay-1\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"A Dra. Camila transformou minha autoestima. O resultado foi super natural e exatamente o que eu sempre quis. Recomendo de olhos fechados!\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">MC</div>\n                    <div>\n                        <div class=\"testimonial-name\">Marina Costa</div>\n                        <div class=\"testimonial-role\">Empresária</div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"testimonial-card wow wow-delay-2\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"Profissionalismo e carinho em cada detalhe. Me senti acolhida desde a primeira consulta. Os resultados superaram minhas expectativas.\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">AS</div>\n                    <div>\n                        <div class=\"testimonial-name\">Amanda Silva</div>\n                        <div class=\"testimonial-role\">Advogada</div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"testimonial-card wow wow-delay-3\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"Finalmente encontrei uma profissional que entende o que eu queria. A harmonização ficou perfeita, me sinto mais confiante e bonita.\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">PO</div>\n                    <div>\n                        <div class=\"testimonial-name\">Patrícia Oliveira</div>\n                        <div class=\"testimonial-role\">Arquiteta</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials-section\" id=\"diferenciais\">\n        <div class=\"section-header wow\">\n            <span class=\"section-tag\">Diferenciais</span>\n            <h2 class=\"section-title\">Por Que Escolher a Dra. Camila Barcellos?</h2>\n            <p class=\"section-description\">Compromisso com sua segurança, satisfação e bem-estar.</p>\n        </div>\n        <div class=\"differentials-grid\">\n            <div class=\"differential-item wow wow-delay-1\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/>\n                        </svg>\n                    </div>\n                </div>\n                <div class=\"differential-content\">\n                    <h4>Excelência Clínica</h4>\n                    <p>Formação especializada e atualização constante com as melhores técnicas do mercado.</p>\n                </div>\n            </div>\n            <div class=\"differential-item wow wow-delay-2\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z\"/>\n                        </svg>\n                    </div>\n                </div>\n                <div class=\"differential-content\">\n                    <h4>Atendimento Personalizado</h4>\n                    <p>Cada paciente é única e merece um plano de tratamento exclusivo.</p>\n                </div>\n            </div>\n            <div class=\"differential-item wow wow-delay-3\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n                        </svg>\n                    </div>\n                </div>\n                <div class=\"differential-content\">\n                    <h4>Segurança Primeiro</h4>\n                    <p>Procedimentos realizados com produtos certificados e técnicas comprovadas.</p>\n                </div>\n            </div>\n            <div class=\"differential-item wow wow-delay-4\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            <polyline points=\"12 6 12 12 16 14\"/>\n                        </svg>\n                    </div>\n                </div>\n                <div class=\"differential-content\">\n                    <h4>Acompanhamento Completo</h4>\n                    <p>Suporte integral antes, durante e após os procedimentos.</p>\n                </div>\n            </div>\n            <div class=\"differential-item wow wow-delay-5\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M14 9V5a3 3 0 00-3-3l-4 9v11h11.28a2 2 0 002-1.7l1.38-9a2 2 0 00-2-2.3zM7 22H4a2 2 0 01-2-2v-7a2 2 0 012-2h3\"/>\n                        </svg>\n                    </div>\n                </div>\n                <div class=\"differential-content\">\n                    <h4>Resultados Naturais</h4>\n                    <p>Foco em realçar sua beleza natural com discrição e equilíbrio.</p>\n                </div>\n            </div>\n            <div class=\"differential-item wow wow-delay-6\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z\"/>\n                        </svg>\n                    </div>\n                </div>\n                <div class=\"differential-content\">\n                    <h4>Estrutura Premium</h4>\n                    <p>Clínica equipada com tecnologia de ponta para seu conforto e segurança.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact-section\" id=\"contato\">\n        <div class=\"section-header wow\">\n            <span class=\"section-tag\">Contato</span>\n            <h2 class=\"section-title\">Agende sua Consulta</h2>\n            <p class=\"section-description\">Dê o primeiro passo em direção à sua melhor versão.</p>\n        </div>\n        <div class=\"contact-container\">\n            <div class=\"contact-info wow\">\n                <h3>Entre em Contato</h3>\n                <p>Estamos prontas para atender você e tirar todas as suas dúvidas. Agende sua consulta e descubra o poder da medicina estética a seu favor.</p>\n                <ul class=\"contact-details\">\n                    <li>\n                        <div class=\"contact-details-icon\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z\"/>\n                                <circle cx=\"12\" cy=\"10\" r=\"3\"/>\n                            </svg>\n                        </div>\n                        <div class=\"contact-details-text\">\n                            <strong>Endereço</strong>\n                            <span>R. Stélio Machado Loureiro, 480 - Alto da Boa Vista, Ribeirão Preto - SP, 14025-470</span>\n                        </div>\n                    </li>\n                    <li>\n                        <div class=\"contact-details-icon\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z\"/>\n                            </svg>\n                        </div>\n                        <div class=\"contact-details-text\">\n                            <strong>WhatsApp</strong>\n                            <span>(14) 99793-4138</span>\n                        </div>\n                    </li>\n                    <li>\n                        <div class=\"contact-details-icon\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                                <polyline points=\"12 6 12 12 16 14\"/>\n                            </svg>\n                        </div>\n                        <div class=\"contact-details-text\">\n                            <strong>Horário</strong>\n                            <span>Segunda a Sexta: 9h às 18h</span>\n                        </div>\n                    </li>\n                </ul>\n            </div>\n            <form class=\"contact-form wow\" id=\"contactForm\">\n                <div class=\"form-group\">\n                    <label for=\"name\">Nome Completo</label>\n                    <input type=\"text\" id=\"name\" name=\"name\" required placeholder=\"Seu nome\">\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"email\">E-mail</label>\n                    <input type=\"email\" id=\"email\" name=\"email\" required placeholder=\"seu@email.com\">\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"service\">Tratamento de Interesse</label>\n                    <select id=\"service\" name=\"service\" required>\n                        <option value=\"\">Selecione um tratamento</option>\n                        <option value=\"harmonizacao\">Harmonização Facial</option>\n                        <option value=\"botox\">Toxina Botulínica</option>\n                        <option value=\"preenchedores\">Preenchedores Faciais</option>\n                        <option value=\"labios\">Preenchimento Labial</option>\n                        <option value=\"bioestimuladores\">Bioestimuladores</option>\n                        <option value=\"protocolos\">Protocolos Exclusivos</option>\n                    </select>\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"message\">Mensagem</label>\n                    <textarea id=\"message\" name=\"message\" required placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                </div>\n                <button type=\"submit\" class=\"form-submit\">Enviar Mensagem</button>\n            </form>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-brand\">\n                <h4>Dra. Camila Barcellos</h4>\n                <p>Medicina e Autoestima - Transformando vidas através da harmonização facial e estética avançada em Ribeirão Preto.</p>\n            </div>\n            <div class=\"footer-links\">\n                <h5>Links Rápidos</h5>\n                <ul>\n                    <li><a href=\"#inicio\">Início</a></li>\n                    <li><a href=\"#servicos\">Serviços</a></li>\n                    <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                    <li><a href=\"#contato\">Contato</a></li>\n                </ul>\n            </div>\n            <div class=\"footer-links\">\n                <h5>Serviços</h5>\n                <ul>\n                    <li><a href=\"#servicos\">Harmonização Facial</a></li>\n                    <li><a href=\"#servicos\">Toxina Botulínica</a></li>\n                    <li><a href=\"#servicos\">Preenchedores</a></li>\n                    <li><a href=\"#servicos\">Bioestimuladores</a></li>\n                </ul>\n            </div>\n        </div>\n        <div class=\"footer-bottom\">\n            <p>© 2024 Dra. Camila Barcellos - Medicina e Autoestima. Todos os direitos reservados.</p>\n        </div>\n    </footer>\n\n    <script>\n        // Navigation scroll behavior\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > lastScroll && currentScroll > 100) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Mobile menu\n        const navMenuBtn = document.getElementById('navMenuBtn');\n        const navMobile = document.getElementById('navMobile');\n\n        navMenuBtn.addEventListener('click', () => {\n            navMobile.classList.toggle('active');\n            navMenuBtn.textContent = navMobile.classList.contains('active') ? '✕' : '☰';\n        });\n\n        // Close mobile menu on link click\n        navMobile.querySelectorAll('a').forEach(link => {\n            link.addEventListener('click', () => {\n                navMobile.classList.remove('active');\n                navMenuBtn.textContent = '☰';\n            });\n        });\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // Intersection Observer for scroll animations\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('animated');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow').forEach(el => {\n            observer.observe(el);\n        });\n\n        // Contact form submission to WhatsApp\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const email = document.getElementById('email').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceNames = {\n                'harmonizacao': 'Harmonização Facial',\n                'botox': 'Toxina Botulínica',\n                'preenchedores': 'Preenchedores Faciais',\n                'labios': 'Preenchimento Labial',\n                'bioestimuladores': 'Bioestimuladores',\n                'protocolos': 'Protocolos Exclusivos'\n            };\n\n            const whatsappMessage = encodeURIComponent(\n                `Olá! Meu nome é ${name}.\\n\\n` +\n                `Gostaria de agendar uma consulta para: ${serviceNames[service]}\\n\\n` +\n                `Mensagem: ${message}\\n\\n` +\n                `E-mail: ${email}`\n            );\n\n            window.open(`https://wa.me/5514997934138?text=${whatsappMessage}`, '_blank');\n        });\n\n        // Parallax effect for hero blobs (only on desktop)\n        if (window.matchMedia('(min-width: 1024px)').matches) {\n            document.addEventListener('mousemove', (e) => {\n                const moveX = (e.clientX - window.innerWidth / 2) * 0.01;\n                const moveY = (e.clientY - window.innerHeight / 2) * 0.01;\n\n                document.querySelectorAll('.hero-blob').forEach((blob, index) => {\n                    const speed = (index + 1) * 0.5;\n                    blob.style.transform = `translate(${moveX * speed}px, ${moveY * speed}px)`;\n                });\n            });\n        }\n\n        // Respect reduced motion preference\n        window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', () => {\n            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n                document.querySelectorAll('.hero-blob').forEach(blob => {\n                    blob.style.animation = 'none';\n                });\n            }\n        });\n    </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null}}
