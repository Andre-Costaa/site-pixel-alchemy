rmorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Montserrat:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ========================================\n           CSS VARIABLES & ROOT STYLES\n        ======================================== */\n        :root {\n            /* Colors - Ethereal Rose & Gold Palette */\n            --color-blush: #F8E8E8;\n            --color-rose: #E8B4B8;\n            --color-rose-dark: #D4959A;\n            --color-champagne: #F5EDE3;\n            --color-gold: #C9A86C;\n            --color-gold-light: #DFC9A3;\n            --color-sand: #D4C4B0;\n            --color-ivory: #FFFEF9;\n            --color-charcoal: #2C2C2C;\n            --color-charcoal-light: #4A4A4A;\n            --color-mauve: #B8A5B5;\n\n            /* Gradients */\n            --gradient-ethereal: linear-gradient(135deg, #F8E8E8 0%, #F5EDE3 50%, #FFF5F5 100%);\n            --gradient-glow: linear-gradient(135deg, #E8B4B8 0%, #F5EDE3 100%);\n            --gradient-rose: linear-gradient(135deg, #D4959A 0%, #C9A86C 100%);\n\n            /* Typography */\n            --font-display: 'Cormorant Garamond', Georgia, serif;\n            --font-body: 'Montserrat', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n            --spacing-xxl: 8rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 16px;\n            --radius-lg: 24px;\n            --radius-pill: 100px;\n            --radius-organic: 60% 40% 30% 70% / 60% 30% 70% 40%;\n\n            /* Shadows */\n            --shadow-soft: 0 8px 32px rgba(201, 168, 108, 0.15);\n            --shadow-glow: 0 8px 48px rgba(232, 180, 184, 0.25);\n            --shadow-elegant: 0 16px 64px rgba(44, 44, 44, 0.08);\n\n            /* Transitions */\n            --transition-fast: 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-base: 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-slow: 0.8s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n\n        /* ========================================\n           RESET & BASE STYLES\n        ======================================== */\n        *, *::before, *::after {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        html {\n            scroll-behavior: smooth;\n            font-size: 16px;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background: var(--color-ivory);\n            color: var(--color-charcoal);\n            line-height: 1.7;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        img {\n            max-width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-fast);","numLines":100,"startLine":1,"totalLines":1562}}}
