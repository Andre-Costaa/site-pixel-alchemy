{"type":"assistant","message":{"id":"msg_20260209000711e960ba2a8faf4204","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"text","text":"Now I'll create the complete site with a unique **Serene Sage & Pearl** aesthetic - a fresh, natural look with soft greens, creamy whites, and pearl accents that creates a premium, modern feel distinct from the previous implementation."}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"7b2b5fe1-65ed-4b78-ae03-7f6126461dbf","uuid":"25567a50-b32d-4151-b84e-0525d6289e37"}
{"type":"assistant","message":{"id":"msg_20260209000711e960ba2a8faf4204","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_36a8746578624103a0b08fe0","name":"Write","input":{"file_path":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-lara-costa/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Lara Costa | Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Lara Costa - Especialista em harmonização facial e estética avançada em Ribeirão Preto. Transforme sua beleza natural com tratamentos personalizados. Agende: (16) 99788-7923\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ========================================\n           CSS VARIABLES & ROOT STYLES\n        ======================================== */\n        :root {\n            /* Colors - Serene Sage & Pearl Palette */\n            --color-sage: #9CBFA8;\n            --color-sage-dark: #7FA68C;\n            --color-sage-light: #B8D4C2;\n            --color-pearl: #F8F6F3;\n            --color-pearl-dark: #E8E4DD;\n            --color-ivory: #FFFEFA;\n            --color-mint: #D4E5DC;\n            --color-seafoam: #C5DDD1;\n            --color-charcoal: #2A2A2A;\n            --color-charcoal-light: #4A4A4A;\n            --color-golden: #C4A77D;\n            --color-golden-light: #D8BE9A;\n            --color-coral: #E8B4A8;\n\n            /* Gradients */\n            --gradient-serene: linear-gradient(135deg, #F8F6F3 0%, #D4E5DC 50%, #FFFEFA 100%);\n            --gradient-fresh: linear-gradient(135deg, #9CBFA8 0%, #C5DDD1 100%);\n            --gradient-pearl: linear-gradient(135deg, #B8D4C2 0%, #C4A77D 100%);\n            --gradient-warm: linear-gradient(135deg, #E8B4A8 0%, #C4A77D 100%);\n\n            /* Typography */\n            --font-display: 'Playfair Display', Georgia, serif;\n            --font-body: 'Inter', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n            --spacing-xxl: 8rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 16px;\n            --radius-lg: 24px;\n            --radius-pill: 100px;\n            --radius-organic: 60% 40% 30% 70% / 60% 30% 70% 40%;\n            --radius-organic-2: 40% 60% 70% 30% / 40% 70% 30% 60%;\n\n            /* Shadows */\n            --shadow-soft: 0 8px 32px rgba(156, 191, 168, 0.15);\n            --shadow-glow: 0 8px 48px rgba(196, 167, 125, 0.2);\n            --shadow-elegant: 0 16px 64px rgba(42, 42, 42, 0.08);\n            --shadow-floating: 0 20px 60px rgba(156, 191, 168, 0.2);\n\n            /* Transitions */\n            --transition-fast: 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-base: 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-slow: 0.8s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n\n        /* ========================================\n           RESET & BASE STYLES\n        ======================================== */\n        *, *::before, *::after {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        html {\n            scroll-behavior: smooth;\n            font-size: 16px;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background: var(--color-ivory);\n            color: var(--color-charcoal);\n            line-height: 1.7;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        img {\n            max-width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-fast);\n        }\n\n        ul {\n            list-style: none;\n        }\n\n        /* ========================================\n           TYPOGRAPHY\n        ======================================== */\n        h1, h2, h3, h4 {\n            font-family: var(--font-display);\n            font-weight: 500;\n            line-height: 1.2;\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 8vw, 5rem);\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 5vw, 3.5rem);\n            letter-spacing: -0.01em;\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 3vw, 2rem);\n        }\n\n        .text-sage { color: var(--color-sage-dark); }\n        .text-golden { color: var(--color-golden); }\n        .text-coral { color: var(--color-coral); }\n\n        /* ========================================\n           NAVIGATION\n        ======================================== */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            background: rgba(255, 254, 250, 0.95);\n            backdrop-filter: blur(20px);\n            z-index: 1000;\n            transition: transform var(--transition-base);\n            box-shadow: 0 1px 0 rgba(156, 191, 168, 0.1);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 1rem 2rem;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            color: var(--color-charcoal);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: 2rem;\n            align-items: center;\n        }\n\n        .nav-link {\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-charcoal-light);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-sage-dark);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.75rem 1.5rem;\n            background: var(--gradient-pearl);\n            color: var(--color-white);\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            cursor: pointer;\n            padding: 10px;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-charcoal);\n            transition: var(--transition-fast);\n        }\n\n        /* Mobile Nav */\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                width: 100%;\n                background: var(--color-ivory);\n                flex-direction: column;\n                padding: 2rem;\n                gap: 1.5rem;\n                transform: translateX(100%);\n                transition: transform var(--transition-base);\n            }\n\n            .nav-menu.active {\n                transform: translateX(0);\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n        }\n\n        /* ========================================\n           HERO SECTION\n        ======================================== */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            position: relative;\n            overflow: hidden;\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--gradient-serene);\n        }\n\n        .hero-background {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            z-index: 0;\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-organic);\n            opacity: 0.7;\n            filter: blur(70px);\n            animation: blob-float 18s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 650px;\n            height: 650px;\n            background: linear-gradient(135deg, var(--color-sage-light) 0%, transparent 70%);\n            top: -250px;\n            right: -150px;\n        }\n\n        .blob-2 {\n            width: 550px;\n            height: 550px;\n            background: linear-gradient(225deg, var(--color-mint) 0%, transparent 70%);\n            bottom: -200px;\n            left: -150px;\n            animation-delay: -6s;\n        }\n\n        .blob-3 {\n            width: 450px;\n            height: 450px;\n            background: linear-gradient(45deg, var(--color-seafoam) 0%, transparent 70%);\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: -12s;\n            border-radius: var(--radius-organic-2);\n        }\n\n        .blob-4 {\n            width: 350px;\n            height: 350px;\n            background: linear-gradient(315deg, var(--color-pearl-dark) 0%, transparent 70%);\n            top: 20%;\n            right: 10%;\n            animation-delay: -3s;\n            border-radius: var(--radius-organic-2);\n            opacity: 0.5;\n        }\n\n        @keyframes blob-float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n                border-radius: var(--radius-organic);\n            }\n            25% {\n                transform: translate(40px, -30px) rotate(8deg) scale(1.08);\n            }\n            50% {\n                transform: translate(-30px, 40px) rotate(-6deg) scale(0.92);\n                border-radius: var(--radius-organic-2);\n            }\n            75% {\n                transform: translate(-40px, -30px) rotate(4deg) scale(1.05);\n            }\n        }\n\n        .hero-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-xl);\n            align-items: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .hero-content {\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fade-up 1s ease forwards;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 0.6rem 1.2rem;\n            background: rgba(156, 191, 168, 0.2);\n            border-radius: var(--radius-pill);\n            font-size: 0.85rem;\n            font-weight: 500;\n            color: var(--color-sage-dark);\n            margin-bottom: var(--spacing-md);\n            border: 1px solid rgba(156, 191, 168, 0.3);\n        }\n\n        .hero-badge::before {\n            content: '';\n            width: 8px;\n            height: 8px;\n            background: var(--color-sage-dark);\n            border-radius: 50%;\n            animation: pulse 2.5s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; transform: scale(1); }\n            50% { opacity: 0.6; transform: scale(1.2); }\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            color: var(--color-charcoal);\n        }\n\n        .hero-description {\n            font-size: 1.15rem;\n            color: var(--color-charcoal-light);\n            margin-bottom: var(--spacing-lg);\n            max-width: 500px;\n        }\n\n        .hero-cta-group {\n            display: flex;\n            gap: 1rem;\n            flex-wrap: wrap;\n        }\n\n        .btn-primary {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            background: var(--gradient-fresh);\n            color: var(--color-white);\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            transition: var(--transition-fast);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-floating);\n        }\n\n        .btn-primary::before {\n            content: '';\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            width: 0;\n            height: 0;\n            background: rgba(255, 255, 255, 0.2);\n            border-radius: 50%;\n            transform: translate(-50%, -50%);\n            transition: width 0.6s, height 0.6s;\n        }\n\n        .btn-primary:active::before {\n            width: 300px;\n            height: 300px;\n        }\n\n        .btn-secondary {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            background: transparent;\n            color: var(--color-charcoal);\n            border: 2px solid var(--color-sage);\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            transition: var(--transition-fast);\n        }\n\n        .btn-secondary:hover {\n            border-color: var(--color-golden);\n            color: var(--color-golden);\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            opacity: 0;\n            transform: translateX(30px);\n            animation: fade-left 1s ease 0.3s forwards;\n        }\n\n        .hero-image {\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-floating);\n        }\n\n        .hero-image-decoration {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            top: 25px;\n            left: 25px;\n            border: 2px solid var(--color-sage);\n            border-radius: var(--radius-lg);\n            z-index: -1;\n            opacity: 0.5;\n        }\n\n        .hero-image-accent {\n            position: absolute;\n            width: 200px;\n            height: 200px;\n            bottom: -50px;\n            right: -50px;\n            background: var(--gradient-pearl);\n            border-radius: var(--radius-organic);\n            opacity: 0.3;\n            filter: blur(40px);\n            z-index: -2;\n        }\n\n        @keyframes fade-up {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fade-left {\n            to {\n                opacity: 1;\n                transform: translateX(0);\n            }\n        }\n\n        /* ========================================\n           PROBLEM/SOLUTION SECTION\n        ======================================== */\n        .section {\n            padding: var(--spacing-xl) var(--spacing-md);\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .problem-solution {\n            background: var(--color-pearl);\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-xl);\n            align-items: center;\n        }\n\n        .section-header {\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .section-subtitle {\n            font-size: 0.85rem;\n            text-transform: uppercase;\n            letter-spacing: 0.2em;\n            color: var(--color-sage-dark);\n            font-weight: 600;\n            margin-bottom: 1rem;\n        }\n\n        .section-title {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .problem-card, .solution-card {\n            padding: var(--spacing-lg);\n            background: var(--color-ivory);\n            border-radius: var(--radius-lg);\n            position: relative;\n            overflow: hidden;\n            margin-bottom: var(--spacing-md);\n            transition: var(--transition-base);\n        }\n\n        .problem-card:hover {\n            transform: translateY(-5px);\n        }\n\n        .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .problem-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: linear-gradient(90deg, var(--color-coral) 0%, var(--color-sage) 100%);\n        }\n\n        .solution-card {\n            box-shadow: var(--shadow-soft);\n        }\n\n        .solution-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: linear-gradient(90deg, var(--color-sage) 0%, var(--color-golden) 100%);\n        }\n\n        .card-icon {\n            width: 64px;\n            height: 64px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--color-mint);\n            border-radius: var(--radius-md);\n            margin-bottom: var(--spacing-md);\n            font-size: 1.8rem;\n        }\n\n        .solution-card .card-icon {\n            background: var(--gradient-fresh);\n        }\n\n        .card-title {\n            margin-bottom: 1rem;\n        }\n\n        .card-list {\n            margin-top: var(--spacing-md);\n        }\n\n        .card-list li {\n            display: flex;\n            align-items: center;\n            gap: 0.75rem;\n            margin-bottom: 0.75rem;\n            font-size: 0.95rem;\n        }\n\n        .card-list li::before {\n            content: '✓';\n            width: 22px;\n            height: 22px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--gradient-fresh);\n            color: var(--color-white);\n            border-radius: 50%;\n            font-size: 0.75rem;\n            flex-shrink: 0;\n        }\n\n        /* ========================================\n           SERVICES SECTION\n        ======================================== */\n        .services {\n            background: var(--color-ivory);\n        }\n\n        .services-intro {\n            text-align: center;\n            max-width: 700px;\n            margin: 0 auto var(--spacing-xl);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-lg);\n        }\n\n        .service-card {\n            padding: var(--spacing-lg);\n            background: var(--color-white);\n            border-radius: var(--radius-lg);\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n            border: 1px solid rgba(156, 191, 168, 0.1);\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background: var(--gradient-serene);\n            opacity: 0;\n            transition: var(--transition-base);\n            z-index: 0;\n        }\n\n        .service-card:hover {\n            transform: translateY(-10px);\n            box-shadow: var(--shadow-floating);\n            border-color: var(--color-sage-light);\n        }\n\n        .service-card:hover::before {\n            opacity: 0.5;\n        }\n\n        .service-icon {\n            width: 72px;\n            height: 72px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--color-mint);\n            border-radius: var(--radius-md);\n            margin-bottom: var(--spacing-md);\n            font-size: 2rem;\n            position: relative;\n            z-index: 1;\n            transition: var(--transition-base);\n        }\n\n        .service-card:hover .service-icon {\n            background: var(--gradient-fresh);\n            transform: scale(1.1);\n        }\n\n        .service-content {\n            position: relative;\n            z-index: 1;\n        }\n\n        .service-title {\n            margin-bottom: 1rem;\n        }\n\n        .service-description {\n            color: var(--color-charcoal-light);\n            margin-bottom: var(--spacing-md);\n            line-height: 1.8;\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-sage-dark);\n            font-weight: 600;\n            font-size: 0.9rem;\n        }\n\n        .service-link::after {\n            content: '→';\n            transition: transform var(--transition-fast);\n        }\n\n        .service-link:hover::after {\n            transform: translateX(5px);\n        }\n\n        /* ========================================\n           TESTIMONIALS SECTION\n        ======================================== */\n        .testimonials {\n            background: var(--gradient-serene);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-lg);\n        }\n\n        .testimonial-card {\n            padding: var(--spacing-lg);\n            background: var(--color-white);\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-soft);\n            transition: var(--transition-base);\n        }\n\n        .testimonial-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-floating);\n        }\n\n        .testimonial-stars {\n            color: var(--color-golden);\n            font-size: 1.2rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .testimonial-text {\n            font-style: italic;\n            color: var(--color-charcoal-light);\n            margin-bottom: var(--spacing-md);\n            line-height: 1.8;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 52px;\n            height: 52px;\n            background: var(--gradient-fresh);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: var(--color-white);\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n        }\n\n        .testimonial-role {\n            font-size: 0.85rem;\n            color: var(--color-charcoal-light);\n        }\n\n        /* ========================================\n           DIFFERENTIALS SECTION\n        ======================================== */\n        .differentials {\n            background: var(--color-charcoal);\n            color: var(--color-ivory);\n        }\n\n        .differentials .section-title {\n            color: var(--color-ivory);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: var(--spacing-lg);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-icon {\n            width: 85px;\n            height: 85px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--gradient-pearl);\n            border-radius: 50%;\n            margin: 0 auto var(--spacing-md);\n            font-size: 2rem;\n            position: relative;\n        }\n\n        .differential-icon::after {\n            content: '';\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            border-radius: 50%;\n            background: var(--gradient-fresh);\n            opacity: 0.3;\n            z-index: -1;\n            animation: pulse-ring 3s ease-in-out infinite;\n        }\n\n        @keyframes pulse-ring {\n            0%, 100% {\n                transform: scale(1);\n                opacity: 0.3;\n            }\n            50% {\n                transform: scale(1.3);\n                opacity: 0;\n            }\n        }\n\n        .differential-title {\n            margin-bottom: 0.75rem;\n        }\n\n        .differential-description {\n            color: rgba(255, 254, 250, 0.7);\n            font-size: 0.95rem;\n            line-height: 1.7;\n        }\n\n        /* ========================================\n           CONTACT SECTION\n        ======================================== */\n        .contact {\n            background: var(--color-pearl);\n        }\n\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-xl);\n        }\n\n        .contact-info {\n            padding: var(--spacing-lg);\n            background: var(--color-ivory);\n            border-radius: var(--radius-lg);\n            border: 1px solid rgba(156, 191, 168, 0.2);\n        }\n\n        .contact-info-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-icon {\n            width: 54px;\n            height: 54px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--color-mint);\n            border-radius: var(--radius-md);\n            font-size: 1.2rem;\n            flex-shrink: 0;\n        }\n\n        .contact-label {\n            font-size: 0.85rem;\n            color: var(--color-charcoal-light);\n            margin-bottom: 0.25rem;\n        }\n\n        .contact-value {\n            font-weight: 600;\n            color: var(--color-charcoal);\n        }\n\n        .contact-form-wrapper {\n            padding: var(--spacing-lg);\n            background: var(--color-white);\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .form-group {\n            margin-bottom: 1.5rem;\n        }\n\n        .form-label {\n            display: block;\n            font-size: 0.9rem;\n            font-weight: 500;\n            margin-bottom: 0.5rem;\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 1rem;\n            border: 2px solid var(--color-sage-light);\n            border-radius: var(--radius-md);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: var(--transition-fast);\n            background: var(--color-ivory);\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-sage-dark);\n            background: var(--color-white);\n        }\n\n        .form-textarea {\n            min-height: 150px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1.25rem;\n            background: var(--gradient-fresh);\n            color: var(--color-white);\n            border: none;\n            border-radius: var(--radius-pill);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: var(--transition-fast);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-floating);\n        }\n\n        /* ========================================\n           FOOTER\n        ======================================== */\n        .footer {\n            background: var(--color-charcoal);\n            color: var(--color-ivory);\n            padding: var(--spacing-xl) var(--spacing-md) var(--spacing-lg);\n        }\n\n        .footer-content {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: var(--spacing-xl);\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .footer-brand .footer-logo {\n            font-family: var(--font-display);\n            font-size: 1.8rem;\n            margin-bottom: 1rem;\n        }\n\n        .footer-description {\n            color: rgba(255, 254, 250, 0.7);\n            font-size: 0.95rem;\n            line-height: 1.8;\n        }\n\n        .footer-title {\n            font-family: var(--font-display);\n            font-size: 1.2rem;\n            margin-bottom: 1rem;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.75rem;\n        }\n\n        .footer-links a {\n            color: rgba(255, 254, 250, 0.7);\n            transition: var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-sage-light);\n        }\n\n        .footer-bottom {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding-top: var(--spacing-md);\n            border-top: 1px solid rgba(255, 254, 250, 0.1);\n            text-align: center;\n            color: rgba(255, 254, 250, 0.5);\n            font-size: 0.9rem;\n        }\n\n        /* ========================================\n           SCROLL ANIMATIONS\n        ======================================== */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(40px);\n            transition: opacity 0.8s ease, transform 0.8s ease;\n        }\n\n        .wow-fade-up.animated {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.8s ease;\n        }\n\n        .wow-fade-in.animated {\n            opacity: 1;\n        }\n\n        [data-delay] {\n            transition-delay: var(--delay);\n        }\n\n        /* ========================================\n           RESPONSIVE DESIGN\n        ======================================== */\n        @media (max-width: 1024px) {\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-description {\n                margin-left: auto;\n                margin-right: auto;\n            }\n\n            .hero-cta-group {\n                justify-content: center;\n            }\n\n            .hero-image-wrapper {\n                max-width: 500px;\n                margin: var(--spacing-lg) auto 0;\n            }\n\n            .problem-solution-grid,\n            .contact-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-content {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        @media (max-width: 768px) {\n            :root {\n                --spacing-lg: 3rem;\n                --spacing-xl: 4rem;\n            }\n\n            .hero, .section {\n                padding: var(--spacing-lg) var(--spacing-sm);\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .hero-cta-group {\n                flex-direction: column;\n            }\n\n            .btn-primary, .btn-secondary {\n                width: 100%;\n                justify-content: center;\n            }\n        }\n\n        @media (max-width: 480px) {\n            h1 {\n                font-size: 2rem;\n            }\n\n            .hero-badge {\n                font-size: 0.75rem;\n            }\n\n            .nav-logo {\n                font-size: 1.2rem;\n            }\n        }\n\n        /* ========================================\n           ACCESSIBILITY\n        ======================================== */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        /* Focus styles */\n        a:focus, button:focus, input:focus, select:focus, textarea:focus {\n            outline: 3px solid var(--color-sage-dark);\n            outline-offset: 2px;\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Lara Costa</a>\n            <div class=\"nav-toggle\" id=\"navToggle\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#inicio\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#contato\" class=\"nav-link\">Contato</a></li>\n                <li><a href=\"tel:+5516997887923\" class=\"nav-cta\">Agendar Consulta</a></li>\n            </ul>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-background\">\n            <div class=\"hero-blob blob-1\"></div>\n            <div class=\"hero-blob blob-2\"></div>\n            <div class=\"hero-blob blob-3\"></div>\n            <div class=\"hero-blob blob-4\"></div>\n        </div>\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge\">\n                    <span>Harmonização Facial & Estética Avançada</span>\n                </div>\n                <h1 class=\"hero-title\">\n                    Sua beleza natural <span class=\"text-sage\">realçada</span> com elegância\n                </h1>\n                <p class=\"hero-description\">\n                    Dra. Lara Costa especialista em harmonização facial e estética avançada em Ribeirão Preto. Resultados naturais que celebram sua beleza única.\n                </p>\n                <div class=\"hero-cta-group\">\n                    <a href=\"https://wa.me/5516997887923\" class=\"btn-primary\">\n                        <span>Agendar Avaliação</span>\n                        <span>→</span>\n                    </a>\n                    <a href=\"#servicos\" class=\"btn-secondary\">\n                        <span>Conhecer Tratamentos</span>\n                    </a>\n                </div>\n            </div>\n            <div class=\"hero-image-wrapper\">\n                <div class=\"hero-image-decoration\"></div>\n                <div class=\"hero-image-accent\"></div>\n                <img src=\"https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=800&h=900&fit=crop\" alt=\"Harmonização Facial - Dra Lara Costa\" class=\"hero-image\" width=\"800\" height=\"900\">\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\">\n        <div class=\"container\">\n            <div class=\"problem-solution-grid\">\n                <div>\n                    <div class=\"section-header\">\n                        <span class=\"section-subtitle\">Entenda sua necessidade</span>\n                        <h2 class=\"section-title\">Você busca uma <span class=\"text-sage\">transformação natural</span>?</h2>\n                    </div>\n                    <div class=\"problem-card wow-fade-up\">\n                        <div class=\"card-icon\">🤔</div>\n                        <h3 class=\"card-title\">Desafios Comuns</h3>\n                        <p>Sinais de envelhecimento, perda de contorno facial, assimetrias, ou simplesmente o desejo de realçar seus traços naturais com segurança e expertise.</p>\n                        <ul class=\"card-list\">\n                            <li>Rugas e linhas de expressão</li>\n                            <li>Perda de volume facial</li>\n                            <li>Assimetrias faciais</li>\n                            <li>Desejo de aparência rejuvenescida</li>\n                        </ul>\n                    </div>\n                </div>\n                <div>\n                    <div class=\"section-header\" style=\"margin-top: 3rem;\">\n                        <h2 class=\"section-title\">Nossa <span class=\"text-golden\">solução exclusiva</span></h2>\n                    </div>\n                    <div class=\"solution-card wow-fade-up\" data-delay=\"0.2s\">\n                        <div class=\"card-icon\">✨</div>\n                        <h3 class=\"card-title\">Tratamentos Personalizados</h3>\n                        <p>Protocolos exclusivos desenvolvidos pela Dra. Lara Costa para resultados naturais, harmoniosos e seguros que respeitam suas características únicas.</p>\n                        <ul class=\"card-list\">\n                            <li>Análise facial personalizada</li>\n                            <li>Produtos de alta qualidade</li>\n                            <li>Técnicas avançadas e seguras</li>\n                            <li>Acompanhamento completo</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"container\">\n            <div class=\"section-header services-intro\">\n                <span class=\"section-subtitle\">Especialidades</span>\n                <h2 class=\"section-title\">Tratamentos que <span class=\"text-sage\">transformam</span></h2>\n                <p>Procedimentos estéticos faciais com foco em resultados naturais e harmoniosos, valorizando sua beleza única com segurança e excelência.</p>\n            </div>\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">👁️</div>\n                    <div class=\"service-content\">\n                        <h3 class=\"service-title\">Harmonização Facial</h3>\n                        <p class=\"service-description\">Equilíbrio dos traços faciais com preenchedores e toxina botulínica para resultados naturais e harmônicos que valorizam sua beleza.</p>\n                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                    </div>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"0.1s\">\n                    <div class=\"service-icon\">💉</div>\n                    <div class=\"service-content\">\n                        <h3 class=\"service-title\">Toxina Botulínica</h3>\n                        <p class=\"service-description\">Suavização de rugas e linhas de expressão com aplicação estratégica para um aspecto descansado, fresco e natural.</p>\n                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                    </div>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"0.2s\">\n                    <div class=\"service-icon\">💧</div>\n                    <div class=\"service-content\">\n                        <h3 class=\"service-title\">Preenchedores Faciais</h3>\n                        <p class=\"service-description\">Restauração de volume e contorno facial com ácido hialurônico de alta qualidade para resultados duradouros e naturais.</p>\n                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                    </div>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"0.3s\">\n                    <div class=\"service-icon\">🔬</div>\n                    <div class=\"service-content\">\n                        <h3 class=\"service-title\">Bioestimuladores</h3>\n                        <p class=\"service-description\">Tratamento que estimula o colágeno natural para rejuvenescimento progressivo e melhora da qualidade da pele.</p>\n                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                    </div>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"0.4s\">\n                    <div class=\"service-icon\">👄</div>\n                    <div class=\"service-content\">\n                        <h3 class=\"service-title\">Preenchimento Labial</h3>\n                        <p class=\"service-description\">Realce dos lábios com técnicas que mantêm a naturalidade e proporções harmoniosas com o resto do rosto.</p>\n                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                    </div>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"0.5s\">\n                    <div class=\"service-icon\">✨</div>\n                    <div class=\"service-content\">\n                        <h3 class=\"service-title\">Protocolos Exclusivos</h3>\n                        <p class=\"service-description\">Combinação de tratamentos personalizados conforme suas necessidades, objetivos e características faciais únicas.</p>\n                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"container\">\n            <div class=\"section-header services-intro\">\n                <span class=\"section-subtitle\">Depoimentos</span>\n                <h2 class=\"section-title\">O que nossas <span class=\"text-golden\">pacientes</span> dizem</h2>\n            </div>\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"A Dra. Lara é excepcional! Fiz minha harmonização facial e o resultado ficou super natural. Ela entendeu exatamente o que eu queria e superou minhas expectativas.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">FS</div>\n                        <div>\n                            <div class=\"testimonial-name\">Fernanda Silva</div>\n                            <div class=\"testimonial-role\">Paciente de Harmonização</div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"0.1s\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Profissionalismo impecável e cuidado em cada detalhe. Me senti segura durante todo o processo. Recomendo de olhos fechados para quem busca naturalidade!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">PM</div>\n                        <div>\n                            <div class=\"testimonial-name\">Patrícia Mendes</div>\n                            <div class=\"testimonial-role\">Paciente de Toxina</div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"0.2s\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Finalmente encontrei uma profissional que preza pela naturalidade acima de tudo. Meus lábios ficaram perfeitos, muito além do que eu imaginava ser possível.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">CR</div>\n                        <div>\n                            <div class=\"testimonial-name\">Carolina Rodrigues</div>\n                            <div class=\"testimonial-role\">Paciente de Preenchimento</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\">\n        <div class=\"container\">\n            <div class=\"section-header services-intro\">\n                <span class=\"section-subtitle\">Por que nos escolher</span>\n                <h2 class=\"section-title\">Nossos <span class=\"text-golden\">Diferenciais</span></h2>\n            </div>\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up\">\n                    <div class=\"differential-icon\">🎓</div>\n                    <h3 class=\"differential-title\">Especialização</h3>\n                    <p class=\"differential-description\">Formação exclusiva em harmonização facial e estética avançada com atualização constante.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"0.1s\">\n                    <div class=\"differential-icon\">🔬</div>\n                    <h3 class=\"differential-title\">Produtos Premium</h3>\n                    <p class=\"differential-description\">Utilização apenas de produtos de alta qualidade, com procedência garantida e segura.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"0.2s\">\n                    <div class=\"differential-icon\">🎯</div>\n                    <h3 class=\"differential-title\">Personalização</h3>\n                    <p class=\"differential-description\">Cada tratamento é desenvolvido exclusivamente para suas características e objetivos.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"0.3s\">\n                    <div class=\"differential-icon\">💚</div>\n                    <h3 class=\"differential-title\">Segurança</h3>\n                    <p class=\"differential-description\">Procedimentos realizados em ambiente seguro com técnicas comprovadas e eficazes.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"0.4s\">\n                    <div class=\"differential-icon\">📍</div>\n                    <h3 class=\"differential-title\">Localização Privilegiada</h3>\n                    <p class=\"differential-description\">Clínica no Jardim Botânico, com fácil acesso, estacionamento e localização conveniente.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"0.5s\">\n                    <div class=\"differential-icon\">🤝</div>\n                    <h3 class=\"differential-title\">Acompanhamento</h3>\n                    <p class=\"differential-description\">Suporte completo antes, durante e após os procedimentos para sua tranquilidade.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"container\">\n            <div class=\"section-header services-intro\">\n                <span class=\"section-subtitle\">Contato</span>\n                <h2 class=\"section-title\">Agende sua <span class=\"text-sage\">avaliação gratuita</span></h2>\n            </div>\n            <div class=\"contact-grid\">\n                <div class=\"contact-info wow-fade-up\">\n                    <div class=\"contact-info-item\">\n                        <div class=\"contact-icon\">📍</div>\n                        <div>\n                            <div class=\"contact-label\">Endereço</div>\n                            <div class=\"contact-value\">Rua Milton José Robusti, 75 - Sala 506<br>Jardim Botânico, Ribeirão Preto - SP<br>CEP: 14021-613</div>\n                        </div>\n                    </div>\n                    <div class=\"contact-info-item\">\n                        <div class=\"contact-icon\">📱</div>\n                        <div>\n                            <div class=\"contact-label\">WhatsApp / Telefone</div>\n                            <div class=\"contact-value\">(16) 99788-7923</div>\n                        </div>\n                    </div>\n                    <div class=\"contact-info-item\">\n                        <div class=\"contact-icon\">⏰</div>\n                        <div>\n                            <div class=\"contact-label\">Horário de Atendimento</div>\n                            <div class=\"contact-value\">Segunda a Sexta: 9h às 18h<br>Sábado: 9h às 13h</div>\n                        </div>\n                    </div>\n                    <div class=\"contact-info-item\">\n                        <div class=\"contact-icon\">💬</div>\n                        <div>\n                            <div class=\"contact-label\">Agende Online</div>\n                            <a href=\"https://wa.me/5516997887923\" class=\"contact-value text-golden\">Clique para iniciar conversa no WhatsApp</a>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"contact-form-wrapper wow-fade-up\" data-delay=\"0.2s\">\n                    <form id=\"contactForm\">\n                        <div class=\"form-group\">\n                            <label for=\"name\" class=\"form-label\">Nome Completo</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" class=\"form-input\" placeholder=\"Seu nome\" required>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"phone\" class=\"form-label\">Telefone / WhatsApp</label>\n                            <input type=\"tel\" id=\"phone\" name=\"phone\" class=\"form-input\" placeholder=\"(16) 99999-9999\" required>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"service\" class=\"form-label\">Tratamento de Interesse</label>\n                            <select id=\"service\" name=\"service\" class=\"form-select\" required>\n                                <option value=\"\">Selecione uma opção</option>\n                                <option value=\"harmonizacao\">Harmonização Facial</option>\n                                <option value=\"toxina\">Toxina Botulínica</option>\n                                <option value=\"preenchedores\">Preenchedores Faciais</option>\n                                <option value=\"bioestimuladores\">Bioestimuladores</option>\n                                <option value=\"labios\">Preenchimento Labial</option>\n                                <option value=\"outro\">Outro Tratamento</option>\n                            </select>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"message\" class=\"form-label\">Mensagem</label>\n                            <textarea id=\"message\" name=\"message\" class=\"form-textarea\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                        </div>\n                        <button type=\"submit\" class=\"form-submit\">Solicitar Agendamento</button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-content\">\n            <div class=\"footer-brand\">\n                <div class=\"footer-logo\">Dra. Lara Costa</div>\n                <p class=\"footer-description\">\n                    Especialista em harmonização facial e estética avançada em Ribeirão Preto.\n                    Transformando vidas através da autoestima com tratamentos seguros, naturais e personalizados.\n                </p>\n            </div>\n            <div>\n                <h4 class=\"footer-title\">Links Rápidos</h4>\n                <ul class=\"footer-links\">\n                    <li><a href=\"#inicio\">Início</a></li>\n                    <li><a href=\"#servicos\">Serviços</a></li>\n                    <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                    <li><a href=\"#contato\">Contato</a></li>\n                </ul>\n            </div>\n            <div>\n                <h4 class=\"footer-title\">Tratamentos</h4>\n                <ul class=\"footer-links\">\n                    <li><a href=\"#servicos\">Harmonização Facial</a></li>\n                    <li><a href=\"#servicos\">Toxina Botulínica</a></li>\n                    <li><a href=\"#servicos\">Preenchedores</a></li>\n                    <li><a href=\"#servicos\">Bioestimuladores</a></li>\n                </ul>\n            </div>\n        </div>\n        <div class=\"footer-bottom\">\n            <p>&copy; 2024 Dra. Lara Costa - Harmonização Facial em Ribeirão Preto. Todos os direitos reservados.</p>\n        </div>\n    </footer>\n\n    <script>\n        // ========================================\n        // NAVIGATION\n        // ========================================\n        const nav = document.getElementById('nav');\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n        let lastScrollY = window.scrollY;\n\n        // Hide/show nav on scroll\n        window.addEventListener('scroll', () => {\n            if (window.scrollY > lastScrollY && window.scrollY > 100) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n            lastScrollY = window.scrollY;\n        });\n\n        // Mobile menu toggle\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close mobile menu when clicking a link\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ========================================\n        // SMOOTH SCROLL\n        // ========================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ========================================\n        // INTERSECTION OBSERVER (WOW ANIMATIONS)\n        // ========================================\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || '0s';\n                    entry.target.style.setProperty('--delay', delay);\n                    entry.target.classList.add('animated');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ========================================\n        // CONTACT FORM\n        // ========================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', function(e) {\n            e.preventDefault();\n\n            const formData = new FormData(this);\n            const name = formData.get('name');\n            const phone = formData.get('phone');\n            const service = formData.get('service');\n            const message = formData.get('message');\n\n            // Create WhatsApp message\n            const serviceNames = {\n                'harmonizacao': 'Harmonização Facial',\n                'toxina': 'Toxina Botulínica',\n                'preenchedores': 'Preenchedores Faciais',\n                'bioestimuladores': 'Bioestimuladores',\n                'labios': 'Preenchimento Labial',\n                'outro': 'Outro Tratamento'\n            };\n\n            const whatsappMessage = encodeURIComponent(\n                `Olá! Meu nome é ${name}.\\n\\n` +\n                `Gostaria de agendar uma avaliação para: ${serviceNames[service] || service}.\\n\\n` +\n                `Telefone: ${phone}\\n` +\n                `Mensagem: ${message || 'Gostaria de mais informações.'}`\n            );\n\n            // Open WhatsApp with the message\n            window.open(`https://wa.me/5516997887923?text=${whatsappMessage}`, '_blank');\n\n            // Optional: reset form\n            this.reset();\n        });\n\n        // ========================================\n        // PARALLAX EFFECT FOR BLOBS\n        // ========================================\n        document.addEventListener('mousemove', (e) => {\n            const blobs = document.querySelectorAll('.hero-blob');\n            const x = e.clientX / window.innerWidth;\n            const y = e.clientY / window.innerHeight;\n\n            blobs.forEach((blob, index) => {\n                const speed = (index + 1) * 25;\n                const xOffset = (x - 0.5) * speed;\n                const yOffset = (y - 0.5) * speed;\n                const currentTransform = blob.style.transform || '';\n                blob.style.transform = `translate(${xOffset}px, ${yOffset}px)`;\n            });\n        });\n\n        // ========================================\n        // REDUCED MOTION SUPPORT\n        // ========================================\n        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n            document.querySelectorAll('.hero-blob').forEach(blob => {\n                blob.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"7b2b5fe1-65ed-4b78-ae03-7f6126461dbf","uuid":"ced372b8-b9a8-4164-bf9c-d6fb5cb8e9ae"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_36a8746578624103a0b08fe0","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-lara-costa/index.html"}]},"parent_tool_use_id":null,"session_id":"7b2b5fe1-65ed-4b78-ae03-7f6126461dbf","uuid":"8b134200-22d0-4a46-a36d-c63ce89c6065","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-lara-costa/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Lara Costa | Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Lara Costa - Especialista em harmonização facial e estética avançada em Ribeirão Preto. Transforme sua beleza natural com tratamentos personalizados. Agende: (16) 99788-7923\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ========================================\n           CSS VARIABLES & ROOT STYLES\n        ======================================== */\n        :root {\n            /* Colors - Serene Sage & Pearl Palette */\n            --color-sage: #9CBFA8;\n            --color-sage-dark: #7FA68C;\n            --color-sage-light: #B8D4C2;\n            --color-pearl: #F8F6F3;\n            --color-pearl-dark: #E8E4DD;\n            --color-ivory: #FFFEFA;\n            --color-mint: #D4E5DC;\n            --color-seafoam: #C5DDD1;\n            --color-charcoal: #2A2A2A;\n            --color-charcoal-light: #4A4A4A;\n            --color-golden: #C4A77D;\n            --color-golden-light: #D8BE9A;\n            --color-coral: #E8B4A8;\n\n            /* Gradients */\n            --gradient-serene: linear-gradient(135deg, #F8F6F3 0%, #D4E5DC 50%, #FFFEFA 100%);\n            --gradient-fresh: linear-gradient(135deg, #9CBFA8 0%, #C5DDD1 100%);\n            --gradient-pearl: linear-gradient(135deg, #B8D4C2 0%, #C4A77D 100%);\n            --gradient-warm: linear-gradient(135deg, #E8B4A8 0%, #C4A77D 100%);\n\n            /* Typography */\n            --font-display: 'Playfair Display', Georgia, serif;\n            --font-body: 'Inter', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n            --spacing-xxl: 8rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 16px;\n            --radius-lg: 24px;\n            --radius-pill: 100px;\n            --radius-organic: 60% 40% 30% 70% / 60% 30% 70% 40%;\n            --radius-organic-2: 40% 60% 70% 30% / 40% 70% 30% 60%;\n\n            /* Shadows */\n            --shadow-soft: 0 8px 32px rgba(156, 191, 168, 0.15);\n            --shadow-glow: 0 8px 48px rgba(196, 167, 125, 0.2);\n            --shadow-elegant: 0 16px 64px rgba(42, 42, 42, 0.08);\n            --shadow-floating: 0 20px 60px rgba(156, 191, 168, 0.2);\n\n            /* Transitions */\n            --transition-fast: 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-base: 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-slow: 0.8s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n\n        /* ========================================\n           RESET & BASE STYLES\n        ======================================== */\n        *, *::before, *::after {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        html {\n            scroll-behavior: smooth;\n            font-size: 16px;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background: var(--color-ivory);\n            color: var(--color-charcoal);\n            line-height: 1.7;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        img {\n            max-width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-fast);\n        }\n\n        ul {\n            list-style: none;\n        }\n\n        /* ========================================\n           TYPOGRAPHY\n        ======================================== */\n        h1, h2, h3, h4 {\n            font-family: var(--font-display);\n            font-weight: 500;\n            line-height: 1.2;\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 8vw, 5rem);\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 5vw, 3.5rem);\n            letter-spacing: -0.01em;\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 3vw, 2rem);\n        }\n\n        .text-sage { color: var(--color-sage-dark); }\n        .text-golden { color: var(--color-golden); }\n        .text-coral { color: var(--color-coral); }\n\n        /* ========================================\n           NAVIGATION\n        ======================================== */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            background: rgba(255, 254, 250, 0.95);\n            backdrop-filter: blur(20px);\n            z-index: 1000;\n            transition: transform var(--transition-base);\n            box-shadow: 0 1px 0 rgba(156, 191, 168, 0.1);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 1rem 2rem;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            color: var(--color-charcoal);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: 2rem;\n            align-items: center;\n        }\n\n        .nav-link {\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-charcoal-light);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-sage-dark);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.75rem 1.5rem;\n            background: var(--gradient-pearl);\n            color: var(--color-white);\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            cursor: pointer;\n            padding: 10px;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-charcoal);\n            transition: var(--transition-fast);\n        }\n\n        /* Mobile Nav */\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                width: 100%;\n                background: var(--color-ivory);\n                flex-direction: column;\n                padding: 2rem;\n                gap: 1.5rem;\n                transform: translateX(100%);\n                transition: transform var(--transition-base);\n            }\n\n            .nav-menu.active {\n                transform: translateX(0);\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n        }\n\n        /* ========================================\n           HERO SECTION\n        ======================================== */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            position: relative;\n            overflow: hidden;\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--gradient-serene);\n        }\n\n        .hero-background {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            z-index: 0;\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-organic);\n            opacity: 0.7;\n            filter: blur(70px);\n            animation: blob-float 18s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 650px;\n            height: 650px;\n            background: linear-gradient(135deg, var(--color-sage-light) 0%, transparent 70%);\n            top: -250px;\n            right: -150px;\n        }\n\n        .blob-2 {\n            width: 550px;\n            height: 550px;\n            background: linear-gradient(225deg, var(--color-mint) 0%, transparent 70%);\n            bottom: -200px;\n            left: -150px;\n            animation-delay: -6s;\n        }\n\n        .blob-3 {\n            width: 450px;\n            height: 450px;\n            background: linear-gradient(45deg, var(--color-seafoam) 0%, transparent 70%);\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: -12s;\n            border-radius: var(--radius-organic-2);\n        }\n\n        .blob-4 {\n            width: 350px;\n            height: 350px;\n            background: linear-gradient(315deg, var(--color-pearl-dark) 0%, transparent 70%);\n            top: 20%;\n            right: 10%;\n            animation-delay: -3s;\n            border-radius: var(--radius-organic-2);\n            opacity: 0.5;\n        }\n\n        @keyframes blob-float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n                border-radius: var(--radius-organic);\n            }\n            25% {\n                transform: translate(40px, -30px) rotate(8deg) scale(1.08);\n            }\n            50% {\n                transform: translate(-30px, 40px) rotate(-6deg) scale(0.92);\n                border-radius: var(--radius-organic-2);\n            }\n            75% {\n                transform: translate(-40px, -30px) rotate(4deg) scale(1.05);\n            }\n        }\n\n        .hero-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-xl);\n            align-items: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .hero-content {\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fade-up 1s ease forwards;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 0.6rem 1.2rem;\n            background: rgba(156, 191, 168, 0.2);\n            border-radius: var(--radius-pill);\n            font-size: 0.85rem;\n            font-weight: 500;\n            color: var(--color-sage-dark);\n            margin-bottom: var(--spacing-md);\n            border: 1px solid rgba(156, 191, 168, 0.3);\n        }\n\n        .hero-badge::before {\n            content: '';\n            width: 8px;\n            height: 8px;\n            background: var(--color-sage-dark);\n            border-radius: 50%;\n            animation: pulse 2.5s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; transform: scale(1); }\n            50% { opacity: 0.6; transform: scale(1.2); }\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            color: var(--color-charcoal);\n        }\n\n        .hero-description {\n            font-size: 1.15rem;\n            color: var(--color-charcoal-light);\n            margin-bottom: var(--spacing-lg);\n            max-width: 500px;\n        }\n\n        .hero-cta-group {\n            display: flex;\n            gap: 1rem;\n            flex-wrap: wrap;\n        }\n\n        .btn-primary {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            background: var(--gradient-fresh);\n            color: var(--color-white);\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            transition: var(--transition-fast);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-floating);\n        }\n\n        .btn-primary::before {\n            content: '';\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            width: 0;\n            height: 0;\n            background: rgba(255, 255, 255, 0.2);\n            border-radius: 50%;\n            transform: translate(-50%, -50%);\n            transition: width 0.6s, height 0.6s;\n        }\n\n        .btn-primary:active::before {\n            width: 300px;\n            height: 300px;\n        }\n\n        .btn-secondary {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            background: transparent;\n            color: var(--color-charcoal);\n            border: 2px solid var(--color-sage);\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            transition: var(--transition-fast);\n        }\n\n        .btn-secondary:hover {\n            border-color: var(--color-golden);\n            color: var(--color-golden);\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            opacity: 0;\n            transform: translateX(30px);\n            animation: fade-left 1s ease 0.3s forwards;\n        }\n\n        .hero-image {\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-floating);\n        }\n\n        .hero-image-decoration {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            top: 25px;\n            left: 25px;\n            border: 2px solid var(--color-sage);\n            border-radius: var(--radius-lg);\n            z-index: -1;\n            opacity: 0.5;\n        }\n\n        .hero-image-accent {\n            position: absolute;\n            width: 200px;\n            height: 200px;\n            bottom: -50px;\n            right: -50px;\n            background: var(--gradient-pearl);\n            border-radius: var(--radius-organic);\n            opacity: 0.3;\n            filter: blur(40px);\n            z-index: -2;\n        }\n\n        @keyframes fade-up {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fade-left {\n            to {\n                opacity: 1;\n                transform: translateX(0);\n            }\n        }\n\n        /* ========================================\n           PROBLEM/SOLUTION SECTION\n        ======================================== */\n        .section {\n            padding: var(--spacing-xl) var(--spacing-md);\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .problem-solution {\n            background: var(--color-pearl);\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-xl);\n            align-items: center;\n        }\n\n        .section-header {\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .section-subtitle {\n            font-size: 0.85rem;\n            text-transform: uppercase;\n            letter-spacing: 0.2em;\n            color: var(--color-sage-dark);\n            font-weight: 600;\n            margin-bottom: 1rem;\n        }\n\n        .section-title {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .problem-card, .solution-card {\n            padding: var(--spacing-lg);\n            background: var(--color-ivory);\n            border-radius: var(--radius-lg);\n            position: relative;\n            overflow: hidden;\n            margin-bottom: var(--spacing-md);\n            transition: var(--transition-base);\n        }\n\n        .problem-card:hover {\n            transform: translateY(-5px);\n        }\n\n        .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .problem-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: linear-gradient(90deg, var(--color-coral) 0%, var(--color-sage) 100%);\n        }\n\n        .solution-card {\n            box-shadow: var(--shadow-soft);\n        }\n\n        .solution-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: linear-gradient(90deg, var(--color-sage) 0%, var(--color-golden) 100%);\n        }\n\n        .card-icon {\n            width: 64px;\n            height: 64px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--color-mint);\n            border-radius: var(--radius-md);\n            margin-bottom: var(--spacing-md);\n            font-size: 1.8rem;\n        }\n\n        .solution-card .card-icon {\n            background: var(--gradient-fresh);\n        }\n\n        .card-title {\n            margin-bottom: 1rem;\n        }\n\n        .card-list {\n            margin-top: var(--spacing-md);\n        }\n\n        .card-list li {\n            display: flex;\n            align-items: center;\n            gap: 0.75rem;\n            margin-bottom: 0.75rem;\n            font-size: 0.95rem;\n        }\n\n        .card-list li::before {\n            content: '✓';\n            width: 22px;\n            height: 22px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--gradient-fresh);\n            color: var(--color-white);\n            border-radius: 50%;\n            font-size: 0.75rem;\n            flex-shrink: 0;\n        }\n\n        /* ========================================\n           SERVICES SECTION\n        ======================================== */\n        .services {\n            background: var(--color-ivory);\n        }\n\n        .services-intro {\n            text-align: center;\n            max-width: 700px;\n            margin: 0 auto var(--spacing-xl);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-lg);\n        }\n\n        .service-card {\n            padding: var(--spacing-lg);\n            background: var(--color-white);\n            border-radius: var(--radius-lg);\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n            border: 1px solid rgba(156, 191, 168, 0.1);\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background: var(--gradient-serene);\n            opacity: 0;\n            transition: var(--transition-base);\n            z-index: 0;\n        }\n\n        .service-card:hover {\n            transform: translateY(-10px);\n            box-shadow: var(--shadow-floating);\n            border-color: var(--color-sage-light);\n        }\n\n        .service-card:hover::before {\n            opacity: 0.5;\n        }\n\n        .service-icon {\n            width: 72px;\n            height: 72px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--color-mint);\n            border-radius: var(--radius-md);\n            margin-bottom: var(--spacing-md);\n            font-size: 2rem;\n            position: relative;\n            z-index: 1;\n            transition: var(--transition-base);\n        }\n\n        .service-card:hover .service-icon {\n            background: var(--gradient-fresh);\n            transform: scale(1.1);\n        }\n\n        .service-content {\n            position: relative;\n            z-index: 1;\n        }\n\n        .service-title {\n            margin-bottom: 1rem;\n        }\n\n        .service-description {\n            color: var(--color-charcoal-light);\n            margin-bottom: var(--spacing-md);\n            line-height: 1.8;\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-sage-dark);\n            font-weight: 600;\n            font-size: 0.9rem;\n        }\n\n        .service-link::after {\n            content: '→';\n            transition: transform var(--transition-fast);\n        }\n\n        .service-link:hover::after {\n            transform: translateX(5px);\n        }\n\n        /* ========================================\n           TESTIMONIALS SECTION\n        ======================================== */\n        .testimonials {\n            background: var(--gradient-serene);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-lg);\n        }\n\n        .testimonial-card {\n            padding: var(--spacing-lg);\n            background: var(--color-white);\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-soft);\n            transition: var(--transition-base);\n        }\n\n        .testimonial-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-floating);\n        }\n\n        .testimonial-stars {\n            color: var(--color-golden);\n            font-size: 1.2rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .testimonial-text {\n            font-style: italic;\n            color: var(--color-charcoal-light);\n            margin-bottom: var(--spacing-md);\n            line-height: 1.8;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 52px;\n            height: 52px;\n            background: var(--gradient-fresh);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: var(--color-white);\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n        }\n\n        .testimonial-role {\n            font-size: 0.85rem;\n            color: var(--color-charcoal-light);\n        }\n\n        /* ========================================\n           DIFFERENTIALS SECTION\n        ======================================== */\n        .differentials {\n            background: var(--color-charcoal);\n            color: var(--color-ivory);\n        }\n\n        .differentials .section-title {\n            color: var(--color-ivory);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: var(--spacing-lg);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-icon {\n            width: 85px;\n            height: 85px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--gradient-pearl);\n            border-radius: 50%;\n            margin: 0 auto var(--spacing-md);\n            font-size: 2rem;\n            position: relative;\n        }\n\n        .differential-icon::after {\n            content: '';\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            border-radius: 50%;\n            background: var(--gradient-fresh);\n            opacity: 0.3;\n            z-index: -1;\n            animation: pulse-ring 3s ease-in-out infinite;\n        }\n\n        @keyframes pulse-ring {\n            0%, 100% {\n                transform: scale(1);\n                opacity: 0.3;\n            }\n            50% {\n                transform: scale(1.3);\n                opacity: 0;\n            }\n        }\n\n        .differential-title {\n            margin-bottom: 0.75rem;\n        }\n\n        .differential-description {\n            color: rgba(255, 254, 250, 0.7);\n            font-size: 0.95rem;\n            line-height: 1.7;\n        }\n\n        /* ========================================\n           CONTACT SECTION\n        ======================================== */\n        .contact {\n            background: var(--color-pearl);\n        }\n\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-xl);\n        }\n\n        .contact-info {\n            padding: var(--spacing-lg);\n            background: var(--color-ivory);\n            border-radius: var(--radius-lg);\n            border: 1px solid rgba(156, 191, 168, 0.2);\n        }\n\n        .contact-info-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-icon {\n            width: 54px;\n            height: 54px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--color-mint);\n            border-radius: var(--radius-md);\n            font-size: 1.2rem;\n            flex-shrink: 0;\n        }\n\n        .contact-label {\n            font-size: 0.85rem;\n            color: var(--color-charcoal-light);\n            margin-bottom: 0.25rem;\n        }\n\n        .contact-value {\n            font-weight: 600;\n            color: var(--color-charcoal);\n        }\n\n        .contact-form-wrapper {\n            padding: var(--spacing-lg);\n            background: var(--color-white);\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .form-group {\n            margin-bottom: 1.5rem;\n        }\n\n        .form-label {\n            display: block;\n            font-size: 0.9rem;\n            font-weight: 500;\n            margin-bottom: 0.5rem;\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 1rem;\n            border: 2px solid var(--color-sage-light);\n            border-radius: var(--radius-md);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: var(--transition-fast);\n            background: var(--color-ivory);\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-sage-dark);\n            background: var(--color-white);\n        }\n\n        .form-textarea {\n            min-height: 150px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1.25rem;\n            background: var(--gradient-fresh);\n            color: var(--color-white);\n            border: none;\n            border-radius: var(--radius-pill);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: var(--transition-fast);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-floating);\n        }\n\n        /* ========================================\n           FOOTER\n        ======================================== */\n        .footer {\n            background: var(--color-charcoal);\n            color: var(--color-ivory);\n            padding: var(--spacing-xl) var(--spacing-md) var(--spacing-lg);\n        }\n\n        .footer-content {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: var(--spacing-xl);\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .footer-brand .footer-logo {\n            font-family: var(--font-display);\n            font-size: 1.8rem;\n            margin-bottom: 1rem;\n        }\n\n        .footer-description {\n            color: rgba(255, 254, 250, 0.7);\n            font-size: 0.95rem;\n            line-height: 1.8;\n        }\n\n        .footer-title {\n            font-family: var(--font-display);\n            font-size: 1.2rem;\n            margin-bottom: 1rem;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.75rem;\n        }\n\n        .footer-links a {\n            color: rgba(255, 254, 250, 0.7);\n            transition: var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-sage-light);\n        }\n\n        .footer-bottom {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding-top: var(--spacing-md);\n            border-top: 1px solid rgba(255, 254, 250, 0.1);\n            text-align: center;\n            color: rgba(255, 254, 250, 0.5);\n            font-size: 0.9rem;\n        }\n\n        /* ========================================\n           SCROLL ANIMATIONS\n        ======================================== */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(40px);\n            transition: opacity 0.8s ease, transform 0.8s ease;\n        }\n\n        .wow-fade-up.animated {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.8s ease;\n        }\n\n        .wow-fade-in.animated {\n            opacity: 1;\n        }\n\n        [data-delay] {\n            transition-delay: var(--delay);\n        }\n\n        /* ========================================\n           RESPONSIVE DESIGN\n        ======================================== */\n        @media (max-width: 1024px) {\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-description {\n                margin-left: auto;\n                margin-right: auto;\n            }\n\n            .hero-cta-group {\n                justify-content: center;\n            }\n\n            .hero-image-wrapper {\n                max-width: 500px;\n                margin: var(--spacing-lg) auto 0;\n            }\n\n            .problem-solution-grid,\n            .contact-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-content {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        @media (max-width: 768px) {\n            :root {\n                --spacing-lg: 3rem;\n                --spacing-xl: 4rem;\n            }\n\n            .hero, .section {\n                padding: var(--spacing-lg) var(--spacing-sm);\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .hero-cta-group {\n                flex-direction: column;\n            }\n\n            .btn-primary, .btn-secondary {\n                width: 100%;\n                justify-content: center;\n            }\n        }\n\n        @media (max-width: 480px) {\n            h1 {\n                font-size: 2rem;\n            }\n\n            .hero-badge {\n                font-size: 0.75rem;\n            }\n\n            .nav-logo {\n                font-size: 1.2rem;\n            }\n        }\n\n        /* ========================================\n           ACCESSIBILITY\n        ======================================== */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        /* Focus styles */\n        a:focus, button:focus, input:focus, select:focus, textarea:focus {\n            outline: 3px solid var(--color-sage-dark);\n            outline-offset: 2px;\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Lara Costa</a>\n            <div class=\"nav-toggle\" id=\"navToggle\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#inicio\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#contato\" class=\"nav-link\">Contato</a></li>\n                <li><a href=\"tel:+5516997887923\" class=\"nav-cta\">Agendar Consulta</a></li>\n            </ul>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-background\">\n            <div class=\"hero-blob blob-1\"></div>\n            <div class=\"hero-blob blob-2\"></div>\n            <div class=\"hero-blob blob-3\"></div>\n            <div class=\"hero-blob blob-4\"></div>\n        </div>\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge\">\n                    <span>Harmonização Facial & Estética Avançada</span>\n                </div>\n                <h1 class=\"hero-title\">\n                    Sua beleza natural <span class=\"text-sage\">realçada</span> com elegância\n                </h1>\n                <p class=\"hero-description\">\n                    Dra. Lara Costa especialista em harmonização facial e estética avançada em Ribeirão Preto. Resultados naturais que celebram sua beleza única.\n                </p>\n                <div class=\"hero-cta-group\">\n                    <a href=\"https://wa.me/5516997887923\" class=\"btn-primary\">\n                        <span>Agendar Avaliação</span>\n                        <span>→</span>\n                    </a>\n                    <a href=\"#servicos\" class=\"btn-secondary\">\n                        <span>Conhecer Tratamentos</span>\n                    </a>\n                </div>\n            </div>\n            <div class=\"hero-image-wrapper\">\n                <div class=\"hero-image-decoration\"></div>\n                <div class=\"hero-image-accent\"></div>\n                <img src=\"https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=800&h=900&fit=crop\" alt=\"Harmonização Facial - Dra Lara Costa\" class=\"hero-image\" width=\"800\" height=\"900\">\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\">\n        <div class=\"container\">\n            <div class=\"problem-solution-grid\">\n                <div>\n                    <div class=\"section-header\">\n                        <span class=\"section-subtitle\">Entenda sua necessidade</span>\n                        <h2 class=\"section-title\">Você busca uma <span class=\"text-sage\">transformação natural</span>?</h2>\n                    </div>\n                    <div class=\"problem-card wow-fade-up\">\n                        <div class=\"card-icon\">🤔</div>\n                        <h3 class=\"card-title\">Desafios Comuns</h3>\n                        <p>Sinais de envelhecimento, perda de contorno facial, assimetrias, ou simplesmente o desejo de realçar seus traços naturais com segurança e expertise.</p>\n                        <ul class=\"card-list\">\n                            <li>Rugas e linhas de expressão</li>\n                            <li>Perda de volume facial</li>\n                            <li>Assimetrias faciais</li>\n                            <li>Desejo de aparência rejuvenescida</li>\n                        </ul>\n                    </div>\n                </div>\n                <div>\n                    <div class=\"section-header\" style=\"margin-top: 3rem;\">\n                        <h2 class=\"section-title\">Nossa <span class=\"text-golden\">solução exclusiva</span></h2>\n                    </div>\n                    <div class=\"solution-card wow-fade-up\" data-delay=\"0.2s\">\n                        <div class=\"card-icon\">✨</div>\n                        <h3 class=\"card-title\">Tratamentos Personalizados</h3>\n                        <p>Protocolos exclusivos desenvolvidos pela Dra. Lara Costa para resultados naturais, harmoniosos e seguros que respeitam suas características únicas.</p>\n                        <ul class=\"card-list\">\n                            <li>Análise facial personalizada</li>\n                            <li>Produtos de alta qualidade</li>\n                            <li>Técnicas avançadas e seguras</li>\n                            <li>Acompanhamento completo</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"container\">\n            <div class=\"section-header services-intro\">\n                <span class=\"section-subtitle\">Especialidades</span>\n                <h2 class=\"section-title\">Tratamentos que <span class=\"text-sage\">transformam</span></h2>\n                <p>Procedimentos estéticos faciais com foco em resultados naturais e harmoniosos, valorizando sua beleza única com segurança e excelência.</p>\n            </div>\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">👁️</div>\n                    <div class=\"service-content\">\n                        <h3 class=\"service-title\">Harmonização Facial</h3>\n                        <p class=\"service-description\">Equilíbrio dos traços faciais com preenchedores e toxina botulínica para resultados naturais e harmônicos que valorizam sua beleza.</p>\n                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                    </div>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"0.1s\">\n                    <div class=\"service-icon\">💉</div>\n                    <div class=\"service-content\">\n                        <h3 class=\"service-title\">Toxina Botulínica</h3>\n                        <p class=\"service-description\">Suavização de rugas e linhas de expressão com aplicação estratégica para um aspecto descansado, fresco e natural.</p>\n                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                    </div>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"0.2s\">\n                    <div class=\"service-icon\">💧</div>\n                    <div class=\"service-content\">\n                        <h3 class=\"service-title\">Preenchedores Faciais</h3>\n                        <p class=\"service-description\">Restauração de volume e contorno facial com ácido hialurônico de alta qualidade para resultados duradouros e naturais.</p>\n                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                    </div>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"0.3s\">\n                    <div class=\"service-icon\">🔬</div>\n                    <div class=\"service-content\">\n                        <h3 class=\"service-title\">Bioestimuladores</h3>\n                        <p class=\"service-description\">Tratamento que estimula o colágeno natural para rejuvenescimento progressivo e melhora da qualidade da pele