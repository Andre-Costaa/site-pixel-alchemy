city: 1;\n        }\n\n        [data-delay] {\n            transition-delay: var(--delay);\n        }\n\n        /* ========================================\n           RESPONSIVE DESIGN\n        ======================================== */\n        @media (max-width: 1024px) {\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-description {\n                margin-left: auto;\n                margin-right: auto;\n            }\n\n            .hero-cta-group {\n                justify-content: center;\n            }\n\n            .hero-image-wrapper {\n                max-width: 500px;\n                margin: var(--spacing-lg) auto 0;\n            }\n\n            .problem-solution-grid,\n            .contact-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-content {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        @media (max-width: 768px) {\n            :root {\n                --spacing-lg: 3rem;\n                --spacing-xl: 4rem;\n            }\n\n            .hero, .section {\n                padding: var(--spacing-lg) var(--spacing-sm);\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .hero-cta-group {\n                flex-direction: column;\n            }\n\n            .btn-primary, .btn-secondary {\n                width: 100%;\n                justify-content: center;\n            }\n        }\n\n        @media (max-width: 480px) {\n            h1 {\n                font-size: 2rem;\n            }\n\n            .hero-badge {\n                font-size: 0.75rem;\n            }\n\n            .nav-logo {\n                font-size: 1.2rem;\n            }\n        }\n\n        /* ========================================\n           ACCESSIBILITY\n 