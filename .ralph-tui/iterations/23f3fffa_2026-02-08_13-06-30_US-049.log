an> com tratamentos personalizados\n  1109→                </h1>\n  1110→                <p class=\"hero-description\">\n  1111→                    Dra. Angélica Lucena especialista em harmonização facial e estética avançada em Ribeirão Preto. Transforme sua autoestima com resultados naturais e seguros.\n  1112→                </p>\n  1113→                <div class=\"hero-cta-group\">\n  1114→                    <a href=\"https://wa.me/5516996353208\" class=\"btn-primary\">\n  1115→                        <span>Agendar Avaliação</span>\n  1116→                        <span>→</span>\n  1117→                    </a>\n  1118→                    <a href=\"#servicos\" class=\"btn-secondary\">\n  1119→                        <span>Conhecer Tratamentos</span>\n  1120→                    </a>\n  1121→                </div>\n  1122→            </div>\n  1123→            <div class=\"hero-image-wrapper\">\n  1124→                <div class=\"hero-image-decoration\"></div>\n  1125→                <img src=\"https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=800&h=900&fit=crop\" alt=\"Harmonização Facial - Dra Angélica Lucena\" class=\"hero-image\" width=\"800\" height=\"900\">\n  1126→            </div>\n  1127→        </div>\n  1128→    </section>\n  1129→\n  1130→    <!-- Problem/Solution Section -->\n  1131→    <section class=\"section problem-solution\">\n  1132→        <div class=\"container\">\n  1133→            <div class=\"problem-solution-grid\">\n  1134→                <div>\n  1135→                    <div class=\"section-header\">\n  1136→                        <span class=\"section-subtitle\">Entenda sua necessidade</span>\n  1137→                        <h2 class=\"section-title\">Você busca uma <span class=\"text-rose\">transformação natural</span>?</h2>\n  1138→                    </div>\n  1139→                    <div class=\"problem-card wow-fade-up\">\n  1140→                        <div class=\"card-icon\">😔</div>\n  1141→                        <h3 class=\"card-title\">Desafios Comuns</h3>\n  1142→                        <p>Sinais de envelhecimento, perda de contorno facial, assimetrias, ou simplesmente o desejo de realçar seus traços naturais com segurança.</p>\n  1143→                        <ul class=\"card-list\">\n  1144→                            <li>Rugas e linhas de expressão</li>\n  1145→                            <li>Perda de volume facial</li>\n  1146→                            <li>Assimetrias leves</li>\n  1147→                            <li>Desejo de aparência descansada</li>\n  1148→                        </ul>\n  1149→                    </div>\n  1150→                </div>\n  1151→                <div>\n  1152→                    <div class=\"section-header\" style=\"margin-top: 3rem;\">\n  1153→                        <h2 class=\"section-title\">Nossa <span class=\"text-gold\">solução exclusiva</span></h2>\n  1154→                    </div>\n  1155→                    <div class=\"solution-card wow-fade-up\" data-delay=\"0.2s\">\n  1156→                        <div class=\"card-icon\">✨</div>\n  1157→                        <h3 class=\"card-title\">Tratamentos Personalizados</h3>\n  1158→                        <p>Protocolos exclusivos desenvolvidos pela Dra. Angélica Lucena para resultados naturais, harmoniosos e seguros.</p>\n  1159→                        <ul class=\"card-list\">\n  1160→                            <li>Análise facial personalizada</li>\n  1161→                            <li>Produtos de alta qualidade</li>\n  1162→                            <li>Técnicas avançadas e seguras</li>\n  1163→                            <li>Acompanhamento pós-procedimento</li>\n  1164→                        </ul>\n  1165→                    </div>\n  1166→                </div>\n  1167→            </div>\n  1168→        </div>\n  1169→    </section>\n  1170→\n  1171→    <!-- Services Section -->\n  1172→    <section class=\"section services\" id=\"servicos\">\n  1173→        <div class=\"container\">\n  1174→            <div class=\"section-header services-intro\">\n  1175→                <span class=\"section-subtitle\">Especialidades</span>\n  1176→                <h2 class=\"section-title\">Tratamentos que <span class=\"text-rose\">transformam</span></h2>\n  1177→                <p>Procedimentos estéticos faciais com foco em resultados naturais e harmoniosos, valorizando sua beleza única.</p>\n  1178→            </div>\n  1179→            <div class=\"services-grid\">\n  1180→                <div class=\"service-card wow-fade-up\">\n  1181→                    <div class=\"service-icon\">👁️</div>\n  1182→                    <div class=\"service-content\">\n  1183→                        <h3 class=\"service-title\">Harmonização Facial</h3>\n  1184→                        <p class=\"service-description\">Equilibrio dos traços faciais com preenchedores e toxina botulínica para resultados naturais e harmônicos.</p>\n  1185→                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n  1186→                    </div>\n  1187→                </div>\n  1188→                <div class=\"service-card wow-fade-up\" data-delay=\"0.1s\">\n  1189→                    <div class=\"service-icon\">💉</div>\n  1190→                    <div class=\"service-content\">\n  1191→                        <h3 class=\"service-title\">Toxina Botulínica</h3>\n  1192→                        <p class=\"service-description\">Suavização de rugas e linhas de expressão com aplicação estratégica para aspecto descansado e natural.</p>\n  1193→                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n  1194→                    </div>\n  1195→                </div>\n  1196→                <div class=\"service-card wow-fade-up\" data-delay=\"0.2s\">\n  1197→                    <div class=\"service-icon\">💧</div>\n  1198→                    <div class=\"service-content\">\n  1199→                        <h3 class=\"service-title\">Preenchedores Faciais</h3>\n  1200→                        <p class=\"service-description\">Restauração de volume e contorno facial com ácido hialurônico de alta qualidade.</p>\n  1201→                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n  1202→                    </div>\n  1203→                </div>\n  1204→                <div class=\"service-card wow-fade-up\" data-delay=\"0.3s\">\n  1205→                    <div class=\"service-icon\">🔬</div>\n  1206→                    <div class=\"service-content\">\n  1207→                        <h3 class=\"service-title\">Bioestimuladores</h3>\n  1208→                        <p class=\"service-description\">Tratamento que estimula o colágeno natural para rejuvenescimento progressivo da pele.</p>\n  1209→                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n  1210→                    </div>\n  1211→                </div>\n  1212→                <div class=\"service-card wow-fade-up\" data-delay=\"0.4s\">\n  1213→                    <div class=\"service-icon\">👄</div>\n  1214→                    <div class=\"service-content\">\n  1215→                        <h3 class=\"service-title\">Preenchimento Labial</h3>\n  1216→                        <p class=\"service-description\">Realce dos lábios com técnicas que mantêm a naturalidade e proporções harmoniosas.</p>\n  1217→                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n  1218→                    </div>\n  1219→                </div>\n  1220→                <div class=\"service-card wow-fade-up\" data-delay=\"0.5s\">\n  1221→                    <div class=\"service-icon\">✨</div>\n  1222→                    <div class=\"service-content\">\n  1223→                        <h3 class=\"service-title\">Protocolos Exclusivos</h3>\n  1224→                        <p class=\"service-description\">Combinação de tratamentos personalizados conforme suas necessidades e objetivos estéticos.</p>\n  1225→                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n  1226→                    </div>\n  1227→                </div>\n  1228→            </div>\n  1229→        </div>\n  1230→    </section>\n  1231→\n  1232→    <!-- Testimonials Section -->\n  1233→    <section class=\"section testimonials\" id=\"depoimentos\">\n  1234→        <div class=\"container\">\n  1235→            <div class=\"section-header services-intro\">\n  1236→                <span class=\"section-subtitle\">Depoimentos</span>\n  1237→                <h2 class=\"section-title\">O que nossas <span class=\"text-gold\">pacientes</span> dizem</h2>\n  1238→            </div>\n  1239→            <div class=\"testimonials-grid\">\n  1240→                <div class=\"testimonial-card wow-fade-up\">\n  1241→                    <div class=\"testimonial-stars\">★★★★★</div>\n  1242→                    <p class=\"testimonial-text\">\"A Dra. Angélica é incrível! Fiz minha harmonização facial e o resultado ficou super natural. Ela entendeu exatamente o que eu queria.\"</p>\n  1243→                    <div class=\"testimonial-author\">\n  1244→                        <div class=\"testimonial-avatar\">MC</div>\n  1245→                        <div>\n  1246→                            <div class=\"testimonial-name\">Maria Clara</div>\n  1247→                            <div class=\"testimonial-role\">Paciente de Harmonização</div>\n  1248→                        </div>\n  1249→                    </div>\n  1250→                </div>\n  1251→                <div class=\"testimonial-card wow-fade-up\" data-delay=\"0.1s\">\n  1252→                    <div class=\"testimonial-stars\">★★★★★</div>\n  1253→                    <p class=\"testimonial-text\">\"Profissionalismo e cuidado em cada detalhe. Me senti segura durante todo o processo. Recomendo de olhos fechados!\"</p>\n  1254→                    <div class=\"testimonial-author\">\n  1255→                        <div class=\"testimonial-avatar\">AS</div>\n  1256→                        <div>\n  1257→                            <div class=\"testimonial-name\">Ana Silva</div>\n  1258→                            <div class=\"testimonial-role\">Paciente de Toxina</div>\n  1259→                        </div>\n  1260→                    </div>\n  1261→                </div>\n  1262→                <div class=\"testimonial-card wow-fade-up\" data-delay=\"0.2s\">\n  1263→                    <div class=\"testimonial-stars\">★★★★★</div>\n  1264→                    <p class=\"testimonial-text\">\"Finalmente encontrei uma profissional que preza pela naturalidade. Meus lábios ficaram perfeitos, muito além do que esperava.\"</p>\n  1265→                    <div class=\"testimonial-author\">\n  1266→                        <div class=\"testimonial-avatar\">JO</div>\n  1267→                        <div>\n  1268→                            <div class=\"testimonial-name\">Juliana Oliveira</div>\n  1269→                            <div class=\"testimonial-role\">Paciente de Preenchimento</div>\n  1270→                        </div>\n  1271→                    </div>\n  1272→                </div>\n  1273→            </div>\n  1274→        </div>\n  1275→    </section>\n  1276→\n  1277→    <!-- Differentials Section -->\n  1278→    <section class=\"section differentials\">\n  1279→        <div class=\"container\">\n  1280→            <div class=\"section-header services-intro\">\n  1281→                <span class=\"section-subtitle\">Por que nos escolher</span>\n  1282→                <h2 class=\"section-title\">Nossos <span class=\"text-gold\">Diferenciais</span></h2>\n  1283→            </div>\n  1284→            <div class=\"differentials-grid\">\n  1285→                <div class=\"differential-item wow-fade-up\">\n  1286→                    <div class=\"differential-icon\">🎓</div>\n  1287→                    <h3 class=\"differential-title\">Especialização</h3>\n  1288→                    <p class=\"differential-description\">Formação exclusiva em harmonização facial e estética avançada.</p>\n  1289→                </div>\n  1290→                <div class=\"differential-item wow-fade-up\" data-delay=\"0.1s\">\n  1291→                    <div class=\"differential-icon\">🔬</div>\n  1292→                    <h3 class=\"differential-title\">Produtos Premium</h3>\n  1293→                    <p class=\"differential-description\">Utilização apenas de produtos de alta qualidade e com procedência.</p>\n  1294→                </div>\n  1295→                <div class=\"differential-item wow-fade-up\" data-delay=\"0.2s\">\n  1296→                    <div class=\"differential-icon\">🎯</div>\n  1297→                    <h3 class=\"differential-title\">Personalização</h3>\n  1298→                    <p class=\"differential-description\">Cada tratamento é desenvolvido exclusivamente para você.</p>\n  1299→                </div>\n  1300→                <div class=\"differential-item wow-fade-up\" data-delay=\"0.3s\">\n  1301→                    <div class=\"differential-icon\">💚</div>\n  1302→                    <h3 class=\"differential-title\">Segurança</h3>\n  1303→                    <p class=\"differential-description\">Procedimentos realizados com técnicas seguras e comprovadas.</p>\n  1304→                </div>\n  1305→                <div class=\"differential-item wow-fade-up\" data-delay=\"0.4s\">\n  1306→                    <div class=\"differential-icon\">📍</div>\n  1307→                    <h3 class=\"differential-title\">Localização Privilegiada</h3>\n  1308→                    <p class=\"differential-description\">Clínica no Jardim Sumaré, com fácil acesso e estacionamento.</p>\n  1309→                </div>\n  1310→                <div class=\"differential-item wow-fade-up\" data-delay=\"0.5s\">\n  1311→                    <div class=\"differential-icon\">🤝</div>\n  1312→                    <h3 class=\"differential-title\">Acompanhamento</h3>\n  1313→                    <p class=\"differential-description\">Suporte completo antes, durante e após os procedimentos.</p>\n  1314→                </div>\n  1315→            </div>\n  1316→        </div>\n  1317→    </section>\n  1318→\n  1319→    <!-- Contact Section -->\n  1320→    <section class=\"section contact\" id=\"contato\">\n  1321→        <div class=\"container\">\n  1322→            <div class=\"section-header services-intro\">\n  1323→                <span class=\"section-subtitle\">Contato</span>\n  1324→                <h2 class=\"section-title\">Agende sua <span class=\"text-rose\">avaliação gratuita</span></h2>\n  1325→            </div>\n  1326→            <div class=\"contact-grid\">\n  1327→                <div class=\"contact-info wow-fade-up\">\n  1328→                    <div class=\"contact-info-item\">\n  1329→                        <div class=\"contact-icon\">📍</div>\n  1330→                        <div>\n  1331→                            <div class=\"contact-label\">Endereço</div>\n  1332→                            <div class=\"contact-value\">R. Garibaldi, 1928<br>Jardim Sumaré, Ribeirão Preto - SP<br>CEP: 14025-382</div>\n  1333→                        </div>\n  1334→                    </div>\n  1335→                    <div class=\"contact-info-item\">\n  1336→                        <div class=\"contact-icon\">📱</div>\n  1337→                        <div>\n  1338→                            <div class=\"contact-label\">WhatsApp / Telefone</div>\n  1339→                            <div class=\"contact-value\">(16) 99635-3208</div>\n  1340→                        </div>\n  1341→                    </div>\n  1342→                    <div class=\"contact-info-item\">\n  1343→                        <div class=\"contact-icon\">⏰</div>\n  1344→                        <div>\n  1345→                            <div class=\"contact-label\">Horário de Atendimento</div>\n  1346→                            <div class=\"contact-value\">Segunda a Sexta: 9h às 18h<br>Sábado: 9h às 13h</div>\n  1347→                        </div>\n  1348→                    </div>\n  1349→                    <div class=\"contact-info-item\">\n  1350→                        <div class=\"contact-icon\">💬</div>\n  1351→                        <div>\n  1352→                            <div class=\"contact-label\">Agende Online</div>\n  1353→                            <a href=\"https://wa.me/5516996353208\" class=\"contact-value text-gold\">Clique para iniciar conversa no WhatsApp</a>\n  1354→                        </div>\n  1355→                    </div>\n  1356→                </div>\n  1357→                <div class=\"contact-form-wrapper wow-fade-up\" data-delay=\"0.2s\">\n  1358→                    <form id=\"contactForm\">\n  1359→                        <div class=\"form-group\">\n  1360→                            <label for=\"name\" class=\"form-label\">Nome Completo</label>\n  1361→                            <input type=\"text\" id=\"name\" name=\"name\" class=\"form-input\" placeholder=\"Seu nome\" required>\n  1362→                        </div>\n  1363→                        <div class=\"form-group\">\n  1364→                            <label for=\"phone\" class=\"form-label\">Telefone / WhatsApp</label>\n  1365→                            <input type=\"tel\" id=\"phone\" name=\"phone\" class=\"form-input\" placeholder=\"(16) 99999-9999\" required>\n  1366→                        </div>\n  1367→                        <div class=\"form-group\">\n  1368→                            <label for=\"service\" class=\"form-label\">Tratamento de Interesse</label>\n  1369→                            <select id=\"service\" name=\"service\" class=\"form-select\" required>\n  1370→                                <option value=\"\">Selecione uma opção</option>\n  1371→                                <option value=\"harmonizacao\">Harmonização Facial</option>\n  1372→                                <option value=\"toxina\">Toxina Botulínica</option>\n  1373→                                <option value=\"preenchedores\">Preenchedores Faciais</option>\n  1374→                                <option value=\"bioestimuladores\">Bioestimuladores</option>\n  1375→                                <option value=\"labios\">Preenchimento Labial</option>\n  1376→                                <option value=\"outro\">Outro Tratamento</option>\n  1377→                            </select>\n  1378→                        </div>\n  1379→                        <div class=\"form-group\">\n  1380→                            <label for=\"message\" class=\"form-label\">Mensagem</label>\n  1381→                            <textarea id=\"message\" name=\"message\" class=\"form-textarea\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n  1382→                        </div>\n  1383→                        <button type=\"submit\" class=\"form-submit\">Solicitar Agendamento</button>\n  1384→                    </form>\n  1385→                </div>\n  1386→            </div>\n  1387→        </div>\n  1388→    </section>\n  1389→\n  1390→    <!-- Footer -->\n  1391→    <footer class=\"footer\">\n  1392→        <div class=\"footer-content\">\n  1393→            <div class=\"footer-brand\">\n  1394→                <div class=\"footer-logo\">Dra. Angélica Lucena</div>\n  1395→                <p class=\"footer-description\">\n  1396→                    Especialista em harmonização facial e estética avançada em Ribeirão Preto.\n  1397→                    Transformando vidas através da autoestima com tratamentos seguros e personalizados.\n  1398→                </p>\n  1399→            </div>\n  1400→            <div>\n  1401→                <h4 class=\"footer-title\">Links Rápidos</h4>\n  1402→                <ul class=\"footer-links\">\n  1403→                    <li><a href=\"#inicio\">Início</a></li>\n  1404→                    <li><a href=\"#servicos\">Serviços</a></li>\n  1405→                    <li><a href=\"#depoimentos\">Depoimentos</a></li>\n  1406→                    <li><a href=\"#contato\">Contato</a></li>\n  1407→                </ul>\n  1408→            </div>\n  1409→            <div>\n  1410→                <h4 class=\"footer-title\">Tratamentos</h4>\n  1411→                <ul class=\"footer-links\">\n  1412→                    <li><a href=\"#servicos\">Harmonização Facial</a></li>\n  1413→                    <li><a href=\"#servicos\">Toxina Botulínica</a></li>\n  1414→                    <li><a href=\"#servicos\">Preenchedores</a></li>\n  1415→                    <li><a href=\"#servicos\">Bioestimuladores</a></li>\n  1416→                </ul>\n  1417→            </div>\n  1418→        </div>\n  1419→        <div class=\"footer-bottom\">\n  1420→            <p>&copy; 2024 Dra. Angélica Lucena - Harmonização Facial em Ribeirão Preto. Todos os direitos reservados.</p>\n  1421→        </div>\n  1422→    </footer>\n  1423→\n  1424→    <script>\n  1425→        // ========================================\n  1426→        // NAVIGATION\n  1427→        // ========================================\n  1428→        const nav = document.getElementById('nav');\n  1429→        const navToggle = document.getElementById('navToggle');\n  1430→        const navMenu = document.getElementById('navMenu');\n  1431→        let lastScrollY = window.scrollY;\n  1432→\n  1433→        // Hide/show nav on scroll\n  1434→        window.addEventListener('scroll', () => {\n  1435→            if (window.scrollY > lastScrollY && window.scrollY > 100) {\n  1436→                nav.classList.add('hidden');\n  1437→            } else {\n  1438→                nav.classList.remove('hidden');\n  1439→            }\n  1440→            lastScrollY = window.scrollY;\n  1441→        });\n  1442→\n  1443→        // Mobile menu toggle\n  1444→        navToggle.addEventListener('click', () => {\n  1445→            navMenu.classList.toggle('active');\n  1446→        });\n  1447→\n  1448→        // Close mobile menu when clicking a link\n  1449→        document.querySelectorAll('.nav-link').forEach(link => {\n  1450→            link.addEventListener('click', () => {\n  1451→                navMenu.classList.remove('active');\n  1452→            });\n  1453→        });\n  1454→\n  1455→        // ========================================\n  1456→        // SMOOTH SCROLL\n  1457→        // ========================================\n  1458→        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n  1459→            anchor.addEventListener('click', function(e) {\n  1460→                e.preventDefault();\n  1461→                const target = document.querySelector(this.getAttribute('href'));\n  1462→                if (target) {\n  1463→                    const navHeight = nav.offsetHeight;\n  1464→                    const targetPosition = target.offsetTop - navHeight;\n  1465→                    window.scrollTo({\n  1466→                        top: targetPosition,\n  1467→                        behavior: 'smooth'\n  1468→                    });\n  1469→                }\n  1470→            });\n  1471→        });\n  1472→\n  1473→        // ========================================\n  1474→        // INTERSECTION OBSERVER (WOW ANIMATIONS)\n  1475→        // ========================================\n  1476→        const observerOptions = {\n  1477→            root: null,\n  1478→            rootMargin: '0px',\n  1479→            threshold: 0.1\n  1480→        };\n  1481→\n  1482→        const observer = new IntersectionObserver((entries) => {\n  1483→            entries.forEach(entry => {\n  1484→                if (entry.isIntersecting) {\n  1485→                    const delay = entry.target.dataset.delay || '0s';\n  1486→                    entry.target.style.setProperty('--delay', delay);\n  1487→                    entry.target.classList.add('animated');\n  1488→                    observer.unobserve(entry.target);\n  1489→                }\n  1490→            });\n  1491→        }, observerOptions);\n  1492→\n  1493→        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n  1494→            observer.observe(el);\n  1495→        });\n  1496→\n  1497→        // ========================================\n  1498→        // CONTACT FORM\n  1499→        // ========================================\n  1500→        const contactForm = document.getElementById('contactForm');\n  1501→\n  1502→        contactForm.addEventListener('submit', function(e) {\n  1503→            e.preventDefault();\n  1504→\n  1505→            const formData = new FormData(this);\n  1506→            const name = formData.get('name');\n  1507→            const phone = formData.get('phone');\n  1508→            const service = formData.get('service');\n  1509→            const message = formData.get('message');\n  1510→\n  1511→            // Create WhatsApp message\n  1512→            const serviceNames = {\n  1513→                'harmonizacao': 'Harmonização Facial',\n  1514→                'toxina': 'Toxina Botulínica',\n  1515→                'preenchedores': 'Preenchedores Faciais',\n  1516→                'bioestimuladores': 'Bioestimuladores',\n  1517→                'labios': 'Preenchimento Labial',\n  1518→                'outro': 'Outro Tratamento'\n  1519→            };\n  1520→\n  1521→            const whatsappMessage = encodeURIComponent(\n  1522→                `Olá! Meu nome é ${name}.\\n\\n` +\n  1523→                `Gostaria de agendar uma avaliação para: ${serviceNames[service] || service}.\\n\\n` +\n  1524→                `Telefone: ${phone}\\n` +\n  1525→                `Mensagem: ${message || 'Gostaria de mais informações.'}`\n  1526→            );\n  1527→\n  1528→            // Open WhatsApp with the message\n  1529→            window.open(`https://wa.me/5516996353208?text=${whatsappMessage}`, '_blank');\n  1530→\n  1531→            // Optional: reset form\n  1532→            this.reset();\n  1533→        });\n  1534→\n  1535→        // ========================================\n  1536→        // PARALLAX EFFECT FOR BLOBS\n  1537→        // ========================================\n  1538→        document.addEventListener('mousemove', (e) => {\n  1539→            const blobs = document.querySelectorAll('.hero-blob');\n  1540→            const x = e.clientX / window.innerWidth;\n  1541→            const y = e.clientY / window.innerHeight;\n  1542→\n  1543→            blobs.forEach((blob, index) => {\n  1544→                const speed = (index + 1) * 20;\n  1545→                const xOffset = (x - 0.5) * speed;\n  1546→                const yOffset = (y - 0.5) * speed;\n  1547→                blob.style.transform = `translate(${xOffset}px, ${yOffset}px)`;\n  1548→            });\n  1549→        });\n  1550→\n  1551→        // ========================================\n  1552→        // REDUCED MOTION SUPPORT\n  1553→        // ========================================\n  1554→        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n  1555→            document.querySelectorAll('.hero-blob').forEach(blob => {\n  1556→                blob.style.animation = 'none';\n  1557→            });\n  1558→        }\n  1559→    </script>\n  1560→</body>\n  1561→</html>\n  1562→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"7b2b5fe1-65ed-4b78-ae03-7f6126461dbf","uuid":"356702ab-2007-4ca4-9528-333b96b4db80","tool_use_result":{"type":"text","file":{"filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-angelica-lucena/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Angélica Lucena | Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Angélica Lucena - Especialista em harmonização facial e estética avançada em Ribeirão Preto. Transforme sua aparência com tratamentos personalizados. Agende: (16) 99635-3208\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Montserrat:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ========================================\n           CSS VARIABLES & ROOT STYLES\n        ======================================== */\n        :root {\n            /* Colors - Ethereal Rose & Gold Palette */\n            --color-blush: #F8E8E8;\n            --color-rose: #E8B4B8;\n            --color-rose-dark: #D4959A;\n            --color-champagne: #F5EDE3;\n            --color-gold: #C9A86C;\n            --color-gold-light: #DFC9A3;\n            --color-sand: #D4C4B0;\n            --color-ivory: #FFFEF9;\n            --color-charcoal: #2C2C2C;\n            --color-charcoal-light: #4A4A4A;\n            --color-mauve: #B8A5B5;\n\n            /* Gradients */\n            --gradient-ethereal: linear-gradient(135deg, #F8E8E8 0%, #F5EDE3 50%, #FFF5F5 100%);\n            --gradient-glow: linear-gradient(135deg, #E8B4B8 0%, #F5EDE3 100%);\n            --gradient-rose: linear-gradient(135deg, #D4959A 0%, #C9A86C 100%);\n\n            /* Typography */\n            --font-display: 'Cormorant Garamond', Georgia, serif;\n            --font-body: 'Montserrat', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n            --spacing-xxl: 8rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 16px;\n            --radius-lg: 24px;\n            --radius-pill: 100px;\n            --radius-organic: 60% 40% 30% 70% / 60% 30% 70% 40%;\n\n            /* Shadows */\n            --shadow-soft: 0 8px 32px rgba(201, 168, 108, 0.15);\n            --shadow-glow: 0 8px 48px rgba(232, 180, 184, 0.25);\n            --shadow-elegant: 0 16px 64px rgba(44, 44, 44, 0.08);\n\n            /* Transitions */\n            --transition-fast: 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-base: 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-slow: 0.8s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n\n        /* ========================================\n           RESET & BASE STYLES\n        ======================================== */\n        *, *::before, *::after {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        html {\n            scroll-behavior: smooth;\n            font-size: 16px;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background: var(--color-ivory);\n            color: var(--color-charcoal);\n            line-height: 1.7;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        img {\n            max-width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-fast);\n        }\n\n        ul {\n            list-style: none;\n        }\n\n        /* ========================================\n           TYPOGRAPHY\n        ======================================== */\n        h1, h2, h3, h4 {\n            font-family: var(--font-display);\n            font-weight: 500;\n            line-height: 1.2;\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 8vw, 5rem);\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 5vw, 3.5rem);\n            letter-spacing: -0.01em;\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 3vw, 2rem);\n        }\n\n        .text-rose { color: var(--color-rose-dark); }\n        .text-gold { color: var(--color-gold); }\n\n        /* ========================================\n           NAVIGATION\n        ======================================== */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            background: rgba(255, 254, 249, 0.95);\n            backdrop-filter: blur(20px);\n            z-index: 1000;\n            transition: transform var(--transition-base);\n            box-shadow: 0 1px 0 rgba(201, 168, 108, 0.1);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 1rem 2rem;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            color: var(--color-charcoal);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: 2rem;\n            align-items: center;\n        }\n\n        .nav-link {\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-charcoal-light);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-gold);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.75rem 1.5rem;\n            background: var(--gradient-rose);\n            color: var(--color-white);\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            cursor: pointer;\n            padding: 10px;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-charcoal);\n            transition: var(--transition-fast);\n        }\n\n        /* Mobile Nav */\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                width: 100%;\n                background: var(--color-ivory);\n                flex-direction: column;\n                padding: 2rem;\n                gap: 1.5rem;\n                transform: translateX(100%);\n                transition: transform var(--transition-base);\n            }\n\n            .nav-menu.active {\n                transform: translateX(0);\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n        }\n\n        /* ========================================\n           HERO SECTION\n        ======================================== */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            position: relative;\n            overflow: hidden;\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--gradient-ethereal);\n        }\n\n        .hero-background {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            z-index: 0;\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-organic);\n            opacity: 0.6;\n            filter: blur(80px);\n            animation: blob-float 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 600px;\n            height: 600px;\n            background: linear-gradient(135deg, var(--color-rose) 0%, transparent 70%);\n            top: -200px;\n            right: -100px;\n        }\n\n        .blob-2 {\n            width: 500px;\n            height: 500px;\n            background: linear-gradient(225deg, var(--color-gold-light) 0%, transparent 70%);\n            bottom: -150px;\n            left: -100px;\n            animation-delay: -5s;\n        }\n\n        .blob-3 {\n            width: 400px;\n            height: 400px;\n            background: linear-gradient(45deg, var(--color-blush) 0%, transparent 70%);\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: -10s;\n        }\n\n        @keyframes blob-float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg) scale(1.05);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg) scale(0.95);\n            }\n            75% {\n                transform: translate(-30px, -20px) rotate(3deg) scale(1.02);\n            }\n        }\n\n        .hero-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-xl);\n            align-items: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .hero-content {\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fade-up 1s ease forwards;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 0.5rem 1rem;\n            background: rgba(201, 168, 108, 0.15);\n            border-radius: var(--radius-pill);\n            font-size: 0.85rem;\n            font-weight: 500;\n            color: var(--color-gold);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-badge::before {\n            content: '';\n            width: 8px;\n            height: 8px;\n            background: var(--color-gold);\n            border-radius: 50%;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; }\n            50% { opacity: 0.5; }\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            color: var(--color-charcoal);\n        }\n\n        .hero-description {\n            font-size: 1.15rem;\n            color: var(--color-charcoal-light);\n            margin-bottom: var(--spacing-lg);\n            max-width: 500px;\n        }\n\n        .hero-cta-group {\n            display: flex;\n            gap: 1rem;\n            flex-wrap: wrap;\n        }\n\n        .btn-primary {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            background: var(--gradient-rose);\n            color: var(--color-white);\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            transition: var(--transition-fast);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .btn-primary::before {\n            content: '';\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            width: 0;\n            height: 0;\n            background: rgba(255, 255, 255, 0.2);\n            border-radius: 50%;\n            transform: translate(-50%, -50%);\n            transition: width 0.6s, height 0.6s;\n        }\n\n        .btn-primary:active::before {\n            width: 300px;\n            height: 300px;\n        }\n\n        .btn-secondary {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            background: transparent;\n            color: var(--color-charcoal);\n            border: 2px solid var(--color-sand);\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            transition: var(--transition-fast);\n        }\n\n        .btn-secondary:hover {\n            border-color: var(--color-gold);\n            color: var(--color-gold);\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            opacity: 0;\n            transform: translateX(30px);\n            animation: fade-left 1s ease 0.3s forwards;\n        }\n\n        .hero-image {\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-elegant);\n        }\n\n        .hero-image-decoration {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            top: 20px;\n            left: 20px;\n            border: 2px solid var(--color-gold);\n            border-radius: var(--radius-lg);\n            z-index: -1;\n        }\n\n        @keyframes fade-up {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fade-left {\n            to {\n                opacity: 1;\n                transform: translateX(0);\n            }\n        }\n\n        /* ========================================\n           PROBLEM/SOLUTION SECTION\n        ======================================== */\n        .section {\n            padding: var(--spacing-xl) var(--spacing-md);\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .problem-solution {\n            background: var(--color-champagne);\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-xl);\n            align-items: center;\n        }\n\n        .section-header {\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .section-subtitle {\n            font-size: 0.85rem;\n            text-transform: uppercase;\n            letter-spacing: 0.2em;\n            color: var(--color-gold);\n            font-weight: 600;\n            margin-bottom: 1rem;\n        }\n\n        .section-title {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .problem-card, .solution-card {\n            padding: var(--spacing-lg);\n            background: var(--color-ivory);\n            border-radius: var(--radius-lg);\n            position: relative;\n            overflow: hidden;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .problem-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: linear-gradient(90deg, var(--color-rose) 0%, var(--color-gold) 100%);\n        }\n\n        .solution-card {\n            box-shadow: var(--shadow-soft);\n        }\n\n        .solution-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: linear-gradient(90deg, var(--color-gold) 0%, var(--color-gold-light) 100%);\n        }\n\n        .card-icon {\n            width: 60px;\n            height: 60px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--color-blush);\n            border-radius: var(--radius-md);\n            margin-bottom: var(--spacing-md);\n            font-size: 1.5rem;\n        }\n\n        .card-title {\n            margin-bottom: 1rem;\n        }\n\n        .card-list {\n            margin-top: var(--spacing-md);\n        }\n\n        .card-list li {\n            display: flex;\n            align-items: center;\n            gap: 0.75rem;\n            margin-bottom: 0.75rem;\n            font-size: 0.95rem;\n        }\n\n        .card-list li::before {\n            content: '✓';\n            width: 20px;\n            height: 20px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--gradient-rose);\n            color: var(--color-white);\n            border-radius: 50%;\n            font-size: 0.75rem;\n            flex-shrink: 0;\n        }\n\n        /* ========================================\n           SERVICES SECTION\n        ======================================== */\n        .services {\n            background: var(--color-ivory);\n        }\n\n        .services-intro {\n            text-align: center;\n            max-width: 700px;\n            margin: 0 auto var(--spacing-xl);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-lg);\n        }\n\n        .service-card {\n            padding: var(--spacing-lg);\n            background: var(--color-white);\n            border-radius: var(--radius-lg);\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background: var(--gradient-ethereal);\n            opacity: 0;\n            transition: var(--transition-base);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-elegant);\n        }\n\n        .service-card:hover::before {\n            opacity: 1;\n        }\n\n        .service-icon {\n            width: 70px;\n            height: 70px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--color-blush);\n            border-radius: var(--radius-md);\n            margin-bottom: var(--spacing-md);\n            font-size: 2rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .service-content {\n            position: relative;\n            z-index: 1;\n        }\n\n        .service-title {\n            margin-bottom: 1rem;\n        }\n\n        .service-description {\n            color: var(--color-charcoal-light);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-gold);\n            font-weight: 600;\n            font-size: 0.9rem;\n        }\n\n        .service-link::after {\n            content: '→';\n            transition: transform var(--transition-fast);\n        }\n\n        .service-link:hover::after {\n            transform: translateX(5px);\n        }\n\n        /* ========================================\n           TESTIMONIALS SECTION\n        ======================================== */\n        .testimonials {\n            background: var(--gradient-ethereal);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-lg);\n        }\n\n        .testimonial-card {\n            padding: var(--spacing-lg);\n            background: var(--color-white);\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .testimonial-stars {\n            color: var(--color-gold);\n            font-size: 1.2rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .testimonial-text {\n            font-style: italic;\n            color: var(--color-charcoal-light);\n            margin-bottom: var(--spacing-md);\n            line-height: 1.8;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: var(--color-blush);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: var(--color-rose-dark);\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n        }\n\n        .testimonial-role {\n            font-size: 0.85rem;\n            color: var(--color-charcoal-light);\n        }\n\n        /* ========================================\n           DIFFERENTIALS SECTION\n        ======================================== */\n        .differentials {\n            background: var(--color-charcoal);\n            color: var(--color-ivory);\n        }\n\n        .differentials .section-title {\n            color: var(--color-ivory);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: var(--spacing-lg);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-icon {\n            width: 80px;\n            height: 80px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--gradient-rose);\n            border-radius: 50%;\n            margin: 0 auto var(--spacing-md);\n            font-size: 2rem;\n        }\n\n        .differential-title {\n            margin-bottom: 0.75rem;\n        }\n\n        .differential-description {\n            color: rgba(255, 254, 249, 0.7);\n            font-size: 0.95rem;\n        }\n\n        /* ========================================\n           CONTACT SECTION\n        ======================================== */\n        .contact {\n            background: var(--color-champagne);\n        }\n\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-xl);\n        }\n\n        .contact-info {\n            padding: var(--spacing-lg);\n            background: var(--color-ivory);\n            border-radius: var(--radius-lg);\n        }\n\n        .contact-info-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-icon {\n            width: 50px;\n            height: 50px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--color-blush);\n            border-radius: var(--radius-md);\n            font-size: 1.2rem;\n            flex-shrink: 0;\n        }\n\n        .contact-label {\n            font-size: 0.85rem;\n            color: var(--color-charcoal-light);\n            margin-bottom: 0.25rem;\n        }\n\n        .contact-value {\n            font-weight: 600;\n            color