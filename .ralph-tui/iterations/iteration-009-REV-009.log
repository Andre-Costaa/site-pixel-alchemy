er-radius: var(--radius-full);\n   151→            transition: all var(--transition-base);\n   152→            position: relative;\n   153→            overflow: hidden;\n   154→        }\n   155→\n   156→        .btn-primary {\n   157→            background: var(--gradient-warm);\n   158→            color: var(--color-white);\n   159→            box-shadow: var(--shadow-md);\n   160→        }\n   161→\n   162→        .btn-primary:hover {\n   163→            transform: translateY(-3px);\n   164→            box-shadow: var(--shadow-glow);\n   165→        }\n   166→\n   167→        .btn-secondary {\n   168→            background: var(--color-white);\n   169→            color: var(--color-coral);\n   170→            border: 2px solid var(--color-coral);\n   171→        }\n   172→\n   173→        .btn-secondary:hover {\n   174→            background: var(--color-coral);\n   175→            color: var(--color-white);\n   176→        }\n   177→\n   178→        .btn-large {\n   179→            padding: 1.25rem 2.5rem;\n   180→            font-size: 1.125rem;\n   181→        }\n   182→\n   183→        /* ============================================\n   184→           NAVIGATION\n   185→           ============================================ */\n   186→        .nav {\n   187→            position: fixed;\n   188→            top: 0;\n   189→            left: 0;\n   190→            right: 0;\n   191→            z-index: 1000;\n   192→            padding: 1rem 0;\n   193→            transition: all var(--transition-base);\n   194→            background: transparent;\n   195→        }\n   196→\n   197→        .nav.scrolled {\n   198→            background: rgba(255,248,240,0.95);\n   199→            backdrop-filter: blur(10px);\n   200→            box-shadow: var(--shadow-sm);\n   201→        }\n   202→\n   203→        .nav-container {\n   204→            display: flex;\n   205→            justify-content: space-between;\n   206→            align-items: center;\n   207→        }\n