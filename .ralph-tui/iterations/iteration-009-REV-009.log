;\n   271→            display: flex;\n   272→            flex-direction: column;\n   273→            gap: 1.5rem;\n   274→        }\n   275→\n   276→        .nav-menu.active {\n   277→            right: 0;\n   278→        }\n   279→\n   280→        .nav-menu .nav-link {\n   281→            font-size: 1.25rem;\n   282→            padding: 0.75rem 0;\n   283→            border-bottom: 1px solid var(--color-sand);\n   284→        }\n   285→\n   286→        .nav-overlay {\n   287→            position: fixed;\n   288→            inset: 0;\n   289→            background: rgba(0,0,0,0.5);\n   290→            opacity: 0;\n   291→            visibility: hidden;\n   292→            transition: all var(--transition-base);\n   293→            z-index: 999;\n   294→        }\n   295→\n   296→        .nav-overlay.active {\n   297→            opacity: 1;\n   298→            visibility: visible;\n   299→        }\n   300→\n   301→        .nav-close {\n   302→            position: absolute;\n   303→            top: 1.5rem;\n   304→            right: 1.5rem;\n   305→            font-size: 2rem;\n   306→            color: var(--color-charcoal);\n   307→        }\n   308→\n   309→        /* ============================================\n   310→           HERO SECTION\n   311→           ============================================ */\n   312→        .hero {\n   313→            min-height: 100vh;\n   314→            padding-top: 80px;\n   315→            display: flex;\n   316→            align-items: center;\n   317→            background: var(--gradient-soft);\n   318→            position: relative;\n   319→            overflow: hidden;\n   320→        }\n   321→\n   322→        .hero-bg-blob {\n   323→            position: absolute;\n   324→            border-radius: var(--radius-blob);\n   325→            filter: blur(80px);\n   326→            opacity: 0.4;\n   327→            animation: blob-float 20s ease-in-out infinite;\n   328→        }\n   329→\n   330→        .blob-1 {\n   331→            width: 500px;\n   332→            height: 500px;\n   333→            background: var(--color-coral);\n   334→            top: -100px;\n   335→            right: -150px;\n   336→        }\n   337→\n   338→        .blob-2 {\n   339→            width: 400px;\n   340→            height: 400px;\n   341→            background: var(--color-amber);\n   342→            bottom: -50px;\n   343→            left: -100px;\n   344→            animation-delay: -10s;\n   345→        }\n   346→\n   347→        .blob-3 {\n   348→            width: 300px;\n   349→            height: 300px;\n   350→            background: var(--color-sage);\n   351→            top: 50%;\n   352→            left: 50%;\n   353→            animation-delay: -5s;\n   354→        }\n   355→\n   356→        @keyframes blob-float {\n   357→            0%, 100% { transform: translate(0, 0) rotate(0deg) scale(1); }\n   358→            25% { transform: translate(30px, -30px) rotate(90deg) scale(1.1); }\n   359→            50% { transform: translate(-20px, 20px) rotate(180deg) scale(0.9); }\n   360→            75% { transform: translate(20px, 30px) rotate(270deg) scale(1.05); }\n   361→        }\n   362→\n   363→        .hero-container {\n   364→            display: grid;\n   365→            grid-template-columns: 1fr 1fr;\n   366→            gap: 4rem;\n   367→            align-items: center;\n   368→            position: relative;\n   369→            z-index: 1;\n   370→        }\n   371→\n   372→        .hero-content {\n   373→            opacity: 0;\n   374→            transform: translateY(40px);\n   375→            animation: fade-up 0.8s ease forwards;\n   376→        }\n   377→\n   378→        @keyframes fade-up {\n   379→            to {\n   380→                opacity: 1;\n   381→                transform: translateY(0);\n   382→            }\n   383→        }\n   384→\n   385→        .hero-badge {\n   386→            display: inline-flex;\n   387→            align-items: center;\n   388→    