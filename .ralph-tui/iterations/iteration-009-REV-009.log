e\" stroke=\"currentColor\" stroke-width=\"2\">\n  1361→                            <path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"/>\n  1362→                        </svg>\n  1363→                    </div>\n  1364→                    <div class=\"float-card-content\">\n  1365→                        <h4>Emergência 24h</h4>\n  1366→                        <p>Sempre disponível</p>\n  1367→                    </div>\n  1368→                </div>\n  1369→\n  1370→                <div class=\"hero-float-card card-2\">\n  1371→                    <div class=\"float-card-icon\">\n  1372→                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1373→                            <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/>\n  1374→                        </svg>\n  1375→                    </div>\n  1376→                    <div class=\"float-card-content\">\n  1377→                        <h4>Amor e Cuidado</h4>\n  1378→                        <p>Seu pet em boas mãos</p>\n  1379→                    </div>\n  1380→                </div>\n  1381→            </div>\n  1382→        </div>\n  1383→    </section>\n  1384→\n  1385→    <!-- Problem/Solution Section -->\n  1386→    <section class=\"section problem\">\n  1387→        <div class=\"container problem-grid\">\n  1388→            <div class=\"problem-visual wow-fade-up\">\n  1389→                <img src=\"https://images.unsplash.com/photo-1612531386530-97286d97c2d2?w=800&q=80\" alt=\"Gato sendo examinado por veterinária\" class=\"problem-image\">\n  1390→                <div class=\"problem-overlay\">\n  1391→                    <div class=\"problem-overlay-stats\">\n  1392→                        <div class=\"stat-item\">\n  1393→                            <h3>24h</h3>\n  1394→                            <p>Atendimento</p>\n  1395→                        </div>\n  1396→                        <div class=\"stat-item\">\n  1397→                            <h3>+5k</h3>\n  1398→                            <p>Pets Atendidos</p>\n  1399→                        </div>\n  1400→                        <div class=\"stat-item\">\n  1401→                            <h3>100%</h3>\n  1402→                            <p>Dedicação</p>\n  1403→                        </div>\n  1404→                    </div>\n  1405→                </div>\n  1406→            </div>\n  1407→\n  1408→            <div class=\"problem-content wow-fade-up\" style=\"transition-delay: 0.2s;\">\n  1409→                <h2>Quando seu pet precisa, nós estamos aqui</h2>\n  1410→\n  1411→                <p>Sabemos que emergências não escolhem hora. Por isso, a Clínica Filhos de Pelo funciona 24 horas por dia, 7 dias por semana, pronta para atender seu pet quando ele mais precisa.</p>\n  1412→\n  1413→                <div class=\"problem-points\">\n  1414→                    <div class=\"problem-point\">\n  1415→                        <div class=\"problem-point-icon\">\n  1416→                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1417→                                <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n  1418→                            </svg>\n  1419→                        </div>\n  1420→                        <div class=\"problem-point-text\">\n  1421→                            <h4>Equipe Especializada</h4>\n  1422→                            <p>Veterinários experientes e apaixonados por animais</p>\n  1423→                        </div>\n  1424→                    </div>\n  1425→\n  1426→                    <div class=\"problem-point\">\n  1427→                        <div class=\"problem-point-icon\">\n  1428→                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1429→                                <rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"/>\n  1430→                                <path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"/>\n  1431→                            </svg>\n  1432→                        </div>\n  1433→                        <div class=\"problem-point-text\">\n  1434→                            <h4>Estrutura Completa</h4>\n  1435→                            <p>Laboratório, cirurgia, internação e UTI 24h</p>\n  1436→                        </div>\n  1437→                    </div>\n  1438→\n  1439→                    <div class=\"problem-point\">\n  1440→                        <div class=\"problem-point-icon\">\n  1441→                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1442→                                <path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"/>\n  1443→                            </svg>\n  1444→                        </div>\n  1445→                        <div class=\"problem-point-text\">\n  1446→                            <h4>Rápido Atendimento</h4>\n  1447→                            <p>Agilidade nas emergências para salvar vidas</p>\n  1448→                        </div>\n  1449→                    </div>\n  1450→                </div>\n  1451→            </div>\n  1452→        </div>\n  1453→    </section>\n  1454→\n  1455→    <!-- Services Section -->\n  1456→    <section class=\"section services\" id=\"servicos\">\n  1457→        <div class=\"container\">\n  1458→            <div class=\"section-header wow-fade-up\">\n  1459→                <span class=\"section-tag\">Nossos Serviços</span>\n  1460→                <h2>Cuidado completo para seu pet</h2>\n  1461→                <p>Oferecemos uma gama completa de serviços veterinários para garantir a saúde e o bem-estar do seu melhor amigo.</p>\n  1462→            </div>\n  1463→\n  1464→            <div class=\"services-grid\">\n  1465→                <div class=\"service-card wow-fade-up\" style=\"transition-delay: 0.1s;\">\n  1466→                    <div class=\"service-icon\">\n  1467→                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1468→                            <path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"/>\n  1469→                        </svg>\n  1470→                    </div>\n  1471→                    <h3>Emergência 24h</h3>\n  1472→                    <p>Atendimento urgente a qualquer hora do dia ou da noite, incluindo finais de semana e feriados.</p>\n  1473→                    <a href=\"#contato\" class=\"service-link\">\n  1474→                        Agendar agora\n  1475→                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1476→                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n  1477→                        </svg>\n  1478→                    </a>\n  1479→                </div>\n  1480→\n  1481→                <div class=\"service-card wow-fade-up\" style=\"transition-delay: 0.2s;\">\n  1482→                    <div class=\"service-icon\">\n  1483→                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1484→                            <path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"/>\n  1485→                        </svg>\n  1486→                    </div>\n  1487→                    <h3>Cirurgias</h3>\n  1488→                    <p>Procedimentos cirúrgicos desde as mais simples intervenções até cirurgias complexas.</p>\n  1489→                    <a href=\"#contato\" class=\"service-link\">\n  1490→                        Saiba mais\n  1491→                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1492→                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n  1493→                        </svg>\n  149