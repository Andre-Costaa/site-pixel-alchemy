 <div class=\"form-row\">\n  1750→                        <div class=\"form-group\">\n  1751→                            <label class=\"form-label\" for=\"name\">Seu Nome</label>\n  1752→                            <input type=\"text\" id=\"name\" name=\"name\" class=\"form-input\" placeholder=\"Digite seu nome\" required>\n  1753→                        </div>\n  1754→                        <div class=\"form-group\">\n  1755→                            <label class=\"form-label\" for=\"phone\">Seu Telefone</label>\n  1756→                            <input type=\"tel\" id=\"phone\" name=\"phone\" class=\"form-input\" placeholder=\"(00) 00000-0000\" required>\n  1757→                        </div>\n  1758→                    </div>\n  1759→\n  1760→                    <div class=\"form-group\">\n  1761→                        <label class=\"form-label\" for=\"email\">Seu E-mail</label>\n  1762→                        <input type=\"email\" id=\"email\" name=\"email\" class=\"form-input\" placeholder=\"seu@email.com\" required>\n  1763→                    </div>\n  1764→\n  1765→                    <div class=\"form-group\">\n  1766→                        <label class=\"form-label\" for=\"pet\">Nome do Pet</label>\n  1767→                        <input type=\"text\" id=\"pet\" name=\"pet\" class=\"form-input\" placeholder=\"Nome do seu pet\">\n  1768→                    </div>\n  1769→\n  1770→                    <div class=\"form-group\">\n  1771→                        <label class=\"form-label\" for=\"service\">Tipo de Atendimento</label>\n  1772→                        <select id=\"service\" name=\"service\" class=\"form-select\" required>\n  1773→                            <option value=\"\">Selecione uma opção</option>\n  1774→                            <option value=\"emergencia\">Emergência 24h</option>\n  1775→                            <option value=\"consulta\">Consulta de rotina</option>\n  1776→                            <option value=\"cirurgia\">Cirurgia</option>\n  1777→                            <option value=\"exames\">Exames laboratoriais</option>\n  1778→                            <option value=\"vacinacao\">Vacinação</option>\n  1779→                            <option value=\"outro\">Outro</option>\n  1780→                        </select>\n  1781→                    </div>\n  1782→\n  1783→                    <div class=\"form-group\">\n  1784→                        <label class=\"form-label\" for=\"message\">Mensagem</label>\n  1785→                        <textarea id=\"message\" name=\"message\" class=\"form-textarea\" placeholder=\"Descreva como podemos ajudar...\" required></textarea>\n  1786→                    </div>\n  1787→\n  1788→                    <button type=\"submit\" class=\"btn btn-primary submit-btn\">\n  1789→                        Enviar Mensagem\n  1790→                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1791→                            <path d=\"M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z\"/>\n  1792→                        </svg>\n  1793→                    </button>\n  1794→                </form>\n  1795→            </div>\n  1796→        </div>\n  1797→    </section>\n  1798→\n  1799→    <!-- Footer -->\n  1800→    <footer class=\"footer\">\n  1801→        <div class=\"container\">\n  1802→            <div class=\"footer-grid\">\n  1803→                <div class=\"footer-brand\">\n  1804→                    <div class=\"logo\">\n  1805→                        <svg viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n  1806→                            <circle cx=\"50\" cy=\"50\" r=\"45\" fill=\"#FF6B5B\"/>\n  1807→                            <path d=\"M35 40C35 40 38 35 45 35C52 35 55 40 55 40C55 40 58 35 65 35C72 35 75 40 75 40C75 55 70 65 60 70C55 72 50 72 50 72C50 72 45 72 40 70C30 65 25 55 25 40C25 40 28 35 35 35Z\" fill=\"white\"/>\n  1808→                            <circle cx=\"42\" cy=\"45\" r=\"3\" fill=\"#2D3436\"/>\n  1809→                            <circle cx=\"58\" cy=\"45\" r=\"3\" fill=\"#2D3436\"/>\n  1810→                            <path d=\"M45 52C45 52 48 55 50 55C52 55 55 52 55 52\" stroke=\"#2D3436\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n  1811→                        </svg>\n  1812→                        Filhos de Pelo\n  1813→                    </div>\n  1814→                    <p>Clínica veterinária 24h dedicada a cuidar do seu pet com amor, dedicação e excelência.</p>\n  1815→                    <div class=\"footer-social\">\n  1816→                        <a href=\"#\" aria-label=\"Instagram\">\n  1817→                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1818→                                <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\" ry=\"5\"/>\n  1819→                                <path d=\"M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z\"/>\n  1820→                                <line x1=\"17.5\" y1=\"6.5\" x2=\"17.51\" y2=\"6.5\"/>\n  1821→                            </svg>\n  1822→                        </a>\n  1823→                        <a href=\"#\" aria-label=\"Facebook\">\n  1824→                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1825→                                <path d=\"M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z\"/>\n  1826→                            </svg>\n  1827→                        </a>\n  1828→                        <a href=\"#\" aria-label=\"WhatsApp\">\n  1829→                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1830→                                <path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"/>\n  1831→                            </svg>\n  1832→                        </a>\n  1833→                    </div>\n  1834→                </div>\n  1835→\n  1836→                <div class=\"footer-column\">\n  1837→                    <h4>Links Rápidos</h4>\n  1838→                    <ul>\n  1839→                        <li><a href=\"#inicio\">Início</a></li>\n  1840→                        <li><a href=\"#servicos\">Serviços</a></li>\n  1841→                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n  1842→                        <li><a href=\"#contato\">Contato</a></li>\n  1843→                    </ul>\n  1844→                </div>\n  1845→\n  1846→                <div class=\"footer-column\">\n  1847→                    <h4>Serviços</h4>\n  1848→                    <ul>\n  1849→                        <li><a href=\"#\">Emergência 24h</a></li>\n  1850→                        <li><a href=\"#\">Cirurgias</a></li>\n  1851→                        <li><a href=\"#\">Internação</a></li>\n  1852→                        <li><a href=\"#\">Exames</a></li>\n  1853→                    </ul>\n  1854→                </div>\n  1855→\n  1856→                <div class=\"footer-column\">\n  1857→                    <h4>Contato</h4>\n  1858→                    <ul>\n  1859→                        <li>(16) 99218-8558</li>\n  1860→                        <li>Av. Independência, 815</li>\n  1861→                        <li>Vila Seixas - Ribeirão Preto/SP</li>\n  1862→                        <li>14020-010</li>\n  1863→                    </ul>\n  1864→                </div>\n  1865→            </div>\n  1866→\n  1867→            <div class=\"footer-bottom\">\n  1868→                <p>&copy; 2025 Clínica Veterinária Filhos de Pelo 24h. Todos os direitos reservados.</p>\n  1869→                <p>Desenvolvido com <span style=\"color: #FF6B5B;\">&hearts;</span> para quem ama pets</p>\n  1870→            </div>\n  1871→        </div>\n  1872→    </footer>\n  1873→\n  1874→    <!-- JavaScript -->\n  1875→    <script>\n  1876→        // Navigation scroll effect\n  1877→        const nav = document.getElementById('nav');\n  1878→        let lastScroll = 0;\n  1879→\n  1880→        window.addEventListener('scroll', () => {\n  1881→            const currentScroll = window.pageYOffset;\n  1882→\n  1883→            if (currentScroll > 50) {\n  1884→                nav.classList.add('scrolled');\n  1885→            } else {\n  1886→                nav.classList.remove('scrolled');\n  1887→            }\n  1888→\n  1889→            lastScroll = currentScroll;\n  1890→        });\n  1891→\n  1892→        // Mobile menu toggle\n  1893→        const navToggle = document.getElementById('navToggle');\n  1894→        const navMenu = document.getElementById('navMenu');\n  1895→        const navOverlay = document.getElementById('navOverlay');\n  1896→        const navClose = document.getElementById('navClose');\n  1897→        const navLinks = document.querySelectorAll('.nav-link');\n  1898→\n  1899→        function openMenu() {\n  1900→            navMenu.classList.add('active');\n  1901→            navOverlay.classList.add('active');\n  1902→            document.body.style.overflow = 'hidden';\n  1903→        }\n  1904→\n  1905→        function closeMenu() {\n  1906→            navMenu.classList.remove('active');\n  1907→            navOverlay.classList.remove('active');\n  1908→            document.body.style.overflow = '';\n  1909→        }\n  1910→\n  1911→        navToggle.addEventListener('click', openMenu);\n  1912→        navClose.addEventListener('click', closeMenu);\n  1913→        navOverlay.addEventListener('click', closeMenu);\n  1914→\n  1915→        navLinks.forEach(link => {\n  1916→            link.addEventListener('click', closeMenu);\n  1917→        });\n  1918→\n  1919→        // Smooth scroll for anchor links\n  1920→        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n  1921→            anchor.addEventListener('click', function(e) {\n  1922→                e.preventDefault();\n  1923→                const target = document.querySelector(this.getAttribute('href'));\n  1924→                if (target) {\n  1925→                    const navHeight = nav.offsetHeight;\n  1926→                    const targetPosition = target.offsetTop - navHeight;\n  1927→                    window.scrollTo({\n  1928→                        top: targetPosition,\n  1929→                        behavior: 'smooth'\n  1930→                    });\n  1931→                }\n  1932→            });\n  1933→        });\n  1934→\n  1935→        // Intersection Observer for scroll animations\n  1936→        const observerOptions = {\n  1937→            root: null,\n  1938→            rootMargin: '0px',\n  1939→            threshold: 0.1\n  1940→        };\n  1941→\n  1942→        const observer = new IntersectionObserver((entries) => {\n  1943→            entries.forEach(entry => {\n  1944→                if (entry.isIntersecting) {\n  1945→                    entry.target.classList.add('animated');\n  1946→                    observer.unobserve(entry.target);\n  1947→                }\n  1948→            });\n  1949→        }, observerOptions);\n  1950→\n  1951→        document.querySelectorAll('.wow-fade-up').forEach(el => {\n  1952→            observer.observe(el);\n  1953→        });\n  1954→\n  1955→        // Contact form handling\n  1956→        const contactForm = document.getElementById('contactForm');\n  1957→\n  1958→        contactForm.addEventListener('submit', function(e) {\n  1959→            e.preventDefault();\n  1960→\n  1961→            const formData = new FormData(this);\n  1962→            const data = Object.fromEntries(formData);\n  1963→\n  1964→            // Here you would typically send the data to a server\n  1965→            console.log('Form submitted:', data);\n  1966→\n  1967→            // Show success message\n  1968→            alert('Mensagem enviada com sucesso! Entraremos em contato em breve.');\n  1969→            this.reset();\n  1970→        });\n  1971→\n  1972→        // Phone formatting\n  1973→        const phoneInput = document.getElementById('phone');\n  1974→\n  1975→        phoneInput.addEventListener('input', function(e) {\n  1976→            let value = e.target.value.replace(/\\D/g, '');\n  1977→\n  1978→            if (value.length > 11) value = value.slice(0, 11);\n  1979→\n  1980→            if (value.length > 6) {\n  1981→                value = `(${value.slice(0, 2}) ${value.slice(2, 7)}-${value.slice(7)}`;\n  1982→            } else if (value.length > 2) {\n  1983→                value = `(${value.slice(0, 2)}) ${value.slice(2)}`;\n  1984→            } else if (value.length > 0) {\n  1985→                value = `(${value}`;\n  1986→            }\n  1987→\n  1988→            e.target.value = value;\n  1989→        });\n  1990→\n  1991→        // Dynamic year in footer\n  1992→        const yearElements = document.querySelectorAll('.footer-bottom p');\n  1993→        const currentYear = new Date().getFullYear();\n  1994→    </script>\n  1995→</body>\n  1996→</html>\n  1997→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a1820da4-c043-4716-ae35-56770360e1b6","uuid":"708f8260-0f8f-44be-ad06-5792ab6546a7","tool_use_result":{"type":"text","file":{"filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/clinica-veterinaria-filhos-de-pelo-24h/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Filhos de Pelo 24h | Clínica Veterinária de Emergência - Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Clínica veterinária 24h em Ribeirão Preto. Atendimento de emergência para seu pet. Av. Independência, 815 - Vila Seixas. (16) 99218-8558\">\n\n    <!-- Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=DM+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           FILHOS DE PELO 24H - VETERINARY CLINIC\n           Organic, Warm & Trustworthy Design\n           ============================================ */\n\n        /* CSS Variables - Warm Earth Tones */\n        :root {\n            /* Colors */\n            --color-coral: #FF6B5B;\n            --color-coral-dark: #E85545;\n            --color-amber: #FFB347;\n            --color-amber-light: #FFC97A;\n            --color-sage: #7CB987;\n            --color-sage-dark: #5A9A6B;\n            --color-cream: #FFF8F0;\n            --color-sand: #F5EDE4;\n            --color-charcoal: #2D3436;\n            --color-charcoal-light: #4A5154;\n            --color-white: #FFFFFF;\n\n            /* Gradients */\n            --gradient-warm: linear-gradient(135deg, #FF6B5B 0%, #FFB347 100%);\n            --gradient-soft: linear-gradient(180deg, #FFF8F0 0%, #FFFFFF 100%);\n            --gradient-overlay: linear-gradient(180deg, rgba(45,52,54,0.7) 0%, rgba(45,52,54,0.9) 100%);\n\n            /* Typography */\n            --font-display: 'Outfit', sans-serif;\n            --font-body: 'DM Sans', sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 1.5rem;\n            --spacing-lg: 2rem;\n            --spacing-xl: 3rem;\n            --spacing-2xl: 5rem;\n\n            /* Border Radius */\n            --radius-sm: 12px;\n            --radius-md: 20px;\n            --radius-lg: 30px;\n            --radius-full: 9999px;\n            --radius-blob: 60% 40% 30% 70% / 60% 30% 70% 40%;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(45,52,54,0.08);\n            --shadow-md: 0 8px 24px rgba(45,52,54,0.12);\n            --shadow-lg: 0 16px 48px rgba(45,52,54,0.16);\n            --shadow-glow: 0 0 40px rgba(255,107,91,0.3);\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Container */\n            --container-max: 1200px;\n            --container-padding: 1.5rem;\n        }\n\n        /* Reset & Base */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.6;\n            color: var(--color-charcoal);\n            background: var(--color-cream);\n            overflow-x: hidden;\n        }\n\n        img {\n            max-width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n        }\n\n        button {\n            font-family: inherit;\n            border: none;\n            background: none;\n            cursor: pointer;\n        }\n\n        ul {\n            list-style: none;\n        }\n\n        /* Typography */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 700;\n            line-height: 1.2;\n        }\n\n        h1 { font-size: clamp(2.5rem, 6vw, 4rem); }\n        h2 { font-size: clamp(2rem, 4vw, 3rem); }\n        h3 { font-size: clamp(1.25rem, 2vw, 1.5rem); }\n\n        /* Container */\n        .container {\n            max-width: var(--container-max);\n            margin: 0 auto;\n            padding: 0 var(--container-padding);\n        }\n\n        /* Section */\n        .section {\n            padding: var(--spacing-2xl) 0;\n            position: relative;\n        }\n\n        /* Buttons */\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            font-family: var(--font-display);\n            font-weight: 600;\n            font-size: 1rem;\n            border-radius: var(--radius-full);\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .btn-primary {\n            background: var(--gradient-warm);\n            color: var(--color-white);\n            box-shadow: var(--shadow-md);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .btn-secondary {\n            background: var(--color-white);\n            color: var(--color-coral);\n            border: 2px solid var(--color-coral);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-coral);\n            color: var(--color-white);\n        }\n\n        .btn-large {\n            padding: 1.25rem 2.5rem;\n            font-size: 1.125rem;\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: 1rem 0;\n            transition: all var(--transition-base);\n            background: transparent;\n        }\n\n        .nav.scrolled {\n            background: rgba(255,248,240,0.95);\n            backdrop-filter: blur(10px);\n            box-shadow: var(--shadow-sm);\n        }\n\n        .nav-container {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 800;\n            color: var(--color-coral);\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .nav-logo svg {\n            width: 40px;\n            height: 40px;\n        }\n\n        .nav-links {\n            display: flex;\n            gap: 2rem;\n            align-items: center;\n        }\n\n        .nav-link {\n            font-weight: 500;\n            color: var(--color-charcoal);\n            transition: color var(--transition-fast);\n        }\n\n        .nav-link:hover {\n            color: var(--color-coral);\n        }\n\n        .nav-cta {\n            display: none;\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            padding: 0.5rem;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 3px;\n            background: var(--color-charcoal);\n            border-radius: 3px;\n            transition: all var(--transition-fast);\n        }\n\n        /* Mobile Menu */\n        .nav-menu {\n            position: fixed;\n            top: 0;\n            right: -100%;\n            width: 80%;\n            max-width: 400px;\n            height: 100vh;\n            background: var(--color-white);\n            padding: 6rem 2rem 2rem;\n            box-shadow: var(--shadow-lg);\n            transition: right var(--transition-base);\n            display: flex;\n            flex-direction: column;\n            gap: 1.5rem;\n        }\n\n        .nav-menu.active {\n            right: 0;\n        }\n\n        .nav-menu .nav-link {\n            font-size: 1.25rem;\n            padding: 0.75rem 0;\n            border-bottom: 1px solid var(--color-sand);\n        }\n\n        .nav-overlay {\n            position: fixed;\n            inset: 0;\n            background: rgba(0,0,0,0.5);\n            opacity: 0;\n            visibility: hidden;\n            transition: all var(--transition-base);\n            z-index: 999;\n        }\n\n        .nav-overlay.active {\n            opacity: 1;\n            visibility: visible;\n        }\n\n        .nav-close {\n            position: absolute;\n            top: 1.5rem;\n            right: 1.5rem;\n            font-size: 2rem;\n            color: var(--color-charcoal);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            padding-top: 80px;\n            display: flex;\n            align-items: center;\n            background: var(--gradient-soft);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .hero-bg-blob {\n            position: absolute;\n            border-radius: var(--radius-blob);\n            filter: blur(80px);\n            opacity: 0.4;\n            animation: blob-float 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--color-coral);\n            top: -100px;\n            right: -150px;\n        }\n\n        .blob-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--color-amber);\n            bottom: -50px;\n            left: -100px;\n            animation-delay: -10s;\n        }\n\n        .blob-3 {\n            width: 300px;\n            height: 300px;\n            background: var(--color-sage);\n            top: 50%;\n            left: 50%;\n            animation-delay: -5s;\n        }\n\n        @keyframes blob-float {\n            0%, 100% { transform: translate(0, 0) rotate(0deg) scale(1); }\n            25% { transform: translate(30px, -30px) rotate(90deg) scale(1.1); }\n            50% { transform: translate(-20px, 20px) rotate(180deg) scale(0.9); }\n            75% { transform: translate(20px, 30px) rotate(270deg) scale(1.05); }\n        }\n\n        .hero-container {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .hero-content {\n            opacity: 0;\n            transform: translateY(40px);\n            animation: fade-up 0.8s ease forwards;\n        }\n\n        @keyframes fade-up {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 0.5rem 1rem;\n            background: rgba(255,107,91,0.15);\n            color: var(--color-coral);\n            border-radius: var(--radius-full);\n            font-weight: 600;\n            font-size: 0.875rem;\n            margin-bottom: 1.5rem;\n        }\n\n        .hero-badge svg {\n            width: 18px;\n            height: 18px;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { transform: scale(1); }\n            50% { transform: scale(1.1); }\n        }\n\n        .hero-title {\n            margin-bottom: 1.5rem;\n            color: var(--color-charcoal);\n        }\n\n        .hero-title span {\n            color: var(--color-coral);\n        }\n\n        .hero-description {\n            font-size: 1.25rem;\n            color: var(--color-charcoal-light);\n            margin-bottom: 2rem;\n            max-width: 500px;\n        }\n\n        .hero-actions {\n            display: flex;\n            gap: 1rem;\n            flex-wrap: wrap;\n        }\n\n        .hero-phone {\n            display: flex;\n            align-items: center;\n            gap: 0.75rem;\n            margin-top: 2rem;\n            font-size: 1.25rem;\n            font-weight: 700;\n            color: var(--color-coral);\n        }\n\n        .hero-phone svg {\n            width: 28px;\n            height: 28px;\n            animation: ring 1.5s ease-in-out infinite;\n        }\n\n        @keyframes ring {\n            0%, 100% { transform: rotate(0deg); }\n            10%, 30% { transform: rotate(-10deg); }\n            20%, 40% { transform: rotate(10deg); }\n        }\n\n        .hero-visual {\n            position: relative;\n            opacity: 0;\n            animation: fade-up 0.8s ease 0.2s forwards;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            border-radius: var(--radius-lg);\n            overflow: hidden;\n            box-shadow: var(--shadow-lg);\n        }\n\n        .hero-image {\n            width: 100%;\n            height: 500px;\n            object-fit: cover;\n        }\n\n        .hero-float-card {\n            position: absolute;\n            background: var(--color-white);\n            padding: 1rem 1.5rem;\n            border-radius: var(--radius-md);\n            box-shadow: var(--shadow-lg);\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n            animation: float 4s ease-in-out infinite;\n        }\n\n        .card-1 {\n            top: 10%;\n            left: -30px;\n        }\n\n        .card-2 {\n            bottom: 15%;\n            right: -30px;\n            animation-delay: -2s;\n        }\n\n        @keyframes float {\n            0%, 100% { transform: translateY(0); }\n            50% { transform: translateY(-15px); }\n        }\n\n        .float-card-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-warm);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n        }\n\n        .float-card-icon svg {\n            width: 24px;\n            height: 24px;\n            color: var(--color-white);\n        }\n\n        .float-card-content h4 {\n            font-size: 0.875rem;\n            color: var(--color-charcoal);\n        }\n\n        .float-card-content p {\n            font-size: 0.75rem;\n            color: var(--color-charcoal-light);\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem {\n            background: var(--color-white);\n        }\n\n        .problem-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: center;\n        }\n\n        .problem-content h2 {\n            margin-bottom: 1.5rem;\n            color: var(--color-charcoal);\n        }\n\n        .problem-content p {\n            font-size: 1.125rem;\n            color: var(--color-charcoal-light);\n            margin-bottom: 1.5rem;\n        }\n\n        .problem-points {\n            display: flex;\n            flex-direction: column;\n            gap: 1rem;\n        }\n\n        .problem-point {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n            padding: 1rem;\n            background: var(--color-cream);\n            border-radius: var(--radius-md);\n            transition: all var(--transition-base);\n        }\n\n        .problem-point:hover {\n            transform: translateX(10px);\n            background: var(--color-sand);\n        }\n\n        .problem-point-icon {\n            width: 40px;\n            height: 40px;\n            background: var(--color-coral);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n        }\n\n        .problem-point-icon svg {\n            width: 20px;\n            height: 20px;\n            color: var(--color-white);\n        }\n\n        .problem-point-text h4 {\n            margin-bottom: 0.25rem;\n        }\n\n        .problem-point-text p {\n            font-size: 0.875rem;\n            margin: 0;\n        }\n\n        .problem-visual {\n            position: relative;\n        }\n\n        .problem-image {\n            width: 100%;\n            height: 450px;\n            object-fit: cover;\n            border-radius: var(--radius-lg);\n        }\n\n        .problem-overlay {\n            position: absolute;\n            bottom: -30px;\n            left: -30px;\n            right: 30px;\n            background: var(--color-white);\n            padding: 2rem;\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .problem-overlay-stats {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 1.5rem;\n            text-align: center;\n        }\n\n        .stat-item h3 {\n            font-size: 2.5rem;\n            color: var(--color-coral);\n            margin-bottom: 0.25rem;\n        }\n\n        .stat-item p {\n            font-size: 0.875rem;\n            color: var(--color-charcoal-light);\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            background: var(--color-cream);\n        }\n\n        .section-header {\n            text-align: center;\n            max-width: 700px;\n            margin: 0 auto 4rem;\n        }\n\n        .section-tag {\n            display: inline-block;\n            padding: 0.5rem 1.25rem;\n            background: rgba(255,107,91,0.15);\n            color: var(--color-coral);\n            border-radius: var(--radius-full);\n            font-weight: 600;\n            font-size: 0.875rem;\n            margin-bottom: 1rem;\n        }\n\n        .section-header h2 {\n            margin-bottom: 1rem;\n            color: var(--color-charcoal);\n        }\n\n        .section-header p {\n            font-size: 1.125rem;\n            color: var(--color-charcoal-light);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .service-card {\n            background: var(--color-white);\n            padding: 2rem;\n            border-radius: var(--radius-lg);\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-warm);\n            transform: scaleX(0);\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-icon {\n            width: 70px;\n            height: 70px;\n            background: var(--gradient-warm);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n        }\n\n        .service-icon svg {\n            width: 32px;\n            height: 32px;\n            color: var(--color-white);\n        }\n\n        .service-card h3 {\n            margin-bottom: 0.75rem;\n            color: var(--color-charcoal);\n        }\n\n        .service-card p {\n            color: var(--color-charcoal-light);\n            margin-bottom: 1.5rem;\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-coral);\n            font-weight: 600;\n            transition: gap var(--transition-fast);\n        }\n\n        .service-link:hover {\n            gap: 0.75rem;\n        }\n\n        .service-link svg {\n            width: 18px;\n            height: 18px;\n            transition: transform var(--transition-fast);\n        }\n\n        .service-link:hover svg {\n            transform: translateX(3px);\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            background: var(--color-charcoal);\n            color: var(--color-white);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .testimonials::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 100%;\n            background: url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\");\n            opacity: 0.5;\n        }\n\n        .testimonials .section-header h2 {\n            color: var(--color-white);\n        }\n\n        .testimonials .section-header p {\n            color: rgba(255,255,255,0.7);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .testimonial-card {\n            background: rgba(255,255,255,0.05);\n            backdrop-filter: blur(10px);\n            padding: 2rem;\n            border-radius: var(--radius-lg);\n            border: 1px solid rgba(255,255,255,0.1);\n            transition: all var(--transition-base);\n        }\n\n        .testimonial-card:hover {\n            background: rgba(255,255,255,0.08);\n            transform: translateY(-5px);\n        }\n\n        .testimonial-stars {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: 1.5rem;\n        }\n\n        .testimonial-stars svg {\n            width: 20px;\n            height: 20px;\n            fill: var(--color-amber);\n        }\n\n        .testimonial-text {\n            font-size: 1.0625rem;\n            line-height: 1.8;\n            margin-bottom: 1.5rem;\n            color: rgba(255,255,255,0.9);\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            object-fit: cover;\n        }\n\n        .testimonial-info h4 {\n            font-size: 1rem;\n            margin-bottom: 0.25rem;\n        }\n\n        .testimonial-info p {\n            font-size: 0.875rem;\n            color: rgba(255,255,255,0.6);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            background: var(--color-white);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(4, 1fr);\n            gap: 2rem;\n        }\n\n        .differential-card {\n            text-align: center;\n            padding: 2rem 1.5rem;\n            background: var(--color-cream);\n            border-radius: var(--radius-lg);\n            transition: all var(--transition-base);\n        }\n\n        .differential-card:hover {\n            transform: translateY(-8px);\n            background: var(--color-sand);\n        }\n\n        .differential-icon {\n            width: 80px;\n            height: 80px;\n            margin: 0 auto 1.5rem;\n            background: var(--gradient-warm);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .differential-icon svg {\n            width: 36px;\n            height: 36px;\n            color: var(--color-white);\n        }\n\n        .differential-card h3 {\n            margin-bottom: 0.75rem;\n            color: var(--color-charcoal);\n        }\n\n        .differential-card p {\n            color: var(--color-charcoal-light);\n            font-size: 0.9375rem;\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            background: var(--gradient-soft);\n        }\n\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1.5fr;\n            gap: 4rem;\n        }\n\n        .contact-info h2 {\n            margin-bottom: 1rem;\n            color: var(--color-charcoal);\n        }\n\n        .contact-info p {\n            font-size: 1.125rem;\n            color: var(--color-charcoal-light);\n            margin-bottom: 2rem;\n        }\n\n        .contact-details {\n            display: flex;\n            flex-direction: column;\n            gap: 1.5rem;\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n        }\n\n        .contact-item-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-warm);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n        }\n\n        .contact-item-icon svg {\n            width: 24px;\n            height: 24px;\n            color: var(--color-white);\n        }\n\n        .contact-item-content h4 {\n            margin-bottom: 0.25rem;\n            color: var(--color-charcoal);\n        }\n\n        .contact-item-content p {\n            font-size: 0.9375rem;\n            margin: 0;\n            color: var(--color-charcoal-light);\n        }\n\n        .contact-item-content a {\n            color: var(--color-coral);\n            font-weight: 600;\n        }\n\n        .contact-form-wrapper {\n            background: var(--color-white);\n            padding: 2.5rem;\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .contact-form-wrapper h3 {\n            margin-bottom: 0.5rem;\n            color: var(--color-charcoal);\n        }\n\n        .contact-form-wrapper > p {\n            color: var(--color-charcoal-light);\n            margin-bottom: 2rem;\n        }\n\n        .form-group {\n            margin-bottom: 1.5rem;\n        }\n\n        .form-label {\n            display: block;\n            font-weight: 600;\n            margin-bottom: 0.5rem;\n            color: var(--color-charcoal);\n        }\n\n        .form-input, .form-textarea, .form-select {\n            width: 100%;\n            padding: 1rem;\n            border: 2px solid var(--color-sand);\n            border-radius: var(--radius-md);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: all var(--transition-fast);\n            background: var(--color-cream);\n        }\n\n        .form-input:focus, .form-textarea:focus, .form-select:focus {\n            outline: none;\n            border-color: var(--color-coral);\n            background: var(--color-white);\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-row {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 1rem;\n        }\n\n        .submit-btn {\n            width: 100%;\n            padding: 1.25rem;\n            font-size: 1.125rem;\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--color-charcoal);\n            color: var(--color-white);\n            padding: 4rem 0 2rem;\n        }\n\n        .footer-grid {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr 1.5fr;\n            gap: 3rem;\n            margin-bottom: 3rem;\n        }\n\n        .footer-brand .logo {\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 800;\n            color: var(--color-coral);\n            margin-bottom: 1rem;\n        }\n\n        .footer-brand .logo svg {\n            width: 36px;\n            height: 36px;\n        }\n\n        .footer-brand p {\n            color: rgba(255,255,255,0.7);\n            margin-bottom: 1.5rem;\n            max-width: 300px;\n        }\n\n        .footer-social {\n            display: flex;\n            gap: 1rem;\n        }\n\n        .footer-social a {\n            width: 40px;\n            height: 40px;\n            background: rgba(255,255,255,0.1);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: all var(--transition-fast);\n        }\n\n        .footer-social a:hover {\n            background: var(--color-coral);\n            transform: translateY(-3px);\n        }\n\n        .footer-social svg {\n            width: 18px;\n            height: 18px;\n        }\n\n        .footer-column h4 {\n            margin-bottom: 1.25rem;\n            color: var(--color-white);\n        }\n\n        .footer-column ul {\n            display: flex;\n            flex-direction: column;\n            gap: 0.75rem;\n        }\n\n        .footer-column a {\n            color: rgba(255,255,255,0.7);\n            transition: color var(--transition-fast);\n        }\n\n        .footer-column a:hover {\n            color: var(--color-coral);\n        }\n\n        .footer-bottom {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding-top: 2rem;\n            border-top: 1px solid rgba(255,255,255,0.1);\n        }\n\n        .footer-bottom p {\n            color: rgba(255,255,255,0.5);\n            font-size: 0.875rem;\n        }\n\n        /* ============================================\n           SCROLL ANIMATIONS\n           ============================================ */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(40px);\n            transition: all 0.6s ease;\n        }\n\n        .wow-fade-up.animated {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (min-width: 768px) {\n            .nav-cta {\n                display: inline-flex;\n            }\n        }\n\n        @media (max-width: 1024px) {\n            .hero-container,\n            .problem-grid,\n            .contact-grid {\n                grid-template-columns: 1fr;\n                gap: 3rem;\n            }\n\n            .hero-visual {\n                order: -1;\n            }\n\n            .services-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .testimonials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .footer-grid {\n                grid-template-columns: 1fr 1fr;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-links {\n                display: none;\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n\n            .hero {\n                padding-top: 100px;\n                text-align: center;\n            }\n\n            .hero-actions {\n                justify-content: center;\n            }\n\n            .hero-phone {\n                justify-content: center;\n            }\n\n            .hero-float-card {\n                display: none;\n            }\n\n            .services-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .problem-overlay {\n                position: static;\n                margin-top: -30px;\n            }\n\n            .form-row {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-bottom {\n                flex-direction: column;\n                gap: 1rem;\n                text-align: center;\n            }\n        }\n\n        /* Reduced Motion */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        /* ============================================\n           UTILITIES\n           ============================================ */\n        .text-center { text-align: center; }\n        .text-coral { color: var(--color-coral); }\n        .mb-1 { margin-bottom: 1rem; }\n        .mb-2 { margin-bottom: 2rem; }\n    </style>\n</head>\n<body>\n\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"container nav-container\">\n            <a href=\"#\" class=\"nav-logo\">\n                <svg viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                    <circle cx=\"50\" cy=\"50\" r=\"45\" fill=\"#FF6B5B\"/>\n                    <path d=\"M35 40C35 40 38 35 45 35C52 35 55 40 55 40C55 40 58 35 65 35C72 35 75 40 75 40C75 55 70 65 60 70C55 72 50 72 50 72C50 72 45 72 40 70C30 65 25 55 25 40C25 40 28 35 35 35Z\" fill=\"white\"/>\n                    <circle cx=\"42\" cy=\"45\" r=\"3\" fill=\"#2D3436\"/>\n                    <circle cx=\"58\" cy=\"45\" r=\"3\" fill=\"#2D3436\"/>\n                    <path d=\"M45 52C45 52 48 55 50 55C52 55 55 52 55 52\" stroke=\"#2D3436\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n                    <path d=\"M30 40C30 40 28 38 28 35\" stroke=\"white\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n                    <path d=\"M70 40C70 40 72 38 72 35\" stroke=\"white\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n                </svg>\n                Filhos de Pelo\n            </a>\n\n            <div class=\"nav-links\">\n                <a href=\"#inicio\" class=\"nav-link\">Início</a>\n                <a href=\"#servicos\" class=\"nav-link\">Serviços</a>\n                <a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a>\n                <a href=\"#contato\" class=\"nav-link\">Contato</a>\n                <a href=\"tel:+5516992188558\" class=\"btn btn-primary nav-cta\">\n                    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"/>\n                    </svg>\n                    (16) 99218-8558\n                </a>\n            </div>\n\n            <button class=\"nav-toggle\" id=\"navToggle\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Mobile Menu -->\n    <div class=\"nav-overlay\" id=\"navOverlay\"></div>\n    <div class=\"nav-menu\" id=\"navMenu\">\n        <button class=\"nav-close\" id=\"navClose\">&times;</button>\n        <a href=\"#inicio\" class=\"nav-link\">Início</a>\n        <a href=\"#servicos\" class=\"nav-link\">Serviços</a>\n        <a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a>\n        <a href=\"#contato\" class=\"nav-link\">Contato</a>\n        <a href=\"tel:+5516992188558\" class=\"btn btn-primary\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"/>\n            </svg>\n            (16) 99218-8558\n        </a>\n    </div>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-bg-blob blob-1\"></div>\n        <div class=\"hero-bg-blob blob-2\"></div>\n        <div class=\"hero-bg-blob blob-3\"></div>\n\n        <div class=\"container hero-container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                        <path d=\"M12 6v6l4 2\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n                    </svg>\n                    Atendimento 24 horas\n                </div>\n\n                <h1 class=\"hero-title\">\n                    Seu pet merece cuidado <span>a qualquer hora</span>\n                </h1>\n\n                <p class=\"hero-description\">\n                    Clínica veterinária de emergência 24h em Ribeirão Preto. Nossa equipe está sempre pronta para cuidar do seu melhor amigo.\n                </p>\n\n                <div class=\"hero-actions\">\n                    <a href=\"#contato\" class=\"btn btn-primary btn-large\">\n                        Agendar Consulta\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                    <a href=\"#servicos\" class=\"btn btn-secondary btn-large\">\n                        Conhecer Serviços\n                    </a>\n                </div>\n\n                <div class=\"hero-phone\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"/>\n                    </svg>\n                    (16) 99218-8558\n                </div>\n            </div>\n\n            <div class=\"hero-visual\">\n                <div class=\"hero-image-wrapper\">\n                    <img src=\"https://images.unsplash.com/photo-1587300003388-59208cc962cb?w=800&q=80\" alt=\"Veterinária cuidando de cachorro\" class=\"hero-image\">\n                </div>\n\n                <div class=\"hero-float-card card-1\">\n                    <div class=\"float-card-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"/>\n                        </svg>\n                    </div>\n                    <div class=\"float-card-content\">\n                        <h4>Emergência 24h</h4>\n                        <p>Sempre disponível</p>\n                    </div>\n                </div>\n\n                <div class=\"hero-float-card card-2\">\n                    <div class=\"float-card-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"float-card-content\">\n                        <h4>Amor e Cuidado</h4>\n                        <p>Seu pet em boas mãos</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem\">\n        <div class=\"container problem-grid\">\n            <div class=\"problem-visual wow-fade-up\">\n                <img src=\"https://images.unsplash.com/photo-1612531386530-97286d97c2d2?w=800&q=80\" alt=\"Gato sendo examinado por veterinária\" class=\"problem-image\">\n                <div class=\"problem-overlay\">\n                    <div class=\"problem-overlay-stats\">\n                        <div class=\"stat-item\">\n                            <h3>24h</h3>\n                            <p>Atendimento</p>\n                        </div>\n                        <div class=\"stat-item\">\n                            <h3>+5k</h3>\n                            <p>Pets Atendidos</p>\n                        </div>\n                        <div class=\"stat-item\">\n                            <h3>100%</h3>\n                            <p>Dedicação</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"problem-content wow-fade-up\" style=\"transition-delay: 0.2s;\">\n                <h2>Quando seu pet precisa, nós estamos aqui</h2>\n\n                <p>Sabemos que emergências não escolhem hora. Por isso, a Clínica Filhos de Pelo funciona 24 horas por dia, 7 dias por semana, pronta para atender seu pet quando ele mais precisa.</p>\n\n                <div class=\"problem-points\">\n                    <div class=\"problem-point\">\n                        <div class=\"problem-point-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n                            </svg>\n                        </div>\n                        <div class=\"problem-point-text\">\n                            <h4>Equipe Especializada</h4>\n                            <p>Veterinários experientes e apaixonados por animais</p>\n                        </div>\n                    </div>\n\n                    <div class=\"problem-point\">\n                        <div class=\"problem-point-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"/>\n                                <path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"/>\n                            </svg>\n                        </div>\n                        <div class=\"problem-point-text\">\n                            <h4>Estrutura Completa</h4>\n                            <p>Laboratório, cirurgia, internação e UTI 24h</p>\n                        </div>\n                    </div>\n\n                    <div class=\"problem-point\">\n                        <div class=\"problem-point-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"/>\n                            </svg>\n                        </div>\n                        <div class=\"problem-point-text\">\n                            <h4>Rápido Atendimento</h4>\n                            <p>Agilidade nas emergências para salvar vidas</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Nossos Serviços</span>\n                <h2>Cuidado completo para seu pet</h2>\n                <p>Oferecemos uma gama completa de serviços veterinários para garantir a saúde e o bem-estar do seu melhor amigo.</p>\n            </div>\n\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\" style=\"transition-delay: 0.1s;\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"/>\n                        </svg>\n                    </div>\n                    <h3>Emergência 24h</h3>\n                    <p>Atendimento urgente a qualquer hora do dia ou da noite, incluindo finais de semana e feriados.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Agendar agora\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" style=\"transition-delay: 0.2s;\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"/>\n                        </svg>\n                    </div>\n                    <h3>Cirurgias</h3>\n                    <p>Procedimentos cirúrgicos desde as mais simples intervenções até cirurgias complexas.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" style=\"transition-delay: 0.3s;\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M9 12h6M12 9v6M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/>\n                        </svg>\n                    </div>\n                    <h3>Internação</h3>\n                    <p>Accomodação confortável e monitoramento constante para pets que necessitam de internação.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" style=\"transition-delay: 0.4s;\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"/>\n                            <circle cx=\"12\" cy=\"12\" r=\"3\"/>\n                        </svg>\n                    </div>\n                    <h3>Exames Laboratoriais</h3>\n                    <p>Análises clínicas completas com resultados rápidos e precisos para diagnóstico assertivo.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Agendar exame\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" style=\"transition-delay: 0.5s;\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n                            <path d=\"M8 11h8M8 15h8\"/>\n                        </svg>\n                    </div>\n                    <h3>Vacinação</h3>\n                    <p>Mantenha a saúde do seu pet em dia com nosso programa completo de vacinação.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Ver vacinas\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" style=\"transition-delay: 0.6s;\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            <path d=\"M8 14s1.5 2 4 2 4-2 4-2\"/>\n                            <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"/>\n                            <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"/>\n                        </svg>\n                    </div>\n                    <h3>Consultas</h3>\n                    <p>Acompanhamento preventivo e check-ups regulares para manter seu pet sempre saudável.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Agendar consulta\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Depoimentos</span>\n                <h2>O que nossos clientes dizem</h2>\n                <p>A confiança de quem já confiou a saúde do seu pet a nós.</p>\n            </div>\n\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up\" style=\"transition-delay: 0.1s;\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"Minha gatinha teve uma emergência à meia-noite e a equipe da Filhos de Pelo foi incrível. Atendimento rápido, carinhoso e muito profissional. Salvaram a vida da minha Mia!\"</p>\n                    <div class=\"testimonial-author\">\n                        <img src=\"https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=100&q=80\" alt=\"Foto de cliente\" class=\"testimonial-avatar\">\n                        <div class=\"testimonial-info\">\n                            <h4>Mariana Silva</h4>\n                            <>Mãe da Mia (gata)</p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up\" style=\"transition-delay: 0.2s;\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"O Thor precisou de uma cirurgia de emergência e a Dra. Carolina foi excelente. Explicou tudo, foi muito atenciosa e o Thor se recuperou perfeitamente. Recomendo de olhos fechados!\"</p>\n                    <div class=\"testimonial-author\">\n                        <img src=\"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&q=80\" alt=\"Foto de cliente\" class=\"testimonial-avatar\">\n                        <div class=\"testimonial-info\">\n                            <h4>Carlos Eduardo</h4>\n                            <p>Pai do Thor (golden retriever)</p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up\" style=\"transition-delay: 0.3s;\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"Faço consultas de rotina há 3 anos com meus dois cachorros. A estrutura é impecável e os veterinários são super cuidadosos. Meus pets adoram ir lá!\"</p>\n                    <div class=\"testimonial-author\">\n                        <img src=\"https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&q=80\" alt=\"Foto de cliente\" class=\"testimonial-avatar\">\n                        <div class=\"testimonial-info\">\n                            <h4>Fernanda Oliveira</h4>\n                            <p>Mãe do Bob e da Luna</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\">\n        <div class=\"container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Por que nos escolher</span>\n                <h2>Diferenciais que fazem a diferença</h2>\n                <p>O que nos torna únicos no cuidado com a saúde do seu pet.</p>\n            </div>\n\n            <div class=\"differentials-grid\">\n                <div class=\"differential-card wow-fade-up\" style=\"transition-delay: 0.1s;\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            <polyline points=\"12 6 12 12 16 14\"/>\n                        </svg>\n                    </div>\n                    <h3>24 Horas</h3>\n                    <p>Atendimento ininterrupto para emergências a qualquer momento</p>\n                </div>\n\n                <div class=\"differential-card wow-fade-up\" style=\"transition-delay: 0.2s;\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/>\n                        </svg>\n                    </div>\n                    <h3>Amor pelos Animais</h3>\n                    <p>Equipe apaixonada que trata cada pet como se fosse da família</p>\n                </div>\n\n                <div class=\"differential-card wow-fade-up\" style=\"transition-delay: 0.3s;\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/>\n                        </svg>\n                    </div>\n                    <h3>Excelência</h3>\n                    <p>Equipamentos modernos e técnicas atualizadas</p>\n                </div>\n\n                <div class=\"differential-card wow-fade-up\" style=\"transition-delay: 0.4s;\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/>\n                            <circle cx=\"9\" cy=\"7\" r=\"4\"/>\n                            <path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/>\n                            <path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/>\n                        </svg>\n                    </div>\n                    <h3>Equipe Qualificada</h3>\n                    <p>Veterinários experientes e constantemente treinados</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"container contact-grid\">\n            <div class=\"contact-info wow-fade-up\">\n                <span class=\"section-tag\">Contato</span>\n                <h2>Entre em contato</h2>\n                <p>Estamos prontos para atender seu pet a qualquer momento. Ligue agora ou agende uma visita.</p>\n\n                <div class=\"contact-details\">\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/>\n                                <circle cx=\"12\" cy=\"10\" r=\"3\"/>\n                            </svg>\n                        </div>\n                        <div class=\"contact-item-content\">\n                            <h4>Endereço</h4>\n                            <p>Av. Independência, 815 - Vila Seixas<br>Ribeirão Preto - SP, 14020-010</p>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"/>\n                            </svg>\n                        </div>\n                        <div class=\"contact-item-content\">\n                            <h4>Telefone</h4>\n                            <p><a href=\"tel:+5516992188558\">(16) 99218-8558</a></p>\n                            <p style=\"font-size: 0.875rem; color: #7CB987;\">Atendimento 24 horas</p>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/>\n                                <path d=\"M10 8h4M10 12h4M10 16h4\"/>\n                                <line x1=\"2\" y1=\"10\" x2=\"22\" y2=\"10\"/>\n                            </svg>\n                        </div>\n                        <div class=\"contact-item-content\">\n                            <h4>Horário</h4>\n                            <p>Aberto 24 horas<br>7 dias por semana</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"contact-form-wrapper wow-fade-up\" style=\"transition-delay: 0.2s;\">\n                <h3>Envie uma mensagem</h3>\n                <p>Preencha o formulário e entraremos em contato o mais rápido possível.</p>\n\n                <form class=\"contact-form\" id=\"contactForm\">\n                    <div class=\"form-row\">\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"name\">Seu Nome</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" class=\"form-input\" placeholder=\"Digite seu nome\" required>\n                        </div>\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"phone\">Seu Telefone</label>\n                            <input type=\"tel\" id=\"phone\" name=\"phone\" class=\"form-input\" placeholder=\"(00) 00000-0000\" required>\n                        </div>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"email\">Seu E-mail</label>\n                        <input type=\"email\" id=\"email\" name=\"email\" class=\"form-input\" placeholder=\"seu@email.com\" required>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"pet\">Nome do Pet</label>\n                        <input type=\"text\" id=\"pet\" name=\"pet\" class=\"form-input\" placeholder=\"Nome do seu pet\">\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"service\">Tipo de Atendimento</label>\n                        <select id=\"service\" name=\"service\" class=\"form-select\" required>\n                            <option value=\"\">Selecione uma opção</option>\n                            <option value=\"emergencia\">Emergência 24h</option>\n                            <option value=\"consulta\">Consulta de rotina</option>\n                            <option value=\"cirurgia\">Cirurgia</option>\n                            <option value=\"exames\">Exames laboratoriais</option>\n                            <option value=\"vacinacao\">Vacinação</option>\n                            <option value=\"outro\">Outro</option>\n                        </select>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"message\">Mensagem</label>\n                        <textarea id=\"message\" name=\"message\" class=\"form-textarea\" placeholder=\"Descreva como podemos ajudar...\" required></textarea>\n                    </div>\n\n                    <button type=\"submit\" class=\"btn btn-primary submit-btn\">\n                        Enviar Mensagem\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z\"/>\n                        </svg>\n                    </button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"container\">\n            <div class=\"footer-grid\">\n                <div class=\"footer-brand\">\n                    <div class=\"logo\">\n                        <svg viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <circle cx=\"50\" cy=\"50\" r=\"45\" fill=\"#FF6B5B\"/>\n                            <path d=\"M35 40C35 40 38 35 45 35C52 35 55 40 55 40C55 40 58 35 65 35C72 35 75 40 75 40C75 55 70 65 60 70C55 72 50 72 50 72C50 72 45 72 40 70C30 65 25 55 25 40C25 40 28 35 35 35Z\" fill=\"white\"/>\n                            <circle cx=\"42\" cy=\"45\" r=\"3\" fill=\"#2D3436\"/>\n                            <circle cx=\"58\" cy=\"45\" r=\"3\" fill=\"#2D3436\"/>\n                            <path d=\"M45 52C45 52 48 55 50 55C52 55 55 52 55 52\" stroke=\"#2D3436\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n                        </svg>\n                        Filhos de Pelo\n                    </div>\n                    <p>Clínica veterinária 24h dedicada a cuidar do seu pet com amor, dedicação e excelência.</p>\n                    <div class=\"footer-social\">\n                        <a href=\"#\" aria-label=\"Instagram\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\" ry=\"5\"/>\n                                <path d=\"M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z\"/>\n                             