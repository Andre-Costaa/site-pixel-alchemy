            </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"container\">\n            <div class=\"section-header services-intro\">\n                <span class=\"section-subtitle\">Especialidades</span>\n                <h2 class=\"section-title\">Tratamentos que <span class=\"text-rose\">transformam</span></h2>\n                <p>Procedimentos estéticos faciais com foco em resultados naturais e harmoniosos, valorizando sua beleza única.</p>\n            </div>\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">👁️</div>\n                    <div class=\"service-content\">\n                        <h3 class=\"service-title\">Harmonização Facial</h3>\n                        <p class=\"service-description\">Equilibrio dos traços faciais com preenchedores e toxina botulínica para resultados naturais e harmônicos.</p>\n                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                    </div>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"0.1s\">\n                    <div class=\"service-icon\">💉</div>\n                    <div class=\"service-content\">\n                        <h3 class=\"service-title\">Toxina Botulínica</h3>\n                        <p class=\"service-description\">Suavização de rugas e linhas de expressão com aplicação estratégica para aspecto descansado e natural.</p>\n                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                    </div>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"0.2s\">\n                    <div class=\"service-icon\">💧</div>\n                    <div class=\"service-content\">\n                        <h3 class=\"service-title\">Preenchedores Faciais</h3>\n                        <p class=\"service-description\">Restauração de volume e contorno facial com ácido hialurônico de alta qualidade.</p>\n                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                    </div>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"0.3s\">\n                    <div class=\"service-icon\">🔬</div>\n                    <div class=\"service-content\">\n                        <h3 class=\"service-title\">Bioestimuladores</h3>\n                        <p class=\"service-description\">Tratamento que estimula o colágeno natural para rejuvenescimento progressivo da pele.</p>\n                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                    </div>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"0.4s\">\n                    <div class=\"service-icon\">👄</div>\n                    <div class=\"service-content\">\n                        <h3 class=\"service-title\">Preenchimento Labial</h3>\n                        <p class=\"service-description\">Realce dos lábios com técnicas que mantêm a naturalidade e proporções harmoniosas.</p>\n                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                    </div>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"0.5s\">\n                    <div class=\"service-icon\">✨</div>\n                    <div class=\"service-content\">\n                        <h3 class=\"service-title\">Protocolos Exclusivos</h3>\n                        <p class=\"service-description\">Combinação de tratamentos personalizados conforme suas necessidades e objetivos estéticos.</p>\n                        <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"container\">\n            <div class=\"section-header services-intro\">\n                <span class=\"section-subtitle\">Depoimentos</span>\n                <h2 class=\"section-title\">O que nossas <span class=\"text-gold\">pacientes</span> dizem</h2>\n            </div>\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"A Dra. Angélica é incrível! Fiz minha harmonização facial e o resultado ficou super natural. Ela entendeu exatamente o que eu queria.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div>\n                            <div class=\"testimonial-name\">Maria Clara</div>\n                            <div class=\"testimonial-role\">Paciente de Harmonização</div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"0.1s\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Profissionalismo e cuidado em cada detalhe. Me senti segura durante todo o processo. Recomendo de olhos fechados!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AS</div>\n                        <div>\n                            <div class=\"testimonial-name\">Ana Silva</div>\n                            <div class=\"testimonial-role\">Paciente de Toxina</div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"0.2s\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Finalmente encontrei uma profissional que preza pela naturalidade. Meus lábios ficaram perfeitos, muito além do que esperava.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">JO</div>\n                        <div>\n                            <div class=\"testimonial-name\">Juliana Oliveira</div>\n                            <div class=\"testimonial-role\">Paciente de Preenchimento</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\">\n        <div class=\"container\">\n            <div class=\"section-header services-intro\">\n                <span class=\"section-subtitle\">Por que nos escolher</span>\n                <h2 class=\"section-title\">Nossos <span class=\"text-gold\">Diferenciais</span></h2>\n            </div>\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up\">\n                    <div class=\"differential-icon\">🎓</div>\n                    <h3 class=\"differential-title\">Especialização</h3>\n                    <p class=\"differential-description\">Formação exclusiva em harmonização facial e estética avançada.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"0.1s\">\n                    <div class=\"differential-icon\">🔬</div>\n                    <h3 class=\"differential-title\">Produtos Premium</h3>\n                    <p class=\"differential-description\">Utilização apenas de produtos de alta qualidade e com procedência.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"0.2s\">\n                    <div class=\"differential-icon\">🎯</div>\n                    <h3 class=\"differential-title\">Personalização</h3>\n                    <p class=\"differential-description\">Cada tratamento é desenvolvido exclusivamente para você.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"0.3s\">\n                    <div class=\"differential-icon\">💚</div>\n                    <h3 class=\"differential-title\">Segurança</h3>\n                    <p class=\"differential-description\">Procedimentos realizados com técnicas seguras e comprovadas.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"0.4s\">\n                    <div class=\"differential-icon\">📍</div>\n                    <h3 class=\"differential-title\">Localização Privilegiada</h3>\n                    <p class=\"differential-description\">Clínica no Jardim Sumaré, com fácil acesso e estacionamento.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"0.5s\">\n                    <div class=\"differential-icon\">🤝</div>\n                    <h3 class=\"differential-title\">Acompanhamento</h3>\n                    <p class=\"differential-description\">Suporte completo antes, durante e após os procedimentos.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"container\">\n            <div class=\"section-header services-intro\">\n                <span class=\"section-subtitle\">Contato</span>\n                <h2 class=\"section-title\">Agende sua <span class=\"text-rose\">avaliação gratuita</span></h2>\n            </div>\n            <div class=\"contact-grid\">\n                <div class=\"contact-info wow-fade-up\">\n                    <div class=\"contact-info-item\">\n                        <div class=\"contact-icon\">📍</div>\n                        <div>\n                            <div class=\"contact-label\">Endereço</div>\n                            <div class=\"contact-value\">R. Garibaldi, 1928<br>Jardim Sumaré, Ribeirão Preto - SP<br>CEP: 14025-382</div>\n                        </div>\n                    </div>\n                    <div class=\"contact-info-item\">\n                        <div class=\"contact-icon\">📱</div>\n                        <div>\n                            <div class=\"contact-label\">WhatsApp / Telefone</div>\n                            <div class=\"contact-value\">(16) 99635-3208</div>\n                        </div>\n                    </div>\n                    <div class=\"contact-info-item\">\n                        <div class=\"contact-icon\">⏰</div>\n                        <div>\n                            <div class=\"contact-label\">Horário de Atendimento</div>\n                            <div class=\"contact-value\">Segunda a Sexta: 9h às 18h<br>Sábado: 9h às 13h</div>\n                        </div>\n                    </div>\n                    <div class=\"contact-info-item\">\n                        <div class=\"contact-icon\">💬</div>\n                        <div>\n                            <div class=\"contact-label\">Agende Online</div>\n                            <a href=\"https://wa.me/5516996353208\" class=\"contact-value text-gold\">Clique para iniciar conversa no WhatsApp</a>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"contact-form-wrapper wow-fade-up\" data-delay=\"0.2s\">\n                    <form id=\"contactForm\">\n                        <div class=\"form-group\">\n                            <label for=\"name\" class=\"form-label\">Nome Completo</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" class=\"form-input\" placeholder=\"Seu nome\" required>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"phone\" class=\"form-label\">Telefone / WhatsApp</label>\n                            <input type=\"tel\" id=\"phone\" name=\"phone\" class=\"form-input\" placeholder=\"(16) 99999-9999\" required>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"service\" class=\"form-label\">Tratamento de Interesse</label>\n                            <select id=\"service\" name=\"service\" class=\"form-select\" required>\n                                <option value=\"\">Selecione uma opção</option>\n                                <option value=\"harmonizacao\">Harmonização Facial</option>\n                                <option value=\"toxina\">Toxina Botulínica</option>\n                                <option value=\"preenchedores\">Preenchedores Faciais</option>\n                                <option value=\"bioestimuladores\">Bioestimuladores</option>\n                                <option value=\"labios\">Preenchimento Labial</option>\n                                <option value=\"outro\">Outro Tratamento</option>\n                            </select>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"message\" class=\"form-label\">Mensagem</label>\n                            <textarea id=\"message\" name=\"message\" class=\"form-textarea\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                        </div>\n                        <button type=\"submit\" class=\"form-submit\">Solicitar Agendamento</button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-content\">\n            <div class=\"footer-brand\">\n                <div class=\"footer-logo\">Dra. Angélica Lucena</div>\n                <p class=\"footer-description\">\n                    Especialista em harmonização facial e estética avançada em Ribeirão Preto.\n                    Transformando vidas através da autoestima com tratamentos seguros e personalizados.\n                </p>\n            </div>\n            <div>\n                <h4 class=\"footer-title\">Links Rápidos</h4>\n                <ul class=\"footer-links\">\n                    <li><a href=\"#inicio\">Início</a></li>\n                    <li><a href=\"#servicos\">Serviços</a></li>\n                    <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                    <li><a href=\"#contato\">Contato</a></li>\n                </ul>\n            </div>\n            <div>\n                <h4 class=\"footer-title\">Tratamentos</h4>\n                <ul class=\"footer-links\">\n                    <li><a href=\"#servicos\">Harmonização Facial</a></li>\n                    <li><a href=\"#servicos\">Toxina Botulínica</a></li>\n                    <li><a href=\"#servicos\">Preenchedores</a></li>\n                    <li><a href=\"#servicos\">Bioestimuladores</a></li>\n                </ul>\n            </div>\n        </div>\n        <div class=\"footer-bottom\">\n            <p>&copy; 2024 Dra. Angélica Lucena - Harmonização Facial em Ribeirão Preto. Todos os direitos reservados.</p>\n        </div>\n    </footer>\n\n    <script>\n        // ========================================\n        // NAVIGATION\n        // ========================================\n        const nav = document.getElementById('nav');\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n        let lastScrollY = window.scrollY;\n\n        // Hide/show nav on scroll\n        window.addEventListener('scroll', () => {\n            if (window.scrollY > lastScrollY && window.scrollY > 100) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n            lastScrollY = window.scrollY;\n        });\n\n        // Mobile menu toggle\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close mobile menu when clicking a link\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ========================================\n        // SMOOTH SCROLL\n        // ========================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ========================================\n        // INTERSECTION OBSERVER (WOW ANIMATIONS)\n        // ========================================\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || '0s';\n                    entry.target.style.setProperty('--delay', delay);\n                    entry.target.classList.add('animated');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ========================================\n        // CONTACT FORM\n        // ========================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', function(e) {\n            e.preventDefault();\n\n            const formData = new FormData(this);\n            const name = formData.get('name');\n            const phone = formData.get('phone');\n            const service = formData.get('service');\n            const message = formData.get('message');\n\n            // Create WhatsApp message\n            const serviceNames = {\n                'harmonizacao': 'Harmonização Facial',\n                'toxina': 'Toxina Botulínica',\n                'preenchedores': 'Preenchedores Faciais',\n                'bioestimuladores': 'Bioestimuladores',\n                'labios': 'Preenchimento Labial',\n                'outro': 'Outro Tratamento'\n            };\n\n            const whatsappMessage = encodeURIComponent(\n                `Olá! Meu nome é ${name}.\\n\\n` +\n                `Gostaria de agendar uma avaliação para: ${serviceNames[service] || service}.\\n\\n` +\n                `Telefone: ${phone}\\n` +\n                `Mensagem: ${message || 'Gostaria de mais informações.'}`\n            );\n\n            // Open WhatsApp with the message\n            window.open(`https://wa.me/5516996353208?text=${whatsappMessage}`, '_blank');\n\n            // Optional: reset form\n            this.reset();\n        });\n\n        // ========================================\n        // PARALLAX EFFECT FOR BLOBS\n        // ========================================\n        document.addEventListener('mousemove', (e) => {\n            const blobs = document.querySelectorAll('.hero-blob');\n            const x = e.clientX / window.innerWidth;\n            const y = e.clientY / window.innerHeight;\n\n            blobs.forEach((blob, index) => {\n                const speed = (index + 1) * 20;\n                const xOffset = (x - 0.5) * speed;\n                const yOffset = (y - 0.5) * speed;\n                blob.style.transform = `translate(${xOffset}px, ${yOffset}px)`;\n            });\n        });\n\n        // ========================================\n        // REDUCED MOTION SUPPORT\n        // ========================================\n        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n            document.querySelectorAll('.hero-blob').forEach(blob => {\n                blob.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null}}
