{"type":"assistant","message":{"id":"msg_20260209021150e6860eaef0ba46b3","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_fab97e75123845edb0c37135","name":"Write","input":{"file_path":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-juliana-bittencourt-harmonizacao-facial/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra Juliana Bittencourt | Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra Juliana Bittencourt - Harmonização Facial e Estética Avançada em Ribeirão Preto. Transforme sua aparência com tratamentos personalizados e resultados naturais.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            /* Ivory & Emerald Noir Palette */\n            --color-emerald: #2D5A4A;\n            --color-emerald-light: #3D7A6A;\n            --color-emerald-mid: #4A8A7A;\n            --color-emerald-dark: #1D3A2A;\n            --color-emerald-deep: #0D2A1A;\n            --color-emerald-mist: #E8F0EC;\n\n            --color-ivory: #FAFAF6;\n            --color-ivory-warm: #F5F5F0;\n            --color-ivory-soft: #F0F0E8;\n            --color-cream: #F8F6F2;\n\n            --color-sage: #8BA89A;\n            --color-sage-light: #A8C8B8;\n            --color-sage-dark: #6A8878;\n\n            --color-gold: #B89B5A;\n            --color-gold-light: #C8AB6A;\n            --color-gold-dark: #A88B4A;\n\n            --color-charcoal: #2A2828;\n            --color-charcoal-dark: #1A1818;\n            --color-ink: #1A1A1A;\n            --color-ink-deep: #0F0F12;\n\n            /* Gradients */\n            --gradient-emerald: linear-gradient(135deg, var(--color-emerald) 0%, var(--color-emerald-light) 50%, var(--color-sage) 100%);\n            --gradient-emerald-soft: linear-gradient(135deg, var(--color-emerald-mist) 0%, var(--color-ivory) 100%);\n            --gradient-gold: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-light) 100%);\n            --gradient-ivory: linear-gradient(180deg, var(--color-ivory) 0%, var(--color-cream) 100%);\n\n            /* Typography */\n            --font-display: 'Libre Baskerville', Georgia, serif;\n            --font-body: 'Outfit', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 1.5rem;\n            --spacing-lg: 2rem;\n            --spacing-xl: 3rem;\n            --spacing-2xl: 4rem;\n            --spacing-3xl: 6rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 12px;\n            --radius-lg: 20px;\n            --radius-leaf-1: 65% 35% 45% 55% / 55% 45% 55% 45%;\n            --radius-leaf-2: 45% 55% 65% 35% / 45% 55% 45% 55%;\n            --radius-leaf-3: 55% 45% 35% 65% / 55% 45% 55% 45%;\n            --radius-leaf-4: 35% 65% 55% 45% / 45% 55% 45% 55%;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.3s ease;\n            --transition-slow: 0.5s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(45, 90, 74, 0.08);\n            --shadow-md: 0 4px 16px rgba(45, 90, 74, 0.12);\n            --shadow-lg: 0 8px 32px rgba(45, 90, 74, 0.16);\n            --shadow-gold: 0 4px 20px rgba(184, 155, 90, 0.15);\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background: var(--gradient-ivory);\n            color: var(--color-charcoal);\n            line-height: 1.6;\n            overflow-x: hidden;\n        }\n\n        /* Typography */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-emerald-deep);\n        }\n\n        h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); }\n        h2 { font-size: clamp(2rem, 4vw, 3rem); }\n        h3 { font-size: clamp(1.25rem, 2.5vw, 1.75rem); }\n\n        p {\n            font-size: clamp(0.95rem, 1.2vw, 1.1rem);\n            color: var(--color-charcoal);\n            opacity: 0.85;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* Navigation */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-md) var(--spacing-lg);\n            background: rgba(250, 250, 246, 0.95);\n            backdrop-filter: blur(10px);\n            border-bottom: 1px solid rgba(45, 90, 74, 0.1);\n            transition: transform 0.3s ease, padding 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-emerald-dark);\n        }\n\n        .nav-links {\n            display: flex;\n            gap: var(--spacing-lg);\n            list-style: none;\n        }\n\n        .nav-links a {\n            font-weight: 500;\n            font-size: 0.95rem;\n            color: var(--color-charcoal);\n            position: relative;\n        }\n\n        .nav-links a::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-emerald);\n            transition: width var(--transition-base);\n        }\n\n        .nav-links a:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.6rem 1.4rem;\n            background: var(--gradient-emerald);\n            color: white;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            transition: var(--transition-base);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-gold);\n        }\n\n        .nav-menu-btn {\n            display: none;\n            background: none;\n            border: none;\n            font-size: 1.5rem;\n            cursor: pointer;\n            color: var(--color-emerald-dark);\n        }\n\n        /* Mobile Menu */\n        .nav-mobile {\n            display: none;\n            position: fixed;\n            top: 70px;\n            left: 0;\n            right: 0;\n            background: var(--color-ivory);\n            padding: var(--spacing-lg);\n            border-bottom: 1px solid rgba(45, 90, 74, 0.1);\n            z-index: 999;\n        }\n\n        .nav-mobile.active {\n            display: block;\n        }\n\n        .nav-mobile-links {\n            list-style: none;\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-md);\n        }\n\n        .nav-mobile-links a {\n            font-weight: 500;\n            padding: var(--spacing-sm) 0;\n            border-bottom: 1px solid rgba(45, 90, 74, 0.1);\n        }\n\n        /* Hero Section */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            padding: var(--spacing-3xl) var(--spacing-lg);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .hero-leaves {\n            position: absolute;\n            inset: 0;\n            overflow: hidden;\n            z-index: 0;\n        }\n\n        .hero-leaf {\n            position: absolute;\n            border-radius: var(--radius-leaf-1);\n            filter: blur(60px);\n            opacity: 0.35;\n            animation: leafFloat 20s ease-in-out infinite;\n        }\n\n        .hero-leaf-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-emerald);\n            top: -150px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .hero-leaf-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-gold);\n            bottom: -100px;\n            left: -100px;\n            animation-delay: 5s;\n        }\n\n        .hero-leaf-3 {\n            width: 300px;\n            height: 300px;\n            background: var(--color-emerald-mist);\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: 10s;\n        }\n\n        .hero-leaf-4 {\n            width: 350px;\n            height: 350px;\n            background: linear-gradient(135deg, var(--color-sage-light) 0%, var(--color-emerald-light) 100%);\n            bottom: 20%;\n            right: 10%;\n            animation-delay: 15s;\n        }\n\n        @keyframes leafFloat {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n                border-radius: var(--radius-leaf-1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(90deg) scale(1.05);\n                border-radius: var(--radius-leaf-2);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(180deg) scale(0.95);\n                border-radius: var(--radius-leaf-3);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(270deg) scale(1.02);\n                border-radius: var(--radius-leaf-4);\n            }\n        }\n\n        .hero-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-2xl);\n            align-items: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .hero-content {\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease forwards;\n        }\n\n        @keyframes fadeInUp {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .hero-badge {\n            display: inline-block;\n            padding: 0.5rem 1rem;\n            background: var(--color-emerald-mist);\n            color: var(--color-emerald-dark);\n            border-radius: var(--radius-lg);\n            font-weight: 600;\n            font-size: 0.9rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            color: var(--color-emerald-deep);\n        }\n\n        .hero-title span {\n            color: var(--color-gold);\n        }\n\n        .hero-description {\n            font-size: 1.1rem;\n            margin-bottom: var(--spacing-lg);\n            opacity: 0.9;\n        }\n\n        .hero-ctas {\n            display: flex;\n            gap: var(--spacing-md);\n            flex-wrap: wrap;\n        }\n\n        .btn-primary {\n            padding: 1rem 2rem;\n            background: var(--gradient-emerald);\n            color: white;\n            border: none;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-gold);\n        }\n\n        .btn-secondary {\n            padding: 1rem 2rem;\n            background: transparent;\n            color: var(--color-emerald-dark);\n            border: 2px solid var(--color-emerald);\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-emerald-mist);\n        }\n\n        .hero-image {\n            position: relative;\n            opacity: 0;\n            transform: translateX(30px);\n            animation: fadeInRight 0.8s ease 0.2s forwards;\n        }\n\n        @keyframes fadeInRight {\n            to {\n                opacity: 1;\n                transform: translateX(0);\n            }\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            border-radius: var(--radius-lg);\n            overflow: hidden;\n            box-shadow: var(--shadow-lg);\n        }\n\n        .hero-image-wrapper img {\n            width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        .hero-image-decoration {\n            position: absolute;\n            bottom: -20px;\n            left: -20px;\n            width: 100px;\n            height: 100px;\n            background: var(--gradient-gold);\n            border-radius: var(--radius-leaf-1);\n            opacity: 0.3;\n        }\n\n        /* Problem/Solution Section */\n        .problem-solution {\n            padding: var(--spacing-3xl) var(--spacing-lg);\n            background: var(--color-ivory-soft);\n        }\n\n        .problem-solution-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: var(--spacing-xl);\n        }\n\n        .problem-card, .solution-card {\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            position: relative;\n            overflow: hidden;\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-slow);\n        }\n\n        .problem-card {\n            background: var(--color-ivory);\n            border-left: 4px solid var(--color-emerald-dark);\n        }\n\n        .solution-card {\n            background: var(--gradient-emerald-soft);\n            border-left: 4px solid var(--color-gold);\n        }\n\n        .problem-card.wow-animate, .solution-card.wow-animate {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .problem-card h3, .solution-card h3 {\n            margin-bottom: var(--spacing-md);\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .problem-icon, .solution-icon {\n            width: 40px;\n            height: 40px;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.2rem;\n        }\n\n        .problem-icon {\n            background: rgba(45, 90, 74, 0.1);\n            color: var(--color-emerald-dark);\n        }\n\n        .solution-icon {\n            background: rgba(184, 155, 90, 0.2);\n            color: var(--color-gold-dark);\n        }\n\n        /* Services Section */\n        .services {\n            padding: var(--spacing-3xl) var(--spacing-lg);\n        }\n\n        .services-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-2xl);\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-slow);\n        }\n\n        .section-header.wow-animate {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .section-subtitle {\n            display: inline-block;\n            padding: 0.4rem 1rem;\n            background: var(--color-emerald-mist);\n            color: var(--color-emerald-dark);\n            border-radius: var(--radius-lg);\n            font-weight: 600;\n            font-size: 0.9rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .section-title {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .section-description {\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .service-card {\n            background: var(--color-ivory);\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-sm);\n            transition: var(--transition-base);\n            opacity: 0;\n            transform: translateY(30px);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card.wow-animate {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .service-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-emerald);\n            transform: scaleX(0);\n            transform-origin: left;\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-emerald-soft);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.8rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .service-card h3 {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-emerald-deep);\n        }\n\n        .service-card p {\n            margin-bottom: var(--spacing-md);\n            opacity: 0.8;\n        }\n\n        .service-link {\n            color: var(--color-emerald);\n            font-weight: 600;\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .service-link:hover {\n            color: var(--color-gold);\n        }\n\n        /* Testimonials Section */\n        .testimonials {\n            padding: var(--spacing-3xl) var(--spacing-lg);\n            background: var(--gradient-emerald-soft);\n        }\n\n        .testimonials-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .testimonial-card {\n            background: var(--color-ivory);\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-md);\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-base);\n        }\n\n        .testimonial-card.wow-animate {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .testimonial-card:hover {\n            transform: translateY(-5px);\n        }\n\n        .testimonial-rating {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: var(--spacing-md);\n            color: var(--color-gold);\n        }\n\n        .testimonial-text {\n            font-style: italic;\n            margin-bottom: var(--spacing-md);\n            opacity: 0.9;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: var(--gradient-emerald);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-weight: 600;\n        }\n\n        .testimonial-info h4 {\n            font-size: 1rem;\n            margin-bottom: 0.2rem;\n        }\n\n        .testimonial-info span {\n            font-size: 0.85rem;\n            opacity: 0.7;\n        }\n\n        /* Differentials Section */\n        .differentials {\n            padding: var(--spacing-3xl) var(--spacing-lg);\n        }\n\n        .differentials-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-lg);\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-base);\n        }\n\n        .differential-item.wow-animate {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            width: 80px;\n            height: 80px;\n            margin: 0 auto var(--spacing-md);\n        }\n\n        .differential-icon-wrapper::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            border-radius: 50%;\n            background: var(--gradient-emerald);\n            opacity: 0.2;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { transform: scale(1); opacity: 0.2; }\n            50% { transform: scale(1.1); opacity: 0.1; }\n        }\n\n        .differential-icon {\n            position: relative;\n            width: 80px;\n            height: 80px;\n            background: var(--gradient-emerald-soft);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 2rem;\n        }\n\n        .differential-item h3 {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-emerald-deep);\n        }\n\n        .differential-item p {\n            opacity: 0.8;\n        }\n\n        /* Contact Section */\n        .contact {\n            padding: var(--spacing-3xl) var(--spacing-lg);\n            background: var(--color-emerald-deep);\n            color: var(--color-ivory);\n        }\n\n        .contact-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-2xl);\n        }\n\n        .contact-info h2 {\n            color: var(--color-ivory);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-info p {\n            color: var(--color-ivory);\n            opacity: 0.9;\n            margin-bottom: var(--spacing-xl);\n        }\n\n        .contact-details {\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-md);\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-md);\n        }\n\n        .contact-item-icon {\n            width: 50px;\n            height: 50px;\n            background: rgba(255, 255, 255, 0.1);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.3rem;\n        }\n\n        .contact-item-text h4 {\n            color: var(--color-ivory);\n            font-size: 1rem;\n            margin-bottom: 0.2rem;\n        }\n\n        .contact-item-text span {\n            color: var(--color-sage-light);\n            font-size: 0.9rem;\n        }\n\n        .contact-form {\n            background: var(--color-ivory);\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n        }\n\n        .contact-form h3 {\n            color: var(--color-emerald-deep);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-group label {\n            display: block;\n            font-weight: 500;\n            margin-bottom: 0.5rem;\n            color: var(--color-emerald-dark);\n        }\n\n        .form-group input,\n        .form-group select,\n        .form-group textarea {\n            width: 100%;\n            padding: 0.8rem 1rem;\n            border: 2px solid var(--color-sage);\n            border-radius: var(--radius-md);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: var(--transition-base);\n            background: var(--color-ivory);\n        }\n\n        .form-group input:focus,\n        .form-group select:focus,\n        .form-group textarea:focus {\n            outline: none;\n            border-color: var(--color-emerald);\n            background: white;\n        }\n\n        .form-group textarea {\n            resize: vertical;\n            min-height: 120px;\n        }\n\n        .submit-btn {\n            width: 100%;\n            padding: 1rem;\n            background: var(--gradient-emerald);\n            color: white;\n            border: none;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .submit-btn:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-gold);\n        }\n\n        /* Footer */\n        .footer {\n            padding: var(--spacing-xl) var(--spacing-lg);\n            background: var(--color-ink-deep);\n            color: var(--color-ivory);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            text-align: center;\n        }\n\n        .footer-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .footer-links {\n            display: flex;\n            justify-content: center;\n            gap: var(--spacing-lg);\n            margin-bottom: var(--spacing-md);\n            flex-wrap: wrap;\n        }\n\n        .footer-links a {\n            opacity: 0.8;\n            transition: var(--transition-base);\n        }\n\n        .footer-links a:hover {\n            opacity: 1;\n            color: var(--color-gold);\n        }\n\n        .footer-copy {\n            opacity: 0.6;\n            font-size: 0.9rem;\n        }\n\n        /* Responsive */\n        @media (max-width: 1024px) {\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-links, .nav-cta {\n                display: none;\n            }\n\n            .nav-menu-btn {\n                display: block;\n            }\n\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-ctas {\n                justify-content: center;\n            }\n\n            .hero-image {\n                order: -1;\n            }\n\n            .problem-solution-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .contact-grid {\n                grid-template-columns: 1fr;\n            }\n\n            h1 { font-size: clamp(2rem, 8vw, 3rem); }\n        }\n\n        /* Reduced Motion */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        /* WoW Animations */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.wow-animate {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-delay-1 { animation-delay: 0.1s; transition-delay: 0.1s; }\n        .wow-delay-2 { animation-delay: 0.2s; transition-delay: 0.2s; }\n        .wow-delay-3 { animation-delay: 0.3s; transition-delay: 0.3s; }\n        .wow-delay-4 { animation-delay: 0.4s; transition-delay: 0.4s; }\n        .wow-delay-5 { animation-delay: 0.5s; transition-delay: 0.5s; }\n        .wow-delay-6 { animation-delay: 0.6s; transition-delay: 0.6s; }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <div class=\"nav-logo\">Dra Juliana Bittencourt</div>\n            <ul class=\"nav-links\">\n                <li><a href=\"#home\">Início</a></li>\n                <li><a href=\"#services\">Serviços</a></li>\n                <li><a href=\"#testimonials\">Depoimentos</a></li>\n                <li><a href=\"#differentials\">Diferenciais</a></li>\n                <li><a href=\"#contact\">Contato</a></li>\n            </ul>\n            <a href=\"#contact\" class=\"nav-cta\">Agendar Consulta</a>\n            <button class=\"nav-menu-btn\" id=\"menuBtn\">☰</button>\n        </div>\n    </nav>\n\n    <!-- Mobile Menu -->\n    <div class=\"nav-mobile\" id=\"mobileMenu\">\n        <ul class=\"nav-mobile-links\">\n            <li><a href=\"#home\">Início</a></li>\n            <li><a href=\"#services\">Serviços</a></li>\n            <li><a href=\"#testimonials\">Depoimentos</a></li>\n            <li><a href=\"#differentials\">Diferenciais</a></li>\n            <li><a href=\"#contact\">Contato</a></li>\n        </ul>\n    </div>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-leaves\">\n            <div class=\"hero-leaf hero-leaf-1\"></div>\n            <div class=\"hero-leaf hero-leaf-2\"></div>\n            <div class=\"hero-leaf hero-leaf-3\"></div>\n            <div class=\"hero-leaf hero-leaf-4\"></div>\n        </div>\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <span class=\"hero-badge\">✨ Harmonização Facial em Ribeirão Preto</span>\n                <h1 class=\"hero-title\">Sua Beleza Natural <span>Realçada</span> com Excelência</h1>\n                <p class=\"hero-description\">Transforme sua aparência com tratamentos personalizados de harmonização facial. Resultados naturais e seguros com a Dra Juliana Bittencourt.</p>\n                <div class=\"hero-ctas\">\n                    <a href=\"#contact\" class=\"btn-primary\">Agendar Consulta →</a>\n                    <a href=\"#services\" class=\"btn-secondary\">Conhecer Serviços</a>\n                </div>\n            </div>\n            <div class=\"hero-image\">\n                <div class=\"hero-image-wrapper\">\n                    <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=600&h=700&fit=crop&crop=face\" alt=\"Dra Juliana Bittencourt - Harmonização Facial\">\n                </div>\n                <div class=\"hero-image-decoration\"></div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"problem-solution\">\n        <div class=\"problem-solution-container\">\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card wow-fade-up\">\n                    <h3>\n                        <span class=\"problem-icon\">😔</span>\n                        Seu Desafio\n                    </h3>\n                    <p>Sente que seu rosto perdeu luminosidade e vitalidade? Linhas de expressão, perda de volume e assimetrias faciais afetam sua autoestima? Você busca resultados naturais mas tem receio de procedimentos estéticos?</p>\n                </div>\n                <div class=\"solution-card wow-fade-up\">\n                    <h3>\n                        <span class=\"solution-icon\">✨</span>\n                        Nossa Solução\n                    </h3>\n                    <p>Harmonização facial personalizada com técnicas avançadas e produtos de alta qualidade. A Dra Juliana Bittencourt combina arte e ciência para realçar seus traços naturais, proporcionando resultados sutis e elegantes.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"services\" id=\"services\">\n        <div class=\"services-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-subtitle\">Tratamentos Especializados</span>\n                <h2 class=\"section-title\">Serviços que Transformam</h2>\n                <p class=\"section-description\">Procedimentos faciais personalizados para realçar sua beleza natural com resultados harmoniosos.</p>\n            </div>\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up wow-delay-1\">\n                    <div class=\"service-icon\">🎯</div>\n                    <h3>Harmonização Facial</h3>\n                    <p>Equilíbrio dos traços faciais com preenchedores e toxina botulínica para resultados naturais e harmoniosos.</p>\n                    <a href=\"#contact\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-fade-up wow-delay-2\">\n                    <div class=\"service-icon\">💉</div>\n                    <h3>Toxina Botulínica</h3>\n                    <p>Suavização de linhas de expressão com aplicação estratégica para resultado rejuvenescedor natural.</p>\n                    <a href=\"#contact\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-fade-up wow-delay-3\">\n                    <div class=\"service-icon\">✨</div>\n                    <h3>Preenchedores Faciais</h3>\n                    <p>Restauração de volume e contorno facial com ácido hialurônico de alta qualidade.</p>\n                    <a href=\"#contact\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-fade-up wow-delay-4\">\n                    <div class=\"service-icon\">💋</div>\n                    <h3>Preenchimento Labial</h3>\n                    <p>Realce e volume dos lábios com técnicas que proporcionam resultado natural e bonito.</p>\n                    <a href=\"#contact\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-fade-up wow-delay-5\">\n                    <div class=\"service-icon\">🔬</div>\n                    <h3>Bioestimuladores</h3>\n                    <p>Estímulo de colágeno para rejuvenescimento progressivo e duradouro da pele.</p>\n                    <a href=\"#contact\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-fade-up wow-delay-6\">\n                    <div class=\"service-icon\">💎</div>\n                    <h3>Protocolos Exclusivos</h3>\n                    <p>Combinações personalizadas de tratamentos para resultados únicos e excepcionais.</p>\n                    <a href=\"#contact\" class=\"service-link\">Saiba mais →</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"testimonials\" id=\"testimonials\">\n        <div class=\"testimonials-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-subtitle\">Depoimentos Reais</span>\n                <h2 class=\"section-title\">O Que Dizem Nossas Clientes</h2>\n                <p class=\"section-description\">Histórias de transformação e satisfação com nossos tratamentos.</p>\n            </div>\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up wow-delay-1\">\n                    <div class=\"testimonial-rating\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Excelente profissional! A Dra Juliana é super atenciosa e caprichosa. Fiz harmonização facial e o resultado ficou super natural. Recomendo de olhos fechados!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Maria Clara</h4>\n                            <span>Empresária</span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up wow-delay-2\">\n                    <div class=\"testimonial-rating\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Fiz preenchimento labial e ficou perfeito! Muito natural, exatamente como eu queria. A Dra tem mão leve e muito conhecimento técnico.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AS</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Ana Silva</h4>\n                            <span>Advogada</span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up wow-delay-3\">\n                    <div class=\"testimonial-rating\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Ambiente acolhedor e profissional muito preparada. Fiz botox e ficou super natural. Ninguém diz que fiz algo, só que estou com cara de descansada.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">PL</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Patricia Lima</h4>\n                            <span>Profissional Liberal</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"differentials\" id=\"differentials\">\n        <div class=\"differentials-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-subtitle\">Por Que Nos Escolher</span>\n                <h2 class=\"section-title\">Nossos Diferenciais</h2>\n                <p class=\"section-description\">Compromisso com qualidade, segurança e resultados excepcionais.</p>\n            </div>\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up wow-delay-1\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">🎨</div>\n                    </div>\n                    <h3>Resultados Naturais</h3>\n                    <p>Técnicas que realçam sua beleza sem exageros, preservando sua identidade.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-2\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">🔬</div>\n                    </div>\n                    <h3>Produtos Certificados</h3>\n                    <p>Utilização exclusiva de produtos originais e aprovados pela ANVISA.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-3\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">👩‍⚕️</div>\n                    </div>\n                    <h3>Atendimento Personalizado</h3>\n                    <p>Cada tratamento é único e desenvolvido especialmente para você.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-4\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">🏥</div>\n                    </div>\n                    <h3>Ambiente Seguro</h3>\n                    <p>Clínica equipada e seguindo rigorosamente as normas de biossegurança.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-5\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">📚</div>\n                    </div>\n                    <h3>Atualização Constante</h3>\n                    <p>Profissional sempre em busca das últimas técnicas do mercado.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-6\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">💚</div>\n                    </div>\n                    <h3>Acompanhamento</h3>\n                    <p>Suporte contínuo antes, durante e após os procedimentos.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"contact\" id=\"contact\">\n        <div class=\"contact-container\">\n            <div class=\"contact-grid\">\n                <div class=\"contact-info\">\n                    <h2>Agende Sua Consulta</h2>\n                    <p>Entre em contato para transformar sua aparência com tratamentos personalizados de harmonização facial em Ribeirão Preto.</p>\n                    <div class=\"contact-details\">\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">📍</div>\n                            <div class=\"contact-item-text\">\n                                <h4>Endereço</h4>\n                                <span>R. Triunfo, 1349 - Jardim Botânico, Ribeirão Preto - SP, 14021-612</span>\n                            </div>\n                        </div>\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">📱</div>\n                            <div class=\"contact-item-text\">\n                                <h4>WhatsApp</h4>\n                                <span>(16) 99725-2010</span>\n                            </div>\n                        </div>\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">⏰</div>\n                            <div class=\"contact-item-text\">\n                                <h4>Horário</h4>\n                                <span>Segunda a Sexta: 9h às 18h</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"contact-form\">\n                    <h3>Envie uma Mensagem</h3>\n                    <form id=\"whatsappForm\">\n                        <div class=\"form-group\">\n                            <label for=\"name\">Nome Completo</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" required placeholder=\"Seu nome\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"phone\">Telefone</label>\n                            <input type=\"tel\" id=\"phone\" name=\"phone\" required placeholder=\"(00) 00000-0000\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"service\">Tratamento de Interesse</label>\n                            <select id=\"service\" name=\"service\" required>\n                                <option value=\"\">Selecione uma opção</option>\n                                <option value=\"Harmonização Facial\">Harmonização Facial</option>\n                                <option value=\"Toxina Botulínica\">Toxina Botulínica</option>\n                                <option value=\"Preenchedores Faciais\">Preenchedores Faciais</option>\n                                <option value=\"Preenchimento Labial\">Preenchimento Labial</option>\n                                <option value=\"Bioestimuladores\">Bioestimuladores</option>\n                                <option value=\"Protocolos Exclusivos\">Protocolos Exclusivos</option>\n                                <option value=\"Outro\">Outro</option>\n                            </select>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"message\">Mensagem</label>\n                            <textarea id=\"message\" name=\"message\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                        </div>\n                        <button type=\"submit\" class=\"submit-btn\">Enviar via WhatsApp →</button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-logo\">Dra Juliana Bittencourt</div>\n            <div class=\"footer-links\">\n                <a href=\"#home\">Início</a>\n                <a href=\"#services\">Serviços</a>\n                <a href=\"#testimonials\">Depoimentos</a>\n                <a href=\"#differentials\">Diferenciais</a>\n                <a href=\"#contact\">Contato</a>\n            </div>\n            <p class=\"footer-copy\">© 2025 Dra Juliana Bittencourt - Harmonização Facial. Todos os direitos reservados.</p>\n        </div>\n    </footer>\n\n    <script>\n        // Navigation scroll effect\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                } else {\n                    nav.classList.remove('hidden');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Mobile menu toggle\n        const menuBtn = document.getElementById('menuBtn');\n        const mobileMenu = document.getElementById('mobileMenu');\n\n        menuBtn.addEventListener('click', () => {\n            mobileMenu.classList.toggle('active');\n        });\n\n        // Close mobile menu on link click\n        const mobileLinks = mobileMenu.querySelectorAll('a');\n        mobileLinks.forEach(link => {\n            link.addEventListener('click', () => {\n                mobileMenu.classList.remove('active');\n            });\n        });\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // Intersection Observer for animations\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('wow-animate');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        // Observe all wow elements\n        document.querySelectorAll('.wow-fade-up, .problem-card, .solution-card, .service-card, .testimonial-card, .differential-item, .section-header').forEach(el => {\n            observer.observe(el);\n        });\n\n        // WhatsApp form submission\n        const whatsappForm = document.getElementById('whatsappForm');\n        whatsappForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const whatsappNumber = '5516997252010';\n            const text = `Olá! Meu nome é ${name}.%0A%0ATelefone: ${phone}%0A%0ATratamento de interesse: ${service}%0A%0AMensagem: ${message || 'Gostaria de agendar uma consulta.'}`;\n\n            window.open(`https://wa.me/${whatsappNumber}?text=${text}`, '_blank');\n        });\n\n        // Check for reduced motion preference\n        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n        if (prefersReducedMotion.matches) {\n            document.querySelectorAll('.hero-leaf').forEach(leaf => {\n                leaf.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"22f4130f-cb77-438b-a06a-f562b3a68d40","uuid":"8c9f80a0-4d50-42ac-861d-c22a40a041f0"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_fab97e75123845edb0c37135","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-juliana-bittencourt-harmonizacao-facial/index.html"}]},"parent_tool_use_id":null,"session_id":"22f4130f-cb77-438b-a06a-f562b3a68d40","uuid":"502164cf-789a-4640-9fee-c00cb7d1770d","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-juliana-bittencourt-harmonizacao-facial/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra Juliana Bittencourt | Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra Juliana Bittencourt - Harmonização Facial e Estética Avançada em Ribeirão Preto. Transforme sua aparência com tratamentos personalizados e resultados naturais.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            /* Ivory & Emerald Noir Palette */\n            --color-emerald: #2D5A4A;\n            --color-emerald-light: #3D7A6A;\n            --color-emerald-mid: #4A8A7A;\n            --color-emerald-dark: #1D3A2A;\n            --color-emerald-deep: #0D2A1A;\n            --color-emerald-mist: #E8F0EC;\n\n            --color-ivory: #FAFAF6;\n            --color-ivory-warm: #F5F5F0;\n            --color-ivory-soft: #F0F0E8;\n            --color-cream: #F8F6F2;\n\n            --color-sage: #8BA89A;\n            --color-sage-light: #A8C8B8;\n            --color-sage-dark: #6A8878;\n\n            --color-gold: #B89B5A;\n            --color-gold-light: #C8AB6A;\n            --color-gold-dark: #A88B4A;\n\n            --color-charcoal: #2A2828;\n            --color-charcoal-dark: #1A1818;\n            --color-ink: #1A1A1A;\n            --color-ink-deep: #0F0F12;\n\n            /* Gradients */\n            --gradient-emerald: linear-gradient(135deg, var(--color-emerald) 0%, var(--color-emerald-light) 50%, var(--color-sage) 100%);\n            --gradient-emerald-soft: linear-gradient(135deg, var(--color-emerald-mist) 0%, var(--color-ivory) 100%);\n            --gradient-gold: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-light) 100%);\n            --gradient-ivory: linear-gradient(180deg, var(--color-ivory) 0%, var(--color-cream) 100%);\n\n            /* Typography */\n            --font-display: 'Libre Baskerville', Georgia, serif;\n            --font-body: 'Outfit', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 1.5rem;\n            --spacing-lg: 2rem;\n            --spacing-xl: 3rem;\n            --spacing-2xl: 4rem;\n            --spacing-3xl: 6rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 12px;\n            --radius-lg: 20px;\n            --radius-leaf-1: 65% 35% 45% 55% / 55% 45% 55% 45%;\n            --radius-leaf-2: 45% 55% 65% 35% / 45% 55% 45% 55%;\n            --radius-leaf-3: 55% 45% 35% 65% / 55% 45% 55% 45%;\n            --radius-leaf-4: 35% 65% 55% 45% / 45% 55% 45% 55%;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.3s ease;\n            --transition-slow: 0.5s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(45, 90, 74, 0.08);\n            --shadow-md: 0 4px 16px rgba(45, 90, 74, 0.12);\n            --shadow-lg: 0 8px 32px rgba(45, 90, 74, 0.16);\n            --shadow-gold: 0 4px 20px rgba(184, 155, 90, 0.15);\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background: var(--gradient-ivory);\n            color: var(--color-charcoal);\n            line-height: 1.6;\n            overflow-x: hidden;\n        }\n\n        /* Typography */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-emerald-deep);\n        }\n\n        h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); }\n        h2 { font-size: clamp(2rem, 4vw, 3rem); }\n        h3 { font-size: clamp(1.25rem, 2.5vw, 1.75rem); }\n\n        p {\n            font-size: clamp(0.95rem, 1.2vw, 1.1rem);\n            color: var(--color-charcoal);\n            opacity: 0.85;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* Navigation */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-md) var(--spacing-lg);\n            background: rgba(250, 250, 246, 0.95);\n            backdrop-filter: blur(10px);\n            border-bottom: 1px solid rgba(45, 90, 74, 0.1);\n            transition: transform 0.3s ease, padding 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-emerald-dark);\n        }\n\n        .nav-links {\n            display: flex;\n            gap: var(--spacing-lg);\n            list-style: none;\n        }\n\n        .nav-links a {\n            font-weight: 500;\n            font-size: 0.95rem;\n            color: var(--color-charcoal);\n            position: relative;\n        }\n\n        .nav-links a::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-emerald);\n            transition: width var(--transition-base);\n        }\n\n        .nav-links a:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.6rem 1.4rem;\n            background: var(--gradient-emerald);\n            color: white;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            transition: var(--transition-base);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-gold);\n        }\n\n        .nav-menu-btn {\n            display: none;\n            background: none;\n            border: none;\n            font-size: 1.5rem;\n            cursor: pointer;\n            color: var(--color-emerald-dark);\n        }\n\n        /* Mobile Menu */\n        .nav-mobile {\n            display: none;\n            position: fixed;\n            top: 70px;\n            left: 0;\n            right: 0;\n            background: var(--color-ivory);\n            padding: var(--spacing-lg);\n            border-bottom: 1px solid rgba(45, 90, 74, 0.1);\n            z-index: 999;\n        }\n\n        .nav-mobile.active {\n            display: block;\n        }\n\n        .nav-mobile-links {\n            list-style: none;\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-md);\n        }\n\n        .nav-mobile-links a {\n            font-weight: 500;\n            padding: var(--spacing-sm) 0;\n            border-bottom: 1px solid rgba(45, 90, 74, 0.1);\n        }\n\n        /* Hero Section */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            padding: var(--spacing-3xl) var(--spacing-lg);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .hero-leaves {\n            position: absolute;\n            inset: 0;\n            overflow: hidden;\n            z-index: 0;\n        }\n\n        .hero-leaf {\n            position: absolute;\n            border-radius: var(--radius-leaf-1);\n            filter: blur(60px);\n            opacity: 0.35;\n            animation: leafFloat 20s ease-in-out infinite;\n        }\n\n        .hero-leaf-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-emerald);\n            top: -150px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .hero-leaf-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-gold);\n            bottom: -100px;\n            left: -100px;\n            animation-delay: 5s;\n        }\n\n        .hero-leaf-3 {\n            width: 300px;\n            height: 300px;\n            background: var(--color-emerald-mist);\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: 10s;\n        }\n\n        .hero-leaf-4 {\n            width: 350px;\n            height: 350px;\n            background: linear-gradient(135deg, var(--color-sage-light) 0%, var(--color-emerald-light) 100%);\n            bottom: 20%;\n            right: 10%;\n            animation-delay: 15s;\n        }\n\n        @keyframes leafFloat {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n                border-radius: var(--radius-leaf-1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(90deg) scale(1.05);\n                border-radius: var(--radius-leaf-2);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(180deg) scale(0.95);\n                border-radius: var(--radius-leaf-3);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(270deg) scale(1.02);\n                border-radius: var(--radius-leaf-4);\n            }\n        }\n\n        .hero-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-2xl);\n            align-items: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .hero-content {\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease forwards;\n        }\n\n        @keyframes fadeInUp {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .hero-badge {\n            display: inline-block;\n            padding: 0.5rem 1rem;\n            background: var(--color-emerald-mist);\n            color: var(--color-emerald-dark);\n            border-radius: var(--radius-lg);\n            font-weight: 600;\n            font-size: 0.9rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            color: var(--color-emerald-deep);\n        }\n\n        .hero-title span {\n            color: var(--color-gold);\n        }\n\n        .hero-description {\n            font-size: 1.1rem;\n            margin-bottom: var(--spacing-lg);\n            opacity: 0.9;\n        }\n\n        .hero-ctas {\n            display: flex;\n            gap: var(--spacing-md);\n            flex-wrap: wrap;\n        }\n\n        .btn-primary {\n            padding: 1rem 2rem;\n            background: var(--gradient-emerald);\n            color: white;\n            border: none;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-gold);\n        }\n\n        .btn-secondary {\n            padding: 1rem 2rem;\n            background: transparent;\n            color: var(--color-emerald-dark);\n            border: 2px solid var(--color-emerald);\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-emerald-mist);\n        }\n\n        .hero-image {\n            position: relative;\n            opacity: 0;\n            transform: translateX(30px);\n            animation: fadeInRight 0.8s ease 0.2s forwards;\n        }\n\n        @keyframes fadeInRight {\n            to {\n                opacity: 1;\n                transform: translateX(0);\n            }\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            border-radius: var(--radius-lg);\n            overflow: hidden;\n            box-shadow: var(--shadow-lg);\n        }\n\n        .hero-image-wrapper img {\n            width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        .hero-image-decoration {\n            position: absolute;\n            bottom: -20px;\n            left: -20px;\n            width: 100px;\n            height: 100px;\n            background: var(--gradient-gold);\n            border-radius: var(--radius-leaf-1);\n            opacity: 0.3;\n        }\n\n        /* Problem/Solution Section */\n        .problem-solution {\n            padding: var(--spacing-3xl) var(--spacing-lg);\n            background: var(--color-ivory-soft);\n        }\n\n        .problem-solution-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: var(--spacing-xl);\n        }\n\n        .problem-card, .solution-card {\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            position: relative;\n            overflow: hidden;\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-slow);\n        }\n\n        .problem-card {\n            background: var(--color-ivory);\n            border-left: 4px solid var(--color-emerald-dark);\n        }\n\n        .solution-card {\n            background: var(--gradient-emerald-soft);\n            border-left: 4px solid var(--color-gold);\n        }\n\n        .problem-card.wow-animate, .solution-card.wow-animate {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .problem-card h3, .solution-card h3 {\n            margin-bottom: var(--spacing-md);\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .problem-icon, .solution-icon {\n            width: 40px;\n            height: 40px;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.2rem;\n        }\n\n        .problem-icon {\n            background: rgba(45, 90, 74, 0.1);\n            color: var(--color-emerald-dark);\n        }\n\n        .solution-icon {\n            background: rgba(184, 155, 90, 0.2);\n            color: var(--color-gold-dark);\n        }\n\n        /* Services Section */\n        .services {\n            padding: var(--spacing-3xl) var(--spacing-lg);\n        }\n\n        .services-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-2xl);\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-slow);\n        }\n\n        .section-header.wow-animate {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .section-subtitle {\n            display: inline-block;\n            padding: 0.4rem 1rem;\n            background: var(--color-emerald-mist);\n            color: var(--color-emerald-dark);\n            border-radius: var(--radius-lg);\n            font-weight: 600;\n            font-size: 0.9rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .section-title {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .section-description {\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .service-card {\n            background: var(--color-ivory);\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-sm);\n            transition: var(--transition-base);\n            opacity: 0;\n            transform: translateY(30px);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card.wow-animate {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .service-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-emerald);\n            transform: scaleX(0);\n            transform-origin: left;\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-emerald-soft);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.8rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .service-card h3 {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-emerald-deep);\n        }\n\n        .service-card p {\n            margin-bottom: var(--spacing-md);\n            opacity: 0.8;\n        }\n\n        .service-link {\n            color: var(--color-emerald);\n            font-weight: 600;\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .service-link:hover {\n            color: var(--color-gold);\n        }\n\n        /* Testimonials Section */\n        .testimonials {\n            padding: var(--spacing-3xl) var(--spacing-lg);\n            background: var(--gradient-emerald-soft);\n        }\n\n        .testimonials-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .testimonial-card {\n            background: var(--color-ivory);\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-md);\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-base);\n        }\n\n        .testimonial-card.wow-animate {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .testimonial-card:hover {\n            transform: translateY(-5px);\n        }\n\n        .testimonial-rating {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: var(--spacing-md);\n            color: var(--color-gold);\n        }\n\n        .testimonial-text {\n            font-style: italic;\n            margin-bottom: var(--spacing-md);\n            opacity: 0.9;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: var(--gradient-emerald);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-weight: 600;\n        }\n\n        .testimonial-info h4 {\n            font-size: 1rem;\n            margin-bottom: 0.2rem;\n        }\n\n        .testimonial-info span {\n            font-size: 0.85rem;\n            opacity: 0.7;\n        }\n\n        /* Differentials Section */\n        .differentials {\n            padding: var(--spacing-3xl) var(--spacing-lg);\n        }\n\n        .differentials-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-lg);\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-base);\n        }\n\n        .differential-item.wow-animate {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            width: 80px;\n            height: 80px;\n            margin: 0 auto var(--spacing-md);\n        }\n\n        .differential-icon-wrapper::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            border-radius: 50%;\n            background: var(--gradient-emerald);\n            opacity: 0.2;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { transform: scale(1); opacity: 0.2; }\n            50% { transform: scale(1.1); opacity: 0.1; }\n        }\n\n        .differential-icon {\n            position: relative;\n            width: 80px;\n            height: 80px;\n            background: var(--gradient-emerald-soft);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 2rem;\n        }\n\n        .differential-item h3 {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-emerald-deep);\n        }\n\n        .differential-item p {\n            opacity: 0.8;\n        }\n\n        /* Contact Section */\n        .contact {\n            padding: var(--spacing-3xl) var(--spacing-lg);\n            background: var(--color-emerald-deep);\n            color: var(--color-ivory);\n        }\n\n        .contact-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-2xl);\n        }\n\n        .contact-info h2 {\n            color: var(--color-ivory);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-info p {\n            color: var(--color-ivory);\n            opacity: 0.9;\n            margin-bottom: var(--spacing-xl);\n        }\n\n        .contact-details {\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-md);\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-md);\n        }\n\n        .contact-item-icon {\n            width: 50px;\n            height: 50px;\n            background: rgba(255, 255, 255, 0.1);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.3rem;\n        }\n\n        .contact-item-text h4 {\n            color: var(--color-ivory);\n            font-size: 1rem;\n            margin-bottom: 0.2rem;\n        }\n\n        .contact-item-text span {\n            color: var(--color-sage-light);\n            font-size: 0.9rem;\n        }\n\n        .contact-form {\n            background: var(--color-ivory);\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n        }\n\n        .contact-form h3 {\n            color: var(--color-emerald-deep);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-group label {\n            display: block;\n            font-weight: 500;\n            margin-bottom: 0.5rem;\n            color: var(--color-emerald-dark);\n        }\n\n        .form-group input,\n        .form-group select,\n        .form-group textarea {\n            width: 100%;\n            padding: 0.8rem 1rem;\n            border: 2px solid var(--color-sage);\n            border-radius: var(--radius-md);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: var(--transition-base);\n            background: var(--color-ivory);\n        }\n\n        .form-group input:focus,\n        .form-group select:focus,\n        .form-group textarea:focus {\n            outline: none;\n            border-color: var(--color-emerald);\n            background: white;\n        }\n\n        .form-group textarea {\n            resize: vertical;\n            min-height: 120px;\n        }\n\n        .submit-btn {\n            width: 100%;\n            padding: 1rem;\n            background: var(--gradient-emerald);\n            color: white;\n            border: none;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .submit-btn:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-gold);\n        }\n\n        /* Footer */\n        .footer {\n            padding: var(--spacing-xl) var(--spacing-lg);\n            background: var(--color-ink-deep);\n            color: var(--color-ivory);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            text-align: center;\n        }\n\n        .footer-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .footer-links {\n            display: flex;\n            justify-content: center;\n            gap: var(--spacing-lg);\n            margin-bottom: var(--spacing-md);\n            flex-wrap: wrap;\n        }\n\n        .footer-links a {\n            opacity: 0.8;\n            transition: var(--transition-base);\n        }\n\n        .footer-links a:hover {\n            opacity: 1;\n            color: var(--color-gold);\n        }\n\n        .footer-copy {\n            opacity: 0.6;\n            font-size: 0.9rem;\n        }\n\n        /* Responsive */\n        @media (max-width: 1024px) {\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-links, .nav-cta {\n                display: none;\n            }\n\n            .nav-menu-btn {\n                display: block;\n            }\n\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-ctas {\n                justify-content: center;\n            }\n\n            .hero-image {\n                order: -1;\n            }\n\n            .problem-solution-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .contact-grid {\n                grid-template-columns: 1fr;\n            }\n\n            h1 { font-size: clamp(2rem, 8vw, 3rem); }\n        }\n\n        /* Reduced Motion */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        /* WoW Animations */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.wow-animate {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-delay-1 { animation-delay: 0.1s; transition-delay: 0.1s; }\n        .wow-delay-2 { animation-delay: 0.2s; transition-delay: 0.2s; }\n        .wow-delay-3 { animation-delay: 0.3s; transition-delay: 0.3s; }\n        .wow-delay-4 { animation-delay: 0.4s; transition-delay: 0.4s; }\n        .wow-delay-5 { animation-delay: 0.5s; transition-delay: 0.5s; }\n        .wow-delay-6 { animation-delay: 0.6s; transition-delay: 0.6s; }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <div class=\"nav-logo\">Dra Juliana Bittencourt</div>\n            <ul class=\"nav-links\">\n                <li><a href=\"#home\">Início</a></li>\n                <li><a href=\"#services\">Serviços</a></li>\n                <li><a href=\"#testimonials\">Depoimentos</a></li>\n                <li><a href=\"#differentials\">Diferenciais</a></li>\n                <li><a href=\"#contact\">Contato</a></li>\n            </ul>\n            <a href=\"#contact\" class=\"nav-cta\">Agendar Consulta</a>\n            <button class=\"nav-menu-btn\" id=\"menuBtn\">☰</button>\n        </div>\n    </nav>\n\n    <!-- Mobile Menu -->\n    <div class=\"nav-mobile\" id=\"mobileMenu\">\n        <ul class=\"nav-mobile-links\">\n            <li><a href=\"#home\">Início</a></li>\n            <li><a href=\"#services\">Serviços</a></li>\n            <li><a href=\"#testimonials\">Depoimentos</a></li>\n            <li><a href=\"#differentials\">Diferenciais</a></li>\n            <li><a href=\"#contact\">Contato</a></li>\n        </ul>\n    </div>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-leaves\">\n            <div class=\"hero-leaf hero-leaf-1\"></div>\n            <div class=\"hero-leaf hero-leaf-2\"></div>\n            <div class=\"hero-leaf hero-leaf-3\"></div>\n            <div class=\"hero-leaf hero-leaf-4\"></div>\n        </div>\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <span class=\"hero-badge\">✨ Harmonização Facial em Ribeirão Preto</span>\n                <h1 class=\"hero-title\">Sua Beleza Natural <span>Realçada</span> com Excelência</h1>\n                <p class=\"hero-description\">Transforme sua aparência com tratamentos personalizados de harmonização facial. Resultados naturais e seguros com a Dra Juliana Bittencourt.</p>\n                <div class=\"hero-ctas\">\n                    <a href=\"#contact\" class=\"btn-primary\">Agendar Consulta →</a>\n                    <a href=\"#services\" class=\"btn-secondary\">Conhecer Serviços</a>\n                </div>\n            </div>\n            <div class=\"hero-image\">\n                <div class=\"hero-image-wrapper\">\n                    <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=600&h=700&fit=crop&crop=face\" alt=\"Dra Juliana Bittencourt - Harmonização Facial\">\n                </div>\n                <div class=\"hero-image-decoration\"></div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"problem-solution\">\n        <div class=\"problem-solution-container\">\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card wow-fade-up\">\n                    <h3>\n                        <span class=\"problem-icon\">😔</span>\n                        Seu Desafio\n                    </h3>\n                    <p>Sente que seu rosto perdeu luminosidade e vitalidade? Linhas de expressão, perda de volume e assimetrias faciais afetam sua autoestima? Você busca resultados naturais mas tem receio de procedimentos estéticos?</p>\n                </div>\n                <div class=\"solution-card wow-fade-up\">\n                    <h3>\n                        <span class=\"solution-icon\">✨</span>\n                        Nossa Solução\n                    </h3>\n                    <p>Harmonização facial personalizada com técnicas avançadas e produtos de alta qualidade. A Dra Juliana Bittencourt combina arte e ciência para realçar seus traços naturais, proporcionando resultados sutis e elegantes.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"services\" id=\"services\">\n        <div class=\"services-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-subtitle\">Tratamentos Especializados</span>\n                <h2 class=\"section-title\">Serviços que Transformam</h2>\n                <p class=\"section-description\">Procedimentos faciais personalizados para realçar sua beleza natural com resultados harmoniosos.</p>\n            </div>\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up wow-delay-1\">\n                    <div class=\"service-icon\">🎯</div>\n                    <h3>Harmonização Facial</h3>\n                    <p>Equilíbrio dos traços faciais com preenchedores e toxina botulínica para resultados naturais e harmoniosos.</p>\n                    <a href=\"#contact\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-fade-up wow-delay-2\">\n                    <div class=\"service-icon\">💉</div>\n                    <h3>Toxina Botulínica</h3>\n                    <p>Suavização de linhas de expressão com aplicação estratégica para resultado rejuvenescedor natural.</p>\n                    <a href=\"#contact\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-fade-up wow-delay-3\">\n                    <div class=\"service-icon\">✨</div>\n                    <h3>Preenchedores Faciais</h3>\n                    <p>Restauração de volume e contorno facial com ácido hialurônico de alta qualidade.</p>\n                    <a href=\"#contact\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-fade-up wow-delay-4\">\n                    <div class=\"service-icon\">💋</div>\n                    <h3>Preenchimento Labial</h3>\n                    <p>Realce e volume dos lábios com técnicas que proporcionam resultado natural e bonito.</p>\n                    <a href=\"#contact\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-fade-up wow-delay-5\">\n                    <div class=\"service-icon\">🔬</div>\n                    <h3>Bioestimuladores</h3>\n                    <p>Estímulo de colágeno para rejuvenescimento progressivo e duradouro da pele.</p>\n                    <a href=\"#contact\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-fade-up wow-delay-6\">\n                    <div class=\"service-icon\">💎</div>\n                    <h3>Protocolos Exclusivos</h3>\n                    <p>Combinações personalizadas de tratamentos para resultados únicos e excepcionais.</p>\n                    <a href=\"#contact\" class=\"service-link\">Saiba mais →</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"testimonials\" id=\"testimonials\">\n        <div class=\"testimonials-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-subtitle\">Depoimentos Reais</span>\n                <h2 class=\"section-title\">O Que Dizem Nossas Clientes</h2>\n                <p class=\"section-description\">Histórias de transformação e satisfação com nossos tratamentos.</p>\n            </div>\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up wow-delay-1\">\n                    <div class=\"testimonial-rating\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Excelente profissional! A Dra Juliana é super atenciosa e caprichosa. Fiz harmonização facial e o resultado ficou super natural. Recomendo de olhos fechados!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Maria Clara</h4>\n                            <span>Empresária</span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up wow-delay-2\">\n                    <div class=\"testimonial-rating\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Fiz preenchimento labial e ficou perfeito! Muito natural, exatamente como eu queria. A Dra tem mão leve e muito conhecimento técnico.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AS</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Ana Silva</h4>\n                            <span>Advogada</span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up wow-delay-3\">\n                    <div class=\"testimonial-rating\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Ambiente acolhedor e profissional muito preparada. Fiz botox e ficou super natural. Ninguém diz que fiz algo, só que estou com cara de descansada.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">PL</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Patricia Lima</h4>\n                            <span>Profissional Liberal</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"differentials\" id=\"differentials\">\n        <div class=\"differentials-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-subtitle\">Por Que Nos Escolher</span>\n                <h2 class=\"section-title\">Nossos Diferenciais</h2>\n                <p class=\"section-description\">Compromisso com qualidade, segurança e resultados excepcionais.</p>\n            </div>\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up wow-delay-1\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">🎨</div>\n                    </div>\n                    <h3>Resultados Naturais</h3>\n                    <p>Técnicas que realçam sua beleza sem exageros, preservando sua identidade.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-2\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">🔬</div>\n                    </div>\n                    <h3>Produtos Certificados</h3>\n                    <p>Utilização exclusiva de produtos originais e aprovados pela ANVISA.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-3\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">👩‍⚕️</div>\n                    </div>\n                    <h3>Atendimento Personalizado</h3>\n                    <p>Cada tratamento é único e desenvolvido especialmente para você.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-4\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">🏥</div>\n                    </div>\n                    <h3>Ambiente Seguro</h3>\n                    <p>Clínica equipada e seguindo rigorosamente as normas de biossegurança.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-5\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">📚</div>\n                    </div>\n                    <h3>Atualização Constante</h3>\n                    <p>Profissional sempre em busca das últimas técnicas do mercado.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-6\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">💚</div>\n                    </div>\n                    <h3>Acompanhamento</h3>\n                    <p>Suporte contínuo antes, durante e após os procedimentos.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"contact\" id=\"contact\">\n        <div class=\"contact-container\">\n            <div class=\"contact-grid\">\n                <div class=\"contact-info\">\n                    <h2>Agende Sua Consulta</h2>\n                    <p>Entre em contato para transformar sua aparência com tratamentos personalizados de harmonização facial em Ribeirão Preto.</p>\n                    <div class=\"contact-details\">\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">📍</div>\n                            <div class=\"contact-item-text\">\n                                <h4>Endereço</h4>\n                                <span>R. Triunfo, 1349 - Jardim Botânico, Ribeirão Preto - SP, 14021-612</span>\n                            </div>\n                        </div>\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">📱</div>\n                            <div class=\"contact-item-text\">\n                                <h4>WhatsApp</h4>\n                                <span>(16) 99725-2010</span>\n                            </div>\n                        </div>\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">⏰</div>\n                            <div class=\"contact-item-text\">\n                                <h4>Horário</h4>\n                                <span>Segunda a Sexta: 9h às 18h</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"contact-form\">\n                    <h3>Envie uma Mensagem</h3>\n                    <form id=\"whatsappForm\">\n                        <div class=\"form-group\">\n                            <label for=\"name\">Nome Completo</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" required placeholder=\"Seu nome\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"phone\">Telefone</label>\n                            <input type=\"tel\" id=\"phone\" name=\"phone\" required placeholder=\"(00) 00000-0000\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"service\">Tratamento de Interesse</label>\n                            <select id=\"service\" name=\"service\" required>\n                                <option value=\"\">Selecione uma opção</option>\n                                <option value=\"Harmonização Facial\">Harmonização Facial</option>\n                                <option value=\"Toxina Botulínica\">Toxina Botulínica</option>\n                                <option value=\"Preenchedores Faciais\">Preenchedores Faciais</option>\n                                <option value=\"Preenchimento Labial\">Preenchimento Labial</option>\n                                <option value=\"Bioestimuladores\">Bioestimuladores</option>\n                                <option value=\"Protocolos Exclusivos\">Protocolos Exclusivos</option>\n                                <option value=\"Outro\">Outro</option>\n                            </select>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"message\">Mensagem</label>\n                            <textarea id=\"message\" name=\"message\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                        </div>\n                        <button type=\"submit\" class=\"submit-btn\">Enviar via WhatsApp →</button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-logo\">Dra Juliana Bittencourt</div>\n            <div class=\"footer-links\">\n                <a href=\"#home\">Início</a>\n                <a href=\"#services\">Serviços</a>\n                <a href=\"#testimonials\">Depoimentos</a>\n                <a href=\"#differentials\">Diferenciais</a>\n                <a href=\"#contact\">Contato</a>\n            </div>\n            <p class=\"footer-copy\">© 2025 Dra Juliana Bittencourt - Harmonização Facial. Todos os direitos reservados.</p>\n        </div>\n    </footer>\n\n    <script>\n        // Navigation scroll effect\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                } else {\n                    nav.classList.remove('hidden');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Mobile menu toggle\n        const menuBtn = document.getElementById('menuBtn');\n        const mobileMenu = document.getElementById('mobileMenu');\n\n        menuBtn.addEventListener('click', () => {\n            mobileMenu.classList.toggle('active');\n        });\n\n        // Close mobile menu on link click\n        const mobileLinks = mobileMenu.querySelectorAll('a');\n        mobileLinks.forEach(link => {\n            link.addEventListener('click', () => {\n                mobileMenu.classList.remove('active');\n            });\n        });\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // Intersection Observer for animations\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('wow-animate');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        // Observe all wow elements\n        document.querySelectorAll('.wow-fade-up, .problem-card, .solution-card, .service-card, .testimonial-card, .differential-item, .section-header').forEach(el => {\n            observer.observe(el);\n        });\n\n        // WhatsApp form submission\n        const whatsappForm = document.getElementById('whatsappForm');\n        whatsappForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const whatsappNumber = '5516997252010';\n            const text = `Olá! Meu nome é ${name}.%0A%0ATelefone: ${phone}%0A%0ATratamento de interesse: ${service}%0A%0AMensagem: ${message || 'Gostaria de agendar uma consulta.'}`;\n\n            window.open(`https://wa.me/${whatsappNumber}?text=${text}`, '_blank');\n        });\n\n        // Check for reduced motion preference\n        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n        if (prefersReducedMotion.matches) {\n            document.querySelectorAll('.hero-leaf').forEach(leaf => {\n                leaf.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null}}
