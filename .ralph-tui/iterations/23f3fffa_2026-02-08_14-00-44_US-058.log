gap: 0.5rem;\n   866→        }\n   867→\n   868→        .form-group label {\n   869→            font-weight: 500;\n   870→            font-size: 0.9rem;\n   871→            color: var(--color-charcoal);\n   872→        }\n   873→\n   874→        .form-group input,\n   875→        .form-group select,\n   876→        .form-group textarea {\n   877→            padding: 0.875rem 1rem;\n   878→            border: 2px solid var(--color-opal-mid);\n   879→            border-radius: var(--radius-shard-2);\n   880→            font-family: var(--font-body);\n   881→            font-size: 1rem;\n   882→            background: var(--color-opal-white);\n   883→            transition: var(--transition-fast);\n   884→        }\n   885→\n   886→        .form-group input:focus,\n   887→        .form-group select:focus,\n   888→        .form-group textarea:focus {\n   889→            outline: none;\n   890→            border-color: var(--color-dusty-rose);\n   891→            box-shadow: 0 0 0 3px rgba(201, 168, 168, 0.1);\n   892→        }\n   893→\n   894→        .form-group textarea {\n   895→            min-height: 120px;\n   896→            resize: vertical;\n   897→        }\n   898→\n   899→        .submit-btn {\n   900→            padding: 1rem 2rem;\n   901→            background: var(--color-dusty-rose);\n   902→            color: var(--color-text-light);\n   903→            font-weight: 600;\n   904→            font-size: 1rem;\n   905→            border: none;\n   906→            border-radius: var(--radius-shard-1);\n   907→            cursor: pointer;\n   908→            transition: var(--transition-fast);\n   909→            display: flex;\n   910→            align-items: center;\n   911→            justify-content: center;\n   912→            gap: 0.5rem;\n   913→        }\n   914→\n   915→        .submit-btn:hover {\n   916→            background: var(--color-dusty-rose-dark);\n   917→            transform: translateY(-2px);\n   918→            box-shadow: var(--shad