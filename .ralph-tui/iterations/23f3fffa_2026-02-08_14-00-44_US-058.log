9909613654-28e377c37b09?w=800&q=80\" alt=\"Harmonização Facial - Dra. Karen Veronese\" loading=\"lazy\">\n  1165→                    <div class=\"hero-image-decoration\"></div>\n  1166→                </div>\n  1167→            </div>\n  1168→        </div>\n  1169→    </section>\n  1170→\n  1171→    <!-- Problem/Solution Section -->\n  1172→    <section class=\"section problem-solution\">\n  1173→        <div class=\"section-container\">\n  1174→            <div class=\"section-header wow-fade-up\">\n  1175→                <span class=\"section-tag\">Transformação Real</span>\n  1176→                <h2 class=\"section-title\">Sua beleza merece destaque</h2>\n  1177→                <p class=\"section-description\">Compreendemos suas necessidades e oferecemos soluções estéticas avançadas com resultados naturais.</p>\n  1178→            </div>\n  1179→            <div class=\"problem-solution-grid\">\n  1180→                <div class=\"problem-card wow-fade-up\" data-delay=\"0\">\n  1181→                    <div class=\"card-icon\">\n  1182→                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1183→                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n  1184→                            <path d=\"M8 14s1.5 2 4 2 4-2 4-2\"/>\n  1185→                            <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"/>\n  1186→                            <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"/>\n  1187→                        </svg>\n  1188→                    </div>\n  1189→                    <h3>O Desafio</h3>\n  1190→                    <p>O passar dos anos, o estresse e os fatores ambientais podem deixar marcas no seu rosto, afetando sua autoestima e confiança.</p>\n  1191→                </div>\n  1192→                <div class=\"solution-card wow-fade-up\" data-delay=\"200\">\n  1193→                    <div class=\"card-icon\">\n  1194→                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1195→                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n  1196→                        </svg>\n  1197→                    </div>\n  1198→                    <h3>A Solução</h3>\n  1199→                    <p>Tratamentos personalizados de harmonização facial que realçam seus traços naturais, proporcionando uma aparência rejuvenescida e harmônica.</p>\n  1200→                </div>\n  1201→            </div>\n  1202→        </div>\n  1203→    </section>\n  1204→\n  1205→    <!-- Services Section -->\n  1206→    <section class=\"section services\" id=\"servicos\">\n  1207→        <div class=\"section-container\">\n  1208→            <div class=\"section-header wow-fade-up\">\n  1209→                <span class=\"section-tag\">Tratamentos Exclusivos</span>\n  1210→                <h2 class=\"section-title\">Procedimentos especializados</h2>\n  1211→                <p class=\"section-description\">Oferecemos uma gama completa de tratamentos estéticos faciais com técnicas avançadas e produtos de alta qualidade.</p>\n  1212→            </div>\n  1213→            <div class=\"services-grid\">\n  1214→                <div class=\"service-card wow-fade-up\" data-delay=\"0\">\n  1215→                    <div class=\"service-icon\">\n  1216→                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1217→                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n  1218→                        </svg>\n  1219→                    </div>\n  1220→                    <h3>Harmonização Facial</h3>\n  1221→                    <p>Equilíbrio e proporção do rosto através de preenchedores e toxina botulínica para resultados naturais e harmônicos.</p>\n  1222→                    <a href=\"#contato\" class=\"service-link\">\n  1223→                        Saiba mais\n  1224→                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1225→                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n  1226→                        </svg>\n  1227→                    </a>\n  1228→                </div>\n  1229→                <div class=\"service-card wow-fade-up\" data-delay=\"100\">\n  1230→                    <div class=\"service-icon\">\n  1231→                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1232→                            <path d=\"M9 12h6M12 9v6M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0z\"/>\n  1233→                        </svg>\n  1234→                    </div>\n  1235→                    <h3>Toxina Botulínica</h3>\n  1236→                    <p>Suavização de linhas de expressão e prevenção de rugas com aplicações precisas e resultados naturais.</p>\n  1237→                    <a href=\"#contato\" class=\"service-link\">\n  1238→                        Saiba mais\n  1239→                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1240→                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n  1241→                        </svg>\n  1242→                    </a>\n  1243→                </div>\n  1244→                <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n  1245→                    <div class=\"service-icon\">\n  1246→                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1247→                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n  1248→                        </svg>\n  1249→                    </div>\n  1250→                    <h3>Preenchedores Faciais</h3>\n  1251→                    <p>Restauração de volume, contorno facial e preenchimento de sulcos com ácido hialurônico de alta qualidade.</p>\n  1252→                    <a href=\"#contato\" class=\"service-link\">\n  1253→                        Saiba mais\n  1254→                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1255→                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n  1256→                        </svg>\n  1257→                    </a>\n  1258→                </div>\n  1259→                <div class=\"service-card wow-fade-up\" data-delay=\"300\">\n  1260→                    <div class=\"service-icon\">\n  1261→                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1262→                            <path d=\"M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z\"/>\n  1263→                        </svg>\n  1264→                    </div>\n  1265→                    <h3>Preenchimento Labial</h3>\n  1266→                    <p>Realce e volume para os lábios com contorno definido e hidratação profunda, mantendo a naturalidade.</p>\n  1267→                    <a href=\"#contato\" class=\"service-link\">\n  1268→                        Saiba mais\n  1269→                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1270→                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n  1271→                        </svg>\n  1272→                    </a>\n  1273→                </div>\n  1274→                <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n  1275→                    <div class=\"service-icon\">\n  1276→                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1277→                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n  1278→                        </svg>\n  1279→                    </div>\n  1280→                    <h3>Bioestimuladores</h3>\n  1281→                    <p>Estímulo de colágeno para firmeza e elasticidade da pele, revertendo os sinais de envelhecimento.</p>\n  1282→                    <a href=\"#contato\" class=\"service-link\">\n  1283→                        Saiba mais\n  1284→                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1285→                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n  1286→                        </svg>\n  1287→                    </a>\n  1288→                </div>\n  1289→                <div class=\"service-card wow-fade-up\" data-delay=\"500\">\n  1290→                    <div class=\"service-icon\">\n  1291→                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1292→                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n  1293→                        </svg>\n  1294→                    </div>\n  1295→                    <h3>Protocolos Exclusivos</h3>\n  1296→                    <p>Tratamentos personalizados combinando técnicas avançadas para resultados únicos e naturais.</p>\n  1297→                    <a href=\"#contato\" class=\"service-link\">\n  1298→                        Saiba mais\n  1299→                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1300→                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n  1301→                        </svg>\n  1302→                    </a>\n  1303→                </div>\n  1304→            </div>\n  1305→        </div>\n  1306→    </section>\n  1307→\n  1308→    <!-- Testimonials Section -->\n  1309→    <section class=\"section testimonials\" id=\"depoimentos\">\n  1310→        <div class=\"section-container\">\n  1311→            <div class=\"section-header wow-fade-up\">\n  1312→                <span class=\"section-tag\">Depoimentos</span>\n  1313→                <h2 class=\"section-title\">O que nossas pacientes dizem</h2>\n  1314→                <p class=\"section-description\">Histórias reais de transformação e satisfação com nossos tratamentos.</p>\n  1315→            </div>\n  1316→            <div class=\"testimonials-grid\">\n  1317→                <div class=\"testimonial-card wow-fade-up\" data-delay=\"0\">\n  1318→                    <div class=\"testimonial-stars\">★★★★★</div>\n  1319→                    <p class=\"testimonial-text\">\"A Dra. Karen é extraordinária! Fiz minha harmonização facial e o resultado superou todas as minhas expectativas. Muito natural e elegante.\"</p>\n  1320→                    <div class=\"testimonial-author\">\n  1321→                        <div class=\"testimonial-avatar\">MC</div>\n  1322→                        <div>\n  1323→                            <p class=\"testimonial-name\">Marina Costa</p>\n  1324→                            <p class=\"testimonial-role\">Empresária</p>\n  1325→                        </div>\n  1326→                    </div>\n  1327→                </div>\n  1328→                <div class=\"testimonial-card wow-fade-up\" data-delay=\"200\">\n  1329→                    <div class=\"testimonial-stars\">★★★★★</div>\n  1330→                    <p class=\"testimonial-text\">\"Finalmente encontrei uma profissional que entende o que quero. O preenchimento labial ficou perfeito, muito natural e duradouro.\"</p>\n  1331→                    <div class=\"testimonial-author\">\n  1332→                        <div class=\"testimonial-avatar\">AL</div>\n  1333→                        <div>\n  1334→                            <p class=\"testimonial-name\">Ana Luiza</p>\n  1335→                            <p class=\"testimonial-role\">Advogada</p>\n  1336→                        </div>\n  1337→                    </div>\n  1338→                </div>\n  1339→                <div class=\"testimonial-card wow-fade-up\" data-delay=\"400\">\n  1340→                    <div class=\"testimonial-stars\">★★★★★</div>\n  1341→                    <p class=\"testimonial-text\">\"A toxina botulínica aplicada pela Dra. Karen foi impecável. Resultados naturais e o atendimento é excepcional. Super recomendo!\"</p>\n  1342→                    <div class=\"testimonial-author\">\n  1343→                        <div class=\"testimonial-avatar\">PS</div>\n  1344→                        <div>\n  1345→                            <p class=\"testimonial-name\">Patrícia Silva</p>\n  1346→                            <p class=\"testimonial-role\">Professora</p>\n  1347→                        </div>\n  1348→                    </div>\n  1349→                </div>\n  1350→            </div>\n  1351→        </div>\n  1352→    </section>\n  1353→\n  1354→    <!-- Differentials Section -->\n  1355→    <section class=\"section differentials\" id=\"diferenciais\">\n  1356→        <div class=\"section-container\">\n  1357→            <div class=\"section-header wow-fade-up\">\n  1358→                <span class=\"section-tag\">Por que nos escolher</span>\n  1359→                <h2 class=\"section-title\">Diferenciais exclusivos</h2>\n  1360→                <p class=\"section-description\">Compromisso com a excelência e resultados que transformam vidas.</p>\n  1361→            </div>\n  1362→            <div class=\"differentials-grid\">\n  1363→                <div class=\"differential-item wow-fade-up\" data-delay=\"0\">\n  1364→                    <div class=\"differential-icon\">\n  1365→                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1366→                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n  1367→                        </svg>\n  1368→                    </div>\n  1369→                    <div class=\"differential-content\">\n  1370→                        <h3>Resultados Naturais</h3>\n  1371→                        <p>Técnicas que realçam sua beleza sem transformar sua expressão.</p>\n  1372→                    </div>\n  1373→                </div>\n  1374→                <div class=\"differential-item wow-fade-up\" data-delay=\"100\">\n  1375→                    <div class=\"differential-icon\">\n  1376→                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1377→                            <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/>\n  1378→                        </svg>\n  1379→                    </div>\n  1380→                    <div class=\"differential-content\">\n  1381→                        <h3>Atendimento Personalizado</h3>\n  1382→                        <p>Cada tratamento é desenvolvido exclusivamente para você.</p>\n  1383→                    </div>\n  1384→                </div>\n  1385→                <div class=\"differential-item wow-fade-up\" data-delay=\"200\">\n  1386→                    <div class=\"differential-icon\">\n  1387→                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1388→                            <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/>\n  1389→                            <polyline points=\"22 4 12 14.01 9 11.01\"/>\n  1390→                        </svg>\n  1391→                    </div>\n  1392→                    <div class=\"differential-content\">\n  1393→                        <h3>Produtos Certificados</h3>\n  1394→                        <p>Utilizamos apenas produtos de origem comprovada e alta qualidade.</p>\n  1395→                    </div>\n  1396→                </div>\n  1397→                <div class=\"differential-item wow-fade-up\" data-delay=\"300\">\n  1398→                    <div class=\"differential-icon\">\n  1399→                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1400→                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n  1401→                        </svg>\n  1402→                    </div>\n  1403→                    <div class=\"differential-content\">\n  1404→                        <h3>Técnica Avançada</h3>\n  1405→                        <p>Procedimentos realizados com as mais modernas técnicas.</p>\n  1406→                    </div>\n  1407→                </div>\n  1408→                <div class=\"differential-item wow-fade-up\" data-delay=\"400\">\n  1409→                    <div class=\"differential-icon\">\n  1410→                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1411→                            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n  1412→                        </svg>\n  1413→                    </div>\n  1414→                    <div class=\"differential-content\">\n  1415→                        <h3>Segurança Total</h3>\n  1416→                        <p>Procedimentos realizados em ambiente estéril e seguro.</p>\n  1417→                    </div>\n  1418→                </div>\n  1419→                <div class=\"differential-item wow-fade-up\" data-delay=\"500\">\n  1420→                    <div class=\"differential-icon\">\n  1421→                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1422→                            <path d=\"M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9\"/>\n  1423→                            <path d=\"M13.73 21a2 2 0 0 1-3.46 0\"/>\n  1424→                        </svg>\n  1425→                    </div>\n  1426→                    <div class=\"differential-content\">\n  1427→                        <h3>Acompanhamento</h3>\n  1428→                        <p>Suporte contínuo antes e depois dos procedimentos.</p>\n  1429→                    </div>\n  1430→                </div>\n  1431→            </div>\n  1432→        </div>\n  1433→    </section>\n  1434→\n  1435→    <!-- Contact Section -->\n  1436→    <section class=\"section contact\" id=\"contato\">\n  1437→        <div class=\"section-container\">\n  1438→            <div class=\"section-header wow-fade-up\">\n  1439→                <span class=\"section-tag\">Entre em Contato</span>\n  1440→                <h2 class=\"section-title\">Agende sua consulta</h2>\n  1441→                <p class=\"section-description\">Dê o primeiro passo em direção à sua transformação. Entre em contato para agendar sua avaliação.</p>\n  1442→            </div>\n  1443→            <div class=\"contact-wrapper\">\n  1444→                <div class=\"contact-info wow-fade-up\" data-delay=\"0\">\n  1445→                    <div class=\"contact-info-item\">\n  1446→                        <div class=\"contact-icon\">\n  1447→                            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1448→                                <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/>\n  1449→                                <circle cx=\"12\" cy=\"10\" r=\"3\"/>\n  1450→                            </svg>\n  1451→                        </div>\n  1452→                        <div class=\"contact-details\">\n  1453→                            <h4>Endereço</h4>\n  1454→                            <p>Rua Milton José Robusti, 75 - sala 103<br>Jardim Botânico, Ribeirão Preto - SP<br>CEP: 14021-613</p>\n  1455→                        </div>\n  1456→                    </div>\n  1457→                    <div class=\"contact-info-item\">\n  1458→                        <div class=\"contact-icon\">\n  1459→                            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1460→                                <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"/>\n  1461→                            </svg>\n  1462→                        </div>\n  1463→                        <div class=\"contact-details\">\n  1464→                            <h4>Telefone / WhatsApp</h4>\n  1465→                            <p>(16) 99153-9505</p>\n  1466→                        </div>\n  1467→                    </div>\n  1468→                    <div class=\"contact-info-item\">\n  1469→                        <div class=\"contact-icon\">\n  1470→                            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1471→                                <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n  1472→                            </svg>\n  1473→                        </div>\n  1474→                        <div class=\"contact-details\">\n  1475→                            <h4>Horário de Atendimento</h4>\n  1476→                            <p>Segunda a Sexta: 9h às 18h<br>Sábados: 9h às 13h</p>\n  1477→                        </div>\n  1478→                    </div>\n  1479→                </div>\n  1480→                <div class=\"contact-form-wrapper wow-fade-up\" data-delay=\"200\">\n  1481→                    <form class=\"contact-form\" id=\"contactForm\">\n  1482→                        <div class=\"form-group\">\n  1483→                            <label for=\"name\">Nome completo</label>\n  1484→                            <input type=\"text\" id=\"name\" name=\"name\" placeholder=\"Seu nome\" required>\n  1485→                        </div>\n  1486→                        <div class=\"form-group\">\n  1487→                            <label for=\"phone\">Telefone / WhatsApp</label>\n  1488→                            <input type=\"tel\" id=\"phone\" name=\"phone\" placeholder=\"(00) 00000-0000\" required>\n  1489→                        </div>\n  1490→                        <div class=\"form-group\">\n  1491→                            <label for=\"service\">Tratamento de interesse</label>\n  1492→                            <select id=\"service\" name=\"service\" required>\n  1493→                                <option value=\"\">Selecione uma opção</option>\n  1494→                                <option value=\"Harmonização Facial\">Harmonização Facial</option>\n  1495→                                <option value=\"Toxina Botulínica\">Toxina Botulínica</option>\n  1496→                                <option value=\"Preenchedores Faciais\">Preenchedores Faciais</option>\n  1497→                                <option value=\"Preenchimento Labial\">Preenchimento Labial</option>\n  1498→                                <option value=\"Bioestimuladores\">Bioestimuladores</option>\n  1499→                                <option value=\"Protocolos Exclusivos\">Protocolos Exclusivos</option>\n  1500→                                <option value=\"Avaliação Geral\">Avaliação Geral</option>\n  1501→                            </select>\n  1502→                        </div>\n  1503→                        <div class=\"form-group\">\n  1504→                            <label for=\"message\">Mensagem</label>\n  1505→                            <textarea id=\"message\" name=\"message\" placeholder=\"Conte-nos sobre suas expectativas...\" required></textarea>\n  1506→                        </div>\n  1507→                        <button type=\"submit\" class=\"submit-btn\">\n  1508→                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1509→                                <path d=\"M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z\"/>\n  1510→                            </svg>\n  1511→                            Enviar Mensagem\n  1512→                        </button>\n  1513→                    </form>\n  1514→                </div>\n  1515→            </div>\n  1516→        </div>\n  1517→    </section>\n  1518→\n  1519→    <!-- Footer -->\n  1520→    <footer class=\"footer\">\n  1521→        <div class=\"footer-container\">\n  1522→            <div class=\"footer-content\">\n  1523→                <div class=\"footer-brand\">\n  1524→                    <h3>Dra. Karen Veronese</h3>\n  1525→                    <p>Harmonização Facial e Estética Avançada em Ribeirão Preto. Transforme sua aparência com tratamentos personalizados e resultados naturais.</p>\n  1526→                </div>\n  1527→                <div class=\"footer-links\">\n  1528→                    <h4>Links Rápidos</h4>\n  1529→                    <ul>\n  1530→                        <li><a href=\"#inicio\">Início</a></li>\n  1531→                        <li><a href=\"#servicos\">Serviços</a></li>\n  1532→                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n  1533→                        <li><a href=\"#diferenciais\">Diferenciais</a></li>\n  1534→                        <li><a href=\"#contato\">Contato</a></li>\n  1535→                    </ul>\n  1536→                </div>\n  1537→                <div class=\"footer-contact\">\n  1538→                    <h4>Contato</h4>\n  1539→                    <p>(16) 99153-9505</p>\n  1540→                    <p>Rua Milton José Robusti, 75 - sala 103</p>\n  1541→                    <p>Jardim Botânico, Ribeirão Preto - SP</p>\n  1542→                </div>\n  1543→            </div>\n  1544→            <div class=\"footer-bottom\">\n  1545→                <p>&copy; 2025 Dra. Karen Veronese. Todos os direitos reservados. | Harmonização Facial em Ribeirão Preto</p>\n  1546→            </div>\n  1547→        </div>\n  1548→    </footer>\n  1549→\n  1550→    <script>\n  1551→        // ============================================\n  1552→        // NAVIGATION\n  1553→        // ============================================\n  1554→        const nav = document.getElementById('nav');\n  1555→        const navToggle = document.getElementById('navToggle');\n  1556→        const navMenu = document.getElementById('navMenu');\n  1557→        let lastScroll = 0;\n  1558→\n  1559→        // Auto-hide navigation on scroll\n  1560→        window.addEventListener('scroll', () => {\n  1561→            const currentScroll = window.pageYOffset;\n  1562→\n  1563→            if (currentScroll > 100) {\n  1564→                if (currentScroll > lastScroll) {\n  1565→                    nav.classList.add('hidden');\n  1566→                } else {\n  1567→                    nav.classList.remove('hidden');\n  1568→                }\n  1569→            }\n  1570→\n  1571→            lastScroll = currentScroll;\n  1572→        });\n  1573→\n  1574→        // Mobile menu toggle\n  1575→        navToggle.addEventListener('click', () => {\n  1576→            navMenu.classList.toggle('active');\n  1577→        });\n  1578→\n  1579→        // Close mobile menu on link click\n  1580→        document.querySelectorAll('.nav-link').forEach(link => {\n  1581→            link.addEventListener('click', () => {\n  1582→                navMenu.classList.remove('active');\n  1583→            });\n  1584→        });\n  1585→\n  1586→        // ============================================\n  1587→        // SMOOTH SCROLL\n  1588→        // ============================================\n  1589→        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n  1590→            anchor.addEventListener('click', function(e) {\n  1591→                e.preventDefault();\n  1592→                const target = document.querySelector(this.getAttribute('href'));\n  1593→                if (target) {\n  1594→                    const navHeight = nav.offsetHeight;\n  1595→                    const targetPosition = target.offsetTop - navHeight;\n  1596→                    window.scrollTo({\n  1597→                        top: targetPosition,\n  1598→                        behavior: 'smooth'\n  1599→                    });\n  1600→                }\n  1601→            });\n  1602→        });\n  1603→\n  1604→        // ============================================\n  1605→        // INTERSECTION OBSERVER ANIMATIONS\n  1606→        // ============================================\n  1607→        const observerOptions = {\n  1608→            threshold: 0.1,\n  1609→            rootMargin: '0px 0px -50px 0px'\n  1610→        };\n  1611→\n  1612→        const observer = new IntersectionObserver((entries) => {\n  1613→            entries.forEach(entry => {\n  1614→                if (entry.isIntersecting) {\n  1615→                    const delay = entry.target.dataset.delay || 0;\n  1616→                    setTimeout(() => {\n  1617→                        entry.target.classList.add('visible');\n  1618→                    }, delay);\n  1619→                    observer.unobserve(entry.target);\n  1620→                }\n  1621→            });\n  1622→        }, observerOptions);\n  1623→\n  1624→        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n  1625→            observer.observe(el);\n  1626→        });\n  1627→\n  1628→        // ============================================\n  1629→        // PARALLAX EFFECT ON BLOBS\n  1630→        // ============================================\n  1631→        const blobs = document.querySelectorAll('.blob');\n  1632→\n  1633→        document.addEventListener('mousemove', (e) => {\n  1634→            const mouseX = e.clientX / window.innerWidth - 0.5;\n  1635→            const mouseY = e.clientY / window.innerHeight - 0.5;\n  1636→\n  1637→            blobs.forEach((blob, index) => {\n  1638→                const speed = (index + 1) * 20;\n  1639→                const x = mouseX * speed;\n  1640→                const y = mouseY * speed;\n  1641→                blob.style.transform = `translate(${x}px, ${y}px)`;\n  1642→            });\n  1643→        });\n  1644→\n  1645→        // ============================================\n  1646→        // FORM SUBMISSION TO WHATSAPP\n  1647→        // ============================================\n  1648→        const contactForm = document.getElementById('contactForm');\n  1649→\n  1650→        contactForm.addEventListener('submit', (e) => {\n  1651→            e.preventDefault();\n  1652→\n  1653→            const name = document.getElementById('name').value;\n  1654→            const phone = document.getElementById('phone').value;\n  1655→            const service = document.getElementById('service').value;\n  1656→            const message = document.getElementById('message').value;\n  1657→\n  1658→            const whatsappNumber = '5516991539505';\n  1659→            const text = `Olá, me chamo ${name}!\\n\\nTelefone: ${phone}\\nTratamento de interesse: ${service}\\n\\nMensagem: ${message}`;\n  1660→\n  1661→            const whatsappURL = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;\n  1662→            window.open(whatsappURL, '_blank');\n  1663→        });\n  1664→\n  1665→        // ============================================\n  1666→        // HOVER EFFECTS ON SERVICE CARDS\n  1667→        // ============================================\n  1668→        const serviceCards = document.querySelectorAll('.service-card');\n  1669→\n  1670→        serviceCards.forEach(card => {\n  1671→            card.addEventListener('mouseenter', function() {\n  1672→                this.style.transform = 'translateY(-8px) scale(1.02)';\n  1673→            });\n  1674→\n  1675→            card.addEventListener('mouseleave', function() {\n  1676→                this.style.transform = 'translateY(0) scale(1)';\n  1677→            });\n  1678→        });\n  1679→\n  1680→        // ============================================\n  1681→        // ACCESSIBILITY - REDUCED MOTION\n  1682→        // ============================================\n  1683→        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n  1684→            document.querySelectorAll('.blob').forEach(blob => {\n  1685→                blob.style.animation = 'none';\n  1686→            });\n  1687→        }\n  1688→    </script>\n  1689→</body>\n  1690→</html>\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"f8012cbd-3ec1-4d07-9162-269868ea5435","uuid":"9c9428fe-9b0d-4b9f-bc68-06f5745c053e","tool_use_result":{"type":"text","file":{"filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-karen-veronese/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Karen Veronese | Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Karen Veronese - Harmonização Facial e Estética Avançada em Ribeirão Preto. Transforme sua aparência com tratamentos faciais personalizados e resultados naturais.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Libre+Baskerville:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        /* ============================================\n           CSS RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        :root {\n            /* Opal & Dusty Rose Noir Palette */\n            --color-opal-white: #F8F6F4;\n            --color-opal-light: #E8E4E0;\n            --color-opal-mid: #D8D4D0;\n            --color-opal-warm: #C8C4BC;\n\n            --color-dusty-rose: #C9A8A8;\n            --color-dusty-rose-light: #D9B8B8;\n            --color-dusty-rose-dark: #A88888;\n            --color-dusty-rose-deep: #886868;\n\n            --color-charcoal: #2A2A2A;\n            --color-charcoal-dark: #1A1A1A;\n            --color-charcoal-light: #3A3A3A;\n\n            --color-text-dark: #1A1A1A;\n            --color-text-muted: #6A6A6A;\n            --color-text-light: #F8F6F4;\n\n            /* Gradients */\n            --gradient-opal: linear-gradient(135deg, #F8F6F4 0%, #E8E4E0 50%, #D8D4D0 100%);\n            --gradient-rose: linear-gradient(135deg, #C9A8A8 0%, #A88888 100%);\n            --gradient-shimmer: linear-gradient(90deg, transparent, rgba(201, 168, 168, 0.3), transparent);\n\n            /* Typography */\n            --font-display: 'Libre Baskerville', Georgia, serif;\n            --font-body: 'Inter', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Border Radius - Opal Shard Shapes */\n            --radius-shard-1: 72% 28% 48% 52% / 52% 38% 62% 48%;\n            --radius-shard-2: 48% 52% 68% 32% / 38% 62% 38% 62%;\n            --radius-shard-3: 62% 38% 42% 58% / 58% 42% 52% 48%;\n            --radius-shard-4: 38% 62% 52% 48% / 42% 58% 48% 52%;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(42, 42, 42, 0.08);\n            --shadow-md: 0 8px 24px rgba(42, 42, 42, 0.12);\n            --shadow-lg: 0 16px 48px rgba(42, 42, 42, 0.16);\n            --shadow-rose: 0 8px 32px rgba(201, 168, 168, 0.3);\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.6;\n            color: var(--color-text-dark);\n            background-color: var(--color-opal-white);\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 700;\n            line-height: 1.2;\n            color: var(--color-charcoal);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        h1 { font-size: clamp(2.5rem, 6vw, 4rem); }\n        h2 { font-size: clamp(2rem, 4vw, 3rem); }\n        h3 { font-size: clamp(1.25rem, 2.5vw, 1.75rem); }\n\n        p {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-muted);\n        }\n\n        a {\n            color: inherit;\n            text-decoration: none;\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-sm) var(--spacing-md);\n            background: rgba(248, 246, 244, 0.95);\n            backdrop-filter: blur(10px);\n            transition: transform 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.25rem;\n            font-weight: 700;\n            color: var(--color-charcoal);\n        }\n\n        .nav-logo span {\n            color: var(--color-dusty-rose);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-muted);\n            position: relative;\n            padding: 0.5rem 0;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-dusty-rose);\n            transition: width var(--transition-base);\n        }\n\n        .nav-link:hover {\n            color: var(--color-charcoal);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--color-dusty-rose);\n            color: var(--color-text-light) !important;\n            padding: 0.75rem 1.5rem;\n            border-radius: var(--radius-shard-1);\n            transition: var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            background: var(--color-dusty-rose-dark);\n            transform: translateY(-2px);\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        /* Mobile Menu */\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 6px;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav-toggle span {\n            width: 24px;\n            height: 2px;\n            background: var(--color-charcoal);\n            transition: var(--transition-fast);\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                right: 0;\n                flex-direction: column;\n                background: var(--color-opal-white);\n                padding: var(--spacing-md);\n                gap: var(--spacing-sm);\n                transform: translateX(100%);\n                transition: transform var(--transition-base);\n            }\n\n            .nav-menu.active {\n                transform: translateX(0);\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            position: relative;\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            padding: calc(var(--spacing-xl) + var(--spacing-md)) var(--spacing-md) var(--spacing-xl);\n            overflow: hidden;\n        }\n\n        .hero-blobs {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            overflow: hidden;\n            z-index: 0;\n        }\n\n        .blob {\n            position: absolute;\n            opacity: 0.15;\n            filter: blur(60px);\n            animation: blobFloat 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-rose);\n            top: -100px;\n            right: -100px;\n            border-radius: var(--radius-shard-1);\n            animation-delay: 0s;\n        }\n\n        .blob-2 {\n            width: 400px;\n            height: 400px;\n            background: linear-gradient(135deg, #D8D4D0 0%, #C8C4BC 100%);\n            bottom: -50px;\n            left: -50px;\n            border-radius: var(--radius-shard-2);\n            animation-delay: -5s;\n        }\n\n        .blob-3 {\n            width: 300px;\n            height: 300px;\n            background: var(--gradient-opal);\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            border-radius: var(--radius-shard-3);\n            animation-delay: -10s;\n        }\n\n        .blob-4 {\n            width: 250px;\n            height: 250px;\n            background: linear-gradient(135deg, #D9B8B8 0%, #B89898 100%);\n            bottom: 20%;\n            right: 10%;\n            border-radius: var(--radius-shard-4);\n            animation-delay: -15s;\n            opacity: 0.1;\n        }\n\n        @keyframes blobFloat {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg) scale(1.05);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg) scale(0.95);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(3deg) scale(1.02);\n            }\n        }\n\n        .hero-container {\n            position: relative;\n            z-index: 1;\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n            align-items: center;\n        }\n\n        .hero-content {\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease forwards;\n        }\n\n        .hero-tag {\n            display: inline-block;\n            padding: 0.5rem 1rem;\n            background: var(--color-dusty-rose-light);\n            color: var(--color-dusty-rose-deep);\n            font-size: 0.85rem;\n            font-weight: 600;\n            border-radius: var(--radius-shard-1);\n            margin-bottom: var(--spacing-sm);\n            animation-delay: 0ms !important;\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-sm);\n            animation-delay: 200ms !important;\n            opacity: 0;\n            animation: fadeInUp 0.8s ease 0.2s forwards;\n        }\n\n        .hero-title span {\n            color: var(--color-dusty-rose);\n        }\n\n        .hero-description {\n            font-size: 1.125rem;\n            margin-bottom: var(--spacing-md);\n            max-width: 500px;\n            animation-delay: 400ms !important;\n            opacity: 0;\n            animation: fadeInUp 0.8s ease 0.4s forwards;\n        }\n\n        .hero-cta {\n            display: flex;\n            gap: var(--spacing-sm);\n            flex-wrap: wrap;\n            animation-delay: 600ms !important;\n            opacity: 0;\n            animation: fadeInUp 0.8s ease 0.6s forwards;\n        }\n\n        .btn-primary {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            background: var(--color-dusty-rose);\n            color: var(--color-text-light);\n            font-weight: 600;\n            font-size: 1rem;\n            border-radius: var(--radius-shard-1);\n            transition: var(--transition-fast);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .btn-primary:hover {\n            background: var(--color-dusty-rose-dark);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-rose);\n        }\n\n        .btn-primary::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: -100%;\n            width: 100%;\n            height: 100%;\n            background: var(--gradient-shimmer);\n            transition: left 0.6s ease;\n        }\n\n        .btn-primary:hover::before {\n            left: 100%;\n        }\n\n        .btn-secondary {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            background: transparent;\n            color: var(--color-charcoal);\n            font-weight: 600;\n            font-size: 1rem;\n            border: 2px solid var(--color-opal-mid);\n            border-radius: var(--radius-shard-2);\n            transition: var(--transition-fast);\n        }\n\n        .btn-secondary:hover {\n            border-color: var(--color-dusty-rose);\n            color: var(--color-dusty-rose);\n        }\n\n        .hero-image {\n            position: relative;\n            opacity: 0;\n            transform: translateX(30px);\n            animation: fadeInRight 0.8s ease 0.4s forwards;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            border-radius: var(--radius-shard-1);\n            overflow: hidden;\n            box-shadow: var(--shadow-lg);\n        }\n\n        .hero-image-wrapper img {\n            width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        .hero-image-decoration {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            top: 0;\n            left: 0;\n            background: linear-gradient(135deg, rgba(201, 168, 168, 0.1) 0%, transparent 50%);\n            pointer-events: none;\n        }\n\n        @keyframes fadeInUp {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fadeInRight {\n            to {\n                opacity: 1;\n                transform: translateX(0);\n            }\n        }\n\n        /* ============================================\n           SECTIONS COMMON\n           ============================================ */\n        .section {\n            padding: var(--spacing-xl) var(--spacing-md);\n            position: relative;\n        }\n\n        .section-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .section-tag {\n            display: inline-block;\n            padding: 0.5rem 1rem;\n            background: var(--color-dusty-rose-light);\n            color: var(--color-dusty-rose-deep);\n            font-size: 0.85rem;\n            font-weight: 600;\n            border-radius: var(--radius-shard-1);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .section-title {\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .section-description {\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            background: var(--color-opal-light);\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .problem-card, .solution-card {\n            padding: var(--spacing-md);\n            border-radius: var(--radius-shard-1);\n            transition: var(--transition-base);\n        }\n\n        .problem-card {\n            background: var(--color-opal-white);\n            border-left: 4px solid var(--color-dusty-rose-dark);\n        }\n\n        .solution-card {\n            background: linear-gradient(135deg, var(--color-dusty-rose-light) 0%, var(--color-opal-white) 100%);\n            border-left: 4px solid var(--color-dusty-rose);\n        }\n\n        .problem-card:hover, .solution-card:hover {\n            transform: translateY(-4px);\n            box-shadow: var(--shadow-md);\n        }\n\n        .card-icon {\n            width: 48px;\n            height: 48px;\n            margin-bottom: var(--spacing-sm);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--color-dusty-rose-light);\n            border-radius: var(--radius-shard-2);\n            color: var(--color-dusty-rose-deep);\n        }\n\n        .problem-card h3, .solution-card h3 {\n            margin-bottom: var(--spacing-xs);\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            background: var(--color-opal-white);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .service-card {\n            background: var(--color-opal-white);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-shard-1);\n            box-shadow: var(--shadow-sm);\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: var(--gradient-rose);\n            transform: scaleX(0);\n            transform-origin: left;\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            margin-bottom: var(--spacing-sm);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--gradient-opal);\n            border-radius: var(--radius-shard-2);\n            font-size: 1.5rem;\n            color: var(--color-dusty-rose);\n        }\n\n        .service-card h3 {\n            font-size: 1.25rem;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        .service-card p {\n            font-size: 0.95rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-link {\n            color: var(--color-dusty-rose);\n            font-weight: 600;\n            display: inline-flex;\n            align-items: center;\n            gap: 0.25rem;\n        }\n\n        .service-link:hover {\n            gap: 0.5rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            background: var(--color-charcoal);\n            color: var(--color-text-light);\n        }\n\n        .testimonials .section-title,\n        .testimonials .section-description,\n        .testimonials p {\n            color: var(--color-text-light);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.05);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-shard-1);\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            transition: var(--transition-base);\n        }\n\n        .testimonial-card:hover {\n            background: rgba(255, 255, 255, 0.08);\n            transform: translateY(-4px);\n        }\n\n        .testimonial-stars {\n            color: #FFD700;\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.25rem;\n        }\n\n        .testimonial-text {\n            font-style: italic;\n            margin-bottom: var(--spacing-sm);\n            opacity: 0.9;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 48px;\n            height: 48px;\n            border-radius: 50%;\n            background: var(--gradient-rose);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: white;\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n            color: var(--color-dusty-rose-light);\n        }\n\n        .testimonial-role {\n            font-size: 0.85rem;\n            opacity: 0.7;\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            background: var(--color-opal-light);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .differential-item {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-sm);\n            padding: var(--spacing-md);\n            background: var(--color-opal-white);\n            border-radius: var(--radius-shard-1);\n            transition: var(--transition-base);\n        }\n\n        .differential-item:hover {\n            transform: translateX(8px);\n            box-shadow: var(--shadow-sm);\n        }\n\n        .differential-icon {\n            width: 50px;\n            height: 50px;\n            flex-shrink: 0;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--color-dusty-rose-light);\n            border-radius: var(--radius-shard-2);\n            color: var(--color-dusty-rose-deep);\n            position: relative;\n        }\n\n        .differential-icon::before {\n            content: '';\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            border-radius: inherit;\n            border: 2px solid var(--color-dusty-rose);\n            opacity: 0;\n            animation: pulseRing 2s ease-in-out infinite;\n        }\n\n        @keyframes pulseRing {\n            0% {\n                transform: scale(1);\n                opacity: 0.5;\n            }\n            100% {\n                transform: scale(1.3);\n                opacity: 0;\n            }\n        }\n\n        .differential-content h3 {\n            font-size: 1.125rem;\n            margin-bottom: 0.25rem;\n        }\n\n        .differential-content p {\n            font-size: 0.9rem;\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            background: var(--color-opal-white);\n        }\n\n        .contact-wrapper {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n            margin-top: var(--spacing-lg);\n        }\n\n        .contact-info {\n            padding: var(--spacing-md);\n        }\n\n        .contact-info-item {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-sm);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-icon {\n            width: 48px;\n            height: 48px;\n            flex-shrink: 0;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--color-dusty-rose-light);\n            border-radius: var(--radius-shard-2);\n            color: var(--color-dusty-rose-deep);\n        }\n\n        .contact-details h4 {\n            font-size: 1.125rem;\n            margin-bottom: 0.25rem;\n        }\n\n        .contact-details p {\n            font-size: 0.95rem;\n        }\n\n        .contact-form-wrapper {\n            background: var(--color-opal-light);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-shard-1);\n        }\n\n        .contact-form {\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-sm);\n        }\n\n        .form-group {\n            display: flex;\n            flex-direction: column;\n            gap: 0.5rem;\n        }\n\n        .form-group label {\n            font-weight: 500;\n            font-size: 0.9rem;\n            color: var(--color-charcoal);\n        }\n\n        .form-group input,\n        .form-group select,\n        .form-group textarea {\n            padding: 0.875rem 1rem;\n            border: 2px solid var(--color-opal-mid);\n            border-radius: var(--radius-shard-2);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            background: var(--color-opal-white);\n            transition: var(--transition-fast);\n        }\n\n        .form-group input:focus,\n        .form-group select:focus,\n        .form-group textarea:focus {\n            outline: none;\n            border-color: var(--color-dusty-rose);\n            box-shadow: 0 0 0 3px rgba(201, 168, 168, 0.1);\n        }\n\n        .form-group textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .submit-btn {\n            padding: 1rem 2rem;\n            background: var(--color-dusty-rose);\n            color: var(--color-text-light);\n            font-weight: 600;\n            font-size: 1rem;\n            border: none;\n            border-radius: var(--radius-shard-1);\n            cursor: pointer;\n            transition: var(--transition-fast);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 0.5rem;\n        }\n\n        .submit-btn:hover {\n            background: var(--color-dusty-rose-dark);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-rose);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--color-charcoal-dark);\n            color: var(--color-text-light);\n            padding: var(--spacing-lg) var(--spacing-md) var(--spacing-md);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: var(--spacing-lg);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .footer-brand h3 {\n            color: var(--color-text-light);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-brand p {\n            color: var(--color-opal-warm);\n            font-size: 0.95rem;\n        }\n\n        .footer-links h4,\n        .footer-contact h4 {\n            color: var(--color-dusty-rose-light);\n            font-size: 1rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-links ul {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-links a {\n            color: var(--color-opal-warm);\n            font-size: 0.9rem;\n            transition: var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-dusty-rose-light);\n        }\n\n        .footer-contact p {\n            color: var(--color-opal-warm);\n            font-size: 0.9rem;\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-bottom {\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            padding-top: var(--spacing-md);\n            text-align: center;\n            color: var(--color-opal-warm);\n            font-size: 0.85rem;\n        }\n\n        /* ============================================\n           ANIMATIONS\n           ============================================ */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(40px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.6s ease;\n        }\n\n        .wow-fade-in.visible {\n            opacity: 1;\n        }\n\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 1024px) {\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-image {\n                order: -1;\n                max-width: 500px;\n                margin: 0 auto;\n                animation: fadeInUp 0.8s ease 0.4s forwards !important;\n            }\n\n            .hero-cta {\n                justify-content: center;\n            }\n\n            .hero-description {\n                margin-left: auto;\n                margin-right: auto;\n            }\n\n            .services-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .testimonials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .contact-wrapper {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-content {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .services-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .problem-solution-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .section {\n                padding: var(--spacing-lg) var(--spacing-sm);\n            }\n        }\n\n        @media (max-width: 480px) {\n            h1 { font-size: 2rem; }\n            h2 { font-size: 1.75rem; }\n\n            .hero {\n                padding: var(--spacing-lg) var(--spacing-sm);\n            }\n\n            .btn-primary, .btn-secondary {\n                width: 100%;\n                justify-content: center;\n            }\n\n            .hero-cta {\n                flex-direction: column;\n            }\n        }\n\n        /* ============================================\n           UTILITY CLASSES\n           ============================================ */\n        .text-center { text-align: center; }\n        .text-muted { color: var(--color-text-muted); }\n        .mb-sm { margin-bottom: var(--spacing-sm); }\n        .mb-md { margin-bottom: var(--spacing-md); }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Karen <span>Veronese</span></a>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#inicio\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contato\" class=\"nav-link nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <div class=\"nav-toggle\" id=\"navToggle\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-blobs\">\n            <div class=\"blob blob-1\"></div>\n            <div class=\"blob blob-2\"></div>\n            <div class=\"blob blob-3\"></div>\n            <div class=\"blob blob-4\"></div>\n        </div>\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <span class=\"hero-tag\">Harmonização Facial em Ribeirão Preto</span>\n                <h1 class=\"hero-title\">Revele sua <span>beleza natural</span> com tratamentos personalizados</h1>\n                <p class=\"hero-description\">Dra. Karen Veronese especialista em harmonização facial e estética avançada. Resultados naturais que realçam sua expressão única.</p>\n                <div class=\"hero-cta\">\n                    <a href=\"#contato\" class=\"btn-primary\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"/>\n                        </svg>\n                        Agendar Consulta\n                    </a>\n                    <a href=\"#servicos\" class=\"btn-secondary\">\n                        Conhecer Tratamentos\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n            <div class=\"hero-image\">\n                <div class=\"hero-image-wrapper\">\n                    <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=800&q=80\" alt=\"Harmonização Facial - Dra. Karen Veronese\" loading=\"lazy\">\n                    <div class=\"hero-image-decoration\"></div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Transformação Real</span>\n                <h2 class=\"section-title\">Sua beleza merece destaque</h2>\n                <p class=\"section-description\">Compreendemos suas necessidades e oferecemos soluções estéticas avançadas com resultados naturais.</p>\n            </div>\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card wow-fade-up\" data-delay=\"0\">\n                    <div class=\"card-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            <path d=\"M8 14s1.5 2 4 2 4-2 4-2\"/>\n                            <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"/>\n                            <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"/>\n                        </svg>\n                    </div>\n                    <h3>O Desafio</h3>\n                    <p>O passar dos anos, o estresse e os fatores ambientais podem deixar marcas no seu rosto, afetando sua autoestima e confiança.</p>\n                </div>\n                <div class=\"solution-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"card-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>A Solução</h3>\n                    <p>Tratamentos personalizados de harmonização facial que realçam seus traços naturais, proporcionando uma aparência rejuvenescida e harmônica.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Tratamentos Exclusivos</span>\n                <h2 class=\"section-title\">Procedimentos especializados</h2>\n                <p class=\"section-description\">Oferecemos uma gama completa de tratamentos estéticos faciais com técnicas avançadas e produtos de alta qualidade.</p>\n            </div>\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\" data-delay=\"0\">\n                    <div class=\"service-icon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Harmonização Facial</h3>\n                    <p>Equilíbrio e proporção do rosto através de preenchedores e toxina botulínica para resultados naturais e harmônicos.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"100\">\n                    <div class=\"service-icon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M9 12h6M12 9v6M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0z\"/>\n                        </svg>\n                    </div>\n                    <h3>Toxina Botulínica</h3>\n                    <p>Suavização de linhas de expressão e prevenção de rugas com aplicações precisas e resultados naturais.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"service-icon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Preenchedores Faciais</h3>\n                    <p>Restauração de volume, contorno facial e preenchimento de sulcos com ácido hialurônico de alta qualidade.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"300\">\n                    <div class=\"service-icon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z\"/>\n                        </svg>\n                    </div>\n                    <h3>Preenchimento Labial</h3>\n                    <p>Realce e volume para os lábios com contorno definido e hidratação profunda, mantendo a naturalidade.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"service-icon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Bioestimuladores</h3>\n                    <p>Estímulo de colágeno para firmeza e elasticidade da pele, revertendo os sinais de envelhecimento.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"500\">\n                    <div class=\"service-icon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Protocolos Exclusivos</h3>\n                    <p>Tratamentos personalizados combinando técnicas avançadas para resultados únicos e naturais.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Depoimentos</span>\n                <h2 class=\"section-title\">O que nossas pacientes dizem</h2>\n                <p class=\"section-description\">Histórias reais de transformação e satisfação com nossos tratamentos.</p>\n            </div>\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"0\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"A Dra. Karen é extraordinária! Fiz minha harmonização facial e o resultado superou todas as minhas expectativas. Muito natural e elegante.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div>\n                            <p class=\"testimonial-name\">Marina Costa</p>\n                            <p class=\"testimonial-role\">Empresária</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Finalmente encontrei uma profissional que entende o que quero. O preenchimento labial ficou perfeito, muito natural e duradouro.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AL</div>\n                        <div>\n                            <p class=\"testimonial-name\">Ana Luiza</p>\n                            <p class=\"testimonial-role\">Advogada</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"A toxina botulínica aplicada pela Dra. Karen foi impecável. Resultados naturais e o atendimento é excepcional. Super recomendo!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">PS</div>\n                        <div>\n                            <p class=\"testimonial-name\">Patrícia Silva</p>\n                            <p class=\"testimonial-role\">Professora</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\" id=\"diferenciais\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Por que nos escolher</span>\n                <h2 class=\"section-title\">Diferenciais exclusivos</h2>\n                <p class=\"section-description\">Compromisso com a excelência e resultados que transformam vidas.</p>\n            </div>\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up\" data-delay=\"0\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h3>Resultados Naturais</h3>\n                        <p>Técnicas que realçam sua beleza sem transformar sua expressão.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"100\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h3>Atendimento Personalizado</h3>\n                        <p>Cada tratamento é desenvolvido exclusivamente para você.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"200\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/>\n                            <polyline points=\"22 4 12 14.01 9 11.01\"/>\n                        </svg>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h3>Produtos Certificados</h3>\n                        <p>Utilizamos apenas produtos de origem comprovada e alta qualidade.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"300\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h3>Técnica Avançada</h3>\n                        <p>Procedimentos realizados com as mais modernas técnicas.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"400\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h3>Segurança Total</h3>\n                        <p>Procedimentos realizados em ambiente estéril e seguro.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"500\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9\"/>\n                            <path d=\"M13.73 21a2 2 0 0 1-3.46 0\"/>\n                        </svg>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h3>Acompanhamento</h3>\n                        <p>Suporte contínuo antes e depois dos procedimentos.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Entre em Contato</span>\n                <h2 class=\"section-title\">Agende sua consulta</h2>\n                <p class=\"section-description\">Dê o primeiro passo em direção à sua transformação. Entre em contato para agendar sua avaliação.</p>\n            </div>\n            <div class=\"contact-wrapper\">\n                <div class=\"contact-info wow-fade-up\" data-delay=\"0\">\n                    <div class=\"contact-info-item\">\n                        <div class=\"contact-icon\">\n                            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/>\n                                <circle cx=\"12\" cy=\"10\" r=\"3\"/>\n                            </svg>\n                        </div>\n                        <div class=\"contact-details\">\n                            <h4>Endereço</h4>\n                            <p>Rua Milton José Robusti, 75 - sala 103<br>Jardim Botânico, Ribeirão Preto - SP<br>CEP: 14021-613</p>\n                        </div>\n                    </div>\n                    <div class=\"contact-info-item\">\n                        <div class=\"contact-icon\">\n                            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"/>\n                            </svg>\n                        </div>\n                        <div class=\"contact-details\">\n                            <h4>Telefone / WhatsApp</h4>\n                            <p>(16) 99153-9505</p>\n                        </div>\n                    </div>\n                    <div class=\"contact-info-item\">\n                        <div class=\"contact-icon\">\n                            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                            </svg>\n                        </div>\n                        <div class=\"contact-details\">\n                            <h4>Horário de Atendimento</h4>\n                            <p>Segunda a Sexta: 9h às 18h<br>Sábados: 9h às 13h</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"contact-form-wrapper wow-fade-up\" data-delay=\"200\">\n                    <form class=\"contact-form\" id=\"contactForm\">\n                        <div class=\"form-group\">\n                            <label for=\"name\">Nome completo</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" placeholder=\"Seu nome\" required>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"phone\">Telefone / WhatsApp</label>\n                            <input type=\"tel\" id=\"phone\" name=\"phone\" placeholder=\"(00) 00000-0000\" required>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"service\">Tratamento de interesse</label>\n                            <select id=\"service\" name=\"service\" required>\n                                <option value=\"\">Selecione uma opção</option>\n                                <option value=\"Harmonização Facial\">Harmonização Facial</option>\n                                <option value=\"Toxina Botulínica\">Toxina Botulínica</option>\n                                <option value=\"Preenchedores Faciais\">Preenchedores Faciais</option>\n                                <option value=\"Preenchimento Labial\">Preenchimento Labial</option>\n                                <option value=\"Bioestimuladores\">Bioestimuladores</option>\n                                <option value=\"Protocolos Exclusivos\">Protocolos Exclusivos</option>\n                                <option value=\"Avaliação Geral\">Avaliação Geral</option>\n                            </select>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"message\">Mensagem</label>\n                            <textarea id=\"message\" name=\"message\" placeholder=\"Conte-nos sobre suas expectativas...\" required></textarea>\n                        </div>\n                        <button type=\"submit\" class=\"submit-btn\">\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z\"/>\n                            </svg>\n                            Enviar Mensagem\n                        </button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-brand\">\n                    <h3>Dra. Karen Veronese</h3>\n                    <p>Harmonização Facial e Estética Avançada em Ribeirão Preto. Transforme sua aparência com tratamentos personalizados e resultados naturais.</p>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Links Rápidos</h4>\n                    <ul>\n                        <li><a href=\"#inicio\">Início</a></li>\n                        <li><a href=\"#servicos\">Serviços</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                        <li><a href=\"#diferenciais\">Diferenciais</a></li>\n                        <li><a href=\"#contato\">Contato</a></li>\n                    </ul>\n                </div>\n                <div class=\"footer-contact\">\n                    <h4>Contato</h4>\n                    <p>(16) 99153-9505</p>\n                    <p>Rua Milton José Robusti, 75 - sala 103</p>\n                    <p>Jardim Botânico, Ribeirão Preto - SP</p>\n                </div>\n            </div>\n            <div class=\"footer-bottom\">\n                <p>&copy; 2025 Dra. Karen Veronese. Todos os direitos reservados. | Harmonização Facial em Ribeirão Preto</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION\n        // ============================================\n        const nav = document.getElementById('nav');\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n        let lastScroll = 0;\n\n        // Auto-hide navigation on scroll\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                } else {\n                    nav.classList.remove('hidden');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Mobile menu toggle\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close mobile menu on link click\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER ANIMATIONS\n        // ============================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || 0;\n                    setTimeout(() => {\n                        entry.target.classList.add('visible');\n                    }, delay);\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // PARALLAX EFFECT ON BLOBS\n        // ============================================\n        const blobs = document.querySelectorAll('.blob');\n\n        document.addEventListener('mousemove', (e) => {\n            const mouseX = e.clientX / window.innerWidth - 0.5;\n            const mouseY = e.clientY / window.innerHeight - 0.5;\n\n            blobs.forEach((blob, index) => {\n                const speed = (index + 1) * 20;\n                const x = mouseX * speed;\n                const y = mouseY * speed;\n                blob.style.transform = `translate(${x}px, ${y}px)`;\n            });\n        });\n\n        // ============================================\n        // FORM SUBMISSION TO WHATSAPP\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const whatsappNumber = '5516991539505';\n            const text = `Olá, me chamo ${name}!\\n\\nTelefone: ${phone}\\nTratamento de interesse: ${service}\\n\\nMensagem: ${message}`;\n\n            const whatsappURL = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;\n            window.open(whatsappURL, '_blank');\n        });\n\n        // ============================================\n        // HOVER EFFECTS ON SERVICE CARDS\n        // ============================================\n        const serviceCards = document.querySelectorAll('.service-card');\n\n        serviceCards.forEach(card => {\n            card.addEventListener('mouseenter', function() {\n                this.style.transform = 'translateY(-8px) scale(1.02)';\n            });\n\n            card.addEventListener('mouseleave', function() {\n                this.style.transform = 'translateY(0) scale(1)';\n            });\n        });\n\n        // ============================================\n        // ACCESSIBILITY - REDUCED MOTION\n        // ============================================\n        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n            document.querySelectorAll('.blob').forEach(blob => {\n                blob.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>","numLines":1690,"startLine":1,"totalLines":1690}}}
