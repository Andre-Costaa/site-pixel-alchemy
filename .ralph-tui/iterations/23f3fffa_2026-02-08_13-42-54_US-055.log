</div>\n                </div>\n                <div class=\"differential-content\">\n                    <h3>Ambiente Confortável</h3>\n                    <p>Espaço planejado para oferecer conforto, segurança e privacidade.</p>\n                </div>\n            </div>\n\n            <div class=\"differential-item wow-fade-up\" data-delay=\"500\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path>\n                            <polyline points=\"22 4 12 14.01 9 11.01\"></polyline>\n                        </svg>\n                    </div>\n                </div>\n                <div class=\"differential-content\">\n                    <h3>Resultados Naturais</h3>\n                    <p>Foco em enhancear sua beleza natural com resultados sutis e elegantes.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"contact-container\">\n            <div class=\"contact-info\">\n                <h2>Agende Sua Consulta</h2>\n                <p>\n                    Dê o primeiro passo em direção a uma versão mais confiante de si mesma. Entre em contato conosco e agende sua avaliação personalizada.\n                </p>\n\n                <div class=\"contact-details\">\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n                                <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n                            </svg>\n                        </div>\n                        <div class=\"contact-item-text\">\n                            <h4>Endereço</h4>\n                            <p>Sala 715 - Nova Ribeirânia, Ribeirão Preto - SP, 14096-730</p>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path>\n                            </svg>\n                        </div>\n                        <div class=\"contact-item-text\">\n                            <h4>WhatsApp</h4>\n                            <p>(16) 98142-0597</p>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect>\n                                <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"></line>\n                                <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"></line>\n                                <line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"></line>\n                            </svg>\n                        </div>\n                        <div class=\"contact-item-text\">\n                            <h4>Horário de Atendimento</h4>\n                            <p>Segunda a Sexta: 9h às 18h</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"contact-form-wrapper\">\n                <form class=\"contact-form\" id=\"contactForm\">\n                    <div class=\"form-group\">\n                        <label for=\"name\">Nome Completo</label>\n                        <input type=\"text\" id=\"name\" name=\"name\" placeholder=\"Seu nome\" required>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label for=\"phone\">Telefone / WhatsApp</label>\n                        <input type=\"tel\" id=\"phone\" name=\"phone\" placeholder=\"(00) 00000-0000\" required>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label for=\"service\">Serviço de Interesse</label>\n                        <select id=\"service\" name=\"service\" required>\n                            <option value=\"\">Selecione uma opção</option>\n                            <option value=\"harmonizacao-facial\">Harmonização Facial</option>\n                            <option value=\"toxina-botulinica\">Toxina Botulínica</option>\n                            <option value=\"preenchedores\">Preenchedores Faciais</option>\n                            <option value=\"labial\">Preenchimento Labial</option>\n                            <option value=\"bioestimuladores\">Bioestimuladores</option>\n                            <option value=\"outros\">Outros Tratamentos</option>\n                        </select>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label for=\"message\">Mensagem (opcional)</label>\n                        <textarea id=\"message\" name=\"message\" placeholder=\"Conte-nos mais sobre suas necessidades...\"></textarea>\n                    </div>\n\n                    <button type=\"submit\" class=\"btn btn-primary\">\n                        Enviar Mensagem\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"22\" y1=\"2\" x2=\"11\" y2=\"13\"></line>\n                            <polygon points=\"22 2 15 22 11 13 2 9 22 2\"></polygon>\n                        </svg>\n                    </button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-brand\">\n                    <h3>Remon</h3>\n                    <p>\n                        Transformando vidas através da harmonização facial e estética avançada com excelência, segurança e resultados naturais.\n                    </p>\n                </div>\n\n                <div class=\"footer-links\">\n                    <h4>Links Rápidos</h4>\n                    <ul>\n                        <li><a href=\"#home\">Início</a></li>\n                        <li><a href=\"#servicos\">Serviços</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                        <li><a href=\"#contato\">Contato</a></li>\n                    </ul>\n                </div>\n\n                <div class=\"footer-links\">\n                    <h4>Serviços</h4>\n                    <ul>\n                        <li><a href=\"#servicos\">Harmonização Facial</a></li>\n                        <li><a href=\"#servicos\">Toxina Botulínica</a></li>\n                        <li><a href=\"#servicos\">Preenchedores</a></li>\n                        <li><a href=\"#servicos\">Bioestimuladores</a></li>\n                    </ul>\n                </div>\n            </div>\n\n            <div class=\"footer-bottom\">\n                <p>&copy; 2025 Remon. Todos os direitos reservados.</p>\n                <div class=\"footer-social\">\n                    <a href=\"https://instagram.com\" aria-label=\"Instagram\" target=\"_blank\" rel=\"noopener noreferrer\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\" ry=\"5\"></rect>\n                            <path d=\"M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z\"></path>\n                            <line x1=\"17.5\" y1=\"6.5\" x2=\"17.51\" y2=\"6.5\"></line>\n                        </svg>\n                    </a>\n                    <a href=\"https://facebook.com\" aria-label=\"Facebook\" target=\"_blank\" rel=\"noopener noreferrer\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z\"></path>\n                        </svg>\n                    </a>\n                    <a href=\"https://wa.me/5516981420597\" aria-label=\"WhatsApp\" target=\"_blank\" rel=\"noopener noreferrer\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // Navigation scroll effect\n        const nav = document.getElementById('nav');\n        let lastScrollY = window.scrollY;\n\n        window.addEventListener('scroll', () => {\n            if (window.scrollY > lastScrollY && window.scrollY > 100) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n            lastScrollY = window.scrollY;\n        });\n\n        // Mobile menu toggle\n        const mobileMenuBtn = document.getElementById('mobileMenuBtn');\n        const navLinks = document.getElementById('navLinks');\n\n        mobileMenuBtn.addEventListener('click', () => {\n            navLinks.classList.toggle('active');\n        });\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                    navLinks.classList.remove('active');\n                }\n            });\n        });\n\n        // Intersection Observer for scroll animations\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.getAttribute('data-delay');\n                    entry.target.style.transitionDelay = delay ? `${delay}ms` : '0ms';\n                    entry.target.classList.add('visible');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up').forEach(el => {\n            observer.observe(el);\n        });\n\n        // Contact form submission to WhatsApp\n        const contactForm = document.getElementById('contactForm');\n        contactForm.addEventListener('submit', function(e) {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceNames = {\n                'harmonizacao-facial': 'Harmonização Facial',\n                'toxina-botulinica': 'Toxina Botulínica',\n                'preenchedores': 'Preenchedores Faciais',\n                'labial': 'Preenchimento Labial',\n                'bioestimuladores': 'Bioestimuladores',\n                'outros': 'Outros Tratamentos'\n            };\n\n            const serviceName = serviceNames[service] || service;\n\n            const whatsappMessage = `Olá! Meu nome é ${name}.\\nTelefone: ${phone}\\nServiço de interesse: ${serviceName}\\n${message ? 'Mensagem: ' + message : ''}\\n\\nGostaria de agendar uma consulta.`;\n\n            const whatsappUrl = `https://wa.me/5516981420597?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappUrl, '_blank');\n        });\n\n        // Parallax effect for hero blobs\n        document.addEventListener('mousemove', (e) => {\n            const moveX = (e.clientX - window.innerWidth / 2) * 0.01;\n            const moveY = (e.clientY - window.innerHeight / 2) * 0.01;\n\n            document.querySelectorAll('.hero-blob').forEach((blob, index) => {\n                const speed = (index + 1) * 0.5;\n                blob.style.transform = `translate(${moveX * speed}px, ${moveY * speed}px)`;\n            });\n        });\n\n        // Close mobile menu when clicking outside\n        document.addEventListener('click', (e) => {\n            if (!e.target.closest('.nav')) {\n                navLinks.classList.remove('active');\n            }\n        });\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"149ba568-b00f-4fee-98f1-28ada4c5f719","uuid":"3f4fd8b2-9203-4916-822b-e5f9fab48536"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a3a03ca905f94671b9105750","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/remon/index.html"}]},"parent_tool_use_id":null,"session_id":"149ba568-b00f-4fee-98f1-28ada4c5f719","uuid":"7e503d6b-6b07-43f9-af29-b27371e4d07a","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/remon/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Remon | Harmonização Facial e Estética Avançada em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Remon - Harmonização Facial e Estética Avançada em Ribeirão Preto. Transforme sua aparência com tratamentos exclusivos e personalizados.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;600;700&family=Manrope:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        :root {\n            /* Sapphire Noir & Champagne Palette */\n            --color-sapphire: #1E3A5F;\n            --color-sapphire-light: #2A5298;\n            --color-sapphire-dark: #0F2440;\n            --color-sapphire-deep: #0A1830;\n            --color-champagne: #D4AF77;\n            --color-champagne-light: #E5C89A;\n            --color-champagne-dark: #B8945C;\n            --color-ivory: #FAF8F5;\n            --color-ivory-dark: #F0EBE3;\n            --color-midnight: #0D1B2A;\n            --color-pearl: #FDFCFA;\n\n            /* Typography */\n            --font-display: 'Cinzel Decorative', serif;\n            --font-body: 'Manrope', sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Diamond Border Radius - Crystalline geometric shapes */\n            --radius-diamond: 75% 25% 55% 45% / 45% 65% 35% 55%;\n            --radius-diamond-2: 55% 45% 35% 65% / 65% 35% 55% 45%;\n            --radius-diamond-3: 40% 60% 65% 35% / 55% 45% 35% 65%;\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background-color: var(--color-ivory);\n            color: var(--color-sapphire-dark);\n            line-height: 1.7;\n            overflow-x: hidden;\n        }\n\n        /* Typography */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-sapphire);\n        }\n\n        h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); }\n        h2 { font-size: clamp(2rem, 4vw, 3rem); }\n        h3 { font-size: clamp(1.3rem, 2.5vw, 1.8rem); }\n\n        p {\n            font-size: clamp(1rem, 1.2vw, 1.125rem);\n            color: var(--color-sapphire);\n            opacity: 0.85;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* Navigation */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: 1.25rem 5%;\n            background: rgba(250, 248, 245, 0.9);\n            backdrop-filter: blur(20px);\n            border-bottom: 1px solid rgba(212, 175, 119, 0.2);\n            transition: var(--transition-base);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.8rem;\n            font-weight: 700;\n            color: var(--color-sapphire);\n            letter-spacing: 0.05em;\n        }\n\n        .nav-links {\n            display: flex;\n            gap: 2.5rem;\n            list-style: none;\n        }\n\n        .nav-links a {\n            font-family: var(--font-body);\n            font-size: 0.95rem;\n            font-weight: 500;\n            color: var(--color-sapphire);\n            position: relative;\n            padding: 0.5rem 0;\n        }\n\n        .nav-links a::after {\n            content: '';\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-champagne);\n            transition: width var(--transition-base);\n        }\n\n        .nav-links a:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--color-champagne);\n            color: var(--color-sapphire-deep) !important;\n            padding: 0.75rem 1.75rem !important;\n            border-radius: 50px;\n            font-weight: 600 !important;\n            transition: var(--transition-base);\n        }\n\n        .nav-cta:hover {\n            background: var(--color-champagne-dark);\n            transform: translateY(-2px);\n            box-shadow: 0 10px 30px rgba(212, 175, 119, 0.3);\n        }\n\n        .nav-cta::after {\n            display: none !important;\n        }\n\n        .mobile-menu-btn {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .mobile-menu-btn span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-sapphire);\n            transition: var(--transition-base);\n        }\n\n        /* Hero Section */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            position: relative;\n            padding: 8rem 5% 4rem;\n            overflow: hidden;\n        }\n\n        .hero-blobs {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            z-index: 0;\n            overflow: hidden;\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-diamond);\n            filter: blur(80px);\n            opacity: 0.4;\n            animation: diamond-float 20s ease-in-out infinite;\n        }\n\n        .hero-blob-1 {\n            width: 600px;\n            height: 600px;\n            background: linear-gradient(135deg, var(--color-sapphire-light), var(--color-champagne));\n            top: -200px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .hero-blob-2 {\n            width: 500px;\n            height: 500px;\n            background: linear-gradient(225deg, var(--color-champagne-light), var(--color-sapphire));\n            bottom: -150px;\n            left: -100px;\n            animation-delay: -5s;\n            border-radius: var(--radius-diamond-2);\n        }\n\n        .hero-blob-3 {\n            width: 400px;\n            height: 400px;\n            background: linear-gradient(180deg, var(--color-sapphire), var(--color-champagne-dark));\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: -10s;\n            border-radius: var(--radius-diamond-3);\n            opacity: 0.25;\n        }\n\n        .hero-blob-4 {\n            width: 350px;\n            height: 350px;\n            background: linear-gradient(315deg, var(--color-champagne), var(--color-sapphire-light));\n            top: 20%;\n            left: 10%;\n            animation-delay: -15s;\n            border-radius: var(--radius-diamond);\n            opacity: 0.2;\n        }\n\n        @keyframes diamond-float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(3deg);\n            }\n        }\n\n        .hero-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .hero-content {\n            animation: fade-up 1s ease forwards;\n            animation-delay: 0ms;\n            opacity: 0;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            background: rgba(212, 175, 119, 0.15);\n            border: 1px solid rgba(212, 175, 119, 0.3);\n            padding: 0.6rem 1.25rem;\n            border-radius: 50px;\n            font-size: 0.875rem;\n            font-weight: 600;\n            color: var(--color-sapphire);\n            margin-bottom: 1.5rem;\n            animation: fade-up 1s ease forwards;\n            animation-delay: 200ms;\n            opacity: 0;\n        }\n\n        .hero-badge::before {\n            content: '';\n            width: 8px;\n            height: 8px;\n            background: var(--color-champagne);\n            border-radius: 50%;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; transform: scale(1); }\n            50% { opacity: 0.5; transform: scale(1.2); }\n        }\n\n        .hero h1 {\n            margin-bottom: 1.5rem;\n            animation: fade-up 1s ease forwards;\n            animation-delay: 400ms;\n            opacity: 0;\n        }\n\n        .hero-description {\n            font-size: 1.125rem;\n            margin-bottom: 2.5rem;\n            max-width: 500px;\n            animation: fade-up 1s ease forwards;\n            animation-delay: 600ms;\n            opacity: 0;\n        }\n\n        .hero-cta {\n            display: flex;\n            gap: 1rem;\n            flex-wrap: wrap;\n            animation: fade-up 1s ease forwards;\n            animation-delay: 800ms;\n            opacity: 0;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.75rem;\n            padding: 1rem 2rem;\n            border-radius: 50px;\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n            border: none;\n            font-family: var(--font-body);\n        }\n\n        .btn-primary {\n            background: linear-gradient(135deg, var(--color-champagne), var(--color-champagne-dark));\n            color: var(--color-sapphire-deep);\n            box-shadow: 0 4px 20px rgba(212, 175, 119, 0.3);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 8px 30px rgba(212, 175, 119, 0.4);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-sapphire);\n            border: 2px solid var(--color-sapphire);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-sapphire);\n            color: var(--color-ivory);\n        }\n\n        .hero-visual {\n            position: relative;\n            height: 600px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            animation: fade-in 1.2s ease forwards;\n            animation-delay: 400ms;\n            opacity: 0;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            width: 100%;\n            height: 100%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .hero-image {\n            width: 100%;\n            max-width: 500px;\n            height: 600px;\n            object-fit: cover;\n            border-radius: var(--radius-diamond);\n            position: relative;\n            z-index: 2;\n        }\n\n        .hero-image-frame {\n            position: absolute;\n            width: 520px;\n            height: 620px;\n            border: 3px solid var(--color-champagne);\n            border-radius: var(--radius-diamond-2);\n            top: -10px;\n            left: 50%;\n            transform: translateX(-50%);\n            z-index: 1;\n        }\n\n        .hero-floating-card {\n            position: absolute;\n            background: rgba(255, 255, 255, 0.95);\n            backdrop-filter: blur(10px);\n            padding: 1.25rem 1.75rem;\n            border-radius: 20px;\n            box-shadow: 0 20px 60px rgba(30, 58, 95, 0.15);\n            z-index: 3;\n            animation: card-float 6s ease-in-out infinite;\n        }\n\n        .hero-floating-card-1 {\n            top: 15%;\n            right: -20px;\n            animation-delay: 0s;\n        }\n\n        .hero-floating-card-2 {\n            bottom: 20%;\n            left: -30px;\n            animation-delay: -3s;\n        }\n\n        @keyframes card-float {\n            0%, 100% { transform: translateY(0); }\n            50% { transform: translateY(-15px); }\n        }\n\n        .floating-card-icon {\n            width: 50px;\n            height: 50px;\n            background: linear-gradient(135deg, var(--color-champagne), var(--color-champagne-dark));\n            border-radius: 14px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 0.75rem;\n        }\n\n        .floating-card-icon svg {\n            width: 24px;\n            height: 24px;\n            color: var(--color-sapphire-deep);\n        }\n\n        .floating-card-text {\n            font-family: var(--font-body);\n            font-size: 0.875rem;\n            font-weight: 600;\n            color: var(--color-sapphire);\n        }\n\n        /* Section Styles */\n        .section {\n            padding: var(--spacing-xl) 5%;\n            position: relative;\n        }\n\n        .section-dark {\n            background: var(--color-sapphire-deep);\n            color: var(--color-ivory);\n        }\n\n        .section-dark h2,\n        .section-dark h3,\n        .section-dark p {\n            color: var(--color-ivory);\n        }\n\n        .section-dark p {\n            opacity: 0.8;\n        }\n\n        .section-header {\n            text-align: center;\n            max-width: 800px;\n            margin: 0 auto 4rem;\n        }\n\n        .section-tag {\n            display: inline-block;\n            font-family: var(--font-body);\n            font-size: 0.875rem;\n            font-weight: 600;\n            color: var(--color-champagne);\n            text-transform: uppercase;\n            letter-spacing: 0.15em;\n            margin-bottom: 1rem;\n        }\n\n        .section-title {\n            margin-bottom: 1.5rem;\n        }\n\n        .section-description {\n            font-size: 1.125rem;\n            opacity: 0.85;\n        }\n\n        /* Problem/Solution Section */\n        .problem-solution {\n            background: linear-gradient(180deg, var(--color-ivory) 0%, var(--color-ivory-dark) 100%);\n        }\n\n        .ps-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 2rem;\n        }\n\n        .ps-card {\n            background: var(--color-pearl);\n            padding: 3rem;\n            border-radius: 30px;\n            position: relative;\n            overflow: hidden;\n            transition: var(--transition-base);\n            border: 1px solid rgba(30, 58, 95, 0.08);\n        }\n\n        .ps-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 4px;\n            height: 100%;\n            background: linear-gradient(180deg, var(--color-champagne), var(--color-champagne-dark));\n            opacity: 0;\n            transition: var(--transition-base);\n        }\n\n        .ps-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 20px 60px rgba(30, 58, 95, 0.12);\n        }\n\n        .ps-card:hover::before {\n            opacity: 1;\n        }\n\n        .ps-icon {\n            width: 70px;\n            height: 70px;\n            background: linear-gradient(135deg, rgba(212, 175, 119, 0.2), rgba(212, 175, 119, 0.1));\n            border-radius: 20px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n        }\n\n        .ps-icon svg {\n            width: 32px;\n            height: 32px;\n            color: var(--color-champagne-dark);\n        }\n\n        .ps-card h3 {\n            margin-bottom: 1rem;\n            font-size: 1.5rem;\n        }\n\n        .ps-card p {\n            opacity: 0.75;\n        }\n\n        /* Services Section */\n        .services {\n            background: var(--color-sapphire-deep);\n            color: var(--color-ivory);\n        }\n\n        .services-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .service-card {\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(10px);\n            padding: 2.5rem;\n            border-radius: 25px;\n            border: 1px solid rgba(212, 175, 119, 0.15);\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background: linear-gradient(135deg, rgba(212, 175, 119, 0.1), transparent);\n            opacity: 0;\n            transition: var(--transition-base);\n        }\n\n        .service-card:hover {\n            transform: translateY(-10px);\n            border-color: var(--color-champagne);\n            background: rgba(255, 255, 255, 0.08);\n        }\n\n        .service-card:hover::before {\n            opacity: 1;\n        }\n\n        .service-icon {\n            width: 65px;\n            height: 65px;\n            background: linear-gradient(135deg, var(--color-champagne), var(--color-champagne-dark));\n            border-radius: 18px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .service-icon svg {\n            width: 28px;\n            height: 28px;\n            color: var(--color-sapphire-deep);\n        }\n\n        .service-card h3 {\n            color: var(--color-ivory);\n            margin-bottom: 1rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .service-card p {\n            color: var(--color-ivory);\n            opacity: 0.75;\n            position: relative;\n            z-index: 1;\n        }\n\n        /* Testimonials Section */\n        .testimonials {\n            background: linear-gradient(180deg, var(--color-ivory) 0%, var(--color-ivory-dark) 100%);\n        }\n\n        .testimonials-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .testimonial-card {\n            background: var(--color-pearl);\n            padding: 2.5rem;\n            border-radius: 25px;\n            position: relative;\n            transition: var(--transition-base);\n            border: 1px solid rgba(30, 58, 95, 0.08);\n        }\n\n        .testimonial-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 20px 60px rgba(30, 58, 95, 0.12);\n        }\n\n        .testimonial-stars {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: 1.25rem;\n        }\n\n        .testimonial-stars svg {\n            width: 18px;\n            height: 18px;\n            color: var(--color-champagne);\n            fill: var(--color-champagne);\n        }\n\n        .testimonial-quote {\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-style: italic;\n            color: var(--color-sapphire);\n            opacity: 0.85;\n            margin-bottom: 1.5rem;\n            line-height: 1.8;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: linear-gradient(135deg, var(--color-sapphire-light), var(--color-champagne));\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-ivory);\n            font-family: var(--font-display);\n            font-weight: 600;\n            font-size: 1.25rem;\n        }\n\n        .testimonial-info h4 {\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            color: var(--color-sapphire);\n        }\n\n        .testimonial-info span {\n            font-size: 0.875rem;\n            color: var(--color-sapphire);\n            opacity: 0.65;\n        }\n\n        /* Differentials Section */\n        .differentials {\n            background: var(--color-sapphire);\n            color: var(--color-ivory);\n        }\n\n        .differentials-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .differential-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1.25rem;\n            padding: 1.5rem;\n            border-radius: 20px;\n            transition: var(--transition-base);\n        }\n\n        .differential-item:hover {\n            background: rgba(255, 255, 255, 0.05);\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            flex-shrink: 0;\n        }\n\n        .differential-icon {\n            width: 55px;\n            height: 55px;\n            background: linear-gradient(135deg, var(--color-champagne), var(--color-champagne-dark));\n            border-radius: 16px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .differential-icon svg {\n            width: 24px;\n            height: 24px;\n            color: var(--color-sapphire-deep);\n        }\n\n        .differential-icon-wrapper::after {\n            content: '';\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 65px;\n            height: 65px;\n            border: 2px solid var(--color-champagne);\n            border-radius: 20px;\n            opacity: 0.3;\n            animation: pulse-ring 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse-ring {\n            0%, 100% {\n                transform: translate(-50%, -50%) scale(1);\n                opacity: 0.3;\n            }\n            50% {\n                transform: translate(-50%, -50%) scale(1.1);\n                opacity: 0.1;\n            }\n        }\n\n        .differential-content h3 {\n            font-family: var(--font-body);\n            font-size: 1.125rem;\n            font-weight: 600;\n            color: var(--color-ivory);\n            margin-bottom: 0.5rem;\n        }\n\n        .differential-content p {\n            font-size: 0.95rem;\n            color: var(--color-ivory);\n            opacity: 0.75;\n        }\n\n        /* Contact Section */\n        .contact {\n            background: linear-gradient(180deg, var(--color-ivory) 0%, var(--color-ivory-dark) 100%);\n        }\n\n        .contact-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: start;\n        }\n\n        .contact-info {\n            animation: fade-up 0.8s ease forwards;\n            opacity: 0;\n        }\n\n        .contact-info h2 {\n            margin-bottom: 1.5rem;\n        }\n\n        .contact-info p {\n            margin-bottom: 2rem;\n            opacity: 0.75;\n        }\n\n        .contact-details {\n            display: flex;\n            flex-direction: column;\n            gap: 1.5rem;\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .contact-item-icon {\n            width: 50px;\n            height: 50px;\n            background: linear-gradient(135deg, rgba(212, 175, 119, 0.2), rgba(212, 175, 119, 0.1));\n            border-radius: 14px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .contact-item-icon svg {\n            width: 20px;\n            height: 20px;\n            color: var(--color-champagne-dark);\n        }\n\n        .contact-item-text h4 {\n            font-family: var(--font-body);\n            font-size: 0.875rem;\n            font-weight: 600;\n            color: var(--color-sapphire);\n            margin-bottom: 0.25rem;\n        }\n\n        .contact-item-text p {\n            font-size: 1rem;\n            color: var(--color-sapphire);\n            opacity: 0.85;\n        }\n\n        .contact-form-wrapper {\n            background: var(--color-pearl);\n            padding: 3rem;\n            border-radius: 30px;\n            box-shadow: 0 20px 60px rgba(30, 58, 95, 0.1);\n            animation: fade-up 0.8s ease forwards 0.2s;\n            opacity: 0;\n        }\n\n        .contact-form {\n            display: flex;\n            flex-direction: column;\n            gap: 1.5rem;\n        }\n\n        .form-group {\n            display: flex;\n            flex-direction: column;\n            gap: 0.5rem;\n        }\n\n        .form-group label {\n            font-family: var(--font-body);\n            font-size: 0.875rem;\n            font-weight: 600;\n            color: var(--color-sapphire);\n        }\n\n        .form-group input,\n        .form-group select,\n        .form-group textarea {\n            padding: 1rem 1.25rem;\n            border: 2px solid rgba(30, 58, 95, 0.1);\n            border-radius: 14px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            color: var(--color-sapphire);\n            background: var(--color-ivory);\n            transition: var(--transition-fast);\n        }\n\n        .form-group input:focus,\n        .form-group select:focus,\n        .form-group textarea:focus {\n            outline: none;\n            border-color: var(--color-champagne);\n            box-shadow: 0 0 0 4px rgba(212, 175, 119, 0.1);\n        }\n\n        .form-group textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .contact-form button {\n            width: 100%;\n            padding: 1.125rem 2rem;\n            font-size: 1.05rem;\n        }\n\n        /* Footer */\n        .footer {\n            background: var(--color-midnight);\n            color: var(--color-ivory);\n            padding: 4rem 5% 2rem;\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: 3rem;\n            margin-bottom: 3rem;\n        }\n\n        .footer-brand h3 {\n            font-family: var(--font-display);\n            font-size: 2rem;\n            color: var(--color-ivory);\n            margin-bottom: 1rem;\n        }\n\n        .footer-brand p {\n            color: var(--color-ivory);\n            opacity: 0.7;\n            margin-bottom: 1.5rem;\n        }\n\n        .footer-links h4 {\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            color: var(--color-ivory);\n            margin-bottom: 1.25rem;\n        }\n\n        .footer-links ul {\n            list-style: none;\n            display: flex;\n            flex-direction: column;\n            gap: 0.75rem;\n        }\n\n        .footer-links a {\n            font-family: var(--font-body);\n            font-size: 0.95rem;\n            color: var(--color-ivory);\n            opacity: 0.7;\n            transition: var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            opacity: 1;\n            color: var(--color-champagne);\n        }\n\n        .footer-bottom {\n            padding-top: 2rem;\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .footer-bottom p {\n            color: var(--color-ivory);\n            opacity: 0.6;\n            font-size: 0.875rem;\n        }\n\n        .footer-social {\n            display: flex;\n            gap: 1rem;\n        }\n\n        .footer-social a {\n            width: 40px;\n            height: 40px;\n            background: rgba(255, 255, 255, 0.1);\n            border-radius: 10px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: var(--transition-fast);\n        }\n\n        .footer-social a:hover {\n            background: var(--color-champagne);\n            transform: translateY(-3px);\n        }\n\n        .footer-social svg {\n            width: 18px;\n            height: 18px;\n            color: var(--color-ivory);\n        }\n\n        /* Animations */\n        @keyframes fade-up {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fade-in {\n            from { opacity: 0; }\n            to { opacity: 1; }\n        }\n\n        /* Scroll Animations */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.8s ease, transform 0.8s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-up[data-delay] {\n            transition-delay: var(--delay, 0ms);\n        }\n\n        /* Responsive Design */\n        @media (max-width: 1024px) {\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-visual {\n                height: 500px;\n                order: -1;\n            }\n\n            .hero-description {\n                margin-left: auto;\n                margin-right: auto;\n            }\n\n            .hero-cta {\n                justify-content: center;\n            }\n\n            .services-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .testimonials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .contact-container {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-content {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .footer-bottom {\n                flex-direction: column;\n                gap: 1.5rem;\n                text-align: center;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-links {\n                display: none;\n                position: absolute;\n                top: 100%;\n                left: 0;\n                right: 0;\n                background: var(--color-ivory);\n                flex-direction: column;\n                padding: 2rem;\n                gap: 1.5rem;\n                border-top: 1px solid rgba(212, 175, 119, 0.2);\n            }\n\n            .nav-links.active {\n                display: flex;\n            }\n\n            .mobile-menu-btn {\n                display: flex;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .ps-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .hero-floating-card {\n                display: none;\n            }\n\n            .hero-image {\n                max-width: 100%;\n            }\n\n            .hero-image-frame {\n                width: 100%;\n                max-width: 400px;\n                height: 500px;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .hero-cta {\n                flex-direction: column;\n                align-items: stretch;\n            }\n\n            .btn {\n                justify-content: center;\n            }\n\n            .contact-form-wrapper {\n                padding: 2rem;\n            }\n        }\n\n        /* Reduced Motion */\n        @media (prefers-reduced-motion: reduce) {\n            *,\n            *::before,\n            *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#home\" class=\"nav-logo\">Remon</a>\n            <ul class=\"nav-links\" id=\"navLinks\">\n                <li><a href=\"#home\">Início</a></li>\n                <li><a href=\"#servicos\">Serviços</a></li>\n                <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                <li><a href=\"#contato\">Contato</a></li>\n                <li><a href=\"#contato\" class=\"nav-cta\">Agendar</a></li>\n            </ul>\n            <button class=\"mobile-menu-btn\" id=\"mobileMenuBtn\" aria-label=\"Menu\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-blobs\">\n            <div class=\"hero-blob hero-blob-1\"></div>\n            <div class=\"hero-blob hero-blob-2\"></div>\n            <div class=\"hero-blob hero-blob-3\"></div>\n            <div class=\"hero-blob hero-blob-4\"></div>\n        </div>\n\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge\">\n                    Estética Avançada em Ribeirão Preto\n                </div>\n                <h1>Transforme Sua Aparência com Elegância</h1>\n                <p class=\"hero-description\">\n                    Descubra uma versão mais confiante e radiante de si mesma com tratamentos de harmonização facial personalizados, realizados por profissionais especializados.\n                </p>\n                <div class=\"hero-cta\">\n                    <a href=\"#contato\" class=\"btn btn-primary\">\n                        Agendar Consulta\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                            <polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                    <a href=\"#servicos\" class=\"btn btn-secondary\">\n                        Conhecer Serviços\n                    </a>\n                </div>\n            </div>\n\n            <div class=\"hero-visual\">\n                <div class=\"hero-image-wrapper\">\n                    <div class=\"hero-image-frame\"></div>\n                    <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=600&h=800&fit=crop&crop=faces\" alt=\"Harmonização Facial\" class=\"hero-image\">\n\n                    <div class=\"hero-floating-card hero-floating-card-1\">\n                        <div class=\"floating-card-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path>\n                            </svg>\n                        </div>\n                        <div class=\"floating-card-text\">+5.000 pacientes satisfeitas</div>\n                    </div>\n\n                    <div class=\"hero-floating-card hero-floating-card-2\">\n                        <div class=\"floating-card-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path>\n                                <polyline points=\"22 4 12 14.01 9 11.01\"></polyline>\n                            </svg>\n                        </div>\n                        <div class=\"floating-card-text\">Resultados naturais e duradouros</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\" id=\"problema-solucao\">\n        <div class=\"section-header\">\n            <span class=\"section-tag\">Sua Jornada</span>\n            <h2 class=\"section-title\">Descubra uma Nova Versão de Si Mesma</h2>\n            <p class=\"section-description\">\n                Entendemos seus desejos e oferecemos soluções personalizadas que realçam sua beleza natural com segurança e excelência.\n            </p>\n        </div>\n\n        <div class=\"ps-grid\">\n            <div class=\"ps-card wow-fade-up\" data-delay=\"0\">\n                <div class=\"ps-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                        <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line>\n                        <line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line>\n                    </svg>\n                </div>\n                <h3>O Desafio</h3>\n                <p>\n                    Sinais de envelhecimento, assimetrias faciais ou simplesmente o desejo de realçar seus traços naturais podem afetar sua autoestima. Sabemos que cada rosto é único e merece atenção personalizada.\n                </p>\n            </div>\n\n            <div class=\"ps-card wow-fade-up\" data-delay=\"200\">\n                <div class=\"ps-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path>\n                        <polyline points=\"22 4 12 14.01 9 11.01\"></polyline>\n                    </svg>\n                </div>\n                <h3>A Solução</h3>\n                <p>\n                    Com tecnologias avançadas e protocolos personalizados, transformamos sua aparência mantendo sua essência. Resultados naturais que elevam sua confiança sem perder sua identidade.\n                </p>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"section-header\">\n            <span class=\"section-tag\">Tratamentos</span>\n            <h2 class=\"section-title\">Serviços Especializados</h2>\n            <p class=\"section-description\">\n                Oferecemos uma gama completa de procedimentos estéticos faciais para atender suas necessidades únicas.\n            </p>\n        </div>\n\n        <div class=\"services-grid\">\n            <div class=\"service-card wow-fade-up\" data-delay=\"0\">\n                <div class=\"service-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path>\n                    </svg>\n                </div>\n                <h3>Harmonização Facial</h3>\n                <p>\n                    Equilibre seus traços faciais com técnicas avançadas que proporcionam harmonia e naturalidade aos resultados.\n                </p>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"100\">\n                <div class=\"service-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <path d=\"M9 11H5a2 2 0 0 0-2 2v3c0 1.1.9 2 2 2h4\"></path>\n                        <path d=\"M15 11h4a2 2 0 0 1 2 2v3c0 1.1-.9 2-2 2h-4\"></path>\n                        <line x1=\"12\" y1=\"12\" x2=\"12\" y2=\"18\"></line>\n                    </svg>\n                </div>\n                <h3>Toxina Botulínica</h3>\n                <p>\n                    Suavize linhas de expressão e rugas com aplicações precisas que rejuvenescem sua aparência de forma natural.\n                </p>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                <div class=\"service-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <path d=\"M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z\"></path>\n                    </svg>\n                </div>\n                <h3>Preenchedores Faciais</h3>\n                <p>\n                    Restaurhe volume e contorno facial com ácido hialurônico de alta qualidade para resultados duradouros.\n                </p>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"300\">\n                <div class=\"service-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <path d=\"M12 20h9\"></path>\n                        <path d=\"M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z\"></path>\n                    </svg>\n                </div>\n                <h3>Preenchimento Labial</h3>\n                <p>\n                    Destaque seus lábios com preenchimento que proporciona volume, contorno e hidratação natural.\n                </p>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n                <div class=\"service-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                        <path d=\"M8 14s1.5 2 4 2 4-2 4-2\"></path>\n                        <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"></line>\n                        <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"></line>\n                    </svg>\n                </div>\n                <h3>Bioestimuladores</h3>\n                <p>\n                    Estimule o colágeno natural da sua pele com tratamentos que rejuvenescem de dentro para fora.\n                </p>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"500\">\n                <div class=\"service-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon>\n                    </svg>\n                </div>\n                <h3>Protocolos Exclusivos</h3>\n                <p>\n                    Tratamentos personalizados desenvolvidos especialmente para suas necessidades e objetivos estéticos.\n                </p>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"section-header\">\n            <span class=\"section-tag\">Depoimentos</span>\n            <h2 class=\"section-title\">O Que Nossas Pacientes Dizem</h2>\n            <p class=\"section-description\">\n                Histórias reais de transformação e satisfação.\n            </p>\n        </div>\n\n        <div class=\"testimonials-grid\">\n            <div class=\"testimonial-card wow-fade-up\" data-delay=\"0\">\n                <div class=\"testimonial-stars\">\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                </div>\n                <p class=\"testimonial-quote\">\n                    \"Excelente profissional! Me senti muito acolhida desde a primeira consulta. O resultado da harmonização facial superou minhas expectativas.\"\n                </p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">MC</div>\n                    <div class=\"testimonial-info\">\n                        <h4>Mariana Costa</h4>\n                        <span>Empresária</span>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"testimonial-card wow-fade-up\" data-delay=\"100\">\n                <div class=\"testimonial-stars\">\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                </div>\n                <p class=\"testimonial-quote\">\n                    \"Profissional extremamente atenciosa e cuidadosa. Fiz preenchimento labial e ficou super natural. Recomendo de olhos fechados!\"\n                </p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">AS</div>\n                    <div class=\"testimonial-info\">\n                        <h4>Ana Silva</h4>\n                        <span>Advogada</span>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"testimonial-card wow-fade-up\" data-delay=\"200\">\n                <div class=\"testimonial-stars\">\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                </div>\n                <p class=\"testimonial-quote\">\n                    \"Há tempos procurava um profissional de confiança. Encontrei na Remon a qualidade e atenção que sempre desejei. Resultado impecável!\"\n                </p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">PO</div>\n                    <div class=\"testimonial-info\">\n                        <h4>Patrícia Oliveira</h4>\n                        <span>Arquiteta</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\" id=\"diferenciais\">\n        <div class=\"section-header\">\n            <span class=\"section-tag\">Por Que Escolher</span>\n            <h2 class=\"section-title\">Nossos Diferenciais</h2>\n            <p class=\"section-description\">\n                Compromisso com excelência, segurança e resultados que transformam vidas.\n            </p>\n        </div>\n\n        <div class=\"differentials-grid\">\n            <div class=\"differential-item wow-fade-up\" data-delay=\"0\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path>\n                        </svg>\n                    </div>\n                </div>\n                <div class=\"differential-content\">\n                    <h3>Profissionais Especializados</h3>\n                    <p>Equipe qualificada com anos de experiência em procedimentos estéticos faciais.</p>\n                </div>\n            </div>\n\n            <div class=\"differential-item wow-fade-up\" data-delay=\"100\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path>\n                        </svg>\n                    </div>\n                </div>\n                <div class=\"differential-content\">\n                    <h3>Produtos Certificados</h3>\n                    <p>Utilizamos apenas produtos de alta qualidade com procedência garantida.</p>\n                </div>\n            </div>\n\n            <div class=\"differential-item wow-fade-up\" data-delay=\"200\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                            <polyline points=\"12 6 12 12 16 14\"></polyline>\n                        </svg>\n                    </div>\n                </div>\n                <div class=\"differential-content\">\n                    <h3>Atendimento Personalizado</h3>\n                    <p>Cada tratamento é desenvolvido exclusivamente para suas necessidades.</p>\n                </div>\n            </div>\n\n            <div class=\"differential-item wow-fade-up\" data-delay=\"300\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"></path>\n                        </svg>\n                    </div>\n                </div>\n                <div class=\"differential-content\">\n                    <h3>Tecnologia Avançada</h3>\n                    <p>Técnicas modernas e equipamentos de última geração para melhores resultados.</p>\n                </div>\n            </div>\n\n            <div class=\"differential-item wow-fade-up\" data-delay=\"400\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M4.93 19.07a10 10 0 0 1 0-14.14M8.5 15.5a5 5 0 0 1 0-7.07M12 11v2M16.5 15.5a5 5 0 0 0 0-7.07M19.07 19.07a10 10 0 0 0 0-14.14\"></path>\n                        </svg>\n                    </div>\n                </div>\n                <div class=\"differential-content\">\n                    <h3>Ambiente Confortável</h3>\n                    <p>Espaço planejado para oferecer conforto, segurança e privacidade.</p>\n                </div>\n            </div>\n\n            <div class=\"differential-item wow-fade-up\" data-delay=\"500\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path>\n                            <polyline points=\"22 4 12 14.01 9 11.01\"></polyline>\n                        </svg>\n                    </div>\n                </div>\n                <div class=\"differential-content\">\n                    <h3>Resultados Naturais</h3>\n                    <p>Foco em enhancear sua beleza natural com resultados sutis e elegantes.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"contact-container\">\n            <div class=\"contact-info\">\n                <h2>Agende Sua Consulta</h2>\n                <p>\n                    Dê o primeiro passo em direção a uma versão mais confiante de si mesma. Entre em contato conosco e agende sua avaliação personalizada.\n                </p>\n\n                <div class=\"contact-details\">\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n                                <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n                            </svg>\n                        </div>\n                        <div class=\"contact-item-text\">\n                            <h4>Endereço</h4>\n                            <p>Sala 715 - Nova Ribeirânia, Ribeirão Preto - SP, 14096-730</p>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path>\n                            </svg>\n                        </div>\n                        <div class=\"contact-item-text\">\n                            <h4>WhatsApp</h4>\n                            <p>(16) 98142-0597</p>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect>\n                                <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"></line>\n                                <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"></line>\n                                <line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"></line>\n                            </svg>\n                        </div>\n                        <div class=\"contact-item-text\">\n                            <h4>Horário de Atendimento</h4>\n                            <p>Segunda a Sexta: 9h às 18h</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"contact-form-wrapper\">\n                <form class=\"contact-form\" id=\"contactForm\">\n                    <div class=\"form-group\">\n                        <label for=\"name\">Nome Completo</label>\n                        <input type=\"text\" id=\"name\" name=\"name\" placeholder=\"Seu nome\" required>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label for=\"phone\">Telefone / WhatsApp</label>\n                        <input type=\"tel\" id=\"phone\" name=\"phone\" placeholder=\"(00) 00000-0000\" required>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label for=\"service\">Serviço de Interesse</label>\n                        <select id=\"service\" name=\"service\" required>\n                            <option value=\"\">Selecione uma opção</option>\n                            <option value=\"harmonizacao-facial\">Harmonização Facial</option>\n                            <option value=\"toxina-botulinica\">Toxina Botulínica</option>\n                            <option value=\"preenchedores\">Preenchedores Faciais</option>\n                            <option value=\"labial\">Preenchimento Labial</option>\n                            <option value=\"bioestimuladores\">Bioestimuladores</option>\n                            <option value=\"outros\">Outros Tratamentos</option>\n                        </select>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label for=\"message\">Mensagem (opcional)</label>\n                        <textarea id=\"message\" name=\"message\" placeholder=\"Conte-nos mais sobre suas necessidades...\"></textarea>\n                    </div>\n\n                    <button type=\"submit\" class=\"btn btn-primary\">\n                        Enviar Mensagem\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"22\" y1=\"2\" x2=\"11\" y2=\"13\"></line>\n                            <polygon points=\"22 2 15 22 11 13 2 9 22 2\"></polygon>\n                        </svg>\n                    </button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-brand\">\n                    <h3>Remon</h3>\n                    <p>\n                        Transformando vidas através da harmonização facial e estética avançada com excelência, segurança e resultados naturais.\n                    </p>\n                </div>\n\n                <div class=\"footer-links\">\n                    <h4>Links Rápidos</h4>\n                    <ul>\n                        <li><a href=\"#home\">Início</a></li>\n                        <li><a href=\"#servicos\">Serviços</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                        <li><a href=\"#contato\">Contato</a></li>\n                    </ul>\n                </div>\n\n                <div class=\"footer-links\">\n                    <h4>Serviços</h4>\n                    <ul>\n                        <li><a href=\"#servicos\">Harmonização Facial</a></li>\n                        <li><a href=\"#servicos\">Toxina Botulínica</a></li>\n                        <li><a href=\"#servicos\">Preenchedores</a></li>\n                        <li><a href=\"#servicos\">Bioestimuladores</a></li>\n                    </ul>\n                </div>\n            </div>\n\n            <div class=\"footer-bottom\">\n                <p>&copy; 2025 Remon. Todos os direitos reservados.</p>\n                <div class=\"footer-social\">\n                    <a href=\"https://instagram.com\" aria-label=\"Instagram\" target=\"_blank\" rel=\"noopener noreferrer\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\" ry=\"5\"></rect>\n                            <path d=\"M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z\"></path>\n                            <line x1=\"17.5\" y1=\"6.5\" x2=\"17.51\" y2=\"6.5\"></line>\n                        </svg>\n                    </a>\n                    <a href=\"https://facebook.com\" aria-label=\"Facebook\" target=\"_blank\" rel=\"noopener noreferrer\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z\"></path>\n                        </svg>\n                    </a>\n                    <a href=\"https://wa.me/5516981420597\" aria-label=\"WhatsApp\" target=\"_blank\" rel=\"noopener noreferrer\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"></path>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // Navigation scroll effect\n        const nav = document.getElementById('nav');\n        let lastScrollY = window.scrollY;\n\n        window.addEventListener('scroll', () => {\n            if (window.scrollY > lastScrollY && window.scrollY > 100) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n            lastScrollY = window.scrollY;\n        });\n\n        // Mobile menu toggle\n        const mobileMenuBtn = document.getElementById('mobileMenuBtn');\n        const navLinks = document.getElementById('navLinks');\n\n        mobileMenuBtn.addEventListener('click', () => {\n            navLinks.classList.toggle('active');\n        });\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                    navLinks.classList.remove('active');\n                }\n            });\n        });\n\n        // Intersection Observer for scroll animations\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.getAttribute('data-delay');\n                    entry.target.style.transitionDelay = delay ? `${delay}ms` : '0ms';\n                    entry.target.classList.add('visible');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up').forEach(el => {\n            observer.observe(el);\n        });\n\n        // Contact form submission to WhatsApp\n        const contactForm = document.getElementById('contactForm');\n        contactForm.addEventListener('submit', function(e) {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceNames = {\n                'harmonizacao-facial': 'Harmonização Facial',\n                'toxina-botulinica': 'Toxina Botulínica',\n                'preenchedores': 'Preenchedores Faciais',\n                'labial': 'Preenchimento Labial',\n                'bioestimuladores': 'Bioestimuladores',\n                'outros': 'Outros Tratamentos'\n            };\n\n            const serviceName = serviceNames[service] || service;\n\n            const whatsappMessage = `Olá! Meu nome é ${name}.\\nTelefone: ${phone}\\nServiço de interesse: ${serviceName}\\n${message ? 'Mensagem: ' + message : ''}\\n\\nGostaria de agendar uma consulta.`;\n\n            const whatsappUrl = `https://wa.me/5516981420597?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappUrl, '_blank');\n        });\n\n        // Parallax effect for hero blobs\n        document.addEventListener('mousemove', (e) => {\n            const moveX = (e.clientX - window.innerWidth / 2) * 0.01;\n            const moveY = (e.clientY - window.innerHeight / 2) * 0.01;\n\n            document.querySelectorAll('.hero-blob').forEach((blob, index) => {\n                const speed = (index + 1) * 0.5;\n                blob.style.transform = `translate(${moveX * speed}px, ${moveY * speed}px)`;\n            });\n        });\n\n        // Close mobile menu when clicking outside\n        document.addEventListener('click', (e) => {\n            if (!e.target.closest('.nav')) {\n                navLinks.classList.remove('active');\n            }\n        });\n    </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null}}
