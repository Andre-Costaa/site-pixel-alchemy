ngs"}],"newTodos":[{"content":"Create site-demo/remon directory structure","status":"completed","activeForm":"Creating site-demo/remon directory structure"},{"content":"Design and implement unique aesthetic direction for Remon","status":"in_progress","activeForm":"Designing and implementing unique aesthetic direction for Remon"},{"content":"Implement Hero section with animated backgrounds","status":"pending","activeForm":"Implementing Hero section with animated backgrounds"},{"content":"Implement Problem/Solution section","status":"pending","activeForm":"Implementing Problem/Solution section"},{"content":"Implement Services section","status":"pending","activeForm":"Implementing Services section"},{"content":"Implement Testimonials section","status":"pending","activeForm":"Implementing Testimonials section"},{"content":"Implement Differentials section","status":"pending","activeForm":"Implementing Differentials section"},{"content":"Implement Contact section with WhatsApp integration","status":"pending","activeForm":"Implementing Contact section with WhatsApp integration"},{"content":"Implement Footer","status":"pending","activeForm":"Implementing Footer"},{"content":"Test responsive design and all interactions","status":"pending","activeForm":"Testing responsive design and all interactions"},{"content":"Update checkpoint.md with progress and demo URL","status":"pending","activeForm":"Updating checkpoint.md with progress and demo URL"},{"content":"Update progress.md with learnings","status":"pending","activeForm":"Updating progress.md with learnings"}]}}
{"type":"assistant","message":{"id":"msg_2026020900433143c448f2c97240ac","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_a3a03ca905f94671b9105750","name":"Write","input":{"file_path":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/remon/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Remon | Harmonização Facial e Estética Avançada em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Remon - Harmonização Facial e Estética Avançada em Ribeirão Preto. Transforme sua aparência com tratamentos exclusivos e personalizados.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;600;700&family=Manrope:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        :root {\n            /* Sapphire Noir & Champagne Palette */\n            --color-sapphire: #1E3A5F;\n            --color-sapphire-light: #2A5298;\n            --color-sapphire-dark: #0F2440;\n            --color-sapphire-deep: #0A1830;\n            --color-champagne: #D4AF77;\n            --color-champagne-light: #E5C89A;\n            --color-champagne-dark: #B8945C;\n            --color-ivory: #FAF8F5;\n            --color-ivory-dark: #F0EBE3;\n            --color-midnight: #0D1B2A;\n            --color-pearl: #FDFCFA;\n\n            /* Typography */\n            --font-display: 'Cinzel Decorative', serif;\n            --font-body: 'Manrope', sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Diamond Border Radius - Crystalline geometric shapes */\n            --radius-diamond: 75% 25% 55% 45% / 45% 65% 35% 55%;\n            --radius-diamond-2: 55% 45% 35% 65% / 65% 35% 55% 45%;\n            --radius-diamond-3: 40% 60% 65% 35% / 55% 45% 35% 65%;\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background-color: var(--color-ivory);\n            color: var(--color-sapphire-dark);\n            line-height: 1.7;\n            overflow-x: hidden;\n        }\n\n        /* Typography */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-sapphire);\n        }\n\n        h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); }\n        h2 { font-size: clamp(2rem, 4vw, 3rem); }\n        h3 { font-size: clamp(1.3rem, 2.5vw, 1.8rem); }\n\n        p {\n            font-size: clamp(1rem, 1.2vw, 1.125rem);\n            color: var(--color-sapphire);\n            opacity: 0.85;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* Navigation */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: 1.25rem 5%;\n            background: rgba(250, 248, 245, 0.9);\n            backdrop-filter: blur(20px);\n            border-bottom: 1px solid rgba(212, 175, 119, 0.2);\n            transition: var(--transition-base);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.8rem;\n            font-weight: 700;\n            color: var(--color-sapphire);\n            letter-spacing: 0.05em;\n        }\n\n        .nav-links {\n            display: flex;\n            gap: 2.5rem;\n            list-style: none;\n        }\n\n        .nav-links a {\n            font-family: var(--font-body);\n            font-size: 0.95rem;\n            font-weight: 500;\n            color: var(--color-sapphire);\n            position: relative;\n            padding: 0.5rem 0;\n        }\n\n        .nav-links a::after {\n            content: '';\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-champagne);\n            transition: width var(--transition-base);\n        }\n\n        .nav-links a:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--color-champagne);\n            color: var(--color-sapphire-deep) !important;\n            padding: 0.75rem 1.75rem !important;\n            border-radius: 50px;\n            font-weight: 600 !important;\n            transition: var(--transition-base);\n        }\n\n        .nav-cta:hover {\n            background: var(--color-champagne-dark);\n            transform: translateY(-2px);\n            box-shadow: 0 10px 30px rgba(212, 175, 119, 0.3);\n        }\n\n        .nav-cta::after {\n            display: none !important;\n        }\n\n        .mobile-menu-btn {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .mobile-menu-btn span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-sapphire);\n            transition: var(--transition-base);\n        }\n\n        /* Hero Section */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            position: relative;\n            padding: 8rem 5% 4rem;\n            overflow: hidden;\n        }\n\n        .hero-blobs {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            z-index: 0;\n            overflow: hidden;\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-diamond);\n            filter: blur(80px);\n            opacity: 0.4;\n            animation: diamond-float 20s ease-in-out infinite;\n        }\n\n        .hero-blob-1 {\n            width: 600px;\n            height: 600px;\n            background: linear-gradient(135deg, var(--color-sapphire-light), var(--color-champagne));\n            top: -200px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .hero-blob-2 {\n            width: 500px;\n            height: 500px;\n            background: linear-gradient(225deg, var(--color-champagne-light), var(--color-sapphire));\n            bottom: -150px;\n            left: -100px;\n            animation-delay: -5s;\n            border-radius: var(--radius-diamond-2);\n        }\n\n        .hero-blob-3 {\n            width: 400px;\n            height: 400px;\n            background: linear-gradient(180deg, var(--color-sapphire), var(--color-champagne-dark));\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: -10s;\n            border-radius: var(--radius-diamond-3);\n            opacity: 0.25;\n        }\n\n        .hero-blob-4 {\n            width: 350px;\n            height: 350px;\n            background: linear-gradient(315deg, var(--color-champagne), var(--color-sapphire-light));\n            top: 20%;\n            left: 10%;\n            animation-delay: -15s;\n            border-radius: var(--radius-diamond);\n            opacity: 0.2;\n        }\n\n        @keyframes diamond-float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(3deg);\n            }\n        }\n\n        .hero-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .hero-content {\n            animation: fade-up 1s ease forwards;\n            animation-delay: 0ms;\n            opacity: 0;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            background: rgba(212, 175, 119, 0.15);\n            border: 1px solid rgba(212, 175, 119, 0.3);\n            padding: 0.6rem 1.25rem;\n            border-radius: 50px;\n            font-size: 0.875rem;\n            font-weight: 600;\n            color: var(--color-sapphire);\n            margin-bottom: 1.5rem;\n            animation: fade-up 1s ease forwards;\n            animation-delay: 200ms;\n            opacity: 0;\n        }\n\n        .hero-badge::before {\n            content: '';\n            width: 8px;\n            height: 8px;\n            background: var(--color-champagne);\n            border-radius: 50%;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; transform: scale(1); }\n            50% { opacity: 0.5; transform: scale(1.2); }\n        }\n\n        .hero h1 {\n            margin-bottom: 1.5rem;\n            animation: fade-up 1s ease forwards;\n            animation-delay: 400ms;\n            opacity: 0;\n        }\n\n        .hero-description {\n            font-size: 1.125rem;\n            margin-bottom: 2.5rem;\n            max-width: 500px;\n            animation: fade-up 1s ease forwards;\n            animation-delay: 600ms;\n            opacity: 0;\n        }\n\n        .hero-cta {\n            display: flex;\n            gap: 1rem;\n            flex-wrap: wrap;\n            animation: fade-up 1s ease forwards;\n            animation-delay: 800ms;\n            opacity: 0;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.75rem;\n            padding: 1rem 2rem;\n            border-radius: 50px;\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n            border: none;\n            font-family: var(--font-body);\n        }\n\n        .btn-primary {\n            background: linear-gradient(135deg, var(--color-champagne), var(--color-champagne-dark));\n            color: var(--color-sapphire-deep);\n            box-shadow: 0 4px 20px rgba(212, 175, 119, 0.3);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 8px 30px rgba(212, 175, 119, 0.4);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-sapphire);\n            border: 2px solid var(--color-sapphire);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-sapphire);\n            color: var(--color-ivory);\n        }\n\n        .hero-visual {\n            position: relative;\n            height: 600px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            animation: fade-in 1.2s ease forwards;\n            animation-delay: 400ms;\n            opacity: 0;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            width: 100%;\n            height: 100%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .hero-image {\n            width: 100%;\n            max-width: 500px;\n            height: 600px;\n            object-fit: cover;\n            border-radius: var(--radius-diamond);\n            position: relative;\n            z-index: 2;\n        }\n\n        .hero-image-frame {\n            position: absolute;\n            width: 520px;\n            height: 620px;\n            border: 3px solid var(--color-champagne);\n            border-radius: var(--radius-diamond-2);\n            top: -10px;\n            left: 50%;\n            transform: translateX(-50%);\n            z-index: 1;\n        }\n\n        .hero-floating-card {\n            position: absolute;\n            background: rgba(255, 255, 255, 0.95);\n            backdrop-filter: blur(10px);\n            padding: 1.25rem 1.75rem;\n            border-radius: 20px;\n            box-shadow: 0 20px 60px rgba(30, 58, 95, 0.15);\n            z-index: 3;\n            animation: card-float 6s ease-in-out infinite;\n        }\n\n        .hero-floating-card-1 {\n            top: 15%;\n            right: -20px;\n            animation-delay: 0s;\n        }\n\n        .hero-floating-card-2 {\n            bottom: 20%;\n            left: -30px;\n            animation-delay: -3s;\n        }\n\n        @keyframes card-float {\n            0%, 100% { transform: translateY(0); }\n            50% { transform: translateY(-15px); }\n        }\n\n        .floating-card-icon {\n            width: 50px;\n            height: 50px;\n            background: linear-gradient(135deg, var(--color-champagne), var(--color-champagne-dark));\n            border-radius: 14px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 0.75rem;\n        }\n\n        .floating-card-icon svg {\n            width: 24px;\n            height: 24px;\n            color: var(--color-sapphire-deep);\n        }\n\n        .floating-card-text {\n            font-family: var(--font-body);\n            font-size: 0.875rem;\n            font-weight: 600;\n            color: var(--color-sapphire);\n        }\n\n        /* Section Styles */\n        .section {\n            padding: var(--spacing-xl) 5%;\n            position: relative;\n        }\n\n        .section-dark {\n            background: var(--color-sapphire-deep);\n            color: var(--color-ivory);\n        }\n\n        .section-dark h2,\n        .section-dark h3,\n        .section-dark p {\n            color: var(--color-ivory);\n        }\n\n        .section-dark p {\n            opacity: 0.8;\n        }\n\n        .section-header {\n            text-align: center;\n            max-width: 800px;\n            margin: 0 auto 4rem;\n        }\n\n        .section-tag {\n            display: inline-block;\n            font-family: var(--font-body);\n            font-size: 0.875rem;\n            font-weight: 600;\n            color: var(--color-champagne);\n            text-transform: uppercase;\n            letter-spacing: 0.15em;\n            margin-bottom: 1rem;\n        }\n\n        .section-title {\n            margin-bottom: 1.5rem;\n        }\n\n        .section-description {\n            font-size: 1.125rem;\n            opacity: 0.85;\n        }\n\n        /* Problem/Solution Section */\n        .problem-solution {\n            background: linear-gradient(180deg, var(--color-ivory) 0%, var(--color-ivory-dark) 100%);\n        }\n\n        .ps-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 2rem;\n        }\n\n        .ps-card {\n            background: var(--color-pearl);\n            padding: 3rem;\n            border-radius: 30px;\n            position: relative;\n            overflow: hidden;\n            transition: var(--transition-base);\n            border: 1px solid rgba(30, 58, 95, 0.08);\n        }\n\n        .ps-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 4px;\n            height: 100%;\n            background: linear-gradient(180deg, var(--color-champagne), var(--color-champagne-dark));\n            opacity: 0;\n            transition: var(--transition-base);\n        }\n\n        .ps-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 20px 60px rgba(30, 58, 95, 0.12);\n        }\n\n        .ps-card:hover::before {\n            opacity: 1;\n        }\n\n        .ps-icon {\n            width: 70px;\n            height: 70px;\n            background: linear-gradient(135deg, rgba(212, 175, 119, 0.2), rgba(212, 175, 119, 0.1));\n            border-radius: 20px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n        }\n\n        .ps-icon svg {\n            width: 32px;\n            height: 32px;\n            color: var(--color-champagne-dark);\n        }\n\n        .ps-card h3 {\n            margin-bottom: 1rem;\n            font-size: 1.5rem;\n        }\n\n        .ps-card p {\n            opacity: 0.75;\n        }\n\n        /* Services Section */\n        .services {\n            background: var(--color-sapphire-deep);\n            color: var(--color-ivory);\n        }\n\n        .services-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .service-card {\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(10px);\n            padding: 2.5rem;\n            border-radius: 25px;\n            border: 1px solid rgba(212, 175, 119, 0.15);\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background: linear-gradient(135deg, rgba(212, 175, 119, 0.1), transparent);\n            opacity: 0;\n            transition: var(--transition-base);\n        }\n\n        .service-card:hover {\n            transform: translateY(-10px);\n            border-color: var(--color-champagne);\n            background: rgba(255, 255, 255, 0.08);\n        }\n\n        .service-card:hover::before {\n            opacity: 1;\n        }\n\n        .service-icon {\n            width: 65px;\n            height: 65px;\n            background: linear-gradient(135deg, var(--color-champagne), var(--color-champagne-dark));\n            border-radius: 18px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .service-icon svg {\n            width: 28px;\n            height: 28px;\n            color: var(--color-sapphire-deep);\n        }\n\n        .service-card h3 {\n            color: var(--color-ivory);\n            margin-bottom: 1rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .service-card p {\n            color: var(--color-ivory);\n            opacity: 0.75;\n            position: relative;\n            z-index: 1;\n        }\n\n        /* Testimonials Section */\n        .testimonials {\n            background: linear-gradient(180deg, var(--color-ivory) 0%, var(--color-ivory-dark) 100%);\n        }\n\n        .testimonials-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .testimonial-card {\n            background: var(--color-pearl);\n            padding: 2.5rem;\n            border-radius: 25px;\n            position: relative;\n            transition: var(--transition-base);\n            border: 1px solid rgba(30, 58, 95, 0.08);\n        }\n\n        .testimonial-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 20px 60px rgba(30, 58, 95, 0.12);\n        }\n\n        .testimonial-stars {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: 1.25rem;\n        }\n\n        .testimonial-stars svg {\n            width: 18px;\n            height: 18px;\n            color: var(--color-champagne);\n            fill: var(--color-champagne);\n        }\n\n        .testimonial-quote {\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-style: italic;\n            color: var(--color-sapphire);\n            opacity: 0.85;\n            margin-bottom: 1.5rem;\n            line-height: 1.8;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: linear-gradient(135deg, var(--color-sapphire-light), var(--color-champagne));\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-ivory);\n            font-family: var(--font-display);\n            font-weight: 600;\n            font-size: 1.25rem;\n        }\n\n        .testimonial-info h4 {\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            color: var(--color-sapphire);\n        }\n\n        .testimonial-info span {\n            font-size: 0.875rem;\n            color: var(--color-sapphire);\n            opacity: 0.65;\n        }\n\n        /* Differentials Section */\n        .differentials {\n            background: var(--color-sapphire);\n            color: var(--color-ivory);\n        }\n\n        .differentials-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .differential-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1.25rem;\n            padding: 1.5rem;\n            border-radius: 20px;\n            transition: var(--transition-base);\n        }\n\n        .differential-item:hover {\n            background: rgba(255, 255, 255, 0.05);\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            flex-shrink: 0;\n        }\n\n        .differential-icon {\n            width: 55px;\n            height: 55px;\n            background: linear-gradient(135deg, var(--color-champagne), var(--color-champagne-dark));\n            border-radius: 16px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .differential-icon svg {\n            width: 24px;\n            height: 24px;\n            color: var(--color-sapphire-deep);\n        }\n\n        .differential-icon-wrapper::after {\n            content: '';\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 65px;\n            height: 65px;\n            border: 2px solid var(--color-champagne);\n            border-radius: 20px;\n            opacity: 0.3;\n            animation: pulse-ring 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse-ring {\n            0%, 100% {\n                transform: translate(-50%, -50%) scale(1);\n                opacity: 0.3;\n            }\n            50% {\n                transform: translate(-50%, -50%) scale(1.1);\n                opacity: 0.1;\n            }\n        }\n\n        .differential-content h3 {\n            font-family: var(--font-body);\n            font-size: 1.125rem;\n            font-weight: 600;\n            color: var(--color-ivory);\n            margin-bottom: 0.5rem;\n        }\n\n        .differential-content p {\n            font-size: 0.95rem;\n            color: var(--color-ivory);\n            opacity: 0.75;\n        }\n\n        /* Contact Section */\n        .contact {\n            background: linear-gradient(180deg, var(--color-ivory) 0%, var(--color-ivory-dark) 100%);\n        }\n\n        .contact-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: start;\n        }\n\n        .contact-info {\n            animation: fade-up 0.8s ease forwards;\n            opacity: 0;\n        }\n\n        .contact-info h2 {\n            margin-bottom: 1.5rem;\n        }\n\n        .contact-info p {\n            margin-bottom: 2rem;\n            opacity: 0.75;\n        }\n\n        .contact-details {\n            display: flex;\n            flex-direction: column;\n            gap: 1.5rem;\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .contact-item-icon {\n            width: 50px;\n            height: 50px;\n            background: linear-gradient(135deg, rgba(212, 175, 119, 0.2), rgba(212, 175, 119, 0.1));\n            border-radius: 14px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .contact-item-icon svg {\n            width: 20px;\n            height: 20px;\n            color: var(--color-champagne-dark);\n        }\n\n        .contact-item-text h4 {\n            font-family: var(--font-body);\n            font-size: 0.875rem;\n            font-weight: 600;\n            color: var(--color-sapphire);\n            margin-bottom: 0.25rem;\n        }\n\n        .contact-item-text p {\n            font-size: 1rem;\n            color: var(--color-sapphire);\n            opacity: 0.85;\n        }\n\n        .contact-form-wrapper {\n            background: var(--color-pearl);\n            padding: 3rem;\n            border-radius: 30px;\n            box-shadow: 0 20px 60px rgba(30, 58, 95, 0.1);\n            animation: fade-up 0.8s ease forwards 0.2s;\n            opacity: 0;\n        }\n\n        .contact-form {\n            display: flex;\n            flex-direction: column;\n            gap: 1.5rem;\n        }\n\n        .form-group {\n            display: flex;\n            flex-direction: column;\n            gap: 0.5rem;\n        }\n\n        .form-group label {\n            font-family: var(--font-body);\n            font-size: 0.875rem;\n            font-weight: 600;\n            color: var(--color-sapphire);\n        }\n\n        .form-group input,\n        .form-group select,\n        .form-group textarea {\n            padding: 1rem 1.25rem;\n            border: 2px solid rgba(30, 58, 95, 0.1);\n            border-radius: 14px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            color: var(--color-sapphire);\n            background: var(--color-ivory);\n            transition: var(--transition-fast);\n        }\n\n        .form-group input:focus,\n        .form-group select:focus,\n        .form-group textarea:focus {\n            outline: none;\n            border-color: var(--color-champagne);\n            box-shadow: 0 0 0 4px rgba(212, 175, 119, 0.1);\n        }\n\n        .form-group textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .contact-form button {\n            width: 100%;\n            padding: 1.125rem 2rem;\n            font-size: 1.05rem;\n        }\n\n        /* Footer */\n        .footer {\n            background: var(--color-midnight);\n            color: var(--color-ivory);\n            padding: 4rem 5% 2rem;\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: 3rem;\n            margin-bottom: 3rem;\n        }\n\n        .footer-brand h3 {\n            font-family: var(--font-display);\n            font-size: 2rem;\n            color: var(--color-ivory);\n            margin-bottom: 1rem;\n        }\n\n        .footer-brand p {\n            color: var(--color-ivory);\n            opacity: 0.7;\n            margin-bottom: 1.5rem;\n        }\n\n        .footer-links h4 {\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            color: var(--color-ivory);\n            margin-bottom: 1.25rem;\n        }\n\n        .footer-links ul {\n            list-style: none;\n            display: flex;\n            flex-direction: column;\n            gap: 0.75rem;\n        }\n\n        .footer-links a {\n            font-family: var(--font-body);\n            font-size: 0.95rem;\n            color: var(--color-ivory);\n            opacity: 0.7;\n            transition: var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            opacity: 1;\n            color: var(--color-champagne);\n        }\n\n        .footer-bottom {\n            padding-top: 2rem;\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .footer-bottom p {\n            color: var(--color-ivory);\n            opacity: 0.6;\n            font-size: 0.875rem;\n        }\n\n        .footer-social {\n            display: flex;\n            gap: 1rem;\n        }\n\n        .footer-social a {\n            width: 40px;\n            height: 40px;\n            background: rgba(255, 255, 255, 0.1);\n            border-radius: 10px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: var(--transition-fast);\n        }\n\n        .footer-social a:hover {\n            background: var(--color-champagne);\n            transform: translateY(-3px);\n        }\n\n        .footer-social svg {\n            width: 18px;\n            height: 18px;\n            color: var(--color-ivory);\n        }\n\n        /* Animations */\n        @keyframes fade-up {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fade-in {\n            from { opacity: 0; }\n            to { opacity: 1; }\n        }\n\n        /* Scroll Animations */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.8s ease, transform 0.8s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-up[data-delay] {\n            transition-delay: var(--delay, 0ms);\n        }\n\n        /* Responsive Design */\n        @media (max-width: 1024px) {\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-visual {\n                height: 500px;\n                order: -1;\n            }\n\n            .hero-description {\n                margin-left: auto;\n                margin-right: auto;\n            }\n\n            .hero-cta {\n                justify-content: center;\n            }\n\n            .services-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .testimonials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .contact-container {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-content {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .footer-bottom {\n                flex-direction: column;\n                gap: 1.5rem;\n                text-align: center;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-links {\n                display: none;\n                position: absolute;\n                top: 100%;\n                left: 0;\n                right: 0;\n                background: var(--color-ivory);\n                flex-direction: column;\n                padding: 2rem;\n                gap: 1.5rem;\n                border-top: 1px solid rgba(212, 175, 119, 0.2);\n            }\n\n            .nav-links.active {\n                display: flex;\n            }\n\n            .mobile-menu-btn {\n                display: flex;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .ps-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .hero-floating-card {\n                display: none;\n            }\n\n            .hero-image {\n                max-width: 100%;\n            }\n\n            .hero-image-frame {\n                width: 100%;\n                max-width: 400px;\n                height: 500px;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .hero-cta {\n                flex-direction: column;\n                align-items: stretch;\n            }\n\n            .btn {\n                justify-content: center;\n            }\n\n            .contact-form-wrapper {\n                padding: 2rem;\n            }\n        }\n\n        /* Reduced Motion */\n        @media (prefers-reduced-motion: reduce) {\n            *,\n            *::before,\n            *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#home\" class=\"nav-logo\">Remon</a>\n            <ul class=\"nav-links\" id=\"navLinks\">\n                <li><a href=\"#home\">Início</a></li>\n                <li><a href=\"#servicos\">Serviços</a></li>\n                <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                <li><a href=\"#contato\">Contato</a></li>\n                <li><a href=\"#contato\" class=\"nav-cta\">Agendar</a></li>\n            </ul>\n            <button class=\"mobile-menu-btn\" id=\"mobileMenuBtn\" aria-label=\"Menu\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-blobs\">\n            <div class=\"hero-blob hero-blob-1\"></div>\n            <div class=\"hero-blob hero-blob-2\"></div>\n            <div class=\"hero-blob hero-blob-3\"></div>\n            <div class=\"hero-blob hero-blob-4\"></div>\n        </div>\n\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge\">\n                    Estética Avançada em Ribeirão Preto\n                </div>\n                <h1>Transforme Sua Aparência com Elegância</h1>\n                <p class=\"hero-description\">\n                    Descubra uma versão mais confiante e radiante de si mesma com tratamentos de harmonização facial personalizados, realizados por profissionais especializados.\n                </p>\n                <div class=\"hero-cta\">\n                    <a href=\"#contato\" class=\"btn btn-primary\">\n                        Agendar Consulta\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                            <polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                    <a href=\"#servicos\" class=\"btn btn-secondary\">\n                        Conhecer Serviços\n                    </a>\n                </div>\n            </div>\n\n            <div class=\"hero-visual\">\n                <div class=\"hero-image-wrapper\">\n                    <div class=\"hero-image-frame\"></div>\n                    <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=600&h=800&fit=crop&crop=faces\" alt=\"Harmonização Facial\" class=\"hero-image\">\n\n                    <div class=\"hero-floating-card hero-floating-card-1\">\n                        <div class=\"floating-card-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path>\n                            </svg>\n                        </div>\n                        <div class=\"floating-card-text\">+5.000 pacientes satisfeitas</div>\n                    </div>\n\n                    <div class=\"hero-floating-card hero-floating-card-2\">\n                        <div class=\"floating-card-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path>\n                                <polyline points=\"22 4 12 14.01 9 11.01\"></polyline>\n                            </svg>\n                        </div>\n                        <div class=\"floating-card-text\">Resultados naturais e duradouros</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\" id=\"problema-solucao\">\n        <div class=\"section-header\">\n            <span class=\"section-tag\">Sua Jornada</span>\n            <h2 class=\"section-title\">Descubra uma Nova Versão de Si Mesma</h2>\n            <p class=\"section-description\">\n                Entendemos seus desejos e oferecemos soluções personalizadas que realçam sua beleza natural com segurança e excelência.\n            </p>\n        </div>\n\n        <div class=\"ps-grid\">\n            <div class=\"ps-card wow-fade-up\" data-delay=\"0\">\n                <div class=\"ps-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                        <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line>\n                        <line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line>\n                    </svg>\n                </div>\n                <h3>O Desafio</h3>\n                <p>\n                    Sinais de envelhecimento, assimetrias faciais ou simplesmente o desejo de realçar seus traços naturais podem afetar sua autoestima. Sabemos que cada rosto é único e merece atenção personalizada.\n                </p>\n            </div>\n\n            <div class=\"ps-card wow-fade-up\" data-delay=\"200\">\n                <div class=\"ps-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path>\n                        <polyline points=\"22 4 12 14.01 9 11.01\"></polyline>\n                    </svg>\n                </div>\n                <h3>A Solução</h3>\n                <p>\n                    Com tecnologias avançadas e protocolos personalizados, transformamos sua aparência mantendo sua essência. Resultados naturais que elevam sua confiança sem perder sua identidade.\n                </p>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"section-header\">\n            <span class=\"section-tag\">Tratamentos</span>\n            <h2 class=\"section-title\">Serviços Especializados</h2>\n            <p class=\"section-description\">\n                Oferecemos uma gama completa de procedimentos estéticos faciais para atender suas necessidades únicas.\n            </p>\n        </div>\n\n        <div class=\"services-grid\">\n            <div class=\"service-card wow-fade-up\" data-delay=\"0\">\n                <div class=\"service-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"></path>\n                    </svg>\n                </div>\n                <h3>Harmonização Facial</h3>\n                <p>\n                    Equilibre seus traços faciais com técnicas avançadas que proporcionam harmonia e naturalidade aos resultados.\n                </p>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"100\">\n                <div class=\"service-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <path d=\"M9 11H5a2 2 0 0 0-2 2v3c0 1.1.9 2 2 2h4\"></path>\n                        <path d=\"M15 11h4a2 2 0 0 1 2 2v3c0 1.1-.9 2-2 2h-4\"></path>\n                        <line x1=\"12\" y1=\"12\" x2=\"12\" y2=\"18\"></line>\n                    </svg>\n                </div>\n                <h3>Toxina Botulínica</h3>\n                <p>\n                    Suavize linhas de expressão e rugas com aplicações precisas que rejuvenescem sua aparência de forma natural.\n                </p>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                <div class=\"service-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <path d=\"M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z\"></path>\n                    </svg>\n                </div>\n                <h3>Preenchedores Faciais</h3>\n                <p>\n                    Restaurhe volume e contorno facial com ácido hialurônico de alta qualidade para resultados duradouros.\n                </p>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"300\">\n                <div class=\"service-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <path d=\"M12 20h9\"></path>\n                        <path d=\"M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z\"></path>\n                    </svg>\n                </div>\n                <h3>Preenchimento Labial</h3>\n                <p>\n                    Destaque seus lábios com preenchimento que proporciona volume, contorno e hidratação natural.\n                </p>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n                <div class=\"service-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                        <path d=\"M8 14s1.5 2 4 2 4-2 4-2\"></path>\n                        <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"></line>\n                        <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"></line>\n                    </svg>\n                </div>\n                <h3>Bioestimuladores</h3>\n                <p>\n                    Estimule o colágeno natural da sua pele com tratamentos que rejuvenescem de dentro para fora.\n                </p>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"500\">\n                <div class=\"service-icon\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                        <polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon>\n                    </svg>\n                </div>\n                <h3>Protocolos Exclusivos</h3>\n                <p>\n                    Tratamentos personalizados desenvolvidos especialmente para suas necessidades e objetivos estéticos.\n                </p>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"section-header\">\n            <span class=\"section-tag\">Depoimentos</span>\n            <h2 class=\"section-title\">O Que Nossas Pacientes Dizem</h2>\n            <p class=\"section-description\">\n                Histórias reais de transformação e satisfação.\n            </p>\n        </div>\n\n        <div class=\"testimonials-grid\">\n            <div class=\"testimonial-card wow-fade-up\" data-delay=\"0\">\n                <div class=\"testimonial-stars\">\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                </div>\n                <p class=\"testimonial-quote\">\n                    \"Excelente profissional! Me senti muito acolhida desde a primeira consulta. O resultado da harmonização facial superou minhas expectativas.\"\n                </p>\n               