{"type":"assistant","message":{"id":"msg_202602090050493cfded8a9ddd4e36","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_7934af11ad8e49e4bbfa1daf","name":"Write","input":{"file_path":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/beaute-clinic/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Beauté Clinic | Dra. Suzan Salvador - Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Beauté Clinic - Dra. Suzan Salvador, especialista em harmonização facial e estética avançada em Ribeirão Preto. Transforme sua aparência com tratamentos premium.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        /* ============================================\n           PEARL & MINK NOIR AESTHETIC\n           Ultra-sophisticated, quiet luxury palette\n           ============================================ */\n        :root {\n            /* Pearl & Mink Noir Color Palette */\n            --color-pearl: #E8E4DF;\n            --color-pearl-light: #F5F2ED;\n            --color-pearl-dark: #D0CCC7;\n            --color-mink: #8B7E74;\n            --color-mink-light: #A69D94;\n            --color-mink-dark: #6B6158;\n            --color-mink-deep: #4A423C;\n            --color-rose-gold: #C9A88C;\n            --color-rose-gold-light: #DCC0A8;\n            --color-rose-gold-dark: #A88A6E;\n            --color-cream: #FAF8F5;\n            --color-charcoal: #2C2825;\n            --color-charcoal-light: #3D3834;\n\n            /* Pearl Mink Border Radius - Soft, flowing shapes */\n            --radius-pearl-1: 62% 38% 45% 55% / 58% 42% 58% 42%;\n            --radius-pearl-2: 45% 55% 38% 62% / 42% 58% 42% 58%;\n            --radius-pearl-3: 55% 45% 62% 38% / 48% 52% 48% 52%;\n            --radius-pearl-4: 38% 62% 55% 45% / 52% 48% 52% 48%;\n\n            /* Typography */\n            --font-display: 'Cormorant Garamond', serif;\n            --font-body: 'DM Sans', sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 30px rgba(139, 126, 116, 0.15);\n            --shadow-medium: 0 8px 40px rgba(139, 126, 116, 0.2);\n            --shadow-strong: 0 12px 50px rgba(44, 40, 37, 0.25);\n        }\n\n        /* ============================================\n           RESET & BASE\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background-color: var(--color-cream);\n            color: var(--color-charcoal);\n            line-height: 1.7;\n            overflow-x: hidden;\n        }\n\n        img {\n            max-width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n        }\n\n        button {\n            border: none;\n            background: none;\n            cursor: pointer;\n            font-family: inherit;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-charcoal);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 3vw, 2rem);\n        }\n\n        p {\n            font-size: 1.0625rem;\n            color: var(--color-mink-dark);\n        }\n\n        /* ============================================\n           ANIMATIONS\n           ============================================ */\n        @keyframes pearlFloat {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg);\n                border-radius: var(--radius-pearl-1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg);\n                border-radius: var(--radius-pearl-2);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg);\n                border-radius: var(--radius-pearl-3);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(3deg);\n                border-radius: var(--radius-pearl-4);\n            }\n        }\n\n        @keyframes pearlFloatReverse {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg);\n                border-radius: var(--radius-pearl-3);\n            }\n            25% {\n                transform: translate(-25px, 25px) rotate(-4deg);\n                border-radius: var(--radius-pearl-4);\n            }\n            50% {\n                transform: translate(35px, -25px) rotate(4deg);\n                border-radius: var(--radius-pearl-1);\n            }\n            75% {\n                transform: translate(-30px, -35px) rotate(-3deg);\n                border-radius: var(--radius-pearl-2);\n            }\n        }\n\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(40px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fadeIn {\n            from { opacity: 0; }\n            to { opacity: 1; }\n        }\n\n        @keyframes pulse {\n            0%, 100% {\n                transform: scale(1);\n                opacity: 1;\n            }\n            50% {\n                transform: scale(1.05);\n                opacity: 0.9;\n            }\n        }\n\n        @keyframes shimmer {\n            0% { background-position: -200% 0; }\n            100% { background-position: 200% 0; }\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: 1.25rem 5%;\n            transition: var(--transition-base);\n            background: transparent;\n        }\n\n        .nav.scrolled {\n            background: rgba(250, 248, 245, 0.95);\n            backdrop-filter: blur(10px);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .nav-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.75rem;\n            font-weight: 700;\n            color: var(--color-charcoal);\n            letter-spacing: 0.02em;\n        }\n\n        .nav-logo span {\n            color: var(--color-rose-gold);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: 2.5rem;\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-weight: 500;\n            font-size: 0.9375rem;\n            color: var(--color-charcoal);\n            letter-spacing: 0.02em;\n            position: relative;\n            padding: 0.5rem 0;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-rose-gold);\n            transition: var(--transition-fast);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.875rem 2rem;\n            background: var(--color-charcoal);\n            color: var(--color-cream) !important;\n            border-radius: 50px;\n            font-weight: 600;\n            transition: var(--transition-base);\n        }\n\n        .nav-cta:hover {\n            background: var(--color-rose-gold);\n            transform: translateY(-2px);\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        .mobile-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .mobile-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-charcoal);\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            position: relative;\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            padding: 8rem 5% 4rem;\n            overflow: hidden;\n            background: linear-gradient(135deg, var(--color-pearl-light) 0%, var(--color-cream) 100%);\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-pearl-1);\n            filter: blur(80px);\n            opacity: 0.5;\n            animation: pearlFloat 20s ease-in-out infinite;\n            pointer-events: none;\n        }\n\n        .hero-blob-1 {\n            width: 500px;\n            height: 500px;\n            background: linear-gradient(135deg, var(--color-pearl) 0%, var(--color-pearl-light) 100%);\n            top: 10%;\n            left: -10%;\n        }\n\n        .hero-blob-2 {\n            width: 400px;\n            height: 400px;\n            background: linear-gradient(225deg, var(--color-rose-gold) 0%, var(--color-rose-gold-light) 100%);\n            top: 20%;\n            right: -5%;\n            animation-delay: -5s;\n        }\n\n        .hero-blob-3 {\n            width: 350px;\n            height: 350px;\n            background: linear-gradient(45deg, var(--color-mink-light) 0%, var(--color-pearl) 100%);\n            bottom: 10%;\n            left: 30%;\n            animation-delay: -10s;\n            opacity: 0.4;\n        }\n\n        .hero-blob-4 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(315deg, var(--color-rose-gold-light) 0%, var(--color-pearl) 100%);\n            bottom: 20%;\n            right: 20%;\n            animation: pearlFloatReverse 18s ease-in-out infinite;\n            opacity: 0.3;\n        }\n\n        .hero-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .hero-content {\n            opacity: 0;\n            animation: fadeInUp 0.8s ease forwards;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 0.5rem 1rem;\n            background: var(--color-pearl);\n            border-radius: 50px;\n            font-size: 0.875rem;\n            font-weight: 500;\n            color: var(--color-mink-dark);\n            margin-bottom: 1.5rem;\n        }\n\n        .hero-badge-dot {\n            width: 8px;\n            height: 8px;\n            background: var(--color-rose-gold);\n            border-radius: 50%;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        .hero-title {\n            margin-bottom: 1.5rem;\n            color: var(--color-charcoal);\n        }\n\n        .hero-title span {\n            color: var(--color-rose-gold);\n            font-style: italic;\n        }\n\n        .hero-subtitle {\n            font-size: 1.25rem;\n            color: var(--color-mink-dark);\n            margin-bottom: 2rem;\n            max-width: 500px;\n        }\n\n        .hero-cta-group {\n            display: flex;\n            gap: 1rem;\n            flex-wrap: wrap;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2.5rem;\n            border-radius: 50px;\n            font-weight: 600;\n            font-size: 1rem;\n            transition: var(--transition-base);\n            cursor: pointer;\n        }\n\n        .btn-primary {\n            background: var(--color-charcoal);\n            color: var(--color-cream);\n        }\n\n        .btn-primary:hover {\n            background: var(--color-rose-gold);\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-charcoal);\n            border: 2px solid var(--color-mink);\n        }\n\n        .btn-secondary:hover {\n            border-color: var(--color-charcoal);\n            background: var(--color-charcoal);\n            color: var(--color-cream);\n        }\n\n        .hero-image {\n            position: relative;\n            opacity: 0;\n            animation: fadeInUp 0.8s ease 0.2s forwards;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            border-radius: var(--radius-pearl-1);\n            overflow: hidden;\n            box-shadow: var(--shadow-strong);\n        }\n\n        .hero-image-wrapper img {\n            width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        .hero-float-card {\n            position: absolute;\n            background: rgba(255, 255, 255, 0.95);\n            backdrop-filter: blur(10px);\n            padding: 1.25rem 1.75rem;\n            border-radius: 20px;\n            box-shadow: var(--shadow-medium);\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n            animation: pearlFloat 15s ease-in-out infinite;\n        }\n\n        .hero-float-card-1 {\n            top: 10%;\n            left: -30px;\n        }\n\n        .hero-float-card-2 {\n            bottom: 15%;\n            right: -30px;\n            animation-delay: -7s;\n        }\n\n        .hero-float-icon {\n            width: 50px;\n            height: 50px;\n            background: linear-gradient(135deg, var(--color-rose-gold) 0%, var(--color-rose-gold-light) 100%);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-size: 1.25rem;\n        }\n\n        .hero-float-text strong {\n            display: block;\n            font-size: 0.875rem;\n            color: var(--color-charcoal);\n        }\n\n        .hero-float-text span {\n            font-size: 0.75rem;\n            color: var(--color-mink-dark);\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            padding: var(--spacing-xl) 5%;\n            background: var(--color-cream);\n        }\n\n        .section-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-slow);\n        }\n\n        .section-header.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .section-label {\n            display: inline-block;\n            font-size: 0.875rem;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 0.15em;\n            color: var(--color-rose-gold);\n            margin-bottom: 1rem;\n        }\n\n        .section-title {\n            margin-bottom: 1rem;\n        }\n\n        .section-description {\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 2rem;\n        }\n\n        .problem-card,\n        .solution-card {\n            background: white;\n            padding: 3rem;\n            border-radius: 30px;\n            position: relative;\n            overflow: hidden;\n            box-shadow: var(--shadow-soft);\n            transition: var(--transition-base);\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .problem-card.visible,\n        .solution-card.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .problem-card:hover,\n        .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .problem-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 4px;\n            height: 100%;\n            background: var(--color-mink);\n        }\n\n        .solution-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 4px;\n            height: 100%;\n            background: var(--color-rose-gold);\n        }\n\n        .card-icon {\n            width: 60px;\n            height: 60px;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.5rem;\n            margin-bottom: 1.5rem;\n        }\n\n        .problem-card .card-icon {\n            background: var(--color-pearl);\n            color: var(--color-mink-dark);\n        }\n\n        .solution-card .card-icon {\n            background: linear-gradient(135deg, var(--color-rose-gold) 0%, var(--color-rose-gold-light) 100%);\n            color: white;\n        }\n\n        .card-title {\n            font-size: 1.5rem;\n            margin-bottom: 1rem;\n        }\n\n        .card-list {\n            list-style: none;\n            margin-top: 1.5rem;\n        }\n\n        .card-list li {\n            padding: 0.75rem 0;\n            border-bottom: 1px solid var(--color-pearl);\n            display: flex;\n            align-items: center;\n            gap: 0.75rem;\n            font-size: 0.9375rem;\n        }\n\n        .card-list li:last-child {\n            border-bottom: none;\n        }\n\n        .card-list li::before {\n            content: '•';\n            color: var(--color-rose-gold);\n            font-size: 1.25rem;\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            padding: var(--spacing-xl) 5%;\n            background: linear-gradient(180deg, var(--color-pearl-light) 0%, var(--color-cream) 100%);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .service-card {\n            background: white;\n            padding: 2.5rem;\n            border-radius: 30px;\n            box-shadow: var(--shadow-soft);\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .service-card.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: -50%;\n            right: -50%;\n            width: 100%;\n            height: 100%;\n            background: radial-gradient(circle, var(--color-rose-gold-light) 0%, transparent 70%);\n            opacity: 0;\n            transition: var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            opacity: 0.1;\n        }\n\n        .service-icon {\n            width: 70px;\n            height: 70px;\n            background: linear-gradient(135deg, var(--color-pearl) 0%, var(--color-pearl-light) 100%);\n            border-radius: 20px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 2rem;\n            margin-bottom: 1.5rem;\n            transition: var(--transition-base);\n        }\n\n        .service-card:hover .service-icon {\n            background: linear-gradient(135deg, var(--color-rose-gold) 0%, var(--color-rose-gold-light) 100%);\n            transform: scale(1.05);\n        }\n\n        .service-title {\n            font-size: 1.375rem;\n            margin-bottom: 1rem;\n        }\n\n        .service-description {\n            font-size: 0.9375rem;\n            color: var(--color-mink-dark);\n            margin-bottom: 1.5rem;\n            line-height: 1.6;\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-rose-gold);\n            font-weight: 600;\n            font-size: 0.875rem;\n            transition: var(--transition-fast);\n        }\n\n        .service-link:hover {\n            gap: 1rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            padding: var(--spacing-xl) 5%;\n            background: var(--color-mink-deep);\n            color: var(--color-cream);\n        }\n\n        .testimonials .section-header {\n            color: var(--color-cream);\n        }\n\n        .testimonials .section-label {\n            color: var(--color-rose-gold);\n        }\n\n        .testimonials .section-title {\n            color: var(--color-cream);\n        }\n\n        .testimonials .section-description {\n            color: var(--color-pearl);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(10px);\n            padding: 2.5rem;\n            border-radius: 30px;\n            border: 1px solid rgba(201, 168, 140, 0.2);\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-base);\n        }\n\n        .testimonial-card.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .testimonial-card:hover {\n            background: rgba(255, 255, 255, 0.08);\n            transform: translateY(-5px);\n        }\n\n        .testimonial-stars {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: 1.5rem;\n            color: var(--color-rose-gold);\n            font-size: 1.25rem;\n        }\n\n        .testimonial-quote {\n            font-size: 1.0625rem;\n            color: var(--color-pearl);\n            margin-bottom: 1.5rem;\n            line-height: 1.7;\n            font-style: italic;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: linear-gradient(135deg, var(--color-rose-gold) 0%, var(--color-pearl) 100%);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: var(--color-charcoal);\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n            color: var(--color-cream);\n        }\n\n        .testimonial-role {\n            font-size: 0.875rem;\n            color: var(--color-mink-light);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            padding: var(--spacing-xl) 5%;\n            background: var(--color-cream);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .differential-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1.25rem;\n            padding: 2rem;\n            background: white;\n            border-radius: 25px;\n            box-shadow: var(--shadow-soft);\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-base);\n        }\n\n        .differential-item.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .differential-item:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            flex-shrink: 0;\n        }\n\n        .differential-icon {\n            width: 55px;\n            height: 55px;\n            background: linear-gradient(135deg, var(--color-pearl) 0%, var(--color-pearl-light) 100%);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.5rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .differential-icon-wrapper::after {\n            content: '';\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 70px;\n            height: 70px;\n            border-radius: 50%;\n            border: 2px solid var(--color-rose-gold);\n            opacity: 0.3;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        .differential-content h4 {\n            font-size: 1.125rem;\n            margin-bottom: 0.5rem;\n        }\n\n        .differential-content p {\n            font-size: 0.9375rem;\n            color: var(--color-mink-dark);\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            padding: var(--spacing-xl) 5%;\n            background: linear-gradient(180deg, var(--color-pearl-light) 0%, var(--color-pearl) 100%);\n        }\n\n        .contact-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: center;\n        }\n\n        .contact-info {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-slow);\n        }\n\n        .contact-info.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .contact-title {\n            margin-bottom: 1.5rem;\n        }\n\n        .contact-description {\n            margin-bottom: 2rem;\n        }\n\n        .contact-details {\n            display: flex;\n            flex-direction: column;\n            gap: 1.5rem;\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .contact-item-icon {\n            width: 50px;\n            height: 50px;\n            background: white;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-rose-gold);\n            font-size: 1.25rem;\n            box-shadow: var(--shadow-soft);\n        }\n\n        .contact-item-text strong {\n            display: block;\n            font-size: 0.875rem;\n            color: var(--color-mink-dark);\n        }\n\n        .contact-item-text span {\n            color: var(--color-charcoal);\n            font-weight: 500;\n        }\n\n        .contact-form-wrapper {\n            background: white;\n            padding: 3rem;\n            border-radius: 35px;\n            box-shadow: var(--shadow-medium);\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-slow);\n        }\n\n        .contact-form-wrapper.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .contact-form {\n            display: flex;\n            flex-direction: column;\n            gap: 1.5rem;\n        }\n\n        .form-group {\n            display: flex;\n            flex-direction: column;\n            gap: 0.5rem;\n        }\n\n        .form-label {\n            font-size: 0.875rem;\n            font-weight: 600;\n            color: var(--color-charcoal);\n        }\n\n        .form-input,\n        .form-select,\n        .form-textarea {\n            padding: 1rem 1.25rem;\n            border: 2px solid var(--color-pearl);\n            border-radius: 15px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            color: var(--color-charcoal);\n            background: var(--color-cream);\n            transition: var(--transition-fast);\n        }\n\n        .form-input:focus,\n        .form-select:focus,\n        .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-rose-gold);\n            background: white;\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            padding: 1.125rem 2.5rem;\n            background: var(--color-charcoal);\n            color: var(--color-cream);\n            border: none;\n            border-radius: 50px;\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .form-submit:hover {\n            background: var(--color-rose-gold);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            padding: var(--spacing-lg) 5% 2rem;\n            background: var(--color-charcoal);\n            color: var(--color-cream);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: 4rem;\n            margin-bottom: 3rem;\n        }\n\n        .footer-brand .footer-logo {\n            font-family: var(--font-display);\n            font-size: 2rem;\n            font-weight: 700;\n            margin-bottom: 1rem;\n        }\n\n        .footer-brand .footer-logo span {\n            color: var(--color-rose-gold);\n        }\n\n        .footer-description {\n            color: var(--color-mink-light);\n            font-size: 0.9375rem;\n            margin-bottom: 1.5rem;\n        }\n\n        .footer-social {\n            display: flex;\n            gap: 1rem;\n        }\n\n        .footer-social a {\n            width: 45px;\n            height: 45px;\n            background: rgba(255, 255, 255, 0.1);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: var(--transition-base);\n        }\n\n        .footer-social a:hover {\n            background: var(--color-rose-gold);\n            transform: translateY(-3px);\n        }\n\n        .footer-column h4 {\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            color: var(--color-cream);\n            margin-bottom: 1.5rem;\n        }\n\n        .footer-links {\n            list-style: none;\n            display: flex;\n            flex-direction: column;\n            gap: 0.75rem;\n        }\n\n        .footer-links a {\n            color: var(--color-mink-light);\n            font-size: 0.9375rem;\n            transition: var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-rose-gold);\n            padding-left: 5px;\n        }\n\n        .footer-bottom {\n            padding-top: 2rem;\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            text-align: center;\n            color: var(--color-mink-dark);\n            font-size: 0.875rem;\n        }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 1024px) {\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-subtitle {\n                margin-left: auto;\n                margin-right: auto;\n            }\n\n            .hero-cta-group {\n                justify-content: center;\n            }\n\n            .hero-float-card {\n                display: none;\n            }\n\n            .problem-solution-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .contact-container {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-content {\n                grid-template-columns: 1fr;\n                gap: 2rem;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 0;\n                right: -100%;\n                width: 80%;\n                max-width: 300px;\n                height: 100vh;\n                background: var(--color-cream);\n                flex-direction: column;\n                padding: 6rem 2rem 2rem;\n                gap: 1.5rem;\n                transition: var(--transition-base);\n                box-shadow: var(--shadow-strong);\n            }\n\n            .nav-menu.active {\n                right: 0;\n            }\n\n            .mobile-toggle {\n                display: flex;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .section-container {\n                padding: 0;\n            }\n\n            .hero {\n                padding: 6rem 5% 2rem;\n            }\n\n            .hero-blob {\n                opacity: 0.3;\n            }\n\n            .contact-form-wrapper {\n                padding: 2rem;\n            }\n        }\n\n        @media (max-width: 480px) {\n            h1 {\n                font-size: 2rem;\n            }\n\n            .btn {\n                width: 100%;\n                justify-content: center;\n            }\n\n            .hero-cta-group {\n                flex-direction: column;\n            }\n\n            .problem-card,\n            .solution-card {\n                padding: 2rem;\n            }\n\n            .service-card,\n            .testimonial-card {\n                padding: 2rem;\n            }\n        }\n\n        /* ============================================\n           ACCESSIBILITY\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *,\n            *::before,\n            *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        .sr-only {\n            position: absolute;\n            width: 1px;\n            height: 1px;\n            padding: 0;\n            margin: -1px;\n            overflow: hidden;\n            clip: rect(0, 0, 0, 0);\n            white-space: nowrap;\n            border: 0;\n        }\n\n        /* Focus styles */\n        a:focus,\n        button:focus,\n        input:focus,\n        select:focus,\n        textarea:focus {\n            outline: 3px solid var(--color-rose-gold);\n            outline-offset: 2px;\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Beauté <span>Clinic</span></a>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#home\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#services\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#testimonials\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#differentials\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contact\" class=\"nav-link nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <div class=\"mobile-toggle\" id=\"mobileToggle\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-blob hero-blob-1\"></div>\n        <div class=\"hero-blob hero-blob-2\"></div>\n        <div class=\"hero-blob hero-blob-3\"></div>\n        <div class=\"hero-blob hero-blob-4\"></div>\n\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge\">\n                    <span class=\"hero-badge-dot\"></span>\n                    Dra. Suzan Salvador\n                </div>\n                <h1 class=\"hero-title\">\n                    Sua beleza única,<br>\n                    <span>elevada à perfeição</span>\n                </h1>\n                <p class=\"hero-subtitle\">\n                    Especialista em harmonização facial e estética avançada. Resultados naturais que realçam sua essência.\n                </p>\n                <div class=\"hero-cta-group\">\n                    <a href=\"#contact\" class=\"btn btn-primary\">Agendar Consulta</a>\n                    <a href=\"#services\" class=\"btn btn-secondary\">Conhecer Tratamentos</a>\n                </div>\n            </div>\n            <div class=\"hero-image\">\n                <div class=\"hero-image-wrapper\">\n                    <img src=\"https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=800&h=1000&fit=crop&crop=face\" alt=\"Dra. Suzan Salvador - Beauté Clinic\" loading=\"lazy\">\n                </div>\n                <div class=\"hero-float-card hero-float-card-1\">\n                    <div class=\"hero-float-icon\">✓</div>\n                    <div class=\"hero-float-text\">\n                        <strong>+5.000</strong>\n                        <span>Atendimentos Realizados</span>\n                    </div>\n                </div>\n                <div class=\"hero-float-card hero-float-card-2\">\n                    <div class=\"hero-float-icon\">★</div>\n                    <div class=\"hero-float-text\">\n                        <strong>4.9/5</strong>\n                        <span>Avaliação Média</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"problem-solution\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">Transformação Real</span>\n                <h2 class=\"section-title\">Sua confiança renovada</h2>\n                <p class=\"section-description\">Entendemos as inseguranças que afetam sua autoestima e oferecemos soluções que valorizam sua beleza natural.</p>\n            </div>\n\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card\" data-delay=\"0\">\n                    <div class=\"card-icon\">✦</div>\n                    <h3 class=\"card-title\">O Desafio</h3>\n                    <p>Sinais de envelhecimento, assimetrias faciais ou perda de volume podem impactar sua autoestima e confiança.</p>\n                    <ul class=\"card-list\">\n                        <li>Rugas e linhas de expressão</li>\n                        <li>Perda de contorno facial</li>\n                        <li>Assimetrias que incomodam</li>\n                        <li>Sensação de aparência cansada</li>\n                    </ul>\n                </div>\n\n                <div class=\"solution-card\" data-delay=\"200\">\n                    <div class=\"card-icon\">✓</div>\n                    <h3 class=\"card-title\">A Solução Beauté</h3>\n                    <p>Protocolos personalizados que harmonizam seus traços naturais, com resultados sutis e elegantes.</p>\n                    <ul class=\"card-list\">\n                        <li>Harmonização facial natural</li>\n                        <li>Toxina botulínica preventiva</li>\n                        <li>Preenchedores de qualidade</li>\n                        <li>Acompanhamento dedicado</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"services\" id=\"services\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">Tratamentos Exclusivos</span>\n                <h2 class=\"section-title\">Estética avançada</h2>\n                <p class=\"section-description\">Procedimentos realizados com técnicas modernas e produtos de alta qualidade para sua segurança.</p>\n            </div>\n\n            <div class=\"services-grid\">\n                <div class=\"service-card\" data-delay=\"0\">\n                    <div class=\"service-icon\">✦</div>\n                    <h3 class=\"service-title\">Harmonização Facial</h3>\n                    <p class=\"service-description\">Equilíbrio dos traços faciais com preenchedores, realçando sua beleza natural com resultados sutis.</p>\n                    <a href=\"#contact\" class=\"service-link\">Agendar →</a>\n                </div>\n\n                <div class=\"service-card\" data-delay=\"100\">\n                    <div class=\"service-icon\">✧</div>\n                    <h3 class=\"service-title\">Toxina Botulínica</h3>\n                    <p class=\"service-description\">Suavização de rugas e linhas de expressão, prevenindo novos sinais de envelhecimento facial.</p>\n                    <a href=\"#contact\" class=\"service-link\">Agendar →</a>\n                </div>\n\n                <div class=\"service-card\" data-delay=\"200\">\n                    <div class=\"service-icon\">◈</div>\n                    <h3 class=\"service-title\">Preenchedores Faciais</h3>\n                    <p class=\"service-description\">Restauração de volume e contorno facial, com ácido hialurônico de alta qualidade.</p>\n                    <a href=\"#contact\" class=\"service-link\">Agendar →</a>\n                </div>\n\n                <div class=\"service-card\" data-delay=\"300\">\n                    <div class=\"service-icon\">❋</div>\n                    <h3 class=\"service-title\">Preenchimento Labial</h3>\n                    <p class=\"service-description\">Aumento e contorno dos lábios com técnicas que proporcionam naturalidade e equilíbrio.</p>\n                    <a href=\"#contact\" class=\"service-link\">Agendar →</a>\n                </div>\n\n                <div class=\"service-card\" data-delay=\"400\">\n                    <div class=\"service-icon\">✤</div>\n                    <h3 class=\"service-title\">Bioestimuladores</h3>\n                    <p class=\"service-description\">Estímulo de colágeno para firmeza e qualidade da pele, com resultados progressivos e duradouros.</p>\n                    <a href=\"#contact\" class=\"service-link\">Agendar →</a>\n                </div>\n\n                <div class=\"service-card\" data-delay=\"500\">\n                    <div class=\"service-icon\">★</div>\n                    <h3 class=\"service-title\">Protocolos Exclusivos</h3>\n                    <p class=\"service-description\">Combinações personalizadas de tratamentos para resultados otimizados e naturais.</p>\n                    <a href=\"#contact\" class=\"service-link\">Agendar →</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"testimonials\" id=\"testimonials\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">Depoimentos</span>\n                <h2 class=\"section-title\">O que dizem nossas clientes</h2>\n                <p class=\"section-description\">Histórias reais de transformação e satisfação com os resultados alcançados.</p>\n            </div>\n\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card\" data-delay=\"0\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-quote\">\"A Dra. Suzan tem mãos de fada! Fiz harmonização facial e o resultado foi super natural. Todo mundo diz que estou 'iluminada' mas não conseguem pontuar o que foi feito. Exatamente o que eu queria!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div>\n                            <div class=\"testimonial-name\">Marina Costa</div>\n                            <div class=\"testimonial-role\">Empresária, 34 anos</div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card\" data-delay=\"200\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-quote\">\"Preço justo, resultado impecável. A Dra. Suzan é muito atenciosa e explica tudo sobre o procedimento. Me sinto mais confiante e bonita. Recomendo de olhos fechados!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AL</div>\n                        <div>\n                            <div class=\"testimonial-name\">Ana Luiza</div>\n                            <div class=\"testimonial-role\">Advogada, 28 anos</div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card\" data-delay=\"400\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-quote\">\"Já fiz preenchimento labial e toxina botulínica. A clinica é linda, limpa e a equipe é super simpática. A Dra. Suzan é muito profissional e competente. Amei os resultados!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">PS</div>\n                        <div>\n                            <div class=\"testimonial-name\">Patrícia Silva</div>\n                            <div class=\"testimonial-role\">Arquiteta, 41 anos</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"differentials\" id=\"differentials\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">Por que Beauté Clinic</span>\n                <h2 class=\"section-title\">Diferenciais exclusivos</h2>\n                <p class=\"section-description\">Compromisso com sua segurança, satisfação e resultados que superam expectativas.</p>\n            </div>\n\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item\" data-delay=\"0\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">✓</div>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h4>Profissional Certificada</h4>\n                        <p>Dra. Suzan Salvador é especialista em estética avançada com formação continuada.</p>\n                    </div>\n                </div>\n\n                <div class=\"differential-item\" data-delay=\"100\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">★</div>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h4>Produtos de Qualidade</h4>\n                        <p>Utilizamos apenas preenchedores e toxina botulínica de origem certificada e comprovada.</p>\n                    </div>\n                </div>\n\n                <div class=\"differential-item\" data-delay=\"200\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">◈</div>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h4>Resultados Naturais</h4>\n                        <p>Foco na harmonização e naturalidade, realçando sua beleza sem exageros.</p>\n                    </div>\n                </div>\n\n                <div class=\"differential-item\" data-delay=\"300\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">✦</div>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h4>Atendimento Personalizado</h4>\n                        <p>Cada paciente recebe um protocolo individualizado conforme suas necessidades.</p>\n                    </div>\n                </div>\n\n                <div class=\"differential-item\" data-delay=\"400\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">✤</div>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h4>Ambiente Seguro</h4>\n                        <p>Clínica equipada e seguir todos os protocolos de assepsia e segurança.</p>\n                    </div>\n                </div>\n\n                <div class=\"differential-item\" data-delay=\"500\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">❋</div>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h4>Acompanhamento</h4>\n                        <p>Suporte pós-procedimento e acompanhamento da sua evolução e satisfação.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"contact\" id=\"contact\">\n        <div class=\"contact-container\">\n            <div class=\"contact-info\">\n                <h2 class=\"contact-title\">Agende sua consulta</h2>\n                <p class=\"contact-description\">Entre em contato para transformar sua autoestima. Respondemos em até 24 horas úteis.</p>\n\n                <div class=\"contact-details\">\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">📍</div>\n                        <div class=\"contact-item-text\">\n                            <strong>Endereço</strong>\n                            <span>R. Adolfo Serra, 1352 - Alto da Boa Vista, Ribeirão Preto - SP, 14025-520</span>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">📱</div>\n                        <div class=\"contact-item-text\">\n                            <strong>WhatsApp</strong>\n                            <span>(16) 99728-7401</span>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">✉</div>\n                        <div class=\"contact-item-text\">\n                            <strong>Email</strong>\n                            <span>contato@beauteclinic.com.br</span>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">🕐</div>\n                        <div class=\"contact-item-text\">\n                            <strong>Horário</strong>\n                            <span>Seg - Sex: 9h às 19h | Sáb: 9h às 14h</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"contact-form-wrapper\">\n                <form class=\"contact-form\" id=\"contactForm\">\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"name\">Nome Completo</label>\n                        <input type=\"text\" class=\"form-input\" id=\"name\" name=\"name\" placeholder=\"Seu nome\" required>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"phone\">Telefone/WhatsApp</label>\n                        <input type=\"tel\" class=\"form-input\" id=\"phone\" name=\"phone\" placeholder=\"(16) 99999-9999\" required>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"service\">Tratamento de Interesse</label>\n                        <select class=\"form-select\" id=\"service\" name=\"service\" required>\n                            <option value=\"\">Selecione uma opção</option>\n                            <option value=\"Harmonização Facial\">Harmonização Facial</option>\n                            <option value=\"Toxina Botulínica\">Toxina Botulínica</option>\n                            <option value=\"Preenchedores Faciais\">Preenchedores Faciais</option>\n                            <option value=\"Preenchimento Labial\">Preenchimento Labial</option>\n                            <option value=\"Bioestimuladores\">Bioestimuladores</option>\n                            <option value=\"Protocolos Exclusivos\">Protocolos Exclusivos</option>\n                            <option value=\"Outros\">Outros</option>\n                        </select>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"message\">Mensagem (opcional)</label>\n                        <textarea class=\"form-textarea\" id=\"message\" name=\"message\" placeholder=\"Conte-nos mais sobre o que você busca...\"></textarea>\n                    </div>\n\n                    <button type=\"submit\" class=\"form-submit\">Enviar Mensagem</button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-brand\">\n                    <div class=\"footer-logo\">Beauté <span>Clinic</span></div>\n                    <p class=\"footer-description\">Transformando vidas através da estética avançada. Sua beleza única, elevada à perfeição.</p>\n                    <div class=\"footer-social\">\n                        <a href=\"#\" aria-label=\"Instagram\">IG</a>\n                        <a href=\"#\" aria-label=\"Facebook\">FB</a>\n                        <a href=\"#\" aria-label=\"WhatsApp\">WA</a>\n                    </div>\n                </div>\n\n                <div class=\"footer-column\">\n                    <h4>Links Rápidos</h4>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#home\">Início</a></li>\n                        <li><a href=\"#services\">Tratamentos</a></li>\n                        <li><a href=\"#testimonials\">Depoimentos</a></li>\n                        <li><a href=\"#contact\">Contato</a></li>\n                    </ul>\n                </div>\n\n                <div class=\"footer-column\">\n                    <h4>Tratamentos</h4>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#services\">Harmonização Facial</a></li>\n                        <li><a href=\"#services\">Toxina Botulínica</a></li>\n                        <li><a href=\"#services\">Preenchedores</a></li>\n                        <li><a href=\"#services\">Bioestimuladores</a></li>\n                    </ul>\n                </div>\n            </div>\n\n            <div class=\"footer-bottom\">\n                <p>&copy; 2024 Beauté Clinic. Todos os direitos reservados. Dra. Suzan Salvador - Harmonização Facial em Ribeirão Preto</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION SCROLL EFFECT\n        // ============================================\n        const nav = document.getElementById('nav');\n        let lastScroll = 0;\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                nav.classList.add('scrolled');\n            } else {\n                nav.classList.remove('scrolled');\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // ============================================\n        // MOBILE MENU TOGGLE\n        // ============================================\n        const mobileToggle = document.getElementById('mobileToggle');\n        const navMenu = document.getElementById('navMenu');\n\n        mobileToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close menu when clicking on links\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER ANIMATIONS\n        // ============================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || 0;\n                    setTimeout(() => {\n                        entry.target.classList.add('visible');\n                    }, delay);\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        // Observe elements\n        document.querySelectorAll('.section-header, .problem-card, .solution-card, .service-card, .testimonial-card, .differential-item, .contact-info, .contact-form-wrapper').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // CONTACT FORM - WHATSAPP INTEGRATION\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const whatsappNumber = '5516997287401';\n            const whatsappMessage = encodeURIComponent(\n                `Olá! Meu nome é ${name}.\\n` +\n                `Telefone: ${phone}\\n` +\n                `Interesse: ${service}\\n` +\n                `Mensagem: ${message || 'Gostaria de agendar uma consulta.'}`\n            );\n\n            const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;\n            window.open(whatsappUrl, '_blank');\n\n            // Optional: reset form\n            contactForm.reset();\n        });\n\n        // ============================================\n        // PARALLAX EFFECT ON BLOBS\n        // ============================================\n        document.addEventListener('mousemove', (e) => {\n            const blobs = document.querySelectorAll('.hero-blob');\n            const x = (e.clientX / window.innerWidth - 0.5) * 20;\n            const y = (e.clientY / window.innerHeight - 0.5) * 20;\n\n            blobs.forEach((blob, index) => {\n                const speed = (index + 1) * 0.3;\n                blob.style.transform = `translate(${x * speed}px, ${y * speed}px)`;\n            });\n        });\n\n        // ============================================\n        // REDUCED MOTION SUPPORT\n        // ============================================\n        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n            document.querySelectorAll('.hero-blob').forEach(blob => {\n                blob.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"10cf803c-31eb-4202-88c0-e304b8e75670","uuid":"f6ffd245-a0da-4c73-b3dd-3dcbf23648b1"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_7934af11ad8e49e4bbfa1daf","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/beaute-clinic/index.html"}]},"parent_tool_use_id":null,"session_id":"10cf803c-31eb-4202-88c0-e304b8e75670","uuid":"eb38a1b4-5069-4c83-a032-16ee8a75a586","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/beaute-clinic/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Beauté Clinic | Dra. Suzan Salvador - Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Beauté Clinic - Dra. Suzan Salvador, especialista em harmonização facial e estética avançada em Ribeirão Preto. Transforme sua aparência com tratamentos premium.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        /* ============================================\n           PEARL & MINK NOIR AESTHETIC\n           Ultra-sophisticated, quiet luxury palette\n           ============================================ */\n        :root {\n            /* Pearl & Mink Noir Color Palette */\n            --color-pearl: #E8E4DF;\n            --color-pearl-light: #F5F2ED;\n            --color-pearl-dark: #D0CCC7;\n            --color-mink: #8B7E74;\n            --color-mink-light: #A69D94;\n            --color-mink-dark: #6B6158;\n            --color-mink-deep: #4A423C;\n            --color-rose-gold: #C9A88C;\n            --color-rose-gold-light: #DCC0A8;\n            --color-rose-gold-dark: #A88A6E;\n            --color-cream: #FAF8F5;\n            --color-charcoal: #2C2825;\n            --color-charcoal-light: #3D3834;\n\n            /* Pearl Mink Border Radius - Soft, flowing shapes */\n            --radius-pearl-1: 62% 38% 45% 55% / 58% 42% 58% 42%;\n            --radius-pearl-2: 45% 55% 38% 62% / 42% 58% 42% 58%;\n            --radius-pearl-3: 55% 45% 62% 38% / 48% 52% 48% 52%;\n            --radius-pearl-4: 38% 62% 55% 45% / 52% 48% 52% 48%;\n\n            /* Typography */\n            --font-display: 'Cormorant Garamond', serif;\n            --font-body: 'DM Sans', sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 30px rgba(139, 126, 116, 0.15);\n            --shadow-medium: 0 8px 40px rgba(139, 126, 116, 0.2);\n            --shadow-strong: 0 12px 50px rgba(44, 40, 37, 0.25);\n        }\n\n        /* ============================================\n           RESET & BASE\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background-color: var(--color-cream);\n            color: var(--color-charcoal);\n            line-height: 1.7;\n            overflow-x: hidden;\n        }\n\n        img {\n            max-width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n        }\n\n        button {\n            border: none;\n            background: none;\n            cursor: pointer;\n            font-family: inherit;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-charcoal);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 3vw, 2rem);\n        }\n\n        p {\n            font-size: 1.0625rem;\n            color: var(--color-mink-dark);\n        }\n\n        /* ============================================\n           ANIMATIONS\n           ============================================ */\n        @keyframes pearlFloat {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg);\n                border-radius: var(--radius-pearl-1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg);\n                border-radius: var(--radius-pearl-2);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg);\n                border-radius: var(--radius-pearl-3);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(3deg);\n                border-radius: var(--radius-pearl-4);\n            }\n        }\n\n        @keyframes pearlFloatReverse {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg);\n                border-radius: var(--radius-pearl-3);\n            }\n            25% {\n                transform: translate(-25px, 25px) rotate(-4deg);\n                border-radius: var(--radius-pearl-4);\n            }\n            50% {\n                transform: translate(35px, -25px) rotate(4deg);\n                border-radius: var(--radius-pearl-1);\n            }\n            75% {\n                transform: translate(-30px, -35px) rotate(-3deg);\n                border-radius: var(--radius-pearl-2);\n            }\n        }\n\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(40px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fadeIn {\n            from { opacity: 0; }\n            to { opacity: 1; }\n        }\n\n        @keyframes pulse {\n            0%, 100% {\n                transform: scale(1);\n                opacity: 1;\n            }\n            50% {\n                transform: scale(1.05);\n                opacity: 0.9;\n            }\n        }\n\n        @keyframes shimmer {\n            0% { background-position: -200% 0; }\n            100% { background-position: 200% 0; }\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: 1.25rem 5%;\n            transition: var(--transition-base);\n            background: transparent;\n        }\n\n        .nav.scrolled {\n            background: rgba(250, 248, 245, 0.95);\n            backdrop-filter: blur(10px);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .nav-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.75rem;\n            font-weight: 700;\n            color: var(--color-charcoal);\n            letter-spacing: 0.02em;\n        }\n\n        .nav-logo span {\n            color: var(--color-rose-gold);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: 2.5rem;\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-weight: 500;\n            font-size: 0.9375rem;\n            color: var(--color-charcoal);\n            letter-spacing: 0.02em;\n            position: relative;\n            padding: 0.5rem 0;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-rose-gold);\n            transition: var(--transition-fast);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.875rem 2rem;\n            background: var(--color-charcoal);\n            color: var(--color-cream) !important;\n            border-radius: 50px;\n            font-weight: 600;\n            transition: var(--transition-base);\n        }\n\n        .nav-cta:hover {\n            background: var(--color-rose-gold);\n            transform: translateY(-2px);\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        .mobile-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .mobile-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-charcoal);\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            position: relative;\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            padding: 8rem 5% 4rem;\n            overflow: hidden;\n            background: linear-gradient(135deg, var(--color-pearl-light) 0%, var(--color-cream) 100%);\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-pearl-1);\n            filter: blur(80px);\n            opacity: 0.5;\n            animation: pearlFloat 20s ease-in-out infinite;\n            pointer-events: none;\n        }\n\n        .hero-blob-1 {\n            width: 500px;\n            height: 500px;\n            background: linear-gradient(135deg, var(--color-pearl) 0%, var(--color-pearl-light) 100%);\n            top: 10%;\n            left: -10%;\n        }\n\n        .hero-blob-2 {\n            width: 400px;\n            height: 400px;\n            background: linear-gradient(225deg, var(--color-rose-gold) 0%, var(--color-rose-gold-light) 100%);\n            top: 20%;\n            right: -5%;\n            animation-delay: -5s;\n        }\n\n        .hero-blob-3 {\n            width: 350px;\n            height: 350px;\n            background: linear-gradient(45deg, var(--color-mink-light) 0%, var(--color-pearl) 100%);\n            bottom: 10%;\n            left: 30%;\n            animation-delay: -10s;\n            opacity: 0.4;\n        }\n\n        .hero-blob-4 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(315deg, var(--color-rose-gold-light) 0%, var(--color-pearl) 100%);\n            bottom: 20%;\n            right: 20%;\n            animation: pearlFloatReverse 18s ease-in-out infinite;\n            opacity: 0.3;\n        }\n\n        .hero-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .hero-content {\n            opacity: 0;\n            animation: fadeInUp 0.8s ease forwards;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 0.5rem 1rem;\n            background: var(--color-pearl);\n            border-radius: 50px;\n            font-size: 0.875rem;\n            font-weight: 500;\n            color: var(--color-mink-dark);\n            margin-bottom: 1.5rem;\n        }\n\n        .hero-badge-dot {\n            width: 8px;\n            height: 8px;\n            background: var(--color-rose-gold);\n            border-radius: 50%;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        .hero-title {\n            margin-bottom: 1.5rem;\n            color: var(--color-charcoal);\n        }\n\n        .hero-title span {\n            color: var(--color-rose-gold);\n            font-style: italic;\n        }\n\n        .hero-subtitle {\n            font-size: 1.25rem;\n            color: var(--color-mink-dark);\n            margin-bottom: 2rem;\n            max-width: 500px;\n        }\n\n        .hero-cta-group {\n            display: flex;\n            gap: 1rem;\n            flex-wrap: wrap;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2.5rem;\n            border-radius: 50px;\n            font-weight: 600;\n            font-size: 1rem;\n            transition: var(--transition-base);\n            cursor: pointer;\n        }\n\n        .btn-primary {\n            background: var(--color-charcoal);\n            color: var(--color-cream);\n        }\n\n        .btn-primary:hover {\n            background: var(--color-rose-gold);\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-charcoal);\n            border: 2px solid var(--color-mink);\n        }\n\n        .btn-secondary:hover {\n            border-color: var(--color-charcoal);\n            background: var(--color-charcoal);\n            color: var(--color-cream);\n        }\n\n        .hero-image {\n            position: relative;\n            opacity: 0;\n            animation: fadeInUp 0.8s ease 0.2s forwards;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            border-radius: var(--radius-pearl-1);\n            overflow: hidden;\n            box-shadow: var(--shadow-strong);\n        }\n\n        .hero-image-wrapper img {\n            width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        .hero-float-card {\n            position: absolute;\n            background: rgba(255, 255, 255, 0.95);\n            backdrop-filter: blur(10px);\n            padding: 1.25rem 1.75rem;\n            border-radius: 20px;\n            box-shadow: var(--shadow-medium);\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n            animation: pearlFloat 15s ease-in-out infinite;\n        }\n\n        .hero-float-card-1 {\n            top: 10%;\n            left: -30px;\n        }\n\n        .hero-float-card-2 {\n            bottom: 15%;\n            right: -30px;\n            animation-delay: -7s;\n        }\n\n        .hero-float-icon {\n            width: 50px;\n            height: 50px;\n            background: linear-gradient(135deg, var(--color-rose-gold) 0%, var(--color-rose-gold-light) 100%);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-size: 1.25rem;\n        }\n\n        .hero-float-text strong {\n            display: block;\n            font-size: 0.875rem;\n            color: var(--color-charcoal);\n        }\n\n        .hero-float-text span {\n            font-size: 0.75rem;\n            color: var(--color-mink-dark);\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            padding: var(--spacing-xl) 5%;\n            background: var(--color-cream);\n        }\n\n        .section-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-slow);\n        }\n\n        .section-header.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .section-label {\n            display: inline-block;\n            font-size: 0.875rem;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 0.15em;\n            color: var(--color-rose-gold);\n            margin-bottom: 1rem;\n        }\n\n        .section-title {\n            margin-bottom: 1rem;\n        }\n\n        .section-description {\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 2rem;\n        }\n\n        .problem-card,\n        .solution-card {\n            background: white;\n            padding: 3rem;\n            border-radius: 30px;\n            position: relative;\n            overflow: hidden;\n            box-shadow: var(--shadow-soft);\n            transition: var(--transition-base);\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .problem-card.visible,\n        .solution-card.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .problem-card:hover,\n        .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .problem-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 4px;\n            height: 100%;\n            background: var(--color-mink);\n        }\n\n        .solution-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 4px;\n            height: 100%;\n            background: var(--color-rose-gold);\n        }\n\n        .card-icon {\n            width: 60px;\n            height: 60px;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.5rem;\n            margin-bottom: 1.5rem;\n        }\n\n        .problem-card .card-icon {\n            background: var(--color-pearl);\n            color: var(--color-mink-dark);\n        }\n\n        .solution-card .card-icon {\n            background: linear-gradient(135deg, var(--color-rose-gold) 0%, var(--color-rose-gold-light) 100%);\n            color: white;\n        }\n\n        .card-title {\n            font-size: 1.5rem;\n            margin-bottom: 1rem;\n        }\n\n        .card-list {\n            list-style: none;\n            margin-top: 1.5rem;\n        }\n\n        .card-list li {\n            padding: 0.75rem 0;\n            border-bottom: 1px solid var(--color-pearl);\n            display: flex;\n            align-items: center;\n            gap: 0.75rem;\n            font-size: 0.9375rem;\n        }\n\n        .card-list li:last-child {\n            border-bottom: none;\n        }\n\n        .card-list li::before {\n            content: '•';\n            color: var(--color-rose-gold);\n            font-size: 1.25rem;\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            padding: var(--spacing-xl) 5%;\n            background: linear-gradient(180deg, var(--color-pearl-light) 0%, var(--color-cream) 100%);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .service-card {\n            background: white;\n            padding: 2.5rem;\n            border-radius: 30px;\n            box-shadow: var(--shadow-soft);\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .service-card.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: -50%;\n            right: -50%;\n            width: 100%;\n            height: 100%;\n            background: radial-gradient(circle, var(--color-rose-gold-light) 0%, transparent 70%);\n            opacity: 0;\n            transition: var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            opacity: 0.1;\n        }\n\n        .service-icon {\n            width: 70px;\n            height: 70px;\n            background: linear-gradient(135deg, var(--color-pearl) 0%, var(--color-pearl-light) 100%);\n            border-radius: 20px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 2rem;\n            margin-bottom: 1.5rem;\n            transition: var(--transition-base);\n        }\n\n        .service-card:hover .service-icon {\n            background: linear-gradient(135deg, var(--color-rose-gold) 0%, var(--color-rose-gold-light) 100%);\n            transform: scale(1.05);\n        }\n\n        .service-title {\n            font-size: 1.375rem;\n            margin-bottom: 1rem;\n        }\n\n        .service-description {\n            font-size: 0.9375rem;\n            color: var(--color-mink-dark);\n            margin-bottom: 1.5rem;\n            line-height: 1.6;\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-rose-gold);\n            font-weight: 600;\n            font-size: 0.875rem;\n            transition: var(--transition-fast);\n        }\n\n        .service-link:hover {\n            gap: 1rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            padding: var(--spacing-xl) 5%;\n            background: var(--color-mink-deep);\n            color: var(--color-cream);\n        }\n\n        .testimonials .section-header {\n            color: var(--color-cream);\n        }\n\n        .testimonials .section-label {\n            color: var(--color-rose-gold);\n        }\n\n        .testimonials .section-title {\n            color: var(--color-cream);\n        }\n\n        .testimonials .section-description {\n            color: var(--color-pearl);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(10px);\n            padding: 2.5rem;\n            border-radius: 30px;\n            border: 1px solid rgba(201, 168, 140, 0.2);\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-base);\n        }\n\n        .testimonial-card.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .testimonial-card:hover {\n            background: rgba(255, 255, 255, 0.08);\n            transform: translateY(-5px);\n        }\n\n        .testimonial-stars {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: 1.5rem;\n            color: var(--color-rose-gold);\n            font-size: 1.25rem;\n        }\n\n        .testimonial-quote {\n            font-size: 1.0625rem;\n            color: var(--color-pearl);\n            margin-bottom: 1.5rem;\n            line-height: 1.7;\n            font-style: italic;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: linear-gradient(135deg, var(--color-rose-gold) 0%, var(--color-pearl) 100%);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: var(--color-charcoal);\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n            color: var(--color-cream);\n        }\n\n        .testimonial-role {\n            font-size: 0.875rem;\n            color: var(--color-mink-light);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            padding: var(--spacing-xl) 5%;\n            background: var(--color-cream);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .differential-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1.25rem;\n            padding: 2rem;\n            background: white;\n            border-radius: 25px;\n            box-shadow: var(--shadow-soft);\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-base);\n        }\n\n        .differential-item.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .differential-item:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            flex-shrink: 0;\n        }\n\n        .differential-icon {\n            width: 55px;\n            height: 55px;\n            background: linear-gradient(135deg, var(--color-pearl) 0%, var(--color-pearl-light) 100%);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.5rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .differential-icon-wrapper::after {\n            content: '';\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 70px;\n            height: 70px;\n            border-radius: 50%;\n            border: 2px solid var(--color-rose-gold);\n            opacity: 0.3;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        .differential-content h4 {\n            font-size: 1.125rem;\n            margin-bottom: 0.5rem;\n        }\n\n        .differential-content p {\n            font-size: 0.9375rem;\n            color: var(--color-mink-dark);\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            padding: var(--spacing-xl) 5%;\n            background: linear-gradient(180deg, var(--color-pearl-light) 0%, var(--color-pearl) 100%);\n        }\n\n        .contact-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: center;\n        }\n\n        .contact-info {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-slow);\n        }\n\n        .contact-info.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .contact-title {\n            margin-bottom: 1.5rem;\n        }\n\n        .contact-description {\n            margin-bottom: 2rem;\n        }\n\n        .contact-details {\n            display: flex;\n            flex-direction: column;\n            gap: 1.5rem;\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .contact-item-icon {\n            width: 50px;\n            height: 50px;\n            background: white;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-rose-gold);\n            font-size: 1.25rem;\n            box-shadow: var(--shadow-soft);\n        }\n\n        .contact-item-text strong {\n            display: block;\n            font-size: 0.875rem;\n            color: var(--color-mink-dark);\n        }\n\n        .contact-item-text span {\n            color: var(--color-charcoal);\n            font-weight: 500;\n        }\n\n        .contact-form-wrapper {\n            background: white;\n            padding: 3rem;\n            border-radius: 35px;\n            box-shadow: var(--shadow-medium);\n            opacity: 0;\n            transform: translateY(30px);\n            transition: var(--transition-slow);\n        }\n\n        .contact-form-wrapper.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .contact-form {\n            display: flex;\n            flex-direction: column;\n            gap: 1.5rem;\n        }\n\n        .form-group {\n            display: flex;\n            flex-direction: column;\n            gap: 0.5rem;\n        }\n\n        .form-label {\n            font-size: 0.875rem;\n            font-weight: 600;\n            color: var(--color-charcoal);\n        }\n\n        .form-input,\n        .form-select,\n        .form-textarea {\n            padding: 1rem 1.25rem;\n            border: 2px solid var(--color-pearl);\n            border-radius: 15px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            color: var(--color-charcoal);\n            background: var(--color-cream);\n            transition: var(--transition-fast);\n        }\n\n        .form-input:focus,\n        .form-select:focus,\n        .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-rose-gold);\n            background: white;\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            padding: 1.125rem 2.5rem;\n            background: var(--color-charcoal);\n            color: var(--color-cream);\n            border: none;\n            border-radius: 50px;\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .form-submit:hover {\n            background: var(--color-rose-gold);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            padding: var(--spacing-lg) 5% 2rem;\n            background: var(--color-charcoal);\n            color: var(--color-cream);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: 4rem;\n            margin-bottom: 3rem;\n        }\n\n        .footer-brand .footer-logo {\n            font-family: var(--font-display);\n            font-size: 2rem;\n            font-weight: 700;\n            margin-bottom: 1rem;\n        }\n\n        .footer-brand .footer-logo span {\n            color: var(--color-rose-gold);\n        }\n\n        .footer-description {\n            color: var(--color-mink-light);\n            font-size: 0.9375rem;\n            margin-bottom: 1.5rem;\n        }\n\n        .footer-social {\n            display: flex;\n            gap: 1rem;\n        }\n\n        .footer-social a {\n            width: 45px;\n            height: 45px;\n            background: rgba(255, 255, 255, 0.1);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: var(--transition-base);\n        }\n\n        .footer-social a:hover {\n            background: var(--color-rose-gold);\n            transform: translateY(-3px);\n        }\n\n        .footer-column h4 {\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            color: var(--color-cream);\n            margin-bottom: 1.5rem;\n        }\n\n        .footer-links {\n            list-style: none;\n            display: flex;\n            flex-direction: column;\n            gap: 0.75rem;\n        }\n\n        .footer-links a {\n            color: var(--color-mink-light);\n            font-size: 0.9375rem;\n            transition: var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-rose-gold);\n            padding-left: 5px;\n        }\n\n        .footer-bottom {\n            padding-top: 2rem;\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            text-align: center;\n            color: var(--color-mink-dark);\n            font-size: 0.875rem;\n        }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 1024px) {\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-subtitle {\n                margin-left: auto;\n                margin-right: auto;\n            }\n\n            .hero-cta-group {\n                justify-content: center;\n            }\n\n            .hero-float-card {\n                display: none;\n            }\n\n            .problem-solution-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .contact-container {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-content {\n                grid-template-columns: 1fr;\n                gap: 2rem;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 0;\n                right: -100%;\n                width: 80%;\n                max-width: 300px;\n                height: 100vh;\n                background: var(--color-cream);\n                flex-direction: column;\n                padding: 6rem 2rem 2rem;\n                gap: 1.5rem;\n                transition: var(--transition-base);\n                box-shadow: var(--shadow-strong);\n            }\n\n            .nav-menu.active {\n                right: 0;\n            }\n\n            .mobile-toggle {\n                display: flex;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .section-container {\n                padding: 0;\n            }\n\n            .hero {\n                padding: 6rem 5% 2rem;\n            }\n\n            .hero-blob {\n                opacity: 0.3;\n            }\n\n            .contact-form-wrapper {\n                padding: 2rem;\n            }\n        }\n\n        @media (max-width: 480px) {\n            h1 {\n                font-size: 2rem;\n            }\n\n            .btn {\n                width: 100%;\n                justify-content: center;\n            }\n\n            .hero-cta-group {\n                flex-direction: column;\n            }\n\n            .problem-card,\n            .solution-card {\n                padding: 2rem;\n            }\n\n            .service-card,\n            .testimonial-card {\n                padding: 2rem;\n            }\n        }\n\n        /* ============================================\n           ACCESSIBILITY\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *,\n            *::before,\n            *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        .sr-only {\n            position: absolute;\n            width: 1px;\n            height: 1px;\n            padding: 0;\n            margin: -1px;\n            overflow: hidden;\n            clip: rect(0, 0, 0, 0);\n            white-space: nowrap;\n            border: 0;\n        }\n\n        /* Focus styles */\n        a:focus,\n        button:focus,\n        input:focus,\n        select:focus,\n        textarea:focus {\n            outline: 3px solid var(--color-rose-gold);\n            outline-offset: 2px;\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Beauté <span>Clinic</span></a>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#home\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#services\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#testimonials\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#differentials\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contact\" class=\"nav-link nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <div class=\"mobile-toggle\" id=\"mobileToggle\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-blob hero-blob-1\"></div>\n        <div class=\"hero-blob hero-blob-2\"></div>\n        <div class=\"hero-blob hero-blob-3\"></div>\n        <div class=\"hero-blob hero-blob-4\"></div>\n\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge\">\n                    <span class=\"hero-badge-dot\"></span>\n                    Dra. Suzan Salvador\n                </div>\n                <h1 class=\"hero-title\">\n                    Sua beleza única,<br>\n                    <span>elevada à perfeição</span>\n                </h1>\n                <p class=\"hero-subtitle\">\n                    Especialista em harmonização facial e estética avançada. Resultados naturais que realçam sua essência.\n                </p>\n                <div class=\"hero-cta-group\">\n                    <a href=\"#contact\" class=\"btn btn-primary\">Agendar Consulta</a>\n                    <a href=\"#services\" class=\"btn btn-secondary\">Conhecer Tratamentos</a>\n                </div>\n            </div>\n            <div class=\"hero-image\">\n                <div class=\"hero-image-wrapper\">\n                    <img src=\"https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=800&h=1000&fit=crop&crop=face\" alt=\"Dra. Suzan Salvador - Beauté Clinic\" loading=\"lazy\">\n                </div>\n                <div class=\"hero-float-card hero-float-card-1\">\n                    <div class=\"hero-float-icon\">✓</div>\n                    <div class=\"hero-float-text\">\n                        <strong>+5.000</strong>\n                        <span>Atendimentos Realizados</span>\n                    </div>\n                </div>\n                <div class=\"hero-float-card hero-float-card-2\">\n                    <div class=\"hero-float-icon\">★</div>\n                    <div class=\"hero-float-text\">\n                        <strong>4.9/5</strong>\n                        <span>Avaliação Média</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"problem-solution\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">Transformação Real</span>\n                <h2 class=\"section-title\">Sua confiança renovada</h2>\n                <p class=\"section-description\">Entendemos as inseguranças que afetam sua autoestima e oferecemos soluções que valorizam sua beleza natural.</p>\n            </div>\n\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card\" data-delay=\"0\">\n                    <div class=\"card-icon\">✦</div>\n                    <h3 class=\"card-title\">O Desafio</h3>\n                    <p>Sinais de envelhecimento, assimetrias faciais ou perda de volume podem impactar sua autoestima e confiança.</p>\n                    <ul class=\"card-list\">\n                        <li>Rugas e linhas de expressão</li>\n                        <li>Perda de contorno facial</li>\n                        <li>Assimetrias que incomodam</li>\n                        <li>Sensação de aparência cansada</li>\n                    </ul>\n                </div>\n\n                <div class=\"solution-card\" data-delay=\"200\">\n                    <div class=\"card-icon\">✓</div>\n                    <h3 class=\"card-title\">A Solução Beauté</h3>\n                    <p>Protocolos personalizados que harmonizam seus traços naturais, com resultados sutis e elegantes.</p>\n                    <ul class=\"card-list\">\n                        <li>Harmonização facial natural</li>\n                        <li>Toxina botulínica preventiva</li>\n                        <li>Preenchedores de qualidade</li>\n                        <li>Acompanhamento dedicado</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"services\" id=\"services\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">Tratamentos Exclusivos</span>\n                <h2 class=\"section-title\">Estética avançada</h2>\n                <p class=\"section-description\">Procedimentos realizados com técnicas modernas e produtos de alta qualidade para sua segurança.</p>\n            </div>\n\n            <div class=\"services-grid\">\n                <div class=\"service-card\" data-delay=\"0\">\n                    <div class=\"service-icon\">✦</div>\n                    <h3 class=\"service-title\">Harmonização Facial</h3>\n                    <p class=\"service-description\">Equilíbrio dos traços faciais com preenchedores, realçando sua beleza natural com resultados sutis.</p>\n                    <a href=\"#contact\" class=\"service-link\">Agendar →</a>\n                </div>\n\n                <div class=\"service-card\" data-delay=\"100\">\n                    <div class=\"service-icon\">✧</div>\n                    <h3 class=\"service-title\">Toxina Botulínica</h3>\n                    <p class=\"service-description\">Suavização de rugas e linhas de expressão, prevenindo novos sinais de envelhecimento facial.</p>\n                    <a href=\"#contact\" class=\"service-link\">Agendar →</a>\n                </div>\n\n                <div class=\"service-card\" data-delay=\"200\">\n                    <div class=\"service-icon\">◈</div>\n                    <h3 class=\"service-title\">Preenchedores Faciais</h3>\n                    <p class=\"service-description\">Restauração de volume e contorno facial, com ácido hialurônico de alta qualidade.</p>\n                    <a href=\"#contact\" class=\"service-link\">Agendar →</a>\n                </div>\n\n                <div class=\"service-card\" data-delay=\"300\">\n                    <div class=\"service-icon\">❋</div>\n                    <h3 class=\"service-title\">Preenchimento Labial</h3>\n                    <p class=\"service-description\">Aumento e contorno dos lábios com técnicas que proporcionam naturalidade e equilíbrio.</p>\n                    <a href=\"#contact\" class=\"service-link\">Agendar →</a>\n                </div>\n\n                <div class=\"service-card\" data-delay=\"400\">\n                    <div class=\"service-icon\">✤</div>\n                    <h3 class=\"service-title\">Bioestimuladores</h3>\n                    <p class=\"service-description\">Estímulo de colágeno para firmeza e qualidade da pele, com resultados progressivos e duradouros.</p>\n                    <a href=\"#contact\" class=\"service-link\">Agendar →</a>\n                </div>\n\n                <div class=\"service-card\" data-delay=\"500\">\n                    <div class=\"service-icon\">★</div>\n                    <h3 class=\"service-title\">Protocolos Exclusivos</h3>\n                    <p class=\"service-description\">Combinações personalizadas de tratamentos para resultados otimizados e naturais.</p>\n                    <a href=\"#contact\" class=\"service-link\">Agendar →</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"testimonials\" id=\"testimonials\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">Depoimentos</span>\n                <h2 class=\"section-title\">O que dizem nossas clientes</h2>\n                <p class=\"section-description\">Histórias reais de transformação e satisfação com os resultados alcançados.</p>\n            </div>\n\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card\" data-delay=\"0\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-quote\">\"A Dra. Suzan tem mãos de fada! Fiz harmonização facial e o resultado foi super natural. Todo mundo diz que estou 'iluminada' mas não conseguem pontuar o que foi feito. Exatamente o que eu queria!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div>\n                            <div class=\"testimonial-name\">Marina Costa</div>\n                            <div class=\"testimonial-role\">Empresária, 34 anos</div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card\" data-delay=\"200\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-quote\">\"Preço justo, resultado impecável. A Dra. Suzan é muito atenciosa e explica tudo sobre o procedimento. Me sinto mais confiante e bonita. Recomendo de olhos fechados!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AL</div>\n                        <div>\n                            <div class=\"testimonial-name\">Ana Luiza</div>\n                            <div class=\"testimonial-role\">Advogada, 28 anos</div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card\" data-delay=\"400\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-quote\">\"Já fiz preenchimento labial e toxina botulínica. A clinica é linda, limpa e a equipe é super simpática. A Dra. Suzan é muito profissional e competente. Amei os resultados!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">PS</div>\n                        <div>\n                            <div class=\"testimonial-name\">Patrícia Silva</div>\n                            <div class=\"testimonial-role\">Arquiteta, 41 anos</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"differentials\" id=\"differentials\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">Por que Beauté Clinic</span>\n                <h2 class=\"section-title\">Diferenciais exclusivos</h2>\n                <p class=\"section-description\">Compromisso com sua segurança, satisfação e resultados que superam expectativas.</p>\n            </div>\n\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item\" data-delay=\"0\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">✓</div>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h4>Profissional Certificada</h4>\n                        <p>Dra. Suzan Salvador é especialista em estética avançada com formação continuada.</p>\n                    </div>\n                </div>\n\n                <div class=\"differential-item\" data-delay=\"100\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">★</div>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h4>Produtos de Qualidade</h4>\n                        <p>Utilizamos apenas preenchedores e toxina botulínica de origem certificada e comprovada.</p>\n                    </div>\n                </div>\n\n                <div class=\"differential-item\" data-delay=\"200\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">◈</div>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h4>Resultados Naturais</h4>\n                        <p>Foco na harmonização e naturalidade, realçando sua beleza sem exageros.</p>\n                    </div>\n                </div>\n\n                <div class=\"differential-item\" data-delay=\"300\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">✦</div>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h4>Atendimento Personalizado</h4>\n                        <p>Cada paciente recebe um protocolo individualizado conforme suas necessidades.</p>\n                    </div>\n                </div>\n\n                <div class=\"differential-item\" data-delay=\"400\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">✤</div>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h4>Ambiente Seguro</h4>\n                        <p>Clínica equipada e seguir todos os protocolos de assepsia e segurança.</p>\n                    </div>\n                </div>\n\n                <div class=\"differential-item\" data-delay=\"500\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">❋</div>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h4>Acompanhamento</h4>\n                        <p>Suporte pós-procedimento e acompanhamento da sua evolução e satisfação.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"contact\" id=\"contact\">\n        <div class=\"contact-container\">\n            <div class=\"contact-info\">\n                <h2 class=\"contact-title\">Agende sua consulta</h2>\n                <p class=\"contact-description\">Entre em contato para transformar sua autoestima. Respondemos em até 24 horas úteis.</p>\n\n                <div class=\"contact-details\">\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">📍</div>\n                        <div class=\"contact-item-text\">\n                            <strong>Endereço</strong>\n                            <span>R. Adolfo Serra, 1352 - Alto da Boa Vista, Ribeirão Preto - SP, 14025-520</span>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">📱</div>\n                        <div class=\"contact-item-text\">\n                            <strong>WhatsApp</strong>\n                            <span>(16) 99728-7401</span>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">✉</div>\n                        <div class=\"contact-item-text\">\n                            <strong>Email</strong>\n                            <span>contato@beauteclinic.com.br</span>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">🕐</div>\n                        <div class=\"contact-item-text\">\n                            <strong>Horário</strong>\n                            <span>Seg - Sex: 9h às 19h | Sáb: 9h às 14h</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"contact-form-wrapper\">\n                <form class=\"contact-form\" id=\"contactForm\">\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"name\">Nome Completo</label>\n                        <input type=\"text\" class=\"form-input\" id=\"name\" name=\"name\" placeholder=\"Seu nome\" required>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"phone\">Telefone/WhatsApp</label>\n                        <input type=\"tel\" class=\"form-input\" id=\"phone\" name=\"phone\" placeholder=\"(16) 99999-9999\" required>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"service\">Tratamento de Interesse</label>\n                        <select class=\"form-select\" id=\"service\" name=\"service\" required>\n                            <option value=\"\">Selecione uma opção</option>\n                            <option value=\"Harmonização Facial\">Harmonização Facial</option>\n                            <option value=\"Toxina Botulínica\">Toxina Botulínica</option>\n                            <option value=\"Preenchedores Faciais\">Preenchedores Faciais</option>\n                            <option value=\"Preenchimento Labial\">Preenchimento Labial</option>\n                            <option value=\"Bioestimuladores\">Bioestimuladores</option>\n                            <option value=\"Protocolos Exclusivos\">Protocolos Exclusivos</option>\n                            <option value=\"Outros\">Outros</option>\n                        </select>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"message\">Mensagem (opcional)</label>\n                        <textarea class=\"form-textarea\" id=\"message\" name=\"message\" placeholder=\"Conte-nos mais sobre o que você busca...\"></textarea>\n                    </div>\n\n                    <button type=\"submit\" class=\"form-submit\">Enviar Mensagem</button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-brand\">\n                    <div class=\"footer-logo\">Beauté <span>Clinic</span></div>\n                    <p class=\"footer-description\">Transformando vidas através da estética avançada. Sua beleza única, elevada à perfeição.</p>\n                    <div class=\"footer-social\">\n                        <a href=\"#\" aria-label=\"Instagram\">IG</a>\n                        <a href=\"#\" aria-label=\"Facebook\">FB</a>\n                        <a href=\"#\" aria-label=\"WhatsApp\">WA</a>\n                    </div>\n                </div>\n\n                <div class=\"footer-column\">\n                    <h4>Links Rápidos</h4>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#home\">Início</a></li>\n                        <li><a href=\"#services\">Tratamentos</a></li>\n                        <li><a href=\"#testimonials\">Depoimentos</a></li>\n                        <li><a href=\"#contact\">Contato</a></li>\n                    </ul>\n                </div>\n\n                <div class=\"footer-column\">\n                    <h4>Tratamentos</h4>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#services\">Harmonização Facial</a></li>\n                        <li><a href=\"#services\">Toxina Botulínica</a></li>\n                        <li><a href=\"#services\">Preenchedores</a></li>\n                        <li><a href=\"#services\">Bioestimuladores</a></li>\n                    </ul>\n                </div>\n            </div>\n\n            <div class=\"footer-bottom\">\n                <p>&copy; 2024 Beauté Clinic. Todos os direitos reservados. Dra. Suzan Salvador - Harmonização Facial em Ribeirão Preto</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION SCROLL EFFECT\n        // ============================================\n        const nav = document.getElementById('nav');\n        let lastScroll = 0;\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                nav.classList.add('scrolled');\n            } else {\n                nav.classList.remove('scrolled');\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // ============================================\n        // MOBILE MENU TOGGLE\n        // ============================================\n        const mobileToggle = document.getElementById('mobileToggle');\n        const navMenu = document.getElementById('navMenu');\n\n        mobileToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close menu when clicking on links\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER ANIMATIONS\n        // ============================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || 0;\n                    setTimeout(() => {\n                        entry.target.classList.add('visible');\n                    }, delay);\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        // Observe elements\n        document.querySelectorAll('.section-header, .problem-card, .solution-card, .service-card, .testimonial-card, .differential-item, .contact-info, .contact-form-wrapper').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // CONTACT FORM - WHATSAPP INTEGRATION\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const whatsappNumber = '5516997287401';\n            const whatsappMessage = encodeURIComponent(\n                `Olá! Meu nome é ${name}.\\n` +\n                `Telefone: ${phone}\\n` +\n                `Interesse: ${service}\\n` +\n                `Mensagem: ${message || 'Gostaria de agendar uma consulta.'}`\n            );\n\n            const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;\n            window.open(whatsappUrl, '_blank');\n\n            // Optional: reset form\n            contactForm.reset();\n        });\n\n        // ============================================\n        // PARALLAX EFFECT ON BLOBS\n        // ============================================\n        document.addEventListener('mousemove', (e) => {\n            const blobs = document.querySelectorAll('.hero-blob');\n            const x = (e.clientX / window.innerWidth - 0.5) * 20;\n            const y = (e.clientY / window.innerHeight - 0.5) * 20;\n\n            blobs.forEach((blob, index) => {\n                const speed = (index + 1) * 0.3;\n                blob.style.transform = `translate(${x * speed}px, ${y * speed}px)`;\n            });\n        });\n\n        // ============================================\n        // REDUCED MOTION SUPPORT\n        // ============================================\n        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n            document.querySelectorAll('.hero-blob').forEach(blob => {\n                blob.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null}}
