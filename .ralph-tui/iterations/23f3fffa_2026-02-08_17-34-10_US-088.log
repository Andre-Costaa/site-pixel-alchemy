{"type":"assistant","message":{"id":"msg_202602090435036a437eed670e491f","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_c89ceac330054de78818abec","name":"Write","input":{"file_path":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/clinica-de-estetica-belle-sante/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Belle Santé | Clínica de Estética em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Belle Santé - Clínica de Estética em Ribeirão Preto. Harmonização facial e estética avançada com atendimento personalizado.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           FRENCH GARDEN & CHAMPAGNE GOLD PALETTE\n           ============================================ */\n        :root {\n            /* Sage Garden Tones */\n            --sage-deep: #2D4A3A;\n            --sage-dark: #3D5A4A;\n            --sage-mid: #4A6A5A;\n            --sage-light: #6A8A7A;\n            --sage-pale: #8AAA9A;\n            --sage-mist: #BACCAC;\n\n            /* Champagne Gold Tones */\n            --champagne-deep: #B89A5A;\n            --champagne-dark: #C8AA6A;\n            --champagne-mid: #D4B87A;\n            --champagne-light: #E0C890;\n            --champagne-shimmer: #E8D0A0;\n            --champagne-glow: #F0D8B0;\n\n            /* French Cream Tones */\n            --cream-deep: #F5F0E8;\n            --cream-mid: #FAF5ED;\n            --cream-light: #FDF8F5;\n            --cream-pearl: #FFFBF8;\n\n            /* Charcoal Noir Accents */\n            --noir-deep: #0A0A0F;\n            --noir-dark: #12121A;\n            --noir-mid: #1A1A22;\n            --noir-charcoal: #2A2A32;\n\n            /* Text Colors */\n            --text-primary: #2A2A2A;\n            --text-secondary: #4A4A4A;\n            --text-muted: #6A6A6A;\n            --text-on-light: #3A5A4A;\n\n            /* Typography */\n            --font-display: 'Playfair Display', Georgia, serif;\n            --font-body: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Topiary Border Radius - FRENCH GARDEN SHAPES */\n            --radius-topiary-1: 70% 30% 50% 50% / 55% 45% 50% 50%;\n            --radius-topiary-2: 50% 50% 70% 30% / 45% 55% 50% 50%;\n            --radius-topiary-3: 60% 40% 40% 60% / 50% 50% 45% 55%;\n            --radius-topiary-4: 40% 60% 60% 40% / 55% 45% 55% 45%;\n            --radius-sm: 4px;\n            --radius-md: 12px;\n            --radius-lg: 24px;\n            --radius-xl: 32px;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Gradients */\n            --gradient-sage: linear-gradient(135deg, var(--sage-deep) 0%, var(--sage-dark) 50%, var(--sage-mid) 100%);\n            --gradient-champagne: linear-gradient(135deg, var(--champagne-deep) 0%, var(--champagne-mid) 50%, var(--champagne-light) 100%);\n            --gradient-cream: linear-gradient(135deg, var(--cream-deep) 0%, var(--cream-mid) 50%, var(--cream-light) 100%);\n            --gradient-hero: linear-gradient(135deg, var(--cream-deep) 0%, var(--sage-mist) 40%, var(--cream-pearl) 100%);\n            --gradient-garden: linear-gradient(135deg, var(--sage-pale) 0%, var(--sage-mist) 50%, var(--cream-mid) 100%);\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(42, 74, 58, 0.1);\n            --shadow-medium: 0 8px 30px rgba(42, 74, 58, 0.15);\n            --shadow-strong: 0 12px 40px rgba(42, 74, 58, 0.2);\n            --shadow-glow-sage: 0 0 30px rgba(106, 138, 122, 0.3);\n            --shadow-glow-champagne: 0 0 30px rgba(212, 184, 122, 0.3);\n            --shadow-garden: 0 0 40px rgba(74, 106, 90, 0.15);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background-color: var(--cream-pearl);\n            color: var(--text-primary);\n            line-height: 1.7;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 500;\n            line-height: 1.2;\n            color: var(--sage-deep);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 600;\n            letter-spacing: -0.01em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            font-size: clamp(1rem, 1.1vw, 1.125rem);\n            color: var(--text-secondary);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: 1rem 0;\n            background: rgba(255, 251, 248, 0.95);\n            backdrop-filter: blur(20px);\n            transition: all var(--transition-base);\n            border-bottom: 1px solid rgba(106, 138, 122, 0.1);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav.scrolled {\n            box-shadow: 0 4px 30px rgba(42, 74, 58, 0.1);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 var(--spacing-md);\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            background: var(--gradient-sage);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            color: var(--text-secondary);\n            font-size: 0.9rem;\n            font-weight: 500;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-sage);\n            transition: width var(--transition-base);\n        }\n\n        .nav-link:hover {\n            color: var(--sage-deep);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-toggle {\n            display: none;\n            background: none;\n            border: none;\n            color: var(--text-primary);\n            font-size: 1.5rem;\n            cursor: pointer;\n        }\n\n        /* Mobile Menu */\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                right: 0;\n                flex-direction: column;\n                background: var(--cream-pearl);\n                padding: var(--spacing-md);\n                gap: var(--spacing-sm);\n                transform: translateX(100%);\n                transition: transform var(--transition-base);\n                border-top: 1px solid rgba(106, 138, 122, 0.1);\n            }\n\n            .nav-menu.active {\n                transform: translateX(0);\n            }\n\n            .nav-toggle {\n                display: block;\n            }\n        }\n\n        /* ============================================\n           UTILITIES\n           ============================================ */\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 var(--spacing-md);\n        }\n\n        .section {\n            padding: var(--spacing-xl) 0;\n            position: relative;\n        }\n\n        .text-center {\n            text-align: center;\n        }\n\n        .sage-accent {\n            color: var(--sage-deep);\n        }\n\n        .champagne-accent {\n            color: var(--champagne-deep);\n        }\n\n        /* ============================================\n           BUTTONS\n           ============================================ */\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 1rem 2rem;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            text-decoration: none;\n            border-radius: var(--radius-lg);\n            transition: all var(--transition-base);\n            cursor: pointer;\n            position: relative;\n            overflow: hidden;\n            border: none;\n        }\n\n        .btn-primary {\n            background: var(--gradient-sage);\n            color: var(--cream-pearl);\n            box-shadow: var(--shadow-glow-sage);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-garden);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--sage-deep);\n            border: 2px solid var(--sage-deep);\n        }\n\n        .btn-secondary:hover {\n            background: var(--sage-deep);\n            color: var(--cream-pearl);\n        }\n\n        /* ============================================\n           ANIMATIONS\n           ============================================ */\n        @keyframes topiary-float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg);\n            }\n            25% {\n                transform: translate(15px, -15px) rotate(3deg);\n            }\n            50% {\n                transform: translate(0, -30px) rotate(0deg);\n            }\n            75% {\n                transform: translate(-15px, -15px) rotate(-3deg);\n            }\n        }\n\n        @keyframes garden-shimmer {\n            0%, 100% {\n                opacity: 0.4;\n                transform: scale(1);\n            }\n            50% {\n                opacity: 0.6;\n                transform: scale(1.05);\n            }\n        }\n\n        @keyframes champagne-drift {\n            0%, 100% {\n                transform: translateY(0) translateX(0);\n            }\n            50% {\n                transform: translateY(-25px) translateX(10px);\n            }\n        }\n\n        @keyframes pulse-glow {\n            0%, 100% {\n                box-shadow: 0 0 20px rgba(106, 138, 122, 0.3);\n            }\n            50% {\n                box-shadow: 0 0 40px rgba(106, 138, 122, 0.5);\n            }\n        }\n\n        @keyframes fade-up {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fade-in {\n            from {\n                opacity: 0;\n            }\n            to {\n                opacity: 1;\n            }\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            position: relative;\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        .hero-bg {\n            position: absolute;\n            inset: 0;\n            overflow: hidden;\n        }\n\n        .topiary-blob {\n            position: absolute;\n            border-radius: var(--radius-topiary-1);\n            opacity: 0.2;\n            filter: blur(50px);\n            animation: topiary-float 18s ease-in-out infinite;\n        }\n\n        .topiary-blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-sage);\n            top: -150px;\n            right: -100px;\n            animation-delay: 0s;\n            border-radius: var(--radius-topiary-1);\n        }\n\n        .topiary-blob-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-champagne);\n            bottom: -100px;\n            left: -100px;\n            animation-delay: -4s;\n            border-radius: var(--radius-topiary-2);\n        }\n\n        .topiary-blob-3 {\n            width: 350px;\n            height: 350px;\n            background: var(--gradient-garden);\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: -9s;\n            border-radius: var(--radius-topiary-3);\n        }\n\n        .topiary-blob-4 {\n            width: 250px;\n            height: 250px;\n            background: var(--gradient-cream);\n            bottom: 20%;\n            right: 15%;\n            animation-delay: -13s;\n            border-radius: var(--radius-topiary-4);\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 10;\n            max-width: 800px;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 0.5rem 1rem;\n            background: rgba(74, 106, 90, 0.1);\n            border: 1px solid rgba(74, 106, 90, 0.3);\n            border-radius: var(--radius-lg);\n            font-size: 0.875rem;\n            color: var(--sage-deep);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero h1 {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-subtitle {\n            font-size: clamp(1.125rem, 2vw, 1.375rem);\n            color: var(--text-secondary);\n            margin-bottom: var(--spacing-lg);\n            max-width: 600px;\n        }\n\n        .hero-cta {\n            display: flex;\n            gap: var(--spacing-sm);\n            flex-wrap: wrap;\n        }\n\n        .hero-image {\n            position: absolute;\n            right: 0;\n            top: 50%;\n            transform: translateY(-50%);\n            width: 45%;\n            height: 80%;\n            background: url('https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=800&q=80') center/cover no-repeat;\n            border-radius: var(--radius-xl) 0 0 var(--radius-xl);\n            opacity: 0.15;\n            filter: blur(2px);\n        }\n\n        @media (max-width: 1024px) {\n            .hero-image {\n                display: none;\n            }\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            background: var(--cream-pearl);\n        }\n\n        .ps-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n            margin-top: var(--spacing-lg);\n        }\n\n        .ps-card {\n            padding: var(--spacing-lg);\n            border-radius: var(--radius-xl);\n            transition: all var(--transition-base);\n        }\n\n        .ps-problem {\n            background: var(--cream-mid);\n            border-left: 4px solid var(--sage-mid);\n        }\n\n        .ps-problem:hover {\n            transform: translateX(-10px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .ps-solution {\n            background: var(--gradient-sage);\n            color: var(--cream-pearl);\n            border-left: 4px solid var(--champagne-mid);\n        }\n\n        .ps-solution h3,\n        .ps-solution p {\n            color: var(--cream-pearl);\n        }\n\n        .ps-solution:hover {\n            transform: translateX(10px);\n            box-shadow: var(--shadow-strong);\n        }\n\n        .ps-icon {\n            width: 60px;\n            height: 60px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--gradient-champagne);\n            border-radius: var(--radius-md);\n            margin-bottom: var(--spacing-md);\n            font-size: 1.5rem;\n        }\n\n        @media (max-width: 768px) {\n            .ps-grid {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            background: var(--cream-deep);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .service-card {\n            background: var(--cream-pearl);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-xl);\n            transition: all var(--transition-base);\n            border: 1px solid rgba(106, 138, 122, 0.1);\n        }\n\n        .service-card:hover {\n            transform: translateY(-10px);\n            box-shadow: var(--shadow-strong);\n            border-color: var(--sage-pale);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--gradient-sage);\n            border-radius: var(--radius-md);\n            margin-bottom: var(--spacing-sm);\n            color: var(--cream-pearl);\n            font-size: 1.5rem;\n        }\n\n        .service-card h3 {\n            font-size: 1.25rem;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            color: var(--sage-deep);\n            font-weight: 600;\n            margin-top: var(--spacing-sm);\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            background: var(--gradient-sage);\n            color: var(--cream-pearl);\n        }\n\n        .testimonials h2,\n        .testimonials h3,\n        .testimonials p {\n            color: var(--cream-pearl);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.1);\n            backdrop-filter: blur(10px);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-xl);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n        }\n\n        .testimonial-stars {\n            color: var(--champagne-shimmer);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .testimonial-text {\n            font-style: italic;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: var(--gradient-champagne);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            background: var(--cream-pearl);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-icon {\n            width: 80px;\n            height: 80px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--gradient-garden);\n            border-radius: 50%;\n            margin: 0 auto var(--spacing-sm);\n            color: var(--sage-deep);\n            font-size: 2rem;\n            animation: pulse-glow 3s ease-in-out infinite;\n        }\n\n        .differential-item h3 {\n            font-size: 1.125rem;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            background: var(--cream-deep);\n        }\n\n        .contact-container {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n            margin-top: var(--spacing-lg);\n        }\n\n        .contact-info {\n            padding: var(--spacing-lg);\n            background: var(--cream-pearl);\n            border-radius: var(--radius-xl);\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-sm);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-icon {\n            width: 50px;\n            height: 50px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--gradient-sage);\n            border-radius: var(--radius-md);\n            color: var(--cream-pearl);\n            flex-shrink: 0;\n        }\n\n        .contact-form {\n            padding: var(--spacing-lg);\n            background: var(--cream-pearl);\n            border-radius: var(--radius-xl);\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-label {\n            display: block;\n            margin-bottom: var(--spacing-xs);\n            font-weight: 500;\n            color: var(--sage-deep);\n        }\n\n        .form-input,\n        .form-select,\n        .form-textarea {\n            width: 100%;\n            padding: 1rem;\n            border: 2px solid rgba(106, 138, 122, 0.2);\n            border-radius: var(--radius-md);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: all var(--transition-fast);\n            background: var(--cream-pearl);\n        }\n\n        .form-input:focus,\n        .form-select:focus,\n        .form-textarea:focus {\n            outline: none;\n            border-color: var(--sage-deep);\n            box-shadow: 0 0 0 3px rgba(45, 74, 58, 0.1);\n        }\n\n        .form-textarea {\n            min-height: 150px;\n            resize: vertical;\n        }\n\n        @media (max-width: 768px) {\n            .contact-container {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--noir-deep);\n            color: var(--cream-pearl);\n            padding: var(--spacing-lg) 0 var(--spacing-md);\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-lg);\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .footer-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            background: var(--gradient-champagne);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-links {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: var(--spacing-xs);\n        }\n\n        .footer-links a {\n            color: var(--text-muted);\n            transition: color var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--champagne-shimmer);\n        }\n\n        .footer-bottom {\n            text-align: center;\n            padding-top: var(--spacing-md);\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            color: var(--text-muted);\n        }\n\n        /* ============================================\n           INTERSECTION OBSERVER ANIMATIONS\n           ============================================ */\n        .wow {\n            opacity: 0;\n        }\n\n        .wow.fade-up {\n            animation: fade-up 0.6s ease forwards;\n        }\n\n        .wow.fade-in {\n            animation: fade-in 0.6s ease forwards;\n        }\n\n        .wow[data-delay] {\n            animation-delay: var(--delay);\n        }\n\n        /* ============================================\n           ACCESSIBILITY\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        /* Focus styles */\n        a:focus, button:focus, .btn:focus {\n            outline: 2px solid var(--sage-deep);\n            outline-offset: 2px;\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Belle Santé</a>\n            <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Toggle navigation\">\n                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                    <path d=\"M3 12h18M3 6h18M3 18h18\"/>\n                </svg>\n            </button>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#home\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contato\" class=\"nav-link\">Contato</a></li>\n            </ul>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-bg\">\n            <div class=\"topiary-blob topiary-blob-1\"></div>\n            <div class=\"topiary-blob topiary-blob-2\"></div>\n            <div class=\"topiary-blob topiary-blob-3\"></div>\n            <div class=\"topiary-blob topiary-blob-4\"></div>\n        </div>\n        <div class=\"hero-image\"></div>\n        <div class=\"container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge\">\n                    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                    </svg>\n                    Estética Avançada em Ribeirão Preto\n                </div>\n                <h1>Sua Beleza,<br> Nossa Paixão</h1>\n                <p class=\"hero-subtitle\">Descubra uma nova versão de si mesma com tratamentos de harmonização facial e estética avançada personalizados para você.</p>\n                <div class=\"hero-cta\">\n                    <a href=\"#contato\" class=\"btn btn-primary\">\n                        Agendar Consulta\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                    <a href=\"#servicos\" class=\"btn btn-secondary\">Conheça os Serviços</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\">\n        <div class=\"container\">\n            <div class=\"text-center\">\n                <h2 class=\"wow fade-up\">Sua Jornada de Transformação</h2>\n                <p class=\"wow fade-up\" data-delay=\"200\">Entendemos suas necessidades e oferecemos soluções personalizadas</p>\n            </div>\n            <div class=\"ps-grid\">\n                <div class=\"ps-card ps-problem wow fade-up\" data-delay=\"400\">\n                    <div class=\"ps-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            <path d=\"M8 14s1.5 2 4 2 4-2 4-2\"/>\n                            <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"/>\n                            <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"/>\n                        </svg>\n                    </div>\n                    <h3>Seus Desafios</h3>\n                    <p>Sente que sua aparência não reflete sua vitalidade? Marcas de expressão, perda de volume facial e flacidez podem afetar sua autoestima.</p>\n                </div>\n                <div class=\"ps-card ps-solution wow fade-up\" data-delay=\"600\">\n                    <div class=\"ps-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Nossa Solução</h3>\n                    <p>Protocolos personalizados de harmonização facial e estética avançada que realçam sua beleza natural com resultados naturais e elegantes.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"container\">\n            <div class=\"text-center\">\n                <h2 class=\"wow fade-up\">Nossos Serviços</h2>\n                <p class=\"wow fade-up\" data-delay=\"200\">Tratamentos especializados para realçar sua beleza natural</p>\n            </div>\n            <div class=\"services-grid\">\n                <div class=\"service-card wow fade-up\" data-delay=\"400\">\n                    <div class=\"service-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Harmonização Facial</h3>\n                    <p>Equilíbrio e simetria para seu rosto com técnicas avançadas e produtos de alta qualidade.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow fade-up\" data-delay=\"500\">\n                    <div class=\"service-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M9 12l2 2 4-4\"/>\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                        </svg>\n                    </div>\n                    <h3>Toxina Botulínica</h3>\n                    <p>Suavize linhas de expressão e previna novas rugas com aplicações precisas e naturais.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow fade-up\" data-delay=\"600\">\n                    <div class=\"service-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 19l7-7 3 3-7 7-3-3z\"/>\n                            <path d=\"M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z\"/>\n                            <path d=\"M2 2l7.586 7.586\"/>\n                            <circle cx=\"11\" cy=\"11\" r=\"2\"/>\n                        </svg>\n                    </div>\n                    <h3>Preenchedores Faciais</h3>\n                    <p>Restaure volume e contorno facial com ácido hialurônico de última geração.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow fade-up\" data-delay=\"700\">\n                    <div class=\"service-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M6 9l6 6 6-6\"/>\n                        </svg>\n                    </div>\n                    <h3>Preenchimento Labial</h3>\n                    <p>Lábios volumosos e naturais com técnicas que preservam a harmonia do seu rosto.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow fade-up\" data-delay=\"800\">\n                    <div class=\"service-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Bioestimuladores</h3>\n                    <p>Estimule o colágeno natural e rejuvenesça sua pele com tratamentos progressivos.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow fade-up\" data-delay=\"900\">\n                    <div class=\"service-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Protocolos Personalizados</h3>\n                    <p>Planos de tratamento exclusivos desenvolvidos especialmente para suas necessidades.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"container\">\n            <div class=\"text-center\">\n                <h2 class=\"wow fade-up\">O Que Nossas Clientes Dizem</h2>\n                <p class=\"wow fade-up\" data-delay=\"200\">Histórias reais de transformação e satisfação</p>\n            </div>\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow fade-up\" data-delay=\"400\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Excelente profissional! Fiz minha harmonização facial e ficou super natural. Recomendo muito!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\"></div>\n                        <div>\n                            <h4>Maria Silva</h4>\n                            <small>Paciente</small>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow fade-up\" data-delay=\"500\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Ambiente acolhedor e atendimento impecável. Fiz o preenchimento labial e amei o resultado!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\"></div>\n                        <div>\n                            <h4>Ana Costa</h4>\n                            <small>Paciente</small>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow fade-up\" data-delay=\"600\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Profissionais super atenciosos e caprichosos. O resultado superou minhas expectativas!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\"></div>\n                        <div>\n                            <h4>Carla Oliveira</h4>\n                            <small>Paciente</small>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\" id=\"diferenciais\">\n        <div class=\"container\">\n            <div class=\"text-center\">\n                <h2 class=\"wow fade-up\">Por Que Escolher a Belle Santé</h2>\n                <p class=\"wow fade-up\" data-delay=\"200\">Diferenciais que fazem a diferença em sua experiência</p>\n            </div>\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow fade-up\" data-delay=\"400\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Profissionais Qualificados</h3>\n                    <p>Equipe especializada com anos de experiência em estética avançada</p>\n                </div>\n                <div class=\"differential-item wow fade-up\" data-delay=\"500\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Produtos de Qualidade</h3>\n                    <p>Utilizamos apenas produtos certificados e aprovados pela ANVISA</p>\n                </div>\n                <div class=\"differential-item wow fade-up\" data-delay=\"600\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Atendimento Personalizado</h3>\n                    <p>Cada paciente é única: tratamentos personalizados para você</p>\n                </div>\n                <div class=\"differential-item wow fade-up\" data-delay=\"700\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Ambiente Confortável</h3>\n                    <p>Espaço seguro, limpo e preparado para sua total comodidade</p>\n                </div>\n                <div class=\"differential-item wow fade-up\" data-delay=\"800\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Resultados Naturais</h3>\n                    <p>Foco na harmonia e naturalidade para realçar sua beleza única</p>\n                </div>\n                <div class=\"differential-item wow fade-up\" data-delay=\"900\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Acompanhamento</h3>\n                    <p>Suporte contínuo antes, durante e após seus procedimentos</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"container\">\n            <div class=\"text-center\">\n                <h2 class=\"wow fade-up\">Entre em Contato</h2>\n                <p class=\"wow fade-up\" data-delay=\"200\">Agende sua consulta e transforme sua autoestima</p>\n            </div>\n            <div class=\"contact-container\">\n                <div class=\"contact-info wow fade-up\" data-delay=\"400\">\n                    <h3>Informações de Contato</h3>\n                    <div class=\"contact-item\">\n                        <div class=\"contact-icon\">\n                            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/>\n                                <circle cx=\"12\" cy=\"10\" r=\"3\"/>\n                            </svg>\n                        </div>\n                        <div>\n                            <strong>Endereço</strong>\n                            <p>Edifício Spazzio Mariza Vilela<br>R. Paschoal Bardaro, 1516<br>Jardim Botânico, Ribeirão Preto - SP<br>CEP: 14020-340</p>\n                        </div>\n                    </div>\n                    <div class=\"contact-item\">\n                        <div class=\"contact-icon\">\n                            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"/>\n                            </svg>\n                        </div>\n                        <div>\n                            <strong>Telefone</strong>\n                            <p>(16) 99770-2307</p>\n                        </div>\n                    </div>\n                    <div class=\"contact-item\">\n                        <div class=\"contact-icon\">\n                            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/>\n                                <path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"/>\n                            </svg>\n                        </div>\n                        <div>\n                            <strong>Email</strong>\n                            <p>contato@bellesante.com.br</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"contact-form wow fade-up\" data-delay=\"600\">\n                    <h3>Envie uma Mensagem</h3>\n                    <form id=\"contactForm\">\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"name\">Nome Completo</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" class=\"form-input\" required>\n                        </div>\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"phone\">Telefone</label>\n                            <input type=\"tel\" id=\"phone\" name=\"phone\" class=\"form-input\" required>\n                        </div>\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"service\">Serviço de Interesse</label>\n                            <select id=\"service\" name=\"service\" class=\"form-select\" required>\n                                <option value=\"\">Selecione um serviço</option>\n                                <option value=\"harmonizacao\">Harmonização Facial</option>\n                                <option value=\"botulina\">Toxina Botulínica</option>\n                                <option value=\"preenchedores\">Preenchedores Faciais</option>\n                                <option value=\"labial\">Preenchimento Labial</option>\n                                <option value=\"bioestimuladores\">Bioestimuladores</option>\n                                <option value=\"protocolos\">Protocolos Personalizados</option>\n                            </select>\n                        </div>\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"message\">Mensagem</label>\n                            <textarea id=\"message\" name=\"message\" class=\"form-textarea\" required></textarea>\n                        </div>\n                        <button type=\"submit\" class=\"btn btn-primary\">\n                            Enviar Mensagem\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z\"/>\n                            </svg>\n                        </button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"container\">\n            <div class=\"footer-content\">\n                <div>\n                    <div class=\"footer-logo\">Belle Santé</div>\n                    <p>Estética avançada com excelência e carinho.</p>\n                </div>\n                <div>\n                    <h4>Links Rápidos</h4>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#home\">Início</a></li>\n                        <li><a href=\"#servicos\">Serviços</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                        <li><a href=\"#contato\">Contato</a></li>\n                    </ul>\n                </div>\n                <div>\n                    <h4>Horário de Atendimento</h4>\n                    <ul class=\"footer-links\">\n                        <li>Segunda a Sexta: 9h às 18h</li>\n                        <li>Sábado: 9h às 13h</li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"footer-bottom\">\n                <p>&copy; 2024 Belle Santé - Clínica de Estética. Todos os direitos reservados.</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // Navigation scroll behavior\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                nav.classList.add('scrolled');\n            } else {\n                nav.classList.remove('scrolled');\n            }\n\n            if (currentScroll > lastScroll && currentScroll > 200) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Mobile menu toggle\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close menu when clicking on links\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // Intersection Observer for animations\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || 0;\n                    setTimeout(() => {\n                        entry.target.classList.add('fade-up');\n                    }, delay);\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow').forEach(el => {\n            observer.observe(el);\n        });\n\n        // Contact form submission\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceNames = {\n                harmonizacao: 'Harmonização Facial',\n                botulina: 'Toxina Botulínica',\n                preenchedores: 'Preenchedores Faciais',\n                labial: 'Preenchimento Labial',\n                bioestimuladores: 'Bioestimuladores',\n                protocolos: 'Protocolos Personalizados'\n            };\n\n            const whatsappMessage = `Olá! Meu nome é ${name}.%0A%0ATelefone: ${phone}%0A%0AServiço de interesse: ${serviceNames[service]}%0A%0AMensagem: ${message}`;\n\n            const whatsappUrl = `https://wa.me/5516997702307?text=${whatsappMessage}`;\n\n            window.open(whatsappUrl, '_blank');\n\n            contactForm.reset();\n        });\n\n        // Hero parallax effect on mouse move\n        const heroBg = document.querySelector('.hero-bg');\n\n        if (heroBg && window.innerWidth > 1024) {\n            document.addEventListener('mousemove', (e) => {\n                const x = (e.clientX / window.innerWidth - 0.5) * 20;\n                const y = (e.clientY / window.innerHeight - 0.5) * 20;\n\n                heroBg.style.transform = `translate(${x}px, ${y}px)`;\n            });\n        }\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"6b7a4a81-9e9d-4b65-9f8f-743678560845","uuid":"727fe195-3d56-4471-8486-445940384699"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c89ceac330054de78818abec","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/clinica-de-estetica-belle-sante/index.html"}]},"parent_tool_use_id":null,"session_id":"6b7a4a81-9e9d-4b65-9f8f-743678560845","uuid":"cd58ce55-e0e9-4f62-beae-2c10982b9cde","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/clinica-de-estetica-belle-sante/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Belle Santé | Clínica de Estética em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Belle Santé - Clínica de Estética em Ribeirão Preto. Harmonização facial e estética avançada com atendimento personalizado.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           FRENCH GARDEN & CHAMPAGNE GOLD PALETTE\n           ============================================ */\n        :root {\n            /* Sage Garden Tones */\n            --sage-deep: #2D4A3A;\n            --sage-dark: #3D5A4A;\n            --sage-mid: #4A6A5A;\n            --sage-light: #6A8A7A;\n            --sage-pale: #8AAA9A;\n            --sage-mist: #BACCAC;\n\n            /* Champagne Gold Tones */\n            --champagne-deep: #B89A5A;\n            --champagne-dark: #C8AA6A;\n            --champagne-mid: #D4B87A;\n            --champagne-light: #E0C890;\n            --champagne-shimmer: #E8D0A0;\n            --champagne-glow: #F0D8B0;\n\n            /* French Cream Tones */\n            --cream-deep: #F5F0E8;\n            --cream-mid: #FAF5ED;\n            --cream-light: #FDF8F5;\n            --cream-pearl: #FFFBF8;\n\n            /* Charcoal Noir Accents */\n            --noir-deep: #0A0A0F;\n            --noir-dark: #12121A;\n            --noir-mid: #1A1A22;\n            --noir-charcoal: #2A2A32;\n\n            /* Text Colors */\n            --text-primary: #2A2A2A;\n            --text-secondary: #4A4A4A;\n            --text-muted: #6A6A6A;\n            --text-on-light: #3A5A4A;\n\n            /* Typography */\n            --font-display: 'Playfair Display', Georgia, serif;\n            --font-body: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Topiary Border Radius - FRENCH GARDEN SHAPES */\n            --radius-topiary-1: 70% 30% 50% 50% / 55% 45% 50% 50%;\n            --radius-topiary-2: 50% 50% 70% 30% / 45% 55% 50% 50%;\n            --radius-topiary-3: 60% 40% 40% 60% / 50% 50% 45% 55%;\n            --radius-topiary-4: 40% 60% 60% 40% / 55% 45% 55% 45%;\n            --radius-sm: 4px;\n            --radius-md: 12px;\n            --radius-lg: 24px;\n            --radius-xl: 32px;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Gradients */\n            --gradient-sage: linear-gradient(135deg, var(--sage-deep) 0%, var(--sage-dark) 50%, var(--sage-mid) 100%);\n            --gradient-champagne: linear-gradient(135deg, var(--champagne-deep) 0%, var(--champagne-mid) 50%, var(--champagne-light) 100%);\n            --gradient-cream: linear-gradient(135deg, var(--cream-deep) 0%, var(--cream-mid) 50%, var(--cream-light) 100%);\n            --gradient-hero: linear-gradient(135deg, var(--cream-deep) 0%, var(--sage-mist) 40%, var(--cream-pearl) 100%);\n            --gradient-garden: linear-gradient(135deg, var(--sage-pale) 0%, var(--sage-mist) 50%, var(--cream-mid) 100%);\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(42, 74, 58, 0.1);\n            --shadow-medium: 0 8px 30px rgba(42, 74, 58, 0.15);\n            --shadow-strong: 0 12px 40px rgba(42, 74, 58, 0.2);\n            --shadow-glow-sage: 0 0 30px rgba(106, 138, 122, 0.3);\n            --shadow-glow-champagne: 0 0 30px rgba(212, 184, 122, 0.3);\n            --shadow-garden: 0 0 40px rgba(74, 106, 90, 0.15);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background-color: var(--cream-pearl);\n            color: var(--text-primary);\n            line-height: 1.7;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 500;\n            line-height: 1.2;\n            color: var(--sage-deep);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 600;\n            letter-spacing: -0.01em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            font-size: clamp(1rem, 1.1vw, 1.125rem);\n            color: var(--text-secondary);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: 1rem 0;\n            background: rgba(255, 251, 248, 0.95);\n            backdrop-filter: blur(20px);\n            transition: all var(--transition-base);\n            border-bottom: 1px solid rgba(106, 138, 122, 0.1);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav.scrolled {\n            box-shadow: 0 4px 30px rgba(42, 74, 58, 0.1);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 var(--spacing-md);\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            background: var(--gradient-sage);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            color: var(--text-secondary);\n            font-size: 0.9rem;\n            font-weight: 500;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-sage);\n            transition: width var(--transition-base);\n        }\n\n        .nav-link:hover {\n            color: var(--sage-deep);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-toggle {\n            display: none;\n            background: none;\n            border: none;\n            color: var(--text-primary);\n            font-size: 1.5rem;\n            cursor: pointer;\n        }\n\n        /* Mobile Menu */\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                right: 0;\n                flex-direction: column;\n                background: var(--cream-pearl);\n                padding: var(--spacing-md);\n                gap: var(--spacing-sm);\n                transform: translateX(100%);\n                transition: transform var(--transition-base);\n                border-top: 1px solid rgba(106, 138, 122, 0.1);\n            }\n\n            .nav-menu.active {\n                transform: translateX(0);\n            }\n\n            .nav-toggle {\n                display: block;\n            }\n        }\n\n        /* ============================================\n           UTILITIES\n           ============================================ */\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 var(--spacing-md);\n        }\n\n        .section {\n            padding: var(--spacing-xl) 0;\n            position: relative;\n        }\n\n        .text-center {\n            text-align: center;\n        }\n\n        .sage-accent {\n            color: var(--sage-deep);\n        }\n\n        .champagne-accent {\n            color: var(--champagne-deep);\n        }\n\n        /* ============================================\n           BUTTONS\n           ============================================ */\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 1rem 2rem;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            text-decoration: none;\n            border-radius: var(--radius-lg);\n            transition: all var(--transition-base);\n            cursor: pointer;\n            position: relative;\n            overflow: hidden;\n            border: none;\n        }\n\n        .btn-primary {\n            background: var(--gradient-sage);\n            color: var(--cream-pearl);\n            box-shadow: var(--shadow-glow-sage);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-garden);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--sage-deep);\n            border: 2px solid var(--sage-deep);\n        }\n\n        .btn-secondary:hover {\n            background: var(--sage-deep);\n            color: var(--cream-pearl);\n        }\n\n        /* ============================================\n           ANIMATIONS\n           ============================================ */\n        @keyframes topiary-float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg);\n            }\n            25% {\n                transform: translate(15px, -15px) rotate(3deg);\n            }\n            50% {\n                transform: translate(0, -30px) rotate(0deg);\n            }\n            75% {\n                transform: translate(-15px, -15px) rotate(-3deg);\n            }\n        }\n\n        @keyframes garden-shimmer {\n            0%, 100% {\n                opacity: 0.4;\n                transform: scale(1);\n            }\n            50% {\n                opacity: 0.6;\n                transform: scale(1.05);\n            }\n        }\n\n        @keyframes champagne-drift {\n            0%, 100% {\n                transform: translateY(0) translateX(0);\n            }\n            50% {\n                transform: translateY(-25px) translateX(10px);\n            }\n        }\n\n        @keyframes pulse-glow {\n            0%, 100% {\n                box-shadow: 0 0 20px rgba(106, 138, 122, 0.3);\n            }\n            50% {\n                box-shadow: 0 0 40px rgba(106, 138, 122, 0.5);\n            }\n        }\n\n        @keyframes fade-up {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fade-in {\n            from {\n                opacity: 0;\n            }\n            to {\n                opacity: 1;\n            }\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            position: relative;\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        .hero-bg {\n            position: absolute;\n            inset: 0;\n            overflow: hidden;\n        }\n\n        .topiary-blob {\n            position: absolute;\n            border-radius: var(--radius-topiary-1);\n            opacity: 0.2;\n            filter: blur(50px);\n            animation: topiary-float 18s ease-in-out infinite;\n        }\n\n        .topiary-blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-sage);\n            top: -150px;\n            right: -100px;\n            animation-delay: 0s;\n            border-radius: var(--radius-topiary-1);\n        }\n\n        .topiary-blob-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-champagne);\n            bottom: -100px;\n            left: -100px;\n            animation-delay: -4s;\n            border-radius: var(--radius-topiary-2);\n        }\n\n        .topiary-blob-3 {\n            width: 350px;\n            height: 350px;\n            background: var(--gradient-garden);\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: -9s;\n            border-radius: var(--radius-topiary-3);\n        }\n\n        .topiary-blob-4 {\n            width: 250px;\n            height: 250px;\n            background: var(--gradient-cream);\n            bottom: 20%;\n            right: 15%;\n            animation-delay: -13s;\n            border-radius: var(--radius-topiary-4);\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 10;\n            max-width: 800px;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 0.5rem 1rem;\n            background: rgba(74, 106, 90, 0.1);\n            border: 1px solid rgba(74, 106, 90, 0.3);\n            border-radius: var(--radius-lg);\n            font-size: 0.875rem;\n            color: var(--sage-deep);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero h1 {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-subtitle {\n            font-size: clamp(1.125rem, 2vw, 1.375rem);\n            color: var(--text-secondary);\n            margin-bottom: var(--spacing-lg);\n            max-width: 600px;\n        }\n\n        .hero-cta {\n            display: flex;\n            gap: var(--spacing-sm);\n            flex-wrap: wrap;\n        }\n\n        .hero-image {\n            position: absolute;\n            right: 0;\n            top: 50%;\n            transform: translateY(-50%);\n            width: 45%;\n            height: 80%;\n            background: url('https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=800&q=80') center/cover no-repeat;\n            border-radius: var(--radius-xl) 0 0 var(--radius-xl);\n            opacity: 0.15;\n            filter: blur(2px);\n        }\n\n        @media (max-width: 1024px) {\n            .hero-image {\n                display: none;\n            }\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            background: var(--cream-pearl);\n        }\n\n        .ps-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n            margin-top: var(--spacing-lg);\n        }\n\n        .ps-card {\n            padding: var(--spacing-lg);\n            border-radius: var(--radius-xl);\n            transition: all var(--transition-base);\n        }\n\n        .ps-problem {\n            background: var(--cream-mid);\n            border-left: 4px solid var(--sage-mid);\n        }\n\n        .ps-problem:hover {\n            transform: translateX(-10px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .ps-solution {\n            background: var(--gradient-sage);\n            color: var(--cream-pearl);\n            border-left: 4px solid var(--champagne-mid);\n        }\n\n        .ps-solution h3,\n        .ps-solution p {\n            color: var(--cream-pearl);\n        }\n\n        .ps-solution:hover {\n            transform: translateX(10px);\n            box-shadow: var(--shadow-strong);\n        }\n\n        .ps-icon {\n            width: 60px;\n            height: 60px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--gradient-champagne);\n            border-radius: var(--radius-md);\n            margin-bottom: var(--spacing-md);\n            font-size: 1.5rem;\n        }\n\n        @media (max-width: 768px) {\n            .ps-grid {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            background: var(--cream-deep);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .service-card {\n            background: var(--cream-pearl);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-xl);\n            transition: all var(--transition-base);\n            border: 1px solid rgba(106, 138, 122, 0.1);\n        }\n\n        .service-card:hover {\n            transform: translateY(-10px);\n            box-shadow: var(--shadow-strong);\n            border-color: var(--sage-pale);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--gradient-sage);\n            border-radius: var(--radius-md);\n            margin-bottom: var(--spacing-sm);\n            color: var(--cream-pearl);\n            font-size: 1.5rem;\n        }\n\n        .service-card h3 {\n            font-size: 1.25rem;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            color: var(--sage-deep);\n            font-weight: 600;\n            margin-top: var(--spacing-sm);\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            background: var(--gradient-sage);\n            color: var(--cream-pearl);\n        }\n\n        .testimonials h2,\n        .testimonials h3,\n        .testimonials p {\n            color: var(--cream-pearl);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.1);\n            backdrop-filter: blur(10px);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-xl);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n        }\n\n        .testimonial-stars {\n            color: var(--champagne-shimmer);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .testimonial-text {\n            font-style: italic;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: var(--gradient-champagne);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            background: var(--cream-pearl);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-icon {\n            width: 80px;\n            height: 80px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--gradient-garden);\n            border-radius: 50%;\n            margin: 0 auto var(--spacing-sm);\n            color: var(--sage-deep);\n            font-size: 2rem;\n            animation: pulse-glow 3s ease-in-out infinite;\n        }\n\n        .differential-item h3 {\n            font-size: 1.125rem;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            background: var(--cream-deep);\n        }\n\n        .contact-container {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n            margin-top: var(--spacing-lg);\n        }\n\n        .contact-info {\n            padding: var(--spacing-lg);\n            background: var(--cream-pearl);\n            border-radius: var(--radius-xl);\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-sm);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-icon {\n            width: 50px;\n            height: 50px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--gradient-sage);\n            border-radius: var(--radius-md);\n            color: var(--cream-pearl);\n            flex-shrink: 0;\n        }\n\n        .contact-form {\n            padding: var(--spacing-lg);\n            background: var(--cream-pearl);\n            border-radius: var(--radius-xl);\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-label {\n            display: block;\n            margin-bottom: var(--spacing-xs);\n            font-weight: 500;\n            color: var(--sage-deep);\n        }\n\n        .form-input,\n        .form-select,\n        .form-textarea {\n            width: 100%;\n            padding: 1rem;\n            border: 2px solid rgba(106, 138, 122, 0.2);\n            border-radius: var(--radius-md);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: all var(--transition-fast);\n            background: var(--cream-pearl);\n        }\n\n        .form-input:focus,\n        .form-select:focus,\n        .form-textarea:focus {\n            outline: none;\n            border-color: var(--sage-deep);\n            box-shadow: 0 0 0 3px rgba(45, 74, 58, 0.1);\n        }\n\n        .form-textarea {\n            min-height: 150px;\n            resize: vertical;\n        }\n\n        @media (max-width: 768px) {\n            .contact-container {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--noir-deep);\n            color: var(--cream-pearl);\n            padding: var(--spacing-lg) 0 var(--spacing-md);\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-lg);\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .footer-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            background: var(--gradient-champagne);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-links {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: var(--spacing-xs);\n        }\n\n        .footer-links a {\n            color: var(--text-muted);\n            transition: color var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--champagne-shimmer);\n        }\n\n        .footer-bottom {\n            text-align: center;\n            padding-top: var(--spacing-md);\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            color: var(--text-muted);\n        }\n\n        /* ============================================\n           INTERSECTION OBSERVER ANIMATIONS\n           ============================================ */\n        .wow {\n            opacity: 0;\n        }\n\n        .wow.fade-up {\n            animation: fade-up 0.6s ease forwards;\n        }\n\n        .wow.fade-in {\n            animation: fade-in 0.6s ease forwards;\n        }\n\n        .wow[data-delay] {\n            animation-delay: var(--delay);\n        }\n\n        /* ============================================\n           ACCESSIBILITY\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        /* Focus styles */\n        a:focus, button:focus, .btn:focus {\n            outline: 2px solid var(--sage-deep);\n            outline-offset: 2px;\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" c