--noir-dark) 50%, var(--noir-mid) 100%);\n    80→            --gradient-hero: linear-gradient(135deg, var(--noir-deep) 0%, var(--sapphire-dark) 40%, var(--noir-mid) 100%);\n    81→            --gradient-crystal: linear-gradient(135deg, var(--sapphire-frost) 0%, var(--crystal-ice) 50%, var(--pearl-frost) 100%);\n    82→            --gradient-icy: linear-gradient(135deg, var(--crystal-blue) 0%, var(--sapphire-frost) 50%, var(--pearl-frost) 100%);\n    83→\n    84→            /* Shadows */\n    85→            --shadow-soft: 0 4px 20px rgba(8, 8, 16, 0.5);\n    86→            --shadow-medium: 0 8px 30px rgba(8, 8, 16, 0.6);\n    87→            --shadow-strong: 0 12px 40px rgba(8, 8, 16, 0.7);\n    88→            --shadow-glow-sapphire: 0 0 30px rgba(58, 74, 154, 0.3);\n    89→            --shadow-glow-frost: 0 0 30px rgba(168, 208, 232, 0.2);\n    90→            --shadow-crystal: 0 0 40px rgba(138, 154, 216, 0.15);\n    91→        }\n    92→\n    93→        /* ============================================\n    94→           RESET & BASE STYLES\n    95→           ============================================ */\n    96→        *, *::before, *::after {\n    97→            margin: 0;\n    98→            padding: 0;\n    99→            box-sizing: border-box;\n   100→        }\n   101→\n   102→        html {\n   103→            scroll-behavior: smooth;\n   104→        }\n   105→\n   106→        body {\n   107→            font-family: var(--font-body);\n   108→            background-color: var(--noir-deep);\n   109→            color: var(--text-primary);\n   110→            line-height: 1.7;\n   111→            overflow-x: hidden;\n   112→            -webkit-font-smoothing: antialiased;\n   113→            -moz-osx-font-smoothing: grayscale;\n   114→        }\n   115→\n   116→        /* ============================================\n   117→           TYPOGRAPHY\n   118→           ============================================ */\n   119→        h1, h2, h3, h4, h5, h6 {\n   120→            font-family: var(--font-display);\n   121→            font-weight: 400;\n   122→            line-height: 1.2;\n   123→            color: var(--text-primary);\n   124→        }\n   125→\n   126→        h1 {\n   127→            font-size: clamp(2.5rem, 6vw, 4.5rem);\n   128→            font-weight: 400;\n   129→            letter-spacing: -0.01em;\n   130→        }\n   131→\n   132→        h2 {\n   133→            font-size: clamp(2rem, 4vw, 3rem);\n   134→            margin-bottom: var(--spacing-md);\n   135→        }\n   136→\n   137→        h3 {\n   138→            font-size: clamp(1.5rem, 2.5vw, 2rem);\n   139→            margin-bottom: var(--spacing-sm);\n   140→        }\n   141→\n   142→        p {\n   143→            font-size: clamp(1rem, 1.1vw, 1.125rem);\n   144→            color: var(--text-secondary);\n   145→            margin-bottom: var(--spacing-sm);\n   146→        }\n   147→\n   148→        a {\n   149→            text-decoration: none;\n   150→            color: inherit;\n   151→            transition: var(--transition-base);\n   152→        }\n   153→\n   154→        /* ============================================\n   155→           NAVIGATION\n   156→           ============================================ */\n   157→        .nav {\n   158→            position: fixed;\n   159→            top: 0;\n   160→            left: 0;\n   161→            right: 0;\n   162→            z-index: 1000;\n   163→            padding: 1rem 0;\n   164→            background: rgba(8, 8, 16, 0.9);\n   165→            backdrop-filter: blur(20px);\n   166→            transition: all var(--transition-base);\n   167→        }\n   168→\n   169→        .nav.hidden {\n   170→            transform: translateY(-100%);\n   171→        }\n   172→\n   173→        .nav.scrolled {\n   174→            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);\n   175→        }\n   176→\n   177→        .nav-container {\n   178→            max-width: 1200px;\n   179→            margin: 0 auto;\n   180→            padding: 0 var(--spacing-md);\n   181→            display: flex;\n   182→            justify-content: space-between;\n   183→            align-items: center;\n   184→        }\n   185→\n   186→        .nav-logo {\n   187→            font-family: var(--font-display);\n   188→            font-size: 1.5rem;\n   189→            font-weight: 400;\n   190→            background: var(--gradient-crystal);\n   191→            -webkit-background-clip: text;\n   192→            -webkit-text-fill-color: transparent;\n   193→            background-clip: text;\n   194→        }\n   195→\n   196→        .nav-menu {\n   197→            display: flex;\n   198→            gap: var(--spacing-md);\n   199→            list-style: none;\n   200→        }\n   201→\n   202→        .nav-link {\n   203→            color: var(--text-secondary);\n   204→            font-size: 0.9rem;\n   205→            font-weight: 500;\n   206→            transition: color var(--transition-fast);\n   207→            position: relative;\n   208→        }\n   209→\n   210→        .nav-link::after {\n   211→            content: '';\n   212→            position: absolute;\n   213→            bottom: -4px;\n   214→            left: 0;\n   215→            width: 0;\n   216→            height: 2px;\n   217→            background: var(--gradient-crystal);\n   218→            transition: width var(--transition-base);\n   219→        }\n   220→\n   221→        .nav-link:hover {\n   222→            color: var(--sapphire-frost);\n   223→        }\n   224→\n   225→        .nav-link:hover::after {\n   226→            width: 100%;\n   227→        }\n   228→\n   229→        .nav-toggle {\n   230→            display: none;\n   231→            background: none;\n   232→            border: none;\n   233→            color: var(--text-primary);\n   234→            font-size: 1.5rem;\n   235→            cursor: pointer;\n   236→        }\n   237→\n   238→        /* Mobile Menu */\n   239→        @media (max-width: 768px) {\n   240→            .nav-menu {\n   241→                position: fixed;\n   242→                top: 70px;\n   243→                left: 0;\n   244→                right: 0;\n   245→                flex-direction: column;\n   246→                background: var(--noir-deep);\n   247→                padding: var(--spacing-md);\n   248→                gap: var(--spacing-sm);\n   249→                transform: translateX(100%);\n   250→                transition: transform var(--transition-base);\n   251→                border-top: 1px solid rgba(138, 154, 216, 0.1);\n   252→            }\n   253→\n   254→            .nav-menu.active {\n   255→                transform: translateX(0);\n   256→            }\n   257→\n   258→            .nav-toggle {\n   259→                display: block;\n   260→            }\n   261→        }\n   262→\n   263→        /* ============================================\n   264→           UTILITIES\n   265→           ============================================ */\n   266→        .container {\n   267→            max-width: 1200px;\n   268→            margin: 0 auto;\n   269→            padding: 0 var(--spacing-md);\n   270→        }\n   271→\n   272→        .section {\n   273→            padding: var(--spacing-xl) 0;\n   274→            position: relative;\n   275→        }\n   276→\n   277→        .text-center {\n   278→            text-align: center;\n   279→        }\n   280→\n   281→        .sapphire-accent {\n   282→            color: var(--sapphire-frost);\n   283→        }\n   284→\n   285→        .frost-accent {\n   286→            color: var(--crystal-ice);\n   287→        }\n   288→\n   289→        /* ============================================\n   290→           BUTTONS\n   291→           ============================================ */\n   292→        .btn {\n   293→            display: inline-flex;\n   294→            align-items: center;\n   295→            gap: var(--spacing-xs);\n   296→            padding: 1rem 2rem;\n   297→            font-family: var(--font-body);\n   298→            font-size: 1rem;\n   299→            font-weight: 600;\n   300→            text-decoration: none;\n   301→            border-radius: var(--radius-lg);\n   302→            transition: all var(--transition-base);\n   303→            cursor: pointer;\n   304→            position: relative;\n   305→            overflow: hidden;\n   306→            border: none;\n   307→        }\n   308→\n   309→        .btn-primary {\n   310→            background: var(--gradient-crystal);\n   311→            color: var(--text-on-light);\n   312→            box-shadow: var(--shadow-glow-sapphire);\n   313→        }\n   314→\n   315→        .btn-primary:hover {\n   316→            transform: translateY(-2px);\n   317→            box-shadow: var(--shadow-crystal);\n   318→        }\n   319→\n   320→        .btn-secondary {\n   321→            background: transparent;\n   322→            color: var(--sapphire-frost);\n   323→            border: 2px solid var(--sapphire-frost);\n   324→        }\n   325→\n   326→        .btn-secondary:hover {\n   327→            background: var(--sapphire-frost);\n   328→            color: var(--text-on-light);\n   329→        }\n   330→\n   331→        /* ============================================\n   332→           ANIMATIONS\n   333→           ============================================ */\n   334→        @keyframes crystal-float {\n   335→            0%, 100% {\n   336→                transform: translate(0, 0) rotate(0deg);\n   337→            }\n   338→            25% {\n   339→                transform: translate(20px, -20px) rotate(5deg);\n   340→            }\n   341→            50% {\n   342→                transform: translate(0, -40px) rotate(0deg);\n   343→            }\n   344→            75% {\n   345→                transform: translate(-20px, -20px) rotate(-5deg);\n   346→            }\n   347→        }\n   348→\n   349→        @keyframes crystal-shimmer {\n   350→            0%, 100% {\n   351→                opacity: 0.6;\n   352→                transform: scale(1);\n   353→            }\n   354→            50% {\n   355→                opacity: 0.8;\n   356→                transform: scale(1.05);\n   357→            }\n   358→        }\n   359→\n   360→        @keyframes frost-drift {\n   361→            0%, 100% {\n   362→                transform: translateY(0) translateX(0);\n   363→            }\n   364→            50% {\n   365→                transform: translateY(-30px) translateX(15px);\n   366→            }\n   367→        }\n   368→\n   369→        @keyframes pulse-glow {\n   370→            0%, 100% {\n   371→                box-shadow: 0 0 20px rgba(138, 154, 216, 0.3);\n   372→            }\n   373→            50% {\n   374→                box-shadow: 0 0 40px rgba(138, 154, 216, 0.6);\n   375→            }\n   376→        }\n   377→\n   378→        @keyframes fade-up {\n   379→            from {\n   380→                opacity: 0;\n   381→                transform: translateY(30px);\n   382→            }\n   383→            to {\n   384→                opacity: 1;\n   385→                transform: translateY(0);\n   386→            }\n   387→        }\n   388→\n   389→        @keyframes fade-in {\n   390→            from {\n   391→                opacity: 0;\n   392→            }\n   393→            to {\n   394→                opacity: 1;\n   395→            }\n   396→        }\n   397→\n   398→        /* ============================================\n   399→           HERO SECTION\n   400→           ============================================ */\n   401→        .hero {\n   402→            min-height: 100vh;\n   403→            display: flex;\n   404→            align-items: center;\n   405→            position: relative;\n   406→            background: var(--gradient-hero);\n   407→            overflow: hidden;\n   408→        }\n   409→\n   410→        .hero-bg {\n   411→            position: absolute;\n   412→            inset: 0;\n   413→            overflow: hidden;\n   414→        }\n   415→\n   416→        .crystal-blob {\n   417→            position: absolute;\n   418→            border-radius: var(--radius-crystal-1);\n   419→            opacity: 0.15;\n   420→            filter: blur(60px);\n   421→            animation: crystal-float 20s ease-in-out infinite;\n   422→        }\n   423→\n   424→        .crystal-blob-1 {\n   425→            width: 500px;\n   426→            height: 500px;\n   427→            background: var(--gradient-sapphire);\n   428→            top: -150px;\n   429→            right: -100px;\n   430→            animation-delay: 0s;\n   431→            border-radius: var(--radius-crystal-1);\n   432→        }\n   433→\n   434→        .crystal-blob-2 {\n   435→            width: 400px;\n   436→            height: 400px;\n   437→            background: var(--gradient-crystal);\n   438→            bottom: -100px;\n   439→            left: -100px;\n   440→            animation-delay: -5s;\n   441→            border-radius: var(--radius-crystal-2);\n   442→        }\n   443→\n   444→        .crystal-blob-3 {\n   445→            width: 350px;\n   446→            height: 350px;\n   447→            background: var(--gradient-icy);\n   448→            top: 50%;\n   449→            left: 50%;\n   450→            transform: translate(-50%, -50%);\n   451→            animation-delay: -10s;\n   452→            border-radius: var(--radius-crystal-3);\n   453→        }\n   454→\n   455→        .crystal-blob-4 {\n   456→            width: 250px;\n   457→            height: 250px;\n   458→            background: var(--gradient-frost);\n   459→            bottom: 20%;\n   460→            right: 15%;\n   461→            animation-delay: -15s;\n   462→            border-radius: var(--radius-crystal-4);\n   463→        }\n   464→\n   465→        .hero-content {\n   466→            position: relative;\n   467→            z-index: 10;\n   468→            max-width: 800px;\n   469→        }\n   470→\n   471→        .hero-badge {\n   472→            display: inline-flex;\n   473→            align-items: center;\n   474→            gap: var(--spacing-xs);\n   475→            padding: 0.5rem 1rem;\n   476→            background: rgba(138, 154, 216, 0.1);\n   477→            border: 1px solid rgba(138, 154, 216, 0.3);\n   478→            border-radius: var(--radius-lg);\n   479→            font-size: 0.875rem;\n   480→            color: var(--sapphire-frost);\n   481→            margin-bottom: var(--spacing-md);\n   482→        }\n   483→\n   484→        .hero h1 {\n   485→            margin-bottom: var(--spacing-md);\n   486→        }\n   487→\n   488→        .hero-subtitle {\n   489→            font-size: clamp(1.125rem, 2vw, 1.375rem);\n   490→            color: var(--text-secondary);\n   491→            margin-bottom: var(--spacing-lg);\n   492→            max-width: 600px;\n   493→        }\n   494→\n   495→        .hero-cta {\n   496→            display: flex;\n   497→            gap: var(--spacing-sm);\n   498→            flex-wrap: wrap;\n   499→        }\n   500→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6b7a4a81-9e9d-4b65-9f8f-743678560845","uuid":"68a2c657-4246-4c51-b2f6-1e0a5c61a640","tool_use_result":{"type":"text","file":{"filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/clinica-harmoniser/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Clínica Harmoniser | Estética de Alta Performance em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Clínica Harmoniser - Estética de Alta Performance em Ribeirão Preto. Harmonização facial e estética avançada com tratamentos personalizados.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Tenor+Sans&family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           SAPPHIRE NOIR & PEARL FROST PALETTE\n           ============================================ */\n        :root {\n            /* Sapphire Tones */\n            --sapphire-deep: #0D1A3A;\n            --sapphire-dark: #1A2A5A;\n            --sapphire-mid: #2A3A7A;\n            --sapphire-light: #3A4A9A;\n            --sapphire-pale: #5A6AB8;\n            --sapphire-frost: #8A9AD8;\n\n            /* Pearl Frost Tones */\n            --pearl-frost: #E8F0F8;\n            --pearl-frost-light: #F0F5FA;\n            --pearl-frost-dark: #D8E8F0;\n            --pearl-ice: #F8FAFC;\n\n            /* Icy Crystal Accents */\n            --crystal-ice: #A8D0E8;\n            --crystal-blue: #88C0E0;\n            --frost-white: #F0F8FF;\n\n            /* Noir Backgrounds */\n            --noir-deep: #080810;\n            --noir-dark: #0A0A15;\n            --noir-mid: #12121F;\n            --noir-charcoal: #1A1A2A;\n\n            /* Text Colors */\n            --text-primary: #F0F0F8;\n            --text-secondary: #C8D0E0;\n            --text-muted: #8890A8;\n            --text-on-light: #1A2A4A;\n\n            /* Typography */\n            --font-display: 'Tenor Sans', 'Playfair Display', Georgia, serif;\n            --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Crystalline Border Radius - NEW PATTERN */\n            --radius-crystal-1: 75% 25% 45% 55% / 55% 35% 65% 45%;\n            --radius-crystal-2: 45% 55% 75% 25% / 35% 65% 35% 65%;\n            --radius-crystal-3: 65% 35% 40% 60% / 60% 40% 60% 40%;\n            --radius-crystal-4: 40% 60% 60% 40% / 40% 60% 40% 60%;\n            --radius-sm: 4px;\n            --radius-md: 12px;\n            --radius-lg: 24px;\n            --radius-xl: 32px;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Gradients */\n            --gradient-sapphire: linear-gradient(135deg, var(--sapphire-deep) 0%, var(--sapphire-dark) 50%, var(--sapphire-mid) 100%);\n            --gradient-frost: linear-gradient(135deg, var(--pearl-frost) 0%, var(--frost-white) 50%, var(--crystal-ice) 100%);\n            --gradient-noir: linear-gradient(135deg, var(--noir-deep) 0%, var(--noir-dark) 50%, var(--noir-mid) 100%);\n            --gradient-hero: linear-gradient(135deg, var(--noir-deep) 0%, var(--sapphire-dark) 40%, var(--noir-mid) 100%);\n            --gradient-crystal: linear-gradient(135deg, var(--sapphire-frost) 0%, var(--crystal-ice) 50%, var(--pearl-frost) 100%);\n            --gradient-icy: linear-gradient(135deg, var(--crystal-blue) 0%, var(--sapphire-frost) 50%, var(--pearl-frost) 100%);\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(8, 8, 16, 0.5);\n            --shadow-medium: 0 8px 30px rgba(8, 8, 16, 0.6);\n            --shadow-strong: 0 12px 40px rgba(8, 8, 16, 0.7);\n            --shadow-glow-sapphire: 0 0 30px rgba(58, 74, 154, 0.3);\n            --shadow-glow-frost: 0 0 30px rgba(168, 208, 232, 0.2);\n            --shadow-crystal: 0 0 40px rgba(138, 154, 216, 0.15);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background-color: var(--noir-deep);\n            color: var(--text-primary);\n            line-height: 1.7;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 400;\n            line-height: 1.2;\n            color: var(--text-primary);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 400;\n            letter-spacing: -0.01em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            font-size: clamp(1rem, 1.1vw, 1.125rem);\n            color: var(--text-secondary);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: 1rem 0;\n            background: rgba(8, 8, 16, 0.9);\n            backdrop-filter: blur(20px);\n            transition: all var(--transition-base);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav.scrolled {\n            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 var(--spacing-md);\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 400;\n            background: var(--gradient-crystal);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            color: var(--text-secondary);\n            font-size: 0.9rem;\n            font-weight: 500;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-crystal);\n            transition: width var(--transition-base);\n        }\n\n        .nav-link:hover {\n            color: var(--sapphire-frost);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-toggle {\n            display: none;\n            background: none;\n            border: none;\n            color: var(--text-primary);\n            font-size: 1.5rem;\n            cursor: pointer;\n        }\n\n        /* Mobile Menu */\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                right: 0;\n                flex-direction: column;\n                background: var(--noir-deep);\n                padding: var(--spacing-md);\n                gap: var(--spacing-sm);\n                transform: translateX(100%);\n                transition: transform var(--transition-base);\n                border-top: 1px solid rgba(138, 154, 216, 0.1);\n            }\n\n            .nav-menu.active {\n                transform: translateX(0);\n            }\n\n            .nav-toggle {\n                display: block;\n            }\n        }\n\n        /* ============================================\n           UTILITIES\n           ============================================ */\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 var(--spacing-md);\n        }\n\n        .section {\n            padding: var(--spacing-xl) 0;\n            position: relative;\n        }\n\n        .text-center {\n            text-align: center;\n        }\n\n        .sapphire-accent {\n            color: var(--sapphire-frost);\n        }\n\n        .frost-accent {\n            color: var(--crystal-ice);\n        }\n\n        /* ============================================\n           BUTTONS\n           ============================================ */\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 1rem 2rem;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            text-decoration: none;\n            border-radius: var(--radius-lg);\n            transition: all var(--transition-base);\n            cursor: pointer;\n            position: relative;\n            overflow: hidden;\n            border: none;\n        }\n\n        .btn-primary {\n            background: var(--gradient-crystal);\n            color: var(--text-on-light);\n            box-shadow: var(--shadow-glow-sapphire);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-crystal);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--sapphire-frost);\n            border: 2px solid var(--sapphire-frost);\n        }\n\n        .btn-secondary:hover {\n            background: var(--sapphire-frost);\n            color: var(--text-on-light);\n        }\n\n        /* ============================================\n           ANIMATIONS\n           ============================================ */\n        @keyframes crystal-float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg);\n            }\n            25% {\n                transform: translate(20px, -20px) rotate(5deg);\n            }\n            50% {\n                transform: translate(0, -40px) rotate(0deg);\n            }\n            75% {\n                transform: translate(-20px, -20px) rotate(-5deg);\n            }\n        }\n\n        @keyframes crystal-shimmer {\n            0%, 100% {\n                opacity: 0.6;\n                transform: scale(1);\n            }\n            50% {\n                opacity: 0.8;\n                transform: scale(1.05);\n            }\n        }\n\n        @keyframes frost-drift {\n            0%, 100% {\n                transform: translateY(0) translateX(0);\n            }\n            50% {\n                transform: translateY(-30px) translateX(15px);\n            }\n        }\n\n        @keyframes pulse-glow {\n            0%, 100% {\n                box-shadow: 0 0 20px rgba(138, 154, 216, 0.3);\n            }\n            50% {\n                box-shadow: 0 0 40px rgba(138, 154, 216, 0.6);\n            }\n        }\n\n        @keyframes fade-up {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fade-in {\n            from {\n                opacity: 0;\n            }\n            to {\n                opacity: 1;\n            }\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            position: relative;\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        .hero-bg {\n            position: absolute;\n            inset: 0;\n            overflow: hidden;\n        }\n\n        .crystal-blob {\n            position: absolute;\n            border-radius: var(--radius-crystal-1);\n            opacity: 0.15;\n            filter: blur(60px);\n            animation: crystal-float 20s ease-in-out infinite;\n        }\n\n        .crystal-blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-sapphire);\n            top: -150px;\n            right: -100px;\n            animation-delay: 0s;\n            border-radius: var(--radius-crystal-1);\n        }\n\n        .crystal-blob-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-crystal);\n            bottom: -100px;\n            left: -100px;\n            animation-delay: -5s;\n            border-radius: var(--radius-crystal-2);\n        }\n\n        .crystal-blob-3 {\n            width: 350px;\n            height: 350px;\n            background: var(--gradient-icy);\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: -10s;\n            border-radius: var(--radius-crystal-3);\n        }\n\n        .crystal-blob-4 {\n            width: 250px;\n            height: 250px;\n            background: var(--gradient-frost);\n            bottom: 20%;\n            right: 15%;\n            animation-delay: -15s;\n            border-radius: var(--radius-crystal-4);\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 10;\n            max-width: 800px;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 0.5rem 1rem;\n            background: rgba(138, 154, 216, 0.1);\n            border: 1px solid rgba(138, 154, 216, 0.3);\n            border-radius: var(--radius-lg);\n            font-size: 0.875rem;\n            color: var(--sapphire-frost);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero h1 {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-subtitle {\n            font-size: clamp(1.125rem, 2vw, 1.375rem);\n            color: var(--text-secondary);\n            margin-bottom: var(--spacing-lg);\n            max-width: 600px;\n        }\n\n        .hero-cta {\n            display: flex;\n            gap: var(--spacing-sm);\n            flex-wrap: wrap;\n        }\n","numLines":500,"startLine":1,"totalLines":1933}}}
