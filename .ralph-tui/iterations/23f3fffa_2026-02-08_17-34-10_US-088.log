      <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow fade-up\" data-delay=\"900\">\n                    <div class=\"service-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Protocolos Personalizados</h3>\n                    <p>Planos de tratamento exclusivos desenvolvidos especialmente para suas necessidades.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"container\">\n            <div class=\"text-center\">\n                <h2 class=\"wow fade-up\">O Que Nossas Clientes Dizem</h2>\n                <p class=\"wow fade-up\" data-delay=\"200\">Histórias reais de transformação e satisfação</p>\n            </div>\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow fade-up\" data-delay=\"400\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Excelente profissional! Fiz minha harmonização facial e ficou super natural. Recomendo muito!\"</p>\n                    <div class=\"testimonial-author\">\n                 