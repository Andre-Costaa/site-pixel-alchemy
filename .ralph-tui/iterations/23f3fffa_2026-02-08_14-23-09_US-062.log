{"type":"assistant","message":{"id":"msg_202602090124114e642440efad4b58","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_22bc914b52f644afae2dbfc8","name":"Write","input":{"file_path":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/clinica-botoesthetic/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Clínica BotoEsthetic | Harmonização Facial e Estética Avançada em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Clínica BotoEsthetic - Atendimento especializado em harmonização facial e estética avançada em Ribeirão Preto. Agende sua consulta.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Prata:wght@400;500;600;700&family=Figtree:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        /* ============================================\n           CSS RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        :root {\n            /* Chrome Noir & Electric Violet Palette */\n            --color-chrome: #C8C8D8;\n            --color-chrome-light: #D8D8E8;\n            --color-chrome-dark: #A8A8B8;\n            --color-chrome-mid: #B8B8C8;\n\n            --color-violet: #8B5FC8;\n            --color-violet-light: #A87FD8;\n            --color-violet-mid: #7B4FB8;\n            --color-violet-dark: #5B3F98;\n            --color-violet-deep: #3B2F78;\n\n            --color-electric: #9B7FD8;\n            --color-electric-bright: #BB9FF8;\n\n            --color-noir: #0D0D12;\n            --color-noir-deep: #050508;\n            --color-charcoal: #1A1A24;\n            --color-stone: #2A2A38;\n\n            --color-mist: #F5F5F8;\n            --color-mist-warm: #FAFAFC;\n            --color-frost: #E8E8F0;\n\n            --color-text-dark: #0D0D12;\n            --color-text-muted: #6A6A78;\n            --color-text-light: #FAFAFC;\n\n            /* Gradients */\n            --gradient-violet: linear-gradient(135deg, #8B5FC8 0%, #5B3F98 100%);\n            --gradient-violet-rich: linear-gradient(135deg, #A87FD8 0%, #8B5FC8 50%, #5B3F98 100%);\n            --gradient-chrome: linear-gradient(135deg, #C8C8D8 0%, #A8A8B8 100%);\n            --gradient-electric: linear-gradient(135deg, #9B7FD8 0%, #8B5FC8 100%);\n            --gradient-noir: linear-gradient(135deg, #0D0D12 0%, #1A1A24 100%);\n            --gradient-mist: linear-gradient(135deg, #FAFAFC 0%, #F5F5F8 100%);\n            --gradient-frost: linear-gradient(135deg, #E8E8F0 0%, #D8D8E8 100%);\n            --gradient-shimmer: linear-gradient(90deg, transparent, rgba(139, 95, 200, 0.3), transparent);\n\n            /* Typography */\n            --font-display: 'Prata', Georgia, serif;\n            --font-body: 'Figtree', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Border Radius - Prism Shard Shapes */\n            --radius-prism-1: 70% 30% 50% 50% / 50% 40% 60% 50%;\n            --radius-prism-2: 50% 50% 30% 70% / 40% 60% 40% 60%;\n            --radius-prism-3: 60% 40% 55% 45% / 45% 55% 45% 55%;\n            --radius-prism-4: 45% 55% 40% 60% / 55% 45% 55% 45%;\n            --radius-prism-sharp: 85% 15% 70% 30% / 30% 70% 15% 85%;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(13, 13, 18, 0.08);\n            --shadow-md: 0 8px 24px rgba(13, 13, 18, 0.12);\n            --shadow-lg: 0 16px 48px rgba(13, 13, 18, 0.16);\n            --shadow-violet: 0 8px 32px rgba(139, 95, 200, 0.35);\n            --shadow-chrome: 0 8px 32px rgba(200, 200, 216, 0.35);\n            --shadow-glow: 0 0 40px rgba(139, 95, 200, 0.3);\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.6;\n            color: var(--color-text-dark);\n            background-color: var(--color-mist-warm);\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 500;\n            line-height: 1.2;\n            color: var(--color-noir);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            letter-spacing: -0.01em;\n        }\n\n        h3 {\n            font-size: clamp(1.25rem, 2.5vw, 1.75rem);\n        }\n\n        p {\n            font-size: 1rem;\n            line-height: 1.7;\n            color: var(--color-text-muted);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            background: rgba(250, 250, 252, 0.95);\n            backdrop-filter: blur(20px);\n            border-bottom: 1px solid rgba(139, 95, 200, 0.1);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav.scrolled {\n            box-shadow: 0 4px 20px rgba(139, 95, 200, 0.1);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 1rem 2rem;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            color: var(--color-violet);\n            letter-spacing: -0.02em;\n        }\n\n        .nav-logo span {\n            color: var(--color-chrome-dark);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: 2rem;\n            list-style: none;\n        }\n\n        .nav-link {\n            font-weight: 500;\n            color: var(--color-text-dark);\n            position: relative;\n            padding: 0.5rem 0;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-violet);\n            transition: width var(--transition-base);\n        }\n\n        .nav-link:hover {\n            color: var(--color-violet);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--gradient-violet);\n            color: var(--color-mist-warm);\n            padding: 0.75rem 1.5rem;\n            border-radius: var(--radius-prism-2);\n            font-weight: 600;\n            transition: var(--transition-base);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-violet);\n            color: var(--color-mist-warm);\n        }\n\n        .mobile-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .mobile-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-violet);\n            transition: var(--transition-base);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            position: relative;\n            overflow: hidden;\n            background: var(--gradient-mist);\n            padding: 6rem 2rem 4rem;\n        }\n\n        .hero-bg {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            top: 0;\n            left: 0;\n            overflow: hidden;\n            z-index: 0;\n        }\n\n        .prism {\n            position: absolute;\n            border-radius: var(--radius-prism-1);\n            opacity: 0.6;\n            filter: blur(60px);\n            animation: prism-float 20s ease-in-out infinite;\n        }\n\n        .prism-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-frost);\n            top: -100px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .prism-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-violet);\n            bottom: -50px;\n            left: -50px;\n            opacity: 0.4;\n            animation-delay: -5s;\n        }\n\n        .prism-3 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(135deg, #9B7FD8 0%, #E8E8F0 100%);\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            opacity: 0.3;\n            animation-delay: -10s;\n        }\n\n        .prism-4 {\n            width: 250px;\n            height: 250px;\n            background: var(--gradient-electric);\n            bottom: 20%;\n            right: 20%;\n            opacity: 0.35;\n            animation-delay: -15s;\n        }\n\n        @keyframes prism-float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n                border-radius: var(--radius-prism-1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg) scale(1.05);\n                border-radius: var(--radius-prism-2);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg) scale(0.95);\n                border-radius: var(--radius-prism-3);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(3deg) scale(1.02);\n                border-radius: var(--radius-prism-4);\n            }\n        }\n\n        .hero-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .hero-content {\n            animation: fade-up 0.8s ease-out;\n        }\n\n        .hero-badge {\n            display: inline-block;\n            background: var(--gradient-frost);\n            color: var(--color-violet-dark);\n            padding: 0.5rem 1rem;\n            border-radius: var(--radius-prism-2);\n            font-size: 0.875rem;\n            font-weight: 600;\n            margin-bottom: 1.5rem;\n        }\n\n        .hero-title {\n            margin-bottom: 1.5rem;\n            animation: fade-up 0.8s ease-out 0.1s backwards;\n        }\n\n        .hero-title span {\n            color: var(--color-violet);\n        }\n\n        .hero-subtitle {\n            font-size: 1.25rem;\n            color: var(--color-text-muted);\n            margin-bottom: 2rem;\n            line-height: 1.8;\n            animation: fade-up 0.8s ease-out 0.2s backwards;\n        }\n\n        .hero-ctas {\n            display: flex;\n            gap: 1rem;\n            flex-wrap: wrap;\n            animation: fade-up 0.8s ease-out 0.3s backwards;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            border-radius: var(--radius-prism-2);\n            font-weight: 600;\n            transition: var(--transition-base);\n            cursor: pointer;\n            border: none;\n            font-size: 1rem;\n        }\n\n        .btn-primary {\n            background: var(--gradient-violet);\n            color: var(--color-mist-warm);\n            box-shadow: var(--shadow-violet);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 12px 40px rgba(139, 95, 200, 0.45);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-violet);\n            border: 2px solid var(--color-violet);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-violet);\n            color: var(--color-mist-warm);\n        }\n\n        .hero-image {\n            position: relative;\n            animation: fade-up 0.8s ease-out 0.4s backwards;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            border-radius: var(--radius-prism-sharp);\n            overflow: hidden;\n            box-shadow: var(--shadow-lg);\n        }\n\n        .hero-image-wrapper img {\n            width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        .hero-image-card {\n            position: absolute;\n            background: var(--color-mist-warm);\n            padding: 1rem 1.5rem;\n            border-radius: var(--radius-prism-2);\n            box-shadow: var(--shadow-md);\n            bottom: 30px;\n            left: -30px;\n        }\n\n        .hero-image-card strong {\n            display: block;\n            font-family: var(--font-display);\n            font-size: 2rem;\n            color: var(--color-violet);\n        }\n\n        .hero-image-card span {\n            font-size: 0.875rem;\n            color: var(--color-text-muted);\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-mist-warm);\n        }\n\n        .problem-solution-container {\n            max-width: 1000px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: 4rem;\n        }\n\n        .section-header h2 {\n            margin-bottom: 1rem;\n        }\n\n        .section-header p {\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 3rem;\n        }\n\n        .problem-card, .solution-card {\n            background: var(--color-mist);\n            padding: 2.5rem;\n            border-radius: var(--radius-prism-1);\n            border-left: 4px solid;\n            transition: var(--transition-base);\n        }\n\n        .problem-card {\n            border-color: var(--color-violet-dark);\n        }\n\n        .problem-card:hover {\n            border-color: var(--color-violet);\n            box-shadow: var(--shadow-violet);\n        }\n\n        .solution-card {\n            border-color: var(--color-chrome-dark);\n            background: var(--gradient-frost);\n        }\n\n        .solution-card:hover {\n            border-color: var(--color-violet);\n            box-shadow: var(--shadow-chrome);\n        }\n\n        .card-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-violet);\n            border-radius: var(--radius-prism-3);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n            color: var(--color-mist-warm);\n            font-size: 1.5rem;\n        }\n\n        .solution-card .card-icon {\n            background: var(--gradient-chrome);\n            color: var(--color-noir);\n        }\n\n        .problem-card h3, .solution-card h3 {\n            margin-bottom: 1rem;\n            color: var(--color-noir);\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--gradient-mist);\n        }\n\n        .services-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n            margin-top: 3rem;\n        }\n\n        .service-card {\n            background: var(--color-mist-warm);\n            padding: 2rem;\n            border-radius: var(--radius-prism-1);\n            transition: var(--transition-base);\n            border: 1px solid rgba(139, 95, 200, 0.1);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-violet);\n            transform: scaleX(0);\n            transition: var(--transition-base);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-violet);\n            border-color: rgba(139, 95, 200, 0.2);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-frost);\n            border-radius: var(--radius-prism-3);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n            color: var(--color-violet);\n            font-size: 1.5rem;\n        }\n\n        .service-card h3 {\n            margin-bottom: 0.75rem;\n            color: var(--color-noir);\n        }\n\n        .service-card p {\n            font-size: 0.9375rem;\n            margin-bottom: 1rem;\n        }\n\n        .service-link {\n            color: var(--color-violet);\n            font-weight: 600;\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .service-link:hover {\n            gap: 0.75rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-violet-deep);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .testimonials-bg {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            top: 0;\n            left: 0;\n            opacity: 0.1;\n        }\n\n        .testimonials-container {\n            max-width: 1000px;\n            margin: 0 auto;\n            position: relative;\n            z-index: 1;\n        }\n\n        .testimonials .section-header h2,\n        .testimonials .section-header p {\n            color: var(--color-mist-warm);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n            margin-top: 3rem;\n        }\n\n        .testimonial-card {\n            background: rgba(250, 250, 252, 0.1);\n            backdrop-filter: blur(10px);\n            padding: 2rem;\n            border-radius: var(--radius-prism-1);\n            border: 1px solid rgba(250, 250, 252, 0.2);\n        }\n\n        .testimonial-stars {\n            color: #FFD700;\n            margin-bottom: 1rem;\n            font-size: 1.25rem;\n        }\n\n        .testimonial-text {\n            color: var(--color-mist-warm);\n            font-style: italic;\n            margin-bottom: 1.5rem;\n            line-height: 1.8;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-frost);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-family: var(--font-display);\n            font-weight: 600;\n            color: var(--color-violet);\n        }\n\n        .testimonial-info h4 {\n            color: var(--color-mist-warm);\n            font-size: 1rem;\n            margin-bottom: 0.25rem;\n        }\n\n        .testimonial-info span {\n            color: rgba(250, 250, 252, 0.7);\n            font-size: 0.875rem;\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--gradient-mist);\n        }\n\n        .differentials-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n            margin-top: 3rem;\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: 2rem;\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            display: inline-block;\n            margin-bottom: 1.5rem;\n        }\n\n        .differential-icon {\n            width: 80px;\n            height: 80px;\n            background: var(--gradient-frost);\n            border-radius: var(--radius-prism-2);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-violet);\n            font-size: 2rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .differential-icon-wrapper::before {\n            content: '';\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            background: var(--gradient-violet);\n            border-radius: var(--radius-prism-2);\n            opacity: 0.2;\n            animation: pulse-ring 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse-ring {\n            0%, 100% {\n                transform: scale(1);\n                opacity: 0.2;\n            }\n            50% {\n                transform: scale(1.2);\n                opacity: 0;\n            }\n        }\n\n        .differential-item h3 {\n            margin-bottom: 0.75rem;\n            color: var(--color-noir);\n        }\n\n        .differential-item p {\n            font-size: 0.9375rem;\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-mist);\n        }\n\n        .contact-container {\n            max-width: 1000px;\n            margin: 0 auto;\n        }\n\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            margin-top: 3rem;\n        }\n\n        .contact-info h3 {\n            margin-bottom: 1.5rem;\n            color: var(--color-noir);\n        }\n\n        .contact-info p {\n            margin-bottom: 1rem;\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n            margin-bottom: 1.5rem;\n        }\n\n        .contact-item-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-frost);\n            border-radius: var(--radius-prism-3);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-violet);\n            flex-shrink: 0;\n        }\n\n        .contact-item-content h4 {\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            color: var(--color-noir);\n            margin-bottom: 0.25rem;\n        }\n\n        .contact-item-content p {\n            font-size: 0.9375rem;\n            margin: 0;\n        }\n\n        .contact-form {\n            background: var(--color-mist-warm);\n            padding: 2.5rem;\n            border-radius: var(--radius-prism-1);\n            box-shadow: var(--shadow-md);\n        }\n\n        .form-group {\n            margin-bottom: 1.5rem;\n        }\n\n        .form-label {\n            display: block;\n            margin-bottom: 0.5rem;\n            font-weight: 500;\n            color: var(--color-text-dark);\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 1rem;\n            border: 2px solid var(--color-frost);\n            border-radius: var(--radius-prism-2);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: var(--transition-fast);\n            background: var(--color-mist-warm);\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-violet);\n            box-shadow: 0 0 0 3px rgba(139, 95, 200, 0.1);\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1rem 2rem;\n            background: var(--gradient-violet);\n            color: var(--color-mist-warm);\n            border: none;\n            border-radius: var(--radius-prism-2);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-violet);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--color-violet-deep);\n            color: var(--color-mist-warm);\n            padding: 4rem 2rem 2rem;\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-grid {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr 1fr;\n            gap: 3rem;\n            margin-bottom: 3rem;\n        }\n\n        .footer-brand h3 {\n            color: var(--color-mist-warm);\n            font-size: 1.5rem;\n            margin-bottom: 1rem;\n        }\n\n        .footer-brand p {\n            color: rgba(250, 250, 252, 0.7);\n            margin-bottom: 1.5rem;\n        }\n\n        .footer-links h4 {\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            margin-bottom: 1rem;\n            color: var(--color-mist-warm);\n        }\n\n        .footer-links ul {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-links a {\n            color: rgba(250, 250, 252, 0.7);\n            transition: var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-mist-warm);\n        }\n\n        .footer-bottom {\n            border-top: 1px solid rgba(250, 250, 252, 0.1);\n            padding-top: 2rem;\n            text-align: center;\n            color: rgba(250, 250, 252, 0.5);\n            font-size: 0.875rem;\n        }\n\n        /* ============================================\n           ANIMATIONS\n           ============================================ */\n        @keyframes fade-up {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fade-in {\n            from {\n                opacity: 0;\n            }\n            to {\n                opacity: 1;\n            }\n        }\n\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.6s ease;\n        }\n\n        .wow-fade-in.visible {\n            opacity: 1;\n        }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 1024px) {\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .footer-grid {\n                grid-template-columns: 1fr 1fr;\n            }\n\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-ctas {\n                justify-content: center;\n            }\n\n            .hero-image {\n                order: -1;\n                max-width: 500px;\n                margin: 0 auto;\n            }\n\n            .hero-image-card {\n                left: 50%;\n                transform: translateX(-50%);\n                bottom: -20px;\n                white-space: nowrap;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                display: none;\n                position: absolute;\n                top: 100%;\n                left: 0;\n                right: 0;\n                background: var(--color-mist-warm);\n                flex-direction: column;\n                padding: 2rem;\n                gap: 1rem;\n                box-shadow: var(--shadow-lg);\n            }\n\n            .nav-menu.active {\n                display: flex;\n            }\n\n            .nav-cta {\n                width: 100%;\n                text-align: center;\n            }\n\n            .mobile-toggle {\n                display: flex;\n            }\n\n            .problem-solution-grid,\n            .contact-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-grid {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero {\n                padding: 4rem 1.5rem 2rem;\n            }\n\n            .prism {\n                opacity: 0.4;\n            }\n\n            .prism-1 {\n                width: 300px;\n                height: 300px;\n            }\n\n            .prism-2 {\n                width: 250px;\n                height: 250px;\n            }\n        }\n\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        /* ============================================\n           UTILITY CLASSES\n           ============================================ */\n        .text-center {\n            text-align: center;\n        }\n\n        .text-violet {\n            color: var(--color-violet);\n        }\n\n        .mb-1 { margin-bottom: 1rem; }\n        .mb-2 { margin-bottom: 2rem; }\n        .mb-3 { margin-bottom: 3rem; }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 2rem;\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Boto<span>Esthetic</span></a>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#inicio\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contato\" class=\"nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <div class=\"mobile-toggle\" id=\"mobileToggle\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-bg\">\n            <div class=\"prism prism-1\"></div>\n            <div class=\"prism prism-2\"></div>\n            <div class=\"prism prism-3\"></div>\n            <div class=\"prism prism-4\"></div>\n        </div>\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <span class=\"hero-badge\">Estética Avançada</span>\n                <h1 class=\"hero-title\">Sua beleza em <span>harmonia</span> perfeita</h1>\n                <p class=\"hero-subtitle\">Especialistas em harmonização facial e estética avançada em Ribeirão Preto. Resultados naturais com técnicas de ponta.</p>\n                <div class=\"hero-ctas\">\n                    <a href=\"#contato\" class=\"btn btn-primary\">Agendar Consulta</a>\n                    <a href=\"#servicos\" class=\"btn btn-secondary\">Conhecer Tratamentos</a>\n                </div>\n            </div>\n            <div class=\"hero-image\">\n                <div class=\"hero-image-wrapper\">\n                    <img src=\"https://images.unsplash.com/photo-1629909615184-74f495363b67?w=600&h=700&fit=crop&crop=faces\" alt=\"Clínica BotoEsthetic - Harmonização Facial\">\n                </div>\n                <div class=\"hero-image-card\">\n                    <strong>+10.000</strong>\n                    <span>Clientes Transformadas</span>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"problem-solution\">\n        <div class=\"problem-solution-container\">\n            <div class=\"section-header wow-fade-up\">\n                <h2>Sua Jornada Estética</h2>\n                <p>Compreendemos seus sonhos e oferecemos soluções personalizadas para realçar sua beleza natural.</p>\n            </div>\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card wow-fade-up\">\n                    <div class=\"card-icon\">✦</div>\n                    <h3>O Desafio</h3>\n                    <p>Encontrar uma clínica que combine técnica avançada com sensibilidade estética. Um lugar onde você se sinta segura e receba atendimento personalizado que respeite suas características únicas.</p>\n                </div>\n                <div class=\"solution-card wow-fade-up\">\n                    <div class=\"card-icon\">❖</div>\n                    <h3>A Solução</h3>\n                    <p>Na BotoEsthetic, unimos tecnologia de ponta com visão artística. Protocolos personalizados que valorizam sua harmonia natural, entregando resultados sofisticados e autênticos.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"services\" id=\"servicos\">\n        <div class=\"services-container\">\n            <div class=\"section-header wow-fade-up\">\n                <h2>Tratamentos Especializados</h2>\n                <p>Procedimentos faciais e corporais com técnicas avançadas e produtos de alta qualidade.</p>\n            </div>\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">◈</div>\n                    <h3>Harmonização Facial</h3>\n                    <p>Equilíbrio e simetria para seu rosto com preenchedores e toxina botulínica. Resultados naturais que realçam seus traços.</p>\n                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n                </div>\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">◉</div>\n                    <h3>Toxina Botulínica</h3>\n                    <p>Suavize linhas de expressão e previna sinais de envelhecimento. Aplicação estratégica para resultado harmônico.</p>\n                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n                </div>\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">◎</div>\n                    <h3>Preenchedores Faciais</h3>\n                    <p>Restaure volume e contorno facial. Áreas como maçãs do rosto, mandíbula, contorno dos lábios e nariz.</p>\n                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n                </div>\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">◇</div>\n                    <h3>Bioestimuladores</h3>\n                    <p>Estimule o colágeno naturalmente. Sculptra e Radiesse para rejuvenescimento progressivo e duradouro.</p>\n                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n                </div>\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">◆</div>\n                    <h3>Preenchimento Labial</h3>\n                    <p>Lábios volumosos e naturais com técnicas avançadas. Aumente a projeção e defina o contorno labial.</p>\n                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n                </div>\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">❖</div>\n                    <h3>Protocolos Exclusivos</h3>\n                    <p>Combinações personalizadas de tratamentos para resultados únicos. Cada paciente recebe um plano especial.</p>\n                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"testimonials\" id=\"depoimentos\">\n        <div class=\"testimonials-bg\">\n            <div class=\"prism prism-1\" style=\"background: linear-gradient(135deg, #A87FD8 0%, #FAFAFC 100%);\"></div>\n   