ation-delay: -10s;\n   305→        }\n   306→\n   307→        .droplet-4 {\n   308→            width: 250px;\n   309→            height: 250px;\n   310→            background: var(--gradient-lab);\n   311→            bottom: 20%;\n   312→            right: 20%;\n   313→            opacity: 0.35;\n   314→            animation-delay: -15s;\n   315→        }\n   316→\n   317→        @keyframes droplet-float {\n   318→            0%, 100% {\n   319→                transform: translate(0, 0) rotate(0deg) scale(1);\n   320→                border-radius: var(--radius-droplet-1);\n   321→            }\n   322→            25% {\n   323→                transform: translate(30px, -30px) rotate(5deg) scale(1.05);\n   324→                border-radius: var(--radius-droplet-2);\n   325→            }\n   326→            50% {\n   327→                transform: translate(-20px, 20px) rotate(-5deg) scale(0.95);\n   328→                border-radius: var(--radius-droplet-3);\n   329→            }\n   330→            75% {\n   331→                transform: translate(20px, 30px) rotate(3deg) scale(1.02);\n   332→                border-radius: var(--radius-droplet-4);\n   333→            }\n   334→        }\n   335→\n   336→        .hero-container {\n   337→            max-width: 1200px;\n   338→            margin: 0 auto;\n   339→            display: grid;\n   340→            grid-template-columns: 1fr 1fr;\n   341→            gap: 4rem;\n   342→            align-items: center;\n   343→            position: relative;\n   344→            z-index: 1;\n   345→        }\n   346→\n   347→        .hero-content {\n   348→            animation: fade-up 0.8s ease-out;\n   349→        }\n   350→\n   351→        .hero-badge {\n   352→            display: inline-block;\n   353→            background: var(--gradient-blush);\n   354→            color: var(--color-rouge-dark);\n   355→            padding: 0.5rem 1rem;\n   356→            border-radius: var(--radius-droplet-2);\n   357→            font-size: 0.875rem;\n   358→            font-weight: 600;\n   359→            margin-bottom: 1.5rem;\n   360→        }\n   361→\n   362→        .hero-title {\n   363→            margin-bottom: 1.5rem;\n   364→            animation: fade-up 0.8s ease-out 0.1s backwards;\n   365→        }\n   366→\n   367→        .hero-title span {\n   368→            color: var(--color-rouge);\n   369→        }\n   370→\n   371→        .hero-subtitle {\n   372→            font-size: 1.25rem;\n   373→            color: var(--color-text-muted);\n   374→            margin-bottom: 2rem;\n   375→            line-height: 1.8;\n   376→            animation: fade-up 0.8s ease-out 0.2s backwards;\n   377→        }\n   378→\n   379→        .hero-ctas {\n   380→            display: flex;\n   381→            gap: 1rem;\n   382→            flex-wrap: wrap;\n   383→            animation: fade-up 0.8s ease-out 0.3s backwards;\n   384→        }\n   385→\n   386→        .btn {\n   387→            display: inline-flex;\n   388→            align-items: center;\n   389→            gap: 0.5rem;\n   390→            padding: 1rem 2rem;\n   391→            border-radius: var(--radius-droplet-2);\n   392→            font-weight: 600;\n   393→            transition: var(--transition-base);\n   394→            cursor: pointer;\n   395→            border: none;\n   396→            font-size: 1rem;\n   397→        }\n   398→\n   399→        .btn-primary {\n   400→            background: var(--gradient-rouge);\n   401→            color: var(--color-porcelain);\n   402→            box-shadow: var(--shadow-rouge);\n   403→        }\n   404→\n   405→        .btn-primary:hover {\n   406→            transform: translateY(-3px);\n   407→            box-shadow: 0 12px 40px rgba(184, 92, 104, 0.45);\n   408→        }\n   409→\n   410→        .btn-secondary {\n   411→            background: transparent;\n   412→            color: var(--color-rouge);\n   413→            border: 2px solid var(--color-rouge);\n   414→        }\n   415→\n   416→        .btn-secondary:hover {\n   417→            background: var(--color-rouge);\n   418→            color: var(--color-porcelain);\n   419→        }\n   420→\n   421→        .hero-image {\n   422→            position: relative;\n   423→            animation: fade-up 0.8s ease-out 0.4s backwards;\n   424→        }\n   425→\n   426→        .hero-image-wrapper {\n   427→            position: relative;\n   428→            border-radius: var(--radius-droplet-1);\n   429→            overflow: hidden;\n   430→            box-shadow: var(--shadow-lg);\n   431→        }\n   432→\n   433→        .hero-image-wrapper img {\n   434→            width: 100%;\n   435→            height: auto;\n   436→            display: block;\n   437→        }\n   438→\n   439→        .hero-image-card {\n   440→            position: absolute;\n   441→            background: var(--color-porcelain);\n   442→            padding: 1rem 1.5rem;\n   443→            border-radius: var(--radius-droplet-2);\n   444→            box-shadow: var(--shadow-md);\n   445→            bottom: 30px;\n   446→            left: -30px;\n   447→        }\n   448→\n   449→        .hero-image-card strong {\n   450→            display: block;\n   451→            font-family: var(--font-display);\n   452→            font-size: 2rem;\n   453→            color: var(--color-rouge);\n   454→        }\n   455→\n   456→        .hero-image-card span {\n   457→            font-size: 0.875rem;\n   458→            color: var(--color-text-muted);\n   459→        }\n   460→\n   461→        /* ============================================\n   462→           PROBLEM/SOLUTION SECTION\n   463→           ============================================ */\n   464→        .problem-solution {\n   465→            padding: var(--spacing-xl) 2rem;\n   466→            background: var(--color-porcelain);\n   467→        }\n   468→\n   469→        .problem-solution-container {\n   470→            max-width: 1000px;\n   471→            margin: 0 auto;\n   472→        }\n   473→\n   474→        .section-header {\n   475→            text-align: center;\n   476→            margin-bottom: 4rem;\n   477→        }\n   478→\n   479→        .section-header h2 {\n   480→            margin-bottom: 1rem;\n   481→        }\n   482→\n   483→        .section-header p {\n   484→            max-width: 600px;\n   485→            margin: 0 auto;\n   486→        }\n   487→\n   488→        .problem-solution-grid {\n   489→            display: grid;\n   490→            grid-template-columns: 1fr 1fr;\n   491→            gap: 3rem;\n   492→        }\n   493→\n   494→        .problem-card, .solution-card {\n   495→            background: var(--color-porcelain-warm);\n   496→            padding: 2.5rem;\n   497→            border-radius: var(--radius-droplet-1);\n   498→            border-left: 4px solid;\n   499→            transition: var(--transition-base);\n   500→        }\n   501→\n   502→        .problem-card {\n   503→            border-color: var(--color-rouge-dark);\n   504→        }\n   505→\n   506→        .problem-card:hover {\n   507→            border-color: var(--color-rouge);\n   508→            box-shadow: var(--shadow-rouge);\n   509→        }\n   510→\n   511→        .solution-card {\n   512→            border-color: var(--color-lab-silver-dark);\n   513→            background: var(--gradient-blush);\n   514→        }\n   515→\n   516→        .solution-card:hover {\n   517→            border-color: var(--color-rouge);\n   518→            box-shadow: var(--shadow-lab);\n   519→        }\n   520→\n   521→        .card-icon {\n   522→            width: 60px;\n   523→            height: 60px;\n   524→            background: var(--gradient-rouge);\n   525→            border-radius: var(--radius-droplet-3);\n   526→            display: flex;\n   527→            align-items: center;\n   528→            justify-content: center;\n   529→            margin-bottom: 1.5rem;\n   530→            color: var(--color-porcelain);\n   531→            font-size: 1.5rem;\n   532→        }\n   533→\n   534→        .solution-card .card-icon {\n   535→            background: var(--gradient-lab);\n   536→        }\n   537→\n   538→        .problem-card h3, .solution-card h3 {\n   539→            margin-bottom: 1rem;\n   540→            color: var(--color-rouge-deep);\n   541→        }\n   542→\n   543→        /* ============================================\n   544→           SERVICES SECTION\n   545→           ============================================ */\n   546→        .services {\n   547→            padding: var(--spacing-xl) 2rem;\n   548→            background: var(--gradient-porcelain);\n   549→        }\n   550→\n   551→        .services-container {\n   552→            max-width: 1200px;\n   553→            margin: 0 auto;\n   554→        }\n   555→\n   556→        .services-grid {\n   557→            display: grid;\n   558→            grid-template-columns: repeat(3, 1fr);\n   559→            gap: 2rem;\n   560→            margin-top: 3rem;\n   561→        }\n   562→\n   563→        .service-card {\n   564→            background: var(--color-porcelain);\n   565→            padding: 2rem;\n   566→            border-radius: var(--radius-droplet-1);\n   567→            transition: var(--transition-base);\n   568→            border: 1px solid rgba(184, 92, 104, 0.1);\n   569→            position: relative;\n   570→            overflow: hidden;\n   571→        }\n   572→\n   573→        .service-card::before {\n   574→            content: '';\n   575→            position: absolute;\n   576→            top: 0;\n   577→            left: 0;\n   578→            right: 0;\n   579→            height: 4px;\n   580→            background: var(--gradient-rouge);\n   581→            transform: scaleX(0);\n   582→            transition: var(--transition-base);\n   583→        }\n   584→\n   585→        .service-card:hover {\n   586→            transform: translateY(-8px);\n   587→            box-shadow: var(--shadow-rouge);\n   588→            border-color: rgba(184, 92, 104, 0.2);\n   589→        }\n   590→\n   591→        .service-card:hover::before {\n   592→            transform: scaleX(1);\n   593→        }\n   594→\n   595→        .service-icon {\n   596→            width: 60px;\n   597→            height: 60px;\n   598→            background: var(--gradient-blush);\n   599→            border-radius: var(--radius-droplet-3);\n   600→            display: flex;\n   601→            align-items: center;\n   602→            justify-content: center;\n   603→            margin-bottom: 1.5rem;\n   604→            color: var(--color-rouge);\n   605→            font-size: 1.5rem;\n   606→        }\n   607→\n   608→        .service-card h3 {\n   609→            margin-bottom: 0.75rem;\n   610→            color: var(--color-rouge-deep);\n   611→        }\n   612→\n   613→        .service-card p {\n   614→            font-size: 0.9375rem;\n   615→            margin-bottom: 1rem;\n   616→        }\n   617→\n   618→        .service-link {\n   619→            color: var(--color-rouge);\n   620→            font-weight: 600;\n   621→            display: inline-flex;\n   622→            align-items: center;\n   623→            gap: 0.5rem;\n   624→        }\n   625→\n   626→        .service-link:hover {\n   627→            gap: 0.75rem;\n   628→        }\n   629→\n   630→        /* ============================================\n   631→           TESTIMONIALS SECTION\n   632→           ============================================ */\n   633→        .testimonials {\n   634→            padding: var(--spacing-xl) 2rem;\n   635→            background: var(--color-rouge-deep);\n   636→            position: relative;\n   637→            overflow: hidden;\n   638→        }\n   639→\n   640→        .testimonials-bg {\n   641→            position: absolute;\n   642→            width: 100%;\n   643→            height: 100%;\n   644→            top: 0;\n   645→            left: 0;\n   646→            opacity: 0.1;\n   647→        }\n   648→\n   649→        .testimonials-container {\n   650→            max-width: 1000px;\n   651→            margin: 0 auto;\n   652→            position: relative;\n   653→            z-index: 1;\n   654→        }\n   655→\n   656→        .testimonials .section-header h2,\n   657→        .testimonials .section-header p {\n   658→            color: var(--color-porcelain);\n   659→        }\n   660→\n   661→        .testimonials-grid {\n   662→            display: grid;\n   663→            grid-template-columns: repeat(3, 1fr);\n   664→            gap: 2rem;\n   665→            margin-top: 3rem;\n   666→        }\n   667→\n   668→        .testimonial-card {\n   669→            background: rgba(250, 250, 250, 0.1);\n   670→            backdrop-filter: blur(10px);\n   671→            padding: 2rem;\n   672→            border-radius: var(--radius-droplet-1);\n   673→            border: 1px solid rgba(250, 250, 250, 0.2);\n   674→        }\n   675→\n   676→        .testimonial-stars {\n   677→            color: #FFD700;\n   678→            margin-bottom: 1rem;\n   679→            font-size: 1.25rem;\n   680→        }\n   681→\n   682→        .testimonial-text {\n   683→            color: var(--color-porcelain);\n   684→            font-style: italic;\n   685→            margin-bottom: 1.5rem;\n   686→            line-height: 1.8;\n   687→        }\n   688→\n   689→        .testimonial-author {\n   690→            display: flex;\n   691→            align-items: center;\n   692→            gap: 1rem;\n   693→        }\n   694→\n   695→        .testimonial-avatar {\n   696→            width: 50px;\n   697→            height: 50px;\n   698→            background: var(--gradient-blush);\n   699→            border-radius: 50%;\n   700→            display: flex;\n   701→            align-items: center;\n   702→            justify-content: center;\n   703→            font-family: var(--font-display);\n   704→            font-weight: 700;\n   705→            color: var(--color-rouge);\n   706→        }\n   707→\n   708→        .testimonial-info h4 {\n   709→            color: var(--color-porcelain);\n   710→            font-size: 1rem;\n   711→            margin-bottom: 0.25rem;\n   712→        }\n   713→\n   714→        .testimonial-info span {\n   715→            color: rgba(250, 250, 250, 0.7);\n   716→            font-size: 0.875rem;\n   717→        }\n   718→\n   719→        /* ============================================\n   720→           DIFFERENTIALS SECTION\n   721→           ============================================ */\n   722→        .differentials {\n   723→            padding: var(--spacing-xl) 2rem;\n   724→            background: var(--gradient-porcelain);\n   725→        }\n   726→\n   727→        .differentials-container {\n   728→            max-width: 1200px;\n   729→            margin: 0 auto;\n   730→        }\n   731→\n   732→        .differentials-grid {\n   733→            display: grid;\n   734→            grid-template-columns: repeat(3, 1fr);\n   735→            gap: 2rem;\n   736→            margin-top: 3rem;\n   737→        }\n   738→\n   739→        .differential-item {\n   740→            text-align: center;\n   741→            padding: 2rem;\n   742→        }\n   743→\n   744→        .differential-icon-wrapper {\n   745→            position: relative;\n   746→            display: inline-block;\n   747→            margin-bottom: 1.5rem;\n   748→        }\n   749→\n   750→        .differential-icon {\n   751→            width: 80px;\n   752→            height: 80px;\n   753→            background: var(--gradient-blush);\n   754→            border-radius: var(--radius-droplet-2);\n   755→            display: flex;\n   756→            align-items: center;\n   757→            justify-content: center;\n   758→            color: var(--color-rouge);\n   759→            font-size: 2rem;\n   760→            position: relative;\n   761→            z-index: 1;\n   762→        }\n   763→\n   764→        .differential-icon-wrapper::before {\n   765→            content: '';\n   766→            position: absolute;\n   767→            width: 100%;\n   768→            height: 100%;\n   769→            background: var(--gradient-rouge);\n   770→            border-radius: var(--radius-droplet-2);\n   771→            opacity: 0.2;\n   772→            animation: pulse-ring 2s ease-in-out infinite;\n   773→        }\n   774→\n   775→        @keyframes pulse-ring {\n   776→            0%, 100% {\n   777→                transform: scale(1);\n   778→                opacity: 0.2;\n   779→            }\n   780→            50% {\n   781→                transform: scale(1.2);\n   782→                opacity: 0;\n   783→            }\n   784→        }\n   785→\n   786→        .differential-item h3 {\n   787→            margin-bottom: 0.75rem;\n   788→            color: var(--color-rouge-deep);\n   789→        }\n   790→\n   791→        .differential-item p {\n   792→            font-size: 0.9375rem;\n   793→        }\n   794→\n   795→        /* ============================================\n   796→           CONTACT SECTION\n   797→           ============================================ */\n   798→        .contact {\n   799→            padding: var(--spacing-xl) 2rem;\n   800→            background: var(--color-porcelain-warm);\n   801→        }\n   802→\n   803→        .contact-container {\n   804→            max-width: 1000px;\n   805→            margin: 0 auto;\n   806→        }\n   807→\n   808→        .contact-grid {\n   809→            display: grid;\n   810→            grid-template-columns: 1fr 1fr;\n   811→            gap: 4rem;\n   812→            margin-top: 3rem;\n   813→        }\n   814→\n   815→        .contact-info h3 {\n   816→            margin-bottom: 1.5rem;\n   817→            color: var(--color-rouge-deep);\n   818→        }\n   819→\n   820→        .contact-info p {\n   821→            margin-bottom: 1rem;\n   822→        }\n   823→\n   824→        .contact-item {\n   825→            display: flex;\n   826→            align-items: flex-start;\n   827→            gap: 1rem;\n   828→            margin-bottom: 1.5rem;\n   829→        }\n   830→\n   831→        .contact-item-icon {\n   832→            width: 50px;\n   833→            height: 50px;\n   834→            background: var(--gradient-blush);\n   835→            border-radius: var(--radius-droplet-3);\n   836→            display: flex;\n   837→            align-items: center;\n   838→            justify-content: center;\n   839→            color: var(--color-rouge);\n   840→            flex-shrink: 0;\n   841→        }\n   842→\n   843→        .contact-item-content h4 {\n   844→            font-family: var(--font-body);\n   845→            font-size: 1rem;\n   846→            font-weight: 600;\n   847→            color: var(--color-rouge-deep);\n   848→            margin-bottom: 0.25rem;\n   849→        }\n   850→\n   851→        .contact-item-content p {\n   852→            font-size: 0.9375rem;\n   853→            margin: 0;\n   854→        }\n   855→\n   856→        .contact-form {\n   857→            background: var(--color-porcelain);\n   858→            padding: 2.5rem;\n   859→            border-radius: var(--radius-droplet-1);\n   860→            box-shadow: var(--shadow-md);\n   861→        }\n   862→\n   863→        .form-group {\n   864→            margin-bottom: 1.5rem;\n   865→        }\n   866→\n   867→        .form-label {\n   868→            display: block;\n   869→            margin-bottom: 0.5rem;\n   870→            font-weight: 500;\n   871→            color: var(--color-text-dark);\n   872→        }\n   873→\n   874→        .form-input, .form-select, .form-textarea {\n   875→            width: 100%;\n   876→            padding: 1rem;\n   877→            border: 2px solid var(--color-blush-mid);\n   878→            border-radius: var(--radius-droplet-2);\n   879→            font-family: var(--font-body);\n   880→            font-size: 1rem;\n   881→            transition: var(--transition-fast);\n   882→            background: var(--color-porcelain);\n   883→        }\n   884→\n   885→        .form-input:focus, .form-select:focus, .form-textarea:focus {\n   886→            outline: none;\n   887→            border-color: var(--color-rouge);\n   888→            box-shadow: 0 0 0 3px rgba(184, 92, 104, 0.1);\n   889→        }\n   890→\n   891→        .form-textarea {\n   892→            min-height: 120px;\n   893→            resize: vertical;\n   894→        }\n   895→\n   896→        .form-submit {\n   897→            width: 100%;\n   898→            padding: 1rem 2rem;\n   899→            background: var(--gradient-rouge);\n   900→            color: var(--color-porcelain);\n   901→            border: none;\n   902→            border-radius: var(--radius-droplet-2);\n   903→            font-weight: 600;\n   904→            font-size: 1rem;\n   905→            cursor: pointer;\n   906→            transition: var(--transition-base);\n   907→        }\n   908→\n   909→        .form-submit:hover {\n   910→            transform: translateY(-2px);\n   911→            box-shadow: var(--shadow-rouge);\n   912→        }\n   913→\n   914→        /* ============================================\n   915→           FOOTER\n   916→           ============================================ */\n   917→        .footer {\n   918→            background: var(--color-rouge-deep);\n   919→            color: var(--color-porcelain);\n   920→            padding: 4rem 2rem 2rem;\n   921→        }\n   922→\n   923→        .footer-container {\n   924→            max-width: 1200px;\n   925→            margin: 0 auto;\n   926→        }\n   927→\n   928→        .footer-grid {\n   929→            display: grid;\n   930→            grid-template-columns: 2fr 1fr 1fr 1fr;\n   931→            gap: 3rem;\n   932→            margin-bottom: 3rem;\n   933→        }\n   934→\n   935→        .footer-brand h3 {\n   936→            color: var(--color-porcelain);\n   937→            font-size: 1.5rem;\n   938→            margin-bottom: 1rem;\n   939→        }\n   940→\n   941→        .footer-brand p {\n   942→            color: rgba(250, 250, 250, 0.7);\n   943→            margin-bottom: 1.5rem;\n   944→        }\n   945→\n   946→        .footer-links h4 {\n   947→            font-family: var(--font-body);\n   948→            font-size: 1rem;\n   949→            font-weight: 600;\n   950→            margin-bottom: 1rem;\n   951→            color: var(--color-porcelain);\n   952→        }\n   953→\n   954→        .footer-links ul {\n   955→            list-style: none;\n   956→        }\n   957→\n   958→        .footer-links li {\n   959→            margin-bottom: 0.5rem;\n   960→        }\n   961→\n   962→        .footer-links a {\n   963→            color: rgba(250, 250, 250, 0.7);\n   964→            transition: var(--transition-fast);\n   965→        }\n   966→\n   967→        .footer-links a:hover {\n   968→            color: var(--color-porcelain);\n   969→        }\n   970→\n   971→        .footer-bottom {\n   972→            border-top: 1px solid rgba(250, 250, 250, 0.1);\n   973→            padding-top: 2rem;\n   974→            text-align: center;\n   975→            color: rgba(250, 250, 250, 0.5);\n   976→            font-size: 0.875rem;\n   977→        }\n   978→\n   979→        /* ============================================\n   980→           ANIMATIONS\n   981→           ============================================ */\n   982→        @keyframes fade-up {\n   983→            from {\n   984→                opacity: 0;\n   985→                transform: translateY(30px);\n   986→            }\n   987→            to {\n   988→                opacity: 1;\n   989→                transform: translateY(0);\n   990→            }\n   991→        }\n   992→\n   993→        @keyframes fade-in {\n   994→            from {\n   995→                opacity: 0;\n   996→            }\n   997→            to {\n   998→                opacity: 1;\n   999→            }\n  1000→        }\n  1001→\n  1002→        .wow-fade-up {\n  1003→            opacity: 0;\n  1004→            transform: translateY(30px);\n  1005→            transition: opacity 0.6s ease, transform 0.6s ease;\n  1006→        }\n  1007→\n  1008→        .wow-fade-up.visible {\n  1009→            opacity: 1;\n  1010→            transform: translateY(0);\n  1011→        }\n  1012→\n  1013→        .wow-fade-in {\n  1014→            opacity: 0;\n  1015→            transition: opacity 0.6s ease;\n  1016→        }\n  1017→\n  1018→        .wow-fade-in.visible {\n  1019→            opacity: 1;\n  1020→        }\n  1021→\n  1022→        /* ============================================\n  1023→           RESPONSIVE DESIGN\n  1024→           ============================================ */\n  1025→        @media (max-width: 1024px) {\n  1026→            .services-grid,\n  1027→            .testimonials-grid,\n  1028→            .differentials-grid {\n  1029→                grid-template-columns: repeat(2, 1fr);\n  1030→            }\n  1031→\n  1032→            .footer-grid {\n  1033→                grid-template-columns: 1fr 1fr;\n  1034→            }\n  1035→\n  1036→            .hero-container {\n  1037→                grid-template-columns: 1fr;\n  1038→                text-align: center;\n  1039→            }\n  1040→\n  1041→            .hero-ctas {\n  1042→                justify-content: center;\n  1043→            }\n  1044→\n  1045→            .hero-image {\n  1046→                order: -1;\n  1047→                max-width: 500px;\n  1048→                margin: 0 auto;\n  1049→            }\n  1050→\n  1051→            .hero-image-card {\n  1052→                left: 50%;\n  1053→                transform: translateX(-50%);\n  1054→                bottom: -20px;\n  1055→                white-space: nowrap;\n  1056→            }\n  1057→        }\n  1058→\n  1059→        @media (max-width: 768px) {\n  1060→            .nav-menu {\n  1061→                display: none;\n  1062→                position: absolute;\n  1063→                top: 100%;\n  1064→                left: 0;\n  1065→                right: 0;\n  1066→                background: var(--color-porcelain);\n  1067→                flex-direction: column;\n  1068→                padding: 2rem;\n  1069→                gap: 1rem;\n  1070→                box-shadow: var(--shadow-lg);\n  1071→            }\n  1072→\n  1073→            .nav-menu.active {\n  1074→                display: flex;\n  1075→            }\n  1076→\n  1077→            .nav-cta {\n  1078→                width: 100%;\n  1079→                text-align: center;\n  1080→            }\n  1081→\n  1082→            .mobile-toggle {\n  1083→                display: flex;\n  1084→            }\n  1085→\n  1086→            .problem-solution-grid,\n  1087→            .contact-grid {\n  1088→                grid-template-columns: 1fr;\n  1089→            }\n  1090→\n  1091→            .services-grid,\n  1092→            .testimonials-grid,\n  1093→            .differentials-grid {\n  1094→                grid-template-columns: 1fr;\n  1095→            }\n  1096→\n  1097→            .footer-grid {\n  1098→                grid-template-columns: 1fr;\n  1099→                text-align: center;\n  1100→            }\n  1101→\n  1102→            .hero {\n  1103→                padding: 4rem 1.5rem 2rem;\n  1104→            }\n  1105→\n  1106→            .droplet {\n  1107→                opacity: 0.4;\n  1108→            }\n  1109→\n  1110→            .droplet-1 {\n  1111→                width: 300px;\n  1112→                height: 300px;\n  1113→            }\n  1114→\n  1115→            .droplet-2 {\n  1116→                width: 250px;\n  1117→                height: 250px;\n  1118→            }\n  1119→        }\n  1120→\n  1121→        @media (prefers-reduced-motion: reduce) {\n  1122→            *, *::before, *::after {\n  1123→                animation-duration: 0.01ms !important;\n  1124→                animation-iteration-count: 1 !important;\n  1125→                transition-duration: 0.01ms !important;\n  1126→            }\n  1127→        }\n  1128→\n  1129→        /* ============================================\n  1130→           UTILITY CLASSES\n  1131→           ============================================ */\n  1132→        .text-center {\n  1133→            text-align: center;\n  1134→        }\n  1135→\n  1136→        .text-rouge {\n  1137→            color: var(--color-rouge);\n  1138→        }\n  1139→\n  1140→        .mb-1 { margin-bottom: 1rem; }\n  1141→        .mb-2 { margin-bottom: 2rem; }\n  1142→        .mb-3 { margin-bottom: 3rem; }\n  1143→\n  1144→        .container {\n  1145→            max-width: 1200px;\n  1146→            margin: 0 auto;\n  1147→            padding: 0 2rem;\n  1148→        }\n  1149→    </style>\n  1150→</head>\n  1151→<body>\n  1152→    <!-- Navigation -->\n  1153→    <nav class=\"nav\" id=\"nav\">\n  1154→        <div class=\"nav-container\">\n  1155→            <a href=\"#\" class=\"nav-logo\">Dra. Camila <span>Capeli</span></a>\n  1156→            <ul class=\"nav-menu\" id=\"navMenu\">\n  1157→                <li><a href=\"#inicio\" class=\"nav-link\">Início</a></li>\n  1158→                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n  1159→                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n  1160→                <li><a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a></li>\n  1161→                <li><a href=\"#contato\" class=\"nav-cta\">Agendar Consulta</a></li>\n  1162→            </ul>\n  1163→            <div class=\"mobile-toggle\" id=\"mobileToggle\">\n  1164→                <span></span>\n  1165→                <span></span>\n  1166→                <span></span>\n  1167→            </div>\n  1168→        </div>\n  1169→    </nav>\n  1170→\n  1171→    <!-- Hero Section -->\n  1172→    <section class=\"hero\" id=\"inicio\">\n  1173→        <div class=\"hero-bg\">\n  1174→            <div class=\"droplet droplet-1\"></div>\n  1175→            <div class=\"droplet droplet-2\"></div>\n  1176→            <div class=\"droplet droplet-3\"></div>\n  1177→            <div class=\"droplet droplet-4\"></div>\n  1178→        </div>\n  1179→        <div class=\"hero-container\">\n  1180→            <div class=\"hero-content\">\n  1181→                <span class=\"hero-badge\">Biomédica Esteta</span>\n  1182→                <h1 class=\"hero-title\">Sua beleza elevada à <span>perfeição</span></h1>\n  1183→                <p class=\"hero-subtitle\">Especialista em harmonização facial, corporal e íntima. Técnicas avançadas para resultados naturais e sofisticados que realçam sua beleza única.</p>\n  1184→                <div class=\"hero-ctas\">\n  1185→                    <a href=\"#contato\" class=\"btn btn-primary\">Agendar Consulta</a>\n  1186→                    <a href=\"#servicos\" class=\"btn btn-secondary\">Conhecer Tratamentos</a>\n  1187→                </div>\n  1188→            </div>\n  1189→            <div class=\"hero-image\">\n  1190→                <div class=\"hero-image-wrapper\">\n  1191→                    <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=600&h=700&fit=crop&crop=faces\" alt=\"Dra. Camila Capeli - Biomédica Esteta\">\n  1192→                </div>\n  1193→                <div class=\"hero-image-card\">\n  1194→                    <strong>+5.000</strong>\n  1195→                    <span>Atendimentos Realizados</span>\n  1196→                </div>\n  1197→            </div>\n  1198→        </div>\n  1199→    </section>\n  1200→\n  1201→    <!-- Problem/Solution Section -->\n  1202→    <section class=\"problem-solution\">\n  1203→        <div class=\"problem-solution-container\">\n  1204→            <div class=\"section-header wow-fade-up\">\n  1205→                <h2>Sua Jornada de Transformação</h2>\n  1206→                <p>Compreendemos seus desejos e oferecemos soluções personalizadas para realçar sua beleza natural.</p>\n  1207→            </div>\n  1208→            <div class=\"problem-solution-grid\">\n  1209→                <div class=\"problem-card wow-fade-up\">\n  1210→                    <div class=\"card-icon\">✦</div>\n  1211→                    <h3>O Desafio</h3>\n  1212→                    <p>Encontrar um profissional que combine técnica científica precisa com sensibilidade estética refinada. Alguém que entenda que cada rosto e corpo são únicos e merecem uma abordagem personalizada.</p>\n  1213→                </div>\n  1214→                <div class=\"solution-card wow-fade-up\">\n  1215→                    <div class=\"card-icon\">❖</div>\n  1216→                    <h3>A Solução</h3>\n  1217→                    <p>Como Biomédica Esteta, aplico conhecimento científico avançado com visão artística. Protocolos personalizados que respeitam sua harmonia natural, entregando resultados sofisticados e autênticos.</p>\n  1218→                </div>\n  1219→            </div>\n  1220→        </div>\n  1221→    </section>\n  1222→\n  1223→    <!-- Services Section -->\n  1224→    <section class=\"services\" id=\"servicos\">\n  1225→        <div class=\"services-container\">\n  1226→            <div class=\"section-header wow-fade-up\">\n  1227→                <h2>Tratamentos Especializados</h2>\n  1228→                <p>Procedimentos faciais, corporais e íntimos com técnicas de ponta e produtos de alta qualidade.</p>\n  1229→            </div>\n  1230→            <div class=\"services-grid\">\n  1231→                <div class=\"service-card wow-fade-up\">\n  1232→                    <div class=\"service-icon\">◈</div>\n  1233→                    <h3>Harmonização Facial</h3>\n  1234→                    <p>Equilíbrio e simetria para seu rosto com preenchedores e toxina botulínica. Resultados naturais que realçam seus traços.</p>\n  1235→                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n  1236→                </div>\n  1237→                <div class=\"service-card wow-fade-up\">\n  1238→                    <div class=\"service-icon\">◉</div>\n  1239→                    <h3>Harmonização Corporal</h3>\n  1240→                    <p>Contorno corporal com bioestimuladores e preenchedores. Defina curvas e recupere a firmeza da pele.</p>\n  1241→                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n  1242→                </div>\n  1243→                <div class=\"service-card wow-fade-up\">\n  1244→                    <div class=\"service-icon\">◎</div>\n  1245→                    <h3>Harmonização Íntima</h3>\n  1246→                    <p>Procedimentos íntimos com técnica refinada e total privacidade. Recupere a autoestima e o bem-estar.</p>\n  1247→                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n  1248→                </div>\n  1249→                <div class=\"service-card wow-fade-up\">\n  1250→                    <div class=\"service-icon\">◇</div>\n  1251→                    <h3>Toxina Botulínica</h3>\n  1252→                    <p>Suavize linhas de expressão e previna sinais de envelhecimento. Aplicação estratégica para resultado harmônico.</p>\n  1253→                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n  1254→                </div>\n  1255→                <div class=\"service-card wow-fade-up\">\n  1256→                    <div class=\"service-icon\">◆</div>\n  1257→                    <h3>Preenchedores Faciais</h3>\n  1258→                    <p>Restaure volume e contorno facial. Áreas como maçãs do rosto, mandíbula, contorno dos lábios e nariz.</p>\n  1259→                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n  1260→                </div>\n  1261→                <div class=\"service-card wow-fade-up\">\n  1262→                    <div class=\"service-icon\">❖</div>\n  1263→                    <h3>Bioestimuladores</h3>\n  1264→                    <p>Estimule o colágeno naturalmente. Sculptra e Radiesse para rejuvenescimento progressivo e duradouro.</p>\n  1265→                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n  1266→                </div>\n  1267→            </div>\n  1268→        </div>\n  1269→    </section>\n  1270→\n  1271→    <!-- Testimonials Section -->\n  1272→    <section class=\"testimonials\" id=\"depoimentos\">\n  1273→        <div class=\"testimonials-bg\">\n  1274→            <div class=\"droplet droplet-1\" style=\"background: linear-gradient(135deg, #D87A88 0%, #FAFAFA 100%);\"></div>\n  1275→            <div class=\"droplet droplet-2\" style=\"background: linear-gradient(135deg, #B8B8C0 0%, #E8D5D0 100%);\"></div>\n  1276→        </div>\n  1277→        <div class=\"testimonials-container\">\n  1278→            <div class=\"section-header wow-fade-up\">\n  1279→                <h2>Depoimentos Reais</h2>\n  1280→                <p>Histórias de transformação e satisfação de nossas clientes.</p>\n  1281→            </div>\n  1282→            <div class=\"testimonials-grid\">\n  1283→                <div class=\"testimonial-card wow-fade-up\">\n  1284→                    <div class=\"testimonial-stars\">★★★★★</div>\n  1285→                    <p class=\"testimonial-text\">\"A Dra. Camila tem mãos de fada! Fiz minha harmonização facial e o resultado superou minhas expectativas. Muito profissional e atenciosa.\"</p>\n  1286→                    <div class=\"testimonial-author\">\n  1287→                        <div class=\"testimonial-avatar\">MC</div>\n  1288→                        <div class=\"testimonial-info\">\n  1289→                            <h4>Marina Costa</h4>\n  1290→                            <span>Empresária</span>\n  1291→                        </div>\n  1292→                    </div>\n  1293→                </div>\n  1294→                <div class=\"testimonial-card wow-fade-up\">\n  1295→                    <div class=\"testimonial-stars\">★★★★★</div>\n  1296→                    <p class=\"testimonial-text\">\"Estava insegura com meu rosto, mas a Dra. Camila me explicou tudo e o resultado foi super natural. Me sinto mais confiante!\"</p>\n  1297→                    <div class=\"testimonial-author\">\n  1298→                        <div class=\"testimonial-avatar\">AS</div>\n  1299→                        <div class=\"testimonial-info\">\n  1300→                            <h4>Ana Silva</h4>\n  1301→                            <span>Advogada</span>\n  1302→                        </div>\n  1303→                    </div>\n  1304→                </div>\n  1305→                <div class=\"testimonial-card wow-fade-up\">\n  1306→                    <div class=\"testimonial-stars\">★★★★★</div>\n  1307→                    <p class=\"testimonial-text\">\"Excelente profissional! O ambiente é super acolhedor e a Dra. tem muita técnica e sensibilidade estética. Recomendo muito!\"</p>\n  1308→                    <div class=\"testimonial-author\">\n  1309→                        <div class=\"testimonial-avatar\">PF</div>\n  1310→                        <div class=\"testimonial-info\">\n  1311→                            <h4>Patrícia Fernandes</h4>\n  1312→                            <span>Arquiteta</span>\n  1313→                        </div>\n  1314→                    </div>\n  1315→                </div>\n  1316→            </div>\n  1317→        </div>\n  1318→    </section>\n  1319→\n  1320→    <!-- Differentials Section -->\n  1321→    <section class=\"differentials\" id=\"diferenciais\">\n  1322→        <div class=\"differentials-container\">\n  1323→            <div class=\"section-header wow-fade-up\">\n  1324→                <h2>Por Que Escolher a Dra. Camila</h2>\n  1325→                <p>Diferenciais que fazem a diferença em seus resultados.</p>\n  1326→            </div>\n  1327→            <div class=\"differentials-grid\">\n  1328→                <div class=\"differential-item wow-fade-up\">\n  1329→                    <div class=\"differential-icon-wrapper\">\n  1330→                        <div class=\"differential-icon\">✦</div>\n  1331→                    </div>\n  1332→                    <h3>Formação Especializada</h3>\n  1333→                    <p>Biomédica com especialização em estética avançada e certificações nos principais procedimentos.</p>\n  1334→                </div>\n  1335→                <div class=\"differential-item wow-fade-up\">\n  1336→                    <div class=\"differential-icon-wrapper\">\n  1337→                        <div class=\"differential-icon\">◈</div>\n  1338→                    </div>\n  1339→                    <h3>Atendimento Personalizado</h3>\n  1340→                    <p>Cada paciente é único. Protocolos personalizados de acordo com suas características e objetivos.</p>\n  1341→                </div>\n  1342→                <div class=\"differential-item wow-fade-up\">\n  1343→                    <div class=\"differential-icon-wrapper\">\n  1344→                        <div class=\"differential-icon\">❖</div>\n  1345→                    </div>\n  1346→                    <h3>Produtos de Qualidade</h3>\n  1347→                    <p>Apenas produtos originais e certificados pela ANvisa para sua segurança e melhores resultados.</p>\n  1348→                </div>\n  1349→                <div class=\"differential-item wow-fade-up\">\n  1350→                    <div class=\"differential-icon-wrapper\">\n  1351→                        <div class=\"differential-icon\">◉</div>\n  1352→                    </div>\n  1353→                    <h3>Ambiente Acolhedor</h3>\n  1354→                    <p>Espaço privativo e confortável para que você se sinta segura e relaxada durante o procedimento.</p>\n  1355→                </div>\n  1356→                <div class=\"differential-item wow-fade-up\">\n  1357→                    <div class=\"differential-icon-wrapper\">\n  1358→                        <div class=\"differential-icon\">◎</div>\n  1359→                    </div>\n  1360→                    <h3>Técnicas Atualizadas</h3>\n  1361→                    <p>Sempre em constante atualização com as mais modernas técnicas do mercado estético.</p>\n  1362→                </div>\n  1363→                <div class=\"differential-item wow-fade-up\">\n  1364→                    <div class=\"differential-icon-wrapper\">\n  1365→                        <div class=\"differential-icon\">◆</div>\n  1366→                    </div>\n  1367→                    <h3>Acompanhamento Pós</h3>\n  1368→                    <p>Acompanhamento completo após o procedimento para sua tranquilidade e satisfação.</p>\n  1369→                </div>\n  1370→            </div>\n  1371→        </div>\n  1372→    </section>\n  1373→\n  1374→    <!-- Contact Section -->\n  1375→    <section class=\"contact\" id=\"contato\">\n  1376→        <div class=\"contact-container\">\n  1377→            <div class=\"section-header wow-fade-up\">\n  1378→                <h2>Agende Sua Consulta</h2>\n  1379→                <p>Entre em contato para transformar sua autoestima. Respondo em até 24 horas.</p>\n  1380→            </div>\n  1381→            <div class=\"contact-grid\">\n  1382→                <div class=\"contact-info wow-fade-up\">\n  1383→                    <h3>Informações de Contato</h3>\n  1384→                    <p>Estou pronta para atender você e realizar seus sonhos estéticos.</p>\n  1385→\n  1386→                    <div class=\"contact-item\">\n  1387→                        <div class=\"contact-item-icon\">📍</div>\n  1388→                        <div class=\"contact-item-content\">\n  1389→                            <h4>Endereço</h4>\n  1390→                            <p>Av. Itatiaia, 662 - Alto da Boa Vista<br>Ribeirão Preto - SP, 14025-240</p>\n  1391→                        </div>\n  1392→                    </div>\n  1393→\n  1394→                    <div class=\"contact-item\">\n  1395→                        <div class=\"contact-item-icon\">📱</div>\n  1396→                        <div class=\"contact-item-content\">\n  1397→                            <h4>WhatsApp</h4>\n  1398→                            <p>(16) 99789-5133</p>\n  1399→                        </div>\n  1400→                    </div>\n  1401→\n  1402→                    <div class=\"contact-item\">\n  1403→                        <div class=\"contact-item-icon\">⏰</div>\n  1404→                        <div class=\"contact-item-content\">\n  1405→                            <h4>Horário de Atendimento</h4>\n  1406→                            <p>Segunda a Sexta: 9h às 18h<br>Sábado: 9h às 13h</p>\n  1407→                        </div>\n  1408→                    </div>\n  1409→                </div>\n  1410→\n  1411→                <div class=\"contact-form wow-fade-up\">\n  1412→                    <form id=\"contactForm\">\n  1413→                        <div class=\"form-group\">\n  1414→                            <label class=\"form-label\" for=\"name\">Nome Completo</label>\n  1415→                            <input type=\"text\" id=\"name\" class=\"form-input\" placeholder=\"Seu nome\" required>\n  1416→                        </div>\n  1417→                        <div class=\"form-group\">\n  1418→                            <label class=\"form-label\" for=\"phone\">Telefone/WhatsApp</label>\n  1419→                            <input type=\"tel\" id=\"phone\" class=\"form-input\" placeholder=\"(00) 00000-0000\" required>\n  1420→                        </div>\n  1421→                        <div class=\"form-group\">\n  1422→                            <label class=\"form-label\" for=\"service\">Tratamento de Interesse</label>\n  1423→                            <select id=\"service\" class=\"form-select\" required>\n  1424→                                <option value=\"\">Selecione uma opção</option>\n  1425→                                <option value=\"Harmonização Facial\">Harmonização Facial</option>\n  1426→                                <option value=\"Harmonização Corporal\">Harmonização Corporal</option>\n  1427→                                <option value=\"Harmonização Íntima\">Harmonização Íntima</option>\n  1428→                                <option value=\"Toxina Botulínica\">Toxina Botulínica</option>\n  1429→                                <option value=\"Preenchedores\">Preenchedores Faciais</option>\n  1430→                                <option value=\"Bioestimuladores\">Bioestimuladores</option>\n  1431→                                <option value=\"Outro\">Outro</option>\n  1432→                            </select>\n  1433→                        </div>\n  1434→                        <div class=\"form-group\">\n  1435→                            <label class=\"form-label\" for=\"message\">Mensagem</label>\n  1436→                            <textarea id=\"message\" class=\"form-textarea\" placeholder=\"Conte-me um pouco sobre seus objetivos...\" required></textarea>\n  1437→                        </div>\n  1438→                        <button type=\"submit\" class=\"form-submit\">Enviar Mensagem pelo WhatsApp</button>\n  1439→                    </form>\n  1440→                </div>\n  1441→            </div>\n  1442→        </div>\n  1443→    </section>\n  1444→\n  1445→    <!-- Footer -->\n  1446→    <footer class=\"footer\">\n  1447→        <div class=\"footer-container\">\n  1448→            <div class=\"footer-grid\">\n  1449→                <div class=\"footer-brand\">\n  1450→                    <h3>Dra. Camila Capeli</h3>\n  1451→                    <p>Biomédica Esteta especializada em harmonização facial, corporal e íntima. Resultados naturais e sofisticados.</p>\n  1452→                </div>\n  1453→                <div class=\"footer-links\">\n  1454→                    <h4>Tratamentos</h4>\n  1455→                    <ul>\n  1456→                        <li><a href=\"#servicos\">Harmonização Facial</a></li>\n  1457→                        <li><a href=\"#servicos\">Harmonização Corporal</a></li>\n  1458→                        <li><a href=\"#servicos\">Harmonização Íntima</a></li>\n  1459→                        <li><a href=\"#servicos\">Bioestimuladores</a></li>\n  1460→                    </ul>\n  1461→                </div>\n  1462→                <div class=\"footer-links\">\n  1463→                    <h4>Links Rápidos</h4>\n  1464→                    <ul>\n  1465→                        <li><a href=\"#inicio\">Início</a></li>\n  1466→                        <li><a href=\"#servicos\">Serviços</a></li>\n  1467→                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n  1468→                        <li><a href=\"#contato\">Contato</a></li>\n  1469→                    </ul>\n  1470→                </div>\n  1471→                <div class=\"footer-links\">\n  1472→                    <h4>Contato</h4>\n  1473→                    <ul>\n  1474→                        <li>(16) 99789-5133</li>\n  1475→                        <li>Av. Itatiaia, 662</li>\n  1476→                        <li>Ribeirão Preto - SP</li>\n  1477→                    </ul>\n  1478→                </div>\n  1479→            </div>\n  1480→            <div class=\"footer-bottom\">\n  1481→                <p>&copy; 2024 Dra. Camila Capeli - Biomédica Esteta. Todos os direitos reservados.</p>\n  1482→            </div>\n  1483→        </div>\n  1484→    </footer>\n  1485→\n  1486→    <script>\n  1487→        // ============================================\n  1488→        // NAVIGATION SCROLL EFFECT\n  1489→        // ============================================\n  1490→        const nav = document.getElementById('nav');\n  1491→        const mobileToggle = document.getElementById('mobileToggle');\n  1492→        const navMenu = document.getElementById('navMenu');\n  1493→        let lastScrollY = window.scrollY;\n  1494→\n  1495→        window.addEventListener('scroll', () => {\n  1496→            const currentScrollY = window.scrollY;\n  1497→\n  1498→            if (currentScrollY > 100) {\n  1499→                nav.classList.add('scrolled');\n  1500→            } else {\n  1501→                nav.classList.remove('scrolled');\n  1502→            }\n  1503→\n  1504→            if (currentScrollY > lastScrollY && currentScrollY > 500) {\n  1505→                nav.classList.add('hidden');\n  1506→            } else {\n  1507→                nav.classList.remove('hidden');\n  1508→            }\n  1509→\n  1510→            lastScrollY = currentScrollY;\n  1511→        });\n  1512→\n  1513→        // Mobile Menu Toggle\n  1514→        mobileToggle.addEventListener('click', () => {\n  1515→            navMenu.classList.toggle('active');\n  1516→        });\n  1517→\n  1518→        // Close mobile menu when clicking a link\n  1519→        document.querySelectorAll('.nav-link').forEach(link => {\n  1520→            link.addEventListener('click', () => {\n  1521→                navMenu.classList.remove('active');\n  1522→            });\n  1523→        });\n  1524→\n  1525→        // Smooth scroll for anchor links\n  1526→        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n  1527→            anchor.addEventListener('click', function(e) {\n  1528→                e.preventDefault();\n  1529→                const target = document.querySelector(this.getAttribute('href'));\n  1530→                if (target) {\n  1531→                    const navHeight = nav.offsetHeight;\n  1532→                    const targetPosition = target.offsetTop - navHeight;\n  1533→                    window.scrollTo({\n  1534→                        top: targetPosition,\n  1535→                        behavior: 'smooth'\n  1536→                    });\n  1537→                }\n  1538→            });\n  1539→        });\n  1540→\n  1541→        // ============================================\n  1542→        // INTERSECTION OBSERVER FOR SCROLL ANIMATIONS\n  1543→        // ============================================\n  1544→        const observerOptions = {\n  1545→            threshold: 0.1,\n  1546→            rootMargin: '0px 0px -50px 0px'\n  1547→        };\n  1548→\n  1549→        const observer = new IntersectionObserver((entries) => {\n  1550→            entries.forEach(entry => {\n  1551→                if (entry.isIntersecting) {\n  1552→                    entry.target.classList.add('visible');\n  1553→                    observer.unobserve(entry.target);\n  1554→                }\n  1555→            });\n  1556→        }, observerOptions);\n  1557→\n  1558→        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n  1559→            observer.observe(el);\n  1560→        });\n  1561→\n  1562→        // ============================================\n  1563→        // PARALLAX EFFECT FOR DROPLETS\n  1564→        // ============================================\n  1565→        document.addEventListener('mousemove', (e) => {\n  1566→            const droplets = document.querySelectorAll('.droplet');\n  1567→            const mouseX = e.clientX / window.innerWidth;\n  1568→            const mouseY = e.clientY / window.innerHeight;\n  1569→\n  1570→            droplets.forEach((droplet, index) => {\n  1571→                const speed = (index + 1) * 10;\n  1572→                const x = (mouseX - 0.5) * speed;\n  1573→                const y = (mouseY - 0.5) * speed;\n  1574→                droplet.style.transform = `translate(${x}px, ${y}px)`;\n  1575→            });\n  1576→        });\n  1577→\n  1578→        // ============================================\n  1579→        // CONTACT FORM - WHATSAPP INTEGRATION\n  1580→        // ============================================\n  1581→        const contactForm = document.getElementById('contactForm');\n  1582→\n  1583→        contactForm.addEventListener('submit', (e) => {\n  1584→            e.preventDefault();\n  1585→\n  1586→            const name = document.getElementById('name').value;\n  1587→            const phone = document.getElementById('phone').value;\n  1588→            const service = document.getElementById('service').value;\n  1589→            const message = document.getElementById('message').value;\n  1590→\n  1591→            const whatsappNumber = '551697895133';\n  1592→            const whatsappMessage = encodeURIComponent(\n  1593→                `Olá Dra. Camila Capeli! Meu nome é *${name}*\\n\\n` +\n  1594→                `*Telefone:* ${phone}\\n` +\n  1595→                `*Tratamento de interesse:* ${service}\\n` +\n  1596→                `*Mensagem:* ${message}\\n\\n` +\n  1597→                `Gostaria de agendar uma consulta.`\n  1598→            );\n  1599→\n  1600→            const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;\n  1601→\n  1602→            window.open(whatsappUrl, '_blank');\n  1603→\n  1604→            contactForm.reset();\n  1605→        });\n  1606→\n  1607→        // ============================================\n  1608→        // PULSE RING ANIMATION FOR DIFFERENTIAL ICONS\n  1609→        // ============================================\n  1610→        document.querySelectorAll('.differential-icon-wrapper').forEach(wrapper => {\n  1611→            const icon = wrapper.querySelector('.differential-icon');\n  1612→            let currentScale = 1;\n  1613→            let isAnimating = true;\n  1614→\n  1615→            setInterval(() => {\n  1616→                if (isAnimating && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n  1617→                    currentScale = currentScale === 1 ? 1.05 : 1;\n  1618→                    icon.style.transform = `scale(${currentScale})`;\n  1619→                }\n  1620→            }, 2000);\n  1621→        });\n  1622→\n  1623→        // ============================================\n  1624→        // PREFERRED REDUCED MOTION\n  1625→        // ============================================\n  1626→        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n  1627→            document.querySelectorAll('.droplet').forEach(droplet => {\n  1628→                droplet.style.animation = 'none';\n  1629→            });\n  1630→        }\n  1631→    </script>\n  1632→</body>\n  1633→</html>\n  1634→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"c96d8321-48e7-4c30-aa26-744b7d13df68","uuid":"323f9461-3f7a-44c0-8811-b4d6c61ac5ea","tool_use_result":{"type":"text","file":{"filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-camila-capeli-biomedica-esteta/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Camila Capeli | Biomédica Esteta - Harmonização Facial e Corporal em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Camila Capeli - Biomédica Esteta especializada em harmonização facial, corporal e íntima em Ribeirão Preto. Atendimento personalizado com técnicas avançadas.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        /* ============================================\n           CSS RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        :root {\n            /* Porcelain & Rouge Noir Palette */\n            --color-porcelain: #FAFAFA;\n            --color-porcelain-warm: #F5F5F5;\n            --color-porcelain-soft: #F0F0F0;\n\n            --color-blush: #E8D5D0;\n            --color-blush-light: #F0E5E0;\n            --color-blush-mid: #D8C5C0;\n            --color-blush-deep: #C8B5B0;\n\n            --color-rouge: #B85C68;\n            --color-rouge-light: #D87A88;\n            --color-rouge-mid: #A85060;\n            --color-rouge-dark: #884048;\n            --color-rouge-deep: #682830;\n\n            --color-lab-silver: #B8B8C0;\n            --color-lab-silver-light: #C8C8D0;\n            --color-lab-silver-dark: #A8A8B0;\n            --color-lab-silver-mid: #A0A0A8;\n\n            --color-onyx: #1A1A1A;\n            --color-charcoal: #2A2A2A;\n            --color-stone: #3A3A3A;\n\n            --color-text-dark: #1A1A1A;\n            --color-text-muted: #6A6A6A;\n            --color-text-light: #FAFAFA;\n\n            /* Gradients */\n            --gradient-rouge: linear-gradient(135deg, #B85C68 0%, #884048 100%);\n            --gradient-rouge-rich: linear-gradient(135deg, #D87A88 0%, #B85C68 50%, #884048 100%);\n            --gradient-blush: linear-gradient(135deg, #E8D5D0 0%, #D8C5C0 100%);\n            --gradient-porcelain: linear-gradient(135deg, #FAFAFA 0%, #F5F5F5 100%);\n            --gradient-lab: linear-gradient(135deg, #B85C68 0%, #B8B8C0 100%);\n            --gradient-shimmer: linear-gradient(90deg, transparent, rgba(184, 92, 104, 0.3), transparent);\n\n            /* Typography */\n            --font-display: 'Cormorant Garamond', Georgia, serif;\n            --font-body: 'Plus Jakarta Sans', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Border Radius - Droplet/Syringe Shapes */\n            --radius-droplet-1: 68% 32% 50% 50% / 50% 40% 60% 50%;\n            --radius-droplet-2: 50% 50% 35% 65% / 45% 55% 45% 55%;\n            --radius-droplet-3: 55% 45% 60% 40% / 50% 50% 50% 50%;\n            --radius-droplet-4: 40% 60% 45% 55% / 55% 45% 55% 45%;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(26, 26, 26, 0.08);\n            --shadow-md: 0 8px 24px rgba(26, 26, 26, 0.12);\n            --shadow-lg: 0 16px 48px rgba(26, 26, 26, 0.16);\n            --shadow-rouge: 0 8px 32px rgba(184, 92, 104, 0.35);\n            --shadow-lab: 0 8px 32px rgba(184, 184, 192, 0.35);\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.6;\n            color: var(--color-text-dark);\n            background-color: var(--color-porcelain);\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-rouge-deep);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            letter-spacing: -0.01em;\n        }\n\n        h3 {\n            font-size: clamp(1.25rem, 2.5vw, 1.75rem);\n        }\n\n        p {\n            font-size: 1rem;\n            line-height: 1.7;\n            color: var(--color-text-muted);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            background: rgba(250, 250, 250, 0.95);\n            backdrop-filter: blur(20px);\n            border-bottom: 1px solid rgba(184, 92, 104, 0.1);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav.scrolled {\n            box-shadow: 0 4px 20px rgba(184, 92, 104, 0.1);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 1rem 2rem;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-rouge);\n            letter-spacing: -0.02em;\n        }\n\n        .nav-logo span {\n            color: var(--color-lab-silver-dark);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: 2rem;\n            list-style: none;\n        }\n\n        .nav-link {\n            font-weight: 500;\n            color: var(--color-text-dark);\n            position: relative;\n            padding: 0.5rem 0;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-rouge);\n            transition: width var(--transition-base);\n        }\n\n        .nav-link:hover {\n            color: var(--color-rouge);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--gradient-rouge);\n            color: var(--color-porcelain);\n            padding: 0.75rem 1.5rem;\n            border-radius: var(--radius-droplet-2);\n            font-weight: 600;\n            transition: var(--transition-base);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-rouge);\n            color: var(--color-porcelain);\n        }\n\n        .mobile-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .mobile-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-rouge);\n            transition: var(--transition-base);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            position: relative;\n            overflow: hidden;\n            background: var(--gradient-porcelain);\n            padding: 6rem 2rem 4rem;\n        }\n\n        .hero-bg {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            top: 0;\n            left: 0;\n            overflow: hidden;\n            z-index: 0;\n        }\n\n        .droplet {\n            position: absolute;\n            border-radius: var(--radius-droplet-1);\n            opacity: 0.6;\n            filter: blur(60px);\n            animation: droplet-float 20s ease-in-out infinite;\n        }\n\n        .droplet-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-blush);\n            top: -100px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .droplet-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-rouge);\n            bottom: -50px;\n            left: -50px;\n            opacity: 0.4;\n            animation-delay: -5s;\n        }\n\n        .droplet-3 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(135deg, #B8B8C0 0%, #E8D5D0 100%);\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            opacity: 0.3;\n            animation-delay: -10s;\n        }\n\n        .droplet-4 {\n            width: 250px;\n            height: 250px;\n            background: var(--gradient-lab);\n            bottom: 20%;\n            right: 20%;\n            opacity: 0.35;\n            animation-delay: -15s;\n        }\n\n        @keyframes droplet-float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n                border-radius: var(--radius-droplet-1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg) scale(1.05);\n                border-radius: var(--radius-droplet-2);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg) scale(0.95);\n                border-radius: var(--radius-droplet-3);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(3deg) scale(1.02);\n                border-radius: var(--radius-droplet-4);\n            }\n        }\n\n        .hero-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .hero-content {\n            animation: fade-up 0.8s ease-out;\n        }\n\n        .hero-badge {\n            display: inline-block;\n            background: var(--gradient-blush);\n            color: var(--color-rouge-dark);\n            padding: 0.5rem 1rem;\n            border-radius: var(--radius-droplet-2);\n            font-size: 0.875rem;\n            font-weight: 600;\n            margin-bottom: 1.5rem;\n        }\n\n        .hero-title {\n            margin-bottom: 1.5rem;\n            animation: fade-up 0.8s ease-out 0.1s backwards;\n        }\n\n        .hero-title span {\n            color: var(--color-rouge);\n        }\n\n        .hero-subtitle {\n            font-size: 1.25rem;\n            color: var(--color-text-muted);\n            margin-bottom: 2rem;\n            line-height: 1.8;\n            animation: fade-up 0.8s ease-out 0.2s backwards;\n        }\n\n        .hero-ctas {\n            display: flex;\n            gap: 1rem;\n            flex-wrap: wrap;\n            animation: fade-up 0.8s ease-out 0.3s backwards;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            border-radius: var(--radius-droplet-2);\n            font-weight: 600;\n            transition: var(--transition-base);\n            cursor: pointer;\n            border: none;\n            font-size: 1rem;\n        }\n\n        .btn-primary {\n            background: var(--gradient-rouge);\n            color: var(--color-porcelain);\n            box-shadow: var(--shadow-rouge);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 12px 40px rgba(184, 92, 104, 0.45);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-rouge);\n            border: 2px solid var(--color-rouge);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-rouge);\n            color: var(--color-porcelain);\n        }\n\n        .hero-image {\n            position: relative;\n            animation: fade-up 0.8s ease-out 0.4s backwards;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            border-radius: var(--radius-droplet-1);\n            overflow: hidden;\n            box-shadow: var(--shadow-lg);\n        }\n\n        .hero-image-wrapper img {\n            width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        .hero-image-card {\n            position: absolute;\n            background: var(--color-porcelain);\n            padding: 1rem 1.5rem;\n            border-radius: var(--radius-droplet-2);\n            box-shadow: var(--shadow-md);\n            bottom: 30px;\n            left: -30px;\n        }\n\n        .hero-image-card strong {\n            display: block;\n            font-family: var(--font-display);\n            font-size: 2rem;\n            color: var(--color-rouge);\n        }\n\n        .hero-image-card span {\n            font-size: 0.875rem;\n            color: var(--color-text-muted);\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-porcelain);\n        }\n\n        .problem-solution-container {\n            max-width: 1000px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: 4rem;\n        }\n\n        .section-header h2 {\n            margin-bottom: 1rem;\n        }\n\n        .section-header p {\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 3rem;\n        }\n\n        .problem-card, .solution-card {\n            background: var(--color-porcelain-warm);\n            padding: 2.5rem;\n            border-radius: var(--radius-droplet-1);\n            border-left: 4px solid;\n            transition: var(--transition-base);\n        }\n\n        .problem-card {\n            border-color: var(--color-rouge-dark);\n        }\n\n        .problem-card:hover {\n            border-color: var(--color-rouge);\n            box-shadow: var(--shadow-rouge);\n        }\n\n        .solution-card {\n            border-color: var(--color-lab-silver-dark);\n            background: var(--gradient-blush);\n        }\n\n        .solution-card:hover {\n            border-color: var(--color-rouge);\n            box-shadow: var(--shadow-lab);\n        }\n\n        .card-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-rouge);\n            border-radius: var(--radius-droplet-3);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n            color: var(--color-porcelain);\n            font-size: 1.5rem;\n        }\n\n        .solution-card .card-icon {\n            background: var(--gradient-lab);\n        }\n\n        .problem-card h3, .solution-card h3 {\n            margin-bottom: 1rem;\n            color: var(--color-rouge-deep);\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--gradient-porcelain);\n        }\n\n        .services-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n            margin-top: 3rem;\n        }\n\n        .service-card {\n            background: var(--color-porcelain);\n            padding: 2rem;\n            border-radius: var(--radius-droplet-1);\n            transition: var(--transition-base);\n            border: 1px solid rgba(184, 92, 104, 0.1);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-rouge);\n            transform: scaleX(0);\n            transition: var(--transition-base);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-rouge);\n            border-color: rgba(184, 92, 104, 0.2);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-blush);\n            border-radius: var(--radius-droplet-3);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n            color: var(--color-rouge);\n            font-size: 1.5rem;\n        }\n\n        .service-card h3 {\n            margin-bottom: 0.75rem;\n            color: var(--color-rouge-deep);\n        }\n\n        .service-card p {\n            font-size: 0.9375rem;\n            margin-bottom: 1rem;\n        }\n\n        .service-link {\n            color: var(--color-rouge);\n            font-weight: 600;\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .service-link:hover {\n            gap: 0.75rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-rouge-deep);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .testimonials-bg {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            top: 0;\n            left: 0;\n            opacity: 0.1;\n        }\n\n        .testimonials-container {\n            max-width: 1000px;\n            margin: 0 auto;\n            position: relative;\n            z-index: 1;\n        }\n\n        .testimonials .section-header h2,\n        .testimonials .section-header p {\n            color: var(--color-porcelain);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n            margin-top: 3rem;\n        }\n\n        .testimonial-card {\n            background: rgba(250, 250, 250, 0.1);\n            backdrop-filter: blur(10px);\n            padding: 2rem;\n            border-radius: var(--radius-droplet-1);\n            border: 1px solid rgba(250, 250, 250, 0.2);\n        }\n\n        .testimonial-stars {\n            color: #FFD700;\n            margin-bottom: 1rem;\n            font-size: 1.25rem;\n        }\n\n        .testimonial-text {\n            color: var(--color-porcelain);\n            font-style: italic;\n            margin-bottom: 1.5rem;\n            line-height: 1.8;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-blush);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-family: var(--font-display);\n            font-weight: 700;\n            color: var(--color-rouge);\n        }\n\n        .testimonial-info h4 {\n            color: var(--color-porcelain);\n            font-size: 1rem;\n            margin-bottom: 0.25rem;\n        }\n\n        .testimonial-info span {\n            color: rgba(250, 250, 250, 0.7);\n            font-size: 0.875rem;\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--gradient-porcelain);\n        }\n\n        .differentials-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n            margin-top: 3rem;\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: 2rem;\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            display: inline-block;\n            margin-bottom: 1.5rem;\n        }\n\n        .differential-icon {\n            width: 80px;\n            height: 80px;\n            background: var(--gradient-blush);\n            border-radius: var(--radius-droplet-2);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-rouge);\n            font-size: 2rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .differential-icon-wrapper::before {\n            content: '';\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            background: var(--gradient-rouge);\n            border-radius: var(--radius-droplet-2);\n            opacity: 0.2;\n            animation: pulse-ring 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse-ring {\n            0%, 100% {\n                transform: scale(1);\n                opacity: 0.2;\n            }\n            50% {\n                transform: scale(1.2);\n                opacity: 0;\n            }\n        }\n\n        .differential-item h3 {\n            margin-bottom: 0.75rem;\n            color: var(--color-rouge-deep);\n        }\n\n        .differential-item p {\n            font-size: 0.9375rem;\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-porcelain-warm);\n        }\n\n        .contact-container {\n            max-width: 1000px;\n            margin: 0 auto;\n        }\n\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            margin-top: 3rem;\n        }\n\n        .contact-info h3 {\n            margin-bottom: 1.5rem;\n            color: var(--color-rouge-deep);\n        }\n\n        .contact-info p {\n            margin-bottom: 1rem;\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n            margin-bottom: 1.5rem;\n        }\n\n        .contact-item-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-blush);\n            border-radius: var(--radius-droplet-3);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-rouge);\n            flex-shrink: 0;\n        }\n\n        .contact-item-content h4 {\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            color: var(--color-rouge-deep);\n            margin-bottom: 0.25rem;\n        }\n\n        .contact-item-content p {\n            font-size: 0.9375rem;\n            margin: 0;\n        }\n\n        .contact-form {\n            background: var(--color-porcelain);\n            padding: 2.5rem;\n            border-radius: var(--radius-droplet-1);\n            box-shadow: var(--shadow-md);\n        }\n\n        .form-group {\n            margin-bottom: 1.5rem;\n        }\n\n        .form-label {\n            display: block;\n            margin-bottom: 0.5rem;\n            font-weight: 500;\n            color: var(--color-text-dark);\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 1rem;\n            border: 2px solid var(--color-blush-mid);\n            border-radius: var(--radius-droplet-2);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: var(--transition-fast);\n            background: var(--color-porcelain);\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-rouge);\n            box-shadow: 0 0 0 3px rgba(184, 92, 104, 0.1);\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1rem 2rem;\n            background: var(--gradient-rouge);\n            color: var(--color-porcelain);\n            border: none;\n            border-radius: var(--radius-droplet-2);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-rouge);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--color-rouge-deep);\n            color: var(--color-porcelain);\n            padding: 4rem 2rem 2rem;\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-grid {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr 1fr;\n            gap: 3rem;\n            margin-bottom: 3rem;\n        }\n\n        .footer-brand h3 {\n            color: var(--color-porcelain);\n            font-size: 1.5rem;\n            margin-bottom: 1rem;\n        }\n\n        .footer-brand p {\n            color: rgba(250, 250, 250, 0.7);\n            margin-bottom: 1.5rem;\n        }\n\n        .footer-links h4 {\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            margin-bottom: 1rem;\n            color: var(--color-porcelain);\n        }\n\n        .footer-links ul {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-links a {\n            color: rgba(250, 250, 250, 0.7);\n            transition: var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-porcelain);\n        }\n\n        .footer-bottom {\n            border-top: 1px solid rgba(250, 250, 250, 0.1);\n            padding-top: 2rem;\n            text-align: center;\n            color: rgba(250, 250, 250, 0.5);\n            font-size: 0.875rem;\n        }\n\n        /* ============================================\n           ANIMATIONS\n           ============================================ */\n        @keyframes fade-up {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fade-in {\n            from {\n                opacity: 0;\n            }\n            to {\n                opacity: 1;\n            }\n        }\n\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.6s ease;\n        }\n\n        .wow-fade-in.visible {\n            opacity: 1;\n        }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 1024px) {\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .footer-grid {\n                grid-template-columns: 1fr 1fr;\n            }\n\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-ctas {\n                justify-content: center;\n            }\n\n            .hero-image {\n                order: -1;\n                max-width: 500px;\n                margin: 0 auto;\n            }\n\n            .hero-image-card {\n                left: 50%;\n                transform: translateX(-50%);\n                bottom: -20px;\n                white-space: nowrap;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                display: none;\n                position: absolute;\n                top: 100%;\n                left: 0;\n                right: 0;\n                background: var(--color-porcelain);\n                flex-direction: column;\n                padding: 2rem;\n                gap: 1rem;\n                box-shadow: var(--shadow-lg);\n            }\n\n            .nav-menu.active {\n                display: flex;\n            }\n\n            .nav-cta {\n                width: 100%;\n                text-align: center;\n            }\n\n            .mobile-toggle {\n                display: flex;\n            }\n\n            .problem-solution-grid,\n            .contact-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-grid {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero {\n                padding: 4rem 1.5rem 2rem;\n            }\n\n            .droplet {\n                opacity: 0.4;\n            }\n\n            .droplet-1 {\n                width: 300px;\n                height: 300px;\n            }\n\n            .droplet-2 {\n                width: 250px;\n                height: 250px;\n            }\n        }\n\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        /* ============================================\n           UTILITY CLASSES\n           ============================================ */\n        .text-center {\n            text-align: center;\n        }\n\n        .text-rouge {\n            color: var(--color-rouge);\n        }\n\n        .mb-1 { margin-bottom: 1rem; }\n        .mb-2 { margin-bottom: 2rem; }\n        .mb-3 { margin-bottom: 3rem; }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 2rem;\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Camila <span>Capeli</span></a>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#inicio\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contato\" class=\"nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <div class=\"mobile-toggle\" id=\"mobileToggle\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-bg\">\n            <div class=\"droplet droplet-1\"></div>\n            <div class=\"droplet droplet-2\"></div>\n            <div class=\"droplet droplet-3\"></div>\n            <div class=\"droplet droplet-4\"></div>\n        </div>\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <span class=\"hero-badge\">Biomédica Esteta</span>\n                <h1 class=\"hero-title\">Sua beleza elevada à <span>perfeição</span></h1>\n                <p class=\"hero-subtitle\">Especialista em harmonização facial, corporal e íntima. Técnicas avançadas para resultados naturais e sofisticados que realçam sua beleza única.</p>\n                <div class=\"hero-ctas\">\n                    <a href=\"#contato\" class=\"btn btn-primary\">Agendar Consulta</a>\n                    <a href=\"#servicos\" class=\"btn btn-secondary\">Conhecer Tratamentos</a>\n                </div>\n            </div>\n            <div class=\"hero-image\">\n                <div class=\"hero-image-wrapper\">\n                    <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=600&h=700&fit=crop&crop=faces\" alt=\"Dra. Camila Capeli - Biomédica Esteta\">\n                </div>\n                <div class=\"hero-image-card\">\n                    <strong>+5.000</strong>\n                    <span>Atendimentos Realizados</span>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"problem-solution\">\n        <div class=\"problem-solution-container\">\n            <div class=\"section-header wow-fade-up\">\n                <h2>Sua Jornada de Transformação</h2>\n                <p>Compreendemos seus desejos e oferecemos soluções personalizadas para realçar sua beleza natural.</p>\n            </div>\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card wow-fade-up\">\n                    <div class=\"card-icon\">✦</div>\n                    <h3>O Desafio</h3>\n                    <p>Encontrar um profissional que combine técnica científica precisa com sensibilidade estética refinada. Alguém que entenda que cada rosto e corpo são únicos e merecem uma abordagem personalizada.</p>\n                </div>\n                <div class=\"solution-card wow-fade-up\">\n                    <div class=\"card-icon\">❖</div>\n                    <h3>A Solução</h3>\n                    <p>Como Biomédica Esteta, aplico conhecimento científico avançado com visão artística. Protocolos personalizados que respeitam sua harmonia natural, entregando resultados sofisticados e autênticos.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"services\" id=\"servicos\">\n        <div class=\"services-container\">\n            <div class=\"section-header wow-fade-up\">\n                <h2>Tratamentos Especializados</h2>\n                <p>Procedimentos faciais, corporais e íntimos com técnicas de ponta e produtos de alta qualidade.</p>\n            </div>\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">◈</div>\n                    <h3>Harmonização Facial</h3>\n                    <p>Equilíbrio e simetria para seu rosto com preenchedores e toxina botulínica. Resultados naturais que realçam seus traços.</p>\n                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n                </div>\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">◉</div>\n                    <h3>Harmonização Corporal</h3>\n                    <p>Contorno corporal com bioestimuladores e preenchedores. Defina curvas e recupere a firmeza da pele.</p>\n                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n                </div>\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">◎</div>\n                    <h3>Harmonização Íntima</h3>\n                    <p>Procedimentos íntimos com técnica refinada e total privacidade. Recupere a autoestima e o bem-estar.</p>\n                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n                </div>\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">◇</div>\n                    <h3>Toxina Botulínica</h3>\n                    <p>Suavize linhas de expressão e previna sinais de envelhecimento. Aplicação estratégica para resultado harmônico.</p>\n                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n                </div>\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">◆</div>\n                    <h3>Preenchedores Faciais</h3>\n                    <p>Restaure volume e contorno facial. Áreas como maçãs do rosto, mandíbula, contorno dos lábios e nariz.</p>\n                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n                </div>\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">❖</div>\n                    <h3>Bioestimuladores</h3>\n                    <p>Estimule o colágeno naturalmente. Sculptra e Radiesse para rejuvenescimento progressivo e duradouro.</p>\n                    <a href=\"#contato\" class=\"service-link\">Agendar →</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"testimonials\" id=\"depoimentos\">\n        <div class=\"testimonials-bg\">\n            <div class=\"droplet droplet-1\" style=\"background: linear-gradient(135deg, #D87A88 0%, #FAFAFA 100%);\"></div>\n            <div class=\"droplet droplet-2\" style=\"background: linear-gradient(135deg, #B8B8C0 0%, #E8D5D0 100%);\"></div>\n        </div>\n        <div class=\"testimonials-container\">\n            <div class=\"section-header wow-fade-up\">\n                <h2>Depoimentos Reais</h2>\n                <p>Histórias de transformação e satisfação de nossas clientes.</p>\n            </div>\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"A Dra. Camila tem mãos de fada! Fiz minha harmonização facial e o resultado superou minhas expectativas. Muito profissional e atenciosa.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Marina Costa</h4>\n                            <span>Empresária</span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Estava insegura com meu rosto, mas a Dra. Camila me explicou tudo e o resultado foi super natural. Me sinto mais confiante!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AS</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Ana Silva</h4>\n                            <span>Advogada</span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Excelente profissional! O ambiente é super acolhedor e a Dra. tem muita técnica e sensibilidade estética. Recomendo muito!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">PF</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Patrícia Fernandes</h4>\n                            <span>Arquiteta</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"differentials\" id=\"diferenciais\">\n        <div class=\"differentials-container\">\n            <div class=\"section-header wow-fade-up\">\n                <h2>Por Que Escolher a Dra. Camila</h2>\n                <p>Diferenciais que fazem a diferença em seus resultados.</p>\n            </div>\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">✦</div>\n                    </div>\n                    <h3>Formação Especializada</h3>\n                    <p>Biomédica com especialização em estética avançada e certificações nos principais procedimentos.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">◈</div>\n                    </div>\n                    <h3>Atendimento Personalizado</h3>\n                    <p>Cada paciente é único. Protocolos personalizados de acordo com suas características e objetivos.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">❖</div>\n                    </div>\n                    <h3>Produtos de Qualidade</h3>\n                    <p>Apenas produtos originais e certificados pela ANvisa para sua segurança e melhores resultados.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">◉</div>\n                    </div>\n                    <h3>Ambiente Acolhedor</h3>\n                    <p>Espaço privativo e confortável para que você se sinta segura e relaxada durante o procedimento.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">◎</div>\n                    </div>\n                    <h3>Técnicas Atualizadas</h3>\n                    <p>Sempre em constante atualização com as mais modernas técnicas do mercado estético.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">◆</div>\n                    </div>\n                    <h3>Acompanhamento Pós</h3>\n                    <p>Acompanhamento completo após o procedimento para sua tranquilidade e satisfação.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"contact\" id=\"contato\">\n        <div class=\"contact-container\">\n            <div class=\"section-header wow-fade-up\">\n                <h2>Agende Sua Consulta</h2>\n                <p>Entre em contato para transformar sua autoestima. Respondo em até 24 horas.</p>\n            </div>\n            <div class=\"contact-grid\">\n                <div class=\"contact-info wow-fade-up\">\n                    <h3>Informações de Contato</h3>\n                    <p>Estou pronta para atender você e realizar seus sonhos estéticos.</p>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">📍</div>\n                        <div class=\"contact-item-content\">\n                            <h4>Endereço</h4>\n                            <p>Av. Itatiaia, 662 - Alto da Boa Vista<br>Ribeirão Preto - SP, 14025-240</p>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">📱</div>\n                        <div class=\"contact-item-content\">\n                            <h4>WhatsApp</h4>\n                            <p>(16) 99789-5133</p>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">⏰</div>\n                        <div class=\"contact-item-content\">\n                            <h4>Horário de Atendimento</h4>\n                            <p>Segunda a Sexta: 9h às 18h<br>Sábado: 9h às 13h</p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"contact-form wow-fade-up\">\n                    <form id=\"contactForm\">\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"name\">Nome Completo</label>\n                            <input type=\"text\" id=\"name\" class=\"form-input\" placeholder=\"Seu nome\" required>\n                        </div>\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"phone\">Telefone/WhatsApp</label>\n                            <input type=\"tel\" id=\"phone\" class=\"form-input\" placeholder=\"(00) 00000-0000\" required>\n                        </div>\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"service\">Tratamento de Interesse</label>\n                            <select id=\"service\" class=\"form-select\" required>\n                                <option value=\"\">Selecione uma opção</option>\n                                <option value=\"Harmonização Facial\">Harmonização Facial</option>\n                                <option value=\"Harmonização Corporal\">Harmonização Corporal</option>\n                                <option value=\"Harmonização Íntima\">Harmonização Íntima</option>\n                                <option value=\"Toxina Botulínica\">Toxina Botulínica</option>\n                                <option value=\"Preenchedores\">Preenchedores Faciais</option>\n                                <option value=\"Bioestimuladores\">Bioestimuladores</option>\n                                <option value=\"Outro\">Outro</option>\n                            </select>\n                        </div>\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"message\">Mensagem</label>\n                            <textarea id=\"message\" class=\"form-textarea\" placeholder=\"Conte-me um pouco sobre seus objetivos...\" required></textarea>\n                        </div>\n                        <button type=\"submit\" class=\"form-submit\">Enviar Mensagem pelo WhatsApp</button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-grid\">\n                <div class=\"footer-brand\">\n                    <h3>Dra. Camila Capeli</h3>\n                    <p>Biomédica Esteta especializada em harmonização facial, corporal e íntima. Resultados naturais e sofisticados.</p>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Tratamentos</h4>\n                    <ul>\n                        <li><a href=\"#servicos\">Harmonização Facial</a></li>\n                        <li><a href=\"#servicos\">Harmonização Corporal</a></li>\n                        <li><a href=\"#servicos\">Harmonização Íntima</a></li>\n                        <li><a href=\"#servicos\">Bioestimuladores</a></li>\n                    </ul>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Links Rápidos</h4>\n                    <ul>\n                        <li><a href=\"#inicio\">Início</a></li>\n                        <li><a href=\"#servicos\">Serviços</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                        <li><a href=\"#contato\">Contato</a></li>\n                    </ul>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Contato</h4>\n                    <ul>\n                        <li>(16) 99789-5133</li>\n                        <li>Av. Itatiaia, 662</li>\n                        <li>Ribeirão Preto - SP</li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"footer-bottom\">\n                <p>&copy; 2024 Dra. Camila Capeli - Biomédica Esteta. Todos os direitos reservados.</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION SCROLL EFFECT\n        // ============================================\n        const nav = document.getElementById('nav');\n        const mobileToggle = document.getElementById('mobileToggle');\n        const navMenu = document.getElementById('navMenu');\n        let lastScrollY = window.scrollY;\n\n        window.addEventListener('scroll', () => {\n            const currentScrollY = window.scrollY;\n\n            if (currentScrollY > 100) {\n                nav.classList.add('scrolled');\n            } else {\n                nav.classList.remove('scrolled');\n            }\n\n            if (currentScrollY > lastScrollY && currentScrollY > 500) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n\n            lastScrollY = currentScrollY;\n        });\n\n        // Mobile Menu Toggle\n        mobileToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close mobile menu when clicking a link\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER FOR SCROLL ANIMATIONS\n        // ============================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('visible');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // PARALLAX EFFECT FOR DROPLETS\n        // ============================================\n        document.addEventListener('mousemove', (e) => {\n            const droplets = document.querySelectorAll('.droplet');\n            const mouseX = e.clientX / window.innerWidth;\n            const mouseY = e.clientY / window.innerHeight;\n\n            droplets.forEach((droplet, index) => {\n                const speed = (index + 1) * 10;\n                const x = (mouseX - 0.5) * speed;\n                const y = (mouseY - 0.5) * speed;\n                droplet.style.transform = `translate(${x}px, ${y}px)`;\n            });\n        });\n\n        // ============================================\n        // CONTACT FORM - WHATSAPP INTEGRATION\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const whatsappNumber = '551697895133';\n            const whatsappMessage = encodeURIComponent(\n                `Olá Dra. Camila Capeli! Meu nome é *${name}*\\n\\n` +\n                `*Telefone:* ${phone}\\n` +\n                `*Tratamento de interesse:* ${service}\\n` +\n                `*Mensagem:* ${message}\\n\\n` +\n                `Gostaria de agendar uma consulta.`\n            );\n\n            const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;\n\n            window.open(whatsappUrl, '_blank');\n\n            contactForm.reset();\n        });\n\n        // ============================================\n        // PULSE RING ANIMATION FOR DIFFERENTIAL ICONS\n        // ============================================\n        document.querySelectorAll('.differential-icon-wrapper').forEach(wrapper => {\n            const icon = wrapper.querySelector('.differential-icon');\n            let currentScale = 1;\n            let isAnimating = true;\n\n            setInterval(() => {\n                if (isAnimating && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n                    currentScale = currentScale === 1 ? 1.05 : 1;\n                    icon.style.transform = `scale(${currentScale})`;\n                }\n            }, 2000);\n        });\n\n        // ============================================\n        // PREFERRED REDUCED MOTION\n        // ============================================\n        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n            document.querySelectorAll('.droplet').forEach(droplet => {\n                droplet.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>\n","numLines":1634,"startLine":1,"totalLines":1634}}}
