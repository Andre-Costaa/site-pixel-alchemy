          <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            <path d=\"M8 14s1.5 2 4 2 4-2 4-2\"/>\n                            <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"/>\n                            <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"/>\n                        </svg>\n                    </div>\n                    <h3>O que te preocupa</h3>\n                    <ul class=\"problem-list\">\n                        <li>Sinais de envelhecimento facial</li>\n                        <li>Perda de contorno e volume</li>\n                        <li>Rugas e linhas de expressão</li>\n                        <li>Assimetria facial</li>\n                        <li>Aparência cansada</li>\n                    </ul>\n                </div>\n                <div class=\"solution-card wow-fade-up stagger-2\">\n                    <div class=\"card-icon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Nossa solução</h3>\n                    <ul class=\"solution-list\">\n                        <li>Harmonização facial personalizada</li>\n                        <li>Técnicas avançadas e minimamente invasivas</li>\n                        <li>Resultados naturais e equilibrados</li>\n                        <li>Procedimentos rápidos e seguros</li>\n                        <li>Aparência descansada e revitalizada</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Se