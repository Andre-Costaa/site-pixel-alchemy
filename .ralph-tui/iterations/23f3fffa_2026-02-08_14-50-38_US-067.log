ion status\n\n<promise>COMPLETE</promise>"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"f120efb9-698b-4e5a-a54e-a533148cc544","uuid":"fca89b3e-fbf7-4ca6-8009-12ceb32ac6a9"}
