{"type":"assistant","message":{"id":"msg_20260209021623d67d573bd3f24748","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_b6fd6970ab4d4facbb789d58","name":"Write","input":{"file_path":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-miriam-freitas-estetica-facial-e-corporal/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Miriam Freitas | Estética Facial e Corporal em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Miriam Freitas - Estética Facial e Corporal em Ribeirão Preto. Harmonização facial, tratamentos corporais e estética avançada com resultados naturais.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            /* Ruby Noir & Antique Silver Palette */\n            --color-ruby: #B83A5A;\n            --color-ruby-light: #D84A7A;\n            --color-ruby-mid: #C8486A;\n            --color-ruby-dark: #982A4A;\n            --color-ruby-deep: #681A2A;\n\n            --color-silver: #B8B8C0;\n            --color-silver-light: #C8C8D0;\n            --color-silver-dark: #9898A0;\n            --color-silver-antique: #A8A8B0;\n            --color-silver-shimmer: #D8D8E0;\n\n            --color-porcelain: #FAFAF8;\n            --color-porcelain-warm: #F5F5F2;\n            --color-cream: #F8F6F4;\n            --color-ivory: #FDFCFA;\n\n            --color-rose-blush: #E8C8D0;\n            --color-rose-dust: #D8B8C0;\n\n            --color-charcoal: #2A2828;\n            --color-charcoal-dark: #1A1818;\n            --color-ink: #1A1A1A;\n\n            /* Gradients */\n            --gradient-ruby: linear-gradient(135deg, var(--color-ruby) 0%, var(--color-ruby-light) 50%, var(--color-ruby-mid) 100%);\n            --gradient-silver: linear-gradient(135deg, var(--color-silver) 0%, var(--color-silver-light) 100%);\n            --gradient-rose: linear-gradient(135deg, var(--color-rose-blush) 0%, var(--color-porcelain) 100%);\n            --gradient-ivory: linear-gradient(180deg, var(--color-porcelain) 0%, var(--color-cream) 100%);\n            --gradient-gemstone: linear-gradient(145deg, var(--color-ruby-dark) 0%, var(--color-ruby) 30%, var(--color-silver-light) 70%, var(--color-porcelain) 100%);\n\n            /* Typography */\n            --font-display: 'Crimson Pro', Georgia, serif;\n            --font-body: 'Space Grotesk', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 1.5rem;\n            --spacing-lg: 2rem;\n            --spacing-xl: 3rem;\n            --spacing-2xl: 4rem;\n            --spacing-3xl: 6rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 12px;\n            --radius-lg: 20px;\n            --radius-faceted-1: 55% 45% 40% 60% / 50% 40% 60% 50%;\n            --radius-faceted-2: 45% 55% 60% 40% / 40% 60% 50% 40%;\n            --radius-faceted-3: 60% 40% 50% 50% / 45% 55% 40% 55%;\n            --radius-faceted-4: 40% 60% 50% 50% / 55% 45% 50% 45%;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.3s ease;\n            --transition-slow: 0.5s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(184, 58, 90, 0.08);\n            --shadow-md: 0 4px 16px rgba(184, 58, 90, 0.12);\n            --shadow-lg: 0 8px 32px rgba(184, 58, 90, 0.16);\n            --shadow-ruby: 0 4px 20px rgba(184, 58, 90, 0.2);\n            --shadow-silver: 0 4px 20px rgba(184, 184, 192, 0.15);\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background: var(--gradient-ivory);\n            color: var(--color-charcoal);\n            line-height: 1.6;\n            overflow-x: hidden;\n        }\n\n        /* Typography */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-ruby-deep);\n        }\n\n        h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); }\n        h2 { font-size: clamp(2rem, 4vw, 3rem); }\n        h3 { font-size: clamp(1.25rem, 2.5vw, 1.75rem); }\n\n        p {\n            font-size: clamp(0.95rem, 1.2vw, 1.1rem);\n            color: var(--color-charcoal);\n            opacity: 0.85;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* Navigation */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-md) var(--spacing-lg);\n            background: rgba(250, 250, 248, 0.95);\n            backdrop-filter: blur(10px);\n            border-bottom: 1px solid rgba(184, 58, 90, 0.1);\n            transition: transform 0.3s ease, padding 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-ruby-dark);\n        }\n\n        .nav-links {\n            display: flex;\n            gap: var(--spacing-lg);\n            list-style: none;\n        }\n\n        .nav-links a {\n            font-weight: 500;\n            font-size: 0.95rem;\n            color: var(--color-charcoal);\n            position: relative;\n        }\n\n        .nav-links a::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-ruby);\n            transition: width var(--transition-base);\n        }\n\n        .nav-links a:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.6rem 1.4rem;\n            background: var(--gradient-ruby);\n            color: white;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            transition: var(--transition-base);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-ruby);\n        }\n\n        .nav-menu-btn {\n            display: none;\n            background: none;\n            border: none;\n            font-size: 1.5rem;\n            cursor: pointer;\n            color: var(--color-ruby-dark);\n        }\n\n        /* Mobile Menu */\n        .nav-mobile {\n            display: none;\n            position: fixed;\n            top: 70px;\n            left: 0;\n            right: 0;\n            background: var(--color-porcelain);\n            padding: var(--spacing-lg);\n            border-bottom: 1px solid rgba(184, 58, 90, 0.1);\n            z-index: 999;\n        }\n\n        .nav-mobile.active {\n            display: block;\n        }\n\n        .nav-mobile-links {\n            list-style: none;\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-md);\n        }\n\n        .nav-mobile-links a {\n            font-weight: 500;\n            padding: var(--spacing-sm) 0;\n            border-bottom: 1px solid rgba(184, 58, 90, 0.1);\n        }\n\n        /* Hero Section */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            padding: var(--spacing-3xl) var(--spacing-lg);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .hero-gemstones {\n            position: absolute;\n            inset: 0;\n            overflow: hidden;\n            z-index: 0;\n        }\n\n        .hero-gemstone {\n            position: absolute;\n            border-radius: var(--radius-faceted-1);\n            filter: blur(60px);\n            opacity: 0.35;\n            animation: gemstoneFloat 20s ease-in-out infinite;\n        }\n\n        .hero-gemstone-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-ruby);\n            top: -150px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .hero-gemstone-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-silver);\n            bottom: -100px;\n            left: -100px;\n            animation-delay: 5s;\n        }\n\n        .hero-gemstone-3 {\n            width: 300px;\n            height: 300px;\n            background: var(--color-rose-blush);\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: 10s;\n        }\n\n        .hero-gemstone-4 {\n            width: 350px;\n            height: 350px;\n            background: linear-gradient(135deg, var(--color-silver-light) 0%, var(--color-ruby-light) 100%);\n            bottom: 20%;\n            right: 10%;\n            animation-delay: 15s;\n        }\n\n        @keyframes gemstoneFloat {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n                border-radius: var(--radius-faceted-1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(90deg) scale(1.1);\n                border-radius: var(--radius-faceted-2);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(180deg) scale(0.95);\n                border-radius: var(--radius-faceted-3);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(270deg) scale(1.05);\n                border-radius: var(--radius-faceted-4);\n            }\n        }\n\n        .hero-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-3xl);\n            align-items: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .hero-content {\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease forwards;\n        }\n\n        @keyframes fadeInUp {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 0.5rem 1rem;\n            background: var(--gradient-rose);\n            border-radius: var(--radius-lg);\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-ruby-dark);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-badge::before {\n            content: '';\n            width: 8px;\n            height: 8px;\n            background: var(--color-ruby);\n            border-radius: 50%;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; transform: scale(1); }\n            50% { opacity: 0.7; transform: scale(1.1); }\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-title em {\n            font-style: normal;\n            background: var(--gradient-ruby);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-description {\n            font-size: 1.1rem;\n            margin-bottom: var(--spacing-lg);\n            opacity: 0.9;\n        }\n\n        .hero-ctas {\n            display: flex;\n            gap: var(--spacing-md);\n            flex-wrap: wrap;\n        }\n\n        .btn-primary {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 0.8rem 1.8rem;\n            background: var(--gradient-ruby);\n            color: white;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .btn-primary::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            background: linear-gradient(135deg, transparent 0%, rgba(255,255,255,0.2) 100%);\n            opacity: 0;\n            transition: opacity var(--transition-base);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-ruby);\n        }\n\n        .btn-primary:hover::before {\n            opacity: 1;\n        }\n\n        .btn-secondary {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 0.8rem 1.8rem;\n            background: transparent;\n            color: var(--color-ruby-dark);\n            border: 2px solid var(--color-ruby);\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            transition: var(--transition-base);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-ruby);\n            color: white;\n        }\n\n        .hero-visual {\n            position: relative;\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease 0.2s forwards;\n        }\n\n        .hero-card {\n            background: rgba(255, 255, 255, 0.8);\n            backdrop-filter: blur(10px);\n            border-radius: var(--radius-lg);\n            padding: var(--spacing-lg);\n            box-shadow: var(--shadow-lg);\n            border: 1px solid rgba(184, 58, 90, 0.1);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .hero-card::before {\n            content: '';\n            position: absolute;\n            top: -50%;\n            right: -50%;\n            width: 100%;\n            height: 100%;\n            background: var(--gradient-ruby);\n            opacity: 0.05;\n            border-radius: 50%;\n        }\n\n        .hero-card-image {\n            width: 100%;\n            height: 300px;\n            object-fit: cover;\n            border-radius: var(--radius-md);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-card-stats {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n        }\n\n        .stat-item {\n            text-align: center;\n        }\n\n        .stat-value {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-ruby-dark);\n        }\n\n        .stat-label {\n            font-size: 0.8rem;\n            color: var(--color-charcoal);\n            opacity: 0.7;\n        }\n\n        /* Section Styles */\n        .section {\n            padding: var(--spacing-3xl) var(--spacing-lg);\n            position: relative;\n        }\n\n        .section-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-2xl);\n        }\n\n        .section-subtitle {\n            display: inline-block;\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-ruby);\n            text-transform: uppercase;\n            letter-spacing: 2px;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .section-title {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .section-description {\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        /* Problem/Solution Section */\n        .problem-solution {\n            background: var(--color-porcelain-warm);\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: var(--spacing-xl);\n        }\n\n        .problem-card, .solution-card {\n            background: white;\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-md);\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .problem-card::before {\n            content: '';\n            position: absolute;\n            left: 0;\n            top: 0;\n            bottom: 0;\n            width: 4px;\n            background: var(--color-ruby-dark);\n        }\n\n        .solution-card::before {\n            content: '';\n            position: absolute;\n            left: 0;\n            top: 0;\n            bottom: 0;\n            width: 4px;\n            background: var(--gradient-ruby);\n        }\n\n        .problem-card:hover, .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .card-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-rose);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-md);\n            font-size: 1.5rem;\n        }\n\n        .card-title {\n            margin-bottom: var(--spacing-md);\n            color: var(--color-ruby-dark);\n        }\n\n        .card-list {\n            list-style: none;\n        }\n\n        .card-list li {\n            padding: var(--spacing-sm) 0;\n            padding-left: 1.5rem;\n            position: relative;\n            border-bottom: 1px solid rgba(184, 58, 90, 0.1);\n        }\n\n        .card-list li:last-child {\n            border-bottom: none;\n        }\n\n        .card-list li::before {\n            content: '•';\n            position: absolute;\n            left: 0;\n            color: var(--color-ruby);\n            font-size: 1.2rem;\n        }\n\n        /* Services Section */\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .service-card {\n            background: white;\n            border-radius: var(--radius-lg);\n            padding: var(--spacing-xl);\n            box-shadow: var(--shadow-sm);\n            transition: var(--transition-base);\n            border: 1px solid rgba(184, 58, 90, 0.08);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-ruby);\n            transform: scaleX(0);\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-ruby);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-rose);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-md);\n            font-size: 1.8rem;\n        }\n\n        .service-title {\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.3rem;\n        }\n\n        .service-description {\n            font-size: 0.95rem;\n            margin-bottom: var(--spacing-md);\n            opacity: 0.8;\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            color: var(--color-ruby);\n            font-weight: 600;\n            font-size: 0.9rem;\n        }\n\n        .service-link::after {\n            content: '→';\n            transition: transform var(--transition-base);\n        }\n\n        .service-link:hover::after {\n            transform: translateX(5px);\n        }\n\n        /* Testimonials Section */\n        .testimonials {\n            background: linear-gradient(135deg, var(--color-ruby-deep) 0%, var(--color-ruby-dark) 100%);\n            color: white;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .testimonials::before {\n            content: '';\n            position: absolute;\n            top: -50%;\n            right: -20%;\n            width: 600px;\n            height: 600px;\n            background: var(--gradient-silver);\n            opacity: 0.1;\n            border-radius: 50%;\n            filter: blur(100px);\n        }\n\n        .testimonials .section-subtitle {\n            color: var(--color-rose-blush);\n        }\n\n        .testimonials .section-title {\n            color: white;\n        }\n\n        .testimonials .section-description {\n            color: rgba(255, 255, 255, 0.8);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n            position: relative;\n            z-index: 1;\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.1);\n            backdrop-filter: blur(10px);\n            border-radius: var(--radius-lg);\n            padding: var(--spacing-xl);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            transition: var(--transition-base);\n        }\n\n        .testimonial-card:hover {\n            background: rgba(255, 255, 255, 0.15);\n            transform: translateY(-5px);\n        }\n\n        .testimonial-rating {\n            display: flex;\n            gap: var(--spacing-xs);\n            margin-bottom: var(--spacing-md);\n            font-size: 1.2rem;\n        }\n\n        .testimonial-rating span {\n            color: var(--color-silver-light);\n        }\n\n        .testimonial-text {\n            font-size: 0.95rem;\n            line-height: 1.7;\n            margin-bottom: var(--spacing-md);\n            color: rgba(255, 255, 255, 0.9);\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 45px;\n            height: 45px;\n            border-radius: 50%;\n            background: var(--gradient-gemstone);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: white;\n        }\n\n        .testimonial-info {\n            flex: 1;\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n            color: white;\n        }\n\n        .testimonial-role {\n            font-size: 0.85rem;\n            color: rgba(255, 255, 255, 0.7);\n        }\n\n        /* Differentials Section */\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-lg);\n            transition: var(--transition-base);\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            width: 80px;\n            height: 80px;\n            margin: 0 auto var(--spacing-md);\n        }\n\n        .differential-icon-wrapper::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            background: var(--gradient-ruby);\n            opacity: 0.15;\n            border-radius: var(--radius-faceted-1);\n            animation: iconPulse 3s ease-in-out infinite;\n        }\n\n        @keyframes iconPulse {\n            0%, 100% { transform: scale(1); opacity: 0.15; }\n            50% { transform: scale(1.1); opacity: 0.25; }\n        }\n\n        .differential-icon {\n            position: relative;\n            z-index: 1;\n            width: 100%;\n            height: 100%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 2rem;\n        }\n\n        .differential-title {\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.1rem;\n        }\n\n        .differential-description {\n            font-size: 0.9rem;\n            opacity: 0.8;\n        }\n\n        /* Contact Section */\n        .contact {\n            background: var(--color-porcelain-warm);\n        }\n\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-2xl);\n        }\n\n        .contact-info {\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-lg);\n        }\n\n        .contact-info-item {\n            display: flex;\n            gap: var(--spacing-md);\n            align-items: flex-start;\n        }\n\n        .contact-info-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-rose);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.2rem;\n            flex-shrink: 0;\n        }\n\n        .contact-info-content h4 {\n            margin-bottom: var(--spacing-xs);\n            font-size: 1rem;\n        }\n\n        .contact-info-content p {\n            font-size: 0.95rem;\n            opacity: 0.8;\n        }\n\n        .contact-form-wrapper {\n            background: white;\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-md);\n        }\n\n        .form-title {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-description {\n            margin-bottom: var(--spacing-lg);\n            font-size: 0.95rem;\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-label {\n            display: block;\n            margin-bottom: var(--spacing-xs);\n            font-weight: 500;\n            font-size: 0.9rem;\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 0.8rem 1rem;\n            border: 2px solid rgba(184, 58, 90, 0.15);\n            border-radius: var(--radius-md);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: var(--transition-base);\n            background: var(--color-porcelain);\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-ruby);\n            background: white;\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1rem;\n            background: var(--gradient-ruby);\n            color: white;\n            border: none;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-ruby);\n        }\n\n        /* Footer */\n        .footer {\n            background: var(--color-ruby-deep);\n            color: white;\n            padding: var(--spacing-2xl) var(--spacing-lg) var(--spacing-lg);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: var(--spacing-2xl);\n            margin-bottom: var(--spacing-xl);\n        }\n\n        .footer-brand h3 {\n            color: white;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-brand p {\n            color: rgba(255, 255, 255, 0.7);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .footer-links h4 {\n            color: var(--color-rose-blush);\n            margin-bottom: var(--spacing-md);\n            font-size: 1rem;\n        }\n\n        .footer-links ul {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-links a {\n            color: rgba(255, 255, 255, 0.7);\n            font-size: 0.9rem;\n        }\n\n        .footer-links a:hover {\n            color: white;\n        }\n\n        .footer-bottom {\n            text-align: center;\n            padding-top: var(--spacing-lg);\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            color: rgba(255, 255, 255, 0.5);\n            font-size: 0.85rem;\n        }\n\n        /* Animations */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.6s ease;\n        }\n\n        .wow-fade-in.visible {\n            opacity: 1;\n        }\n\n        /* Responsive Design */\n        @media (max-width: 1024px) {\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-links, .nav-cta {\n                display: none;\n            }\n\n            .nav-menu-btn {\n                display: block;\n            }\n\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-ctas {\n                justify-content: center;\n            }\n\n            .hero-visual {\n                order: -1;\n            }\n\n            .problem-solution-grid,\n            .contact-grid,\n            .footer-content {\n                grid-template-columns: 1fr;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .hero-visual, .hero-card {\n                display: none;\n            }\n        }\n\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        /* Focus styles for accessibility */\n        a:focus, button:focus, .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: 3px solid var(--color-ruby-light);\n            outline-offset: 2px;\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Miriam Freitas</a>\n            <ul class=\"nav-links\">\n                <li><a href=\"#inicio\">Início</a></li>\n                <li><a href=\"#servicos\">Serviços</a></li>\n                <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                <li><a href=\"#contato\">Contato</a></li>\n            </ul>\n            <a href=\"#contato\" class=\"nav-cta\">Agendar Consulta</a>\n            <button class=\"nav-menu-btn\" id=\"navMenuBtn\" aria-label=\"Menu\">☰</button>\n        </div>\n    </nav>\n\n    <!-- Mobile Menu -->\n    <div class=\"nav-mobile\" id=\"navMobile\">\n        <ul class=\"nav-mobile-links\">\n            <li><a href=\"#inicio\">Início</a></li>\n            <li><a href=\"#servicos\">Serviços</a></li>\n            <li><a href=\"#depoimentos\">Depoimentos</a></li>\n            <li><a href=\"#contato\">Contato</a></li>\n        </ul>\n    </div>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-gemstones\">\n            <div class=\"hero-gemstone hero-gemstone-1\"></div>\n            <div class=\"hero-gemstone hero-gemstone-2\"></div>\n            <div class=\"hero-gemstone hero-gemstone-3\"></div>\n            <div class=\"hero-gemstone hero-gemstone-4\"></div>\n        </div>\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <span class=\"hero-badge\">Estética Facial e Corporal</span>\n                <h1 class=\"hero-title\">Realce sua <em>beleza natural</em> com tratamentos exclusivos</h1>\n                <p class=\"hero-description\">Transforme sua aparência com tratamentos personalizados de harmonização facial e estética corporal. Resultados naturais que realçam o que você tem de melhor.</p>\n                <div class=\"hero-ctas\">\n                    <a href=\"#contato\" class=\"btn-primary\">\n                        <span>Agendar Consulta</span>\n                        <span>→</span>\n                    </a>\n                    <a href=\"#servicos\" class=\"btn-secondary\">\n                        <span>Conhecer Serviços</span>\n                    </a>\n                </div>\n            </div>\n            <div class=\"hero-visual\">\n                <div class=\"hero-card\">\n                    <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=600&h=400&fit=crop\" alt=\"Estética Facial\" class=\"hero-card-image\">\n                    <div class=\"hero-card-stats\">\n                        <div class=\"stat-item\">\n                            <div class=\"stat-value\">10+</div>\n                            <div class=\"stat-label\">Anos de Exp.</div>\n                        </div>\n                        <div class=\"stat-item\">\n                            <div class=\"stat-value\">5000+</div>\n                            <div class=\"stat-label\">Clientes</div>\n                        </div>\n                        <div class=\"stat-item\">\n                            <div class=\"stat-value\">98%</div>\n                            <div class=\"stat-label\">Satisfação</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-subtitle\">Sua Transformação</span>\n                <h2 class=\"section-title\">Supere as inseguranças, descubra sua melhor versão</h2>\n            </div>\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card wow-fade-up\">\n                    <div class=\"card-icon\">😔</div>\n                    <h3 class=\"card-title\">Desafios que enfrentamos</h3>\n                    <ul class=\"card-list\">\n                        <li>Sinais de envelhecimento facial</li>\n                        <li>Perda de contorno do rosto</li>\n                        <li>Gordura localizada difícil de eliminar</li>\n                        <li>Flacidez da pele</li>\n                        <li>Autoestima afetada pela aparência</li>\n                    </ul>\n                </div>\n                <div class=\"solution-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"card-icon\">✨</div>\n                    <h3 class=\"card-title\">Nossa solução exclusiva</h3>\n                    <ul class=\"card-list\">\n                        <li>Harmonização facial com resultados naturais</li>\n                        <li>Protocolos corporais personalizados</li>\n                        <li>Tecnologia de ponta em estética</li>\n                        <li>Acompanhamento completo</li>\n                        <li>Recupere sua confiança e autoestima</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-subtitle\">Nossos Serviços</span>\n                <h2 class=\"section-title\">Tratamentos especializados para você</h2>\n                <p class=\"section-description\">Oferecemos uma linha completa de procedimentos estéticos faciais e corporais com tecnologia avançada e profissionais qualificados.</p>\n            </div>\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">💆</div>\n                    <h3 class=\"service-title\">Harmonização Facial</h3>\n                    <p class=\"service-description\">Equilibre seus traços faciais com preenchedores e toxina botulínica para um resultado natural e harmonioso.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"100\">\n                    <div class=\"service-icon\">💉</div>\n                    <h3 class=\"service-title\">Toxina Botulínica</h3>\n                    <p class=\"service-description\">Suavize linhas de expressão e previna rugas com aplicações estratégicas e naturalidade.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"service-icon\">💎</div>\n                    <h3 class=\"service-title\">Preenchedores Faciais</h3>\n                    <p class=\"service-description\">Restaure volume e contorno facial com ácido hialurônico de alta qualidade.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"300\">\n                    <div class=\"service-icon\">👄</div>\n                    <h3 class=\"service-title\">Preenchimento Labial</h3>\n                    <p class=\"service-description\">Aumente o volume dos lábios e defina seu contorno com naturalidade e equilíbrio.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"service-icon\">🔬</div>\n                    <h3 class=\"service-title\">Bioestimuladores</h3>\n                    <p class=\"service-description\">Estimule o colágeno natural da sua pele para um rejuvenescimento progressivo e duradouro.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"500\">\n                    <div class=\"service-icon\">⭐</div>\n                    <h3 class=\"service-title\">Protocolos Corporais</h3>\n                    <p class=\"service-description\">Tratamentos personalizados para gordura localizada, flacidez e celulite.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-subtitle\">Depoimentos</span>\n                <h2 class=\"section-title\">O que nossas clientes dizem</h2>\n                <p class=\"section-description\">Histórias reais de transformação e satisfação com nossos tratamentos.</p>\n            </div>\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up\">\n                    <div class=\"testimonial-rating\">\n                        <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>\n                    </div>\n                    <p class=\"testimonial-text\">\"A Dra. Mirium é excelente! Fiz minha harmonização facial e o resultado ficou super natural. Todos elogiam!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div class=\"testimonial-info\">\n                            <div class=\"testimonial-name\">Maria Clara</div>\n                            <div class=\"testimonial-role\">Empresária</div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"100\">\n                    <div class=\"testimonial-rating\">\n                        <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>\n                    </div>\n                    <p class=\"testimonial-text\">\"Recuperei minha autoestima com os tratamentos corporais. Profissionalismo e dedicação em cada sessão.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AS</div>\n                        <div class=\"testimonial-info\">\n                            <div class=\"testimonial-name\">Ana Silva</div>\n                            <div class=\"testimonial-role\">Advogada</div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"testimonial-rating\">\n                        <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>\n                    </div>\n                    <p class=\"testimonial-text\">\"O preenchimento labial ficou perfeito! A Dra. Mirium entendeu exatamente o que eu queria. Recomendo muito!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">PL</div>\n                        <div class=\"testimonial-info\">\n                            <div class=\"testimonial-name\">Patrícia Lima</div>\n                            <div class=\"testimonial-role\">Professora</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-subtitle\">Diferenciais</span>\n                <h2 class=\"section-title\">Por que escolher a Dra. Miriam Freitas?</h2>\n            </div>\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">🎓</div>\n                    </div>\n                    <h3 class=\"differential-title\">Formação Especializada</h3>\n                    <p class=\"differential-description\">Atualização constante com os melhores cursos e certificações em estética avançada.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"100\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">🔬</div>\n                    </div>\n                    <h3 class=\"differential-title\">Tecnologia de Ponta</h3>\n                    <p class=\"differential-description\">Utilizamos os produtos mais modernos e seguros do mercado estético.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"200\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">💝</div>\n                    </div>\n                    <h3 class=\"differential-title\">Atendimento Personalizado</h3>\n                    <p class=\"differential-description\">Cada paciente é único: protocolos individualizados para melhores resultados.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"300\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">✅</div>\n                    </div>\n                    <h3 class=\"differential-title\">Resultados Naturais</h3>\n                    <p class=\"differential-description\">Nosso foco é realçar sua beleza natural, nunca transformar completamente.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"400\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">🏥</div>\n                    </div>\n                    <h3 class=\"differential-title\">Ambiente Seguro</h3>\n                    <p class=\"differential-description\">Clínica equipada e seguindo todas as normas de biossegurança.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"500\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">📞</div>\n                    </div>\n                    <h3 class=\"differential-title\">Suporte Completo</h3>\n                    <p class=\"differential-description\">Acompanhamento antes, durante e depois dos procedimentos.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-subtitle\">Contato</span>\n                <h2 class=\"section-title\">Agende sua consulta</h2>\n                <p class=\"section-description\">Entre em contato para transformar sua aparência e recuperar sua autoestima.</p>\n            </div>\n            <div class=\"contact-grid\">\n                <div class=\"contact-info\">\n                    <div class=\"contact-info-item wow-fade-up\">\n                        <div class=\"contact-info-icon\">📍</div>\n                        <div class=\"contact-info-content\">\n                            <h4>Endereço</h4>\n                            <p>R. Magda Perona Frossard, 770 - Sala 10<br>Nova Aliança, Ribeirão Preto - SP<br>CEP: 14026-596</p>\n                        </div>\n                    </div>\n                    <div class=\"contact-info-item wow-fade-up\" data-delay=\"100\">\n                        <div class=\"contact-info-icon\">📱</div>\n                        <div class=\"contact-info-content\">\n                            <h4>WhatsApp</h4>\n                            <p>(16) 99205-3308</p>\n                        </div>\n                    </div>\n                    <div class=\"contact-info-item wow-fade-up\" data-delay=\"200\">\n                        <div class=\"contact-info-icon\">⏰</div>\n                        <div class=\"contact-info-content\">\n                            <h4>Horário de Atendimento</h4>\n                            <p>Segunda a Sexta: 9h às 18h<br>Sábados: 9h às 13h</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"contact-form-wrapper wow-fade-up\" data-delay=\"300\">\n                    <h3 class=\"form-title\">Envie uma mensagem</h3>\n                    <p class=\"form-description\">Preencha o formulário e entraremos em contato o mais breve possível.</p>\n                    <form class=\"contact-form\" id=\"contactForm\">\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"name\">Nome completo</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" class=\"form-input\" required placeholder=\"Seu nome\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"phone\">Telefone/WhatsApp</label>\n                            <input type=\"tel\" id=\"phone\" name=\"phone\" class=\"form-input\" required placeholder=\"(00) 00000-0000\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"service\">Serviço de interesse</label>\n                            <select id=\"service\" name=\"service\" class=\"form-select\" required>\n                                <option value=\"\">Selecione uma opção</option>\n                                <option value=\"harmonizacao-facial\">Harmonização Facial</option>\n                                <option value=\"toxina-botulinica\">Toxina Botulínica</option>\n                                <option value=\"preenchedores\">Preenchedores Faciais</option>\n                                <option value=\"labios\">Preenchimento Labial</option>\n                                <option value=\"bioestimuladores\">Bioestimuladores</option>\n                                <option value=\"corporais\">Protocolos Corporais</option>\n                                <option value=\"outro\">Outro</option>\n                            </select>\n                        </div>\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"message\">Mensagem</label>\n                            <textarea id=\"message\" name=\"message\" class=\"form-textarea\" required placeholder=\"Conte-nos mais sobre o que você precisa...\"></textarea>\n                        </div>\n                        <button type=\"submit\" class=\"form-submit\">Enviar via WhatsApp</button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-brand\">\n                    <h3>Dra. Miriam Freitas</h3>\n                    <p>Estética Facial e Corporal em Ribeirão Preto. Transformando vidas através da autoestima e bem-estar.</p>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Serviços</h4>\n                    <ul>\n                        <li><a href=\"#servicos\">Harmonização Facial</a></li>\n                        <li><a href=\"#servicos\">Toxina Botulínica</a></li>\n                        <li><a href=\"#servicos\">Preenchedores</a></li>\n                        <li><a href=\"#servicos\">Protocolos Corporais</a></li>\n                    </ul>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Contato</h4>\n                    <ul>\n                        <li><a href=\"tel:+5516992053308\">(16) 99205-3308</a></li>\n                        <li><a href=\"#contato\">Agendar Consulta</a></li>\n                        <li><a href=\"#inicio\">Início</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"footer-bottom\">\n                <p>&copy; 2026 Dra. Miriam Freitas - Estética Facial e Corporal. Todos os direitos reservados.</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // Navigation scroll behavior\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                } else {\n                    nav.classList.remove('hidden');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Mobile menu toggle\n        const navMenuBtn = document.getElementById('navMenuBtn');\n        const navMobile = document.getElementById('navMobile');\n\n        navMenuBtn.addEventListener('click', () => {\n            navMobile.classList.toggle('active');\n            navMenuBtn.textContent = navMobile.classList.contains('active') ? '✕' : '☰';\n        });\n\n        // Close mobile menu on link click\n        document.querySelectorAll('.nav-mobile-links a').forEach(link => {\n            link.addEventListener('click', () => {\n                navMobile.classList.remove('active');\n                navMenuBtn.textContent = '☰';\n            });\n        });\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function (e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // Intersection Observer for scroll animations\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || 0;\n                    setTimeout(() => {\n                        entry.target.classList.add('visible');\n                    }, delay);\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n            observer.observe(el);\n        });\n\n        // Contact form - WhatsApp integration\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceLabels = {\n                'harmonizacao-facial': 'Harmonização Facial',\n                'toxina-botulinica': 'Toxina Botulínica',\n                'preenchedores': 'Preenchedores Faciais',\n                'labios': 'Preenchimento Labial',\n                'bioestimuladores': 'Bioestimuladores',\n                'corporais': 'Protocolos Corporais',\n                'outro': 'Outro'\n            };\n\n            const whatsappMessage = `Olá Dra. Miriam! Meu nome é ${name}.\\n\\nTelefone: ${phone}\\nServiço de interesse: ${serviceLabels[service] || service}\\n\\nMensagem: ${message}\\n\\nGostaria de agendar uma consulta.`;\n\n            const whatsappUrl = `https://wa.me/5516992053308?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappUrl, '_blank');\n        });\n\n        // Enhanced hover effects for service cards\n        document.querySelectorAll('.service-card').forEach(card => {\n            card.addEventListener('mousemove', (e) => {\n                const rect = card.getBoundingClientRect();\n                const x = e.clientX - rect.left;\n                const y = e.clientY - rect.top;\n\n                const centerX = rect.width / 2;\n                const centerY = rect.height / 2;\n\n                const rotateX = (y - centerY) / 20;\n                const rotateY = (centerX - x) / 20;\n\n                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-5px)`;\n            });\n\n            card.addEventListener('mouseleave', () => {\n                card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateY(0)';\n            });\n        });\n\n        // Accessibility: Reduced motion check\n        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n        if (prefersReducedMotion.matches) {\n            document.querySelectorAll('.hero-gemstone').forEach(gem => {\n                gem.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"771d6dab-a6df-4f09-97b2-4d43c0cdb268","uuid":"390bb78e-8929-46fe-86fd-8a0d23278419"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b6fd6970ab4d4facbb789d58","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-miriam-freitas-estetica-facial-e-corporal/index.html"}]},"parent_tool_use_id":null,"session_id":"771d6dab-a6df-4f09-97b2-4d43c0cdb268","uuid":"17399427-6ded-4f44-9db4-0d71c5a405d8","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-miriam-freitas-estetica-facial-e-corporal/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Miriam Freitas | Estética Facial e Corporal em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Miriam Freitas - Estética Facial e Corporal em Ribeirão Preto. Harmonização facial, tratamentos corporais e estética avançada com resultados naturais.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            /* Ruby Noir & Antique Silver Palette */\n            --color-ruby: #B83A5A;\n            --color-ruby-light: #D84A7A;\n            --color-ruby-mid: #C8486A;\n            --color-ruby-dark: #982A4A;\n            --color-ruby-deep: #681A2A;\n\n            --color-silver: #B8B8C0;\n            --color-silver-light: #C8C8D0;\n            --color-silver-dark: #9898A0;\n            --color-silver-antique: #A8A8B0;\n            --color-silver-shimmer: #D8D8E0;\n\n            --color-porcelain: #FAFAF8;\n            --color-porcelain-warm: #F5F5F2;\n            --color-cream: #F8F6F4;\n            --color-ivory: #FDFCFA;\n\n            --color-rose-blush: #E8C8D0;\n            --color-rose-dust: #D8B8C0;\n\n            --color-charcoal: #2A2828;\n            --color-charcoal-dark: #1A1818;\n            --color-ink: #1A1A1A;\n\n            /* Gradients */\n            --gradient-ruby: linear-gradient(135deg, var(--color-ruby) 0%, var(--color-ruby-light) 50%, var(--color-ruby-mid) 100%);\n            --gradient-silver: linear-gradient(135deg, var(--color-silver) 0%, var(--color-silver-light) 100%);\n            --gradient-rose: linear-gradient(135deg, var(--color-rose-blush) 0%, var(--color-porcelain) 100%);\n            --gradient-ivory: linear-gradient(180deg, var(--color-porcelain) 0%, var(--color-cream) 100%);\n            --gradient-gemstone: linear-gradient(145deg, var(--color-ruby-dark) 0%, var(--color-ruby) 30%, var(--color-silver-light) 70%, var(--color-porcelain) 100%);\n\n            /* Typography */\n            --font-display: 'Crimson Pro', Georgia, serif;\n            --font-body: 'Space Grotesk', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 1.5rem;\n            --spacing-lg: 2rem;\n            --spacing-xl: 3rem;\n            --spacing-2xl: 4rem;\n            --spacing-3xl: 6rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 12px;\n            --radius-lg: 20px;\n            --radius-faceted-1: 55% 45% 40% 60% / 50% 40% 60% 50%;\n            --radius-faceted-2: 45% 55% 60% 40% / 40% 60% 50% 40%;\n            --radius-faceted-3: 60% 40% 50% 50% / 45% 55% 40% 55%;\n            --radius-faceted-4: 40% 60% 50% 50% / 55% 45% 50% 45%;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.3s ease;\n            --transition-slow: 0.5s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(184, 58, 90, 0.08);\n            --shadow-md: 0 4px 16px rgba(184, 58, 90, 0.12);\n            --shadow-lg: 0 8px 32px rgba(184, 58, 90, 0.16);\n            --shadow-ruby: 0 4px 20px rgba(184, 58, 90, 0.2);\n            --shadow-silver: 0 4px 20px rgba(184, 184, 192, 0.15);\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background: var(--gradient-ivory);\n            color: var(--color-charcoal);\n            line-height: 1.6;\n            overflow-x: hidden;\n        }\n\n        /* Typography */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-ruby-deep);\n        }\n\n        h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); }\n        h2 { font-size: clamp(2rem, 4vw, 3rem); }\n        h3 { font-size: clamp(1.25rem, 2.5vw, 1.75rem); }\n\n        p {\n            font-size: clamp(0.95rem, 1.2vw, 1.1rem);\n            color: var(--color-charcoal);\n            opacity: 0.85;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* Navigation */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-md) var(--spacing-lg);\n            background: rgba(250, 250, 248, 0.95);\n            backdrop-filter: blur(10px);\n            border-bottom: 1px solid rgba(184, 58, 90, 0.1);\n            transition: transform 0.3s ease, padding 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-ruby-dark);\n        }\n\n        .nav-links {\n            display: flex;\n            gap: var(--spacing-lg);\n            list-style: none;\n        }\n\n        .nav-links a {\n            font-weight: 500;\n            font-size: 0.95rem;\n            color: var(--color-charcoal);\n            position: relative;\n        }\n\n        .nav-links a::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-ruby);\n            transition: width var(--transition-base);\n        }\n\n        .nav-links a:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.6rem 1.4rem;\n            background: var(--gradient-ruby);\n            color: white;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            transition: var(--transition-base);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-ruby);\n        }\n\n        .nav-menu-btn {\n            display: none;\n            background: none;\n            border: none;\n            font-size: 1.5rem;\n            cursor: pointer;\n            color: var(--color-ruby-dark);\n        }\n\n        /* Mobile Menu */\n        .nav-mobile {\n            display: none;\n            position: fixed;\n            top: 70px;\n            left: 0;\n            right: 0;\n            background: var(--color-porcelain);\n            padding: var(--spacing-lg);\n            border-bottom: 1px solid rgba(184, 58, 90, 0.1);\n            z-index: 999;\n        }\n\n        .nav-mobile.active {\n            display: block;\n        }\n\n        .nav-mobile-links {\n            list-style: none;\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-md);\n        }\n\n        .nav-mobile-links a {\n            font-weight: 500;\n            padding: var(--spacing-sm) 0;\n            border-bottom: 1px solid rgba(184, 58, 90, 0.1);\n        }\n\n        /* Hero Section */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            padding: var(--spacing-3xl) var(--spacing-lg);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .hero-gemstones {\n            position: absolute;\n            inset: 0;\n            overflow: hidden;\n            z-index: 0;\n        }\n\n        .hero-gemstone {\n            position: absolute;\n            border-radius: var(--radius-faceted-1);\n            filter: blur(60px);\n            opacity: 0.35;\n            animation: gemstoneFloat 20s ease-in-out infinite;\n        }\n\n        .hero-gemstone-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-ruby);\n            top: -150px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .hero-gemstone-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-silver);\n            bottom: -100px;\n            left: -100px;\n            animation-delay: 5s;\n        }\n\n        .hero-gemstone-3 {\n            width: 300px;\n            height: 300px;\n            background: var(--color-rose-blush);\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: 10s;\n        }\n\n        .hero-gemstone-4 {\n            width: 350px;\n            height: 350px;\n            background: linear-gradient(135deg, var(--color-silver-light) 0%, var(--color-ruby-light) 100%);\n            bottom: 20%;\n            right: 10%;\n            animation-delay: 15s;\n        }\n\n        @keyframes gemstoneFloat {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n                border-radius: var(--radius-faceted-1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(90deg) scale(1.1);\n                border-radius: var(--radius-faceted-2);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(180deg) scale(0.95);\n                border-radius: var(--radius-faceted-3);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(270deg) scale(1.05);\n                border-radius: var(--radius-faceted-4);\n            }\n        }\n\n        .hero-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-3xl);\n            align-items: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .hero-content {\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease forwards;\n        }\n\n        @keyframes fadeInUp {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 0.5rem 1rem;\n            background: var(--gradient-rose);\n            border-radius: var(--radius-lg);\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-ruby-dark);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-badge::before {\n            content: '';\n            width: 8px;\n            height: 8px;\n            background: var(--color-ruby);\n            border-radius: 50%;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; transform: scale(1); }\n            50% { opacity: 0.7; transform: scale(1.1); }\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-title em {\n            font-style: normal;\n            background: var(--gradient-ruby);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-description {\n            font-size: 1.1rem;\n            margin-bottom: var(--spacing-lg);\n            opacity: 0.9;\n        }\n\n        .hero-ctas {\n            display: flex;\n            gap: var(--spacing-md);\n            flex-wrap: wrap;\n        }\n\n        .btn-primary {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 0.8rem 1.8rem;\n            background: var(--gradient-ruby);\n            color: white;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .btn-primary::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            background: linear-gradient(135deg, transparent 0%, rgba(255,255,255,0.2) 100%);\n            opacity: 0;\n            transition: opacity var(--transition-base);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-ruby);\n        }\n\n        .btn-primary:hover::before {\n            opacity: 1;\n        }\n\n        .btn-secondary {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 0.8rem 1.8rem;\n            background: transparent;\n            color: var(--color-ruby-dark);\n            border: 2px solid var(--color-ruby);\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            transition: var(--transition-base);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-ruby);\n            color: white;\n        }\n\n        .hero-visual {\n            position: relative;\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease 0.2s forwards;\n        }\n\n        .hero-card {\n            background: rgba(255, 255, 255, 0.8);\n            backdrop-filter: blur(10px);\n            border-radius: var(--radius-lg);\n            padding: var(--spacing-lg);\n            box-shadow: var(--shadow-lg);\n            border: 1px solid rgba(184, 58, 90, 0.1);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .hero-card::before {\n            content: '';\n            position: absolute;\n            top: -50%;\n            right: -50%;\n            width: 100%;\n            height: 100%;\n            background: var(--gradient-ruby);\n            opacity: 0.05;\n            border-radius: 50%;\n        }\n\n        .hero-card-image {\n            width: 100%;\n            height: 300px;\n            object-fit: cover;\n            border-radius: var(--radius-md);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-card-stats {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n        }\n\n        .stat-item {\n            text-align: center;\n        }\n\n        .stat-value {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-ruby-dark);\n        }\n\n        .stat-label {\n            font-size: 0.8rem;\n            color: var(--color-charcoal);\n            opacity: 0.7;\n        }\n\n        /* Section Styles */\n        .section {\n            padding: var(--spacing-3xl) var(--spacing-lg);\n            position: relative;\n        }\n\n        .section-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-2xl);\n        }\n\n        .section-subtitle {\n            display: inline-block;\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-ruby);\n            text-transform: uppercase;\n            letter-spacing: 2px;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .section-title {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .section-description {\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        /* Problem/Solution Section */\n        .problem-solution {\n            background: var(--color-porcelain-warm);\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: var(--spacing-xl);\n        }\n\n        .problem-card, .solution-card {\n            background: white;\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-md);\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .problem-card::before {\n            content: '';\n            position: absolute;\n            left: 0;\n            top: 0;\n            bottom: 0;\n            width: 4px;\n            background: var(--color-ruby-dark);\n        }\n\n        .solution-card::before {\n            content: '';\n            position: absolute;\n            left: 0;\n            top: 0;\n            bottom: 0;\n            width: 4px;\n            background: var(--gradient-ruby);\n        }\n\n        .problem-card:hover, .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .card-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-rose);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-md);\n            font-size: 1.5rem;\n        }\n\n        .card-title {\n            margin-bottom: var(--spacing-md);\n            color: var(--color-ruby-dark);\n        }\n\n        .card-list {\n            list-style: none;\n        }\n\n        .card-list li {\n            padding: var(--spacing-sm) 0;\n            padding-left: 1.5rem;\n            position: relative;\n            border-bottom: 1px solid rgba(184, 58, 90, 0.1);\n        }\n\n        .card-list li:last-child {\n            border-bottom: none;\n        }\n\n        .card-list li::before {\n            content: '•';\n            position: absolute;\n            left: 0;\n            color: var(--color-ruby);\n            font-size: 1.2rem;\n        }\n\n        /* Services Section */\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .service-card {\n            background: white;\n            border-radius: var(--radius-lg);\n            padding: var(--spacing-xl);\n            box-shadow: var(--shadow-sm);\n            transition: var(--transition-base);\n            border: 1px solid rgba(184, 58, 90, 0.08);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-ruby);\n            transform: scaleX(0);\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-ruby);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-rose);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-md);\n            font-size: 1.8rem;\n        }\n\n        .service-title {\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.3rem;\n        }\n\n        .service-description {\n            font-size: 0.95rem;\n            margin-bottom: var(--spacing-md);\n            opacity: 0.8;\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            color: var(--color-ruby);\n            font-weight: 600;\n            font-size: 0.9rem;\n        }\n\n        .service-link::after {\n            content: '→';\n            transition: transform var(--transition-base);\n        }\n\n        .service-link:hover::after {\n            transform: translateX(5px);\n        }\n\n        /* Testimonials Section */\n        .testimonials {\n            background: linear-gradient(135deg, var(--color-ruby-deep) 0%, var(--color-ruby-dark) 100%);\n            color: white;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .testimonials::before {\n            content: '';\n            position: absolute;\n            top: -50%;\n            right: -20%;\n            width: 600px;\n            height: 600px;\n            background: var(--gradient-silver);\n            opacity: 0.1;\n            border-radius: 50%;\n            filter: blur(100px);\n        }\n\n        .testimonials .section-subtitle {\n            color: var(--color-rose-blush);\n        }\n\n        .testimonials .section-title {\n            color: white;\n        }\n\n        .testimonials .section-description {\n            color: rgba(255, 255, 255, 0.8);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n            position: relative;\n            z-index: 1;\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.1);\n            backdrop-filter: blur(10px);\n            border-radius: var(--radius-lg);\n            padding: var(--spacing-xl);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            transition: var(--transition-base);\n        }\n\n        .testimonial-card:hover {\n            background: rgba(255, 255, 255, 0.15);\n            transform: translateY(-5px);\n        }\n\n        .testimonial-rating {\n            display: flex;\n            gap: var(--spacing-xs);\n            margin-bottom: var(--spacing-md);\n            font-size: 1.2rem;\n        }\n\n        .testimonial-rating span {\n            color: var(--color-silver-light);\n        }\n\n        .testimonial-text {\n            font-size: 0.95rem;\n            line-height: 1.7;\n            margin-bottom: var(--spacing-md);\n            color: rgba(255, 255, 255, 0.9);\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 45px;\n            height: 45px;\n            border-radius: 50%;\n            background: var(--gradient-gemstone);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: white;\n        }\n\n        .testimonial-info {\n            flex: 1;\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n            color: white;\n        }\n\n        .testimonial-role {\n            font-size: 0.85rem;\n            color: rgba(255, 255, 255, 0.7);\n        }\n\n        /* Differentials Section */\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-lg);\n            transition: var(--transition-base);\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            width: 80px;\n            height: 80px;\n            margin: 0 auto var(--spacing-md);\n        }\n\n        .differential-icon-wrapper::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            background: var(--gradient-ruby);\n            opacity: 0.15;\n            border-radius: var(--radius-faceted-1);\n            animation: iconPulse 3s ease-in-out infinite;\n        }\n\n        @keyframes iconPulse {\n            0%, 100% { transform: scale(1); opacity: 0.15; }\n            50% { transform: scale(1.1); opacity: 0.25; }\n        }\n\n        .differential-icon {\n            position: relative;\n            z-index: 1;\n            width: 100%;\n            height: 100%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 2rem;\n        }\n\n        .differential-title {\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.1rem;\n        }\n\n        .differential-description {\n            font-size: 0.9rem;\n            opacity: 0.8;\n        }\n\n        /* Contact Section */\n        .contact {\n            background: var(--color-porcelain-warm);\n        }\n\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-2xl);\n        }\n\n        .contact-info {\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-lg);\n        }\n\n        .contact-info-item {\n            display: flex;\n            gap: var(--spacing-md);\n            align-items: flex-start;\n        }\n\n        .contact-info-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-rose);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.2rem;\n            flex-shrink: 0;\n        }\n\n        .contact-info-content h4 {\n            margin-bottom: var(--spacing-xs);\n            font-size: 1rem;\n        }\n\n        .contact-info-content p {\n            font-size: 0.95rem;\n            opacity: 0.8;\n        }\n\n        .contact-form-wrapper {\n            background: white;\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-md);\n        }\n\n        .form-title {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-description {\n            margin-bottom: var(--spacing-lg);\n            font-size: 0.95rem;\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-label {\n            display: block;\n            margin-bottom: var(--spacing-xs);\n            font-weight: 500;\n            font-size: 0.9rem;\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 0.8rem 1rem;\n            border: 2px solid rgba(184, 58, 90, 0.15);\n            border-radius: var(--radius-md);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: var(--transition-base);\n            background: var(--color-porcelain);\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-ruby);\n            background: white;\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1rem;\n            background: var(--gradient-ruby);\n            color: white;\n            border: none;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-ruby);\n        }\n\n        /* Footer */\n        .footer {\n            background: var(--color-ruby-deep);\n            color: white;\n            padding: var(--spacing-2xl) var(--spacing-lg) var(--spacing-lg);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: var(--spacing-2xl);\n            margin-bottom: var(--spacing-xl);\n        }\n\n        .footer-brand h3 {\n            color: white;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-brand p {\n            color: rgba(255, 255, 255, 0.7);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .footer-links h4 {\n            color: var(--color-rose-blush);\n            margin-bottom: var(--spacing-md);\n            font-size: 1rem;\n        }\n\n        .footer-links ul {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-links a {\n            color: rgba(255, 255, 255, 0.7);\n            font-size: 0.9rem;\n        }\n\n        .footer-links a:hover {\n            color: white;\n        }\n\n        .footer-bottom {\n            text-align: center;\n            padding-top: var(--spacing-lg);\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            color: rgba(255, 255, 255, 0.5);\n            font-size: 0.85rem;\n        }\n\n        /* Animations */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.6s ease;\n        }\n\n        .wow-fade-in.visible {\n            opacity: 1;\n        }\n\n        /* Responsive Design */\n        @media (max-width: 1024px) {\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-links, .nav-cta {\n                display: none;\n            }\n\n            .nav-menu-btn {\n                display: block;\n            }\n\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-ctas {\n                justify-content: center;\n            }\n\n            .hero-visual {\n                order: -1;\n            }\n\n            .problem-solution-grid,\n            .contact-grid,\n            .footer-content {\n                grid-template-columns: 1fr;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .hero-visual, .hero-card {\n                display: none;\n            }\n        }\n\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        /* Focus styles for accessibility */\n        a:focus, button:focus, .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: 3px solid var(--color-ruby-light);\n            outline-offset: 2px;\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Miriam Freitas</a>\n            <ul class=\"nav-links\">\n                <li><a href=\"#inicio\">Início</a></li>\n                <li><a href=\"#servicos\">Serviços</a></li>\n                <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                <li><a href=\"#contato\">Contato</a></li>\n            </ul>\n            <a href=\"#contato\" class=\"nav-cta\">Agendar Consulta</a>\n            <button class=\"nav-menu-btn\" id=\"navMenuBtn\" aria-label=\"Menu\">☰</button>\n        </div>\n    </nav>\n\n    <!-- Mobile Menu -->\n    <div class=\"nav-mobile\" id=\"navMobile\">\n        <ul class=\"nav-mobile-links\">\n            <li><a href=\"#inicio\">Início</a></li>\n            <li><a href=\"#servicos\">Serviços</a></li>\n            <li><a href=\"#depoimentos\">Depoimentos</a></li>\n            <li><a href=\"#contato\">Contato</a></li>\n        </ul>\n    </div>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-gemstones\">\n            <div class=\"hero-gemstone hero-gemstone-1\"></div>\n            <div class=\"hero-gemstone hero-gemstone-2\"></div>\n            <div class=\"hero-gemstone hero-gemstone-3\"></div>\n            <div class=\"hero-gemstone hero-gemstone-4\"></div>\n        </div>\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <span class=\"hero-badge\">Estética Facial e Corporal</span>\n                <h1 class=\"hero-title\">Realce sua <em>beleza natural</em> com tratamentos exclusivos</h1>\n                <p class=\"hero-description\">Transforme sua aparência com tratamentos personalizados de harmonização facial e estética corporal. Resultados naturais que realçam o que você tem de melhor.</p>\n                <div class=\"hero-ctas\">\n                    <a href=\"#contato\" class=\"btn-primary\">\n                        <span>Agendar Consulta</span>\n                        <span>→</span>\n                    </a>\n                    <a href=\"#servicos\" class=\"btn-secondary\">\n                        <span>Conhecer Serviços</span>\n                    </a>\n                </div>\n            </div>\n            <div class=\"hero-visual\">\n                <div class=\"hero-card\">\n                    <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=600&h=400&fit=crop\" alt=\"Estética Facial\" class=\"hero-card-image\">\n                    <div class=\"hero-card-stats\">\n                        <div class=\"stat-item\">\n                            <div class=\"stat-value\">10+</div>\n                            <div class=\"stat-label\">Anos de Exp.</div>\n                        </div>\n                        <div class=\"stat-item\">\n                            <div class=\"stat-value\">5000+</div>\n                            <div class=\"stat-label\">Clientes</div>\n                        </div>\n                        <div class=\"stat-item\">\n                            <div class=\"stat-value\">98%</div>\n                            <div class=\"stat-label\">Satisfação</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-subtitle\">Sua Transformação</span>\n                <h2 class=\"section-title\">Supere as inseguranças, descubra sua melhor versão</h2>\n            </div>\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card wow-fade-up\">\n                    <div class=\"card-icon\">😔</div>\n                    <h3 class=\"card-title\">Desafios que enfrentamos</h3>\n                    <ul class=\"card-list\">\n                        <li>Sinais de envelhecimento facial</li>\n                        <li>Perda de contorno do rosto</li>\n                        <li>Gordura localizada difícil de eliminar</li>\n                        <li>Flacidez da pele</li>\n                        <li>Autoestima afetada pela aparência</li>\n                    </ul>\n                </div>\n                <div class=\"solution-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"card-icon\">✨</div>\n                    <h3 class=\"card-title\">Nossa solução exclusiva</h3>\n                    <ul class=\"card-list\">\n                        <li>Harmonização facial com resultados naturais</li>\n                        <li>Protocolos corporais personalizados</li>\n                        <li>Tecnologia de ponta em estética</li>\n                        <li>Acompanhamento completo</li>\n                        <li>Recupere sua confiança e autoestima</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-subtitle\">Nossos Serviços</span>\n                <h2 class=\"section-title\">Tratamentos especializados para você</h2>\n                <p class=\"section-description\">Oferecemos uma linha completa de procedimentos estéticos faciais e corporais com tecnologia avançada e profissionais qualificados.</p>\n            </div>\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">💆</div>\n                    <h3 class=\"service-title\">Harmonização Facial</h3>\n                    <p class=\"service-description\">Equilibre seus traços faciais com preenchedores e toxina botulínica para um resultado natural e harmonioso.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"100\">\n                    <div class=\"service-icon\">💉</div>\n                    <h3 class=\"service-title\">Toxina Botulínica</h3>\n                    <p class=\"service-description\">Suavize linhas de expressão e previna rugas com aplicações estratégicas e naturalidade.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"service-icon\">💎</div>\n                    <h3 class=\"service-title\">Preenchedores Faciais</h3>\n                    <p class=\"service-description\">Restaure volume e contorno facial com ácido hialurônico de alta qualidade.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"300\">\n                    <div class=\"service-icon\">👄</div>\n                    <h3 class=\"service-title\">Preenchimento Labial</h3>\n                    <p class=\"service-description\">Aumente o volume dos lábios e defina seu contorno com naturalidade e equilíbrio.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"service-icon\">🔬</div>\n                    <h3 class=\"service-title\">Bioestimuladores</h3>\n                    <p class=\"service-description\">Estimule o colágeno natural da sua pele para um rejuvenescimento progressivo e duradouro.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"500\">\n                    <div class=\"service-icon\">⭐</div>\n                    <h3 class=\"service-title\">Protocolos Corporais</h3>\n                    <p class=\"service-description\">Tratamentos personalizados para gordura localizada, flacidez e celulite.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-subtitle\">Depoimentos</span>\n                <h2 class=\"section-title\">O que nossas clientes dizem</h2>\n                <p class=\"section-description\">Histórias reais de transformação e satisfação com nossos tratamentos.</p>\n            </div>\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up\">\n                    <div class=\"testimonial-rating\">\n                        <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>\n                    </div>\n                    <p class=\"testimonial-text\">\"A Dra. Mirium é excelente! Fiz minha harmonização facial e o resultado ficou super natural. Todos elogiam!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div class=\"testimonial-info\">\n                            <div class=\"testimonial-name\">Maria Clara</div>\n                            <div class=\"testimonial-role\">Empresária</div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"100\">\n                    <div class=\"testimonial-rating\">\n                        <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>\n                    </div>\n                    <p class=\"testimonial-text\">\"Recuperei minha autoestima com os tratamentos corporais. Profissionalismo e dedicação em cada sessão.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AS</div>\n                        <div class=\"testimonial-info\">\n                            <div class=\"testimonial-name\">Ana Silva</div>\n                            <div class=\"testimonial-role\">Advogada</div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"testimonial-rating\">\n                        <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>\n                    </div>\n                    <p class=\"testimonial-text\">\"O preenchimento labial ficou perfeito! A Dra. Mirium entendeu exatamente o que eu queria. Recomendo muito!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">PL</div>\n                        <div class=\"testimonial-info\">\n                            <div class=\"testimonial-name\">Patrícia Lima</div>\n                            <div class=\"testimonial-role\">Professora</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-subtitle\">Diferenciais</span>\n                <h2 class=\"section-title\">Por que escolher a Dra. Miriam Freitas?</h2>\n            </div>\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">🎓</div>\n                    </div>\n                    <h3 class=\"differential-title\">Formação Especializada</h3>\n                    <p class=\"differential-description\">Atualização constante com os melhores cursos e certificações em estética avançada.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"100\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">🔬</div>\n                    </div>\n                    <h3 class=\"differential-title\">Tecnologia de Ponta</h3>\n                    <p class=\"differential-description\">Utilizamos os produtos mais modernos e seguros do mercado estético.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"200\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">💝</div>\n                    </div>\n                    <h3 class=\"differential-title\">Atendimento Personalizado</h3>\n                    <p class=\"differential-description\">Cada paciente é único: protocolos individualizados para melhores resultados.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"300\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">✅</div>\n                    </div>\n                    <h3 class=\"differential-title\">Resultados Naturais</h3>\n                    <p class=\"differential-description\">Nosso foco é realçar sua beleza natural, nunca transformar completamente.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"400\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">🏥</div>\n                    </div>\n                    <h3 class=\"differential-title\">Ambiente Seguro</h3>\n                    <p class=\"differential-description\">Clínica equipada e seguindo todas as normas de biossegurança.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"500\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">📞</div>\n                    </div>\n                    <h3 class=\"differential-title\">Suporte Completo</h3>\n                    <p class=\"differential-description\">Acompanhamento antes, durante e depois dos procedimentos.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-subtitle\">Contato</span>\n                <h2 class=\"section-title\">Agende sua consulta</h2>\n                <p class=\"section-description\">Entre em contato para transformar sua aparência e recuperar sua autoestima.</p>\n            </div>\n            <div class=\"contact-grid\">\n                <div class=\"contact-info\">\n                    <div class=\"contact-info-item wow-fade-up\">\n                        <div class=\"contact-info-icon\">📍</div>\n                        <div class=\"contact-info-content\">\n                            <h4>Endereço</h4>\n                            <p>R. Magda Perona Frossard, 770 - Sala 10<br>Nova Aliança, Ribeirão Preto - SP<br>CEP: 14026-596</p>\n                        </div>\n                    </div>\n                    <div class=\"contact-info-item wow-fade-up\" data-delay=\"100\">\n                        <div class=\"contact-info-icon\">📱</div>\n                        <div class=\"contact-info-content\">\n                            <h4>WhatsApp</h4>\n                            <p>(16) 99205-3308</p>\n                        </div>\n                    </div>\n                    <div class=\"contact-info-item wow-fade-up\" data-delay=\"200\">\n                        <div class=\"contact-info-icon\">⏰</div>\n                        <div class=\"contact-info-content\">\n                            <h4>Horário de Atendimento</h4>\n                            <p>Segunda a Sexta: 9h às 18h<br>Sábados: 9h às 13h</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"contact-form-wrapper wow-fade-up\" data-delay=\"300\">\n                    <h3 class=\"form-title\">Envie uma mensagem</h3>\n                    <p class=\"form-description\">Preencha o formulário e entraremos em contato o mais breve possível.</p>\n                    <form class=\"contact-form\" id=\"contactForm\">\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"name\">Nome completo</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" class=\"form-input\" required placeholder=\"Seu nome\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"phone\">Telefone/WhatsApp</label>\n                            <input type=\"tel\" id=\"phone\" name=\"phone\" class=\"form-input\" required placeholder=\"(00) 00000-0000\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"service\">Serviço de interesse</label>\n                            <select id=\"service\" name=\"service\" class=\"form-select\" required>\n                                <option value=\"\">Selecione uma opção</option>\n                                <option value=\"harmonizacao-facial\">Harmonização Facial</option>\n                                <option value=\"toxina-botulinica\">Toxina Botulínica</option>\n                                <option value=\"preenchedores\">Preenchedores Faciais</option>\n                                <option value=\"labios\">Preenchimento Labial</option>\n                                <option value=\"bioestimuladores\">Bioestimuladores</option>\n                                <option value=\"corporais\">Protocolos Corporais</option>\n                                <option value=\"outro\">Outro</option>\n                            </select>\n                        </div>\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"message\">Mensagem</label>\n                            <textarea id=\"message\" name=\"message\" class=\"form-textarea\" required placeholder=\"Conte-nos mais sobre o que você precisa...\"></textarea>\n                        </div>\n                        <button type=\"submit\" class=\"form-submit\">Enviar via WhatsApp</button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-brand\">\n                    <h3>Dra. Miriam Freitas</h3>\n                    <p>Estética Facial e Corporal em Ribeirão Preto. Transformando vidas através da autoestima e bem-estar.</p>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Serviços</h4>\n                    <ul>\n                        <li><a href=\"#servicos\">Harmonização Facial</a></li>\n                        <li><a href=\"#servicos\">Toxina Botulínica</a></li>\n                        <li><a href=\"#servicos\">Preenchedores</a></li>\n                        <li><a href=\"#servicos\">Protocolos Corporais</a></li>\n                    </ul>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Contato</h4>\n                    <ul>\n                        <li><a href=\"tel:+5516992053308\">(16) 99205-3308</a></li>\n                        <li><a href=\"#contato\">Agendar Consulta</a></li>\n                        <li><a href=\"#inicio\">Início</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"footer-bottom\">\n                <p>&copy; 2026 Dra. Miriam Freitas - Estética Facial e Corporal. Todos os direitos reservados.</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // Navigation scroll behavior\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                } else {\n                    nav.classList.remove('hidden');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Mobile menu toggle\n        const navMenuBtn = document.getElementById('navMenuBtn');\n        const navMobile = document.getElementById('navMobile');\n\n        navMenuBtn.addEventListener('click', () => {\n            navMobile.classList.toggle('active');\n            navMenuBtn.textContent = navMobile.classList.contains('active') ? '✕' : '☰';\n        });\n\n        // Close mobile menu on link click\n        document.querySelectorAll('.nav-mobile-links a').forEach(link => {\n            link.addEventListener('click', () => {\n                navMobile.classList.remove('active');\n                navMenuBtn.textContent = '☰';\n            });\n        });\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function (e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // Intersection Observer for scroll animations\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || 0;\n                    setTimeout(() => {\n                        entry.target.classList.add('visible');\n                    }, delay);\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n            observer.observe(el);\n        });\n\n        // Contact form - WhatsApp integration\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceLabels = {\n                'harmonizacao-facial': 'Harmonização Facial',\n                'toxina-botulinica': 'Toxina Botulínica',\n                'preenchedores': 'Preenchedores Faciais',\n                'labios': 'Preenchimento Labial',\n                'bioestimuladores': 'Bioestimuladores',\n                'corporais': 'Protocolos Corporais',\n                'outro': 'Outro'\n            };\n\n            const whatsappMessage = `Olá Dra. Miriam! Meu nome é ${name}.\\n\\nTelefone: ${phone}\\nServiço de interesse: ${serviceLabels[service] || service}\\n\\nMensagem: ${message}\\n\\nGostaria de agendar uma consulta.`;\n\n            const whatsappUrl = `https://wa.me/5516992053308?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappUrl, '_blank');\n        });\n\n        // Enhanced hover effects for service cards\n        document.querySelectorAll('.service-card').forEach(card => {\n            card.addEventListener('mousemove', (e) => {\n                const rect = card.getBoundingClientRect();\n                const x = e.clientX - rect.left;\n                const y = e.clientY - rect.top;\n\n                const centerX = rect.width / 2;\n                const centerY = rect.height / 2;\n\n                const rotateX = (y - centerY) / 20;\n                const rotateY = (centerX - x) / 20;\n\n                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-5px)`;\n            });\n\n            card.addEventListener('mouseleave', () => {\n                card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateY(0)';\n            });\n        });\n\n        // Accessibility: Reduced motion check\n        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n        if (prefersReducedMotion.matches) {\n            document.querySelectorAll('.hero-gemstone').forEach(gem => {\n                gem.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>","structuredPatch":[],"originalFile":null}}
