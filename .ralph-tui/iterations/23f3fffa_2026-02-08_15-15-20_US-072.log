       /* Gradients */\n            --gradient-emerald: linear-gradient(135deg, var(--color-emerald) 0%, var(--color-emerald-light) 50%, var(--color-sage) 100%);\n            --gradient-emerald-soft: linear-gradient(135deg, var(--color-emerald-mist) 0%, var(--color-ivory) 100%);\n            --gradient-gold: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-light) 100%);\n            --gradient-ivory: linear-gradient(180deg, var(--color-ivory) 0%, var(--color-cream) 100%);\n\n            /* Typography */\n            --font-display: 'Libre Baskerville', Georgia, serif;\n            --font-body: 'Outfit', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 1.5rem;\n            --spacing-lg: 2rem;\n            --spacing-xl: 3rem;\n            --spacing-2xl: 4rem;\n            --spacing-3xl: 6rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 12px;\n            --radius-lg: 20px;\n            --radius-leaf-1: 65% 35% 45% 55% / 55% 45% 55% 45%;\n            --radius-leaf-2: 45% 55% 65% 35% / 45% 55% 45% 55%;\n            --radius-leaf-3: 55% 45% 35% 65% / 55% 45% 55% 45%;\n            --radius-leaf-4: 35% 65% 55% 45% / 45% 55% 45% 55%;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.3s ease;\n            --transition-slow: 0.5s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(45, 90, 74, 0.08);\n            --shadow-md: 0 4px 16px rgba(45, 90, 74, 0.12);\n            --shadow-lg: 0 8px 32px rgba(45, 90, 74, 0.16);\n            --shadow-gold: 0 4px 20px rgba(184, 155, 90, 0.15);\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background: var(--gradient-ivory);\n            color: var(--color-charcoal);\n            line-height: 1.6;\n            overflow-x: hidden;\n        }\n\n        /* Typography */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-emerald-deep);\n        }\n\n        h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); }\n        h2 { font-size: clamp(2rem, 4vw, 3rem); }\n        h3 { font-size: clamp(1.25rem, 2.5vw, 1.75rem); }\n\n        p {\n            font-size: clamp(0.95rem, 1.2vw, 1.1rem);\n            color: var(--color-charcoal);\n            opacity: 0.85;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* Navigation */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-md) var(--spacing-lg);\n            background: rgba(250, 250, 246, 0.95);\n            backdrop-filter: blur(10px);\n            border-bottom: 1px solid rgba(45, 90, 74, 0.1);\n            transition: transform 0.3s ease, padding 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-emerald-dark);\n        }\n\n        .nav-links {\n            display: flex;\n            gap: var(--spacing-lg);\n            list-style: none;\n        }\n\n        .nav-links a {\n            font-weight: 500;\n            font-size: 0.95rem;\n            color: var(--color-charcoal);\n            position: relative;\n        }\n\n        .nav-links a::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-emerald);\n            transition: width var(--transition-base);\n        }\n\n        .nav-links a:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.6rem 1.4rem;\n            background: var(--gradient-emerald);\n            color: white;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            transition: var(--transition-base);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-gold);\n        }\n\n        .nav-menu-btn {\n            display: none;\n            background: none;\n            border: none;\n            font-size: 1.5rem;\n            cursor: pointer;\n            color: var(--color-emerald-dark);\n        }\n\n        /* Mobile Menu */\n        .nav-mobile {\n            display: none;\n            position: fixed;\n            top: 70px;\n            left: 0;\n            right: 0;\n            background: var(--color-ivory);\n            padding: var(--spacing-lg);\n            border-bottom: 1px solid rgba(45, 90, 74, 0.1);\n            z-index: 999;\n        }\n\n        .nav-mobile.active {\n            display: block;\n        }\n\n        .nav-mobile-links {\n            list-style: none;\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-md);\n        }\n\n        .nav-mobile-links a {\n            font-weight: 500;\n            padding: var(--spacing-sm) 0;\n            border-bottom: 1px solid rgba(45, 90, 74, 0.1);\n        }\n\n        /* Hero Section */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            padding: var(--spacing-3xl) var(--spacing-lg);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .hero-leaves {\n            position: absolute;\n            inset: 0;\n            overflow: hidden;\n            z-index: 0;\n        }\n\n        .hero-leaf {\n            position: absolute;\n            border-radius: var(--radius-leaf-1);\n            filter: blur(60px);\n            opacity: 0.35;\n            animation: leafFloat 20s ease-in-out infinite;\n        }\n\n        .hero-leaf-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-emerald);\n            top: -150px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .hero-leaf-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-gold);\n            bottom: -100px;\n            left: -100px;\n            animation-delay: 5s;\n        }\n\n        .hero-leaf-3 {\n            width: 300px;\n            height: 300px;\n            background: var(--color-emerald-mist);\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: 10s;\n        }\n\n        .hero-leaf-4 {\n            width: 350px;\n            height: 350px;\n            background: linear-gradient(135deg, var(--color-sage-light) 0%, var(--color-emerald-light) 100%);\n            bottom: 20%;\n            right: 10%;\n            animation-delay: 15s;\n        }\n\n        @keyframes leafFloat {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n                border-radius: var(--radius-leaf-1);","numLines":300,"startLine":1,"totalLines":1441}}}
