{"type":"assistant","message":{"id":"msg_202602090147475e84ab2c3e414339","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_40464f02269f444190a56eee","name":"Write","input":{"file_path":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/clinica-7-peles/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Clínica 7 Peles | Dra. Fernanda Ursoli - Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Clínica 7 Peles - Dra. Fernanda Ursoli. Harmonização facial e estética avançada em Ribeirão Preto. Tratamentos personalizados para realçar sua beleza natural.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            /* Moss Noir & Burnt Sienna Palette */\n            --color-moss: #4A6B4A;\n            --color-moss-light: #6B8B6B;\n            --color-moss-dark: #2A4B2A;\n            --color-moss-deep: #1A3B1A;\n            --color-moss-mist: #E8F0E8;\n            --color-sienna: #B8784A;\n            --color-sienna-light: #C8986A;\n            --color-sienna-dark: #985838;\n            --color-sienna-deep: #783828;\n            --color-sienna-shimmer: #D8A888;\n            --color-sand: #F5F3F0;\n            --color-sand-warm: #E8E4DC;\n            --color-cream: #FAF8F5;\n            --color-charcoal: #2A2A28;\n            --color-charcoal-dark: #1A1A18;\n\n            /* Typography */\n            --font-display: 'Playfair Display', Georgia, serif;\n            --font-body: 'Plus Jakarta Sans', system-ui, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 1.5rem;\n            --spacing-lg: 2rem;\n            --spacing-xl: 3rem;\n            --spacing-2xl: 5rem;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Border Radius - Organic Moss Shapes */\n            --radius-moss-1: 68% 32% 52% 48% / 52% 38% 62% 48%;\n            --radius-moss-2: 48% 52% 62% 38% / 42% 58% 42% 58%;\n            --radius-moss-3: 58% 42% 48% 52% / 52% 48% 52% 48%;\n            --radius-moss-4: 42% 58% 52% 48% / 48% 52% 48% 52%;\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background-color: var(--color-cream);\n            color: var(--color-charcoal);\n            line-height: 1.6;\n            overflow-x: hidden;\n        }\n\n        /* Navigation */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: 1.25rem 5%;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            background: rgba(250, 248, 245, 0.95);\n            backdrop-filter: blur(10px);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav.scrolled {\n            box-shadow: 0 2px 20px rgba(42, 42, 40, 0.1);\n        }\n\n        .nav__logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-moss);\n            text-decoration: none;\n            letter-spacing: -0.02em;\n        }\n\n        .nav__logo span {\n            color: var(--color-sienna);\n        }\n\n        .nav__links {\n            display: flex;\n            gap: 2rem;\n            list-style: none;\n        }\n\n        .nav__link {\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-charcoal);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav__link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: linear-gradient(90deg, var(--color-moss), var(--color-sienna));\n            transition: width var(--transition-fast);\n        }\n\n        .nav__link:hover {\n            color: var(--color-moss);\n        }\n\n        .nav__link:hover::after {\n            width: 100%;\n        }\n\n        .nav__cta {\n            padding: 0.75rem 1.5rem;\n            background: linear-gradient(135deg, var(--color-moss), var(--color-moss-dark));\n            color: white;\n            border-radius: 50px;\n            text-decoration: none;\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav__cta:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 10px 30px rgba(74, 107, 74, 0.3);\n        }\n\n        .nav__toggle {\n            display: none;\n            flex-direction: column;\n            gap: 6px;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav__toggle span {\n            width: 24px;\n            height: 2px;\n            background: var(--color-charcoal);\n            transition: var(--transition-fast);\n        }\n\n        /* Hero Section */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            padding: 6rem 5% 4rem;\n            overflow: hidden;\n        }\n\n        .hero__background {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            z-index: 0;\n        }\n\n        .hero__blob {\n            position: absolute;\n            border-radius: var(--radius-moss-1);\n            filter: blur(60px);\n            opacity: 0.4;\n            animation: mossFloat 20s ease-in-out infinite;\n        }\n\n        .hero__blob--1 {\n            width: 500px;\n            height: 500px;\n            background: linear-gradient(135deg, var(--color-moss), var(--color-moss-light));\n            top: -10%;\n            left: -5%;\n            animation-delay: 0s;\n        }\n\n        .hero__blob--2 {\n            width: 400px;\n            height: 400px;\n            background: linear-gradient(135deg, var(--color-sienna), var(--color-sienna-light));\n            bottom: 10%;\n            right: -5%;\n            border-radius: var(--radius-moss-2);\n            animation-delay: -5s;\n        }\n\n        .hero__blob--3 {\n            width: 350px;\n            height: 350px;\n            background: linear-gradient(135deg, var(--color-moss-light), var(--color-moss-mist));\n            top: 40%;\n            right: 20%;\n            border-radius: var(--radius-moss-3);\n            animation-delay: -10s;\n            opacity: 0.3;\n        }\n\n        .hero__blob--4 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(135deg, var(--color-sienna-shimmer), var(--color-sand));\n            bottom: 20%;\n            left: 15%;\n            border-radius: var(--radius-moss-4);\n            animation-delay: -15s;\n            opacity: 0.25;\n        }\n\n        @keyframes mossFloat {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg) scale(1.05);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg) scale(0.95);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(3deg) scale(1.02);\n            }\n        }\n\n        .hero__content {\n            position: relative;\n            z-index: 1;\n            max-width: 800px;\n            text-align: center;\n        }\n\n        .hero__badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 0.5rem 1rem;\n            background: rgba(74, 107, 74, 0.1);\n            border: 1px solid rgba(74, 107, 74, 0.2);\n            border-radius: 50px;\n            font-size: 0.85rem;\n            color: var(--color-moss);\n            margin-bottom: 1.5rem;\n            animation: fadeInUp 0.6s ease forwards;\n            animation-delay: 0ms;\n            opacity: 0;\n        }\n\n        .hero__badge-dot {\n            width: 8px;\n            height: 8px;\n            background: var(--color-sienna);\n            border-radius: 50%;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; transform: scale(1); }\n            50% { opacity: 0.7; transform: scale(1.1); }\n        }\n\n        .hero__title {\n            font-family: var(--font-display);\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            line-height: 1.1;\n            color: var(--color-charcoal);\n            margin-bottom: 1.5rem;\n            animation: fadeInUp 0.6s ease forwards;\n            animation-delay: 200ms;\n            opacity: 0;\n        }\n\n        .hero__title-accent {\n            background: linear-gradient(135deg, var(--color-moss), var(--color-sienna));\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero__subtitle {\n            font-size: clamp(1rem, 2vw, 1.25rem);\n            color: var(--color-charcoal);\n            opacity: 0.8;\n            margin-bottom: 2rem;\n            max-width: 600px;\n            margin-left: auto;\n            margin-right: auto;\n            animation: fadeInUp 0.6s ease forwards;\n            animation-delay: 400ms;\n            opacity: 0;\n        }\n\n        .hero__ctas {\n            display: flex;\n            gap: 1rem;\n            justify-content: center;\n            flex-wrap: wrap;\n            animation: fadeInUp 0.6s ease forwards;\n            animation-delay: 600ms;\n            opacity: 0;\n        }\n\n        .hero__cta {\n            padding: 1rem 2rem;\n            border-radius: 50px;\n            font-weight: 600;\n            font-size: 1rem;\n            text-decoration: none;\n            transition: all var(--transition-fast);\n            cursor: pointer;\n            border: none;\n        }\n\n        .hero__cta--primary {\n            background: linear-gradient(135deg, var(--color-moss), var(--color-moss-dark));\n            color: white;\n            box-shadow: 0 4px 20px rgba(74, 107, 74, 0.3);\n        }\n\n        .hero__cta--primary:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 8px 30px rgba(74, 107, 74, 0.4);\n        }\n\n        .hero__cta--secondary {\n            background: transparent;\n            color: var(--color-moss);\n            border: 2px solid var(--color-moss);\n        }\n\n        .hero__cta--secondary:hover {\n            background: var(--color-moss);\n            color: white;\n        }\n\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        /* Section Styles */\n        .section {\n            padding: var(--spacing-2xl) 5%;\n        }\n\n        .section__header {\n            text-align: center;\n            margin-bottom: var(--spacing-2xl);\n        }\n\n        .section__label {\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-sienna);\n            text-transform: uppercase;\n            letter-spacing: 0.1em;\n            margin-bottom: 1rem;\n        }\n\n        .section__title {\n            font-family: var(--font-display);\n            font-size: clamp(2rem, 4vw, 3rem);\n            font-weight: 700;\n            color: var(--color-charcoal);\n            margin-bottom: 1rem;\n        }\n\n        .section__description {\n            font-size: 1.1rem;\n            color: var(--color-charcoal);\n            opacity: 0.7;\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        /* Problem/Solution Section */\n        .problem-solution {\n            background: var(--color-sand);\n        }\n\n        .problem-solution__grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: 2rem;\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .problem-solution__card {\n            background: white;\n            padding: 2rem;\n            border-radius: 24px;\n            position: relative;\n            overflow: hidden;\n            transition: all var(--transition-base);\n        }\n\n        .problem-solution__card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 4px;\n            height: 100%;\n            background: linear-gradient(180deg, var(--color-moss), var(--color-sienna));\n        }\n\n        .problem-solution__card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);\n        }\n\n        .problem-solution__card--problem {\n            background: linear-gradient(135deg, rgba(184, 120, 74, 0.05), rgba(184, 120, 74, 0.02));\n        }\n\n        .problem-solution__card--solution {\n            background: linear-gradient(135deg, rgba(74, 107, 74, 0.05), rgba(74, 107, 74, 0.02));\n        }\n\n        .problem-solution__icon {\n            width: 60px;\n            height: 60px;\n            border-radius: 16px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n            font-size: 1.5rem;\n        }\n\n        .problem-solution__card--problem .problem-solution__icon {\n            background: linear-gradient(135deg, var(--color-sienna), var(--color-sienna-light));\n            color: white;\n        }\n\n        .problem-solution__card--solution .problem-solution__icon {\n            background: linear-gradient(135deg, var(--color-moss), var(--color-moss-light));\n            color: white;\n        }\n\n        .problem-solution__card-title {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            margin-bottom: 1rem;\n            color: var(--color-charcoal);\n        }\n\n        .problem-solution__card-text {\n            color: var(--color-charcoal);\n            opacity: 0.8;\n            line-height: 1.7;\n        }\n\n        /* Services Section */\n        .services__grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: 2rem;\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .service-card {\n            background: white;\n            padding: 2.5rem;\n            border-radius: 24px;\n            position: relative;\n            overflow: hidden;\n            transition: all var(--transition-base);\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: linear-gradient(90deg, var(--color-moss), var(--color-sienna));\n            opacity: 0;\n            transition: opacity var(--transition-fast);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 20px 50px rgba(74, 107, 74, 0.15);\n        }\n\n        .service-card:hover::before {\n            opacity: 1;\n        }\n\n        .service-card__icon {\n            width: 70px;\n            height: 70px;\n            border-radius: 20px;\n            background: linear-gradient(135deg, var(--color-moss-mist), var(--color-sand));\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 2rem;\n            margin-bottom: 1.5rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .service-card__icon::after {\n            content: '';\n            position: absolute;\n            inset: -3px;\n            border-radius: 23px;\n            background: linear-gradient(135deg, var(--color-moss), var(--color-sienna));\n            z-index: -1;\n            opacity: 0;\n            transition: opacity var(--transition-fast);\n        }\n\n        .service-card:hover .service-card__icon::after {\n            opacity: 1;\n        }\n\n        .service-card__title {\n            font-family: var(--font-display);\n            font-size: 1.35rem;\n            font-weight: 600;\n            margin-bottom: 1rem;\n            color: var(--color-charcoal);\n        }\n\n        .service-card__description {\n            color: var(--color-charcoal);\n            opacity: 0.75;\n            line-height: 1.7;\n            margin-bottom: 1.5rem;\n        }\n\n        .service-card__link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-moss);\n            text-decoration: none;\n            font-weight: 600;\n            transition: gap var(--transition-fast);\n        }\n\n        .service-card__link:hover {\n            gap: 1rem;\n        }\n\n        /* Testimonials Section */\n        .testimonials {\n            background: linear-gradient(135deg, var(--color-moss-dark), var(--color-moss-deep));\n            color: white;\n        }\n\n        .testimonials .section__title,\n        .testimonials .section__description {\n            color: white;\n        }\n\n        .testimonials .section__label {\n            color: var(--color-sienna-shimmer);\n        }\n\n        .testimonials__grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: 2rem;\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(10px);\n            padding: 2.5rem;\n            border-radius: 24px;\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            transition: all var(--transition-base);\n        }\n\n        .testimonial-card:hover {\n            background: rgba(255, 255, 255, 0.08);\n            transform: translateY(-5px);\n        }\n\n        .testimonial-card__stars {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: 1.5rem;\n            color: var(--color-sienna-shimmer);\n        }\n\n        .testimonial-card__quote {\n            font-size: 1.05rem;\n            line-height: 1.8;\n            margin-bottom: 2rem;\n            opacity: 0.9;\n        }\n\n        .testimonial-card__author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-card__avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: linear-gradient(135deg, var(--color-moss-light), var(--color-sienna));\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: white;\n        }\n\n        .testimonial-card__info {\n            flex: 1;\n        }\n\n        .testimonial-card__name {\n            font-weight: 600;\n            margin-bottom: 0.25rem;\n        }\n\n        .testimonial-card__role {\n            font-size: 0.85rem;\n            opacity: 0.7;\n        }\n\n        /* Differentials Section */\n        .differentials__grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 2rem;\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: 2rem;\n            position: relative;\n        }\n\n        .differential-item__icon-wrapper {\n            width: 80px;\n            height: 80px;\n            margin: 0 auto 1.5rem;\n            position: relative;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .differential-item__icon-ring {\n            position: absolute;\n            inset: 0;\n            border-radius: 50%;\n            border: 2px solid var(--color-moss);\n            opacity: 0.2;\n            animation: ringPulse 3s ease-in-out infinite;\n        }\n\n        .differential-item__icon-ring:nth-child(2) {\n            animation-delay: 1s;\n        }\n\n        .differential-item__icon-ring:nth-child(3) {\n            animation-delay: 2s;\n        }\n\n        @keyframes ringPulse {\n            0%, 100% {\n                transform: scale(1);\n                opacity: 0.2;\n            }\n            50% {\n                transform: scale(1.15);\n                opacity: 0.1;\n            }\n        }\n\n        .differential-item__icon {\n            width: 60px;\n            height: 60px;\n            border-radius: 18px;\n            background: linear-gradient(135deg, var(--color-moss), var(--color-moss-light));\n            color: white;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.5rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .differential-item__title {\n            font-family: var(--font-display);\n            font-size: 1.2rem;\n            font-weight: 600;\n            margin-bottom: 0.75rem;\n            color: var(--color-charcoal);\n        }\n\n        .differential-item__text {\n            color: var(--color-charcoal);\n            opacity: 0.75;\n            font-size: 0.95rem;\n        }\n\n        /* Contact Section */\n        .contact {\n            background: var(--color-sand);\n        }\n\n        .contact__container {\n            max-width: 800px;\n            margin: 0 auto;\n        }\n\n        .contact__form {\n            background: white;\n            padding: 3rem;\n            border-radius: 24px;\n            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);\n        }\n\n        .contact__form-group {\n            margin-bottom: 1.5rem;\n        }\n\n        .contact__form-label {\n            display: block;\n            font-weight: 600;\n            margin-bottom: 0.5rem;\n            color: var(--color-charcoal);\n            font-size: 0.9rem;\n        }\n\n        .contact__form-input,\n        .contact__form-select,\n        .contact__form-textarea {\n            width: 100%;\n            padding: 1rem;\n            border: 2px solid var(--color-sand-warm);\n            border-radius: 12px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: all var(--transition-fast);\n            background: var(--color-cream);\n        }\n\n        .contact__form-input:focus,\n        .contact__form-select:focus,\n        .contact__form-textarea:focus {\n            outline: none;\n            border-color: var(--color-moss);\n            background: white;\n        }\n\n        .contact__form-textarea {\n            min-height: 150px;\n            resize: vertical;\n        }\n\n        .contact__form-cta {\n            width: 100%;\n            padding: 1.25rem;\n            background: linear-gradient(135deg, var(--color-moss), var(--color-moss-dark));\n            color: white;\n            border: none;\n            border-radius: 12px;\n            font-size: 1.1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all var(--transition-fast);\n        }\n\n        .contact__form-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 10px 30px rgba(74, 107, 74, 0.3);\n        }\n\n        /* Footer */\n        .footer {\n            background: var(--color-charcoal-dark);\n            color: white;\n            padding: var(--spacing-2xl) 5% var(--spacing-xl);\n        }\n\n        .footer__container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer__top {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 3rem;\n            margin-bottom: 3rem;\n        }\n\n        .footer__brand {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            margin-bottom: 1rem;\n        }\n\n        .footer__brand span {\n            color: var(--color-sienna);\n        }\n\n        .footer__description {\n            opacity: 0.7;\n            line-height: 1.7;\n        }\n\n        .footer__section-title {\n            font-weight: 600;\n            margin-bottom: 1rem;\n            color: var(--color-sienna-shimmer);\n        }\n\n        .footer__links {\n            list-style: none;\n        }\n\n        .footer__link {\n            display: block;\n            color: white;\n            text-decoration: none;\n            opacity: 0.7;\n            padding: 0.5rem 0;\n            transition: opacity var(--transition-fast);\n        }\n\n        .footer__link:hover {\n            opacity: 1;\n        }\n\n        .footer__contact-item {\n            display: flex;\n            align-items: center;\n            gap: 0.75rem;\n            padding: 0.5rem 0;\n            opacity: 0.7;\n        }\n\n        .footer__contact-icon {\n            width: 20px;\n            height: 20px;\n            color: var(--color-sienna);\n        }\n\n        .footer__bottom {\n            text-align: center;\n            padding-top: 2rem;\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            opacity: 0.5;\n            font-size: 0.9rem;\n        }\n\n        /* Animation Classes */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(40px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.wow-visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-up[data-delay] {\n            transition-delay: var(--delay, 0ms);\n        }\n\n        /* Responsive */\n        @media (max-width: 768px) {\n            .nav__links {\n                display: none;\n                position: absolute;\n                top: 100%;\n                left: 0;\n                right: 0;\n                background: var(--color-cream);\n                flex-direction: column;\n                padding: 1rem 5%;\n                gap: 1rem;\n                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);\n            }\n\n            .nav__links.active {\n                display: flex;\n            }\n\n            .nav__cta {\n                display: none;\n            }\n\n            .nav__toggle {\n                display: flex;\n            }\n\n            .hero__blob--1,\n            .hero__blob--2 {\n                width: 300px;\n                height: 300px;\n            }\n\n            .hero__blob--3,\n            .hero__blob--4 {\n                width: 200px;\n                height: 200px;\n            }\n\n            .contact__form {\n                padding: 2rem;\n            }\n        }\n\n        @media (prefers-reduced-motion: reduce) {\n            *,\n            *::before,\n            *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <a href=\"#\" class=\"nav__logo\">7 <span>Peles</span></a>\n        <ul class=\"nav__links\" id=\"navLinks\">\n            <li><a href=\"#home\" class=\"nav__link\">Início</a></li>\n            <li><a href=\"#services\" class=\"nav__link\">Serviços</a></li>\n            <li><a href=\"#testimonials\" class=\"nav__link\">Depoimentos</a></li>\n            <li><a href=\"#differentials\" class=\"nav__link\">Diferenciais</a></li>\n            <li><a href=\"#contact\" class=\"nav__link\">Contato</a></li>\n        </ul>\n        <a href=\"#contact\" class=\"nav__cta\">Agendar Consulta</a>\n        <div class=\"nav__toggle\" id=\"navToggle\">\n            <span></span>\n            <span></span>\n            <span></span>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero__background\">\n            <div class=\"hero__blob hero__blob--1\"></div>\n            <div class=\"hero__blob hero__blob--2\"></div>\n            <div class=\"hero__blob hero__blob--3\"></div>\n            <div class=\"hero__blob hero__blob--4\"></div>\n        </div>\n        <div class=\"hero__content\">\n            <div class=\"hero__badge\">\n                <span class=\"hero__badge-dot\"></span>\n                Estética Avançada em Ribeirão Preto\n            </div>\n            <h1 class=\"hero__title\">\n                Sua beleza natural,<br>\n                <span class=\"hero__title-accent\">potencializada</span>\n            </h1>\n            <p class=\"hero__subtitle\">\n                Dra. Fernanda Ursoli combina técnica apurada e arte para criar resultados naturais e harmoniosos que realçam seus melhores traços.\n            </p>\n            <div class=\"hero__ctas\">\n                <a href=\"#contact\" class=\"hero__cta hero__cta--primary\">Agendar Consulta</a>\n                <a href=\"#services\" class=\"hero__cta hero__cta--secondary\">Conhecer Tratamentos</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\" id=\"problem-solution\">\n        <div class=\"section__header wow-fade-up\">\n            <span class=\"section__label\">Sua Jornada</span>\n            <h2 class=\"section__title\">Transforme sua autoestima</h2>\n            <p class=\"section__description\">Entendemos suas preocupações e oferecemos soluções personalizadas para você se sentir confiante.</p>\n        </div>\n        <div class=\"problem-solution__grid\">\n            <div class=\"problem-solution__card problem-solution__card--problem wow-fade-up\" data-delay=\"0\">\n                <div class=\"problem-solution__icon\">😔</div>\n                <h3 class=\"problem-solution__card-title\">O Desafio</h3>\n                <p class=\"problem-solution__card-text\">Sinais de envelhecimento, assimetrias faciais ou simplesmente não se sentir confiante com sua aparência podem impactar sua autoestima e qualidade de vida.</p>\n            </div>\n            <div class=\"problem-solution__card problem-solution__card--solution wow-fade-up\" data-delay=\"200\">\n                <div class=\"problem-solution__icon\">✨</div>\n                <h3 class=\"problem-solution__card-title\">A Solução</h3>\n                <p class=\"problem-solution__card-text\">Com a Dra. Fernanda Ursoli, você recebe tratamentos personalizados que respeitam sua individualidade, com resultados naturais e duradouros.</p>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"services\">\n        <div class=\"section__header wow-fade-up\">\n            <span class=\"section__label\">Tratamentos</span>\n            <h2 class=\"section__title\">Procedimentos Especializados</h2>\n            <p class=\"section__description\">Técnicas avançadas para realçar sua beleza com naturalidade e segurança.</p>\n        </div>\n        <div class=\"services__grid\">\n            <div class=\"service-card wow-fade-up\" data-delay=\"0\">\n                <div class=\"service-card__icon\">🎯</div>\n                <h3 class=\"service-card__title\">Harmonização Facial</h3>\n                <p class=\"service-card__description\">Equilíbrio e proporção para seus traços faciais com técnicas minimamente invasivas e resultados naturais.</p>\n                <a href=\"#contact\" class=\"service-card__link\">Saiba mais →</a>\n            </div>\n            <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                <div class=\"service-card__icon\">💉</div>\n                <h3 class=\"service-card__title\">Toxina Botulínica</h3>\n                <p class=\"service-card__description\">Suavize linhas de expressão e previna novos sinais com aplicação precisa e personalizada.</p>\n                <a href=\"#contact\" class=\"service-card__link\">Saiba mais →</a>\n            </div>\n            <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n                <div class=\"service-card__icon\">💎</div>\n                <h3 class=\"service-card__title\">Preenchedores Faciais</h3>\n                <p class=\"service-card__description\">Restaure volume e contorno com ácido hialurônico de alta qualidade para resultados harmônicos.</p>\n                <a href=\"#contact\" class=\"service-card__link\">Saiba mais →</a>\n            </div>\n            <div class=\"service-card wow-fade-up\" data-delay=\"0\">\n                <div class=\"service-card__icon\">👄</div>\n                <h3 class=\"service-card__title\">Preenchimento Labial</h3>\n                <p class=\"service-card__description\">Lábios mais volumosos e definidos com técnicas que preservam a naturalidade do seu sorriso.</p>\n                <a href=\"#contact\" class=\"service-card__link\">Saiba mais →</a>\n            </div>\n            <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                <div class=\"service-card__icon\">🌟</div>\n                <h3 class=\"service-card__title\">Bioestimuladores</h3>\n                <p class=\"service-card__description\">Estimule o colágeno natural para uma pele mais firme, jovem e saudável a longo prazo.</p>\n                <a href=\"#contact\" class=\"service-card__link\">Saiba mais →</a>\n            </div>\n            <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n                <div class=\"service-card__icon\">⭐</div>\n                <h3 class=\"service-card__title\">Protocolos Exclusivos</h3>\n                <p class=\"service-card__description\">Tratamentos personalizados combinando técnicas para resultados únicos e satisfatórios.</p>\n                <a href=\"#contact\" class=\"service-card__link\">Saiba mais →</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"testimonials\">\n        <div class=\"section__header wow-fade-up\">\n            <span class=\"section__label\">Depoimentos</span>\n            <h2 class=\"section__title\">O que dizem nossas pacientes</h2>\n            <p class=\"section__description\">Histórias reais de transformação e satisfação.</p>\n        </div>\n        <div class=\"testimonials__grid\">\n            <div class=\"testimonial-card wow-fade-up\" data-delay=\"0\">\n                <div class=\"testimonial-card__stars\">★★★★★</div>\n                <p class=\"testimonial-card__quote\">\"A Dra. Fernanda é incrível! Fiz minha harmonização facial e o resultado superou todas as minhas expectativas. Natural e elegante!\"</p>\n                <div class=\"testimonial-card__author\">\n                    <div class=\"testimonial-card__avatar\">MC</div>\n                    <div class=\"testimonial-card__info\">\n                        <div class=\"testimonial-card__name\">Maria Clara</div>\n                        <div class=\"testimonial-card__role\">Empresária</div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"testimonial-card wow-fade-up\" data-delay=\"200\">\n                <div class=\"testimonial-card__stars\">★★★★★</div>\n                <p class=\"testimonial-card__quote\">\"Profissionalismo e dedicação desde a primeira consulta. Me senti sempre segura e confiante durante todo o tratamento.\"</p>\n                <div class=\"testimonial-card__author\">\n                    <div class=\"testimonial-card__avatar\">AL</div>\n                    <div class=\"testimonial-card__info\">\n                        <div class=\"testimonial-card__name\">Ana Luíza</div>\n                        <div class=\"testimonial-card__role\">Advogada</div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"testimonial-card wow-fade-up\" data-delay=\"400\">\n                <div class=\"testimonial-card__stars\">★★★★★</div>\n                <p class=\"testimonial-card__quote\">\"Os resultados são naturais e duradouros. Recebo elogios sempre! Recomendo a Clínica 7 Peles para todas as minhas amigas.\"</p>\n                <div class=\"testimonial-card__author\">\n                    <div class=\"testimonial-card__avatar\">JS</div>\n                    <div class=\"testimonial-card__info\">\n                        <div class=\"testimonial-card__name\">Juliana Silva</div>\n                        <div class=\"testimonial-card__role\">Arquiteta</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\" id=\"differentials\">\n        <div class=\"section__header wow-fade-up\">\n            <span class=\"section__label\">Por que nos escolher</span>\n            <h2 class=\"section__title\">Nossos Diferenciais</h2>\n            <p class=\"section__description\">O que torna a Clínica 7 Peles única em Ribeirão Preto.</p>\n        </div>\n        <div class=\"differentials__grid\">\n            <div class=\"differential-item wow-fade-up\" data-delay=\"0\">\n                <div class=\"differential-item__icon-wrapper\">\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon\">👩‍⚕️</div>\n                </div>\n                <h3 class=\"differential-item__title\">Especialista Dedicada</h3>\n                <p class=\"differential-item__text\">Dra. Fernanda Ursoli acompanha cada paciente com atenção personalizada.</p>\n            </div>\n            <div class=\"differential-item wow-fade-up\" data-delay=\"200\">\n                <div class=\"differential-item__icon-wrapper\">\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon\">🎨</div>\n                </div>\n                <h3 class=\"differential-item__title\">Abordagem Artística</h3>\n                <p class=\"differential-item__text\">Técnicas que combinam ciência e arte para resultados harmônicos.</p>\n            </div>\n            <div class=\"differential-item wow-fade-up\" data-delay=\"400\">\n                <div class=\"differential-item__icon-wrapper\">\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon\">🔬</div>\n                </div>\n                <h3 class=\"differential-item__title\">Tecnologia Avançada</h3>\n                <p class=\"differential-item__text\">Equipamentos de última geração para procedimentos seguros e eficazes.</p>\n            </div>\n            <div class=\"differential-item wow-fade-up\" data-delay=\"0\">\n                <div class=\"differential-item__icon-wrapper\">\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon\">💚</div>\n                </div>\n                <h3 class=\"differential-item__title\">Resultados Naturais</h3>\n                <p class=\"differential-item__text\">Enhancement que respeita suas características únicas e individuais.</p>\n            </div>\n            <div class=\"differential-item wow-fade-up\" data-delay=\"200\">\n                <div class=\"differential-item__icon-wrapper\">\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon\">🛡️</div>\n                </div>\n                <h3 class=\"differential-item__title\">Segurança Primeiro</h3>\n                <p class=\"differential-item__text\">Protocolos rigorosos e produtos certificados para sua tranquilidade.</p>\n            </div>\n            <div class=\"differential-item wow-fade-up\" data-delay=\"400\">\n                <div class=\"differential-item__icon-wrapper\">\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon\">📍</div>\n                </div>\n                <h3 class=\"differential-item__title\">Localização Privilegiada</h3>\n                <p class=\"differential-item__text\">Clínica facilmente acessível no Alto da Boa Vista em Ribeirão Preto.</p>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contact\">\n        <div class=\"section__header wow-fade-up\">\n            <span class=\"section__label\">Contato</span>\n            <h2 class=\"section__title\">Agende sua consulta</h2>\n            <p class=\"section__description\">Dê o primeiro passo para transformar sua autoestima. Entre em contato conosco.</p>\n        </div>\n        <div class=\"contact__container\">\n            <form class=\"contact__form wow-fade-up\" id=\"contactForm\">\n                <div class=\"contact__form-group\">\n                    <label class=\"contact__form-label\" for=\"name\">Nome completo</label>\n                    <input class=\"contact__form-input\" type=\"text\" id=\"name\" name=\"name\" required placeholder=\"Seu nome\">\n                </div>\n                <div class=\"contact__form-group\">\n                    <label class=\"contact__form-label\" for=\"email\">E-mail</label>\n                    <input class=\"contact__form-input\" type=\"email\" id=\"email\" name=\"email\" required placeholder=\"seu@email.com\">\n                </div>\n                <div class=\"contact__form-group\">\n                    <label class=\"contact__form-label\" for=\"phone\">Telefone</label>\n                    <input class=\"contact__form-input\" type=\"tel\" id=\"phone\" name=\"phone\" required placeholder=\"(16) 99999-9999\">\n                </div>\n                <div class=\"contact__form-group\">\n                    <label class=\"contact__form-label\" for=\"service\">Tratamento de interesse</label>\n                    <select class=\"contact__form-select\" id=\"service\" name=\"service\" required>\n                        <option value=\"\">Selecione uma opção</option>\n                        <option value=\"harmonizacao\">Harmonização Facial</option>\n                        <option value=\"botox\">Toxina Botulínica</option>\n                        <option value=\"preenchedores\">Preenchedores Faciais</option>\n                        <option value=\"labial\">Preenchimento Labial</option>\n                        <option value=\"bioestimuladores\">Bioestimuladores</option>\n                        <option value=\"protocolos\">Protocolos Exclusivos</option>\n                        <option value=\"outro\">Outro</option>\n                    </select>\n                </div>\n                <div class=\"contact__form-group\">\n                    <label class=\"contact__form-label\" for=\"message\">Mensagem</label>\n                    <textarea class=\"contact__form-textarea\" id=\"message\" name=\"message\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                </div>\n                <button type=\"submit\" class=\"contact__form-cta\">Enviar via WhatsApp</button>\n            </form>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer__container\">\n            <div class=\"footer__top\">\n                <div>\n                    <div class=\"footer__brand\">7 <span>Peles</span></div>\n                    <p class=\"footer__description\">Estética avançada com resultados naturais e duradouros. Dra. Fernanda Ursoli - Harmonização Facial em Ribeirão Preto.</p>\n                </div>\n                <div>\n                    <h4 class=\"footer__section-title\">Links Rápidos</h4>\n                    <ul class=\"footer__links\">\n                        <li><a href=\"#home\" class=\"footer__link\">Início</a></li>\n                        <li><a href=\"#services\" class=\"footer__link\">Tratamentos</a></li>\n                        <li><a href=\"#testimonials\" class=\"footer__link\">Depoimentos</a></li>\n                        <li><a href=\"#contact\" class=\"footer__link\">Contato</a></li>\n                    </ul>\n                </div>\n                <div>\n                    <h4 class=\"footer__section-title\">Contato</h4>\n                    <div class=\"footer__contact-item\">\n                        <span>📍</span>\n                        <span>R. Itacolomi, 193 - Alto da Boa Vista, Ribeirão Preto - SP, 14025-250</span>\n                    </div>\n                    <div class=\"footer__contact-item\">\n                        <span>📱</span>\n                        <span>(16) 99776-2809</span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"footer__bottom\">\n                <p>&copy; 2026 Clínica 7 Peles - Dra. Fernanda Ursoli. Todos os direitos reservados.</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // Navigation\n        const nav = document.getElementById('nav');\n        const navToggle = document.getElementById('navToggle');\n        const navLinks = document.getElementById('navLinks');\n        let lastScrollY = window.scrollY;\n\n        window.addEventListener('scroll', () => {\n            if (window.scrollY > 100) {\n                nav.classList.add('scrolled');\n            } else {\n                nav.classList.remove('scrolled');\n            }\n\n            if (window.scrollY > lastScrollY && window.scrollY > 200) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n            lastScrollY = window.scrollY;\n        });\n\n        navToggle.addEventListener('click', () => {\n            navLinks.classList.toggle('active');\n        });\n\n        // Close mobile menu on link click\n        navLinks.querySelectorAll('a').forEach(link => {\n            link.addEventListener('click', () => {\n                navLinks.classList.remove('active');\n            });\n        });\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // Intersection Observer for animations\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || 0;\n                    setTimeout(() => {\n                        entry.target.classList.add('wow-visible');\n                    }, delay);\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up').forEach(el => {\n            observer.observe(el);\n        });\n\n        // Contact form - WhatsApp integration\n        const contactForm = document.getElementById('contactForm');\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const email = document.getElementById('email').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceNames = {\n                'harmonizacao': 'Harmonização Facial',\n                'botox': 'Toxina Botulínica',\n                'preenchedores': 'Preenchedores Faciais',\n                'labial': 'Preenchimento Labial',\n                'bioestimuladores': 'Bioestimuladores',\n                'protocolos': 'Protocolos Exclusivos',\n                'outro': 'Outro'\n            };\n\n            const whatsappMessage = encodeURIComponent(\n                `*Olá! Gostaria de agendar uma consulta na Clínica 7 Peles*\\n\\n` +\n                `📋 *Dados de contato:*\\n` +\n                `• Nome: ${name}\\n` +\n                `• Email: ${email}\\n` +\n                `• Telefone: ${phone}\\n\\n` +\n                `🎯 *Tratamento de interesse:* ${serviceNames[service] || service}\\n\\n` +\n                `💬 *Mensagem:*\\n${message || 'Gostaria de mais informações.'}`\n            );\n\n            const whatsappURL = `https://wa.me/5516997762809?text=${whatsappMessage}`;\n            window.open(whatsappURL, '_blank');\n        });\n\n        // Parallax effect for hero blobs\n        document.addEventListener('mousemove', (e) => {\n            const moveX = (e.clientX - window.innerWidth / 2) * 0.01;\n            const moveY = (e.clientY - window.innerHeight / 2) * 0.01;\n\n            document.querySelectorAll('.hero__blob').forEach((blob, index) => {\n                const speed = (index + 1) * 0.5;\n                blob.style.transform = `translate(${moveX * speed}px, ${moveY * speed}px)`;\n            });\n        });\n    </script>\n</body>\n</html>"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"c258ad88-add6-488e-b9e0-803a8c63d07e","uuid":"63a9200c-bf8e-48fe-a609-587644d400a1"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_40464f02269f444190a56eee","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/clinica-7-peles/index.html"}]},"parent_tool_use_id":null,"session_id":"c258ad88-add6-488e-b9e0-803a8c63d07e","uuid":"1247aa63-4490-4e01-8646-9b6a60421746","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/clinica-7-peles/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Clínica 7 Peles | Dra. Fernanda Ursoli - Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Clínica 7 Peles - Dra. Fernanda Ursoli. Harmonização facial e estética avançada em Ribeirão Preto. Tratamentos personalizados para realçar sua beleza natural.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            /* Moss Noir & Burnt Sienna Palette */\n            --color-moss: #4A6B4A;\n            --color-moss-light: #6B8B6B;\n            --color-moss-dark: #2A4B2A;\n            --color-moss-deep: #1A3B1A;\n            --color-moss-mist: #E8F0E8;\n            --color-sienna: #B8784A;\n            --color-sienna-light: #C8986A;\n            --color-sienna-dark: #985838;\n            --color-sienna-deep: #783828;\n            --color-sienna-shimmer: #D8A888;\n            --color-sand: #F5F3F0;\n            --color-sand-warm: #E8E4DC;\n            --color-cream: #FAF8F5;\n            --color-charcoal: #2A2A28;\n            --color-charcoal-dark: #1A1A18;\n\n            /* Typography */\n            --font-display: 'Playfair Display', Georgia, serif;\n            --font-body: 'Plus Jakarta Sans', system-ui, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 1.5rem;\n            --spacing-lg: 2rem;\n            --spacing-xl: 3rem;\n            --spacing-2xl: 5rem;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Border Radius - Organic Moss Shapes */\n            --radius-moss-1: 68% 32% 52% 48% / 52% 38% 62% 48%;\n            --radius-moss-2: 48% 52% 62% 38% / 42% 58% 42% 58%;\n            --radius-moss-3: 58% 42% 48% 52% / 52% 48% 52% 48%;\n            --radius-moss-4: 42% 58% 52% 48% / 48% 52% 48% 52%;\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background-color: var(--color-cream);\n            color: var(--color-charcoal);\n            line-height: 1.6;\n            overflow-x: hidden;\n        }\n\n        /* Navigation */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: 1.25rem 5%;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            background: rgba(250, 248, 245, 0.95);\n            backdrop-filter: blur(10px);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav.scrolled {\n            box-shadow: 0 2px 20px rgba(42, 42, 40, 0.1);\n        }\n\n        .nav__logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-moss);\n            text-decoration: none;\n            letter-spacing: -0.02em;\n        }\n\n        .nav__logo span {\n            color: var(--color-sienna);\n        }\n\n        .nav__links {\n            display: flex;\n            gap: 2rem;\n            list-style: none;\n        }\n\n        .nav__link {\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-charcoal);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav__link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: linear-gradient(90deg, var(--color-moss), var(--color-sienna));\n            transition: width var(--transition-fast);\n        }\n\n        .nav__link:hover {\n            color: var(--color-moss);\n        }\n\n        .nav__link:hover::after {\n            width: 100%;\n        }\n\n        .nav__cta {\n            padding: 0.75rem 1.5rem;\n            background: linear-gradient(135deg, var(--color-moss), var(--color-moss-dark));\n            color: white;\n            border-radius: 50px;\n            text-decoration: none;\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav__cta:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 10px 30px rgba(74, 107, 74, 0.3);\n        }\n\n        .nav__toggle {\n            display: none;\n            flex-direction: column;\n            gap: 6px;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav__toggle span {\n            width: 24px;\n            height: 2px;\n            background: var(--color-charcoal);\n            transition: var(--transition-fast);\n        }\n\n        /* Hero Section */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            padding: 6rem 5% 4rem;\n            overflow: hidden;\n        }\n\n        .hero__background {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            z-index: 0;\n        }\n\n        .hero__blob {\n            position: absolute;\n            border-radius: var(--radius-moss-1);\n            filter: blur(60px);\n            opacity: 0.4;\n            animation: mossFloat 20s ease-in-out infinite;\n        }\n\n        .hero__blob--1 {\n            width: 500px;\n            height: 500px;\n            background: linear-gradient(135deg, var(--color-moss), var(--color-moss-light));\n            top: -10%;\n            left: -5%;\n            animation-delay: 0s;\n        }\n\n        .hero__blob--2 {\n            width: 400px;\n            height: 400px;\n            background: linear-gradient(135deg, var(--color-sienna), var(--color-sienna-light));\n            bottom: 10%;\n            right: -5%;\n            border-radius: var(--radius-moss-2);\n            animation-delay: -5s;\n        }\n\n        .hero__blob--3 {\n            width: 350px;\n            height: 350px;\n            background: linear-gradient(135deg, var(--color-moss-light), var(--color-moss-mist));\n            top: 40%;\n            right: 20%;\n            border-radius: var(--radius-moss-3);\n            animation-delay: -10s;\n            opacity: 0.3;\n        }\n\n        .hero__blob--4 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(135deg, var(--color-sienna-shimmer), var(--color-sand));\n            bottom: 20%;\n            left: 15%;\n            border-radius: var(--radius-moss-4);\n            animation-delay: -15s;\n            opacity: 0.25;\n        }\n\n        @keyframes mossFloat {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg) scale(1.05);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg) scale(0.95);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(3deg) scale(1.02);\n            }\n        }\n\n        .hero__content {\n            position: relative;\n            z-index: 1;\n            max-width: 800px;\n            text-align: center;\n        }\n\n        .hero__badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 0.5rem 1rem;\n            background: rgba(74, 107, 74, 0.1);\n            border: 1px solid rgba(74, 107, 74, 0.2);\n            border-radius: 50px;\n            font-size: 0.85rem;\n            color: var(--color-moss);\n            margin-bottom: 1.5rem;\n            animation: fadeInUp 0.6s ease forwards;\n            animation-delay: 0ms;\n            opacity: 0;\n        }\n\n        .hero__badge-dot {\n            width: 8px;\n            height: 8px;\n            background: var(--color-sienna);\n            border-radius: 50%;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; transform: scale(1); }\n            50% { opacity: 0.7; transform: scale(1.1); }\n        }\n\n        .hero__title {\n            font-family: var(--font-display);\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            line-height: 1.1;\n            color: var(--color-charcoal);\n            margin-bottom: 1.5rem;\n            animation: fadeInUp 0.6s ease forwards;\n            animation-delay: 200ms;\n            opacity: 0;\n        }\n\n        .hero__title-accent {\n            background: linear-gradient(135deg, var(--color-moss), var(--color-sienna));\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero__subtitle {\n            font-size: clamp(1rem, 2vw, 1.25rem);\n            color: var(--color-charcoal);\n            opacity: 0.8;\n            margin-bottom: 2rem;\n            max-width: 600px;\n            margin-left: auto;\n            margin-right: auto;\n            animation: fadeInUp 0.6s ease forwards;\n            animation-delay: 400ms;\n            opacity: 0;\n        }\n\n        .hero__ctas {\n            display: flex;\n            gap: 1rem;\n            justify-content: center;\n            flex-wrap: wrap;\n            animation: fadeInUp 0.6s ease forwards;\n            animation-delay: 600ms;\n            opacity: 0;\n        }\n\n        .hero__cta {\n            padding: 1rem 2rem;\n            border-radius: 50px;\n            font-weight: 600;\n            font-size: 1rem;\n            text-decoration: none;\n            transition: all var(--transition-fast);\n            cursor: pointer;\n            border: none;\n        }\n\n        .hero__cta--primary {\n            background: linear-gradient(135deg, var(--color-moss), var(--color-moss-dark));\n            color: white;\n            box-shadow: 0 4px 20px rgba(74, 107, 74, 0.3);\n        }\n\n        .hero__cta--primary:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 8px 30px rgba(74, 107, 74, 0.4);\n        }\n\n        .hero__cta--secondary {\n            background: transparent;\n            color: var(--color-moss);\n            border: 2px solid var(--color-moss);\n        }\n\n        .hero__cta--secondary:hover {\n            background: var(--color-moss);\n            color: white;\n        }\n\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        /* Section Styles */\n        .section {\n            padding: var(--spacing-2xl) 5%;\n        }\n\n        .section__header {\n            text-align: center;\n            margin-bottom: var(--spacing-2xl);\n        }\n\n        .section__label {\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-sienna);\n            text-transform: uppercase;\n            letter-spacing: 0.1em;\n            margin-bottom: 1rem;\n        }\n\n        .section__title {\n            font-family: var(--font-display);\n            font-size: clamp(2rem, 4vw, 3rem);\n            font-weight: 700;\n            color: var(--color-charcoal);\n            margin-bottom: 1rem;\n        }\n\n        .section__description {\n            font-size: 1.1rem;\n            color: var(--color-charcoal);\n            opacity: 0.7;\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        /* Problem/Solution Section */\n        .problem-solution {\n            background: var(--color-sand);\n        }\n\n        .problem-solution__grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: 2rem;\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .problem-solution__card {\n            background: white;\n            padding: 2rem;\n            border-radius: 24px;\n            position: relative;\n            overflow: hidden;\n            transition: all var(--transition-base);\n        }\n\n        .problem-solution__card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 4px;\n            height: 100%;\n            background: linear-gradient(180deg, var(--color-moss), var(--color-sienna));\n        }\n\n        .problem-solution__card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);\n        }\n\n        .problem-solution__card--problem {\n            background: linear-gradient(135deg, rgba(184, 120, 74, 0.05), rgba(184, 120, 74, 0.02));\n        }\n\n        .problem-solution__card--solution {\n            background: linear-gradient(135deg, rgba(74, 107, 74, 0.05), rgba(74, 107, 74, 0.02));\n        }\n\n        .problem-solution__icon {\n            width: 60px;\n            height: 60px;\n            border-radius: 16px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n            font-size: 1.5rem;\n        }\n\n        .problem-solution__card--problem .problem-solution__icon {\n            background: linear-gradient(135deg, var(--color-sienna), var(--color-sienna-light));\n            color: white;\n        }\n\n        .problem-solution__card--solution .problem-solution__icon {\n            background: linear-gradient(135deg, var(--color-moss), var(--color-moss-light));\n            color: white;\n        }\n\n        .problem-solution__card-title {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            margin-bottom: 1rem;\n            color: var(--color-charcoal);\n        }\n\n        .problem-solution__card-text {\n            color: var(--color-charcoal);\n            opacity: 0.8;\n            line-height: 1.7;\n        }\n\n        /* Services Section */\n        .services__grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: 2rem;\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .service-card {\n            background: white;\n            padding: 2.5rem;\n            border-radius: 24px;\n            position: relative;\n            overflow: hidden;\n            transition: all var(--transition-base);\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: linear-gradient(90deg, var(--color-moss), var(--color-sienna));\n            opacity: 0;\n            transition: opacity var(--transition-fast);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 20px 50px rgba(74, 107, 74, 0.15);\n        }\n\n        .service-card:hover::before {\n            opacity: 1;\n        }\n\n        .service-card__icon {\n            width: 70px;\n            height: 70px;\n            border-radius: 20px;\n            background: linear-gradient(135deg, var(--color-moss-mist), var(--color-sand));\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 2rem;\n            margin-bottom: 1.5rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .service-card__icon::after {\n            content: '';\n            position: absolute;\n            inset: -3px;\n            border-radius: 23px;\n            background: linear-gradient(135deg, var(--color-moss), var(--color-sienna));\n            z-index: -1;\n            opacity: 0;\n            transition: opacity var(--transition-fast);\n        }\n\n        .service-card:hover .service-card__icon::after {\n            opacity: 1;\n        }\n\n        .service-card__title {\n            font-family: var(--font-display);\n            font-size: 1.35rem;\n            font-weight: 600;\n            margin-bottom: 1rem;\n            color: var(--color-charcoal);\n        }\n\n        .service-card__description {\n            color: var(--color-charcoal);\n            opacity: 0.75;\n            line-height: 1.7;\n            margin-bottom: 1.5rem;\n        }\n\n        .service-card__link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-moss);\n            text-decoration: none;\n            font-weight: 600;\n            transition: gap var(--transition-fast);\n        }\n\n        .service-card__link:hover {\n            gap: 1rem;\n        }\n\n        /* Testimonials Section */\n        .testimonials {\n            background: linear-gradient(135deg, var(--color-moss-dark), var(--color-moss-deep));\n            color: white;\n        }\n\n        .testimonials .section__title,\n        .testimonials .section__description {\n            color: white;\n        }\n\n        .testimonials .section__label {\n            color: var(--color-sienna-shimmer);\n        }\n\n        .testimonials__grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: 2rem;\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(10px);\n            padding: 2.5rem;\n            border-radius: 24px;\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            transition: all var(--transition-base);\n        }\n\n        .testimonial-card:hover {\n            background: rgba(255, 255, 255, 0.08);\n            transform: translateY(-5px);\n        }\n\n        .testimonial-card__stars {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: 1.5rem;\n            color: var(--color-sienna-shimmer);\n        }\n\n        .testimonial-card__quote {\n            font-size: 1.05rem;\n            line-height: 1.8;\n            margin-bottom: 2rem;\n            opacity: 0.9;\n        }\n\n        .testimonial-card__author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-card__avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: linear-gradient(135deg, var(--color-moss-light), var(--color-sienna));\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: white;\n        }\n\n        .testimonial-card__info {\n            flex: 1;\n        }\n\n        .testimonial-card__name {\n            font-weight: 600;\n            margin-bottom: 0.25rem;\n        }\n\n        .testimonial-card__role {\n            font-size: 0.85rem;\n            opacity: 0.7;\n        }\n\n        /* Differentials Section */\n        .differentials__grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 2rem;\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: 2rem;\n            position: relative;\n        }\n\n        .differential-item__icon-wrapper {\n            width: 80px;\n            height: 80px;\n            margin: 0 auto 1.5rem;\n            position: relative;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .differential-item__icon-ring {\n            position: absolute;\n            inset: 0;\n            border-radius: 50%;\n            border: 2px solid var(--color-moss);\n            opacity: 0.2;\n            animation: ringPulse 3s ease-in-out infinite;\n        }\n\n        .differential-item__icon-ring:nth-child(2) {\n            animation-delay: 1s;\n        }\n\n        .differential-item__icon-ring:nth-child(3) {\n            animation-delay: 2s;\n        }\n\n        @keyframes ringPulse {\n            0%, 100% {\n                transform: scale(1);\n                opacity: 0.2;\n            }\n            50% {\n                transform: scale(1.15);\n                opacity: 0.1;\n            }\n        }\n\n        .differential-item__icon {\n            width: 60px;\n            height: 60px;\n            border-radius: 18px;\n            background: linear-gradient(135deg, var(--color-moss), var(--color-moss-light));\n            color: white;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.5rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .differential-item__title {\n            font-family: var(--font-display);\n            font-size: 1.2rem;\n            font-weight: 600;\n            margin-bottom: 0.75rem;\n            color: var(--color-charcoal);\n        }\n\n        .differential-item__text {\n            color: var(--color-charcoal);\n            opacity: 0.75;\n            font-size: 0.95rem;\n        }\n\n        /* Contact Section */\n        .contact {\n            background: var(--color-sand);\n        }\n\n        .contact__container {\n            max-width: 800px;\n            margin: 0 auto;\n        }\n\n        .contact__form {\n            background: white;\n            padding: 3rem;\n            border-radius: 24px;\n            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);\n        }\n\n        .contact__form-group {\n            margin-bottom: 1.5rem;\n        }\n\n        .contact__form-label {\n            display: block;\n            font-weight: 600;\n            margin-bottom: 0.5rem;\n            color: var(--color-charcoal);\n            font-size: 0.9rem;\n        }\n\n        .contact__form-input,\n        .contact__form-select,\n        .contact__form-textarea {\n            width: 100%;\n            padding: 1rem;\n            border: 2px solid var(--color-sand-warm);\n            border-radius: 12px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: all var(--transition-fast);\n            background: var(--color-cream);\n        }\n\n        .contact__form-input:focus,\n        .contact__form-select:focus,\n        .contact__form-textarea:focus {\n            outline: none;\n            border-color: var(--color-moss);\n            background: white;\n        }\n\n        .contact__form-textarea {\n            min-height: 150px;\n            resize: vertical;\n        }\n\n        .contact__form-cta {\n            width: 100%;\n            padding: 1.25rem;\n            background: linear-gradient(135deg, var(--color-moss), var(--color-moss-dark));\n            color: white;\n            border: none;\n            border-radius: 12px;\n            font-size: 1.1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all var(--transition-fast);\n        }\n\n        .contact__form-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 10px 30px rgba(74, 107, 74, 0.3);\n        }\n\n        /* Footer */\n        .footer {\n            background: var(--color-charcoal-dark);\n            color: white;\n            padding: var(--spacing-2xl) 5% var(--spacing-xl);\n        }\n\n        .footer__container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer__top {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 3rem;\n            margin-bottom: 3rem;\n        }\n\n        .footer__brand {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            margin-bottom: 1rem;\n        }\n\n        .footer__brand span {\n            color: var(--color-sienna);\n        }\n\n        .footer__description {\n            opacity: 0.7;\n            line-height: 1.7;\n        }\n\n        .footer__section-title {\n            font-weight: 600;\n            margin-bottom: 1rem;\n            color: var(--color-sienna-shimmer);\n        }\n\n        .footer__links {\n            list-style: none;\n        }\n\n        .footer__link {\n            display: block;\n            color: white;\n            text-decoration: none;\n            opacity: 0.7;\n            padding: 0.5rem 0;\n            transition: opacity var(--transition-fast);\n        }\n\n        .footer__link:hover {\n            opacity: 1;\n        }\n\n        .footer__contact-item {\n            display: flex;\n            align-items: center;\n            gap: 0.75rem;\n            padding: 0.5rem 0;\n            opacity: 0.7;\n        }\n\n        .footer__contact-icon {\n            width: 20px;\n            height: 20px;\n            color: var(--color-sienna);\n        }\n\n        .footer__bottom {\n            text-align: center;\n            padding-top: 2rem;\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            opacity: 0.5;\n            font-size: 0.9rem;\n        }\n\n        /* Animation Classes */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(40px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.wow-visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-up[data-delay] {\n            transition-delay: var(--delay, 0ms);\n        }\n\n        /* Responsive */\n        @media (max-width: 768px) {\n            .nav__links {\n                display: none;\n                position: absolute;\n                top: 100%;\n                left: 0;\n                right: 0;\n                background: var(--color-cream);\n                flex-direction: column;\n                padding: 1rem 5%;\n                gap: 1rem;\n                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);\n            }\n\n            .nav__links.active {\n                display: flex;\n            }\n\n            .nav__cta {\n                display: none;\n            }\n\n            .nav__toggle {\n                display: flex;\n            }\n\n            .hero__blob--1,\n            .hero__blob--2 {\n                width: 300px;\n                height: 300px;\n            }\n\n            .hero__blob--3,\n            .hero__blob--4 {\n                width: 200px;\n                height: 200px;\n            }\n\n            .contact__form {\n                padding: 2rem;\n            }\n        }\n\n        @media (prefers-reduced-motion: reduce) {\n            *,\n            *::before,\n            *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <a href=\"#\" class=\"nav__logo\">7 <span>Peles</span></a>\n        <ul class=\"nav__links\" id=\"navLinks\">\n            <li><a href=\"#home\" class=\"nav__link\">Início</a></li>\n            <li><a href=\"#services\" class=\"nav__link\">Serviços</a></li>\n            <li><a href=\"#testimonials\" class=\"nav__link\">Depoimentos</a></li>\n            <li><a href=\"#differentials\" class=\"nav__link\">Diferenciais</a></li>\n            <li><a href=\"#contact\" class=\"nav__link\">Contato</a></li>\n        </ul>\n        <a href=\"#contact\" class=\"nav__cta\">Agendar Consulta</a>\n        <div class=\"nav__toggle\" id=\"navToggle\">\n            <span></span>\n            <span></span>\n            <span></span>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero__background\">\n            <div class=\"hero__blob hero__blob--1\"></div>\n            <div class=\"hero__blob hero__blob--2\"></div>\n            <div class=\"hero__blob hero__blob--3\"></div>\n            <div class=\"hero__blob hero__blob--4\"></div>\n        </div>\n        <div class=\"hero__content\">\n            <div class=\"hero__badge\">\n                <span class=\"hero__badge-dot\"></span>\n                Estética Avançada em Ribeirão Preto\n            </div>\n            <h1 class=\"hero__title\">\n                Sua beleza natural,<br>\n                <span class=\"hero__title-accent\">potencializada</span>\n            </h1>\n            <p class=\"hero__subtitle\">\n                Dra. Fernanda Ursoli combina técnica apurada e arte para criar resultados naturais e harmoniosos que realçam seus melhores traços.\n            </p>\n            <div class=\"hero__ctas\">\n                <a href=\"#contact\" class=\"hero__cta hero__cta--primary\">Agendar Consulta</a>\n                <a href=\"#services\" class=\"hero__cta hero__cta--secondary\">Conhecer Tratamentos</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\" id=\"problem-solution\">\n        <div class=\"section__header wow-fade-up\">\n            <span class=\"section__label\">Sua Jornada</span>\n            <h2 class=\"section__title\">Transforme sua autoestima</h2>\n            <p class=\"section__description\">Entendemos suas preocupações e oferecemos soluções personalizadas para você se sentir confiante.</p>\n        </div>\n        <div class=\"problem-solution__grid\">\n            <div class=\"problem-solution__card problem-solution__card--problem wow-fade-up\" data-delay=\"0\">\n                <div class=\"problem-solution__icon\">😔</div>\n                <h3 class=\"problem-solution__card-title\">O Desafio</h3>\n                <p class=\"problem-solution__card-text\">Sinais de envelhecimento, assimetrias faciais ou simplesmente não se sentir confiante com sua aparência podem impactar sua autoestima e qualidade de vida.</p>\n            </div>\n            <div class=\"problem-solution__card problem-solution__card--solution wow-fade-up\" data-delay=\"200\">\n                <div class=\"problem-solution__icon\">✨</div>\n                <h3 class=\"problem-solution__card-title\">A Solução</h3>\n                <p class=\"problem-solution__card-text\">Com a Dra. Fernanda Ursoli, você recebe tratamentos personalizados que respeitam sua individualidade, com resultados naturais e duradouros.</p>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"services\">\n        <div class=\"section__header wow-fade-up\">\n            <span class=\"section__label\">Tratamentos</span>\n            <h2 class=\"section__title\">Procedimentos Especializados</h2>\n            <p class=\"section__description\">Técnicas avançadas para realçar sua beleza com naturalidade e segurança.</p>\n        </div>\n        <div class=\"services__grid\">\n            <div class=\"service-card wow-fade-up\" data-delay=\"0\">\n                <div class=\"service-card__icon\">🎯</div>\n                <h3 class=\"service-card__title\">Harmonização Facial</h3>\n                <p class=\"service-card__description\">Equilíbrio e proporção para seus traços faciais com técnicas minimamente invasivas e resultados naturais.</p>\n                <a href=\"#contact\" class=\"service-card__link\">Saiba mais →</a>\n            </div>\n            <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                <div class=\"service-card__icon\">💉</div>\n                <h3 class=\"service-card__title\">Toxina Botulínica</h3>\n                <p class=\"service-card__description\">Suavize linhas de expressão e previna novos sinais com aplicação precisa e personalizada.</p>\n                <a href=\"#contact\" class=\"service-card__link\">Saiba mais →</a>\n            </div>\n            <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n                <div class=\"service-card__icon\">💎</div>\n                <h3 class=\"service-card__title\">Preenchedores Faciais</h3>\n                <p class=\"service-card__description\">Restaure volume e contorno com ácido hialurônico de alta qualidade para resultados harmônicos.</p>\n                <a href=\"#contact\" class=\"service-card__link\">Saiba mais →</a>\n            </div>\n            <div class=\"service-card wow-fade-up\" data-delay=\"0\">\n                <div class=\"service-card__icon\">👄</div>\n                <h3 class=\"service-card__title\">Preenchimento Labial</h3>\n                <p class=\"service-card__description\">Lábios mais volumosos e definidos com técnicas que preservam a naturalidade do seu sorriso.</p>\n                <a href=\"#contact\" class=\"service-card__link\">Saiba mais →</a>\n            </div>\n            <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                <div class=\"service-card__icon\">🌟</div>\n                <h3 class=\"service-card__title\">Bioestimuladores</h3>\n                <p class=\"service-card__description\">Estimule o colágeno natural para uma pele mais firme, jovem e saudável a longo prazo.</p>\n                <a href=\"#contact\" class=\"service-card__link\">Saiba mais →</a>\n            </div>\n            <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n                <div class=\"service-card__icon\">⭐</div>\n                <h3 class=\"service-card__title\">Protocolos Exclusivos</h3>\n                <p class=\"service-card__description\">Tratamentos personalizados combinando técnicas para resultados únicos e satisfatórios.</p>\n                <a href=\"#contact\" class=\"service-card__link\">Saiba mais →</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"testimonials\">\n        <div class=\"section__header wow-fade-up\">\n            <span class=\"section__label\">Depoimentos</span>\n            <h2 class=\"section__title\">O que dizem nossas pacientes</h2>\n            <p class=\"section__description\">Histórias reais de transformação e satisfação.</p>\n        </div>\n        <div class=\"testimonials__grid\">\n            <div class=\"testimonial-card wow-fade-up\" data-delay=\"0\">\n                <div class=\"testimonial-card__stars\">★★★★★</div>\n                <p class=\"testimonial-card__quote\">\"A Dra. Fernanda é incrível! Fiz minha harmonização facial e o resultado superou todas as minhas expectativas. Natural e elegante!\"</p>\n                <div class=\"testimonial-card__author\">\n                    <div class=\"testimonial-card__avatar\">MC</div>\n                    <div class=\"testimonial-card__info\">\n                        <div class=\"testimonial-card__name\">Maria Clara</div>\n                        <div class=\"testimonial-card__role\">Empresária</div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"testimonial-card wow-fade-up\" data-delay=\"200\">\n                <div class=\"testimonial-card__stars\">★★★★★</div>\n                <p class=\"testimonial-card__quote\">\"Profissionalismo e dedicação desde a primeira consulta. Me senti sempre segura e confiante durante todo o tratamento.\"</p>\n                <div class=\"testimonial-card__author\">\n                    <div class=\"testimonial-card__avatar\">AL</div>\n                    <div class=\"testimonial-card__info\">\n                        <div class=\"testimonial-card__name\">Ana Luíza</div>\n                        <div class=\"testimonial-card__role\">Advogada</div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"testimonial-card wow-fade-up\" data-delay=\"400\">\n                <div class=\"testimonial-card__stars\">★★★★★</div>\n                <p class=\"testimonial-card__quote\">\"Os resultados são naturais e duradouros. Recebo elogios sempre! Recomendo a Clínica 7 Peles para todas as minhas amigas.\"</p>\n                <div class=\"testimonial-card__author\">\n                    <div class=\"testimonial-card__avatar\">JS</div>\n                    <div class=\"testimonial-card__info\">\n                        <div class=\"testimonial-card__name\">Juliana Silva</div>\n                        <div class=\"testimonial-card__role\">Arquiteta</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\" id=\"differentials\">\n        <div class=\"section__header wow-fade-up\">\n            <span class=\"section__label\">Por que nos escolher</span>\n            <h2 class=\"section__title\">Nossos Diferenciais</h2>\n            <p class=\"section__description\">O que torna a Clínica 7 Peles única em Ribeirão Preto.</p>\n        </div>\n        <div class=\"differentials__grid\">\n            <div class=\"differential-item wow-fade-up\" data-delay=\"0\">\n                <div class=\"differential-item__icon-wrapper\">\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon\">👩‍⚕️</div>\n                </div>\n                <h3 class=\"differential-item__title\">Especialista Dedicada</h3>\n                <p class=\"differential-item__text\">Dra. Fernanda Ursoli acompanha cada paciente com atenção personalizada.</p>\n            </div>\n            <div class=\"differential-item wow-fade-up\" data-delay=\"200\">\n                <div class=\"differential-item__icon-wrapper\">\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon\">🎨</div>\n                </div>\n                <h3 class=\"differential-item__title\">Abordagem Artística</h3>\n                <p class=\"differential-item__text\">Técnicas que combinam ciência e arte para resultados harmônicos.</p>\n            </div>\n            <div class=\"differential-item wow-fade-up\" data-delay=\"400\">\n                <div class=\"differential-item__icon-wrapper\">\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon\">🔬</div>\n                </div>\n                <h3 class=\"differential-item__title\">Tecnologia Avançada</h3>\n                <p class=\"differential-item__text\">Equipamentos de última geração para procedimentos seguros e eficazes.</p>\n            </div>\n            <div class=\"differential-item wow-fade-up\" data-delay=\"0\">\n                <div class=\"differential-item__icon-wrapper\">\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon\">💚</div>\n                </div>\n                <h3 class=\"differential-item__title\">Resultados Naturais</h3>\n                <p class=\"differential-item__text\">Enhancement que respeita suas características únicas e individuais.</p>\n            </div>\n            <div class=\"differential-item wow-fade-up\" data-delay=\"200\">\n                <div class=\"differential-item__icon-wrapper\">\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon\">🛡️</div>\n                </div>\n                <h3 class=\"differential-item__title\">Segurança Primeiro</h3>\n                <p class=\"differential-item__text\">Protocolos rigorosos e produtos certificados para sua tranquilidade.</p>\n            </div>\n            <div class=\"differential-item wow-fade-up\" data-delay=\"400\">\n                <div class=\"differential-item__icon-wrapper\">\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon-ring\"></div>\n                    <div class=\"differential-item__icon\">📍</div>\n                </div>\n                <h3 class=\"differential-item__title\">Localização Privilegiada</h3>\n                <p class=\"differential-item__text\">Clínica facilmente acessível no Alto da Boa Vista em Ribeirão Preto.</p>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contact\">\n        <div class=\"section__header wow-fade-up\">\n            <span class=\"section__label\">Contato</span>\n            <h2 class=\"section__title\">Agende sua consulta</h2>\n            <p class=\"section__description\">Dê o primeiro passo para transformar sua autoestima. Entre em contato conosco.</p>\n        </div>\n        <div class=\"contact__container\">\n            <form class=\"contact__form wow-fade-up\" id=\"contactForm\">\n                <div class=\"contact__form-group\">\n                    <label class=\"contact__form-label\" for=\"name\">Nome completo</label>\n                    <input class=\"contact__form-input\" type=\"text\" id=\"name\" name=\"name\" required placeholder=\"Seu nome\">\n                </div>\n                <div class=\"contact__form-group\">\n                    <label class=\"contact__form-label\" for=\"email\">E-mail</label>\n                    <input class=\"contact__form-input\" type=\"email\" id=\"email\" name=\"email\" required placeholder=\"seu@email.com\">\n                </div>\n                <div class=\"contact__form-group\">\n                    <label class=\"contact__form-label\" for=\"phone\">Telefone</label>\n                    <input class=\"contact__form-input\" type=\"tel\" id=\"phone\" name=\"phone\" required placeholder=\"(16) 99999-9999\">\n                </div>\n                <div class=\"contact__form-group\">\n                    <label class=\"contact__form-label\" for=\"service\">Tratamento de interesse</label>\n                    <select class=\"contact__form-select\" id=\"service\" name=\"service\" required>\n                        <option value=\"\">Selecione uma opção</option>\n                        <option value=\"harmonizacao\">Harmonização Facial</option>\n                        <option value=\"botox\">Toxina Botulínica</option>\n                        <option value=\"preenchedores\">Preenchedores Faciais</option>\n                        <option value=\"labial\">Preenchimento Labial</option>\n                        <option value=\"bioestimuladores\">Bioestimuladores</option>\n                        <option value=\"protocolos\">Protocolos Exclusivos</option>\n                        <option value=\"outro\">Outro</option>\n                    </select>\n                </div>\n                <div class=\"contact__form-group\">\n                    <label class=\"contact__form-label\" for=\"message\">Mensagem</label>\n                    <textarea class=\"contact__form-textarea\" id=\"message\" name=\"message\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                </div>\n                <button type=\"submit\" class=\"contact__form-cta\">Enviar via WhatsApp</button>\n            </form>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer__container\">\n            <div class=\"footer__top\">\n                <div>\n                    <div class=\"footer__brand\">7 <span>Peles</span></div>\n                    <p class=\"footer__description\">Estética avançada com resultados naturais e duradouros. Dra. Fernanda Ursoli - Harmonização Facial em Ribeirão Preto.</p>\n                </div>\n                <div>\n                    <h4 class=\"footer__section-title\">Links Rápidos</h4>\n                    <ul class=\"footer__links\">\n                        <li><a href=\"#home\" class=\"footer__link\">Início</a></li>\n                        <li><a href=\"#services\" class=\"footer__link\">Tratamentos</a></li>\n                        <li><a href=\"#testimonials\" class=\"footer__link\">Depoimentos</a></li>\n                        <li><a href=\"#contact\" class=\"footer__link\">Contato</a></li>\n                    </ul>\n                </div>\n                <div>\n                    <h4 class=\"footer__section-title\">Contato</h4>\n                    <div class=\"footer__contact-item\">\n                        <span>📍</span>\n                        <span>R. Itacolomi, 193 - Alto da Boa Vista, Ribeirão Preto - SP, 14025-250</span>\n                    </div>\n                    <div class=\"footer__contact-item\">\n                        <span>📱</span>\n                        <span>(16) 99776-2809</span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"footer__bottom\">\n                <p>&copy; 2026 Clínica 7 Peles - Dra. Fernanda Ursoli. Todos os direitos reservados.</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // Navigation\n        const nav = document.getElementById('nav');\n        const navToggle = document.getElementById('navToggle');\n        const navLinks = document.getElementById('navLinks');\n        let lastScrollY = window.scrollY;\n\n        window.addEventListener('scroll', () => {\n            if (window.scrollY > 100) {\n                nav.classList.add('scrolled');\n            } else {\n                nav.classList.remove('scrolled');\n            }\n\n            if (window.scrollY > lastScrollY && window.scrollY > 200) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n            lastScrollY = window.scrollY;\n        });\n\n        navToggle.addEventListener('click', () => {\n            navLinks.classList.toggle('active');\n        });\n\n        // Close mobile menu on link click\n        navLinks.querySelectorAll('a').forEach(link => {\n            link.addEventListener('click', () => {\n                navLinks.classList.remove('active');\n            });\n        });\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // Intersection Observer for animations\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || 0;\n                    setTimeout(() => {\n                        entry.target.classList.add('wow-visible');\n                    }, delay);\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up').forEach(el => {\n            observer.observe(el);\n        });\n\n        // Contact form - WhatsApp integration\n        const contactForm = document.getElementById('contactForm');\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const email = document.getElementById('email').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceNames = {\n                'harmonizacao': 'Harmonização Facial',\n                'botox': 'Toxina Botulínica',\n                'preenchedores': 'Preenchedores Faciais',\n                'labial': 'Preenchimento Labial',\n                'bioestimuladores': 'Bioestimuladores',\n                'protocolos': 'Protocolos Exclusivos',\n                'outro': 'Outro'\n            };\n\n            const whatsappMessage = encodeURIComponent(\n                `*Olá! Gostaria de agendar uma consulta na Clínica 7 Peles*\\n\\n` +\n                `📋 *Dados de contato:*\\n` +\n                `• Nome: ${name}\\n` +\n                `• Email: ${email}\\n` +\n                `• Telefone: ${phone}\\n\\n` +\n                `🎯 *Tratamento de interesse:* ${serviceNames[service] || service}\\n\\n` +\n                `💬 *Mensagem:*\\n${message || 'Gostaria de mais informações.'}`\n            );\n\n            const whatsappURL = `https://wa.me/5516997762809?text=${whatsappMessage}`;\n            window.open(whatsappURL, '_blank');\n        });\n\n        // Parallax effect for hero blobs\n        document.addEventListener('mousemove', (e) => {\n            const moveX = (e.clientX - window.innerWidth / 2) * 0.01;\n            const moveY = (e.clientY - window.innerHeight / 2) * 0.01;\n\n            document.querySelectorAll('.hero__blob').forEach((blob, index) => {\n                const speed = (index + 1) * 0.5;\n                blob.style.transform = `translate(${moveX * speed}px, ${moveY * speed}px)`;\n            });\n        });\n    </script>\n</body>\n</html>","structuredPatch":[],"originalFile":null}}
