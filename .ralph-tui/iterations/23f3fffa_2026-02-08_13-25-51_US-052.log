#8B8680;\n            --color-taupe-light: #A8A4A0;\n\n            /* Gradients */\n            --gradient-emerald: linear-gradient(135deg, #2D7A6E 0%, #4A9A8C 100%);\n            --gradient-emerald-soft: linear-gradient(135deg, #A8D5CC 0%, #D4EBE5 100%);\n            --gradient-silk: linear-gradient(135deg, #F7F5F0 0%, #F0EDE6 100%);\n            --gradient-champagne: linear-gradient(135deg, #C9A86C 0%, #D9BE9A 100%);\n            --gradient-fade: linear-gradient(180deg, rgba(247,245,240,0) 0%, rgba(247,245,240,1) 100%);\n\n            /* Typography */\n            --font-display: 'Bodoni Moda', Georgia, serif;\n            --font-body: 'Source Sans 3', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n            --spacing-xxl: 8rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 16px;\n            --radius-lg: 24px;\n            --radius-pill: 100px;\n            --radius-ellipse: 70% 30% / 30% 70% 70% 30%;\n            --radius-ellipse-2: 30% 70% / 70% 30% 30% 70%;\n            --radius-ellipse-3: 50% 40% / 40% 50% 60% 50%;\n\n            /* Shadows */\n            --shadow-soft: 0 8px 32px rgba(45, 122, 110, 0.15);\n            --shadow-glow: 0 8px 48px rgba(201, 168, 108, 0.2);\n            --shadow-elegant: 0 16px 64px rgba(42, 42, 42, 0.08);\n            --shadow-floating: 0 20px 60px rgba(45, 122, 110, 0.18);\n\n            /* Transitions */\n            --transition-fast: 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-base: 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-slow: 0.8s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n\n        /* ========================================\n           RESET & BASE STYLES\n        ======================================== */\n        *, *::before, *::after {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        html {\n            scroll-behavior: smooth;\n            font-size: 16px;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background: var(--color-silk-cream);\n            color: var(--color-charcoal);\n            line-height: 1.7;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        img {\n            max-width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-fast);\n        }\n\n        ul {\n            list-style: none;\n        }\n\n        /* ========================================\n           TYPOGRAPHY\n        ======================================== */\n        h1, h2, h3, h4 {\n            font-family: var(--font-display);\n            font-weight: 500;\n            line-height: 1.2;\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 8vw, 5rem);\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 5vw, 3.5rem);\n            letter-spacing: -0.01em;\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 3vw, 2rem);\n        }\n\n        .text-emerald { color: var(--color-emerald); }\n        .text-champagne { color: var(--color-champagne); }\n\n        /* ========================================\n           NAVIGATION\n        ======================================== */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            background: rgba(247, 245, 240, 0.95);\n            backdrop-filter: blur(20px);\n            z-index: 1000;\n            transition: transform var(--transition-base);\n            box-shadow: 0 1px 0 rgba(45, 122, 110, 0.1);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 1rem 2rem;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            color: var(--color-charcoal);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: 2rem;\n            align-items: center;\n        }\n\n        .nav-link {\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-charcoal-light);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-emerald);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.75rem 1.5rem;\n            background: var(--color-emerald);\n            color: white;\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: all var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            background: var(--color-emerald-dark);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .mobile-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            cursor: pointer;\n            padding: 5px;\n        }\n\n        .mobile-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-charcoal);\n            transition: var(--transition-fast);\n        }\n\n        /* ========================================\n           HERO SECTION\n        ======================================== */\n        .hero {\n            position: relative;\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            overflow: hidden;\n            background: var(--gradient-silk);\n        }\n\n        .hero-ellipses {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            overflow: hidden;\n            z-index: 1;\n        }\n\n        .ellipse {\n            position: absolute;\n            border-radius: var(--radius-ellipse);\n            filter: blur(60px);\n            opacity: 0.5;\n            animation: ellipse-float 20s ease-in-out infinite;\n        }\n\n        .ellipse-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-emerald);\n            top: -10%;\n            right: -5%;\n            animation-delay: 0s;\n        }\n\n        .ellipse-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-emerald-soft);\n            bottom: -5%;\n            left: -10%;\n            animation-delay: -5s;\n            border-radius: var(--radius-ellipse-2);\n        }\n\n        .ellipse-3 {\n            width: 350px;\n            height: 350px;\n            background: var(--gradient-champagne);\n            top: 40%;\n            left: 30%;\n            animation-delay: -10s;\n            opacity: 0.35;\n            border-radius: var(--radius-ellipse-3);\n        }\n\n        .ellipse-4 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(135deg, #A8D5CC 0%, #F7F5F0 100%);\n            bottom: 20%;\n            right: 20%;\n            animation-delay: -15s;","numLines":300,"startLine":1,"totalLines":1954}}}
