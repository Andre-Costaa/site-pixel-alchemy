2\">\n                            <path d=\"M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z\"/>\n                        </svg>\n                    </div>\n                    <h3>Cuidado</h3>\n                    <p>Acompanhamento completo antes e depois</p>\n                </div>\n                <div class=\"differential-item\" data-delay=\"400\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2\"/>\n                            <circle cx=\"9\" cy=\"7\" r=\"4\"/>\n                            <path d=\"M23 21v-2a4 4 0 00-3-3.87\"/>\n                            <path d=\"M16 3.13a4 4 0 010 7.75\"/>\n                        </svg>\n                    </div>\n                    <h3>Experiência</h3>\n                    <p>Anos de dedicação à estética facial</p>\n                </div>\n                <div class=\"differential-item\" data-delay=\"500\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M14 9V5a3 3 0 00-3-3l-4 9v11h11.28a2 2 0 002-1.7l1.38-9a2 2 0 00-2-2.3zM7 22H4a2 2 0 01-2-2v-7a2 2 0 012-2h3\"/>\n                        </svg>\n                    </div>\n                    <h3>Satisfação</h3>\n                    <p>Resultados que superam expectativas</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact-section\" id=\"contact\">\n        <div class=\"container\">\n            <div class=\"contact-grid\">\n                <div class=\"contact-info\">\n                    <h3>Agende sua Consulta</h3>\n                    <p>Entre em contato para agendar sua avaliação personalizada. Estamos prontos para realçar sua beleza natural.</p>\n                    <div class=\"contact-details\">\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                    <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z\"/>\n                                    <circle cx=\"12\" cy=\"10\" r=\"3\"/>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-text\">\n                                <strong>Endereço:</strong><br>\n                                R. Altíno Arantes, 1901 - Jardim Sumare<br>\n                                Ribeirão Preto - SP, 14020-200\n                            </div>\n                        </div>\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                    <path d=\"M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z\"/>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-text\">\n                                <strong>WhatsApp:</strong><br>\n                                (16) 99729-2323\n                            </div>\n                        </div>\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                    <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                                    <path d=\"M12 6v6l4 2\"/>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-text\">\n                                <strong>Horário:</strong><br>\n                                Segunda a Sexta: 9h às 18h<br>\n                                Sábado: 9h às 13h\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <form class=\"contact-form\" id=\"contactForm\">\n                    <div class=\"form-group\">\n                        <label for=\"name\">Nome Completo</label>\n                        <input type=\"text\" id=\"name\" name=\"name\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"phone\">Telefone/WhatsApp</label>\n                        <input type=\"tel\" id=\"phone\" name=\"phone\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"service\">Serviço de Interesse</label>\n                        <select id=\"service\" name=\"service\" required>\n                            <option value=\"\">Selecione um serviço</option>\n                            <option value=\"Harmonização Facial\">Harmonização Facial</option>\n                            <option value=\"Toxina Botulínica\">Toxina Botulínica</option>\n                            <option value=\"Preenchedores Faciais\">Preenchedores Faciais</option>\n                            <option value=\"Preenchimento Labial\">Preenchimento Labial</option>\n                            <option value=\"Bioestimuladores\">Bioestimuladores</option>\n                            <option value=\"Protocolos Exclusivos\">Protocolos Exclusivos</option>\n                            <option value=\"Outro\">Outro</option>\n                        </select>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"message\">Mensagem</label>\n                        <textarea id=\"message\" name=\"message\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                    </div>\n                    <button type=\"submit\" class=\"form-submit\">Agendar via WhatsApp</button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-content\">\n            <div class=\"footer-section\">\n                <h4>Dra Gel</h4>\n                <p>Harmonização Facial e Estética Avançada em Ribeirão Preto. Realce sua beleza natural com tratamentos premium.</p>\n            </div>\n            <div class=\"footer-section\">\n                <h4>Links Rápidos</h4>\n                <a href=\"#home\">Início</a>\n                <a href=\"#services\">Serviços</a>\n                <a href=\"#testimonials\">Depoimentos</a>\n                <a href=\"#contact\">Contato</a>\n            </div>\n            <div class=\"footer-section\">\n                <h4>Contato</h4>\n                <p>R. Altíno Arantes, 1901 - Jardim Sumare</p>\n                <p>Ribeirão Preto - SP, 14020-200</p>\n                <p>(16) 99729-2323</p>\n            </div>\n            <div class=\"footer-section\">\n                <h4>Horário</h4>\n                <p>Segunda a Sexta: 9h às 18h</p>\n                <p>Sábado: 9h às 13h</p>\n            </div>\n        </div>\n        <div class=\"footer-bottom\">\n            <p>&copy; 2026 Dra Gel. Todos os direitos reservados.</p>\n        </div>\n    </footer>\n\n    <script>\n        // Navigation scroll behavior\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                    nav.classList.remove('visible');\n                } else {\n                    nav.classList.remove('hidden');\n                    nav.classList.add('visible');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Mobile menu toggle\n        const navToggle = document.getElementById('navToggle');\n        const navLinks = document.getElementById('navLinks');\n\n        navToggle.addEventListener('click', () => {\n            navLinks.classList.toggle('active');\n        });\n\n        // Close mobile menu when clicking on a link\n        navLinks.querySelectorAll('a').forEach(link => {\n            link.addEventListener('click', () => {\n                navLinks.classList.remove('active');\n            });\n        });\n\n        // Intersection Observer for scroll animations\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || 0;\n                    setTimeout(() => {\n                        entry.target.classList.add('visible');\n                    }, delay);\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        // Observe elements\n        document.querySelectorAll('.section-header, .problem-card, .service-card, .testimonial-card, .differential-item').forEach(el => {\n            observer.observe(el);\n        });\n\n        // Contact form submission to WhatsApp\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const whatsappMessage = `Olá! Me chamo ${name}.\\n\\nTelefone: ${phone}\\nServiço de interesse: ${service}\\n\\nMensagem: ${message || 'Gostaria de agendar uma consulta.'}`;\n\n            const whatsappUrl = `https://wa.me/5516997292323?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappUrl, '_blank');\n        });\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n    </script>\n</body>\n</html>"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"fc31f120-013d-457b-a233-4e9c3911e39e","uuid":"deffdceb-ac6f-48fc-a39c-4d937337a855"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_826bfc7dd7c44d499034e291","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-gel-clinica/index.html"}]},"parent_tool_use_id":null,"session_id":"fc31f120-013d-457b-a233-4e9c3911e39e","uuid":"fdbd8993-fcce-403c-a40a-5e10b0519988","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-gel-clinica/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra Gel | Harmonização Facial e Estética Avançada em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra Gel - Atendimento especializado em harmonização facial e estética avançada em Ribeirão Preto. Agende sua consulta.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            /* Teal Noir & Copper Palette */\n            --color-teal: #1A7A6E;\n            --color-teal-light: #2A9A8C;\n            --color-teal-dark: #0A5A52;\n            --color-teal-deep: #0A3A32;\n            --color-teal-mid: #1A6A5E;\n            --color-copper: #B8784A;\n            --color-copper-light: #C89868;\n            --color-copper-dark: #985838;\n            --color-copper-shimmer: #D8A888;\n            --color-cream: #FAF8F5;\n            --color-cream-warm: #F5F3F0;\n            --color-off-white: #FDFCFA;\n            --color-shadow: #2A2828;\n            --color-shadow-dark: #1A1818;\n            --color-shadow-light: #3A3838;\n\n            /* Typography */\n            --font-display: 'Libre Baskerville', serif;\n            --font-body: 'Outfit', sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Teal Wave Border Radius */\n            --radius-wave-1: 68% 32% 52% 48% / 58% 42% 58% 42%;\n            --radius-wave-2: 48% 52% 62% 38% / 42% 58% 42% 58%;\n            --radius-wave-3: 58% 42% 48% 52% / 52% 48% 52% 48%;\n            --radius-wave-4: 42% 58% 52% 48% / 48% 52% 48% 52%;\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background-color: var(--color-cream);\n            color: var(--color-shadow);\n            line-height: 1.6;\n            overflow-x: hidden;\n        }\n\n        /* Typography */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-shadow);\n        }\n\n        h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); }\n        h2 { font-size: clamp(2rem, 4vw, 3rem); }\n        h3 { font-size: clamp(1.5rem, 3vw, 2rem); }\n\n        p {\n            font-size: 1.1rem;\n            color: var(--color-shadow-light);\n            line-height: 1.8;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-fast);\n        }\n\n        /* Navigation */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: 1rem 2rem;\n            background: rgba(250, 248, 245, 0.95);\n            backdrop-filter: blur(10px);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav.visible {\n            transform: translateY(0);\n            box-shadow: 0 2px 20px rgba(42, 40, 40, 0.1);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-teal);\n        }\n\n        .nav-links {\n            display: flex;\n            gap: 2rem;\n            list-style: none;\n        }\n\n        .nav-links a {\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-shadow);\n            position: relative;\n        }\n\n        .nav-links a::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-copper);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-links a:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.75rem 1.5rem;\n            background: var(--color-teal);\n            color: var(--color-cream);\n            border-radius: 50px;\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            background: var(--color-teal-dark);\n            transform: translateY(-2px);\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 4px;\n            cursor: pointer;\n        }\n\n        .nav-toggle span {\n            width: 24px;\n            height: 2px;\n            background: var(--color-shadow);\n            transition: var(--transition-fast);\n        }\n\n        /* Hero Section */\n        .hero {\n            position: relative;\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            padding: 6rem 2rem 4rem;\n            overflow: hidden;\n            background: linear-gradient(135deg, var(--color-cream) 0%, var(--color-cream-warm) 100%);\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-wave-1);\n            filter: blur(60px);\n            opacity: 0.4;\n            animation: float 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 400px;\n            height: 400px;\n            background: linear-gradient(135deg, var(--color-teal) 0%, var(--color-teal-light) 100%);\n            top: 10%;\n            left: 10%;\n            animation-delay: 0s;\n        }\n\n        .blob-2 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(135deg, var(--color-copper) 0%, var(--color-copper-light) 100%);\n            top: 60%;\n            right: 10%;\n            animation-delay: -5s;\n            border-radius: var(--radius-wave-2);\n        }\n\n        .blob-3 {\n            width: 250px;\n            height: 250px;\n            background: linear-gradient(135deg, var(--color-teal-light) 0%, var(--color-copper) 100%);\n            bottom: 20%;\n            left: 20%;\n            animation-delay: -10s;\n            border-radius: var(--radius-wave-3);\n        }\n\n        .blob-4 {\n            width: 200px;\n            height: 200px;\n            background: linear-gradient(135deg, var(--color-copper-shimmer) 0%, var(--color-teal) 100%);\n            top: 30%;\n            right: 30%;\n            animation-delay: -15s;\n            border-radius: var(--radius-wave-4);\n        }\n\n        @keyframes float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(90deg) scale(1.1);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(180deg) scale(0.9);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(270deg) scale(1.05);\n            }\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 10;\n            max-width: 800px;\n            text-align: center;\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeUp 1s ease forwards;\n            animation-delay: 0.2s;\n        }\n\n        @keyframes fadeUp {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .hero-tag {\n            display: inline-block;\n            padding: 0.5rem 1.5rem;\n            background: rgba(26, 122, 110, 0.1);\n            color: var(--color-teal);\n            border-radius: 50px;\n            font-size: 0.9rem;\n            font-weight: 600;\n            margin-bottom: 1.5rem;\n            letter-spacing: 0.05em;\n        }\n\n        .hero h1 {\n            margin-bottom: 1.5rem;\n            color: var(--color-shadow-dark);\n        }\n\n        .hero p {\n            font-size: 1.25rem;\n            margin-bottom: 2rem;\n            max-width: 600px;\n            margin-left: auto;\n            margin-right: auto;\n        }\n\n        .hero-cta {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            background: var(--color-teal);\n            color: var(--color-cream);\n            border-radius: 50px;\n            font-weight: 600;\n            font-size: 1rem;\n            transition: var(--transition-fast);\n            box-shadow: 0 4px 20px rgba(26, 122, 110, 0.3);\n        }\n\n        .hero-cta:hover {\n            background: var(--color-teal-dark);\n            transform: translateY(-2px);\n            box-shadow: 0 6px 30px rgba(26, 122, 110, 0.4);\n        }\n\n        /* Section Styles */\n        .section {\n            padding: 6rem 2rem;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: 4rem;\n            opacity: 0;\n            transform: translateY(30px);\n            transition: all 0.6s ease;\n        }\n\n        .section-header.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .section-tag {\n            display: inline-block;\n            padding: 0.5rem 1.5rem;\n            background: rgba(26, 122, 110, 0.1);\n            color: var(--color-teal);\n            border-radius: 50px;\n            font-size: 0.85rem;\n            font-weight: 600;\n            margin-bottom: 1rem;\n            letter-spacing: 0.05em;\n        }\n\n        .section-title {\n            margin-bottom: 1rem;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        /* Problem/Solution Section */\n        .problem-section {\n            background: var(--color-off-white);\n        }\n\n        .problem-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: 2rem;\n            margin-top: 3rem;\n        }\n\n        .problem-card {\n            background: var(--color-cream);\n            padding: 2rem;\n            border-radius: var(--radius-wave-1);\n            border-left: 4px solid var(--color-teal);\n            transition: var(--transition-base);\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .problem-card.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .problem-card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 10px 40px rgba(26, 122, 110, 0.15);\n        }\n\n        .problem-icon {\n            width: 50px;\n            height: 50px;\n            background: rgba(26, 122, 110, 0.1);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1rem;\n            color: var(--color-teal);\n            font-size: 1.5rem;\n        }\n\n        .problem-card h3 {\n            margin-bottom: 0.75rem;\n            font-size: 1.25rem;\n        }\n\n        .problem-card p {\n            font-size: 1rem;\n        }\n\n        /* Services Section */\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: 2rem;\n        }\n\n        .service-card {\n            background: var(--color-cream);\n            padding: 2.5rem;\n            border-radius: var(--radius-wave-2);\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .service-card.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: linear-gradient(90deg, var(--color-teal), var(--color-copper));\n            transform: scaleX(0);\n            transform-origin: left;\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 15px 50px rgba(26, 122, 110, 0.15);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: linear-gradient(135deg, var(--color-teal), var(--color-teal-light));\n            border-radius: var(--radius-wave-1);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n            color: white;\n            font-size: 1.5rem;\n        }\n\n        .service-card h3 {\n            margin-bottom: 1rem;\n            font-size: 1.35rem;\n        }\n\n        .service-card p {\n            font-size: 1rem;\n            margin-bottom: 1.5rem;\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-teal);\n            font-weight: 600;\n            font-size: 0.9rem;\n        }\n\n        .service-link:hover {\n            gap: 0.75rem;\n        }\n\n        /* Testimonials Section */\n        .testimonials-section {\n            background: var(--color-teal-deep);\n            color: var(--color-cream);\n        }\n\n        .testimonials-section .section-title,\n        .testimonials-section p {\n            color: var(--color-cream);\n        }\n\n        .testimonials-section .section-tag {\n            background: rgba(250, 248, 245, 0.15);\n            color: var(--color-copper-shimmer);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: 2rem;\n        }\n\n        .testimonial-card {\n            background: rgba(250, 248, 245, 0.1);\n            backdrop-filter: blur(10px);\n            padding: 2.5rem;\n            border-radius: var(--radius-wave-3);\n            border: 1px solid rgba(184, 120, 74, 0.2);\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .testimonial-card.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .testimonial-stars {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: 1rem;\n            color: var(--color-copper-shimmer);\n        }\n\n        .testimonial-text {\n            font-size: 1.05rem;\n            margin-bottom: 1.5rem;\n            font-style: italic;\n            color: var(--color-cream);\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: linear-gradient(135deg, var(--color-teal-light), var(--color-copper));\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: white;\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n            color: var(--color-copper-shimmer);\n        }\n\n        .testimonial-role {\n            font-size: 0.85rem;\n            color: rgba(250, 248, 245, 0.7);\n        }\n\n        /* Differentials Section */\n        .differentials-section {\n            background: var(--color-cream-warm);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 2rem;\n        }\n\n        .differential-item {\n            text-align: center;\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .differential-item.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .differential-icon {\n            width: 70px;\n            height: 70px;\n            margin: 0 auto 1.5rem;\n            background: linear-gradient(135deg, var(--color-teal), var(--color-teal-light));\n            border-radius: var(--radius-wave-1);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-size: 1.75rem;\n            position: relative;\n        }\n\n        .differential-icon::before {\n            content: '';\n            position: absolute;\n            inset: -5px;\n            border-radius: var(--radius-wave-1);\n            border: 2px solid var(--color-copper);\n            opacity: 0;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% {\n                opacity: 0;\n                transform: scale(1);\n            }\n            50% {\n                opacity: 0.5;\n                transform: scale(1.1);\n            }\n        }\n\n        .differential-item h3 {\n            margin-bottom: 0.75rem;\n            font-size: 1.15rem;\n        }\n\n        .differential-item p {\n            font-size: 0.95rem;\n        }\n\n        /* Contact Section */\n        .contact-section {\n            background: var(--color-off-white);\n        }\n\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: start;\n        }\n\n        .contact-info h3 {\n            margin-bottom: 1.5rem;\n            font-size: 1.75rem;\n        }\n\n        .contact-info p {\n            margin-bottom: 1rem;\n        }\n\n        .contact-details {\n            margin-top: 2rem;\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n            margin-bottom: 1.5rem;\n        }\n\n        .contact-item-icon {\n            width: 45px;\n            height: 45px;\n            background: rgba(26, 122, 110, 0.1);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-teal);\n            font-size: 1.2rem;\n        }\n\n        .contact-item-text {\n            font-size: 1rem;\n            color: var(--color-shadow);\n        }\n\n        .contact-form {\n            background: var(--color-cream);\n            padding: 2.5rem;\n            border-radius: var(--radius-wave-2);\n            box-shadow: 0 10px 40px rgba(26, 122, 110, 0.1);\n        }\n\n        .form-group {\n            margin-bottom: 1.5rem;\n        }\n\n        .form-group label {\n            display: block;\n            margin-bottom: 0.5rem;\n            font-weight: 600;\n            font-size: 0.9rem;\n        }\n\n        .form-group input,\n        .form-group select,\n        .form-group textarea {\n            width: 100%;\n            padding: 0.875rem 1rem;\n            border: 2px solid rgba(26, 122, 110, 0.2);\n            border-radius: 10px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            background: var(--color-off-white);\n            transition: var(--transition-fast);\n        }\n\n        .form-group input:focus,\n        .form-group select:focus,\n        .form-group textarea:focus {\n            outline: none;\n            border-color: var(--color-teal);\n            background: var(--color-cream);\n        }\n\n        .form-group textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1rem;\n            background: var(--color-teal);\n            color: var(--color-cream);\n            border: none;\n            border-radius: 50px;\n            font-family: var(--font-body);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-fast);\n        }\n\n        .form-submit:hover {\n            background: var(--color-teal-dark);\n            transform: translateY(-2px);\n            box-shadow: 0 6px 30px rgba(26, 122, 110, 0.3);\n        }\n\n        /* Footer */\n        .footer {\n            background: var(--color-shadow-dark);\n            color: var(--color-cream);\n            padding: 4rem 2rem 2rem;\n        }\n\n        .footer-content {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 3rem;\n            margin-bottom: 3rem;\n        }\n\n        .footer-section h4 {\n            color: var(--color-copper-shimmer);\n            margin-bottom: 1rem;\n            font-size: 1.1rem;\n        }\n\n        .footer-section p {\n            color: rgba(250, 248, 245, 0.8);\n            font-size: 0.95rem;\n        }\n\n        .footer-section a {\n            color: rgba(250, 248, 245, 0.8);\n            display: block;\n            margin-bottom: 0.5rem;\n            font-size: 0.95rem;\n        }\n\n        .footer-section a:hover {\n            color: var(--color-copper-shimmer);\n        }\n\n        .footer-bottom {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding-top: 2rem;\n            border-top: 1px solid rgba(250, 248, 245, 0.1);\n            text-align: center;\n            color: rgba(250, 248, 245, 0.6);\n            font-size: 0.85rem;\n        }\n\n        /* Mobile Responsive */\n        @media (max-width: 768px) {\n            .nav-links {\n                position: fixed;\n                top: 0;\n                left: 0;\n                right: 0;\n                bottom: 0;\n                background: var(--color-cream);\n                flex-direction: column;\n                align-items: center;\n                justify-content: center;\n                gap: 2rem;\n                transform: translateX(100%);\n                transition: transform 0.3s ease;\n            }\n\n            .nav-links.active {\n                transform: translateX(0);\n            }\n\n            .nav-toggle {\n                display: flex;\n                z-index: 1001;\n            }\n\n            .nav-cta {\n                display: none;\n            }\n\n            .hero {\n                padding: 8rem 1.5rem 3rem;\n            }\n\n            .hero h1 {\n                font-size: 2.5rem;\n            }\n\n            .hero p {\n                font-size: 1.1rem;\n            }\n\n            .section {\n                padding: 4rem 1.5rem;\n            }\n\n            .contact-grid {\n                grid-template-columns: 1fr;\n                gap: 3rem;\n            }\n\n            .blob-1, .blob-2, .blob-3, .blob-4 {\n                display: none;\n            }\n        }\n\n        /* Accessibility */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        /* Focus styles */\n        a:focus, button:focus, input:focus, select:focus, textarea:focus {\n            outline: 3px solid var(--color-copper);\n            outline-offset: 2px;\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <div class=\"nav-logo\">Dra Gel</div>\n            <ul class=\"nav-links\" id=\"navLinks\">\n                <li><a href=\"#home\">Início</a></li>\n                <li><a href=\"#services\">Serviços</a></li>\n                <li><a href=\"#testimonials\">Depoimentos</a></li>\n                <li><a href=\"#contact\">Contato</a></li>\n            </ul>\n            <a href=\"#contact\" class=\"nav-cta\">Agendar Consulta</a>\n            <div class=\"nav-toggle\" id=\"navToggle\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-blob blob-1\"></div>\n        <div class=\"hero-blob blob-2\"></div>\n        <div class=\"hero-blob blob-3\"></div>\n        <div class=\"hero-blob blob-4\"></div>\n        <div class=\"hero-content\">\n            <span class=\"hero-tag\">Harmonização Facial em Ribeirão Preto</span>\n            <h1>Realce sua Beleza Natural com Tratamentos Premium</h1>\n            <p>Atendimento especializado em harmonização facial e estética avançada. Resultados naturais que realçam sua beleza única.</p>\n            <a href=\"#contact\" class=\"hero-cta\">\n                <span>Agende sua Consulta</span>\n                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                    <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                </svg>\n            </a>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-section\" id=\"problem\">\n        <div class=\"container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Por Que Escolher a Dra Gel</span>\n                <h2>Sua Satisfação é Nossa Prioridade</h2>\n                <p>Compreendemos suas necessidades e oferecemos soluções personalizadas</p>\n            </div>\n            <div class=\"problem-grid\">\n                <div class=\"problem-card\" data-delay=\"0\">\n                    <div class=\"problem-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z\"/>\n                        </svg>\n                    </div>\n                    <h3>Atendimento Personalizado</h3>\n                    <p>Cada paciente é única. Desenvolvemos protocolos exclusivos para suas características e objetivos.</p>\n                </div>\n                <div class=\"problem-card\" data-delay=\"200\">\n                    <div class=\"problem-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L2 7l10 5 10-5-10-5z\"/>\n                            <path d=\"M2 17l10 5 10-5\"/>\n                            <path d=\"M2 12l10 5 10-5\"/>\n                        </svg>\n                    </div>\n                    <h3>Técnicas Avançadas</h3>\n                    <p>Utilizamos os procedimentos mais modernos e seguros do mercado estético.</p>\n                </div>\n                <div class=\"problem-card\" data-delay=\"400\">\n                    <div class=\"problem-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            <path d=\"M12 6v6l4 2\"/>\n                        </svg>\n                    </div>\n                    <h3>Resultados Naturais</h3>\n                    <p>Realçamos sua beleza natural com sutileza, mantendo sua harmonia e expressão.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services-section\" id=\"services\">\n        <div class=\"container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Nossos Serviços</span>\n                <h2>Tratamentos Especializados</h2>\n                <p>Procedimentos estéticos de alta qualidade para realçar sua beleza</p>\n            </div>\n            <div class=\"services-grid\">\n                <div class=\"service-card\" data-delay=\"0\">\n                    <div class=\"service-icon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M9 12l2 2 4-4\"/>\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                        </svg>\n                    </div>\n                    <h3>Harmonização Facial</h3>\n                    <p>Equilibre seus traços faciais com técnicas avançadas para resultados naturais e harmoniosos.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card\" data-delay=\"200\">\n                    <div class=\"service-icon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2v20M2 12h20\"/>\n                        </svg>\n                    </div>\n                    <h3>Toxina Botulínica</h3>\n                    <p>Suavize linhas de expressão e previna rugas com aplicações precisas e naturais.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card\" data-delay=\"400\">\n                    <div class=\"service-icon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/>\n                        </svg>\n                    </div>\n                    <h3>Preenchedores Faciais</h3>\n                    <p>Restaure volume e contorno facial com ácido hialurônico de alta qualidade.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card\" data-delay=\"0\">\n                    <div class=\"service-icon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 8v8M8 12h8\"/>\n                        </svg>\n                    </div>\n                    <h3>Preenchimento Labial</h3>\n                    <p>Realce seus lábios com técnicas que proporcionam volume natural e simetria perfeita.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card\" data-delay=\"200\">\n                    <div class=\"service-icon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z\"/>\n                            <path d=\"M12 6v6l4 2\"/>\n                        </svg>\n                    </div>\n                    <h3>Bioestimuladores</h3>\n                    <p>Estimule o colágeno natural da sua pele para rejuvenescimento progressivo e duradouro.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card\" data-delay=\"400\">\n                    <div class=\"service-icon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/>\n                        </svg>\n                    </div>\n                    <h3>Protocolos Exclusivos</h3>\n                    <p>Tratamentos personalizados desenvolvidos especialmente para suas necessidades.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials-section\" id=\"testimonials\">\n        <div class=\"container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Depoimentos</span>\n                <h2>O Que Nossas Pacientes Dizem</h2>\n                <p>Histórias reais de transformação e satisfação</p>\n            </div>\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card\" data-delay=\"0\">\n                    <div class=\"testimonial-stars\">\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"A Dra Gel é excepcional! Meu resultado ficou super natural e exatamente como eu queria. Recomendo muito!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div>\n                            <div class=\"testimonial-name\">Maria Clara</div>\n                            <div class=\"testimonia