  --font-body: 'Manrope', sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Diamond-Ellipse Border Radius */\n            --radius-diamond-1: 70% 30% 50% 50% / 50% 40% 60% 50%;\n            --radius-diamond-2: 50% 50% 30% 70% / 40% 60% 40% 60%;\n            --radius-diamond-3: 60% 40% 55% 45% / 45% 55% 45% 55%;\n            --radius-diamond-4: 45% 55% 40% 60% / 55% 45% 55% 45%;\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background-color: var(--color-ivory);\n            color: var(--color-shadow);\n            line-height: 1.6;\n            overflow-x: hidden;\n        }\n\n        /* Typography */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-shadow);\n        }\n\n        h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); }\n        h2 { font-size: clamp(2rem, 4vw, 3rem); }\n        h3 { font-size: clamp(1.5rem, 3vw, 2rem); }\n\n        p {\n            font-size: 1.1rem;\n            color: var(--color-shadow-light);\n            line-height: 1.8;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-fast);\n        }\n\n        /* Navigation */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: 1rem 2rem;\n            background: rgba(250, 248, 245, 0.95);\n            backdrop-filter: blur(10px);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav.visible {\n            transform: translateY(0);\n            box-shadow: 0 2px 20px rgba(42, 37, 37, 0.1);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-deep-rose);\n        }\n\n        .nav-links {\n            display: flex;\n            gap: 2rem;\n            list-style: none;\n        }\n\n        .nav-links a {\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-shadow);\n            position: relative;\n        }\n\n        .nav-links a::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-rose-gold);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-links a:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.75rem 1.5rem;\n            background: var(--color-rose-gold);\n            color: var(--color-ivory);\n            border-radius: 50px;\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            background: var(--color-rose-gold-dark);\n            transform: translateY(-2px);\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 4px;\n            cursor: pointer;\n        }\n\n        .nav-toggle span {\n            width: 24px;\n            height: 2px;\n            background: var(--color-shadow);\n            transition: var(--transition-fast);\n        }\n\n        /* Hero Section */\n        .hero {\n            position: relative;\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            padding: 6rem 2rem 4rem;\n            overflow: hidden;\n            background: linear-gradient(135deg, var(--color-ivory) 0%, var(--color-champagne-light) 100%);\n        }\n","numLines":200,"startLine":1,"totalLines":1492}}}
