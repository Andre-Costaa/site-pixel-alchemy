{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_63d5ec1d45aa4483b413a51f","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/botolifting-clinica-de-estetica-avancada/index.html"}]},"parent_tool_use_id":null,"session_id":"8a88afe2-047f-48b8-a09a-6bd13c64e361","uuid":"af38728f-c708-48fc-885b-53b48e2441e0","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/botolifting-clinica-de-estetica-avancada/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Botolifting | Clínica de Estética Avançada - Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Botolifting - Clínica de Estética Avançada em Ribeirão Preto. Atendimento especializado em harmonização facial e estética avançada. Transforme sua aparência com tratamentos personalizados.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            /* Champagne Noir & Rose Gold Palette - NEW UNIQUE PALETTE */\n            --color-champagne: #D4A872;\n            --color-champagne-light: #E8C898;\n            --color-champagne-dark: #B89060;\n            --color-champagne-deep: #987848;\n            --color-champagne-shimmer: #F5E8D0;\n\n            --color-rose-gold: #C8909C;\n            --color-rose-gold-light: #D8A8AC;\n            --color-rose-gold-dark: #A87884;\n            --color-rose-gold-deep: #885868;\n            --color-rose-gold-mist: #F0E0E4;\n\n            --color-pearl: #FAFAF8;\n            --color-pearl-warm: #F5F5F0;\n            --color-pearl-soft: #F0F0E8;\n\n            --color-noir: #1A1A1A;\n            --color-noir-deep: #0F0F12;\n            --color-charcoal: #2A2828;\n            --color-charcoal-dark: #1A1818;\n\n            /* Gradients */\n            --gradient-champagne: linear-gradient(135deg, var(--color-champagne) 0%, var(--color-champagne-light) 50%, var(--color-rose-gold) 100%);\n            --gradient-champagne-soft: linear-gradient(135deg, var(--color-champagne-shimmer) 0%, var(--color-pearl) 100%);\n            --gradient-rose-gold: linear-gradient(135deg, var(--color-rose-gold) 0%, var(--color-rose-gold-light) 100%);\n\n            /* Typography */\n            --font-display: 'Playfair Display', Georgia, serif;\n            --font-body: 'Plus Jakarta Sans', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 1.5rem;\n            --spacing-lg: 2rem;\n            --spacing-xl: 3rem;\n            --spacing-2xl: 4rem;\n            --spacing-3xl: 6rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 12px;\n            --radius-lg: 20px;\n            --radius-bubble-1: 65% 35% 55% 45% / 50% 45% 55% 50%;\n            --radius-bubble-2: 45% 55% 40% 60% / 55% 45% 55% 45%;\n            --radius-bubble-3: 55% 45% 60% 40% / 40% 60% 40% 60%;\n            --radius-bubble-4: 40% 60% 45% 55% / 60% 40% 60% 40%;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.3s ease;\n            --transition-slow: 0.5s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(212, 168, 114, 0.08);\n            --shadow-md: 0 4px 16px rgba(212, 168, 114, 0.12);\n            --shadow-lg: 0 8px 32px rgba(212, 168, 114, 0.16);\n            --shadow-rose-gold: 0 4px 20px rgba(200, 144, 156, 0.15);\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background-color: var(--color-pearl);\n            color: var(--color-charcoal);\n            line-height: 1.6;\n            overflow-x: hidden;\n        }\n\n        /* Typography */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-charcoal-dark);\n        }\n\n        h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); }\n        h2 { font-size: clamp(2rem, 4vw, 3rem); }\n        h3 { font-size: clamp(1.25rem, 2.5vw, 1.75rem); }\n\n        p {\n            font-size: clamp(0.95rem, 1.2vw, 1.1rem);\n            color: var(--color-charcoal);\n            opacity: 0.85;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* Navigation */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-md) var(--spacing-lg);\n            background: rgba(250, 250, 248, 0.95);\n            backdrop-filter: blur(10px);\n            border-bottom: 1px solid rgba(212, 168, 114, 0.1);\n            transition: transform 0.3s ease, padding 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-champagne-dark);\n        }\n\n        .nav-links {\n            display: flex;\n            gap: var(--spacing-lg);\n            list-style: none;\n        }\n\n        .nav-links a {\n            font-weight: 500;\n            font-size: 0.95rem;\n            color: var(--color-charcoal);\n            position: relative;\n        }\n\n        .nav-links a::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-champagne);\n            transition: width var(--transition-base);\n        }\n\n        .nav-links a:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.6rem 1.4rem;\n            background: var(--gradient-champagne);\n            color: white;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            transition: var(--transition-base);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-rose-gold);\n        }\n\n        .nav-menu-btn {\n            display: none;\n            background: none;\n            border: none;\n            font-size: 1.5rem;\n            cursor: pointer;\n            color: var(--color-champagne-dark);\n        }\n\n        /* Mobile Menu */\n        .nav-mobile {\n            display: none;\n            position: fixed;\n            top: 70px;\n            left: 0;\n            right: 0;\n            background: var(--color-pearl);\n            padding: var(--spacing-lg);\n            border-bottom: 1px solid rgba(212, 168, 114, 0.1);\n            z-index: 999;\n        }\n\n        .nav-mobile.active {\n            display: block;\n        }\n\n        .nav-mobile-links {\n            list-style: none;\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-md);\n        }\n\n        .nav-mobile-links a {\n            font-weight: 500;\n            padding: var(--spacing-sm) 0;\n            border-bottom: 1px solid rgba(212, 168, 114, 0.1);\n        }\n\n        /* Hero Section */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            padding: var(--spacing-3xl) var(--spacing-lg);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .hero-blobs {\n            position: absolute;\n            inset: 0;\n            overflow: hidden;\n            z-index: 0;\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-bubble-1);\n            filter: blur(60px);\n            opacity: 0.4;\n            animation: bubbleFloat 20s ease-in-out infinite;\n        }\n\n        .hero-blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-champagne);\n            top: -150px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .hero-blob-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-rose-gold);\n            bottom: -100px;\n            left: -100px;\n            animation-delay: 5s;\n        }\n\n        .hero-blob-3 {\n            width: 300px;\n            height: 300px;\n            background: var(--color-champagne-shimmer);\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: 10s;\n        }\n\n        .hero-blob-4 {\n            width: 350px;\n            height: 350px;\n            background: linear-gradient(135deg, var(--color-rose-gold-light) 0%, var(--color-champagne-light) 100%);\n            bottom: 20%;\n            right: 10%;\n            animation-delay: 15s;\n        }\n\n        @keyframes bubbleFloat {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n                border-radius: var(--radius-bubble-1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg) scale(1.05);\n                border-radius: var(--radius-bubble-2);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg) scale(0.95);\n                border-radius: var(--radius-bubble-3);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(3deg) scale(1.02);\n                border-radius: var(--radius-bubble-4);\n            }\n        }\n\n        .hero-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-3xl);\n            align-items: center;\n            position: relative;\n            z-index: 1;\n        }\n\n        .hero-content {\n            opacity: 0;\n            animation: fadeUp 0.8s ease forwards;\n            animation-delay: 0ms;\n        }\n\n        .hero-badge {\n            display: inline-block;\n            padding: 0.5rem 1rem;\n            background: var(--gradient-champagne-soft);\n            color: var(--color-champagne-dark);\n            border-radius: var(--radius-lg);\n            font-weight: 600;\n            font-size: 0.85rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            color: var(--color-noir);\n        }\n\n        .hero-title span {\n            background: var(--gradient-champagne);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: 1.25rem;\n            margin-bottom: var(--spacing-lg);\n            color: var(--color-charcoal);\n        }\n\n        .hero-description {\n            margin-bottom: var(--spacing-xl);\n            max-width: 500px;\n        }\n\n        .hero-ctas {\n            display: flex;\n            gap: var(--spacing-md);\n            flex-wrap: wrap;\n        }\n\n        .btn-primary {\n            padding: 1rem 2rem;\n            background: var(--gradient-champagne);\n            color: white;\n            border: none;\n            border-radius: var(--radius-lg);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .btn-primary::before {\n            content: '';\n            position: absolute;\n            inset: 0;\n            background: var(--gradient-rose-gold);\n            opacity: 0;\n            transition: var(--transition-base);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-rose-gold);\n        }\n\n        .btn-primary:hover::before {\n            opacity: 1;\n        }\n\n        .btn-primary span {\n            position: relative;\n            z-index: 1;\n        }\n\n        .btn-secondary {\n            padding: 1rem 2rem;\n            background: transparent;\n            color: var(--color-champagne-dark);\n            border: 2px solid var(--color-champagne);\n            border-radius: var(--radius-lg);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-champagne-shimmer);\n            transform: translateY(-2px);\n        }\n\n        .hero-visual {\n            position: relative;\n            opacity: 0;\n            animation: fadeUp 0.8s ease forwards;\n            animation-delay: 200ms;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            border-radius: var(--radius-lg);\n            overflow: hidden;\n        }\n\n        .hero-image {\n            width: 100%;\n            height: auto;\n            display: block;\n            border-radius: var(--radius-lg);\n        }\n\n        .hero-floating-card {\n            position: absolute;\n            background: white;\n            padding: var(--spacing-md);\n            border-radius: var(--radius-md);\n            box-shadow: var(--shadow-lg);\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n            animation: floatCard 6s ease-in-out infinite;\n        }\n\n        .hero-floating-card-1 {\n            top: 10%;\n            left: -20px;\n        }\n\n        .hero-floating-card-2 {\n            bottom: 15%;\n            right: -20px;\n            animation-delay: 3s;\n        }\n\n        .floating-card-icon {\n            width: 40px;\n            height: 40px;\n            background: var(--gradient-champagne);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            flex-shrink: 0;\n        }\n\n        .floating-card-text strong {\n            display: block;\n            font-size: 0.9rem;\n            color: var(--color-champagne-dark);\n        }\n\n        .floating-card-text span {\n            font-size: 0.75rem;\n            color: var(--color-charcoal);\n        }\n\n        @keyframes floatCard {\n            0%, 100% { transform: translateY(0); }\n            50% { transform: translateY(-10px); }\n        }\n\n        @keyframes fadeUp {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        /* Section Styles */\n        .section {\n            padding: var(--spacing-3xl) var(--spacing-lg);\n        }\n\n        .section-header {\n            text-align: center;\n            max-width: 700px;\n            margin: 0 auto var(--spacing-2xl);\n        }\n\n        .section-badge {\n            display: inline-block;\n            padding: 0.5rem 1rem;\n            background: var(--gradient-champagne-soft);\n            color: var(--color-champagne-dark);\n            border-radius: var(--radius-lg);\n            font-weight: 600;\n            font-size: 0.85rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .section-title {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .section-description {\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        /* Problem/Solution Section */\n        .problem-solution {\n            background: var(--color-pearl-warm);\n        }\n\n        .problem-solution-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-2xl);\n        }\n\n        .problem-card, .solution-card {\n            background: white;\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            position: relative;\n            overflow: hidden;\n            transition: var(--transition-base);\n        }\n\n        .problem-card {\n            border-left: 4px solid var(--color-rose-gold);\n        }\n\n        .solution-card {\n            border-left: 4px solid var(--color-champagne);\n        }\n\n        .problem-card:hover, .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .card-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-champagne-soft);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-md);\n            font-size: 1.5rem;\n        }\n\n        .problem-card .card-icon {\n            background: linear-gradient(135deg, #F0E0E4 0%, #F5E8D0 100%);\n        }\n\n        .card-title {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-noir);\n        }\n\n        .card-list {\n            list-style: none;\n            margin-top: var(--spacing-md);\n        }\n\n        .card-list li {\n            padding: var(--spacing-sm) 0;\n            padding-left: var(--spacing-lg);\n            position: relative;\n        }\n\n        .card-list li::before {\n            content: '✓';\n            position: absolute;\n            left: 0;\n            color: var(--color-champagne);\n            font-weight: 700;\n        }\n\n        .problem-list li::before {\n            color: var(--color-rose-gold);\n        }\n\n        /* Services Section */\n        .services-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .service-card {\n            background: white;\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .service-card.visible {\n            opacity: 1;\n            transform: translateY(0);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-champagne);\n            opacity: 0;\n            transition: var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            opacity: 1;\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-champagne);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-md);\n            font-size: 1.5rem;\n            color: white;\n        }\n\n        .service-title {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-noir);\n        }\n\n        .service-description {\n            margin-bottom: var(--spacing-md);\n            font-size: 0.95rem;\n        }\n\n        .service-link {\n            color: var(--color-champagne-dark);\n            font-weight: 600;\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n        }\n\n        .service-link:hover {\n            color: var(--color-rose-gold);\n        }\n\n        /* Testimonials Section */\n        .testimonials {\n            background: var(--color-noir);\n            color: white;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .testimonials::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            background: radial-gradient(ellipse at top right, var(--color-champagne) 0%, transparent 50%);\n            opacity: 0.1;\n        }\n\n        .testimonials .section-title {\n            color: white;\n        }\n\n        .testimonials .section-description {\n            color: rgba(255, 255, 255, 0.8);\n        }\n\n        .testimonials-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n            position: relative;\n            z-index: 1;\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(10px);\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            border: 1px solid rgba(212, 168, 114, 0.2);\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .testimonial-card.visible {\n            opacity: 1;\n            transform: translateY(0);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .testimonial-stars {\n            color: var(--color-champagne);\n            margin-bottom: var(--spacing-md);\n            font-size: 1.2rem;\n        }\n\n        .testimonial-text {\n            color: rgba(255, 255, 255, 0.9);\n            margin-bottom: var(--spacing-md);\n            font-style: italic;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 45px;\n            height: 45px;\n            border-radius: 50%;\n            background: var(--gradient-champagne);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-weight: 600;\n            font-size: 0.9rem;\n        }\n\n        .testimonial-info strong {\n            display: block;\n            font-size: 0.95rem;\n            color: white;\n        }\n\n        .testimonial-info span {\n            font-size: 0.85rem;\n            color: rgba(255, 255, 255, 0.7);\n        }\n\n        /* Differentials Section */\n        .differentials {\n            background: var(--color-pearl-warm);\n        }\n\n        .differentials-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .differential-item {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-md);\n            padding: var(--spacing-lg);\n            background: white;\n            border-radius: var(--radius-lg);\n            transition: var(--transition-base);\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .differential-item.visible {\n            opacity: 1;\n            transform: translateY(0);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .differential-item:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-md);\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            flex-shrink: 0;\n        }\n\n        .differential-icon {\n            width: 55px;\n            height: 55px;\n            background: var(--gradient-champagne);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-size: 1.3rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .differential-icon-wrapper::after {\n            content: '';\n            position: absolute;\n            inset: -5px;\n            border-radius: var(--radius-md);\n            background: var(--gradient-champagne);\n            opacity: 0.2;\n            animation: pulseRing 2s ease-in-out infinite;\n        }\n\n        @keyframes pulseRing {\n            0%, 100% {\n                transform: scale(1);\n                opacity: 0.2;\n            }\n            50% {\n                transform: scale(1.1);\n                opacity: 0.1;\n            }\n        }\n\n        .differential-content h4 {\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-noir);\n        }\n\n        .differential-content p {\n            font-size: 0.9rem;\n        }\n\n        /* Contact Section */\n        .contact {\n            background: var(--color-pearl);\n        }\n\n        .contact-container {\n            max-width: 1000px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-2xl);\n        }\n\n        .contact-info {\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .contact-info.visible {\n            opacity: 1;\n            transform: translateY(0);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .contact-info-title {\n            margin-bottom: var(--spacing-md);\n            color: var(--color-noir);\n        }\n\n        .contact-info-description {\n            margin-bottom: var(--spacing-xl);\n        }\n\n        .contact-details {\n            list-style: none;\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-md);\n        }\n\n        .contact-detail {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-sm);\n        }\n\n        .contact-detail-icon {\n            width: 45px;\n            height: 45px;\n            background: var(--gradient-champagne-soft);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-champagne-dark);\n            flex-shrink: 0;\n        }\n\n        .contact-detail-text strong {\n            display: block;\n            font-size: 0.95rem;\n            color: var(--color-noir);\n            margin-bottom: 0.25rem;\n        }\n\n        .contact-detail-text span {\n            font-size: 0.9rem;\n            color: var(--color-charcoal);\n        }\n\n        .contact-form-wrapper {\n            background: white;\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-lg);\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .contact-form-wrapper.visible {\n            opacity: 1;\n            transform: translateY(0);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .contact-form {\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-md);\n        }\n\n        .form-group {\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-xs);\n        }\n\n        .form-group label {\n            font-weight: 600;\n            font-size: 0.9rem;\n            color: var(--color-noir);\n        }\n\n        .form-group input,\n        .form-group select,\n        .form-group textarea {\n            padding: 0.85rem;\n            border: 2px solid rgba(212, 168, 114, 0.2);\n            border-radius: var(--radius-md);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: var(--transition-base);\n            background: var(--color-pearl);\n        }\n\n        .form-group input:focus,\n        .form-group select:focus,\n        .form-group textarea:focus {\n            outline: none;\n            border-color: var(--color-champagne);\n            background: white;\n        }\n\n        .form-group textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .btn-submit {\n            padding: 1rem 2rem;\n            background: var(--gradient-champagne);\n            color: white;\n            border: none;\n            border-radius: var(--radius-lg);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n            margin-top: var(--spacing-sm);\n        }\n\n        .btn-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-rose-gold);\n        }\n\n        /* Footer */\n        .footer {\n            background: var(--color-noir);\n            color: white;\n            padding: var(--spacing-2xl) var(--spacing-lg) var(--spacing-lg);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: var(--spacing-2xl);\n            margin-bottom: var(--spacing-xl);\n        }\n\n        .footer-brand .footer-logo {\n            font-family: var(--font-display);\n            font-size: 1.75rem;\n            font-weight: 700;\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-champagne-light);\n        }\n\n        .footer-brand p {\n            color: rgba(255, 255, 255, 0.7);\n            max-width: 300px;\n        }\n\n        .footer-title {\n            font-family: var(--font-display);\n            font-size: 1.1rem;\n            margin-bottom: var(--spacing-md);\n            color: var(--color-champagne-light);\n        }\n\n        .footer-links {\n            list-style: none;\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-sm);\n        }\n\n        .footer-links a {\n            color: rgba(255, 255, 255, 0.8);\n            font-size: 0.95rem;\n            transition: var(--transition-base);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-champagne-light);\n            padding-left: 5px;\n        }\n\n        .footer-bottom {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding-top: var(--spacing-lg);\n            border-top: 1px solid rgba(212, 168, 114, 0.2);\n            text-align: center;\n            color: rgba(255, 255, 255, 0.6);\n            font-size: 0.9rem;\n        }\n\n        /* Animations */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        /* Responsive Design */\n        @media (max-width: 1024px) {\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-description {\n                margin-left: auto;\n                margin-right: auto;\n            }\n\n            .hero-ctas {\n                justify-content: center;\n            }\n\n            .hero-visual {\n                display: none;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .contact-container {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .footer-brand p {\n                margin: 0 auto;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-links {\n                display: none;\n            }\n\n            .nav-menu-btn {\n                display: block;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .problem-solution-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .hero {\n                padding: var(--spacing-2xl) var(--spacing-md);\n            }\n\n            .section {\n                padding: var(--spacing-2xl) var(--spacing-md);\n            }\n        }\n\n        @media (max-width: 480px) {\n            .hero-ctas {\n                flex-direction: column;\n                width: 100%;\n            }\n\n            .btn-primary, .btn-secondary {\n                width: 100%;\n                justify-content: center;\n            }\n        }\n\n        /* Reduced Motion */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Botolifting</a>\n            <ul class=\"nav-links\">\n                <li><a href=\"#inicio\">Início</a></li>\n                <li><a href=\"#servicos\">Serviços</a></li>\n                <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                <li><a href=\"#diferenciais\">Diferenciais</a></li>\n                <li><a href=\"#contato\" class=\"nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <button class=\"nav-menu-btn\" id=\"navMenuBtn\">☰</button>\n        </div>\n    </nav>\n\n    <!-- Mobile Menu -->\n    <div class=\"nav-mobile\" id=\"navMobile\">\n        <ul class=\"nav-mobile-links\">\n            <li><a href=\"#inicio\">Início</a></li>\n            <li><a href=\"#servicos\">Serviços</a></li>\n            <li><a href=\"#depoimentos\">Depoimentos</a></li>\n            <li><a href=\"#diferenciais\">Diferenciais</a></li>\n            <li><a href=\"#contato\">Agendar Consulta</a></li>\n        </ul>\n    </div>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-blobs\">\n            <div class=\"hero-blob hero-blob-1\"></div>\n            <div class=\"hero-blob hero-blob-2\"></div>\n            <div class=\"hero-blob hero-blob-3\"></div>\n            <div class=\"hero-blob hero-blob-4\"></div>\n        </div>\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <span class=\"hero-badge\">✨ Clínica de Estética Avançada</span>\n                <h1 class=\"hero-title\">\n                    Sua <span>Beleza</span> Elevada ao Mais Alto Padrão\n                </h1>\n                <p class=\"hero-subtitle\">Botolifting - Especialistas em Harmonização Facial em Ribeirão Preto</p>\n                <p class=\"hero-description\">\n                    Descubra uma versão mais confiante e radiante de si mesma. Nossa equipe de especialistas oferece tratamentos personalizados de estética avançada com resultados naturais e sofisticados.\n                </p>\n                <div class=\"hero-ctas\">\n                    <a href=\"#contato\" class=\"btn-primary\">\n                        <span>Agendar Consulta</span>\n                        <span>→</span>\n                    </a>\n                    <a href=\"#servicos\" class=\"btn-secondary\">\n                        <span>Conhecer Serviços</span>\n                    </a>\n                </div>\n            </div>\n            <div class=\"hero-visual\">\n                <div class=\"hero-image-wrapper\">\n                    <img src=\"https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=600&h=750&fit=crop\" alt=\"Tratamentos estéticos faciais avançados\" class=\"hero-image\">\n                </div>\n                <div class=\"hero-floating-card hero-floating-card-1\">\n                    <div class=\"floating-card-icon\">✓</div>\n                    <div class=\"floating-card-text\">\n                        <strong>+5.000</strong>\n                        <span>Atendimentos Realizados</span>\n                    </div>\n                </div>\n                <div class=\"hero-floating-card hero-floating-card-2\">\n                    <div class=\"floating-card-icon\">⭐</div>\n                    <div class=\"floating-card-text\">\n                        <strong>4.9/5</strong>\n                        <span>Avaliação dos Clientes</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\">\n        <div class=\"section-header wow-fade-up\">\n            <span class=\"section-badge\">Transformação Real</span>\n            <h2 class=\"section-title\">Sua Insatisfação Encontra Solução</h2>\n            <p class=\"section-description\">Entendemos suas preocupações e oferecemos tratamentos que realmente funcionam.</p>\n        </div>\n        <div class=\"problem-solution-grid\">\n            <div class=\"problem-card wow-fade-up\" style=\"transition-delay: 200ms;\">\n                <div class=\"card-icon\">😔</div>\n                <h3 class=\"card-title\">O Que Te Preocupa</h3>\n                <p>Aspectos do rosto que te incomodam e afetam sua autoestima:</p>\n                <ul class=\"card-list problem-list\">\n                    <li>Sinais de envelhecimento facial precoce</li>\n                    <li>Perda de contorno e definição do rosto</li>\n                    <li>Rugas e linhas de expressão marcadas</li>\n                    <li>Assimetrias faciais que te incomodam</li>\n                    <li>Sensação de aparência cansada</li>\n                </ul>\n            </div>\n            <div class=\"solution-card wow-fade-up\" style=\"transition-delay: 400ms;\">\n                <div class=\"card-icon\">✨</div>\n                <h3 class=\"card-title\">Nossa Solução</h3>\n                <p>Tratamentos personalizados que transformam sua aparência:</p>\n                <ul class=\"card-list\">\n                    <li>Harmonização facial com resultados naturais</li>\n                    <li>Contorno facial definido e rejuvenescido</li>\n                    <li>Suavização de rugas e linhas de expressão</li>\n                    <li>Correção de assimetrias com precisão</li>\n                    <li>Aspecto descansado e revitalizado</li>\n                </ul>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"section-header wow-fade-up\">\n            <span class=\"section-badge\">Nossos Serviços</span>\n            <h2 class=\"section-title\">Tratamentos Especializados</h2>\n            <p class=\"section-description\">Oferecemos uma gama completa de procedimentos estéticos faciais com técnicas avançadas e produtos de qualidade.</p>\n        </div>\n        <div class=\"services-grid\">\n            <div class=\"service-card\" style=\"transition-delay: 0ms;\">\n                <div class=\"service-icon\">💉</div>\n                <h3 class=\"service-title\">Harmonização Facial</h3>\n                <p class=\"service-description\">Equilibre seus traços faciais com preenchedores e toxina botulínica para resultados naturais e harmônicos.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n            <div class=\"service-card\" style=\"transition-delay: 200ms;\">\n                <div class=\"service-icon\">✨</div>\n                <h3 class=\"service-title\">Toxina Botulínica</h3>\n                <p class=\"service-description\">Suavize rugas e linhas de expressão com aplicação precisa de toxina botulínica para um visual rejuvenescido.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n            <div class=\"service-card\" style=\"transition-delay: 400ms;\">\n                <div class=\"service-icon\">💊</div>\n                <h3 class=\"service-title\">Preenchedores Faciais</h3>\n                <p class=\"service-description\">Restaure volume e contorno facial com preenchedores de ácido hialurônico de alta qualidade.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n            <div class=\"service-card\" style=\"transition-delay: 0ms;\">\n                <div class=\"service-icon\">👄</div>\n                <h3 class=\"service-title\">Preenchimento Labial</h3>\n                <p class=\"service-description\">Aumente o volume dos lábios e defina o contorno com técnicas que proporcionam resultados naturais.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n            <div class=\"service-card\" style=\"transition-delay: 200ms;\">\n                <div class=\"service-icon\">🔬</div>\n                <h3 class=\"service-title\">Bioestimuladores</h3>\n                <p class=\"service-description\">Estimule a produção de colágeno natural para uma pele mais firme, jovem e saudável.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n            <div class=\"service-card\" style=\"transition-delay: 400ms;\">\n                <div class=\"service-icon\">⭐</div>\n                <h3 class=\"service-title\">Protocolos Exclusivos</h3>\n                <p class=\"service-description\">Tratamentos personalizados combinando técnicas avançadas para resultados únicos e excepcionais.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"section-header wow-fade-up\">\n            <span class=\"section-badge\" style=\"background: rgba(212, 168, 114, 0.2); color: var(--color-champagne-light);\">Depoimentos</span>\n            <h2 class=\"section-title\">O Que Nossas Clientes Dizem</h2>\n            <p class=\"section-description\">Histórias reais de transformação e satisfação com nossos tratamentos.</p>\n        </div>\n        <div class=\"testimonials-grid\">\n            <div class=\"testimonial-card\" style=\"transition-delay: 0ms;\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"Simplesmente incrível! O resultado da harmonização facial superou minhas expectativas. Profissionais extremamente qualificados e atenciosos.\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">MC</div>\n                    <div class=\"testimonial-info\">\n                        <strong>Marina Costa</strong>\n                        <span>Empresária</span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"testimonial-card\" style=\"transition-delay: 200ms;\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"Finalmente encontrei uma clínica que entrega o que promete. Meus lábios ficaram perfeitos, muito naturais. Super recomendo!\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">AL</div>\n                    <div class=\"testimonial-info\">\n                        <strong>Ana Luíza</strong>\n                        <span>Advogada</span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"testimonial-card\" style=\"transition-delay: 400ms;\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"O atendimento é impecável do início ao fim. Fizeram minha autoestima voltar às alturas. Gratidão eterna à equipe Botolifting!\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">PS</div>\n                    <div class=\"testimonial-info\">\n                        <strong>Patrícia Silva</strong>\n                        <span>Professora</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\" id=\"diferenciais\">\n        <div class=\"section-header wow-fade-up\">\n            <span class=\"section-badge\">Por Que Nos Escolher</span>\n            <h2 class=\"section-title\">Nossos Diferenciais</h2>\n            <p class=\"section-description\">O que nos torna referência em estética avançada em Ribeirão Preto.</p>\n        </div>\n        <div class=\"differentials-grid\">\n            <div class=\"differential-item\" style=\"transition-delay: 0ms;\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">👨‍⚕️</div>\n                </div>\n                <div class=\"differential-content\">\n                    <h4>Equipe Especializada</h4>\n                    <p>Profissionais qualificados com anos de experiência em estética avançada.</p>\n                </div>\n            </div>\n            <div class=\"differential-item\" style=\"transition-delay: 200ms;\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">🏆</div>\n                </div>\n                <div class=\"differential-content\">\n                    <h4>Técnicas Avançadas</h4>\n                    <p>Utilizamos os procedimentos mais modernos e eficazes do mercado.</p>\n                </div>\n            </div>\n            <div class=\"differential-item\" style=\"transition-delay: 400ms;\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">✓</div>\n                </div>\n                <div class=\"differential-content\">\n                    <h4>Resultados Naturais</h4>\n                    <p>Foco em enhancements sutis que ressaltam sua beleza natural.</p>\n                </div>\n            </div>\n            <div class=\"differential-item\" style=\"transition-delay: 0ms;\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">🔒</div>\n                </div>\n                <div class=\"differential-content\">\n                    <h4>Produtos Certificados</h4>\n                    <p>Utilizamos apenas produtos de origem comprovada e qualidade.</p>\n                </div>\n            </div>\n            <div class=\"differential-item\" style=\"transition-delay: 200ms;\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">💝</div>\n                </div>\n                <div class=\"differential-content\">\n                    <h4>Acompanhamento Completo</h4>\n                    <p>Suporte total antes, durante e após cada procedimento realizado.</p>\n                </div>\n            </div>\n            <div class=\"differential-item\" style=\"transition-delay: 400ms;\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon\">💰</div>\n                </div>\n                <div class=\"differential-content\">\n                    <h4>Investimento Justo</h4>\n                    <p>Preços transparentes e acessíveis para各种 procedimentos estéticos.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"contact-container\">\n            <div class=\"contact-info\">\n                <h3 class=\"contact-info-title\">Agende Sua Consulta</h3>\n                <p class=\"contact-info-description\">Entre em contato para agendar sua avaliação personalizada. Estamos prontos para transformar sua aparência.</p>\n                <ul class=\"contact-details\">\n                    <li class=\"contact-detail\">\n                        <div class=\"contact-detail-icon\">📍</div>\n                        <div class=\"contact-detail-text\">\n                            <strong>Endereço</strong>\n                            <span>Av. Sen. César Vergueiro, 1027 - Jardim Irajá, Ribeirão Preto - SP, 14020-500</span>\n                        </div>\n                    </li>\n                    <li class=\"contact-detail\">\n                        <div class=\"contact-detail-icon\">📞</div>\n                        <div class=\"contact-detail-text\">\n                            <strong>Telefone</strong>\n                            <span>(16) 3325-7725</span>\n                        </div>\n                    </li>\n                    <li class=\"contact-detail\">\n                        <div class=\"contact-detail-icon\">⏰</div>\n                        <div class=\"contact-detail-text\">\n                            <strong>Horário</strong>\n                            <span>Segunda a Sexta: 9h às 19h<br>Sábado: 9h às 14h</span>\n                        </div>\n                    </li>\n                </ul>\n            </div>\n            <div class=\"contact-form-wrapper\">\n                <form class=\"contact-form\" id=\"contactForm\">\n                    <div class=\"form-group\">\n                        <label for=\"name\">Nome Completo</label>\n                        <input type=\"text\" id=\"name\" name=\"name\" required placeholder=\"Seu nome\">\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"email\">E-mail</label>\n                        <input type=\"email\" id=\"email\" name=\"email\" required placeholder=\"seu@email.com\">\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"service\">Serviço de Interesse</label>\n                        <select id=\"service\" name=\"service\" required>\n                            <option value=\"\">Selecione um serviço</option>\n                            <option value=\"harmonizacao\">Harmonização Facial</option>\n                            <option value=\"botox\">Toxina Botulínica</option>\n                            <option value=\"preenchedores\">Preenchedores Faciais</option>\n                            <option value=\"labios\">Preenchimento Labial</option>\n                            <option value=\"bioestimuladores\">Bioestimuladores</option>\n                            <option value=\"protocolos\">Protocolos Exclusivos</option>\n                            <option value=\"avaliacao\">Avaliação Geral</option>\n                        </select>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"message\">Mensagem</label>\n                        <textarea id=\"message\" name=\"message\" required placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                    </div>\n                    <button type=\"submit\" class=\"btn-submit\">\n                        <span>Enviar Mensagem</span>\n                        <span>→</span>\n                    </button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-brand\">\n                <div class=\"footer-logo\">Botolifting</div>\n                <p>Clínica de Estética Avançada especializada em harmonização facial e tratamentos estéticos em Ribeirão Preto.</p>\n            </div>\n            <div class=\"footer-column\">\n                <h4 class=\"footer-title\">Links Rápidos</h4>\n                <ul class=\"footer-links\">\n                    <li><a href=\"#inicio\">Início</a></li>\n                    <li><a href=\"#servicos\">Serviços</a></li>\n                    <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                    <li><a href=\"#diferenciais\">Diferenciais</a></li>\n                    <li><a href=\"#contato\">Contato</a></li>\n                </ul>\n            </div>\n            <div class=\"footer-column\">\n                <h4 class=\"footer-title\">Contato</h4>\n                <ul class=\"footer-links\">\n                    <li><a href=\"tel:+551633257725\">(16) 3325-7725</a></li>\n                    <li><a href=\"https://wa.me/551633257725\">WhatsApp</a></li>\n                    <li>Ribeirão Preto - SP</li>\n                </ul>\n            </div>\n        </div>\n        <div class=\"footer-bottom\">\n            <p>&copy; 2026 Botolifting - Clínica de Estética Avançada. Todos os direitos reservados.</p>\n        </div>\n    </footer>\n\n    <script>\n        // Navigation scroll effects\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                } else {\n                    nav.classList.remove('hidden');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Mobile menu toggle\n        const navMenuBtn = document.getElementById('navMenuBtn');\n        const navMobile = document.getElementById('navMobile');\n\n        navMenuBtn.addEventListener('click', () => {\n            navMobile.classList.toggle('active');\n            navMenuBtn.textContent = navMobile.classList.contains('active') ? '✕' : '☰';\n        });\n\n        // Close mobile menu on link click\n        document.querySelectorAll('.nav-mobile-links a').forEach(link => {\n            link.addEventListener('click', () => {\n                navMobile.classList.remove('active');\n                navMenuBtn.textContent = '☰';\n            });\n        });\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function (e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // Intersection Observer for animations\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('visible');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        // Observe all animated elements\n        document.querySelectorAll('.wow-fade-up, .service-card, .testimonial-card, .differential-item, .contact-info, .contact-form-wrapper').forEach(el => {\n            observer.observe(el);\n        });\n\n        // Contact form - WhatsApp integration\n        const contactForm = document.getElementById('contactForm');\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const email = document.getElementById('email').value;\n            const service = document.getElementById('service');\n            const serviceText = service.options[service.selectedIndex].text;\n            const message = document.getElementById('message').value;\n\n            const whatsappMessage = `Olá! Meu nome é ${name}.%0A%0A📧 Email: ${email}%0A%0A🎯 Serviço de interesse: ${serviceText}%0A%0A💬 Mensagem: ${message}%0A%0AAgostaria de agendar uma consulta.`;\n\n            const whatsappURL = `https://wa.me/551633257725?text=${whatsappMessage}`;\n\n            window.open(whatsappURL, '_blank');\n\n            // Reset form\n            contactForm.reset();\n        });\n\n        // Add active state to nav links based on scroll position\n        const sections = document.querySelectorAll('section[id]');\n\n        window.addEventListener('scroll', () => {\n            const scrollY = window.pageYOffset;\n\n            sections.forEach(section => {\n                const sectionHeight = section.offsetHeight;\n                const sectionTop = section.offsetTop - nav.offsetHeight - 100;\n                const sectionId = section.getAttribute('id');\n\n                if (scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {\n                    document.querySelectorAll('.nav-links a[href=\"#' + sectionId + '\"]').forEach(link => {\n                        link.style.color = 'var(--color-champagne-dark)';\n                    });\n                } else {\n                    document.querySelectorAll('.nav-links a[href=\"#' + sectionId + '\"]').forEach(link => {\n                        link.style.color = '';\n                    });\n                }\n            });\n        });\n    </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null}}
