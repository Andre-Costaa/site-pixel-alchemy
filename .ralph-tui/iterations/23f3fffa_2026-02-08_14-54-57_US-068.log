etElementById('navToggle');\n  1697→        const navMenu = document.getElementById('navMenu');\n  1698→        let lastScroll = 0;\n  1699→\n  1700→        // Auto-hide nav on scroll\n  1701→        window.addEventListener('scroll', () => {\n  1702→            const currentScroll = window.pageYOffset;\n  1703→\n  1704→            if (currentScroll > 100) {\n  1705→                if (currentScroll > lastScroll) {\n  1706→                    nav.classList.add('hidden');\n  1707→                } else {\n  1708→                    nav.classList.remove('hidden');\n  1709→                }\n  1710→            }\n  1711→\n  1712→            lastScroll = currentScroll;\n  1713→        });\n  1714→\n  1715→        // Mobile menu toggle\n  1716→        navToggle.addEventListener('click', () => {\n  1717→            navMenu.classList.toggle('active');\n  1718→            navToggle.classList.toggle('active');\n  1719→        });\n  1720→\n  1721→        // Close menu on link click\n  1722→        navMenu.querySelectorAll('a').forEach(link => {\n  1723→            link.addEventListener('click', () => {\n  1724→                navMenu.classList.remove('active');\n  1725→                navToggle.classList.remove('active');\n  1726→            });\n  1727→        });\n  1728→\n  1729→        // ============================================\n  1730→        // SMOOTH SCROLL\n  1731→        // ============================================\n  1732→        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n  1733→            anchor.addEventListener('click', function(e) {\n  1734→                e.preventDefault();\n  1735→                const target = document.querySelector(this.getAttribute('href'));\n  1736→                if (target) {\n  1737→                    const navHeight = nav.offsetHeight;\n  1738→                    const targetPosition = target.offsetTop - navHeight;\n  1739→                    window.scrollTo({\n  1740→                        top: targetPosition,\n  1741→                        behavior: 'smooth'\n  1742→                    });\n  1743→                }\n  1744→            });\n  1745→        });\n  1746→\n  1747→        // ============================================\n  1748→        // INTERSECTION OBSERVER FOR ANIMATIONS\n  1749→        // ============================================\n  1750→        const observerOptions = {\n  1751→            threshold: 0.1,\n  1752→            rootMargin: '0px 0px -50px 0px'\n  1753→        };\n  1754→\n  1755→        const observer = new IntersectionObserver((entries) => {\n  1756→            entries.forEach(entry => {\n  1757→                if (entry.isIntersecting) {\n  1758→                    entry.target.classList.add('visible');\n  1759→                    observer.unobserve(entry.target);\n  1760→                }\n  1761→            });\n  1762→        }, observerOptions);\n  1763→\n  1764→        document.querySelectorAll('.wow, .wow-fade-up').forEach(el => {\n  1765→            observer.observe(el);\n  1766→        });\n  1767→\n  1768→        // ============================================\n  1769→        // PARALLAX EFFECT ON BLOBS\n  1770→        // ============================================\n  1771→        const blobs = document.querySelectorAll('.blob');\n  1772→\n  1773→        document.addEventListener('mousemove', (e) => {\n  1774→            const mouseX = e.clientX / window.innerWidth - 0.5;\n  1775→            const mouseY = e.clientY / window.innerHeight - 0.5;\n  1776→\n  1777→            blobs.forEach((blob, index) => {\n  1778→                const speed = (index + 1) * 20;\n  1779→                const x = mouseX * speed;\n  1780→                const y = mouseY * speed;\n  1781→                blob.style.transform = `translate(${x}px, ${y}px)`;\n  1782→            });\n  1783→        });\n  1784→\n  1785→        // ============================================\n  1786→        // CONTACT FORM - WHATSAPP INTEGRATION\n  1787→        // ============================================\n  1788→        const contactForm = document.getElementById('contactForm');\n  1789→\n  1790→        contactForm.addEventListener('submit', (e) => {\n  1791→            e.preventDefault();\n  1792→\n  1793→            const name = document.getElementById('name').value;\n  1794→            const phone = document.getElementById('phone').value;\n  1795→            const service = document.getElementById('service').value;\n  1796→            const message = document.getElementById('message').value;\n  1797→\n  1798→            const whatsappMessage = `Olá Dr Brunno Rodrigues! Meu nome é ${name}.%0A%0A` +\n  1799→                `Telefone: ${phone}%0A` +\n  1800→                `Interesse: ${service}%0A%0A` +\n  1801→                `Mensagem: ${message}`;\n  1802→\n  1803→            const whatsappURL = `https://wa.me/5516991220511?text=${whatsappMessage}`;\n  1804→\n  1805→            window.open(whatsappURL, '_blank');\n  1806→        });\n  1807→\n  1808→        // ============================================\n  1809→        // REDUCED MOTION SUPPORT\n  1810→        // ============================================\n  1811→        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n  1812→\n  1813→        if (prefersReducedMotion.matches) {\n  1814→            blobs.forEach(blob => {\n  1815→                blob.style.animation = 'none';\n  1816→            });\n  1817→        }\n  1818→    </script>\n  1819→</body>\n  1820→</html>\n  1821→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"2d580528-34aa-4d7c-a124-48e357ef5700","uuid":"768e9a76-2165-463f-b510-a209d2634340","tool_use_result":{"type":"text","file":{"filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dr-brunno-rodrigues/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dr Brunno Rodrigues | Harmonização Facial e Estética Avançada em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dr Brunno Rodrigues - Atendimento especializado em harmonização facial e estética avançada em Ribeirão Preto. Transforme sua aparência com tratamentos premium.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           JADE NOIR & BRUSHED GOLD PALETTE\n           ============================================ */\n        :root {\n            /* Jade Colors */\n            --color-jade: #2A6B5A;\n            --color-jade-light: #3A8B7A;\n            --color-jade-mid: #4A9B8A;\n            --color-jade-dark: #1A4B3A;\n            --color-jade-deep: #0A2B1A;\n            --color-jade-mist: #E8F5F0;\n\n            /* Brushed Gold */\n            --color-gold: #B89858;\n            --color-gold-light: #C8A868;\n            --color-gold-mid: #D8B878;\n            --color-gold-dark: #A88048;\n            --color-gold-deep: #886038;\n            --color-gold-shimmer: #E8D8C0;\n\n            /* Backgrounds */\n            --color-rice-paper: #FAFAF8;\n            --color-rice-warm: #F5F5F2;\n            --color-rice-soft: #F0F0EC;\n            --color-ink-black: #1A1A1A;\n            --color-ink-deep: #0F0F12;\n            --color-charcoal: #2A2828;\n\n            /* Text */\n            --text-primary: #1A1A1A;\n            --text-secondary: #4A4848;\n            --text-muted: #6A6868;\n            --text-on-dark: #FAFAF8;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 1.5rem;\n            --spacing-lg: 2rem;\n            --spacing-xl: 3rem;\n            --spacing-2xl: 4rem;\n            --spacing-3xl: 6rem;\n\n            /* Border Radius - Jade Stone Shapes */\n            --radius-jade-1: 68% 32% 52% 48% / 52% 38% 62% 48%;\n            --radius-jade-2: 48% 52% 62% 38% / 42% 58% 42% 58%;\n            --radius-jade-3: 58% 42% 48% 52% / 52% 48% 52% 48%;\n            --radius-jade-4: 42% 58% 52% 48% / 48% 52% 48% 52%;\n            --radius-card: 12px;\n            --radius-button: 8px;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.3s ease;\n            --transition-slow: 0.5s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(42, 107, 90, 0.08);\n            --shadow-md: 0 4px 16px rgba(42, 107, 90, 0.12);\n            --shadow-lg: 0 8px 32px rgba(42, 107, 90, 0.16);\n            --shadow-gold: 0 4px 20px rgba(184, 152, 88, 0.25);\n        }\n\n        /* ============================================\n           RESET & BASE\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;\n            font-size: 16px;\n            line-height: 1.6;\n            color: var(--text-primary);\n            background-color: var(--color-rice-paper);\n            overflow-x: hidden;\n        }\n\n        h1, h2, h3, h4, h5, h6 {\n            font-family: 'Crimson Pro', Georgia, serif;\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--text-primary);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        img {\n            max-width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            background: rgba(250, 250, 248, 0.95);\n            backdrop-filter: blur(10px);\n            border-bottom: 1px solid rgba(42, 107, 90, 0.1);\n            transition: transform 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 1rem 1.5rem;\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n        }\n\n        .nav-logo {\n            font-family: 'Crimson Pro', serif;\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-jade);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: 2rem;\n            list-style: none;\n        }\n\n        .nav-link {\n            font-weight: 500;\n            font-size: 0.9rem;\n            color: var(--text-secondary);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-gold);\n            transition: width var(--transition-base);\n        }\n\n        .nav-link:hover {\n            color: var(--color-jade);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--color-jade);\n            color: white;\n            padding: 0.6rem 1.2rem;\n            border-radius: var(--radius-button);\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: all var(--transition-base);\n        }\n\n        .nav-cta:hover {\n            background: var(--color-jade-light);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-gold);\n        }\n\n        .nav-toggle {\n            display: none;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav-toggle span {\n            display: block;\n            width: 24px;\n            height: 2px;\n            background: var(--color-jade);\n            margin: 5px 0;\n            transition: var(--transition-base);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            position: relative;\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            padding: 100px 1.5rem 3rem;\n            overflow: hidden;\n        }\n\n        .hero-blobs {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n            z-index: 0;\n        }\n\n        .blob {\n            position: absolute;\n            border-radius: var(--radius-jade-1);\n            filter: blur(80px);\n            opacity: 0.4;\n            animation: float 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 500px;\n            height: 500px;\n            background: linear-gradient(135deg, var(--color-jade-light), var(--color-jade-mist));\n            top: -100px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .blob-2 {\n            width: 400px;\n            height: 400px;\n            background: linear-gradient(225deg, var(--color-gold-shimmer), var(--color-jade-mist));\n            bottom: -50px;\n            left: -50px;\n            animation-delay: -5s;\n            border-radius: var(--radius-jade-2);\n        }\n\n        .blob-3 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(45deg, var(--color-jade), var(--color-jade-light));\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: -10s;\n            border-radius: var(--radius-jade-3);\n        }\n\n        .blob-4 {\n            width: 250px;\n            height: 250px;\n            background: linear-gradient(180deg, var(--color-gold-light), var(--color-gold-shimmer));\n            top: 20%;\n            left: 10%;\n            animation-delay: -15s;\n            border-radius: var(--radius-jade-4);\n            opacity: 0.3;\n        }\n\n        @keyframes float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(90deg) scale(1.05);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(180deg) scale(0.95);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(270deg) scale(1.02);\n            }\n        }\n\n        .hero-container {\n            position: relative;\n            z-index: 1;\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: center;\n        }\n\n        .hero-content {\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease forwards;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            background: var(--color-jade-mist);\n            color: var(--color-jade);\n            padding: 0.5rem 1rem;\n            border-radius: 50px;\n            font-size: 0.85rem;\n            font-weight: 600;\n            margin-bottom: 1.5rem;\n        }\n\n        .hero-badge::before {\n            content: '';\n            width: 8px;\n            height: 8px;\n            background: var(--color-gold);\n            border-radius: 50%;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; }\n            50% { opacity: 0.5; }\n        }\n\n        .hero h1 {\n            font-size: clamp(2.5rem, 5vw, 4rem);\n            margin-bottom: 1.5rem;\n            color: var(--color-jade-dark);\n        }\n\n        .hero h1 span {\n            color: var(--color-gold);\n        }\n\n        .hero-subtitle {\n            font-size: 1.1rem;\n            color: var(--text-secondary);\n            margin-bottom: 2rem;\n            max-width: 500px;\n        }\n\n        .hero-cta {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 1rem;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 1.8rem;\n            border-radius: var(--radius-button);\n            font-weight: 600;\n            font-size: 0.95rem;\n            cursor: pointer;\n            transition: all var(--transition-base);\n            border: none;\n        }\n\n        .btn-primary {\n            background: var(--color-jade);\n            color: white;\n            box-shadow: var(--shadow-md);\n        }\n\n        .btn-primary:hover {\n            background: var(--color-jade-light);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-gold);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-jade);\n            border: 2px solid var(--color-jade);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-jade);\n            color: white;\n        }\n\n        .hero-image {\n            position: relative;\n            opacity: 0;\n            transform: translateX(30px);\n            animation: fadeInRight 0.8s ease 0.2s forwards;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            border-radius: var(--radius-jade-1);\n            overflow: hidden;\n            box-shadow: var(--shadow-lg);\n        }\n\n        .hero-image img {\n            width: 100%;\n            height: auto;\n            object-fit: cover;\n        }\n\n        .hero-image-accent {\n            position: absolute;\n            bottom: -20px;\n            left: -20px;\n            width: 150px;\n            height: 150px;\n            background: var(--color-gold);\n            border-radius: var(--radius-jade-3);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-family: 'Crimson Pro', serif;\n            font-size: 3rem;\n            font-weight: 700;\n            box-shadow: var(--shadow-gold);\n        }\n\n        @keyframes fadeInUp {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fadeInRight {\n            to {\n                opacity: 1;\n                transform: translateX(0);\n            }\n        }\n\n        /* ============================================\n           PROBLEM / SOLUTION SECTION\n           ============================================ */\n        .section {\n            padding: var(--spacing-3xl) 1.5rem;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-2xl);\n        }\n\n        .section-tag {\n            display: inline-block;\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-gold);\n            text-transform: uppercase;\n            letter-spacing: 2px;\n            margin-bottom: 1rem;\n        }\n\n        .section h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: 1rem;\n            color: var(--color-jade-dark);\n        }\n\n        .section-subtitle {\n            font-size: 1.1rem;\n            color: var(--text-secondary);\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        .problem-solution {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 3rem;\n            align-items: stretch;\n        }\n\n        .problem-card, .solution-card {\n            background: white;\n            padding: 2.5rem;\n            border-radius: var(--radius-card);\n            position: relative;\n            overflow: hidden;\n            transition: all var(--transition-base);\n        }\n\n        .problem-card {\n            border-left: 4px solid var(--color-jade-dark);\n        }\n\n        .solution-card {\n            border-left: 4px solid var(--color-gold);\n        }\n\n        .problem-card::before, .solution-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            right: 0;\n            width: 200px;\n            height: 200px;\n            border-radius: var(--radius-jade-1);\n            opacity: 0.05;\n            pointer-events: none;\n        }\n\n        .problem-card::before {\n            background: var(--color-jade);\n        }\n\n        .solution-card::before {\n            background: var(--color-gold);\n        }\n\n        .card-icon {\n            width: 60px;\n            height: 60px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            border-radius: 50%;\n            margin-bottom: 1.5rem;\n            font-size: 1.5rem;\n        }\n\n        .problem-card .card-icon {\n            background: var(--color-jade-mist);\n            color: var(--color-jade);\n        }\n\n        .solution-card .card-icon {\n            background: var(--color-gold-shimmer);\n            color: var(--color-gold-dark);\n        }\n\n        .problem-card h3, .solution-card h3 {\n            font-size: 1.5rem;\n            margin-bottom: 1rem;\n        }\n\n        .problem-card h3 {\n            color: var(--color-jade-dark);\n        }\n\n        .solution-card h3 {\n            color: var(--color-gold-dark);\n        }\n\n        .problem-list, .solution-list {\n            list-style: none;\n        }\n\n        .problem-list li, .solution-list li {\n            padding: 0.5rem 0;\n            padding-left: 1.5rem;\n            position: relative;\n            color: var(--text-secondary);\n        }\n\n        .problem-list li::before {\n            content: '×';\n            position: absolute;\n            left: 0;\n            color: var(--color-jade-dark);\n            font-weight: bold;\n        }\n\n        .solution-list li::before {\n            content: '✓';\n            position: absolute;\n            left: 0;\n            color: var(--color-gold);\n            font-weight: bold;\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            background: var(--color-rice-warm);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: 2rem;\n        }\n\n        .service-card {\n            background: white;\n            border-radius: var(--radius-card);\n            padding: 2rem;\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: linear-gradient(90deg, var(--color-jade), var(--color-gold));\n            transform: scaleX(0);\n            transform-origin: left;\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-icon {\n            width: 70px;\n            height: 70px;\n            background: linear-gradient(135deg, var(--color-jade), var(--color-jade-light));\n            border-radius: var(--radius-jade-1);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n            font-size: 1.8rem;\n        }\n\n        .service-card h3 {\n            font-size: 1.3rem;\n            margin-bottom: 0.8rem;\n            color: var(--color-jade-dark);\n        }\n\n        .service-card p {\n            color: var(--text-secondary);\n            margin-bottom: 1.5rem;\n            font-size: 0.95rem;\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-jade);\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: all var(--transition-fast);\n        }\n\n        .service-link:hover {\n            color: var(--color-gold);\n            gap: 0.8rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            background: var(--color-jade);\n            color: white;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .testimonials::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background: url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\");\n            opacity: 0.5;\n        }\n\n        .testimonials .section-tag {\n            color: var(--color-gold-shimmer);\n        }\n\n        .testimonials h2 {\n            color: white;\n        }\n\n        .testimonials .section-subtitle {\n            color: rgba(255, 255, 255, 0.8);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: 2rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.1);\n            backdrop-filter: blur(10px);\n            border-radius: var(--radius-card);\n            padding: 2rem;\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            transition: all var(--transition-base);\n        }\n\n        .testimonial-card:hover {\n            background: rgba(255, 255, 255, 0.15);\n            transform: translateY(-4px);\n        }\n\n        .testimonial-stars {\n            color: var(--color-gold);\n            font-size: 1.2rem;\n            margin-bottom: 1rem;\n        }\n\n        .testimonial-text {\n            font-size: 1rem;\n            line-height: 1.7;\n            margin-bottom: 1.5rem;\n            color: rgba(255, 255, 255, 0.95);\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: linear-gradient(135deg, var(--color-gold), var(--color-gold-light));\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 700;\n            color: var(--color-jade);\n        }\n\n        .testimonial-info h4 {\n            font-size: 1rem;\n            color: white;\n            margin-bottom: 0.2rem;\n        }\n\n        .testimonial-info p {\n            font-size: 0.85rem;\n            color: rgba(255, 255, 255, 0.7);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: 2rem;\n        }\n\n        .differential-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n            padding: 1.5rem;\n            border-radius: var(--radius-card);\n            transition: all var(--transition-base);\n        }\n\n        .differential-item:hover {\n            background: white;\n            box-shadow: var(--shadow-md);\n        }\n\n        .differential-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--color-jade-mist);\n            border-radius: var(--radius-jade-2);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n            position: relative;\n        }\n\n        .differential-icon::after {\n            content: '';\n            position: absolute;\n            top: -4px;\n            left: -4px;\n            right: -4px;\n            bottom: -4px;\n            border: 2px solid var(--color-gold);\n            border-radius: var(--radius-jade-2);\n            opacity: 0;\n            animation: pulse-ring 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse-ring {\n            0% {\n                transform: scale(1);\n                opacity: 0.5;\n            }\n            100% {\n                transform: scale(1.2);\n                opacity: 0;\n            }\n        }\n\n        .differential-content h3 {\n            font-size: 1.1rem;\n            margin-bottom: 0.5rem;\n            color: var(--color-jade-dark);\n        }\n\n        .differential-content p {\n            font-size: 0.9rem;\n            color: var(--text-secondary);\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            background: var(--color-rice-warm);\n        }\n\n        .contact-wrapper {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: start;\n        }\n\n        .contact-info h3 {\n            font-size: 1.8rem;\n            margin-bottom: 1rem;\n            color: var(--color-jade-dark);\n        }\n\n        .contact-info p {\n            color: var(--text-secondary);\n            margin-bottom: 2rem;\n        }\n\n        .contact-details {\n            display: flex;\n            flex-direction: column;\n            gap: 1.5rem;\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n        }\n\n        .contact-item-icon {\n            width: 45px;\n            height: 45px;\n            background: var(--color-jade);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            flex-shrink: 0;\n        }\n\n        .contact-item-content h4 {\n            font-size: 1rem;\n            margin-bottom: 0.3rem;\n        }\n\n        .contact-item-content p {\n            font-size: 0.95rem;\n            margin-bottom: 0;\n            color: var(--text-secondary);\n        }\n\n        .contact-form-wrapper {\n            background: white;\n            padding: 2.5rem;\n            border-radius: var(--radius-card);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .contact-form h4 {\n            font-size: 1.3rem;\n            margin-bottom: 1.5rem;\n            color: var(--color-jade-dark);\n        }\n\n        .form-group {\n            margin-bottom: 1.5rem;\n        }\n\n        .form-group label {\n            display: block;\n            font-weight: 600;\n            margin-bottom: 0.5rem;\n            color: var(--text-primary);\n            font-size: 0.9rem;\n        }\n\n        .form-group input,\n        .form-group select,\n        .form-group textarea {\n            width: 100%;\n            padding: 0.8rem 1rem;\n            border: 2px solid var(--color-rice-soft);\n            border-radius: var(--radius-button);\n            font-family: inherit;\n            font-size: 1rem;\n            transition: all var(--transition-fast);\n            background: var(--color-rice-paper);\n        }\n\n        .form-group input:focus,\n        .form-group select:focus,\n        .form-group textarea:focus {\n            outline: none;\n            border-color: var(--color-jade);\n            box-shadow: 0 0 0 3px rgba(42, 107, 90, 0.1);\n        }\n\n        .form-group textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            background: var(--color-jade);\n            color: white;\n            padding: 1rem;\n            border: none;\n            border-radius: var(--radius-button);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: all var(--transition-base);\n        }\n\n        .form-submit:hover {\n            background: var(--color-jade-light);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-gold);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--color-ink-black);\n            color: var(--color-rice-paper);\n            padding: 4rem 1.5rem 2rem;\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: 3rem;\n            margin-bottom: 3rem;\n        }\n\n        .footer-brand h3 {\n            font-size: 1.8rem;\n            color: white;\n            margin-bottom: 1rem;\n        }\n\n        .footer-brand p {\n            color: rgba(250, 250, 248, 0.7);\n            margin-bottom: 1.5rem;\n            max-width: 300px;\n        }\n\n        .footer-brand .logo-accent {\n            color: var(--color-gold);\n        }\n\n        .footer-links h4 {\n            color: white;\n            margin-bottom: 1rem;\n            font-size: 1.1rem;\n        }\n\n        .footer-links ul {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.8rem;\n        }\n\n        .footer-links a {\n            color: rgba(250, 250, 248, 0.7);\n            transition: color var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-gold);\n        }\n\n        .footer-bottom {\n            padding-top: 2rem;\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            flex-wrap: wrap;\n            gap: 1rem;\n        }\n\n        .footer-bottom p {\n            color: rgba(250, 250, 248, 0.6);\n            font-size: 0.9rem;\n        }\n\n        /* ============================================\n           SCROLL ANIMATIONS\n           ============================================ */\n        .wow {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(40px);\n            transition: opacity 0.8s ease, transform 0.8s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .stagger-1 { transition-delay: 0ms; }\n        .stagger-2 { transition-delay: 100ms; }\n        .stagger-3 { transition-delay: 200ms; }\n        .stagger-4 { transition-delay: 300ms; }\n        .stagger-5 { transition-delay: 400ms; }\n        .stagger-6 { transition-delay: 500ms; }\n\n        /* ============================================\n           RESPONSIVE\n           ============================================ */\n        @media (max-width: 1024px) {\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-content {\n                order: 2;\n            }\n\n            .hero-image {\n                order: 1;\n                max-width: 500px;\n                margin: 0 auto;\n            }\n\n            .hero-subtitle {\n                margin-left: auto;\n                margin-right: auto;\n            }\n\n            .hero-cta {\n                justify-content: center;\n            }\n\n            .problem-solution {\n                grid-template-columns: 1fr;\n            }\n\n            .contact-wrapper {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 0;\n                right: -100%;\n                width: 80%;\n                max-width: 300px;\n                height: 100vh;\n                background: white;\n                flex-direction: column;\n                padding: 80px 2rem 2rem;\n                gap: 1.5rem;\n                transition: right var(--transition-base);\n                box-shadow: -5px 0 20px rgba(0, 0, 0, 0.1);\n            }\n\n            .nav-menu.active {\n                right: 0;\n            }\n\n            .nav-toggle {\n                display: block;\n                z-index: 1001;\n            }\n\n            .nav-toggle.active span:nth-child(1) {\n                transform: rotate(45deg) translate(5px, 5px);\n            }\n\n            .nav-toggle.active span:nth-child(2) {\n                opacity: 0;\n            }\n\n            .nav-toggle.active span:nth-child(3) {\n                transform: rotate(-45deg) translate(5px, -5px);\n            }\n\n            .section {\n                padding: var(--spacing-xl) 1rem;\n            }\n\n            .services-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .testimonials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-content {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .footer-brand p {\n                margin-left: auto;\n                margin-right: auto;\n            }\n\n            .footer-bottom {\n                flex-direction: column;\n                text-align: center;\n            }\n\n            .hero-image-accent {\n                display: none;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .hero h1 {\n                font-size: 2rem;\n            }\n\n            .btn {\n                width: 100%;\n                justify-content: center;\n            }\n\n            .hero-cta {\n                flex-direction: column;\n            }\n        }\n\n        /* ============================================\n           ACCESSIBILITY\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n\n            html {\n                scroll-behavior: auto;\n            }\n        }\n\n        .skip-link {\n            position: absolute;\n            top: -40px;\n            left: 0;\n            background: var(--color-jade);\n            color: white;\n            padding: 8px 16px;\n            text-decoration: none;\n            z-index: 100;\n        }\n\n        .skip-link:focus {\n            top: 0;\n        }\n\n        button:focus, a:focus {\n            outline: 2px solid var(--color-gold);\n            outline-offset: 2px;\n        }\n    </style>\n</head>\n<body>\n    <a href=\"#main\" class=\"skip-link\">Pular para o conteúdo principal</a>\n\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dr Brunno Rodrigues</a>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#inicio\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#contato\" class=\"nav-link\">Contato</a></li>\n                <li><a href=\"#contato\" class=\"nav-cta\">Agendar</a></li>\n            </ul>\n            <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Menu\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-blobs\">\n            <div class=\"blob blob-1\"></div>\n            <div class=\"blob blob-2\"></div>\n            <div class=\"blob blob-3\"></div>\n            <div class=\"blob blob-4\"></div>\n        </div>\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge\">\n                    <span>Harmonização Facial em Ribeirão Preto</span>\n                </div>\n                <h1>Transforme sua aparência com <span>Dr Brunno Rodrigues</span></h1>\n                <p class=\"hero-subtitle\">Atendimento especializado em harmonização facial e estética avançada. Resultados naturais que realçam sua beleza única.</p>\n                <div class=\"hero-cta\">\n                    <a href=\"#contato\" class=\"btn btn-primary\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                            <path d=\"M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11zM9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm-8 4H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z\"/>\n                        </svg>\n                        Agendar Consulta\n                    </a>\n                    <a href=\"https://wa.me/5516991220511\" class=\"btn btn-secondary\" target=\"_blank\">\n                        <