                  </div>\n                    <div class=\"differential-content\">\n                        <h3>Atendimento Humanizado</h3>\n                        <p>Cada paciente é única: tratamentos personalizados para suas necessidades específicas.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-fade-up stagger-4\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"/>\n                            <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/>\n                            <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/>\n                            <line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/>\n                        </svg>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h3>Agilidade no Atendimento</h3>\n                        <p>Procedimentos rápidos e eficientes, com mínimo tempo de recuperação.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-fade-up stagger-5\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h3>Ambiente Seguro</h3>\n                        <p>Clínica equipada com os mais altos padrões de segurança e higiene.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-fade-up stagger-6\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h3>Acompanhamento Completo</h3>\n                        <p>Suporte contínuo antes, durante e após os procedimentos.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"container\">\n            <div class=\"contact-wrapper\">\n                <div class=\"contact-info wow-fade-up\">\n                    <h3>Pronta para Transformar sua Aparência?</h3>\n                    <p>Agende sua consulta e descubra como podemos ajudá-la a alcançar seus objetivos estéticos com segurança e excelência.</p>\n                    <div class=\"contact-details\">\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                                    <path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z\"/>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-content\">\n                                <h4>Endereço</h4>\n                                <p>José Ferreira da Costa, 305 - sala 21 - Jardim Nova Alianca Sul, Ribeirão Preto - SP, 14027-070</p>\n                            </div>\n                        </div>\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                                    <path d=\"M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z\"/>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-content\">\n                                <h4>Telefone</h4>\n                                <p>(16) 99114-1066</p>\n                            </div>\n                        </div>\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                                    <path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-content\">\n                                <h4>Horário de Atendimento</h4>\n                                <p>Segunda a Sexta: 9h às 18h</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"contact-form-wrapper wow-fade-up stagger-1\">\n                    <form class=\"contact-form\" id=\"contactForm\">\n                        <h4>Envie uma Mensagem</h4>\n                        <div class=\"form-group\">\n                            <label for=\"name\">Nome Completo</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" required placeholder=\"Seu nome\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"phone\">Telefone/WhatsApp</label>\n                            <input type=\"tel\" id=\"phone\" name=\"phone\" required placeholder=\"(XX) XXXXX-XXXX\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"service\">Tratamento de Interesse</label>\n                            <select id=\"service\" name=\"service\" required>\n                                <option value=\"\">Selecione um tratamento</option>\n                                <option value=\"Harmonização Facial\">Harmonização Facial</option>\n                                <option value=\"Toxina Botulínica\">Toxina Botulínica</option>\n                                <option value=\"Preenchedores Faciais\">Preenchedores Faciais</option>\n                                <option value=\"Preenchimento Labial\">Preenchimento Labial</option>\n                                <option value=\"Bioestimuladores\">Bioestimuladores</option>\n                                <option value=\"Protocolos Exclusivos\">Protocolos Exclusivos</option>\n                                <option value=\"Outro\">Outro</option>\n                            </select>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"message\">Mensagem</label>\n                            <textarea id=\"message\" name=\"message\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                        </div>\n                        <button type=\"submit\" class=\"form-submit\">\n                            Agendar Consulta\n                            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"display: inline-block; margin-left: 8px;\">\n                                <path d=\"M9 5l7 7-7 7\"/>\n                            </svg>\n                        </button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-brand\">\n                    <h3>Dra. <span class=\"logo-accent\">Isabela Barros</span></h3>\n                    <p>Harmonização Facial e Estética Avançada em Ribeirão Preto. Transforme sua aparência com quem entende do assunto.</p>\n                    <a href=\"https://wa.me/5516991141066\" style=\"display: inline-flex; align-items: center; gap: 0.5rem; color: var(--color-aurora-light);\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                            <path d=\"M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01C17.18 3.03 14.69 2 12.04 2z\"/>\n                        </svg>\n                        (16) 99114-1066\n                    </a>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Links Rápidos</h4>\n                    <ul>\n                        <li><a href=\"#inicio\">Início</a></li>\n                        <li><a href=\"#servicos\">Serviços</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                        <li><a href=\"#contato\">Contato</a></li>\n                    </ul>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Tratamentos</h4>\n                    <ul>\n                        <li><a href=\"#servicos\">Harmonização Facial</a></li>\n                        <li><a href=\"#servicos\">Toxina Botulínica</a></li>\n                        <li><a href=\"#servicos\">Preenchedores</a></li>\n                        <li><a href=\"#servicos\">Bioestimuladores</a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"footer-bottom\">\n                <p>&copy; 2026 Dra. Isabela Barros. Todos os direitos reservados.</p>\n                <p>Harmonização Facial em Ribeirão Preto - SP</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION\n        // ============================================\n        const nav = document.getElementById('nav');\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n        let lastScroll = 0;\n\n        // Auto-hide nav on scroll\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                } else {\n                    nav.classList.remove('hidden');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Mobile menu toggle\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n            navToggle.classList.toggle('active');\n        });\n\n        // Close menu on link click\n        navMenu.querySelectorAll('a').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n                navToggle.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER FOR ANIMATIONS\n        // ============================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('visible');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow, .wow-fade-up').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // PARALLAX EFFECT ON BLOBS\n        // ============================================\n        const blobs = document.querySelectorAll('.blob');\n\n        document.addEventListener('mousemove', (e) => {\n            const mouseX = e.clientX / window.innerWidth - 0.5;\n            const mouseY = e.clientY / window.innerHeight - 0.5;\n\n            blobs.forEach((blob, index) => {\n                const speed = (index + 1) * 20;\n                const x = mouseX * speed;\n                const y = mouseY * speed;\n                blob.style.transform = `translate(${x}px, ${y}px)`;\n            });\n        });\n\n        // ============================================\n        // CONTACT FORM - WHATSAPP INTEGRATION\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const whatsappMessage = `Olá Dra. Isabela Barros! Meu nome é ${name}.%0A%0A` +\n                `Telefone: ${phone}%0A` +\n                `Interesse: ${service}%0A%0A` +\n                `Mensagem: ${message}`;\n\n            const whatsappURL = `https://wa.me/5516991141066?text=${whatsappMessage}`;\n\n            window.open(whatsappURL, '_blank');\n        });\n\n        // ============================================\n        // REDUCED MOTION SUPPORT\n        // ============================================\n        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n        if (prefersReducedMotion.matches) {\n            blobs.forEach(blob => {\n                blob.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"2d580528-34aa-4d7c-a124-48e357ef5700","uuid":"e33e256d-d661-47da-a9df-9120e0c28b2d"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_011c82e3096e4cb0b1eac917","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-isabela-barros/index.html"}]},"parent_tool_use_id":null,"session_id":"2d580528-34aa-4d7c-a124-48e357ef5700","uuid":"247f969f-2bc0-425c-aaa3-065effa3b12a","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-isabela-barros/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Isabela Barros | Harmonização Facial e Estética Avançada em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Isabela Barros - Atendimento especializado em harmonização facial e estética avançada em Ribeirão Preto. Transforme sua aparência com tratamentos premium.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           AURORA NOIR & PEARL SILVER PALETTE\n           ============================================ */\n        :root {\n            /* Aurora Colors - Northern Lights inspired greens/blues */\n            --color-aurora: #4A9B8A;\n            --color-aurora-light: #6AB8AA;\n            --color-aurora-mid: #8AC8BA;\n            --color-aurora-dark: #2A7A6A;\n            --color-aurora-deep: #1A5A4A;\n            --color-aurora-mist: #E8F5F2;\n\n            /* Pearl Silver - Shimmering elegant silver */\n            --color-pearl-silver: #C8C8D8;\n            --color-pearl-light: #D8D8E8;\n            --color-pearl-mid: #E8E8F0;\n            --color-pearl-warm: #F0F0F8;\n            --color-pearl-shimmer: #FAFAFC;\n\n            /* Backgrounds */\n            --color-frost: #FAFAFC;\n            --color-frost-warm: #F5F5F8;\n            --color-ivory: #FAFAF8;\n            --color-charcoal: #1A1A1A;\n            --color-charcoal-dark: #0F0F12;\n            --color-noir: #0A0A0C;\n\n            /* Text */\n            --text-primary: #1A1A1A;\n            --text-secondary: #4A4848;\n            --text-muted: #6A6868;\n            --text-on-dark: #FAFAFC;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 1.5rem;\n            --spacing-lg: 2rem;\n            --spacing-xl: 3rem;\n            --spacing-2xl: 4rem;\n            --spacing-3xl: 6rem;\n\n            /* Border Radius - Aurora Wave Shapes */\n            --radius-aurora-1: 72% 28% 58% 42% / 52% 48% 52% 48%;\n            --radius-aurora-2: 48% 52% 42% 58% / 42% 58% 48% 52%;\n            --radius-aurora-3: 58% 42% 52% 48% / 48% 52% 42% 58%;\n            --radius-aurora-4: 42% 58% 48% 52% / 52% 48% 58% 42%;\n            --radius-card: 12px;\n            --radius-button: 8px;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.3s ease;\n            --transition-slow: 0.5s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(74, 155, 138, 0.08);\n            --shadow-md: 0 4px 16px rgba(74, 155, 138, 0.12);\n            --shadow-lg: 0 8px 32px rgba(74, 155, 138, 0.16);\n            --shadow-aurora: 0 4px 20px rgba(74, 155, 138, 0.25);\n        }\n\n        /* ============================================\n           RESET & BASE\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;\n            font-size: 16px;\n            line-height: 1.6;\n            color: var(--text-primary);\n            background-color: var(--color-frost);\n            overflow-x: hidden;\n        }\n\n        h1, h2, h3, h4, h5, h6 {\n            font-family: 'Playfair Display', Georgia, serif;\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--text-primary);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        img {\n            max-width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            background: rgba(250, 250, 252, 0.95);\n            backdrop-filter: blur(10px);\n            border-bottom: 1px solid rgba(74, 155, 138, 0.1);\n            transition: transform 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 1rem 1.5rem;\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n        }\n\n        .nav-logo {\n            font-family: 'Playfair Display', serif;\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-aurora-dark);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: 2rem;\n            list-style: none;\n        }\n\n        .nav-link {\n            font-weight: 500;\n            font-size: 0.9rem;\n            color: var(--text-secondary);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-aurora);\n            transition: width var(--transition-base);\n        }\n\n        .nav-link:hover {\n            color: var(--color-aurora);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--color-aurora);\n            color: white;\n            padding: 0.6rem 1.2rem;\n            border-radius: var(--radius-button);\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: all var(--transition-base);\n        }\n\n        .nav-cta:hover {\n            background: var(--color-aurora-light);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-aurora);\n        }\n\n        .nav-toggle {\n            display: none;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav-toggle span {\n            display: block;\n            width: 24px;\n            height: 2px;\n            background: var(--color-aurora);\n            margin: 5px 0;\n            transition: var(--transition-base);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            position: relative;\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            padding: 100px 1.5rem 3rem;\n            overflow: hidden;\n        }\n\n        .hero-blobs {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n            z-index: 0;\n        }\n\n        .blob {\n            position: absolute;\n            border-radius: var(--radius-aurora-1);\n            filter: blur(80px);\n            opacity: 0.4;\n            animation: float 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 500px;\n            height: 500px;\n            background: linear-gradient(135deg, var(--color-aurora-light), var(--color-aurora-mist));\n            top: -100px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .blob-2 {\n            width: 400px;\n            height: 400px;\n            background: linear-gradient(225deg, var(--color-pearl-shimmer), var(--color-aurora-mist));\n            bottom: -50px;\n            left: -50px;\n            animation-delay: -5s;\n            border-radius: var(--radius-aurora-2);\n        }\n\n        .blob-3 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(45deg, var(--color-aurora), var(--color-aurora-light));\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: -10s;\n            border-radius: var(--radius-aurora-3);\n        }\n\n        .blob-4 {\n            width: 250px;\n            height: 250px;\n            background: linear-gradient(180deg, var(--color-pearl-light), var(--color-pearl-mid));\n            top: 20%;\n            left: 10%;\n            animation-delay: -15s;\n            border-radius: var(--radius-aurora-4);\n            opacity: 0.3;\n        }\n\n        @keyframes float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(90deg) scale(1.05);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(180deg) scale(0.95);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(270deg) scale(1.02);\n            }\n        }\n\n        .hero-container {\n            position: relative;\n            z-index: 1;\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: center;\n        }\n\n        .hero-content {\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease forwards;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            background: var(--color-aurora-mist);\n            color: var(--color-aurora);\n            padding: 0.5rem 1rem;\n            border-radius: 50px;\n            font-size: 0.85rem;\n            font-weight: 600;\n            margin-bottom: 1.5rem;\n        }\n\n        .hero-badge::before {\n            content: '';\n            width: 8px;\n            height: 8px;\n            background: var(--color-aurora);\n            border-radius: 50%;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; }\n            50% { opacity: 0.5; }\n        }\n\n        .hero h1 {\n            font-size: clamp(2.5rem, 5vw, 4rem);\n            margin-bottom: 1.5rem;\n            color: var(--color-aurora-deep);\n        }\n\n        .hero h1 span {\n            color: var(--color-aurora);\n        }\n\n        .hero-subtitle {\n            font-size: 1.1rem;\n            color: var(--text-secondary);\n            margin-bottom: 2rem;\n            max-width: 500px;\n        }\n\n        .hero-cta {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 1rem;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 1.8rem;\n            border-radius: var(--radius-button);\n            font-weight: 600;\n            font-size: 0.95rem;\n            cursor: pointer;\n            transition: all var(--transition-base);\n            border: none;\n        }\n\n        .btn-primary {\n            background: var(--color-aurora);\n            color: white;\n            box-shadow: var(--shadow-md);\n        }\n\n        .btn-primary:hover {\n            background: var(--color-aurora-light);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-aurora);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-aurora);\n            border: 2px solid var(--color-aurora);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-aurora);\n            color: white;\n        }\n\n        .hero-image {\n            position: relative;\n            opacity: 0;\n            transform: translateX(30px);\n            animation: fadeInRight 0.8s ease 0.2s forwards;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            border-radius: var(--radius-aurora-1);\n            overflow: hidden;\n            box-shadow: var(--shadow-lg);\n        }\n\n        .hero-image img {\n            width: 100%;\n            height: auto;\n            object-fit: cover;\n        }\n\n        .hero-image-accent {\n            position: absolute;\n            bottom: -20px;\n            left: -20px;\n            width: 150px;\n            height: 150px;\n            background: linear-gradient(135deg, var(--color-aurora), var(--color-aurora-light));\n            border-radius: var(--radius-aurora-3);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-family: 'Playfair Display', serif;\n            font-size: 3rem;\n            font-weight: 700;\n            box-shadow: var(--shadow-aurora);\n        }\n\n        @keyframes fadeInUp {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fadeInRight {\n            to {\n                opacity: 1;\n                transform: translateX(0);\n            }\n        }\n\n        /* ============================================\n           PROBLEM / SOLUTION SECTION\n           ============================================ */\n        .section {\n            padding: var(--spacing-3xl) 1.5rem;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-2xl);\n        }\n\n        .section-tag {\n            display: inline-block;\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-aurora);\n            text-transform: uppercase;\n            letter-spacing: 2px;\n            margin-bottom: 1rem;\n        }\n\n        .section h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: 1rem;\n            color: var(--color-aurora-deep);\n        }\n\n        .section-subtitle {\n            font-size: 1.1rem;\n            color: var(--text-secondary);\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        .problem-solution {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 3rem;\n            align-items: stretch;\n        }\n\n        .problem-card, .solution-card {\n            background: white;\n            padding: 2.5rem;\n            border-radius: var(--radius-card);\n            position: relative;\n            overflow: hidden;\n            transition: all var(--transition-base);\n        }\n\n        .problem-card {\n            border-left: 4px solid var(--color-aurora-dark);\n        }\n\n        .solution-card {\n            border-left: 4px solid var(--color-pearl-silver);\n        }\n\n        .problem-card::before, .solution-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            right: 0;\n            width: 200px;\n            height: 200px;\n            border-radius: var(--radius-aurora-1);\n            opacity: 0.05;\n            pointer-events: none;\n        }\n\n        .problem-card::before {\n            background: var(--color-aurora);\n        }\n\n        .solution-card::before {\n            background: var(--color-pearl-silver);\n        }\n\n        .card-icon {\n            width: 60px;\n            height: 60px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            border-radius: 50%;\n            margin-bottom: 1.5rem;\n            font-size: 1.5rem;\n        }\n\n        .problem-card .card-icon {\n            background: var(--color-aurora-mist);\n            color: var(--color-aurora);\n        }\n\n        .solution-card .card-icon {\n            background: var(--color-pearl-warm);\n            color: var(--color-aurora-dark);\n        }\n\n        .problem-card h3, .solution-card h3 {\n            font-size: 1.5rem;\n            margin-bottom: 1rem;\n        }\n\n        .problem-card h3 {\n            color: var(--color-aurora-dark);\n        }\n\n        .solution-card h3 {\n            color: var(--color-aurora);\n        }\n\n        .problem-list, .solution-list {\n            list-style: none;\n        }\n\n        .problem-list li, .solution-list li {\n            padding: 0.5rem 0;\n            padding-left: 1.5rem;\n            position: relative;\n            color: var(--text-secondary);\n        }\n\n        .problem-list li::before {\n            content: '×';\n            position: absolute;\n            left: 0;\n            color: var(--color-aurora-dark);\n            font-weight: bold;\n        }\n\n        .solution-list li::before {\n            content: '✓';\n            position: absolute;\n            left: 0;\n            color: var(--color-aurora);\n            font-weight: bold;\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            background: var(--color-frost-warm);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: 2rem;\n        }\n\n        .service-card {\n            background: white;\n            border-radius: var(--radius-card);\n            padding: 2rem;\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: linear-gradient(90deg, var(--color-aurora), var(--color-pearl-silver));\n            transform: scaleX(0);\n            transform-origin: left;\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-icon {\n            width: 70px;\n            height: 70px;\n            background: linear-gradient(135deg, var(--color-aurora), var(--color-aurora-light));\n            border-radius: var(--radius-aurora-1);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n            font-size: 1.8rem;\n        }\n\n        .service-card h3 {\n            font-size: 1.3rem;\n            margin-bottom: 0.8rem;\n            color: var(--color-aurora-dark);\n        }\n\n        .service-card p {\n            color: var(--text-secondary);\n            margin-bottom: 1.5rem;\n            font-size: 0.95rem;\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-aurora);\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: all var(--transition-fast);\n        }\n\n        .service-link:hover {\n            color: var(--color-pearl-silver);\n            gap: 0.8rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            background: var(--color-aurora);\n            color: white;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .testimonials::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background: url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\");\n            opacity: 0.5;\n        }\n\n        .testimonials .section-tag {\n            color: var(--color-pearl-shimmer);\n        }\n\n        .testimonials h2 {\n            color: white;\n        }\n\n        .testimonials .section-subtitle {\n            color: rgba(255, 255, 255, 0.8);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: 2rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.1);\n            backdrop-filter: blur(10px);\n            border-radius: var(--radius-card);\n            padding: 2rem;\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            transition: all var(--transition-base);\n        }\n\n        .testimonial-card:hover {\n            background: rgba(255, 255, 255, 0.15);\n            transform: translateY(-4px);\n        }\n\n        .testimonial-stars {\n            color: var(--color-pearl-shimmer);\n            font-size: 1.2rem;\n            margin-bottom: 1rem;\n        }\n\n        .testimonial-text {\n            font-size: 1rem;\n            line-height: 1.7;\n            margin-bottom: 1.5rem;\n            color: rgba(255, 255, 255, 0.95);\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: linear-gradient(135deg, var(--color-pearl-shimmer), var(--color-pearl-light));\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 700;\n            color: var(--color-aurora-dark);\n        }\n\n        .testimonial-info h4 {\n            font-size: 1rem;\n            color: white;\n            margin-bottom: 0.2rem;\n        }\n\n        .testimonial-info p {\n            font-size: 0.85rem;\n            color: rgba(255, 255, 255, 0.7);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: 2rem;\n        }\n\n        .differential-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n            padding: 1.5rem;\n            border-radius: var(--radius-card);\n            transition: all var(--transition-base);\n        }\n\n        .differential-item:hover {\n            background: white;\n            box-shadow: var(--shadow-md);\n        }\n\n        .differential-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--color-aurora-mist);\n            border-radius: var(--radius-aurora-2);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n            position: relative;\n        }\n\n        .differential-icon::after {\n            content: '';\n            position: absolute;\n            top: -4px;\n            left: -4px;\n            right: -4px;\n            bottom: -4px;\n            border: 2px solid var(--color-pearl-silver);\n            border-radius: var(--radius-aurora-2);\n            opacity: 0;\n            animation: pulse-ring 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse-ring {\n            0% {\n                transform: scale(1);\n                opacity: 0.5;\n            }\n            100% {\n                transform: scale(1.2);\n                opacity: 0;\n            }\n        }\n\n        .differential-content h3 {\n            font-size: 1.1rem;\n            margin-bottom: 0.5rem;\n            color: var(--color-aurora-dark);\n        }\n\n        .differential-content p {\n            font-size: 0.9rem;\n            color: var(--text-secondary);\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            background: var(--color-frost-warm);\n        }\n\n        .contact-wrapper {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: start;\n        }\n\n        .contact-info h3 {\n            font-size: 1.8rem;\n            margin-bottom: 1rem;\n            color: var(--color-aurora-dark);\n        }\n\n        .contact-info p {\n            color: var(--text-secondary);\n            margin-bottom: 2rem;\n        }\n\n        .contact-details {\n            display: flex;\n            flex-direction: column;\n            gap: 1.5rem;\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n        }\n\n        .contact-item-icon {\n            width: 45px;\n            height: 45px;\n            background: var(--color-aurora);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            flex-shrink: 0;\n        }\n\n        .contact-item-content h4 {\n            font-size: 1rem;\n            margin-bottom: 0.3rem;\n        }\n\n        .contact-item-content p {\n            font-size: 0.95rem;\n            margin-bottom: 0;\n            color: var(--text-secondary);\n        }\n\n        .contact-form-wrapper {\n            background: white;\n            padding: 2.5rem;\n            border-radius: var(--radius-card);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .contact-form h4 {\n            font-size: 1.3rem;\n            margin-bottom: 1.5rem;\n            color: var(--color-aurora-dark);\n        }\n\n        .form-group {\n            margin-bottom: 1.5rem;\n        }\n\n        .form-group label {\n            display: block;\n            font-weight: 600;\n            margin-bottom: 0.5rem;\n            color: var(--text-primary);\n            font-size: 0.9rem;\n        }\n\n        .form-group input,\n        .form-group select,\n        .form-group textarea {\n            width: 100%;\n            padding: 0.8rem 1rem;\n            border: 2px solid var(--color-pearl-mid);\n            border-radius: var(--radius-button);\n            font-family: inherit;\n            font-size: 1rem;\n            transition: all var(--transition-fast);\n            background: var(--color-frost);\n        }\n\n        .form-group input:focus,\n        .form-group select:focus,\n        .form-group textarea:focus {\n            outline: none;\n            border-color: var(--color-aurora);\n            box-shadow: 0 0 0 3px rgba(74, 155, 138, 0.1);\n        }\n\n        .form-group textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            background: var(--color-aurora);\n            color: white;\n            padding: 1rem;\n            border: none;\n            border-radius: var(--radius-button);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: all var(--transition-base);\n        }\n\n        .form-submit:hover {\n            background: var(--color-aurora-light);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-aurora);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--color-charcoal);\n            color: var(--color-frost);\n            padding: 4rem 1.5rem 2rem;\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: 3rem;\n            margin-bottom: 3rem;\n        }\n\n        .footer-brand h3 {\n            font-size: 1.8rem;\n            color: white;\n            margin-bottom: 1rem;\n        }\n\n        .footer-brand p {\n            color: rgba(250, 250, 252, 0.7);\n            margin-bottom: 1.5rem;\n            max-width: 300px;\n        }\n\n        .footer-brand .logo-accent {\n            color: var(--color-aurora-light);\n        }\n\n        .footer-links h4 {\n            color: white;\n            margin-bottom: 1rem;\n            font-size: 1.1rem;\n        }\n\n        .footer-links ul {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.8rem;\n        }\n\n        .footer-links a {\n            color: rgba(250, 250, 252, 0.7);\n            transition: color var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-aurora-light);\n        }\n\n        .footer-bottom {\n            padding-top: 2rem;\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            flex-wrap: wrap;\n            gap: 1rem;\n        }\n\n        .footer-bottom p {\n            color: rgba(250, 250, 252, 0.6);\n            font-size: 0.9rem;\n        }\n\n        /* ============================================\n           SCROLL ANIMATIONS\n           ============================================ */\n        .wow {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(40px);\n            transition: opacity 0.8s ease, transform 0.8s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .stagger-1 { transition-delay: 0ms; }\n        .stagger-2 { transition-delay: 100ms; }\n        .stagger-3 { transition-delay: 200ms; }\n        .stagger-4 { transition-delay: 300ms; }\n        .stagger-5 { transition-delay: 400ms; }\n        .stagger-6 { transition-delay: 500ms; }\n\n        /* ============================================\n           RESPONSIVE\n           ============================================ */\n        @media (max-width: 1024px) {\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-content {\n                order: 2;\n            }\n\n            .hero-image {\n                order: 1;\n                max-width: 500px;\n                margin: 0 auto;\n            }\n\n            .hero-subtitle {\n                margin-left: auto;\n                margin-right: auto;\n            }\n\n            .hero-cta {\n                justify-content: center;\n            }\n\n            .problem-solution {\n                grid-template-columns: 1fr;\n            }\n\n            .contact-wrapper {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 0;\n                right: -100%;\n                width: 80%;\n                max-width: 300px;\n                height: 100vh;\n                background: white;\n                flex-direction: column;\n                padding: 80px 2rem 2rem;\n                gap: 1.5rem;\n                transition: right var(--transition-base);\n                box-shadow: -5px 0 20px rgba(0, 0, 0, 0.1);\n            }\n\n            .nav-menu.active {\n                right: 0;\n            }\n\n            .nav-toggle {\n                display: block;\n                z-index: 1001;\n            }\n\n            .nav-toggle.active span:nth-child(1) {\n                transform: rotate(45deg) translate(5px, 5px);\n            }\n\n            .nav-toggle.active span:nth-child(2) {\n                opacity: 0;\n            }\n\n            .nav-toggle.active span:nth-child(3) {\n                transform: rotate(-45deg) translate(5px, -5px);\n            }\n\n            .section {\n                padding: var(--spacing-xl) 1rem;\n            }\n\n            .services-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .testimonials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-content {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .footer-brand p {\n                margin-left: auto;\n                margin-right: auto;\n            }\n\n            .footer-bottom {\n                flex-direction: column;\n                text-align: center;\n            }\n\n            .hero-image-accent {\n                display: none;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .hero h1 {\n                font-size: 2rem;\n            }\n\n            .btn {\n                width: 100%;\n                justify-content: center;\n            }\n\n            .hero-cta {\n                flex-direction: column;\n            }\n        }\n\n        /* ============================================\n           ACCESSIBILITY\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n\n            html {\n                scroll-behavior: auto;\n            }\n        }\n\n        .skip-link {\n            position: absolute;\n            top: -40px;\n            left: 0;\n            background: var(--color-aurora);\n            color: white;\n            padding: 8px 16px;\n            text-decoration: none;\n            z-index: 100;\n        }\n\n        .skip-link:focus {\n            top: 0;\n        }\n\n        button:focus, a:focus {\n            outline: 2px solid var(--color-pearl-silver);\n            outline-offset: 2px;\n        }\n    </style>\n</head>\n<body>\n    <a href=\"#main\" class=\"skip-link\">Pular para o conteúdo principal</a>\n\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Isabela Barros</a>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#inicio\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#contato\" class=\"nav-link\">Contato</a></li>\n                <li><a href=\"#contato\" class=\"nav-cta\">Agendar</a></li>\n            </ul>\n            <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Menu\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-blobs\">\n            <div class=\"blob blob-1\"></div>\n            <div class=\"blob blob-2\"></div>\n            <div class=\"blob blob-3\"></div>\n            <div class=\"blob blob-4\"></div>\n        </div>\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge\">\n                    <span>Harmonização Facial em Ribeirão Preto</span>\n                </div>\n                <h1>Sua Beleza Natural com <span>Dra. Isabela Barros</span></h1>\n                <p class=\"hero-subtitle\">Atendimento especializado em harmonização facial e estética avançada. Resultados naturais que realçam sua beleza única com elegância.</p>\n                <div class=\"hero-cta\">\n                    <a href=\"#contato\" class=\"btn btn-primary\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                            <path d=\"M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11zM9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm-8 4H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z\"/>\n                        </svg>\n                        Agendar Consulta\n                    </a>\n                    <a href=\"https://wa.me/5516991141066\" class=\"btn btn-secondary\" target=\"_blank\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                            <path d=\"M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01C17.18 3.03 14.69 2 12.04 2zM12.05 20.21c-1.5 0-2.97-.39-4.26-1.15l-.3-.18-3.11.82.83-3.04-.2-.31c-.82-1.26-1.25-2.73-1.25-4.24 0-4.55 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.82 2.41 1.56 1.56 2.41 3.63 2.41 5.83-.01 4.54-3.7 8.24-8.25 8.24z\"/>\n                        </svg>\n                        WhatsApp\n                    </a>\n                </div>\n            </div>\n            <div class=\"hero-image\">\n                <div class=\"hero-image-wrapper\">\n                    <img src=\"https://images.unsplash.com/photo-1594744803329-e58b31de8bf5?w=600&h=700&fit=crop&crop=face\" alt=\"Dra. Isabela Barros - Harmonização Facial\">\n                </div>\n                <div class=\"hero-image-accent\">✨</div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section\" id=\"sobre\">\n        <div class=\"container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Sobre</span>\n                <h2>Sua Beleza, Nossa Paixão</h2>\n                <p class=\"section-subtitle\">Compreendemos seus desejos e oferecemos soluções personalizadas para realçar sua beleza natural.</p>\n            </div>\n            <div class=\"problem-solution\">\n                <div class=\"problem-card wow-fade-up stagger-1\">\n                    <div class=\"card-icon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            <path d=\"M8 14s1.5 2 4 2 4-2 4-2\"/>\n                            <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"/>\n                            <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"/>\n                        </svg>\n                    </div>\n                    <h3>O que te preocupa</h3>\n                    <ul class=\"problem-list\">\n                        <li>Sinais de envelhecimento facial</li>\n                        <li>Perda de contorno e volume</li>\n                        <li>Rugas e linhas de expressão</li>\n                        <li>Assimetria facial</li>\n                        <li>Aparência cansada</li>\n                    </ul>\n                </div>\n                <div class=\"solution-card wow-fade-up stagger-2\">\n                    <div class=\"card-icon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Nossa solução</h3>\n                    <ul class=\"solution-list\">\n                        <li>Harmonização facial personalizada</li>\n                        <li>Técnicas avançadas e minimamente invasivas</li>\n                        <li>Resultados naturais e equilibrados</li>\n                        <li>Procedimentos rápidos e seguros</li>\n                        <li>Aparência descansada e revitalizada</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Serviços</span>\n                <h2>Tratamentos Especializados</h2>\n                <p class=\"section-subtitle\">Procedimentos premium realizados com técnicas avançadas e produtos de alta qualidade.</p>\n            </div>\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up stagger-1\">\n                    <div class=\"service-icon\">✨</div>\n                    <h3>Harmonização Facial</h3>\n                    <p>Equilibre seus traços faciais com tratamentos personalizados que realçam sua beleza natural de forma sutil e elegante.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow-fade-up stagger-2\">\n                    <div class=\"service-icon\">💉</div>\n                    <h3>Toxina Botulínica</h3>\n                    <p>Suavize linhas de expressão e rugas com aplicação precisa de toxina botulínica para um aspecto mais jovem e descansado.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow-fade-up stagger-3\">\n                    <div class=\"service-icon\">💎</div>\n                    <h3>Preenchedores Faciais</h3>\n                    <p>Restaure volume e contorno facial com preenchedores de ácido hialurônico de alta qualidade e durabilidade.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow-fade-up stagger-4\">\n                    <div class=\"service-icon\">👄</div>\n                    <h3>Preenchimento Labial</h3>\n                    <p>Destaque seus lábios com preenchimento que proporciona volume, definição e hidratação natural.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow-fade-up stagger-5\">\n                    <div class=\"service-icon\">⚡</div>\n                    <h3>Bioestimuladores</h3>\n                    <p>Estimule a produção de colágeno e rejuvenesça sua pele com bioestimuladores de última geração.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow-fade-up stagger-6\">\n                    <div class=\"service-icon\">🏆</div>\n                    <h3>Protocolos Exclusivos</h3>\n                    <p>Tratamentos personalizados desenvolvidos especificamente para suas necessidades únicas e objetivos estéticos.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Depoimentos</span>\n                <h2>O Que Dizem Nossas Clientes</h2>\n                <p class=\"section-subtitle\">Histórias reais de transformação e satisfação com nossos tratamentos.</p>\n            </div>\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up stagger-1\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Dra. Isabela é incrível! Fez minha harmonização facial com tanta delicadeza e precisão. O resultado ficou super natural, exatamente como eu queria.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">FS</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Fernanda Silva</h4>\n                            <p>Advogada</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up stagger-2\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Excelente profissional! Muito atenciosa e dedicada. Fiz preenchimento labial e ficou perfeito. Recomendo demais o trabalho da Dra. Isabela!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">CM</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Carla Mendes</h4>\n                            <p>Empresária</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up stagger-3\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Sou cliente há um ano e sempre fico satisfeita com os resultados. A Dra. Isabela tem mãos incríveis e sabe exatamente o que cada rosto precisa.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">JO</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Juliana Oliveira</h4>\n                            <p>Arquiteta</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section\" id=\"diferenciais\">\n        <div class=\"container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Diferenciais</span>\n                <h2>Por Que Escolher Dra. Isabela Barros</h2>\n                <p class=\"section-subtitle\">Qualidade, segurança e resultados que transformam vidas.</p>\n            </div>\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up stagger-1\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h3>Expertise Comprovada</h3>\n                        <p>Formação especializada e atualização constante em técnicas avançadas de harmonização facial.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-fade-up stagger-2\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/>\n                            <polyline points=\"22 4 12 14.01 9 11.01\"/>\n                        </svg>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h3>Produtos Premium</h3>\n                        <p>Utilizamos apenas produtos de alta qualidade e procedência certificada para sua segurança.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-fade-up stagger-3\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h3>Atendimento Humanizado</h3>\n                        <p>Cada paciente é única: tratamentos personalizados para suas necessidades específicas.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-fade-up stagger-4\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"/>\n                            <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/>\n                            <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/>\n                            <line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/>\n                        </svg>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h3>Agilidade no Atendimento</h3>\n                        <p>Procedimentos rápidos e eficientes, com mínimo tempo de recuperação.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-fade-up stagger-5\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h3>Ambiente Seguro</h3>\n                        <p>Clínica equipada com os mais altos padrões de segurança e higiene.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-fade-up stagger-6\">\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"differential-content\">\n                        <h3>Acompanhamento Completo</h3>\n                        <p>Suporte contínuo antes, durante e após os procedimentos.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"container\">\n            <div class=\"contact-wrapper\">\n                <div class=\"contact-info wow-fade-up\">\n                    <h3>Pronta para Transformar sua Aparência?</h3>\n                    <p>Agende sua consulta e descubra como podemos ajudá-la a alcançar seus objetivos estéticos com segurança e excelência.</p>\n                    <div class=\"contact-details\">\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                                    <path d=\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z\"/>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-content\">\n                                <h4>Endereço</h4>\n                                <p>José Ferreira da Costa, 305 - sala 21 - Jardim Nova Alianca Sul, Ribeirão Preto - SP, 14027-070</p>\n                            </div>\n                        </div>\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                                    <path d=\"M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z\"/>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-content\">\n                                <h4>Telefone</h4>\n                                <p>(16) 99114-1066</p>\n                            </div>\n                        </div>\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                                    <path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-content\">\n                                <h4>Horário de Atendimento</h4>\n                                <p>Segunda a Sexta: 9h às 18h</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"contact-form-wrapper wow-fade-up stagger-1\">\n                    <form class=\"contact-form\" id=\"contactForm\">\n                        <h4>Envie uma Mensagem</h4>\n                        <div class=\"form-group\">\n                            <label for=\"name\">Nome Completo</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" required placeholder=\"Seu nome\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"phone\">Telefone/WhatsApp</label>\n                            <input type=\"tel\" id=\"phone\" name=\"phone\" required placeholder=\"(XX) XXXXX-XXXX\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"service\">Tratamento de Interesse</label>\n                            <select id=\"service\" name=\"service\" required>\n                                <option value=\"\">Selecione um tratamento</option>\n                                <option value=\"Harmonização Facial\">Harmonização Facial</option>\n                                <option value=\"Toxina Botulínica\">Toxina Botulínica</option>\n                                <option value=\"Preenchedores Faciais\">Preenchedores Faciais</option>\n                                <option value=\"Preenchimento Labial\">Preenchimento Labial</option>\n                                <option value=\"Bioestimuladores\">Bioestimuladores</option>\n                                <option value=\"Protocolos Exclusivos\">Protocolos Exclusivos</option>\n                                <option value=\"Outro\">Outro</option>\n                            </select>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"message\">Mensagem</label>\n                            <textarea id=\"message\" name=\"message\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                        </div>\n                        <button type=\"submit\" class=\"form-submit\">\n                            Agendar Consulta\n                            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"display: inline-block; margin-left: 8px;\">\n                                <path d=\"M9 5l7 7-7 7\"/>\n                            </svg>\n                        </button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-brand\">\n                    <h3>Dra. <span class=\"logo-accent\">Isabela Barros</span></h3>\n                    <p>Harmonização Facial e Estética Avançada em Ribeirão Preto. Transforme sua aparência com quem entende do assunto.</p>\n                    <a href=\"https://wa.me/5516991141066\" style=\"display: inline-flex; align-items: center; gap: 0.5rem; color: var(--color-aurora-light);\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                            <path d=\"M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01C17.18 3.03 14.69 2 12.04 2z\"/>\n                        </svg>\n                        (16) 99114-1066\n                    </a>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Links Rápidos</h4>\n                    <ul>\n                        <li><a href=\"#inicio\">Início</a></li>\n                        <li><a href=\"#servicos\">Serviços</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                        <li><a href=\"#contato\">Contato</a></li>\n                    </ul>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Tratamentos</h4>\n                    <ul>\n                        <li><a href=\"#servicos\">Harmonização Facial</a></li>\n                        <li><a href=\"#servicos\">Toxina Botulínica</a></li>\n                        <li><a href=\"#servicos\">Preenchedores</a></li>\n                        <li><a href=\"#servicos\">Bioestimuladores</a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"footer-bottom\">\n                <p>&copy; 2026 Dra. Isabela Barros. Todos os direitos reservados.</p>\n                <p>Harmonização Facial em Ribeirão Preto - SP</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION\n        // ============================================\n        const nav = document.getElementById('nav');\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n        let lastScroll = 0;\n\n        // Auto-hide nav on scroll\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                } else {\n                    nav.classList.remove('hidden');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Mobile menu toggle\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n            navToggle.classList.toggle('active');\n        });\n\n        // Close menu on link click\n        navMenu.querySelectorAll('a').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n                navToggle.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER FOR ANIMATIONS\n        // ============================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('visible');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow, .wow-fade-up').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // PARALLAX EFFECT ON BLOBS\n        // ============================================\n        const blobs = document.querySelectorAll('.blob');\n\n        document.addEventListener('mousemove', (e) => {\n            const mouseX = e.clientX / window.innerWidth - 0.5;\n            const mouseY = e.clientY / window.innerHeight - 0.5;\n\n            blobs.forEach((blob, index) => {\n                const speed = (index + 1) * 20;\n                const x = mouseX * speed;\n                const y = mouseY * speed;\n                blob.style.transform = `translate(${x}px, ${y}px)`;\n            });\n        });\n\n        // ============================================\n        // CONTACT FORM - WHATSAPP INTEGRATION\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const whatsappMessage = `Olá Dra. Isabela Barros! Meu nome é ${name}.%0A%0A` +\n                `Telefone: ${phone}%0A` +\n                `Interesse: ${service}%0A%0A` +\n                `Mensagem: ${message}`;\n\n            const whatsappURL = `https://wa.me/5516991141066?text=${whatsappMessage}`;\n\n            window.open(whatsappURL, '_blank');\n        });\n\n        // ============================================\n        // REDUCED MOTION SUPPORT\n        // ============================================\n        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n        if (prefersReducedMotion.matches) {\n            blobs.forEach(blob => {\n                blob.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null}}
