;\n    37→            --color-rice-warm: #F5F5F2;\n    38→            --color-rice-soft: #F0F0EC;\n    39→            --color-ink-black: #1A1A1A;\n    40→            --color-ink-deep: #0F0F12;\n    41→            --color-charcoal: #2A2828;\n    42→\n    43→            /* Text */\n    44→            --text-primary: #1A1A1A;\n    45→            --text-secondary: #4A4848;\n    46→            --text-muted: #6A6868;\n    47→            --text-on-dark: #FAFAF8;\n    48→\n    49→            /* Spacing */\n    50→            --spacing-xs: 0.5rem;\n    51→            --spacing-sm: 1rem;\n    52→            --spacing-md: 1.5rem;\n    53→            --spacing-lg: 2rem;\n    54→            --spacing-xl: 3rem;\n    55→            --spacing-2xl: 4rem;\n    56→            --spacing-3xl: 6rem;\n    57→\n    58→            /* Border Radius - Jade Stone Shapes */\n    59→            --radius-jade-1: 68% 32% 52% 48% / 52% 38% 62% 48%;\n    60→            --radius-jade-2: 48% 52% 62% 38% / 42% 58% 42% 58%;\n    61→            --radius-jade-3: 58% 42% 48% 52% / 52% 48% 52% 48%;\n    62→            --radius-jade-4: 42% 58% 52% 48% / 48% 52% 48% 52%;\n    63→            --radius-card: 12px;\n    64→            --radius-button: 8px;\n    65→\n    66→            /* Transitions */\n    67→            --transition-fast: 0.2s ease;\n    68→            --transition-base: 0.3s ease;\n    69→            --transition-slow: 0.5s ease;\n    70→\n    71→            /* Shadows */\n    72→            --shadow-sm: 0 2px 8px rgba(42, 107, 90, 0.08);\n    73→            --shadow-md: 0 4px 16px rgba(42, 107, 90, 0.12);\n    74→            --shadow-lg: 0 8px 32px rgba(42, 107, 90, 0.16);\n    75→            --shadow-gold: 0 4px 20px rgba(184, 152, 88, 0.25);\n    76→        }\n    77→\n    78→        /* ============================================\n    79→           RESET & BASE\n    80→           ============================================ */\n    81→        *, *::before, *::after {\n    82→            margin: 0;\n    83→            padding: 0;\n    84→            box-sizing: border-box;\n    85→        }\n    86→\n    87→        html {\n    88→            scroll-behavior: smooth;\n    89→        }\n    90→\n    91→        body {\n    92→            font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;\n    93→            font-size: 16px;\n    94→            line-height: 1.6;\n    95→            color: var(--text-primary);\n    96→            background-color: var(--color-rice-paper);\n    97→            overflow-x: hidden;\n    98→        }\n    99→\n   100→        h1, h2, h3, h4, h5, h6 {\n   101→            font-family: 'Crimson Pro', Georgia, serif;\n   102→            font-weight: 600;\n   103→            line-height: 1.2;\n   104→            color: var(--text-primary);\n   105→        }\n   106→\n   107→        a {\n   108→            text-decoration: none;\n   109→            color: inherit;\n   110→            transition: var(--transition-base);\n   111→        }\n   112→\n   113→        img {\n   114→            max-width: 100%;\n   115→            height: auto;\n   116→            display: block;\n   117→        }\n   118→\n   119→        /* ============================================\n   120→           NAVIGATION\n   121→           ============================================ */\n   122→        .nav {\n   123→            position: fixed;\n   124→            top: 0;\n   125→            left: 0;\n   126→            right: 0;\n   127→            z-index: 1000;\n   128→            background: rgba(250, 250, 248, 0.95);\n   129→            backdrop-filter: blur(10px);\n   130→            border-bottom: 1px solid rgba(42, 107, 90, 0.1);\n   131→            transition: transform 0.3s ease;\n   132→        }\n   133→\n   134→        .nav.hidden {\n   135→            transform: translateY(-100%);\n   136→        }\n   137→\n   138→        .nav-container {\n   139→            max-width: 1200px;\n   140→            margin: 0 auto;\n   141→            padding: 1rem 1.5rem;\n   142→            display: flex;\n   143→            align-items: center;\n   144→            justify-content: space-between;\n   145→        }\n   146→\n   147→        .nav-logo {\n   148→            font-family: 'Crimson Pro', serif;\n   149→            font-size: 1.5rem;\n   150→            font-weight: 700;\n   151→            color: var(--color-jade);\n   152→        }\n   153→\n   154→        .nav-menu {\n   155→            display: flex;\n   156→            gap: 2rem;\n   157→            list-style: none;\n   158→        }\n   159→\n   160→        .nav-link {\n   161→            font-weight: 500;\n   162→            font-size: 0.9rem;\n   163→            color: var(--text-secondary);\n   164→            position: relative;\n   165→        }\n   166→\n   167→        .nav-link::after {\n   168→            content: '';\n   169→            position: absolute;\n   170→            bottom: -4px;\n   171→            left: 0;\n   172→            width: 0;\n   173→            height: 2px;\n   174→            background: var(--color-gold);\n   175→            transition: width var(--transition-base);\n   176→        }\n   177→\n   178→        .nav-link:hover {\n   179→            color: var(--color-jade);\n   180→        }\n   181→\n   182→        .nav-link:hover::after {\n   183→            width: 100%;\n   184→        }\n   185→\n   186→        .nav-cta {\n   187→            background: var(--color-jade);\n   188→            color: white;\n   189→            padding: 0.6rem 1.2rem;\n   190→            border-radius: var(--radius-button);\n   191→            font-weight: 600;\n   192→            font-size: 0.9rem;\n   193→            transition: all var(--transition-base);\n   194→        }\n   195→\n   196→        .nav-cta:hover {\n   197→            background: var(--color-jade-light);\n   198→            transform: translateY(-2px);\n   199→            box-shadow: var(--shadow-gold);\n   200→        }\n   201→\n   202→        .nav-toggle {\n   203→            display: none;\n   204→            background: none;\n   205→            border: none;\n   206→            cursor: pointer;\n   207→            padding: 0.5rem;\n   208→        }\n   209→\n   210→        .nav-toggle span {\n   211→            display: block;\n   212→            width: 24px;\n   213→            height: 2px;\n   214→            background: var(--color-jade);\n   215→            margin: 5px 0;\n   216→            transition: var(--transition-base);\n   217→        }\n   218→\n   219→        /* ============================================\n   220→           HERO SECTION\n   221→           ============================================ */\n   222→        .hero {\n   223→            position: relative;\n   224→            min-height: 100vh;\n   225→            display: flex;\n   226→            align-items: center;\n   227→            padding: 100px 1.5rem 3rem;\n   228→            overflow: hidden;\n   229→        }\n   230→\n   231→        .hero-blobs {\n   232→            position: absolute;\n   233→            top: 0;\n   234→            left: 0;\n   235→            width: 100%;\n   236→            height: 100%;\n   237→            pointer-events: none;\n   238→            z-index: 0;\n   239→        }\n   240→\n   241→        .blob {\n   242→            position: absolute;\n   243→            border-radius: var(--radius-jade-1);\n   244→            filter: blur(80px);\n   245→            opacity: 0.4;\n   246→            animation: float 20s ease-in-out infinite;\n   247→        }\n   248→\n   249→        .blob-1 {\n   250→            width: 500px;\n   251→            height: 500px;\n   252→            background: linear-gradient(135deg, var(--color-jade-light), var(--color-jade-mist));\n   253→            top: -100px;\n   254→            right: -100px;\n   255→            animation-delay: 0s;\n   256→        }\n   257→\n   258→        .blob-2 {\n   259→            width: 400px;\n   260→            height: 400px;\n   261→            background: linear-gradient(225deg, var(--color-gold-shimmer), var(--color-jade-mist));\n   262→            bottom: -50px;\n   263→            left: -50px;\n   264→            animation-delay: -5s;\n   265→            border-radius: var(--radius-jade-2);\n   266→        }\n   267→\n   268→        .blob-3 {\n   269→            width: 300px;\n   270→            height: 300px;\n   271→            background: linear-gradient(45deg, var(--color-jade), var(--color-jade-light));\n   272→            top: 50%;\n   273→            left: 50%;\n   274→            transform: translate(-50%, -50%);\n   275→            animation-delay: -10s;\n   276→            border-radius: var(--radius-jade-3);\n   277→        }\n   278→\n   279→        .blob-4 {\n   280→            width: 250px;\n   281→            height: 250px;\n   282→            background: linear-gradient(180deg, var(--color-gold-light), var(--color-gold-shimmer));\n   283→            top: 20%;\n   284→            left: 10%;\n   285→            animation-delay: -15s;\n   286→            border-radius: var(--radius-jade-4);\n   287→            opacity: 0.3;\n   288→        }\n   289→\n   290→        @keyframes float {\n   291→            0%, 100% {\n   292→                transform: translate(0, 0) rotate(0deg) scale(1);\n   293→            }\n   294→            25% {\n   295→                transform: translate(30px, -30px) rotate(90deg) scale(1.05);\n   296→            }\n   297→            50% {\n   298→                transform: translate(-20px, 20px) rotate(180deg) scale(0.95);\n   299→            }\n   300→            75% {\n   301→                transform: translate(20px, 30px) rotate(270deg) scale(1.02);\n   302→            }\n   303→        }\n   304→\n   305→        .hero-container {\n   306→            position: relative;\n   307→            z-index: 1;\n   308→            max-width: 1200px;\n   309→            margin: 0 auto;\n   310→            display: grid;\n   311→            grid-template-columns: 1fr 1fr;\n   312→            gap: 4rem;\n   313→            align-items: center;\n   314→        }\n   315→\n   316→        .hero-content {\n   317→            opacity: 0;\n   318→            transform: translateY(30px);\n   319→            animation: fadeInUp 0.8s ease forwards;\n   320→        }\n   321→\n   322→        .hero-badge {\n   323→            display: inline-flex;\n   324→            align-items: center;\n   325→            gap: 0.5rem;\n   326→            background: var(--color-jade-mist);\n   327→            color: var(--color-jade);\n   328→            padding: 0.5rem 1rem;\n   329→            border-radius: 50px;\n   330→            font-size: 0.85rem;\n   331→            font-weight: 600;\n   332→            margin-bottom: 1.5rem;\n   333→        }\n   334→\n   335→        .hero-badge::before {\n   336→            content: '';\n   337→            width: 8px;\n   338→            height: 8px;\n   339→            background: var(--color-gold);\n   340→            border-radius: 50%;\n   341→            animation: pulse 2s ease-in-out infinite;\n   342→        }\n   343→\n   344→        @keyframes pulse {\n   345→            0%, 100% { opacity: 1; }\n   346→            50% { opacity: 0.5; }\n   347→        }\n   348→\n   349→        .hero h1 {\n   350→            font-size: clamp(2.5rem, 5vw, 4rem);\n   351→            margin-bottom: 1.5rem;\n   352→            color: var(--color-jade-dark);\n   353→        }\n   354→\n   355→        .hero h1 span {\n   356→            color: var(--color-gold);\n   357→        }\n   358→\n   359→        .hero-subtitle {\n   360→            font-size: 1.1rem;\n   361→            color: var(--text-secondary);\n   362→            margin-bottom: 2rem;\n   363→            max-width: 500px;\n   364→        }\n   365→\n   366→        .hero-cta {\n   367→            display: flex;\n   368→            flex-wrap: wrap;\n   369→            gap: 1rem;\n   370→        }\n   371→\n   372→        .btn {\n   373→            display: inline-flex;\n   374→            align-items: center;\n   375→            gap: 0.5rem;\n   376→            padding: 1rem 1.8rem;\n   377→            border-radius: var(--radius-button);\n   378→            font-weight: 600;\n   379→            font-size: 0.95rem;\n   380→            cursor: pointer;\n   381→            transition: all var(--transition-base);\n   382→            border: none;\n   383→        }\n   384→\n   385→        .btn-primary {\n   386→            background: var(--color-jade);\n   387→            color: white;\n   388→            box-shadow: var(--shadow-md);\n   389→        }\n   390→\n   391→        .btn-primary:hover {\n   392→            background: var(--color-jade-light);\n   393→            transform: translateY(-2px);\n   394→            box-shadow: var(--shadow-gold);\n   395→        }\n   396→\n   397→        .btn-secondary {\n   398→            background: transparent;\n   399→            color: var(--color-jade);\n   400→            border: 2px solid var(--color-jade);\n   401→        }\n   402→\n   403→        .btn-secondary:hover {\n   404→            background: var(--color-jade);\n   405→            color: white;\n   406→        }\n   407→\n   408→        .hero-image {\n   409→            position: relative;\n   410→            opacity: 0;\n   411→            transform: translateX(30px);\n   412→            animation: fadeInRight 0.8s ease 0.2s forwards;\n   413→        }\n   414→\n   415→        .hero-image-wrapper {\n   416→            position: relative;\n   417→            border-radius: var(--radius-jade-1);\n   418→            overflow: hidden;\n   419→            box-shadow: var(--shadow-lg);\n   420→        }\n   421→\n   422→        .hero-image img {\n   423→            width: 100%;\n   424→            height: auto;\n   425→            object-fit: cover;\n   426→        }\n   427→\n   428→        .hero-image-accent {\n   429→            position: absolute;\n   430→            bottom: -20px;\n   431→            left: -20px;\n   432→            width: 150px;\n   433→            height: 150px;\n   434→            background: var(--color-gold);\n   435→            border-radius: var(--radius-jade-3);\n   436→            display: flex;\n   437→            align-items: center;\n   438→            justify-content: center;\n   439→            color: white;\n   440→            font-family: 'Crimson Pro', serif;\n   441→            font-size: 3rem;\n   442→            font-weight: 700;\n   443→            box-shadow: var(--shadow-gold);\n   444→        }\n   445→\n   446→        @keyframes fadeInUp {\n   447→            to {\n   448→                opacity: 1;\n   449→                transform: translateY(0);\n   450→            }\n   451→        }\n   452→\n   453→        @keyframes fadeInRight {\n   454→            to {\n   455→                opacity: 1;\n   456→                transform: translateX(0);\n   457→            }\n   458→        }\n   459→\n   460→        /* ============================================\n   461→           PROBLEM / SOLUTION SECTION\n   462→           ============================================ */\n   463→        .section {\n   464→            padding: var(--spacing-3xl) 1.5rem;\n   465→        }\n   466→\n   467→        .container {\n   468→            max-width: 1200px;\n   469→            margin: 0 auto;\n   470→        }\n   471→\n   472→        .section-header {\n   473→            text-align: center;\n   474→            margin-bottom: var(--spacing-2xl);\n   475→        }\n   476→\n   477→        .section-tag {\n   478→            display: inline-block;\n   479→            font-size: 0.85rem;\n   480→            font-weight: 600;\n   481→            color: var(--color-gold);\n   482→            text-transform: uppercase;\n   483→            letter-spacing: 2px;\n   484→            margin-bottom: 1rem;\n   485→        }\n   486→\n   487→        .section h2 {\n   488→            font-size: clamp(2rem, 4vw, 3rem);\n   489→            margin-bottom: 1rem;\n   490→            color: var(--color-jade-dark);\n   491→        }\n   492→\n   493→        .section-subtitle {\n   494→            font-size: 1.1rem;\n   495→            color: var(--text-secondary);\n   496→            max-width: 600px;\n   497→            margin: 0 auto;\n   498→        }\n   499→\n   500→        .problem-solution {\n   501→            display: grid;\n   502→            grid-template-columns: 1fr 1fr;\n   503→            gap: 3rem;\n   504→            align-items: stretch;\n   505→        }\n   506→\n   507→        .problem-card, .solution-card {\n   508→            background: white;\n   509→            padding: 2.5rem;\n   510→            border-radius: var(--radius-card);\n   511→            position: relative;\n   512→            overflow: hidden;\n   513→            transition: all var(--transition-base);\n   514→        }\n   515→\n   516→        .problem-card {\n   517→            border-left: 4px solid var(--color-jade-dark);\n   518→        }\n   519→\n   520→        .solution-card {\n   521→            border-left: 4px solid var(--color-gold);\n   522→        }\n   523→\n   524→        .problem-card::before, .solution-card::before {\n   525→            content: '';\n   526→            position: absolute;\n   527→            top: 0;\n   528→            right: 0;\n   529→            width: 200px;\n   530→            height: 200px;\n   531→            border-radius: var(--radius-jade-1);\n   532→            opacity: 0.05;\n   533→            pointer-events: none;\n   534→        }\n   535→\n   536→        .problem-card::before {\n   537→            background: var(--color-jade);\n   538→        }\n   539→\n   540→        .solution-card::before {\n   541→            background: var(--color-gold);\n   542→        }\n   543→\n   544→        .card-icon {\n   545→            width: 60px;\n   546→            height: 60px;\n   547→            display: flex;\n   548→            align-items: center;\n   549→            justify-content: center;\n   550→            border-radius: 50%;\n   551→            margin-bottom: 1.5rem;\n   552→            font-size: 1.5rem;\n   553→        }\n   554→\n   555→        .problem-card .card-icon {\n   556→            background: var(--color-jade-mist);\n   557→            color: var(--color-jade);\n   558→        }\n   559→\n   560→        .solution-card .card-icon {\n   561→            background: var(--color-gold-shimmer);\n   562→            color: var(--color-gold-dark);\n   563→        }\n   564→\n   565→        .problem-card h3, .solution-card h3 {\n   566→            font-size: 1.5rem;\n   567→            margin-bottom: 1rem;\n   568→        }\n   569→\n   570→        .problem-card h3 {\n   571→            color: var(--color-jade-dark);\n   572→        }\n   573→\n   574→        .solution-card h3 {\n   575→            color: var(--color-gold-dark);\n   576→        }\n   577→\n   578→        .problem-list, .solution-list {\n   579→            list-style: none;\n   580→        }\n   581→\n   582→        .problem-list li, .solution-list li {\n   583→            padding: 0.5rem 0;\n   584→            padding-left: 1.5rem;\n   585→            position: relative;\n   586→            color: var(--text-secondary);\n   587→        }\n   588→\n   589→        .problem-list li::before {\n   590→            content: '×';\n   591→            position: absolute;\n   592→            left: 0;\n   593→            color: var(--color-jade-dark);\n   594→            font-weight: bold;\n   595→        }\n   596→\n   597→        .solution-list li::before {\n   598→            content: '✓';\n   599→            position: absolute;\n   600→            left: 0;\n   601→            color: var(--color-gold);\n   602→            font-weight: bold;\n   603→        }\n   604→\n   605→        /* ============================================\n   606→           SERVICES SECTION\n   607→           ============================================ */\n   608→        .services {\n   609→            background: var(-