r(--color-jade-dark);\n   665→        }\n   666→\n   667→        .service-card p {\n   668→            color: var(--text-secondary);\n   669→            margin-bottom: 1.5rem;\n   670→            font-size: 0.95rem;\n   671→        }\n   672→\n   673→        .service-link {\n   674→            display: inline-flex;\n   675→            align-items: center;\n   676→            gap: 0.5rem;\n   677→            color: var(--color-jade);\n   678→            font-weight: 600;\n   679→            font-size: 0.9rem;\n   680→            transition: all var(--transition-fast);\n   681→        }\n   682→\n   683→        .service-link:hover {\n   684→            color: var(--color-gold);\n   685→            gap: 0.8rem;\n   686→        }\n   687→\n   688→        /* ============================================\n   689→           TESTIMONIALS SECTION\n   690→           ============================================ */\n   691→        .testimonials {\n   692→            background: var(--color-jade);\n   693→            color: white;\n   694→            position: relative;\n   695→            overflow: hidden;\n   696→        }\n   697→\n   698→        .testimonials::before {\n   699→            content: '';\n   700→            position: absolute;\n   701→            top: 0;\n   702→            left: 0;\n   703→            width: 100%;\n   704→            height: 100%;\n   705→            background: url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\");\n   706→            opacity: 0.5;\n   707→        }\n   708→\n   709→        .testimonials .section-tag {\n   710→            color: var(--color-gold-shimmer);\n   711→        }\n   712→\n   713→        .testimonials h2 {\n   714→            color: white;\n   715→        }\n   716→\n   717→        .testimonials .section-subtitle {\n   718→            color: rgba(255, 255, 255, 0.8);\n   719→        }\n   720→\n   721→        .testimonials-grid {\n   722→            display: grid;\n   723→            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n   724→            gap: 2rem;\n   725→            position: relative;\n   726→            z-index: 1;\n   727→        }\n   728→\n   729→        .testimonial-card {\n   730→            background: rgba(255, 255, 255, 0.1);\n   731→            backdrop-filter: blur(10px);\n   732→            border-radius: var(--radius-card);\n   733→            padding: 2rem;\n   734→            border: 1px solid rgba(255, 255, 255, 0.2);\n   735→            transition: all var(--transition-base);\n   736→        }\n   737→\n   738→        .testimonial-card:hover {\n   739→            background: rgba(255, 255, 255, 0.15);\n   740→            transform: translateY(-4px);\n   741→        }\n   742→\n   743→        .testimonial-stars {\n   744→            color: var(--color-gold);\n   745→            font-size: 1.2rem;\n   746→            margin-bottom: 1rem;\n   747→        }\n   748→\n   749→        .testimonial-text {\n   750→            font-size: 1rem;\n   751→            line-height: 1.7;\n   752→            margin-bottom: 1.5rem;\n   753→            color: rgba(255, 255, 255, 0.95);\n   754→        }\n   755→\n   756→        .testimonial-author {\n   757→            display: flex;\n   758→            align-items: center;\n   759→            gap: 1rem;\n   760→        }\n   761→\n   762→        .testimonial-avatar {\n   763→            width: 50px;\n   764→            height: 50px;\n   765→            background: linear-gradient(135deg, var(--color-gold), var(--color-gold-light));\n   766→            border-radius: 50%;\n   767→            display: flex;\n   768→            align-items: center;\n   769→            justify-content: center;\n   770→            font-weight: 700;\n   771→            color: var(--color-jade);\n   772→        }\n   773→\n   774→        .testimonial-info h4 {\n   775→            font-size: 1rem;\n   776→            color: white;\n   777→            margin-bottom: 0.2rem;\n   778→        }\n   779→\n   780→        .testimonial-info p {\n   781→            font-size: 0.85rem;\n   782→            color: rgba(255, 255, 255, 0.7);\n   783→        }\n   784→\n   785→        /* ============================================\n   786→           DIFFERENTIALS SECTION\n   787→           ============================================ */\n   788→        .differentials-grid {\n   789→            display: grid;\n   790→            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n   791→            gap: 2rem;\n   792→        }\n   793→\n   794→        .differential-item {\n   795→            display: flex;\n   796→            align-items: flex-start;\n   797→            gap: 1rem;\n   798→            padding: 1.5rem;\n   799→            border-radius: var(--radius-card);\n   800→            transition: all var(--transition-base);\n   801→        }\n   802→\n   803→        .differential-item:hover {\n   804→            background: white;\n   805→            box-shadow: var(--shadow-md);\n   806→        }\n   807→\n   808→        .differential-icon {\n   809→            width: 50px;\n   810→            height: 50px;\n   811→            background: var(--color-jade-mist);\n   812→            border-radius: var(--radius-jade-2);\n   813→            display: flex;\n   814→            align-items: center;\n   815→            justify-content: center;\n   816→            flex-shrink: 0;\n   817→            position: relative;\n   818→        }\n   819→\n   820→        .differential-icon::after {\n   821→            content: '';\n   822→            position: absolute;\n   823→            top: -4px;\n   824→            left: -4px;\n   825→            right: -4px;\n   826→            bottom: -4px;\n   827→            border: 2px solid var(--color-gold);\n   828→            border-radius: var(--radius-jade-2);\n   829→            opacity: 0;\n   830→            animation: pulse-ring 2s ease-in-out infinite;\n   831→        }\n   832→\n   833→        @keyframes pulse-ring {\n   834→            0% {\n   835→                transform: scale(1);\n   836→                opacity: 0.5;\n   837→            }\n   838→            100% {\n   839→                transform: scale(1.2);\n   840→                opacity: 0;\n   841→            }\n   842→        }\n   843→\n   844→        .differential-content h3 {\n   845→            font-size: 1.1rem;\n   846→            margin-bottom: 0.5rem;\n   847→            color: var(--color-jade-dark);\n   848→        }\n   849→\n   850→        .differential-content p {\n   851→            font-size: 0.9rem;\n   852→            color: var(--text-secondary);\n   853→        }\n   854→\n   855→        /* ============================================\n   856→           CONTACT SECTION\n   857→           ============================================ */\n   858→        .contact {\n   859→            background: var(--color-rice-warm);\n   860→        }\n   861→\n   862→        .contact-wrapper {\n   863→            display: grid;\n   864→            grid-template-columns: 1fr 1fr;\n   865→            gap: 4rem;\n   866→            align-items: start;\n   867→        }\n   868→\n   869→        .contact-info h3 {\n   870→            font-size: 1.8rem;\n   871→            margin-bottom: 1rem;\n   872→            color: var(--color-jade-dark);\n   873→        }\n   874→\n   875→        .contact-info p {\n   876→            color: var(--text-secondary);\n   877→            margin-bottom: 2rem;\n   878→        }\n   879→\n   880→        .contact-details {\n   881→            display: flex;\n   882→            flex-direction: column;\n   883→            gap: 1.5rem;\n   884→        }\n   885→\n   886→        .contact-item {\n   887→      