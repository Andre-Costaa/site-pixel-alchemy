{"type":"assistant","message":{"id":"msg_20260209033117d606f6df851d43a8","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_1be58566426143ac8cfaa72c","name":"Write","input":{"file_path":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-fernanda-nirschl/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Fernanda Nirschl | Harmonização Facial e Estética Avançada em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Fernanda Nirschl - Harmonização Facial e Estética Avançada especializada em Ribeirão Preto. Atendimento personalizado com técnicas avançadas de estética facial.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           CSS VARIABLES - Obsidian Noir & Champagne Quartz\n           ============================================ */\n        :root {\n            /* Primary Palette - Obsidian Noir */\n            --color-obsidian: #0D0D0F;\n            --color-obsidian-light: #1A1A1F;\n            --color-obsidian-mid: #252530;\n            --color-obsidian-dark: #08080A;\n            --color-obsidian-deep: #050507;\n\n            /* Accent Palette - Champagne Quartz */\n            --color-champagne: #D4B896;\n            --color-champagne-light: #E8D4B8;\n            --color-champagne-mid: #F0E0C8;\n            --color-champagne-dark: #C4A878;\n            --color-champagne-deep: #B49868;\n            --color-champagne-shimmer: #F8F0E0;\n\n            /* Crystal Accent - Quartz */\n            --color-quartz: #E8E0D8;\n            --color-quartz-rose: #F0E8E0;\n            --color-quartz-warm: #F5F0E8;\n\n            /* Text Colors */\n            --color-text-primary: #FAFAF8;\n            --color-text-secondary: #C8C8C0;\n            --color-text-muted: #888888;\n            --color-text-on-light: #1A1A1F;\n\n            /* Gradients */\n            --gradient-obsidian: linear-gradient(135deg, var(--color-obsidian) 0%, var(--color-obsidian-light) 100%);\n            --gradient-champagne: linear-gradient(135deg, var(--color-champagne) 0%, var(--color-champagne-light) 100%);\n            --gradient-quartz: linear-gradient(135deg, var(--color-quartz) 0%, var(--color-quartz-rose) 100%);\n            --gradient-hero: linear-gradient(135deg, #0D0D0F 0%, #1A1A1F 50%, #252530 100%);\n            --gradient-accent: linear-gradient(135deg, var(--color-champagne) 0%, var(--color-champagne-shimmer) 100%);\n\n            /* Quartz Crystal Border Radius Shapes */\n            --radius-crystal-1: 72% 28% 48% 52% / 52% 38% 62% 48%;\n            --radius-crystal-2: 48% 52% 68% 32% / 38% 62% 38% 62%;\n            --radius-crystal-3: 62% 38% 42% 58% / 58% 42% 52% 48%;\n            --radius-crystal-4: 38% 62% 52% 48% / 42% 58% 48% 52%;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Typography */\n            --font-display: 'Libre Baskerville', Georgia, serif;\n            --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(0, 0, 0, 0.3);\n            --shadow-medium: 0 8px 30px rgba(0, 0, 0, 0.4);\n            --shadow-strong: 0 12px 40px rgba(0, 0, 0, 0.5);\n            --shadow-glow: 0 0 30px rgba(212, 184, 150, 0.3);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.7;\n            color: var(--color-text-primary);\n            background: var(--color-obsidian);\n            overflow-x: hidden;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-text-primary);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-secondary);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-sm) var(--spacing-md);\n            background: rgba(13, 13, 15, 0.95);\n            backdrop-filter: blur(20px);\n            transition: transform 0.3s ease;\n            box-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-champagne);\n            text-decoration: none;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-secondary);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-champagne);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover {\n            color: var(--color-champagne);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--gradient-champagne);\n            color: var(--color-obsidian) !important;\n            padding: 0.75rem 1.5rem;\n            border-radius: 50px;\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-champagne);\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-crystal-1);\n            opacity: 0.15;\n            filter: blur(60px);\n            animation: float 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-champagne);\n            top: -200px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .blob-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-quartz);\n            bottom: -150px;\n            left: -100px;\n            animation-delay: -5s;\n            border-radius: var(--radius-crystal-2);\n        }\n\n        .blob-3 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(135deg, var(--color-champagne) 0%, var(--color-quartz) 100%);\n            top: 50%;\n            left: 20%;\n            animation-delay: -10s;\n            border-radius: var(--radius-crystal-3);\n            opacity: 0.1;\n        }\n\n        .blob-4 {\n            width: 250px;\n            height: 250px;\n            background: linear-gradient(135deg, var(--color-champagne-light) 0%, var(--color-quartz-rose) 100%);\n            bottom: 20%;\n            right: 15%;\n            animation-delay: -15s;\n            border-radius: var(--radius-crystal-4);\n            opacity: 0.12;\n        }\n\n        @keyframes float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg) scale(1.05);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg) scale(0.95);\n            }\n            75% {\n                transform: translate(-30px, -20px) rotate(3deg) scale(1.02);\n            }\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 10;\n            max-width: 800px;\n            text-align: center;\n            animation: fadeInUp 1s ease-out;\n        }\n\n        .hero-badge {\n            display: inline-block;\n            padding: 0.5rem 1.5rem;\n            background: rgba(212, 184, 150, 0.15);\n            border: 1px solid var(--color-champagne);\n            border-radius: 50px;\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-champagne);\n            margin-bottom: var(--spacing-md);\n            animation: fadeInUp 1s ease-out 0.2s both;\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            animation: fadeInUp 1s ease-out 0.4s both;\n        }\n\n        .hero-title span {\n            background: var(--gradient-champagne);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: clamp(1.1rem, 2vw, 1.4rem);\n            color: var(--color-text-secondary);\n            margin-bottom: var(--spacing-lg);\n            animation: fadeInUp 1s ease-out 0.6s both;\n        }\n\n        .hero-cta {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            background: var(--gradient-champagne);\n            color: var(--color-obsidian);\n            text-decoration: none;\n            font-weight: 600;\n            border-radius: 50px;\n            transition: all var(--transition-base);\n            animation: fadeInUp 1s ease-out 0.8s both;\n        }\n\n        .hero-cta:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .hero-image {\n            position: absolute;\n            right: 5%;\n            top: 50%;\n            transform: translateY(-50%);\n            width: 400px;\n            height: 500px;\n            background: url('https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=800&q=80') center/cover;\n            border-radius: var(--radius-crystal-1);\n            opacity: 0.8;\n            animation: fadeInRight 1s ease-out 0.6s both;\n        }\n\n        .hero-image-overlay {\n            position: absolute;\n            inset: 0;\n            background: var(--gradient-obsidian);\n            opacity: 0.3;\n            border-radius: inherit;\n        }\n\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fadeInRight {\n            from {\n                opacity: 0;\n                transform: translateY(-50%) translateX(50px);\n            }\n            to {\n                opacity: 0.8;\n                transform: translateY(-50%) translateX(0);\n            }\n        }\n\n        /* ============================================\n           SECTIONS\n           ============================================ */\n        .section {\n            padding: var(--spacing-xl) var(--spacing-md);\n            position: relative;\n        }\n\n        .section-light {\n            background: var(--color-quartz-warm);\n            color: var(--color-text-on-light);\n        }\n\n        .section-dark {\n            background: var(--color-obsidian);\n        }\n\n        .section-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .section-header h2 {\n            color: var(--color-champagne);\n        }\n\n        .section-light .section-header h2 {\n            color: var(--color-obsidian);\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .problem-card, .solution-card {\n            padding: var(--spacing-md);\n            border-radius: var(--radius-crystal-1);\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .problem-card {\n            background: var(--color-obsidian-light);\n            border-left: 3px solid #C44;\n        }\n\n        .solution-card {\n            background: var(--color-obsidian-mid);\n            border-left: 3px solid var(--color-champagne);\n        }\n\n        .problem-card:hover, .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .card-icon {\n            font-size: 2rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .card-title {\n            font-family: var(--font-display);\n            font-size: 1.3rem;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-text-primary);\n        }\n\n        .card-text {\n            color: var(--color-text-secondary);\n            font-size: 0.95rem;\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .service-card {\n            background: var(--color-obsidian-light);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-crystal-2);\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 3px;\n            background: var(--gradient-champagne);\n            transform: scaleX(0);\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-champagne);\n            border-radius: var(--radius-crystal-3);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.5rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-title {\n            font-family: var(--font-display);\n            font-size: 1.4rem;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-champagne);\n        }\n\n        .service-description {\n            color: var(--color-text-secondary);\n            font-size: 0.95rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-link {\n            color: var(--color-champagne);\n            text-decoration: none;\n            font-weight: 600;\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            transition: gap var(--transition-fast);\n        }\n\n        .service-link:hover {\n            gap: 1rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .testimonial-card {\n            background: var(--color-obsidian-mid);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-crystal-1);\n            position: relative;\n        }\n\n        .testimonial-stars {\n            color: var(--color-champagne);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .testimonial-text {\n            font-style: italic;\n            color: var(--color-text-secondary);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: var(--gradient-champagne);\n        }\n\n        .testimonial-name {\n            font-family: var(--font-display);\n            font-weight: 600;\n            color: var(--color-champagne);\n        }\n\n        .testimonial-role {\n            font-size: 0.85rem;\n            color: var(--color-text-muted);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-md);\n            position: relative;\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            display: inline-block;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .differential-icon {\n            width: 70px;\n            height: 70px;\n            background: var(--gradient-champagne);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.8rem;\n            position: relative;\n            z-index: 2;\n        }\n\n        .differential-ring {\n            position: absolute;\n            inset: -10px;\n            border: 2px solid var(--color-champagne);\n            border-radius: 50%;\n            opacity: 0.3;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        .differential-ring:nth-child(2) {\n            inset: -20px;\n            animation-delay: 0.5s;\n        }\n\n        @keyframes pulse {\n            0%, 100% {\n                transform: scale(1);\n                opacity: 0.3;\n            }\n            50% {\n                transform: scale(1.1);\n                opacity: 0.1;\n            }\n        }\n\n        .differential-title {\n            font-family: var(--font-display);\n            font-size: 1.2rem;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-champagne);\n        }\n\n        .differential-text {\n            color: var(--color-text-secondary);\n            font-size: 0.9rem;\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact-wrapper {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n            margin-top: var(--spacing-lg);\n        }\n\n        .contact-info {\n            background: var(--color-obsidian-light);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-crystal-1);\n        }\n\n        .contact-info-item {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-sm);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-icon {\n            width: 40px;\n            height: 40px;\n            background: var(--gradient-champagne);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n        }\n\n        .contact-label {\n            font-weight: 600;\n            color: var(--color-champagne);\n            margin-bottom: 0.25rem;\n        }\n\n        .contact-value {\n            color: var(--color-text-secondary);\n        }\n\n        .contact-form {\n            background: var(--color-obsidian-light);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-crystal-2);\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .form-label {\n            display: block;\n            margin-bottom: 0.5rem;\n            font-weight: 500;\n            color: var(--color-champagne);\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 0.875rem 1rem;\n            background: var(--color-obsidian);\n            border: 1px solid var(--color-obsidian-mid);\n            border-radius: 10px;\n            color: var(--color-text-primary);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: border-color var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-champagne);\n            box-shadow: 0 0 0 3px rgba(212, 184, 150, 0.2);\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1rem 2rem;\n            background: var(--gradient-champagne);\n            color: var(--color-obsidian);\n            border: none;\n            border-radius: 50px;\n            font-size: 1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all var(--transition-base);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--color-obsidian-deep);\n            padding: var(--spacing-lg) var(--spacing-md);\n            border-top: 1px solid var(--color-obsidian-mid);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-lg);\n        }\n\n        .footer-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-champagne);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-text {\n            color: var(--color-text-muted);\n            font-size: 0.9rem;\n        }\n\n        .footer-title {\n            font-family: var(--font-display);\n            font-size: 1.1rem;\n            color: var(--color-champagne);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-links {\n            list-style: none;\n        }\n\n        .footer-link {\n            color: var(--color-text-secondary);\n            text-decoration: none;\n            display: block;\n            padding: 0.5rem 0;\n            transition: color var(--transition-fast);\n        }\n\n        .footer-link:hover {\n            color: var(--color-champagne);\n        }\n\n        .footer-bottom {\n            text-align: center;\n            padding-top: var(--spacing-md);\n            margin-top: var(--spacing-md);\n            border-top: 1px solid var(--color-obsidian-mid);\n            color: var(--color-text-muted);\n            font-size: 0.85rem;\n        }\n\n        /* ============================================\n           ANIMATION CLASSES\n           ============================================ */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.6s ease;\n        }\n\n        .wow-fade-in.visible {\n            opacity: 1;\n        }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 1024px) {\n            .hero-image {\n                width: 300px;\n                height: 380px;\n            }\n\n            .contact-wrapper {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                right: 0;\n                flex-direction: column;\n                background: var(--color-obsidian);\n                padding: var(--spacing-md);\n                transform: translateX(-100%);\n                transition: transform var(--transition-base);\n            }\n\n            .nav-menu.active {\n                transform: translateX(0);\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n\n            .hero {\n                padding: var(--spacing-lg) var(--spacing-sm);\n                text-align: center;\n            }\n\n            .hero-image {\n                position: relative;\n                right: auto;\n                top: auto;\n                transform: none;\n                width: 100%;\n                max-width: 350px;\n                height: 400px;\n                margin: var(--spacing-md) auto 0;\n            }\n\n            .section {\n                padding: var(--spacing-lg) var(--spacing-sm);\n            }\n\n            .problem-solution-grid,\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        @media (max-width: 480px) {\n            h1 {\n                font-size: 2rem;\n            }\n\n            h2 {\n                font-size: 1.75rem;\n            }\n\n            .hero-cta {\n                width: 100%;\n                justify-content: center;\n            }\n        }\n\n        /* ============================================\n           ACCESSIBILITY\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        :focus-visible {\n            outline: 2px solid var(--color-champagne);\n            outline-offset: 2px;\n        }\n\n        /* Skip link for accessibility */\n        .skip-link {\n            position: absolute;\n            top: -40px;\n            left: 0;\n            background: var(--color-champagne);\n            color: var(--color-obsidian);\n            padding: 8px 16px;\n            text-decoration: none;\n            z-index: 9999;\n        }\n\n        .skip-link:focus {\n            top: 0;\n        }\n    </style>\n</head>\n<body>\n    <a href=\"#main-content\" class=\"skip-link\">Pular para o conteúdo principal</a>\n\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Fernanda Nirschl</a>\n            <ul class=\"nav-menu\" id=\"nav-menu\">\n                <li><a href=\"#inicio\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contato\" class=\"nav-link nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <button class=\"nav-toggle\" id=\"nav-toggle\" aria-label=\"Abrir menu\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-blob blob-1\"></div>\n        <div class=\"hero-blob blob-2\"></div>\n        <div class=\"hero-blob blob-3\"></div>\n        <div class=\"hero-blob blob-4\"></div>\n\n        <div class=\"hero-content\">\n            <span class=\"hero-badge\">✦ Estética Avançada em Ribeirão Preto</span>\n            <h1 class=\"hero-title\">\n                Harmonização Facial que <span>Realça sua Beleza Natural</span>\n            </h1>\n            <p class=\"hero-subtitle\">\n                Transforme sua aparência com tratamentos personalizados que combinam precisão técnica e sensibilidade estética.\n            </p>\n            <a href=\"#contato\" class=\"hero-cta\">\n                Agendar Avaliação\n                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                    <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                </svg>\n            </a>\n        </div>\n\n        <div class=\"hero-image\">\n            <div class=\"hero-image-overlay\"></div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section section-dark\" id=\"problema-solucao\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <h2>Sua Jornada de Transformação</h2>\n                <p>Entendemos suas necessidades e oferecemos soluções personalizadas</p>\n            </div>\n\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card wow-fade-up\">\n                    <div class=\"card-icon\">😔</div>\n                    <h3 class=\"card-title\">O Desafio</h3>\n                    <p class=\"card-text\">Sinais de envelhecimento, perda de contorno facial ou assimetrias que afetam sua autoestima e confiança.</p>\n                </div>\n\n                <div class=\"problem-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"card-icon\">🔍</div>\n                    <h3 class=\"card-title\">A Avaliação</h3>\n                    <p class=\"card-text\">Análise detalhada de suas características faciais, entendendo seus objetivos e expectativas únicas.</p>\n                </div>\n\n                <div class=\"solution-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"card-icon\">✨</div>\n                    <h3 class=\"card-title\">A Solução</h3>\n                    <p class=\"card-text\">Protocolos personalizados que realçam sua beleza natural com resultados harmoniosos e naturais.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section section-light\" id=\"servicos\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <h2>Tratamentos Especializados</h2>\n                <p>Soluções avançadas para harmonização facial e estética</p>\n            </div>\n\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">💎</div>\n                    <h3 class=\"service-title\">Harmonização Facial</h3>\n                    <p class=\"service-description\">Equilíbrio dos traços faciais com técnicas avançadas para resultados naturais e harmoniosos.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"100\">\n                    <div class=\"service-icon\">💉</div>\n                    <h3 class=\"service-title\">Toxina Botulínica</h3>\n                    <p class=\"service-description\">Suavização de rugas e linhas de expressão com aplicação precisa e personalizada.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"service-icon\">✨</div>\n                    <h3 class=\"service-title\">Preenchedores Faciais</h3>\n                    <p class=\"service-description\">Restauração de volume e contorno facial com ácido hialurônico de alta qualidade.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"300\">\n                    <div class=\"service-icon\">👄</div>\n                    <h3 class=\"service-title\">Preenchimento Labial</h3>\n                    <p class=\"service-description\">Aumento e modelagem dos lábios com resultados naturais e equilibrados.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"service-icon\">🌟</div>\n                    <h3 class=\"service-title\">Bioestimuladores</h3>\n                    <p class=\"service-description\">Estímulo de colágeno para rejuvenescimento progressivo e duradouro da pele.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"500\">\n                    <div class=\"service-icon\">🎯</div>\n                    <h3 class=\"service-title\">Protocolos Personalizados</h3>\n                    <p class=\"service-description\">Tratamentos exclusivos desenvolvidos especificamente para suas necessidades.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section section-dark\" id=\"depoimentos\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <h2>O Que Nossas Pacientes Dizem</h2>\n                <p>Histórias reais de transformação e satisfação</p>\n            </div>\n\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"A Dra. Fernanda é excepcional! Fiz minha harmonização facial e o resultado superou minhas expectativas. Muito profissional e atenciosa.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\"></div>\n                        <div>\n                            <div class=\"testimonial-name\">Maria Silva</div>\n                            <div class=\"testimonial-role\">Empresária</div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Finalmente encontrei uma profissional que entende o que eu queria. Resultado natural e muito bonito. Recomendo de olhos fechados!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\"></div>\n                        <div>\n                            <div class=\"testimonial-name\">Ana Costa</div>\n                            <div class=\"testimonial-role\">Advogada</div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"O atendimento é impecável desde o primeiro contato. A Dra. Fernanda tem mãos de fada e um olhar estético refinado.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\"></div>\n                        <div>\n                            <div class=\"testimonial-name\">Juliana Mendes</div>\n                            <div class=\"testimonial-role\">Arquiteta</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section section-light\" id=\"diferenciais\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <h2>Por Que Escolher a Dra. Fernanda</h2>\n                <p>Diferenciais que fazem a diferença no seu resultado</p>\n            </div>\n\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-icon\">🎓</div>\n                    </div>\n                    <h3 class=\"differential-title\">Formação Especializada</h3>\n                    <p class=\"differential-text\">Atualização constante com as mais avançadas técnicas de harmonização facial.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"100\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-icon\">🎯</div>\n                    </div>\n                    <h3 class=\"differential-title\">Atendimento Personalizado</h3>\n                    <p class=\"differential-text\">Cada tratamento é único e desenvolvido exclusivamente para você.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"200\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-icon\">✨</div>\n                    </div>\n                    <h3 class=\"differential-title\">Resultados Naturais</h3>\n                    <p class=\"differential-text\">Técnicas que realçam sua beleza sem parecer artificial.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"300\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-icon\">🏥</div>\n                    </div>\n                    <h3 class=\"differential-title\">Ambiente Seguro</h3>\n                    <p class=\"differential-text\">Clínica equipada com materiais de alta qualidade e protocolos rigorosos.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"400\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-icon\">💬</div>\n                    </div>\n                    <h3 class=\"differential-title\">Acompanhamento Completo</h3>\n                    <p class=\"differential-text\">Suporte total antes, durante e depois dos procedimentos.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"500\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-icon\">⏰</div>\n                    </div>\n                    <h3 class=\"differential-title\">Pontualidade</h3>\n                    <p class=\"differential-text\">Respeito pelo seu tempo com agendamentos eficientes.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section section-dark\" id=\"contato\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <h2>Agende sua Consulta</h2>\n                <p>Dê o primeiro passo para sua transformação</p>\n            </div>\n\n            <div class=\"contact-wrapper\">\n                <div class=\"contact-info wow-fade-up\">\n                    <div class=\"contact-info-item\">\n                        <div class=\"contact-icon\">📍</div>\n                        <div>\n                            <div class=\"contact-label\">Endereço</div>\n                            <div class=\"contact-value\">Av. Leais Paulista, 864 - Jardim Irajá<br>Ribeirão Preto - SP, 14020-650</div>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-info-item\">\n                        <div class=\"contact-icon\">📞</div>\n                        <div>\n                            <div class=\"contact-label\">Telefone / WhatsApp</div>\n                            <div class=\"contact-value\">(16) 99725-2814</div>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-info-item\">\n                        <div class=\"contact-icon\">⏰</div>\n                        <div>\n                            <div class=\"contact-label\">Horário de Atendimento</div>\n                            <div class=\"contact-value\">Segunda a Sexta: 9h às 18h<br>Sábados: 9h às 13h</div>\n                        </div>\n                    </div>\n                </div>\n\n                <form class=\"contact-form wow-fade-up\" id=\"contactForm\">\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"name\">Nome Completo</label>\n                        <input type=\"text\" class=\"form-input\" id=\"name\" name=\"name\" required>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"phone\">Telefone / WhatsApp</label>\n                        <input type=\"tel\" class=\"form-input\" id=\"phone\" name=\"phone\" required>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"service\">Tratamento de Interesse</label>\n                        <select class=\"form-select\" id=\"service\" name=\"service\" required>\n                            <option value=\"\">Selecione uma opção</option>\n                            <option value=\"harmonizacao-facial\">Harmonização Facial</option>\n                            <option value=\"toxina-botulinica\">Toxina Botulínica</option>\n                            <option value=\"preenchedores-faciais\">Preenchedores Faciais</option>\n                            <option value=\"preenchimento-labial\">Preenchimento Labial</option>\n                            <option value=\"bioestimuladores\">Bioestimuladores</option>\n                            <option value=\"protocolos\">Protocolos Personalizados</option>\n                            <option value=\"outro\">Outro</option>\n                        </select>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"message\">Mensagem (opcional)</label>\n                        <textarea class=\"form-textarea\" id=\"message\" name=\"message\" placeholder=\"Conte-nos mais sobre suas expectativas...\"></textarea>\n                    </div>\n\n                    <button type=\"submit\" class=\"form-submit\">Agendar Consulta</button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div>\n                <div class=\"footer-logo\">Dra. Fernanda Nirschl</div>\n                <p class=\"footer-text\">Harmonização Facial e Estética Avançada em Ribeirão Preto. Transformando vidas através da autoestima.</p>\n            </div>\n\n            <div>\n                <h4 class=\"footer-title\">Links Rápidos</h4>\n                <ul class=\"footer-links\">\n                    <li><a href=\"#inicio\" class=\"footer-link\">Início</a></li>\n                    <li><a href=\"#servicos\" class=\"footer-link\">Serviços</a></li>\n                    <li><a href=\"#depoimentos\" class=\"footer-link\">Depoimentos</a></li>\n                    <li><a href=\"#contato\" class=\"footer-link\">Contato</a></li>\n                </ul>\n            </div>\n\n            <div>\n                <h4 class=\"footer-title\">Tratamentos</h4>\n                <ul class=\"footer-links\">\n                    <li><a href=\"#servicos\" class=\"footer-link\">Harmonização Facial</a></li>\n                    <li><a href=\"#servicos\" class=\"footer-link\">Toxina Botulínica</a></li>\n                    <li><a href=\"#servicos\" class=\"footer-link\">Preenchedores</a></li>\n                    <li><a href=\"#servicos\" class=\"footer-link\">Bioestimuladores</a></li>\n                </ul>\n            </div>\n        </div>\n\n        <div class=\"footer-bottom\">\n            <p>&copy; 2024 Dra. Fernanda Nirschl. Todos os direitos reservados.</p>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION - Auto-hide on scroll\n        // ============================================\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > lastScroll && currentScroll > 100) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // ============================================\n        // MOBILE MENU\n        // ============================================\n        const navToggle = document.getElementById('nav-toggle');\n        const navMenu = document.getElementById('nav-menu');\n        const navLinks = document.querySelectorAll('.nav-link');\n\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        navLinks.forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function (e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER - Scroll Animations\n        // ============================================\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || 0;\n                    setTimeout(() => {\n                        entry.target.classList.add('visible');\n                    }, delay);\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // PARALLAX EFFECT - Hero blobs\n        // ============================================\n        const hero = document.querySelector('.hero');\n        const blobs = document.querySelectorAll('.hero-blob');\n\n        hero.addEventListener('mousemove', (e) => {\n            const { clientX, clientY } = e;\n            const { innerWidth, innerHeight } = window;\n\n            const xPercent = (clientX / innerWidth - 0.5) * 2;\n            const yPercent = (clientY / innerHeight - 0.5) * 2;\n\n            blobs.forEach((blob, index) => {\n                const speed = (index + 1) * 10;\n                const x = xPercent * speed;\n                const y = yPercent * speed;\n                blob.style.transform = `translate(${x}px, ${y}px)`;\n            });\n        });\n\n        // ============================================\n        // CONTACT FORM - WhatsApp Integration\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceMap = {\n                'harmonizacao-facial': 'Harmonização Facial',\n                'toxina-botulinica': 'Toxina Botulínica',\n                'preenchedores-faciais': 'Preenchedores Faciais',\n                'preenchimento-labial': 'Preenchimento Labial',\n                'bioestimuladores': 'Bioestimuladores',\n                'protocolos': 'Protocolos Personalizados',\n                'outro': 'Outro'\n            };\n\n            const whatsappMessage = encodeURIComponent(\n                `Olá! Me chamo ${name}.\\n\\n` +\n                `Telefone: ${phone}\\n` +\n                `Interesse: ${serviceMap[service] || service}\\n` +\n                `${message ? `Mensagem: ${message}` : ''}\\n\\n` +\n                `Gostaria de agendar uma consulta.`\n            );\n\n            const whatsappUrl = `https://wa.me/5516997252814?text=${whatsappMessage}`;\n            window.open(whatsappUrl, '_blank');\n        });\n\n        // ============================================\n        // PREFERS REDUCED MOTION\n        // ============================================\n        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n            document.querySelectorAll('.hero-blob').forEach(blob => {\n                blob.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"5ff95dba-e97b-438d-8f46-20c21e418dd8","uuid":"b365b9f7-9e43-43da-af1e-c26e53dbd0f5"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_1be58566426143ac8cfaa72c","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-fernanda-nirschl/index.html"}]},"parent_tool_use_id":null,"session_id":"5ff95dba-e97b-438d-8f46-20c21e418dd8","uuid":"69d09a55-892c-4001-bd77-ef5fb1069a6b","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-fernanda-nirschl/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Fernanda Nirschl | Harmonização Facial e Estética Avançada em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Fernanda Nirschl - Harmonização Facial e Estética Avançada especializada em Ribeirão Preto. Atendimento personalizado com técnicas avançadas de estética facial.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           CSS VARIABLES - Obsidian Noir & Champagne Quartz\n           ============================================ */\n        :root {\n            /* Primary Palette - Obsidian Noir */\n            --color-obsidian: #0D0D0F;\n            --color-obsidian-light: #1A1A1F;\n            --color-obsidian-mid: #252530;\n            --color-obsidian-dark: #08080A;\n            --color-obsidian-deep: #050507;\n\n            /* Accent Palette - Champagne Quartz */\n            --color-champagne: #D4B896;\n            --color-champagne-light: #E8D4B8;\n            --color-champagne-mid: #F0E0C8;\n            --color-champagne-dark: #C4A878;\n            --color-champagne-deep: #B49868;\n            --color-champagne-shimmer: #F8F0E0;\n\n            /* Crystal Accent - Quartz */\n            --color-quartz: #E8E0D8;\n            --color-quartz-rose: #F0E8E0;\n            --color-quartz-warm: #F5F0E8;\n\n            /* Text Colors */\n            --color-text-primary: #FAFAF8;\n            --color-text-secondary: #C8C8C0;\n            --color-text-muted: #888888;\n            --color-text-on-light: #1A1A1F;\n\n            /* Gradients */\n            --gradient-obsidian: linear-gradient(135deg, var(--color-obsidian) 0%, var(--color-obsidian-light) 100%);\n            --gradient-champagne: linear-gradient(135deg, var(--color-champagne) 0%, var(--color-champagne-light) 100%);\n            --gradient-quartz: linear-gradient(135deg, var(--color-quartz) 0%, var(--color-quartz-rose) 100%);\n            --gradient-hero: linear-gradient(135deg, #0D0D0F 0%, #1A1A1F 50%, #252530 100%);\n            --gradient-accent: linear-gradient(135deg, var(--color-champagne) 0%, var(--color-champagne-shimmer) 100%);\n\n            /* Quartz Crystal Border Radius Shapes */\n            --radius-crystal-1: 72% 28% 48% 52% / 52% 38% 62% 48%;\n            --radius-crystal-2: 48% 52% 68% 32% / 38% 62% 38% 62%;\n            --radius-crystal-3: 62% 38% 42% 58% / 58% 42% 52% 48%;\n            --radius-crystal-4: 38% 62% 52% 48% / 42% 58% 48% 52%;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Typography */\n            --font-display: 'Libre Baskerville', Georgia, serif;\n            --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(0, 0, 0, 0.3);\n            --shadow-medium: 0 8px 30px rgba(0, 0, 0, 0.4);\n            --shadow-strong: 0 12px 40px rgba(0, 0, 0, 0.5);\n            --shadow-glow: 0 0 30px rgba(212, 184, 150, 0.3);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.7;\n            color: var(--color-text-primary);\n            background: var(--color-obsidian);\n            overflow-x: hidden;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-text-primary);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-secondary);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-sm) var(--spacing-md);\n            background: rgba(13, 13, 15, 0.95);\n            backdrop-filter: blur(20px);\n            transition: transform 0.3s ease;\n            box-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-champagne);\n            text-decoration: none;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-secondary);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-champagne);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover {\n            color: var(--color-champagne);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--gradient-champagne);\n            color: var(--color-obsidian) !important;\n            padding: 0.75rem 1.5rem;\n            border-radius: 50px;\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-champagne);\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-crystal-1);\n            opacity: 0.15;\n            filter: blur(60px);\n            animation: float 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-champagne);\n            top: -200px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .blob-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-quartz);\n            bottom: -150px;\n            left: -100px;\n            animation-delay: -5s;\n            border-radius: var(--radius-crystal-2);\n        }\n\n        .blob-3 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(135deg, var(--color-champagne) 0%, var(--color-quartz) 100%);\n            top: 50%;\n            left: 20%;\n            animation-delay: -10s;\n            border-radius: var(--radius-crystal-3);\n            opacity: 0.1;\n        }\n\n        .blob-4 {\n            width: 250px;\n            height: 250px;\n            background: linear-gradient(135deg, var(--color-champagne-light) 0%, var(--color-quartz-rose) 100%);\n            bottom: 20%;\n            right: 15%;\n            animation-delay: -15s;\n            border-radius: var(--radius-crystal-4);\n            opacity: 0.12;\n        }\n\n        @keyframes float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg) scale(1.05);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg) scale(0.95);\n            }\n            75% {\n                transform: translate(-30px, -20px) rotate(3deg) scale(1.02);\n            }\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 10;\n            max-width: 800px;\n            text-align: center;\n            animation: fadeInUp 1s ease-out;\n        }\n\n        .hero-badge {\n            display: inline-block;\n            padding: 0.5rem 1.5rem;\n            background: rgba(212, 184, 150, 0.15);\n            border: 1px solid var(--color-champagne);\n            border-radius: 50px;\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-champagne);\n            margin-bottom: var(--spacing-md);\n            animation: fadeInUp 1s ease-out 0.2s both;\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            animation: fadeInUp 1s ease-out 0.4s both;\n        }\n\n        .hero-title span {\n            background: var(--gradient-champagne);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: clamp(1.1rem, 2vw, 1.4rem);\n            color: var(--color-text-secondary);\n            margin-bottom: var(--spacing-lg);\n            animation: fadeInUp 1s ease-out 0.6s both;\n        }\n\n        .hero-cta {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            background: var(--gradient-champagne);\n            color: var(--color-obsidian);\n            text-decoration: none;\n            font-weight: 600;\n            border-radius: 50px;\n            transition: all var(--transition-base);\n            animation: fadeInUp 1s ease-out 0.8s both;\n        }\n\n        .hero-cta:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .hero-image {\n            position: absolute;\n            right: 5%;\n            top: 50%;\n            transform: translateY(-50%);\n            width: 400px;\n            height: 500px;\n            background: url('https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=800&q=80') center/cover;\n            border-radius: var(--radius-crystal-1);\n            opacity: 0.8;\n            animation: fadeInRight 1s ease-out 0.6s both;\n        }\n\n        .hero-image-overlay {\n            position: absolute;\n            inset: 0;\n            background: var(--gradient-obsidian);\n            opacity: 0.3;\n            border-radius: inherit;\n        }\n\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fadeInRight {\n            from {\n                opacity: 0;\n                transform: translateY(-50%) translateX(50px);\n            }\n            to {\n                opacity: 0.8;\n                transform: translateY(-50%) translateX(0);\n            }\n        }\n\n        /* ============================================\n           SECTIONS\n           ============================================ */\n        .section {\n            padding: var(--spacing-xl) var(--spacing-md);\n            position: relative;\n        }\n\n        .section-light {\n            background: var(--color-quartz-warm);\n            color: var(--color-text-on-light);\n        }\n\n        .section-dark {\n            background: var(--color-obsidian);\n        }\n\n        .section-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .section-header h2 {\n            color: var(--color-champagne);\n        }\n\n        .section-light .section-header h2 {\n            color: var(--color-obsidian);\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .problem-card, .solution-card {\n            padding: var(--spacing-md);\n            border-radius: var(--radius-crystal-1);\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .problem-card {\n            background: var(--color-obsidian-light);\n            border-left: 3px solid #C44;\n        }\n\n        .solution-card {\n            background: var(--color-obsidian-mid);\n            border-left: 3px solid var(--color-champagne);\n        }\n\n        .problem-card:hover, .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .card-icon {\n            font-size: 2rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .card-title {\n            font-family: var(--font-display);\n            font-size: 1.3rem;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-text-primary);\n        }\n\n        .card-text {\n            color: var(--color-text-secondary);\n            font-size: 0.95rem;\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .service-card {\n            background: var(--color-obsidian-light);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-crystal-2);\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 3px;\n            background: var(--gradient-champagne);\n            transform: scaleX(0);\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-champagne);\n            border-radius: var(--radius-crystal-3);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.5rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-title {\n            font-family: var(--font-display);\n            font-size: 1.4rem;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-champagne);\n        }\n\n        .service-description {\n            color: var(--color-text-secondary);\n            font-size: 0.95rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-link {\n            color: var(--color-champagne);\n            text-decoration: none;\n            font-weight: 600;\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            transition: gap var(--transition-fast);\n        }\n\n        .service-link:hover {\n            gap: 1rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .testimonial-card {\n            background: var(--color-obsidian-mid);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-crystal-1);\n            position: relative;\n        }\n\n        .testimonial-stars {\n            color: var(--color-champagne);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .testimonial-text {\n            font-style: italic;\n            color: var(--color-text-secondary);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: var(--gradient-champagne);\n        }\n\n        .testimonial-name {\n            font-family: var(--font-display);\n            font-weight: 600;\n            color: var(--color-champagne);\n        }\n\n        .testimonial-role {\n            font-size: 0.85rem;\n            color: var(--color-text-muted);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-md);\n            position: relative;\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            display: inline-block;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .differential-icon {\n            width: 70px;\n            height: 70px;\n            background: var(--gradient-champagne);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.8rem;\n            position: relative;\n            z-index: 2;\n        }\n\n        .differential-ring {\n            position: absolute;\n            inset: -10px;\n            border: 2px solid var(--color-champagne);\n            border-radius: 50%;\n            opacity: 0.3;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        .differential-ring:nth-child(2) {\n            inset: -20px;\n            animation-delay: 0.5s;\n        }\n\n        @keyframes pulse {\n            0%, 100% {\n                transform: scale(1);\n                opacity: 0.3;\n            }\n            50% {\n                transform: scale(1.1);\n                opacity: 0.1;\n            }\n        }\n\n        .differential-title {\n            font-family: var(--font-display);\n            font-size: 1.2rem;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-champagne);\n        }\n\n        .differential-text {\n            color: var(--color-text-secondary);\n            font-size: 0.9rem;\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact-wrapper {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n            margin-top: var(--spacing-lg);\n        }\n\n        .contact-info {\n            background: var(--color-obsidian-light);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-crystal-1);\n        }\n\n        .contact-info-item {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-sm);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-icon {\n            width: 40px;\n            height: 40px;\n            background: var(--gradient-champagne);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n        }\n\n        .contact-label {\n            font-weight: 600;\n            color: var(--color-champagne);\n            margin-bottom: 0.25rem;\n        }\n\n        .contact-value {\n            color: var(--color-text-secondary);\n        }\n\n        .contact-form {\n            background: var(--color-obsidian-light);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-crystal-2);\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .form-label {\n            display: block;\n            margin-bottom: 0.5rem;\n            font-weight: 500;\n            color: var(--color-champagne);\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 0.875rem 1rem;\n            background: var(--color-obsidian);\n            border: 1px solid var(--color-obsidian-mid);\n            border-radius: 10px;\n            color: var(--color-text-primary);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: border-color var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-champagne);\n            box-shadow: 0 0 0 3px rgba(212, 184, 150, 0.2);\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1rem 2rem;\n            background: var(--gradient-champagne);\n            color: var(--color-obsidian);\n            border: none;\n            border-radius: 50px;\n            font-size: 1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all var(--transition-base);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--color-obsidian-deep);\n            padding: var(--spacing-lg) var(--spacing-md);\n            border-top: 1px solid var(--color-obsidian-mid);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-lg);\n        }\n\n        .footer-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-champagne);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-text {\n            color: var(--color-text-muted);\n            font-size: 0.9rem;\n        }\n\n        .footer-title {\n            font-family: var(--font-display);\n            font-size: 1.1rem;\n            color: var(--color-champagne);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-links {\n            list-style: none;\n        }\n\n        .footer-link {\n            color: var(--color-text-secondary);\n            text-decoration: none;\n            display: block;\n            padding: 0.5rem 0;\n            transition: color var(--transition-fast);\n        }\n\n        .footer-link:hover {\n            color: var(--color-champagne);\n        }\n\n        .footer-bottom {\n            text-align: center;\n            padding-top: var(--spacing-md);\n            margin-top: var(--spacing-md);\n            border-top: 1px solid var(--color-obsidian-mid);\n            color: var(--color-text-muted);\n            font-size: 0.85rem;\n        }\n\n        /* ============================================\n           ANIMATION CLASSES\n           ============================================ */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.6s ease;\n        }\n\n        .wow-fade-in.visible {\n            opacity: 1;\n        }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 1024px) {\n            .hero-image {\n                width: 300px;\n                height: 380px;\n            }\n\n            .contact-wrapper {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                right: 0;\n                flex-direction: column;\n                background: var(--color-obsidian);\n                padding: var(--spacing-md);\n                transform: translateX(-100%);\n                transition: transform var(--transition-base);\n            }\n\n            .nav-menu.active {\n                transform: translateX(0);\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n\n            .hero {\n                padding: var(--spacing-lg) var(--spacing-sm);\n                text-align: center;\n            }\n\n            .hero-image {\n                position: relative;\n                right: auto;\n                top: auto;\n                transform: none;\n                width: 100%;\n                max-width: 350px;\n                height: 400px;\n                margin: var(--spacing-md) auto 0;\n            }\n\n            .section {\n                padding: var(--spacing-lg) var(--spacing-sm);\n            }\n\n            .problem-solution-grid,\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        @media (max-width: 480px) {\n            h1 {\n                font-size: 2rem;\n            }\n\n            h2 {\n                font-size: 1.75rem;\n            }\n\n            .hero-cta {\n                width: 100%;\n                justify-content: center;\n            }\n        }\n\n        /* ============================================\n           ACCESSIBILITY\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        :focus-visible {\n            outline: 2px solid var(--color-champagne);\n            outline-offset: 2px;\n        }\n\n        /* Skip link for accessibility */\n        .skip-link {\n            position: absolute;\n            top: -40px;\n            left: 0;\n            background: var(--color-champagne);\n            color: var(--color-obsidian);\n            padding: 8px 16px;\n            text-decoration: none;\n            z-index: 9999;\n        }\n\n        .skip-link:focus {\n            top: 0;\n        }\n    </style>\n</head>\n<body>\n    <a href=\"#main-content\" class=\"skip-link\">Pular para o conteúdo principal</a>\n\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Fernanda Nirschl</a>\n            <ul class=\"nav-menu\" id=\"nav-menu\">\n                <li><a href=\"#inicio\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contato\" class=\"nav-link nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <button class=\"nav-toggle\" id=\"nav-toggle\" aria-label=\"Abrir menu\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-blob blob-1\"></div>\n        <div class=\"hero-blob blob-2\"></div>\n        <div class=\"hero-blob blob-3\"></div>\n        <div class=\"hero-blob blob-4\"></div>\n\n        <div class=\"hero-content\">\n            <span class=\"hero-badge\">✦ Estética Avançada em Ribeirão Preto</span>\n            <h1 class=\"hero-title\">\n                Harmonização Facial que <span>Realça sua Beleza Natural</span>\n            </h1>\n            <p class=\"hero-subtitle\">\n                Transforme sua aparência com tratamentos personalizados que combinam precisão técnica e sensibilidade estética.\n            </p>\n            <a href=\"#contato\" class=\"hero-cta\">\n                Agendar Avaliação\n                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                    <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                </svg>\n            </a>\n        </div>\n\n        <div class=\"hero-image\">\n            <div class=\"hero-image-overlay\"></div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section section-dark\" id=\"problema-solucao\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <h2>Sua Jornada de Transformação</h2>\n                <p>Entendemos suas necessidades e oferecemos soluções personalizadas</p>\n            </div>\n\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card wow-fade-up\">\n                    <div class=\"card-icon\">😔</div>\n                    <h3 class=\"card-title\">O Desafio</h3>\n                    <p class=\"card-text\">Sinais de envelhecimento, perda de contorno facial ou assimetrias que afetam sua autoestima e confiança.</p>\n                </div>\n\n                <div class=\"problem-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"card-icon\">🔍</div>\n                    <h3 class=\"card-title\">A Avaliação</h3>\n                    <p class=\"card-text\">Análise detalhada de suas características faciais, entendendo seus objetivos e expectativas únicas.</p>\n                </div>\n\n                <div class=\"solution-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"card-icon\">✨</div>\n                    <h3 class=\"card-title\">A Solução</h3>\n                    <p class=\"card-text\">Protocolos personalizados que realçam sua beleza natural com resultados harmoniosos e naturais.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section section-light\" id=\"servicos\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <h2>Tratamentos Especializados</h2>\n                <p>Soluções avançadas para harmonização facial e estética</p>\n            </div>\n\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">💎</div>\n                    <h3 class=\"service-title\">Harmonização Facial</h3>\n                    <p class=\"service-description\">Equilíbrio dos traços faciais com técnicas avançadas para resultados naturais e harmoniosos.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"100\">\n                    <div class=\"service-icon\">💉</div>\n                    <h3 class=\"service-title\">Toxina Botulínica</h3>\n                    <p class=\"service-description\">Suavização de rugas e linhas de expressão com aplicação precisa e personalizada.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"service-icon\">✨</div>\n                    <h3 class=\"service-title\">Preenchedores Faciais</h3>\n                    <p class=\"service-description\">Restauração de volume e contorno facial com ácido hialurônico de alta qualidade.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"300\">\n                    <div class=\"service-icon\">👄</div>\n                    <h3 class=\"service-title\">Preenchimento Labial</h3>\n                    <p class=\"service-description\">Aumento e modelagem dos lábios com resultados naturais e equilibrados.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"service-icon\">🌟</div>\n                    <h3 class=\"service-title\">Bioestimuladores</h3>\n                    <p class=\"service-description\">Estímulo de colágeno para rejuvenescimento progressivo e duradouro da pele.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"500\">\n                    <div class=\"service-icon\">🎯</div>\n                    <h3 class=\"service-title\">Protocolos Personalizados</h3>\n                    <p class=\"service-description\">Tratamentos exclusivos desenvolvidos especificamente para suas necessidades.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section section-dark\" id=\"depoimentos\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <h2>O Que Nossas Pacientes Dizem</h2>\n                <p>Histórias reais de transformação e satisfação</p>\n            </div>\n\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"A Dra. Fernanda é excepcional! Fiz minha harmonização facial e o resultado superou minhas expectativas. Muito profissional e atenciosa.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\"></div>\n                        <div>\n                            <div class=\"testimonial-name\">Maria Silva</div>\n                            <div class=\"testimonial-role\">Empresária</div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Finalmente encontrei uma profissional que entende o que eu queria. Resultado natural e muito bonito. Recomendo de olhos fechados!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\"></div>\n                        <div>\n                            <div class=\"testimonial-name\">Ana Costa</div>\n                            <div class=\"testimonial-role\">Advogada</div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"O atendimento é impecável desde o primeiro contato. A Dra. Fernanda tem mãos de fada e um olhar estético refinado.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\"></div>\n                        <div>\n                            <div class=\"testimonial-name\">Juliana Mendes</div>\n                            <div class=\"testimonial-role\">Arquiteta</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section section-light\" id=\"diferenciais\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <h2>Por Que Escolher a Dra. Fernanda</h2>\n                <p>Diferenciais que fazem a diferença no seu resultado</p>\n            </div>\n\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-icon\">🎓</div>\n                    </div>\n                    <h3 class=\"differential-title\">Formação Especializada</h3>\n                    <p class=\"differential-text\">Atualização constante com as mais avançadas técnicas de harmonização facial.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"100\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-icon\">🎯</div>\n                    </div>\n                    <h3 class=\"differential-title\">Atendimento Personalizado</h3>\n                    <p class=\"differential-text\">Cada tratamento é único e desenvolvido exclusivamente para você.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"200\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-icon\">✨</div>\n                    </div>\n                    <h3 class=\"differential-title\">Resultados Naturais</h3>\n                    <p class=\"differential-text\">Técnicas que realçam sua beleza sem parecer artificial.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"300\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-icon\">🏥</div>\n                    </div>\n                    <h3 class=\"differential-title\">Ambiente Seguro</h3>\n                    <p class=\"differential-text\">Clínica equipada com materiais de alta qualidade e protocolos rigorosos.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"400\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-icon\">💬</div>\n                    </div>\n                    <h3 class=\"differential-title\">Acompanhamento Completo</h3>\n                    <p class=\"differential-text\">Suporte total antes, durante e depois dos procedimentos.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"500\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-ring\"></div>\n                        <div class=\"differential-icon\">⏰</div>\n                    </div>\n                    <h3 class=\"differential-title\">Pontualidade</h3>\n                    <p class=\"differential-text\">Respeito pelo seu tempo com agendamentos eficientes.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section section-dark\" id=\"contato\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <h2>Agende sua Consulta</h2>\n                <p>Dê o primeiro passo para sua transformação</p>\n            </div>\n\n            <div class=\"contact-wrapper\">\n                <div class=\"contact-info wow-fade-up\">\n                    <div class=\"contact-info-item\">\n                        <div class=\"contact-icon\">📍</div>\n                        <div>\n                            <div class=\"contact-label\">Endereço</div>\n                            <div class=\"contact-value\">Av. Leais Paulista, 864 - Jardim Irajá<br>Ribeirão Preto - SP, 14020-650</div>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-info-item\">\n                        <div class=\"contact-icon\">📞</div>\n                        <div>\n                            <div class=\"contact-label\">Telefone / WhatsApp</div>\n                            <div class=\"contact-value\">(16) 99725-2814</div>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-info-item\">\n                        <div class=\"contact-icon\">⏰</div>\n                        <div>\n                            <div class=\"contact-label\">Horário de Atendimento</div>\n                            <div class=\"contact-value\">Segunda a Sexta: 9h às 18h<br>Sábados: 9h às 13h</div>\n                        </div>\n                    </div>\n                </div>\n\n                <form class=\"contact-form wow-fade-up\" id=\"contactForm\">\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"name\">Nome Completo</label>\n                        <input type=\"text\" class=\"form-input\" id=\"name\" name=\"name\" required>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"phone\">Telefone / WhatsApp</label>\n                        <input type=\"tel\" class=\"form-input\" id=\"phone\" name=\"phone\" required>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"service\">Tratamento de Interesse</label>\n                        <select class=\"form-select\" id=\"service\" name=\"service\" required>\n                            <option value=\"\">Selecione uma opção</option>\n                            <option value=\"harmonizacao-facial\">Harmonização Facial</option>\n                            <option value=\"toxina-botulinica\">Toxina Botulínica</option>\n                            <option value=\"preenchedores-faciais\">Preenchedores Faciais</option>\n                            <option value=\"preenchimento-labial\">Preenchimento Labial</option>\n                            <option value=\"bioestimuladores\">Bioestimuladores</option>\n                            <option value=\"protocolos\">Protocolos Personalizados</option>\n                            <option value=\"outro\">Outro</option>\n                        </select>\n                    </div>\n\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"message\">Mensagem (opcional)</label>\n                        <textarea class=\"form-textarea\" id=\"message\" name=\"message\" placeholder=\"Conte-nos mais sobre suas expectativas...\"></textarea>\n                    </div>\n\n                    <button type=\"submit\" class=\"form-submit\">Agendar Consulta</button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div>\n                <div class=\"footer-logo\">Dra. Fernanda Nirschl</div>\n                <p class=\"footer-text\">Harmonização Facial e Estética Avançada em Ribeirão Preto. Transformando vidas através da autoestima.</p>\n            </div>\n\n            <div>\n                <h4 class=\"footer-title\">Links Rápidos</h4>\n                <ul class=\"footer-links\">\n                    <li><a href=\"#inicio\" class=\"footer-link\">Início</a></li>\n                    <li><a href=\"#servicos\" class=\"footer-link\">Serviços</a></li>\n                    <li><a href=\"#depoimentos\" class=\"footer-link\">Depoimentos</a></li>\n                    <li><a href=\"#contato\" class=\"footer-link\">Contato</a></li>\n                </ul>\n            </div>\n\n            <div>\n                <h4 class=\"footer-title\">Tratamentos</h4>\n                <ul class=\"footer-links\">\n                    <li><a href=\"#servicos\" class=\"footer-link\">Harmonização Facial</a></li>\n                    <li><a href=\"#servicos\" class=\"footer-link\">Toxina Botulínica</a></li>\n                    <li><a href=\"#servicos\" class=\"footer-link\">Preenchedores</a></li>\n                    <li><a href=\"#servicos\" class=\"footer-link\">Bioestimuladores</a></li>\n                </ul>\n            </div>\n        </div>\n\n        <div class=\"footer-bottom\">\n            <p>&copy; 2024 Dra. Fernanda Nirschl. Todos os direitos reservados.</p>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION - Auto-hide on scroll\n        // ============================================\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > lastScroll && currentScroll > 100) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // ============================================\n        // MOBILE MENU\n        // ============================================\n        const navToggle = document.getElementById('nav-toggle');\n        const navMenu = document.getElementById('nav-menu');\n        const navLinks = document.querySelectorAll('.nav-link');\n\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        navLinks.forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function (e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER - Scroll Animations\n        // ============================================\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || 0;\n                    setTimeout(() => {\n                        entry.target.classList.add('visible');\n                    }, delay);\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // PARALLAX EFFECT - Hero blobs\n        // ============================================\n        const hero = document.querySelector('.hero');\n        const blobs = document.querySelectorAll('.hero-blob');\n\n        hero.addEventListener('mousemove', (e) => {\n            const { clientX, clientY } = e;\n            const { innerWidth, innerHeight } = window;\n\n            const xPercent = (clientX / innerWidth - 0.5) * 2;\n            const yPercent = (clientY / innerHeight - 0.5) * 2;\n\n            blobs.forEach((blob, index) => {\n                const speed = (index + 1) * 10;\n                const x = xPercent * speed;\n                const y = yPercent * speed;\n                blob.style.transform = `translate(${x}px, ${y}px)`;\n            });\n        });\n\n        // ============================================\n        // CONTACT FORM - WhatsApp Integration\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceMap = {\n                'harmonizacao-facial': 'Harmonização Facial',\n                'toxina-botulinica': 'Toxina Botulínica',\n                'preenchedores-faciais': 'Preenchedores Faciais',\n                'preenchimento-labial': 'Preenchimento Labial',\n                'bioestimuladores': 'Bioestimuladores',\n                'protocolos': 'Protocolos Personalizados',\n                'outro': 'Outro'\n            };\n\n            const whatsappMessage = encodeURIComponent(\n                `Olá! Me chamo ${name}.\\n\\n` +\n                `Telefone: ${phone}\\n` +\n                `Interesse: ${serviceMap[service] || service}\\n` +\n                `${message ? `Mensagem: ${message}` : ''}\\n\\n` +\n                `Gostaria de agendar uma consulta.`\n            );\n\n            const whatsappUrl = `https://wa.me/5516997252814?text=${whatsappMessage}`;\n            window.open(whatsappUrl, '_blank');\n        });\n\n        // ============================================\n        // PREFERS REDUCED MOTION\n        // ============================================\n        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n            document.querySelectorAll('.hero-blob').forEach(blob => {\n                blob.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null}}
