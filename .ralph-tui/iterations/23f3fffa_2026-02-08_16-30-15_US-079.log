-bronze-dark: #A67800;\n            --color-bronze-deep: #966A00;\n            --color-bronze-shimmer: #E0B860;\n\n            /* Accent Palette - Orchid Purple */\n            --color-orchid: #8B4789;\n            --color-orchid-light: #9B5799;\n            --color-orchid-mid: #B069AA;\n            --color-orchid-dark: #7B3879;\n            --color-orchid-deep: #6B2969;\n            --color-orchid-shimmer: #C589C0;\n\n            /* Dark Palette - Soft Noir */\n            --color-noir: #1A1A1A;\n            --color-noir-charcoal: #2A2A2A;\n            --color-noir-deep: #0F0F12;\n\n            /* Warmth Accent - Porcelain */\n            --color-porcelain: #FAFAF8;\n            --color-porcelain-warm: #F5F5F2;\n            --color-cream: #F0ECE8;\n\n            /* Text Colors */\n            --color-text-primary: #1A1A1A;\n            --color-text-secondary: #4A4A4A;\n            --color-text-muted: #7A7A7A;\n            --color-text-on-dark: #F5F5F2;\n\n            /* Gradients */\n            --gradient-bronze: linear-gradient(135deg, var(--color-bronze) 0%, var(--color-bronze-light) 100%);\n            --gradient-orchid: linear-gradient(135deg, var(--color-orchid) 0%, var(--color-orchid-light) 100%);\n            --gradient-noir: linear-gradient(135deg, var(--color-noir) 0%, var(--color-noir-charcoal) 100%);\n            --gradient-hero: linear-gradient(135deg, #FAFAF8 0%, #F5F0EA 50%, #F0E8E0 100%);\n            --gradient-bronze-orchid: linear-gradient(135deg, var(--color-bronze) 0%, var(--color-orchid) 100%);\n\n            /* Orchid Petal Border Radius Shapes */\n            --radius-orchid-1: 65% 35% 45% 55% / 55% 40% 60% 45%;\n            --radius-orchid-2: 45% 55% 65% 35% / 40% 60% 35% 65%;\n            --radius-orchid-3: 55% 45% 35% 65% / 60% 35% 55% 45%;\n            --radius-orchid-4: 35% 65% 55% 45% / 35% 55% 45% 60%;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Typography */\n            --font-display: 'Cormorant Infant', Georgia, serif;\n            --font-body: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(26, 26, 26, 0.08);\n            --shadow-medium: 0 8px 30px rgba(26, 26, 26, 0.12);\n            --shadow-strong: 0 12px 40px rgba(26, 26, 26, 0.16);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.7;\n            color: var(--color-text-primary);\n            background: var(--color-porcelain);\n            overflow-x: hidden;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-noir);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-secondary);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-sm) var(--spacing-md);\n            background: rgba(250, 250, 248, 0.95);\n            backdrop-filter: blur(20px);\n            transition: transform 0.3s ease;\n            box-shadow: 0 2px 20px rgba(26, 26, 26, 0.06);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-noir);\n            text-decoration: none;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-secondary);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-bronze-orchid);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover {\n            color: var(--color-noir);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--gradient-orchid);\n            color: white !important;\n            padding: 0.75rem 1.5rem;\n            border-radius: 50px;\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 8px 20px rgba(139, 71, 137, 0.3);\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-noir);\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-orchid-1);\n            opacity: 0.15;\n            filter: blur(60px);\n            animation: float 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-bronze);\n            top: -200px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .blob-2 {\n            width: 400px;\n            height: 400px;\