   :root {\n            /* Colors - Ethereal Rose & Gold Palette */\n            --color-blush: #F8E8E8;\n            --color-rose: #E8B4B8;\n            --color-rose-dark: #D4959A;\n            --color-champagne: #F5EDE3;\n            --color-gold: #C9A86C;\n            --color-gold-light: #DFC9A3;\n            --color-sand: #D4C4B0;\n            --color-ivory: #FFFEF9;\n            --color-charcoal: #2C2C2C;\n            --color-charcoal-light: #4A4A4A;\n            --color-mauve: #B8A5B5;\n\n            /* Gradients */\n            --gradient-ethereal: linear-gradient(135deg, #F8E8E8 0%, #F5EDE3 50%, #FFF5F5 100%);\n            --gradient-glow: linear-gradient(135deg, #E8B4B8 0%, #F5EDE3 100%);\n            --gradient-rose: linear-gradient(135deg, #D4959A 0%, #C9A86C 100%);\n\n            /* Typography */\n            --font-display: 'Cormorant Garamond', Georgia, serif;\n            --font-body: 'Montserrat', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n            --spacing-xxl: 8rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 16px;\n            --radius-lg: 24px;\n            --radius-pill: 100px;\n            --radius-organic: 60% 40% 30% 70% / 60% 30% 70% 40%;\n\n            /* Shadows */\n            --shadow-soft: 0 8px 32px rgba(201, 168, 108, 0.15);\n            --shadow-glow: 0 8px 48px rgba(232, 180, 184, 0.25);\n            --shadow-elegant: 0 16px 64px rgba(44, 44, 44, 0.08);\n\n            /* Transitions */\n            --transition-fast: 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-base: 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-slow: 0.8s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n\n        /* ========================================\n           RESET & BASE STYLES\n        ======================================== */\n        *, *::before, *::after {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        html {\n            scroll-behavior: smooth;\n            font-size: 16px;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background: var(--color-ivory);\n            color: var(--color-charcoal);\n            line-height: 1.7;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        img {\n            max-width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-fast);\n        }\n\n        ul {\n            list-style: none;\n        }\n\n        /* ========================================\n           TYPOGRAPHY\n        ======================================== */\n        h1, h2, h3, h4 {\n            font-family: var(--font-display);\n            font-weight: 500;\n            line-height: 1.2;\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 8vw, 5rem);\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 5vw, 3.5rem);\n            letter-spacing: -0.01em;\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 3vw, 2rem);\n        }\n\n        .text-rose { color: var(--color-rose-dark); }\n        .text-gold { color: var(--color-gold); }\n\n        /* ========================================\n           NAVIGATION\n        ======================================== */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            background: rgba(255, 254, 249, 0.95);\n            backdrop-filter: blur(20px);\n            z-index: 1000;\n            transition: transform var(--transition-base);\n            box-shadow: 0 1px 0 rgba(201, 168, 108, 0.1);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }","numLines":150,"startLine":1,"totalLines":1562}}}
