 class=\"differential-item wow-fade-up wow-delay-1\">\n                    <div class=\"differential-icon\">🏆</div>\n                    <h3>Profissional Qualificada</h3>\n                    <p>Dra. Jéssica Baleia - especialista em estética avançada</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-2\">\n                    <div class=\"differential-icon\">🔬</div>\n                    <h3>Produtos de Qualidade</h3>\n                    <p>Utilização exclusiva de produtos certificados e aprovados</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-3\">\n                    <div class=\"differential-icon\">🎯</div>\n                    <h3>Resultados Naturais</h3>\n                    <p>Foco em harmonia e naturalidade em cada procedimento</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-4\">\n                    <div class=\"differential-icon\">💝</div>\n                    <h3>Acompanhamento Completo</h3>\n                    <p>Suporte total antes, durante e após os procedimentos</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-5\">\n                    <div class=\"differential-icon\">📍</div>\n                    <h3>Localização Privilegiada</h3>\n                    <p>Edifício Dubai no Jardim Botânico, fácil acesso</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-6\">\n                    <div class=\"differential-icon\">⚡</div>\n                    <h3>Procedimentos Rápidos</h3>\n                    <p>Técnicas minimamente invasivas com recuperação ágil</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contact\">\n        <div class=\"container\">\n            <h2 class=\"text-center wow-fade-up\">\n                Agende sua <span class=\"rose-accent\">consulta</span>\n            </h2>\n            <p class=\"text-center wow-fade-up wow-delay-1\" style=\"max-width: 600px; margin: 0 auto var(--spacing-lg);\">\n                Entre em contato para transformar sua aparência e elevar sua autoestima.\n            </p>\n            <div class=\"contact-container\">\n                <div class=\"contact-info wow-fade-up wow-delay-2\">\n                    <div class=\"contact-item\">\n                        <div class=\"contact-icon\">📍</div>\n                        <div class=\"contact-details\">\n                            <h4>Endereço</h4>\n                            <p>R. Triunfo, 1349 - Edifício Dubai: sala 411<br>Jardim Botânico, Ribeirão Preto - SP<br>CEP: 14021-612</p>\n                        </div>\n                    </div>\n                    <div class=\"contact-item\">\n                        <div class=\"contact-icon\">📱</div>\n                        <div class=\"contact-details\">\n                            <h4>WhatsApp</h4>\n                            <p><a href=\"https://wa.me/5516993902657\" target=\"_blank\">(16) 99390-2657</a></p>\n                        </div>\n                    </div>\n                    <div class=\"contact-item\">\n                        <div class=\"contact-icon\">⏰</div>\n                        <div class=\"contact-details\">\n                            <h4>Horário de Atendimento</h4>\n                            <p>Segunda a Sexta: 9h às 18h<br>Sábado: 9h às 13h</p>\n                        </div>\n                    </div>\n                </div>\n                <form class=\"contact-form wow-fade-up wow-delay-3\" id=\"contactForm\">\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"name\">Nome Completo</label>\n                        <input type=\"text\" class=\"form-input\" id=\"name\" name=\"name\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"phone\">Telefone/WhatsApp</label>\n                        <input type=\"tel\" class=\"form-input\" id=\"phone\" name=\"phone\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"service\">Tratamento de Interesse</label>\n                        <select class=\"form-select\" id=\"service\" name=\"service\" required>\n                            <option value=\"\">Selecione uma opção</option>\n                            <option value=\"harmonizacao\">Harmonização Facial</option>\n                            <option value=\"botox\">Toxina Botulínica</option>\n                            <option value=\"labios\">Preenchimento Labial</option>\n                            <option value=\"preenchedores\">Preenchedores Faciais</option>\n                            <option value=\"bioestimuladores\">Bioestimuladores</option>\n                            <option value=\"outros\">Outros Tratamentos</option>\n                        </select>\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"message\">Mensagem (opcional)</label>\n                        <textarea class=\"form-textarea\" id=\"message\" name=\"message\" placeholder=\"Conte-nos mais sobre suas necessidades...\"></textarea>\n                    </div>\n                    <button type=\"submit\" class=\"btn btn-primary form-submit\">\n                        Enviar Mensagem\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-brand\">\n                    <h3>Clínica Glamoré</h3>\n                    <p>Estética Avançada - Dra. Jéssica Baleia</p>\n                    <p style=\"margin-top: 0.5rem;\">Embelezamento • Rejuvenescimento • Harmonização</p>\n                </div>\n                <div>\n                    <h4 style=\"color: var(--rose-quartz-light); margin-bottom: 1rem;\">Tratamentos</h4>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#services\">Harmonização Facial</a></li>\n                        <li><a href=\"#services\">Toxina Botulínica</a></li>\n                        <li><a href=\"#services\">Preenchimento Labial</a></li>\n                        <li><a href=\"#services\">Bioestimuladores</a></li>\n                    </ul>\n                </div>\n                <div>\n                    <h4 style=\"color: var(--rose-quartz-light); margin-bottom: 1rem;\">Contato</h4>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"https://wa.me/5516993902657\" target=\"_blank\">(16) 99390-2657</a></li>\n                        <li><a href=\"#contact\">R. Triunfo, 1349 - sala 411</a></li>\n                        <li><a href=\"#contact\">Jardim Botânico, Ribeirão Preto - SP</a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"footer-bottom\">\n                <p>&copy; 2026 Clínica Glamoré - Dra. Jéssica Baleia. Todos os direitos reservados.</p>\n                <p style=\"margin-top: 0.25rem;\">CRO-SP: [Número]</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION SCROLL EFFECT\n        // ============================================\n        const nav = document.getElementById('nav');\n        let lastScroll = 0;\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                nav.classList.add('scrolled');\n            } else {\n                nav.classList.remove('scrolled');\n            }\n\n            if (currentScroll > lastScroll && currentScroll > 200) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // ============================================\n        // MOBILE MENU TOGGLE\n        // ============================================\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close menu when clicking on a link\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL FOR ANCHOR LINKS\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                const href = this.getAttribute('href');\n                if (href === '#') return;\n\n                e.preventDefault();\n                const target = document.querySelector(href);\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER FOR SCROLL ANIMATIONS\n        // ============================================\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('visible');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // CONTACT FORM SUBMISSION (WhatsApp)\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceLabels = {\n                'harmonizacao': 'Harmonização Facial',\n                'botox': 'Toxina Botulínica',\n                'labios': 'Preenchimento Labial',\n                'preenchedores': 'Preenchedores Faciais',\n                'bioestimuladores': 'Bioestimuladores',\n                'outros': 'Outros Tratamentos'\n            };\n\n            const serviceLabel = serviceLabels[service] || service;\n\n            let whatsappMessage = `Olá! Meu nome é ${name}.\\n`;\n            whatsappMessage += `Telefone: ${phone}\\n`;\n            whatsappMessage += `Tenho interesse em: ${serviceLabel}\\n`;\n            if (message) {\n                whatsappMessage += `\\nMensagem: ${message}`;\n            }\n\n            const whatsappUrl = `https://wa.me/5516993902657?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappUrl, '_blank');\n            contactForm.reset();\n        });\n\n        // ============================================\n        // HERO PARALLAX EFFECT ON MOUSE MOVE\n        // ============================================\n        const heroSection = document.getElementById('home');\n        const blobs = document.querySelectorAll('.glamour-blob');\n\n        if (window.innerWidth > 768) {\n            heroSection.addEventListener('mousemove', (e) => {\n                const x = (e.clientX / window.innerWidth - 0.5) * 20;\n                const y = (e.clientY / window.innerHeight - 0.5) * 20;\n\n                blobs.forEach((blob, index) => {\n                    const speed = (index + 1) * 0.5;\n                    blob.style.transform = `translate(${x * speed}px, ${y * speed}px)`;\n                });\n            });\n        }\n    </script>\n</body>\n</html>"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"f81e241d-2265-45a2-a9ca-d2339637f3ea","uuid":"60311e9b-bd60-4772-a6dc-6dd9225e35b0"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f9ac042dca274803b30a865e","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/clinica-glamore-estetica-avancada-dra-jessica-baleia-embelez/index.html"}]},"parent_tool_use_id":null,"session_id":"f81e241d-2265-45a2-a9ca-d2339637f3ea","uuid":"953e715e-f53b-4a1e-a5bc-c01396070c7f","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/clinica-glamore-estetica-avancada-dra-jessica-baleia-embelez/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Clínica Glamoré | Dra. Jéssica Baleia - Estética Avançada em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Clínica Glamoré - Dra. Jéssica Baleia. Embelezamento, Rejuvenescimento e Harmonização Facial em Ribeirão Preto. Atendimento especializado em estética avançada.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Outfit:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           ROSE QUARTZ & GILDED NOIR PALETTE\n           ============================================ */\n        :root {\n            /* Rose Quartz Tones */\n            --rose-quartz: #E8C8D8;\n            --rose-quartz-light: #F0D8E8;\n            --rose-quartz-dark: #D8B8C8;\n            --rose-quartz-deep: #C8A8B8;\n            --rose-quartz-pale: #F8E8F0;\n            --rose-quartz-mist: #E8D8E8;\n\n            /* Gilded Gold Tones */\n            --gilded-gold: #D4A84B;\n            --gilded-gold-light: #E8C270;\n            --gilded-gold-mid: #F0D080;\n            --gilded-gold-dark: #C4983C;\n            --gilded-gold-deep: #B48830;\n            --gilded-gold-shimmer: #FAF0E0;\n\n            /* Noir Backgrounds */\n            --noir-deep: #0A0A0F;\n            --noir-dark: #0F0F15;\n            --noir-mid: #1A1A22;\n            --noir-charcoal: #252530;\n\n            /* Text Colors */\n            --text-primary: #F8F0F0;\n            --text-secondary: #D8D0D0;\n            --text-muted: #A8A0A0;\n            --text-on-light: #2A1A20;\n\n            /* Typography */\n            --font-display: 'Crimson Pro', Georgia, serif;\n            --font-body: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Glamour Glow Border Radius */\n            --radius-glamour-1: 72% 28% 46% 54% / 54% 38% 62% 48%;\n            --radius-glamour-2: 48% 52% 68% 32% / 38% 62% 38% 62%;\n            --radius-glamour-3: 62% 38% 42% 58% / 58% 42% 52% 48%;\n            --radius-glamour-4: 38% 62% 52% 48% / 42% 58% 48% 52%;\n            --radius-sm: 4px;\n            --radius-md: 12px;\n            --radius-lg: 24px;\n            --radius-xl: 32px;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Gradients */\n            --gradient-rose: linear-gradient(135deg, var(--rose-quartz) 0%, var(--rose-quartz-light) 50%, var(--rose-quartz-mist) 100%);\n            --gradient-gilded: linear-gradient(135deg, var(--gilded-gold) 0%, var(--gilded-gold-light) 50%, var(--gilded-gold-mid) 100%);\n            --gradient-noir: linear-gradient(135deg, var(--noir-deep) 0%, var(--noir-dark) 50%, var(--noir-mid) 100%);\n            --gradient-hero: linear-gradient(135deg, var(--noir-deep) 0%, var(--noir-dark) 40%, var(--noir-mid) 100%);\n            --gradient-glamour: linear-gradient(135deg, var(--rose-quartz-light) 0%, var(--gilded-gold-light) 50%, var(--rose-quartz-pale) 100%);\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(10, 10, 15, 0.5);\n            --shadow-medium: 0 8px 30px rgba(10, 10, 15, 0.6);\n            --shadow-strong: 0 12px 40px rgba(10, 10, 15, 0.7);\n            --shadow-glow-rose: 0 0 30px rgba(232, 200, 216, 0.2);\n            --shadow-glow-gold: 0 0 30px rgba(212, 168, 75, 0.2);\n            --shadow-glamour: 0 0 40px rgba(232, 200, 216, 0.15);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background-color: var(--noir-deep);\n            color: var(--text-primary);\n            line-height: 1.7;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 500;\n            line-height: 1.2;\n            color: var(--text-primary);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 600;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            font-size: clamp(1rem, 1.1vw, 1.125rem);\n            color: var(--text-secondary);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: 1rem 0;\n            background: rgba(10, 10, 15, 0.9);\n            backdrop-filter: blur(20px);\n            transition: all var(--transition-base);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav.scrolled {\n            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 var(--spacing-md);\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            background: var(--gradient-glamour);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            color: var(--text-secondary);\n            font-size: 0.9rem;\n            font-weight: 500;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-glamour);\n            transition: width var(--transition-base);\n        }\n\n        .nav-link:hover {\n            color: var(--rose-quartz-light);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-toggle {\n            display: none;\n            background: none;\n            border: none;\n            color: var(--text-primary);\n            font-size: 1.5rem;\n            cursor: pointer;\n        }\n\n        /* Mobile Menu */\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                right: 0;\n                flex-direction: column;\n                background: var(--noir-deep);\n                padding: var(--spacing-md);\n                gap: var(--spacing-sm);\n                transform: translateX(100%);\n                transition: transform var(--transition-base);\n                border-top: 1px solid rgba(232, 200, 216, 0.1);\n            }\n\n            .nav-menu.active {\n                transform: translateX(0);\n            }\n\n            .nav-toggle {\n                display: block;\n            }\n        }\n\n        /* ============================================\n           UTILITIES\n           ============================================ */\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 var(--spacing-md);\n        }\n\n        .section {\n            padding: var(--spacing-xl) 0;\n            position: relative;\n        }\n\n        .text-center {\n            text-align: center;\n        }\n\n        .rose-accent {\n            color: var(--rose-quartz-light);\n        }\n\n        .gold-accent {\n            color: var(--gilded-gold-light);\n        }\n\n        /* ============================================\n           BUTTONS\n           ============================================ */\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 1rem 2rem;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            text-decoration: none;\n            border-radius: var(--radius-lg);\n            transition: all var(--transition-base);\n            cursor: pointer;\n            position: relative;\n            overflow: hidden;\n            border: none;\n        }\n\n        .btn-primary {\n            background: var(--gradient-glamour);\n            color: var(--noir-deep);\n        }\n\n        .btn-primary::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: -100%;\n            width: 100%;\n            height: 100%;\n            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);\n            transition: left var(--transition-slow);\n        }\n\n        .btn-primary:hover::before {\n            left: 100%;\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glamour);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--rose-quartz-light);\n            border: 2px solid var(--rose-quartz);\n        }\n\n        .btn-secondary:hover {\n            background: var(--rose-quartz);\n            color: var(--noir-deep);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            position: relative;\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        /* Glamour Glow Blobs */\n        .glamour-blob {\n            position: absolute;\n            opacity: 0.4;\n            filter: blur(60px);\n            animation: glamour-float 20s ease-in-out infinite;\n        }\n\n        .glamour-blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-rose);\n            top: -10%;\n            right: -5%;\n            border-radius: var(--radius-glamour-1);\n            animation-delay: 0s;\n        }\n\n        .glamour-blob-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-gilded);\n            bottom: 10%;\n            left: -5%;\n            border-radius: var(--radius-glamour-2);\n            animation-delay: -5s;\n        }\n\n        .glamour-blob-3 {\n            width: 350px;\n            height: 350px;\n            background: var(--gradient-rose);\n            top: 40%;\n            left: 30%;\n            border-radius: var(--radius-glamour-3);\n            animation-delay: -10s;\n            opacity: 0.3;\n        }\n\n        .glamour-blob-4 {\n            width: 300px;\n            height: 300px;\n            background: var(--gradient-gilded);\n            bottom: -5%;\n            right: 20%;\n            border-radius: var(--radius-glamour-4);\n            animation-delay: -15s;\n            opacity: 0.3;\n        }\n\n        @keyframes glamour-float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(90deg) scale(1.05);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(180deg) scale(0.95);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(270deg) scale(1.02);\n            }\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 10;\n            padding: var(--spacing-xl) 0;\n        }\n\n        .hero-badge {\n            display: inline-block;\n            padding: 0.5rem 1.5rem;\n            background: rgba(232, 200, 216, 0.1);\n            border: 1px solid rgba(232, 200, 216, 0.3);\n            border-radius: var(--radius-xl);\n            font-size: 0.85rem;\n            color: var(--rose-quartz-light);\n            margin-bottom: var(--spacing-md);\n            backdrop-filter: blur(10px);\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-title span {\n            background: var(--gradient-glamour);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: clamp(1.1rem, 1.5vw, 1.35rem);\n            color: var(--text-secondary);\n            max-width: 600px;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .hero-cta {\n            display: flex;\n            gap: var(--spacing-sm);\n            flex-wrap: wrap;\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            background: var(--gradient-noir);\n        }\n\n        .ps-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .ps-card {\n            padding: var(--spacing-md);\n            border-radius: var(--radius-lg);\n            transition: all var(--transition-base);\n        }\n\n        .ps-card-problem {\n            background: rgba(255, 100, 100, 0.05);\n            border-left: 3px solid rgba(255, 100, 100, 0.3);\n        }\n\n        .ps-card-problem:hover {\n            background: rgba(255, 100, 100, 0.08);\n            transform: translateX(-5px);\n        }\n\n        .ps-card-solution {\n            background: rgba(232, 200, 216, 0.08);\n            border-left: 3px solid var(--rose-quartz);\n        }\n\n        .ps-card-solution:hover {\n            background: rgba(232, 200, 216, 0.12);\n            transform: translateX(5px);\n        }\n\n        .ps-icon {\n            font-size: 2rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .ps-card h3 {\n            font-size: 1.25rem;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            background: var(--noir-dark);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .service-card {\n            background: rgba(255, 255, 255, 0.02);\n            border: 1px solid rgba(232, 200, 216, 0.1);\n            border-radius: var(--radius-lg);\n            padding: var(--spacing-md);\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 3px;\n            background: var(--gradient-glamour);\n            transform: scaleX(0);\n            transform-origin: left;\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-card:hover {\n            background: rgba(232, 200, 216, 0.05);\n            border-color: rgba(232, 200, 216, 0.2);\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-glow-rose);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-rose);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.5rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-card h3 {\n            color: var(--rose-quartz-light);\n            margin-bottom: var(--spacing-xs);\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            background: var(--gradient-noir);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.02);\n            border: 1px solid rgba(232, 200, 216, 0.1);\n            border-radius: var(--radius-lg);\n            padding: var(--spacing-md);\n            position: relative;\n        }\n\n        .testimonial-card::before {\n            content: '\"';\n            position: absolute;\n            top: var(--spacing-md);\n            left: var(--spacing-md);\n            font-size: 4rem;\n            font-family: var(--font-display);\n            color: var(--gilded-gold);\n            opacity: 0.3;\n            line-height: 1;\n        }\n\n        .testimonial-stars {\n            color: var(--gilded-gold);\n            margin-bottom: var(--spacing-sm);\n            font-size: 1rem;\n        }\n\n        .testimonial-text {\n            font-style: italic;\n            margin-bottom: var(--spacing-sm);\n            position: relative;\n            z-index: 1;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-glamour);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: var(--noir-deep);\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n            color: var(--rose-quartz-light);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            background: var(--noir-dark);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-icon {\n            width: 80px;\n            height: 80px;\n            background: rgba(232, 200, 216, 0.1);\n            border: 2px solid rgba(232, 200, 216, 0.2);\n            border-radius: var(--radius-glamour-1);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin: 0 auto var(--spacing-sm);\n            font-size: 2rem;\n            transition: all var(--transition-base);\n            position: relative;\n        }\n\n        .differential-icon::before {\n            content: '';\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            border-radius: inherit;\n            background: var(--gradient-rose);\n            opacity: 0;\n            transition: opacity var(--transition-base);\n            z-index: -1;\n        }\n\n        .differential-item:hover .differential-icon {\n            border-color: var(--rose-quartz);\n            transform: scale(1.1);\n        }\n\n        .differential-item:hover .differential-icon::before {\n            opacity: 0.3;\n        }\n\n        .differential-item h3 {\n            font-size: 1.1rem;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            background: var(--gradient-noir);\n        }\n\n        .contact-container {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-xl);\n            margin-top: var(--spacing-lg);\n        }\n\n        @media (max-width: 768px) {\n            .contact-container {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        .contact-info {\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-md);\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-sm);\n        }\n\n        .contact-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-rose);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.2rem;\n            flex-shrink: 0;\n        }\n\n        .contact-details h4 {\n            color: var(--rose-quartz-light);\n            margin-bottom: 0.25rem;\n        }\n\n        .contact-details p {\n            margin: 0;\n        }\n\n        .contact-form {\n            background: rgba(255, 255, 255, 0.02);\n            border: 1px solid rgba(232, 200, 216, 0.1);\n            border-radius: var(--radius-lg);\n            padding: var(--spacing-md);\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .form-label {\n            display: block;\n            margin-bottom: 0.5rem;\n            font-size: 0.9rem;\n            color: var(--text-secondary);\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 0.875rem 1rem;\n            background: rgba(255, 255, 255, 0.05);\n            border: 1px solid rgba(232, 200, 216, 0.15);\n            border-radius: var(--radius-md);\n            color: var(--text-primary);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: all var(--transition-fast);\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--rose-quartz);\n            box-shadow: 0 0 0 3px rgba(232, 200, 216, 0.1);\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--noir-deep);\n            border-top: 1px solid rgba(232, 200, 216, 0.1);\n            padding: var(--spacing-lg) 0 var(--spacing-md);\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-lg);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .footer-brand h3 {\n            background: var(--gradient-glamour);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-links {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-links a {\n            color: var(--text-secondary);\n            transition: color var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--rose-quartz-light);\n        }\n\n        .footer-bottom {\n            text-align: center;\n            padding-top: var(--spacing-md);\n            border-top: 1px solid rgba(232, 200, 216, 0.1);\n            font-size: 0.85rem;\n            color: var(--text-muted);\n        }\n\n        /* ============================================\n           ANIMATIONS (Intersection Observer)\n           ============================================ */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.6s ease;\n        }\n\n        .wow-fade-in.visible {\n            opacity: 1;\n        }\n\n        /* Stagger delays */\n        .wow-delay-1 { transition-delay: 0ms; }\n        .wow-delay-2 { transition-delay: 100ms; }\n        .wow-delay-3 { transition-delay: 200ms; }\n        .wow-delay-4 { transition-delay: 300ms; }\n        .wow-delay-5 { transition-delay: 400ms; }\n        .wow-delay-6 { transition-delay: 500ms; }\n\n        /* ============================================\n           ACCESSIBILITY\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        /* Focus styles */\n        :focus-visible {\n            outline: 2px solid var(--rose-quartz);\n            outline-offset: 2px;\n        }\n\n        /* ============================================\n           RESPONSIVE\n           ============================================ */\n        @media (max-width: 768px) {\n            .section {\n                padding: var(--spacing-lg) 0;\n            }\n\n            .hero-cta {\n                flex-direction: column;\n            }\n\n            .btn {\n                width: 100%;\n                justify-content: center;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#home\" class=\"nav-logo\">Clínica Glamoré</a>\n            <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Toggle menu\">\n                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                    <line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line>\n                    <line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line>\n                    <line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line>\n                </svg>\n            </button>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#home\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#services\" class=\"nav-link\">Tratamentos</a></li>\n                <li><a href=\"#testimonials\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#differentials\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contact\" class=\"nav-link\">Contato</a></li>\n            </ul>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"glamour-blob glamour-blob-1\"></div>\n        <div class=\"glamour-blob glamour-blob-2\"></div>\n        <div class=\"glamour-blob glamour-blob-3\"></div>\n        <div class=\"glamour-blob glamour-blob-4\"></div>\n\n        <div class=\"container hero-content\">\n            <div class=\"hero-badge wow-fade-up wow-delay-1\">\n                Estética Avançada em Ribeirão Preto\n            </div>\n            <h1 class=\"hero-title wow-fade-up wow-delay-2\">\n                Revele sua <span>beleza natural</span> com a Dra. Jéssica Baleia\n            </h1>\n            <p class=\"hero-subtitle wow-fade-up wow-delay-3\">\n                Embelezamento, rejuvenescimento e harmonização facial com resultados naturais e sofisticados.\n                Transforme sua autoestima na Clínica Glamoré.\n            </p>\n            <div class=\"hero-cta wow-fade-up wow-delay-4\">\n                <a href=\"#contact\" class=\"btn btn-primary\">\n                    Agendar Consulta\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                    </svg>\n                </a>\n                <a href=\"#services\" class=\"btn btn-secondary\">\n                    Conhecer Tratamentos\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\" id=\"problems\">\n        <div class=\"container\">\n            <h2 class=\"text-center wow-fade-up\">\n                Sua <span class=\"rose-accent\">beleza</span> merece cuidado especializado\n            </h2>\n            <div class=\"ps-grid\">\n                <div class=\"ps-card ps-card-problem wow-fade-up wow-delay-1\">\n                    <div class=\"ps-icon\">😔</div>\n                    <h3>Sinais de envelhecimento</h3>\n                    <p>Rugas, linhas de expressão e perda de volume facial que afetam sua autoestima.</p>\n                </div>\n                <div class=\"ps-card ps-card-problem wow-fade-up wow-delay-2\">\n                    <div class=\"ps-icon\">🤔</div>\n                    <h3>Harmonização facial</h3>\n                    <p>Desejo de equilibrar os traços do rosto com naturalidade e elegância.</p>\n                </div>\n                <div class=\"ps-card ps-card-solution wow-fade-up wow-delay-3\">\n                    <div class=\"ps-icon\">✨</div>\n                    <h3>Resultados naturais</h3>\n                    <p>Procedimentos personalizados que realçam sua beleza sem perder sua essência.</p>\n                </div>\n                <div class=\"ps-card ps-card-solution wow-fade-up wow-delay-4\">\n                    <div class=\"ps-icon\">💎</div>\n                    <h3>Atendimento premium</h3>\n                    <p>Consultoria detalhada e acompanhamento profissional em cada etapa do tratamento.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"services\">\n        <div class=\"container\">\n            <h2 class=\"text-center wow-fade-up\">\n                Tratamentos <span class=\"gold-accent\">especializados</span>\n            </h2>\n            <p class=\"text-center wow-fade-up wow-delay-1\" style=\"max-width: 600px; margin: 0 auto var(--spacing-lg);\">\n                Protocolos avançados de estética facial com foco em resultados naturais e duradouros.\n            </p>\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up wow-delay-1\">\n                    <div class=\"service-icon\">👁️</div>\n                    <h3>Harmonização Facial</h3>\n                    <p>Equilíbrio dos traços faciais com técnicas avançadas para resultados naturais e harmônicos.</p>\n                </div>\n                <div class=\"service-card wow-fade-up wow-delay-2\">\n                    <div class=\"service-icon\">💉</div>\n                    <h3>Toxina Botulínica</h3>\n                    <p>Suavização de rugas e linhas de expressão com aplicação estratégica e personalizada.</p>\n                </div>\n                <div class=\"service-card wow-fade-up wow-delay-3\">\n                    <div class=\"service-icon\">💋</div>\n                    <h3>Preenchimento Labial</h3>\n                    <p>Volume e contorno natural para os lábios, respeitando sua anatomia e harmonia facial.</p>\n                </div>\n                <div class=\"service-card wow-fade-up wow-delay-4\">\n                    <div class=\"service-icon\">✨</div>\n                    <h3>Preenchedores Faciais</h3>\n                    <p>Restauração de volume e contorno facial com ácido hialurônico de alta qualidade.</p>\n                </div>\n                <div class=\"service-card wow-fade-up wow-delay-5\">\n                    <div class=\"service-icon\">🌟</div>\n                    <h3>Bioestimuladores</h3>\n                    <p>Estímulo de colágeno para rejuvenescimento progressivo e natural da pele.</p>\n                </div>\n                <div class=\"service-card wow-fade-up wow-delay-6\">\n                    <div class=\"service-icon\">🎯</div>\n                    <h3>Protocolos Personalizados</h3>\n                    <p>Plano de tratamento individualizado conforme suas necessidades e objetivos estéticos.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"testimonials\">\n        <div class=\"container\">\n            <h2 class=\"text-center wow-fade-up\">\n                O que nossas <span class=\"rose-accent\">pacientes</span> dizem\n            </h2>\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up wow-delay-1\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\n                        \"A Dra. Jéssica é incrível! Fiz minha harmonização facial e o resultado ficou super natural.\n                        Todos elogiam a aparência rejuvenescida!\"\n                    </p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div class=\"testimonial-name\">Maria Clara</div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up wow-delay-2\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\n                        \"Ambiente maravilhoso e atendimento impecável. Amei o resultado do preenchimento labial.\n                        Recomendo de olhos fechados!\"\n                    </p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AS</div>\n                        <div class=\"testimonial-name\">Ana Silva</div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up wow-delay-3\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\n                        \"Profissional que realmente se preocupa com o paciente. Explicou todo o processo\n                        e o resultado superou minhas expectativas!\"\n                    </p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">PL</div>\n                        <div class=\"testimonial-name\">Patrícia Lima</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\" id=\"differentials\">\n        <div class=\"container\">\n            <h2 class=\"text-center wow-fade-up\">\n                Por que escolher a <span class=\"gold-accent\">Clínica Glamoré</span>\n            </h2>\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up wow-delay-1\">\n                    <div class=\"differential-icon\">🏆</div>\n                    <h3>Profissional Qualificada</h3>\n                    <p>Dra. Jéssica Baleia - especialista em estética avançada</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-2\">\n                    <div class=\"differential-icon\">🔬</div>\n                    <h3>Produtos de Qualidade</h3>\n                    <p>Utilização exclusiva de produtos certificados e aprovados</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-3\">\n                    <div class=\"differential-icon\">🎯</div>\n                    <h3>Resultados Naturais</h3>\n                    <p>Foco em harmonia e naturalidade em cada procedimento</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-4\">\n                    <div class=\"differential-icon\">💝</div>\n                    <h3>Acompanhamento Completo</h3>\n                    <p>Suporte total antes, durante e após os procedimentos</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-5\">\n                    <div class=\"differential-icon\">📍</div>\n                    <h3>Localização Privilegiada</h3>\n                    <p>Edifício Dubai no Jardim Botânico, fácil acesso</p>\n                </div>\n                <div class=\"differential-item wow-fade-up wow-delay-6\">\n                    <div class=\"differential-icon\">⚡</div>\n                    <h3>Procedimentos Rápidos</h3>\n                    <p>Técnicas minimamente invasivas com recuperação ágil</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contact\">\n        <div class=\"container\">\n            <h2 class=\"text-center wow-fade-up\">\n                Agende sua <span class=\"rose-accent\">consulta</span>\n            </h2>\n            <p class=\"text-center wow-fade-up wow-delay-1\" style=\"max-width: 600px; margin: 0 auto var(--spacing-lg);\">\n                Entre em contato para transformar sua aparência e elevar sua autoestima.\n            </p>\n            <div class=\"contact-container\">\n                <div class=\"contact-info wow-fade-up wow-delay-2\">\n                    <div class=\"contact-item\">\n                        <div class=\"contact-icon\">📍</div>\n                        <div class=\"contact-details\">\n                            <h4>Endereço</h4>\n                            <p>R. Triunfo, 1349 - Edifício Dubai: sala 411<br>Jardim Botânico, Ribeirão Preto - SP<br>CEP: 14021-612</p>\n                        </div>\n                    </div>\n                    <div class=\"contact-item\">\n                        <div class=\"contact-icon\">📱</div>\n                        <div class=\"contact-details\">\n                            <h4>WhatsApp</h4>\n                            <p><a href=\"https://wa.me/5516993902657\" target=\"_blank\">(16) 99390-2657</a></p>\n                        </div>\n                    </div>\n                    <div class=\"contact-item\">\n                        <div class=\"contact-icon\">⏰</div>\n                        <div class=\"contact-details\">\n                            <h4>Horário de Atendimento</h4>\n                            <p>Segunda a Sexta: 9h às 18h<br>Sábado: 9h às 13h</p>\n                        </div>\n                    </div>\n                </div>\n                <form class=\"contact-form wow-fade-up wow-delay-3\" id=\"contactForm\">\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"name\">Nome Completo</label>\n                        <input type=\"text\" class=\"form-input\" id=\"name\" name=\"name\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"phone\">Telefone/WhatsApp</label>\n                        <input type=\"tel\" class=\"form-input\" id=\"phone\" name=\"phone\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"service\">Tratamento de Interesse</label>\n                        <select class=\"form-select\" id=\"service\" name=\"service\" required>\n                            <option value=\"\">Selecione uma opção</option>\n                            <option value=\"harmonizacao\">Harmonização Facial</option>\n                            <option value=\"botox\">Toxina Botulínica</option>\n                            <option value=\"labios\">Preenchimento Labial</option>\n                            <option value=\"preenchedores\">Preenchedores Faciais</option>\n                            <option value=\"bioestimuladores\">Bioestimuladores</option>\n                            <option value=\"outros\">Outros Tratamentos</option>\n                        </select>\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"message\">Mensagem (opcional)</label>\n                        <textarea class=\"form-textarea\" id=\"message\" name=\"message\" placeholder=\"Conte-nos mais sobre suas necessidades...\"></textarea>\n                    </div>\n                    <button type=\"submit\" class=\"btn btn-primary form-submit\">\n                        Enviar Mensagem\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-brand\">\n                    <h3>Clínica Glamoré</h3>\n                    <p>Estética Avançada - Dra. Jéssica Baleia</p>\n                    <p style=\"margin-top: 0.5rem;\">Embelezamento • Rejuvenescimento • Harmonização</p>\n                </div>\n                <div>\n                    <h4 style=\"color: var(--rose-quartz-light); margin-bottom: 1rem;\">Tratamentos</h4>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#services\">Harmonização Facial</a></li>\n                        <li><a href=\"#services\">Toxina Botulínica</a></li>\n                        <li><a href=\"#services\">Preenchimento Labial</a></li>\n                        <li><a href=\"#services\">Bioestimuladores</a></li>\n                    </ul>\n                </div>\n                <div>\n                    <h4 style=\"color: var(--rose-quartz-light); margin-bottom: 1rem;\">Contato</h4>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"https://wa.me/5516993902657\" target=\"_blank\">(16) 99390-2657</a></li>\n                        <li><a href=\"#contact\">R. Triunfo, 1349 - sala 411</a></li>\n                        <li><a href=\"#contact\">Jardim Botânico, Ribeirão Preto - SP</a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"footer-bottom\">\n                <p>&copy; 2026 Clínica Glamoré - Dra. Jéssica Baleia. Todos os direitos reservados.</p>\n                <p style=\"margin-top: 0.25rem;\">CRO-SP: [Número]</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION SCROLL EFFECT\n        // ============================================\n        const nav = document.getElementById('nav');\n        let lastScroll = 0;\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                nav.classList.add('scrolled');\n            } else {\n                nav.classList.remove('scrolled');\n            }\n\n            if (currentScroll > lastScroll && currentScroll > 200) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // ============================================\n        // MOBILE MENU TOGGLE\n        // ============================================\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close menu when clicking on a link\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL FOR ANCHOR LINKS\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                const href = this.getAttribute('href');\n                if (href === '#') return;\n\n                e.preventDefault();\n                const target = document.querySelector(href);\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER FOR SCROLL ANIMATIONS\n        // ============================================\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('visible');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // CONTACT FORM SUBMISSION (WhatsApp)\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceLabels = {\n                'harmonizacao': 'Harmonização Facial',\n                'botox': 'Toxina Botulínica',\n                'labios': 'Preenchimento Labial',\n                'preenchedores': 'Preenchedores Faciais',\n                'bioestimuladores': 'Bioestimuladores',\n                'outros': 'Outros Tratamentos'\n            };\n\n            const serviceLabel = serviceLabels[service] || service;\n\n            let whatsappMessage = `Olá! Meu nome é ${name}.\\n`;\n            whatsappMessage += `Telefone: ${phone}\\n`;\n            whatsappMessage += `Tenho interesse em: ${serviceLabel}\\n`;\n            if (message) {\n                whatsappMessage += `\\nMensagem: ${message}`;\n            }\n\n            const whatsappUrl = `https://wa.me/5516993902657?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappUrl, '_blank');\n            contactForm.reset();\n        });\n\n        // ============================================\n        // HERO PARALLAX EFFECT ON MOUSE MOVE\n        // ============================================\n        const heroSection = document.getElementById('home');\n        const blobs = document.querySelectorAll('.glamour-blob');\n\n        if (window.innerWidth > 768) {\n            heroSection.addEventListener('mousemove', (e) => {\n                const x = (e.clientX / window.innerWidth - 0.5) * 20;\n                const y = (e.clientY / window.innerHeight - 0.5) * 20;\n\n                blobs.forEach((blob, index) => {\n                    const speed = (index + 1) * 0.5;\n                    blob.style.transform = `translate(${x * speed}px, ${y * speed}px)`;\n                });\n            });\n        }\n    </script>\n</body>\n</html>","structuredPatch":[],"originalFile":null}}
