ePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-zulene-ferreira-harmonizacao-orofacial/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Zulene Ferreira | Harmonização Orofacial - Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Zulene Ferreira - Harmonização Orofacial e Estética Avançada em Ribeirão Preto. Transforme sua aparência com tratamentos faciais personalizados.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Instrument+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           JADE NOIR & GOLDEN PEARL PALETTE\n           ============================================ */\n        :root {\n            /* Jade Green Tones */\n            --jade-primary: #2D6A5A;\n            --jade-light: #3D8A7A;\n            --jade-mid: #4A9A8A;\n            --jade-dark: #1D4A3A;\n            --jade-deep: #0D2A1A;\n            --jade-mist: #D0E8E0;\n            --jade-pale: #E8F0EC;\n\n            /* Golden Pearl Tones */\n            --pearl-gold: #D4C4A8;\n            --pearl-gold-light: #E8DCC8;\n            --pearl-gold-mid: #F0E8DC;\n            --pearl-gold-dark: #B8A888;\n            --pearl-gold-deep: #A89878;\n            --pearl-gold-shimmer: #FAF5F0;\n\n            /* Noir Backgrounds */\n            --noir-deep: #0A0A0F;\n            --noir-dark: #12121A;\n            --noir-mid: #1A1A22;\n            --noir-charcoal: #252530;\n\n            /* Ivory & Cream Accents */\n            --ivory-mist: #F0F0E8;\n            --cream-light: #FAF8F5;\n\n            /* Typography */\n            --font-display: 'Cormorant Garamond', Georgia, serif;\n            --font-body: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Border Radius - Jade Stone Shape */\n            --radius-jade-1: 68% 32% 48% 52% / 52% 42% 58% 48%;\n            --radius-jade-2: 48% 52% 68% 32% / 42% 58% 42% 58%;\n            --radius-jade-3: 58% 42% 42% 58% / 52% 48% 52% 48%;\n            --radius-jade-4: 42% 58% 52% 48% / 48% 52% 48% 52%;\n            --radius-sm: 4px;\n            --radius-md: 12px;\n            --radius-lg: 24px;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Z-index */\n            --z-blob: 1;\n            --z-content: 10;\n            --z-header: 100;\n            --z-modal: 1000;\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background-color: var(--noir-deep);\n            color: var(--ivory-mist);\n            line-height: 1.6;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--pearl-gold-light);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            font-size: clamp(1rem, 1.1vw, 1.125rem);\n            color: rgba(240, 240, 232, 0.8);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        /* ============================================\n           UTILITIES\n           ============================================ */\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 var(--spacing-md);\n        }\n\n        .section {\n            padding: var(--spacing-xl) 0;\n            position: relative;\n        }\n\n        .text-center {\n            text-align: center;\n        }\n\n        .jade-accent {\n            color: var(--jade-light);\n        }\n\n        .gold-accent {\n            color: var(--pearl-gold);\n        }\n\n        /* ============================================\n           BUTTONS\n           ============================================ */\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 1rem 2rem;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            text-decoration: none;\n            border-radius: var(--radius-lg);\n            transition: all var(--transition-base);\n            cursor: pointer;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .btn-primary {\n            background: linear-gradient(135deg, var(--jade-primary), var(--jade-light));\n            color: var(--cream-light);\n            border: none;\n        }\n\n        .btn-primary::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: -100%;\n            width: 100%;\n            height: 100%;\n            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);\n            transition: left var(--transition-slow);\n        }\n\n        .btn-primary:hover::before {\n            left: 100%;\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 10px 30px rgba(61, 138, 122, 0.3);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--pearl-gold-light);\n            border: 2px solid var(--pearl-gold);\n        }\n\n        .btn-secondary:hover {\n            background: var(--pearl-gold);\n            color: var(--noir-deep);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: var(--z-header);\n            padding: 1rem 0;\n            transition: all var(--transition-base);\n        }\n\n        .nav.scrolled {\n            background: rgba(10, 10, 15, 0.95);\n            backdrop-filter: blur(20px);\n            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);\n        }\n\n        .nav-container {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 var(--spacing-md);\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            color: var(--pearl-gold-light);\n            text-decoration: none;\n        }\n\n        .nav-links {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-links a {\n            color: var(--ivory-mist);\n            text-decoration: none;\n            font-size: 0.9rem;\n            font-weight: 500;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-links a::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--jade-light);\n            transition: width var(--transition-base);\n        }\n\n        .nav-links a:hover::after {\n            width: 100%;\n        }\n\n        .nav-links a:hover {\n            color: var(--jade-light);\n        }\n\n        .nav-toggle {\n            display: none;\n            background: none;\n            border: none;\n            color: var(--pearl-gold-light);\n            font-size: 1.5rem;\n            cursor: pointer;\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;","numLines":300,"startLine":1,"totalLines":1769}}}
