clinica-glamore-estetica-avancada-dra-jessica-baleia-embelez"},{"content":"Implement complete HTML site with embedded CSS and JS","status":"in_progress","activeForm":"Implementing complete HTML site with embedded CSS and JS"},{"content":"Test responsiveness and animations","status":"pending","activeForm":"Testing responsiveness and animations"},{"content":"Update checkpoint.md with progress and demo URL","status":"pending","activeForm":"Updating checkpoint.md with progress and demo URL"},{"content":"Update progress.md with learnings","status":"pending","activeForm":"Updating progress.md with learnings"}]}}
{"type":"assistant","message":{"id":"msg_20260209042222cfef828a07134645","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_f9ac042dca274803b30a865e","name":"Write","input":{"file_path":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/clinica-glamore-estetica-avancada-dra-jessica-baleia-embelez/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Clínica Glamoré | Dra. Jéssica Baleia - Estética Avançada em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Clínica Glamoré - Dra. Jéssica Baleia. Embelezamento, Rejuvenescimento e Harmonização Facial em Ribeirão Preto. Atendimento especializado em estética avançada.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Outfit:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           ROSE QUARTZ & GILDED NOIR PALETTE\n           ============================================ */\n        :root {\n            /* Rose Quartz Tones */\n            --rose-quartz: #E8C8D8;\n            --rose-quartz-light: #F0D8E8;\n            --rose-quartz-dark: #D8B8C8;\n            --rose-quartz-deep: #C8A8B8;\n            --rose-quartz-pale: #F8E8F0;\n            --rose-quartz-mist: #E8D8E8;\n\n            /* Gilded Gold Tones */\n            --gilded-gold: #D4A84B;\n            --gilded-gold-light: #E8C270;\n            --gilded-gold-mid: #F0D080;\n            --gilded-gold-dark: #C4983C;\n            --gilded-gold-deep: #B48830;\n            --gilded-gold-shimmer: #FAF0E0;\n\n            /* Noir Backgrounds */\n            --noir-deep: #0A0A0F;\n            --noir-dark: #0F0F15;\n            --noir-mid: #1A1A22;\n            --noir-charcoal: #252530;\n\n            /* Text Colors */\n            --text-primary: #F8F0F0;\n            --text-secondary: #D8D0D0;\n            --text-muted: #A8A0A0;\n            --text-on-light: #2A1A20;\n\n            /* Typography */\n            --font-display: 'Crimson Pro', Georgia, serif;\n            --font-body: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Glamour Glow Border Radius */\n            --radius-glamour-1: 72% 28% 46% 54% / 54% 38% 62% 48%;\n            --radius-glamour-2: 48% 52% 68% 32% / 38% 62% 38% 62%;\n            --radius-glamour-3: 62% 38% 42% 58% / 58% 42% 52% 48%;\n            --radius-glamour-4: 38% 62% 52% 48% / 42% 58% 48% 52%;\n            --radius-sm: 4px;\n            --radius-md: 12px;\n            --radius-lg: 24px;\n            --radius-xl: 32px;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Gradients */\n            --gradient-rose: linear-gradient(135deg, var(--rose-quartz) 0%, var(--rose-quartz-light) 50%, var(--rose-quartz-mist) 100%);\n            --gradient-gilded: linear-gradient(135deg, var(--gilded-gold) 0%, var(--gilded-gold-light) 50%, var(--gilded-gold-mid) 100%);\n            --gradient-noir: linear-gradient(135deg, var(--noir-deep) 0%, var(--noir-dark) 50%, var(--noir-mid) 100%);\n            --gradient-hero: linear-gradient(135deg, var(--noir-deep) 0%, var(--noir-dark) 40%, var(--noir-mid) 100%);\n            --gradient-glamour: linear-gradient(135deg, var(--rose-quartz-light) 0%, var(--gilded-gold-light) 50%, var(--rose-quartz-pale) 100%);\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(10, 10, 15, 0.5);\n            --shadow-medium: 0 8px 30px rgba(10, 10, 15, 0.6);\n            --shadow-strong: 0 12px 40px rgba(10, 10, 15, 0.7);\n            --shadow-glow-rose: 0 0 30px rgba(232, 200, 216, 0.2);\n            --shadow-glow-gold: 0 0 30px rgba(212, 168, 75, 0.2);\n            --shadow-glamour: 0 0 40px rgba(232, 200, 216, 0.15);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background-color: var(--noir-deep);\n            color: var(--text-primary);\n            line-height: 1.7;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 500;\n            line-height: 1.2;\n            color: var(--text-primary);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 600;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            font-size: clamp(1rem, 1.1vw, 1.125rem);\n            color: var(--text-secondary);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: 1rem 0;\n            background: rgba(10, 10, 15, 0.9);\n            backdrop-filter: blur(20px);\n            transition: all var(--transition-base);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav.scrolled {\n            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 var(--spacing-md);\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            background: var(--gradient-glamour);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            color: var(--text-secondary);\n            font-size: 0.9rem;\n            font-weight: 500;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-glamour);\n            transition: width var(--transition-base);\n        }\n\n        .nav-link:hover {\n            color: var(--rose-quartz-light);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-toggle {\n            display: none;\n            background: none;\n            border: none;\n            color: var(--text-primary);\n            font-size: 1.5rem;\n            cursor: pointer;\n        }\n\n        /* Mobile Menu */\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                right: 0;\n                flex-direction: column;\n                background: var(--noir-deep);\n                padding: var(--spacing-md);\n                gap: var(--spacing-sm);\n                transform: translateX(100%);\n                transition: transform var(--transition-base);\n                border-top: 1px solid rgba(232, 200, 216, 0.1);\n            }\n\n            .nav-menu.active {\n                transform: translateX(0);\n            }\n\n            .nav-toggle {\n                display: block;\n            }\n        }\n\n        /* ============================================\n           UTILITIES\n           ============================================ */\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 var(--spacing-md);\n        }\n\n        .section {\n            padding: var(--spacing-xl) 0;\n            position: relative;\n        }\n\n        .text-center {\n            text-align: center;\n        }\n\n        .rose-accent {\n            color: var(--rose-quartz-light);\n        }\n\n        .gold-accent {\n            color: var(--gilded-gold-light);\n        }\n\n        /* ============================================\n           BUTTONS\n           ============================================ */\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 1rem 2rem;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            text-decoration: none;\n            border-radius: var(--radius-lg);\n            transition: all var(--transition-base);\n            cursor: pointer;\n            position: relative;\n            overflow: hidden;\n            border: none;\n        }\n\n        .btn-primary {\n            background: var(--gradient-glamour);\n            color: var(--noir-deep);\n        }\n\n        .btn-primary::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: -100%;\n            width: 100%;\n            height: 100%;\n            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);\n            transition: left var(--transition-slow);\n        }\n\n        .btn-primary:hover::before {\n            left: 100%;\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glamour);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--rose-quartz-light);\n            border: 2px solid var(--rose-quartz);\n        }\n\n        .btn-secondary:hover {\n            background: var(--rose-quartz);\n            color: var(--noir-deep);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            position: relative;\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        /* Glamour Glow Blobs */\n        .glamour-blob {\n            position: absolute;\n            opacity: 0.4;\n            filter: blur(60px);\n            animation: glamour-float 20s ease-in-out infinite;\n        }\n\n        .glamour-blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-rose);\n            top: -10%;\n            right: -5%;\n            border-radius: var(--radius-glamour-1);\n            animation-delay: 0s;\n        }\n\n        .glamour-blob-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-gilded);\n            bottom: 10%;\n            left: -5%;\n            border-radius: var(--radius-glamour-2);\n            animation-delay: -5s;\n        }\n\n        .glamour-blob-3 {\n            width: 350px;\n            height: 350px;\n            background: var(--gradient-rose);\n            top: 40%;\n            left: 30%;\n            border-radius: var(--radius-glamour-3);\n            animation-delay: -10s;\n            opacity: 0.3;\n        }\n\n        .glamour-blob-4 {\n            width: 300px;\n            height: 300px;\n            background: var(--gradient-gilded);\n            bottom: -5%;\n            right: 20%;\n            border-radius: var(--radius-glamour-4);\n            animation-delay: -15s;\n            opacity: 0.3;\n        }\n\n        @keyframes glamour-float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(90deg) scale(1.05);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(180deg) scale(0.95);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(270deg) scale(1.02);\n            }\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 10;\n            padding: var(--spacing-xl) 0;\n        }\n\n        .hero-badge {\n            display: inline-block;\n            padding: 0.5rem 1.5rem;\n            background: rgba(232, 200, 216, 0.1);\n            border: 1px solid rgba(232, 200, 216, 0.3);\n            border-radius: var(--radius-xl);\n            font-size: 0.85rem;\n            color: var(--rose-quartz-light);\n            margin-bottom: var(--spacing-md);\n            backdrop-filter: blur(10px);\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-title span {\n            background: var(--gradient-glamour);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: clamp(1.1rem, 1.5vw, 1.35rem);\n            color: var(--text-secondary);\n            max-width: 600px;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .hero-cta {\n            display: flex;\n            gap: var(--spacing-sm);\n            flex-wrap: wrap;\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            background: var(--gradient-noir);\n        }\n\n        .ps-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .ps-card {\n            padding: var(--spacing-md);\n            border-radius: var(--radius-lg);\n            transition: all var(--transition-base);\n        }\n\n        .ps-card-problem {\n            background: rgba(255, 100, 100, 0.05);\n            border-left: 3px solid rgba(255, 100, 100, 0.3);\n        }\n\n        .ps-card-problem:hover {\n            background: rgba(255, 100, 100, 0.08);\n            transform: translateX(-5px);\n        }\n\n        .ps-card-solution {\n            background: rgba(232, 200, 216, 0.08);\n            border-left: 3px solid var(--rose-quartz);\n        }\n\n        .ps-card-solution:hover {\n            background: rgba(232, 200, 216, 0.12);\n            transform: translateX(5px);\n        }\n\n        .ps-icon {\n            font-size: 2rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .ps-card h3 {\n            font-size: 1.25rem;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            background: var(--noir-dark);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .service-card {\n            background: rgba(255, 255, 255, 0.02);\n            border: 1px solid rgba(232, 200, 216, 0.1);\n            border-radius: var(--radius-lg);\n            padding: var(--spacing-md);\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 3px;\n            background: var(--gradient-glamour);\n            transform: scaleX(0);\n            transform-origin: left;\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-card:hover {\n            background: rgba(232, 200, 216, 0.05);\n            border-color: rgba(232, 200, 216, 0.2);\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-glow-rose);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-rose);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.5rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-card h3 {\n            color: var(--rose-quartz-light);\n            margin-bottom: var(--spacing-xs);\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            background: var(--gradient-noir);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.02);\n            border: 1px solid rgba(232, 200, 216, 0.1);\n            border-radius: var(--radius-lg);\n            padding: var(--spacing-md);\n            position: relative;\n        }\n\n        .testimonial-card::before {\n            content: '\"';\n            position: absolute;\n            top: var(--spacing-md);\n            left: var(--spacing-md);\n            font-size: 4rem;\n            font-family: var(--font-display);\n            color: var(--gilded-gold);\n            opacity: 0.3;\n            line-height: 1;\n        }\n\n        .testimonial-stars {\n            color: var(--gilded-gold);\n            margin-bottom: var(--spacing-sm);\n            font-size: 1rem;\n        }\n\n        .testimonial-text {\n            font-style: italic;\n            margin-bottom: var(--spacing-sm);\n            position: relative;\n            z-index: 1;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-glamour);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: var(--noir-deep);\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n            color: var(--rose-quartz-light);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            background: var(--noir-dark);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-icon {\n            width: 80px;\n            height: 80px;\n            background: rgba(232, 200, 216, 0.1);\n            border: 2px solid rgba(232, 200, 216, 0.2);\n            border-radius: var(--radius-glamour-1);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin: 0 auto var(--spacing-sm);\n            font-size: 2rem;\n            transition: all var(--transition-base);\n            position: relative;\n        }\n\n        .differential-icon::before {\n            content: '';\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            border-radius: inherit;\n            background: var(--gradient-rose);\n            opacity: 0;\n            transition: opacity var(--transition-base);\n            z-index: -1;\n        }\n\n        .differential-item:hover .differential-icon {\n            border-color: var(--rose-quartz);\n            transform: scale(1.1);\n        }\n\n        .differential-item:hover .differential-icon::before {\n            opacity: 0.3;\n        }\n\n        .differential-item h3 {\n            font-size: 1.1rem;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            background: var(--gradient-noir);\n        }\n\n        .contact-container {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-xl);\n            margin-top: var(--spacing-lg);\n        }\n\n        @media (max-width: 768px) {\n            .contact-container {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        .contact-info {\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-md);\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-sm);\n        }\n\n        .contact-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-rose);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.2rem;\n            flex-shrink: 0;\n        }\n\n        .contact-details h4 {\n            color: var(--rose-quartz-light);\n            margin-bottom: 0.25rem;\n        }\n\n        .contact-details p {\n            margin: 0;\n        }\n\n        .contact-form {\n            background: rgba(255, 255, 255, 0.02);\n            border: 1px solid rgba(232, 200, 216, 0.1);\n            border-radius: var(--radius-lg);\n            padding: var(--spacing-md);\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .form-label {\n            display: block;\n            margin-bottom: 0.5rem;\n            font-size: 0.9rem;\n            color: var(--text-secondary);\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 0.875rem 1rem;\n            background: rgba(255, 255, 255, 0.05);\n            border: 1px solid rgba(232, 200, 216, 0.15);\n            border-radius: var(--radius-md);\n            color: var(--text-primary);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: all var(--transition-fast);\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--rose-quartz);\n            box-shadow: 0 0 0 3px rgba(232, 200, 216, 0.1);\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--noir-deep);\n            border-top: 1px solid rgba(232, 200, 216, 0.1);\n            padding: var(--spacing-lg) 0 var(--spacing-md);\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-lg);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .footer-brand h3 {\n            background: var(--gradient-glamour);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-links {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-links a {\n            color: var(--text-secondary);\n            transition: color var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--rose-quartz-light);\n        }\n\n        .footer-bottom {\n            text-align: center;\n            padding-top: var(--spacing-md);\n            border-top: 1px solid rgba(232, 200, 216, 0.1);\n            font-size: 0.85rem;\n            color: var(--text-muted);\n        }\n\n        /* ============================================\n           ANIMATIONS (Intersection Observer)\n           ============================================ */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.6s ease;\n        }\n\n        .wow-fade-in.visible {\n            opacity: 1;\n        }\n\n        /* Stagger delays */\n        .wow-delay-1 { transition-delay: 0ms; }\n        .wow-delay-2 { transition-delay: 100ms; }\n        .wow-delay-3 { transition-delay: 200ms; }\n        .wow-delay-4 { transition-delay: 300ms; }\n        .wow-delay-5 { transition-delay: 400ms; }\n        .wow-delay-6 { transition-delay: 500ms; }\n\n        /* ============================================\n           ACCESSIBILITY\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        /* Focus styles */\n        :focus-visible {\n            outline: 2px solid var(--rose-quartz);\n            outline-offset: 2px;\n        }\n\n        /* ============================================\n           RESPONSIVE\n           ============================================ */\n        @media (max-width: 768px) {\n            .section {\n                padding: var(--spacing-lg) 0;\n            }\n\n            .hero-cta {\n                flex-direction: column;\n            }\n\n            .btn {\n                width: 100%;\n                justify-content: center;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#home\" class=\"nav-logo\">Clínica Glamoré</a>\n            <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Toggle menu\">\n                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                    <line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line>\n                    <line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line>\n                    <line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line>\n                </svg>\n            </button>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#home\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#services\" class=\"nav-link\">Tratamentos</a></li>\n                <li><a href=\"#testimonials\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#differentials\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contact\" class=\"nav-link\">Contato</a></li>\n            </ul>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"glamour-blob glamour-blob-1\"></div>\n        <div class=\"glamour-blob glamour-blob-2\"></div>\n        <div class=\"glamour-blob glamour-blob-3\"></div>\n        <div class=\"glamour-blob glamour-blob-4\"></div>\n\n        <div class=\"container hero-content\"