\n            /* Labradentite Blue Accents */\n            --color-labradentite: #4A5A8A;\n            --color-labradentite-light: #6A7AAA;\n            --color-labradentite-deep: #2A3A6A;\n\n            /* Text Colors */\n            --color-text-primary: #F0F0F8;\n            --color-text-secondary: #C8C8D8;\n            --color-text-muted: #8888A0;\n            --color-text-on-light: #1A1A22;\n\n            /* Gradients */\n            --gradient-moonstone: linear-gradient(135deg, var(--color-moonstone-pearl) 0%, var(--color-moonstone-blue) 50%, var(--color-moonstone-lavender) 100%);\n            --gradient-silver: linear-gradient(135deg, var(--color-silver-dark) 0%, var(--color-silver) 50%, var(--color-silver-light) 100%);\n            --gradient-hero: linear-gradient(135deg, var(--color-midnight-deep) 0%, var(--color-midnight) 40%, var(--color-midnight-light) 100%);\n            --gradient-aurora: linear-gradient(135deg, var(--color-labradentite) 0%, var(--color-moonstone-lavender) 50%, var(--color-labradentite-light) 100%);\n            --gradient-noir: linear-gradient(135deg, var(--color-midnight-deep) 0%, var(--color-midnight) 50%, var(--color-charcoal) 100%);\n            --gradient-iridescent: linear-gradient(135deg, var(--color-moonstone-pearl) 0%, var(--color-moonstone-lavender) 25%, var(--color-moonstone-blue) 50%, var(--color-moonstone-pink) 75%, var(--color-moonstone-pearl) 100%);\n\n            /* Aurora Wave Border Radius - Moonstone/Iridescence inspired */\n            --radius-aurora-1: 68% 32% 48% 52% / 52% 42% 58% 48%;\n            --radius-aurora-2: 48% 52% 68% 32% / 42% 58% 42% 58%;\n            --radius-aurora-3: 58% 42% 42% 58% / 52% 48% 52% 48%;\n            --radius-aurora-4: 42% 58% 52% 48% / 48% 52% 48% 52%;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n            --spacing-2xl: 8rem;\n\n            /* Typography */\n            --font-display: 'Bodoni Moda', Georgia, serif;\n            --font-body: 'Satoshi', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(10, 10, 18, 0.4);\n            --shadow-medium: 0 8px 30px rgba(10, 10, 18, 0.5);\n            --shadow-strong: 0 12px 40px rgba(10, 10, 18, 0.6);\n            --shadow-glow: 0 0 30px rgba(184, 184, 200, 0.2);\n            --shadow-silver: 0 4px 25px rgba(184, 184, 200, 0.15);\n            --shadow-iridescent: 0 0 40px rgba(232, 232, 240, 0.3);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.7;\n            color: var(--color-text-primary);\n            background: var(--color-midnight-deep);\n            overflow-x: hidden;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-text-primary);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n   