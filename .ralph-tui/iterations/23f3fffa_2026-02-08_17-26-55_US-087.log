  <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M22 2L11 13\"/>\n                                <path d=\"M22 2l-7 20-4-9-9-4 20-7z\"/>\n                            </svg>\n                        </button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"container\">\n            <div class=\"footer-content\">\n                <div>\n                    <div class=\"footer-brand\">Harmoniser</div>\n                    <p class=\"footer-description\">Estética de Alta Performance em Ribeirão Preto. Transformando vidas através da harmonização facial e estética avançada.</p>\n                </div>\n\n                <div>\n                    <h4 style=\"margin-bottom: var(--spacing-sm); color: var(--text-primary);\">Tratamentos</h4>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#services\">Harmonização Facial</a></li>\n                        <li><a href=\"#services\">Toxina Botulínica</a></li>\n                        <li><a href=\"#services\">Preenchedores</a></li>\n                        <li><a href=\"#services\">Protocolos Personalizados</a></li>\n                    </ul>\n                </div>\n\n                <div>\n                    <h4 style=\"margin-bottom: var(--spacing-sm); color: var(--text-primary);\">Contato</h4>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#contact\">Agendar Consulta</a></li>\n                        <li><a href=\"https://wa.me/5516997162770\">WhatsApp: (16) 99716-2770</a></li>\n                        <li><a href=\"#differentials\">Diferenciais</a></li>\n                    </ul>\n                </div>\n            </div>\n\n            <div class=\"footer-bottom\">\n                <p>&copy; 2026 Clínica Harmoniser. Todos os direitos reservados. | Ribeirão Preto - SP</p>\n            </div>\n        </div>\n    </footer>\n\n    <!-- JavaScript -->\n    <script>\n        // ============================================\n        // NAVIGATION SCROLL EFFECT\n        // ============================================\n        const nav = document.getElementById('nav');\n        let lastScrollY = window.scrollY;\n\n        window.addEventListener('scroll', () => {\n            if (window.scrollY > 100) {\n                nav.classList.add('scrolled');\n            } else {\n                nav.classList.remove('scrolled');\n            }\n\n            if (window.scrollY > lastScrollY && window.scrollY > 200) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n\n            lastScrollY = window.scrollY;\n        });\n\n        // ============================================\n        // MOBILE MENU TOGGLE\n        // ============================================\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n        const navLinks = document.querySelectorAll('.nav-link');\n\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        navLinks.forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL FOR ANCHOR LINKS\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                const href = this.getAttribute('href');\n                if (href !== '#') {\n                    e.preventDefault();\n                    const target = document.querySelector(href);\n                    if (target) {\n                        const navHeight = nav.offsetHeight;\n                        const targetPosition = target.offsetTop - navHeight;\n                        window.scrollTo({\n                            top: targetPosition,\n                            behavior: 'smooth'\n                        });\n                    }\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER FOR SCROLL ANIMATIONS\n        // ============================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('animated');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // HERO PARALLAX EFFECT\n        // ============================================\n        const hero = document.querySelector('.hero');\n        const heroBlobs = document.querySelectorAll('.crystal-blob');\n\n        if (hero && window.innerWidth > 768) {\n            hero.addEventListener('mousemove', (e) => {\n                const { clientX, clientY } = e;\n                const { innerWidth, innerHeight } = window;\n\n                const xPos = (clientX / innerWidth - 0.5) * 2;\n                const yPos = (clientY / innerHeight - 0.5) * 2;\n\n                heroBlobs.forEach((blob, index) => {\n                    const speed = (index + 1) * 10;\n                    const xOffset = xPos * speed;\n                    const yOffset = yPos * speed;\n                    blob.style.transform = `translate(${xOffset}px, ${yOffset}px)`;\n                });\n            });\n        }\n\n        // ============================================\n        // CONTACT FORM SUBMISSION\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const formData = new FormData(contactForm);\n            const name = formData.get('name');\n            const service = formData.get('service');\n            const message = formData.get('message');\n\n            const whatsappNumber = '5516997162770';\n            const whatsappMessage = encodeURIComponent(\n                `Olá! Meu nome é ${name}.\\n\\n` +\n                `Tenho interesse em: ${service}\\n\\n` +\n                `Mensagem: ${message}`\n            );\n\n            const whatsappURL = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;\n            window.open(whatsappURL, '_blank');\n\n            contactForm.reset();\n        });\n\n        // ============================================\n        // SERVICE CARDS HOVER EFFECT\n        // ============================================\n        const serviceCards = document.querySelectorAll('.service-card');\n\n        serviceCards.forEach(card => {\n            card.addEventListener('mouseenter', function() {\n                this.style.transform = 'translateY(-5px) scale(1.02)';\n            });\n\n            card.addEventListener('mouseleave', function() {\n                this.style.transform = '';\n            });\n        });\n\n        // ============================================\n        // PAGE LOAD ANIMATION\n        // ============================================\n        window.addEventListener('load', () => {\n            document.body.style.opacity = '0';\n\n            setTimeout(() => {\n                document.body.style.transition = 'opacity 0.6s ease';\n                document.body.style.opacity = '1';\n            }, 100);\n        });\n\n        // ============================================\n        // PULSE ANIMATION FOR DIFFERENTIAL ICONS\n        // ============================================\n        const differentialIconRings = document.querySelectorAll('.differential-icon-ring');\n\n        differentialIconRings.forEach((ring, index) => {\n            ring.style.animationDelay = `${index * 0.3}s`;\n        });\n\n        // ============================================\n        // PREFERS REDUCED MOTION\n        // ============================================\n        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n        if (prefersReducedMotion.matches) {\n            document.querySelectorAll('.crystal-blob').forEach(blob => {\n                blob.style.animation = 'none';\n            });\n\n            differentialIconRings.forEach(ring => {\n                ring.style.animation = 'none';\n            });\n        }\n\n        // ============================================\n        // DYNAMIC STATS COUNTER ANIMATION\n        // ============================================\n        const heroStats = document.querySelectorAll('.hero-stat-value');\n        const statsObserver = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const target = entry.target;\n                    const finalValue = target.textContent;\n                    const numericValue = parseInt(finalValue);\n\n                    if (!isNaN(numericValue)) {\n                        let current = 0;\n                        const increment = numericValue / 50;\n                        const timer = setInterval(() => {\n                            current += increment;\n                            if (current >= numericValue) {\n                                target.textContent = finalValue;\n                                clearInterval(timer);\n                            } else {\n                                target.textContent = Math.floor(current) + (finalValue.includes('+') ? '+' : finalValue.includes('%') ? '%' : '');\n                            }\n                        }, 30);\n                    }\n\n                    statsObserver.unobserve(target);\n                }\n            });\n        }, { threshold: 0.5 });\n\n        heroStats.forEach(stat => statsObserver.observe(stat));\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"e0354f47-fa13-4d61-81da-cddadef39ff3","uuid":"f174c517-72c9-4e2c-99d6-11d7f1a88df8"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f4a33edd641d4cb0949c6a44","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/clinica-harmoniser/index.html"}]},"parent_tool_use_id":null,"session_id":"e0354f47-fa13-4d61-81da-cddadef39ff3","uuid":"0a39b2c2-c08a-4a0f-821f-2edb0e0e4144","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/clinica-harmoniser/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Clínica Harmoniser | Estética de Alta Performance em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Clínica Harmoniser - Estética de Alta Performance em Ribeirão Preto. Harmonização facial e estética avançada com tratamentos personalizados.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Tenor+Sans&family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           SAPPHIRE NOIR & PEARL FROST PALETTE\n           ============================================ */\n        :root {\n            /* Sapphire Tones */\n            --sapphire-deep: #0D1A3A;\n            --sapphire-dark: #1A2A5A;\n            --sapphire-mid: #2A3A7A;\n            --sapphire-light: #3A4A9A;\n            --sapphire-pale: #5A6AB8;\n            --sapphire-frost: #8A9AD8;\n\n            /* Pearl Frost Tones */\n            --pearl-frost: #E8F0F8;\n            --pearl-frost-light: #F0F5FA;\n            --pearl-frost-dark: #D8E8F0;\n            --pearl-ice: #F8FAFC;\n\n            /* Icy Crystal Accents */\n            --crystal-ice: #A8D0E8;\n            --crystal-blue: #88C0E0;\n            --frost-white: #F0F8FF;\n\n            /* Noir Backgrounds */\n            --noir-deep: #080810;\n            --noir-dark: #0A0A15;\n            --noir-mid: #12121F;\n            --noir-charcoal: #1A1A2A;\n\n            /* Text Colors */\n            --text-primary: #F0F0F8;\n            --text-secondary: #C8D0E0;\n            --text-muted: #8890A8;\n            --text-on-light: #1A2A4A;\n\n            /* Typography */\n            --font-display: 'Tenor Sans', 'Playfair Display', Georgia, serif;\n            --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Crystalline Border Radius - NEW PATTERN */\n            --radius-crystal-1: 75% 25% 45% 55% / 55% 35% 65% 45%;\n            --radius-crystal-2: 45% 55% 75% 25% / 35% 65% 35% 65%;\n            --radius-crystal-3: 65% 35% 40% 60% / 60% 40% 60% 40%;\n            --radius-crystal-4: 40% 60% 60% 40% / 40% 60% 40% 60%;\n            --radius-sm: 4px;\n            --radius-md: 12px;\n            --radius-lg: 24px;\n            --radius-xl: 32px;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Gradients */\n            --gradient-sapphire: linear-gradient(135deg, var(--sapphire-deep) 0%, var(--sapphire-dark) 50%, var(--sapphire-mid) 100%);\n            --gradient-frost: linear-gradient(135deg, var(--pearl-frost) 0%, var(--frost-white) 50%, var(--crystal-ice) 100%);\n            --gradient-noir: linear-gradient(135deg, var(--noir-deep) 0%, var(--noir-dark) 50%, var(--noir-mid) 100%);\n            --gradient-hero: linear-gradient(135deg, var(--noir-deep) 0%, var(--sapphire-dark) 40%, var(--noir-mid) 100%);\n            --gradient-crystal: linear-gradient(135deg, var(--sapphire-frost) 0%, var(--crystal-ice) 50%, var(--pearl-frost) 100%);\n            --gradient-icy: linear-gradient(135deg, var(--crystal-blue) 0%, var(--sapphire-frost) 50%, var(--pearl-frost) 100%);\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(8, 8, 16, 0.5);\n            --shadow-medium: 0 8px 30px rgba(8, 8, 16, 0.6);\n            --shadow-strong: 0 12px 40px rgba(8, 8, 16, 0.7);\n            --shadow-glow-sapphire: 0 0 30px rgba(58, 74, 154, 0.3);\n            --shadow-glow-frost: 0 0 30px rgba(168, 208, 232, 0.2);\n            --shadow-crystal: 0 0 40px rgba(138, 154, 216, 0.15);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background-color: var(--noir-deep);\n            color: var(--text-primary);\n            line-height: 1.7;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 400;\n            line-height: 1.2;\n            color: var(--text-primary);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 400;\n            letter-spacing: -0.01em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            font-size: clamp(1rem, 1.1vw, 1.125rem);\n            color: var(--text-secondary);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: 1rem 0;\n            background: rgba(8, 8, 16, 0.9);\n            backdrop-filter: blur(20px);\n            transition: all var(--transition-base);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav.scrolled {\n            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 var(--spacing-md);\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 400;\n            background: var(--gradient-crystal);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            color: var(--text-secondary);\n            font-size: 0.9rem;\n            font-weight: 500;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-crystal);\n            transition: width var(--transition-base);\n        }\n\n        .nav-link:hover {\n            color: var(--sapphire-frost);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-toggle {\n            display: none;\n            background: none;\n            border: none;\n            color: var(--text-primary);\n            font-size: 1.5rem;\n            cursor: pointer;\n        }\n\n        /* Mobile Menu */\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                right: 0;\n                flex-direction: column;\n                background: var(--noir-deep);\n                padding: var(--spacing-md);\n                gap: var(--spacing-sm);\n                transform: translateX(100%);\n                transition: transform var(--transition-base);\n                border-top: 1px solid rgba(138, 154, 216, 0.1);\n            }\n\n            .nav-menu.active {\n                transform: translateX(0);\n            }\n\n            .nav-toggle {\n                display: block;\n            }\n        }\n\n        /* ============================================\n           UTILITIES\n           ============================================ */\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 var(--spacing-md);\n        }\n\n        .section {\n            padding: var(--spacing-xl) 0;\n            position: relative;\n        }\n\n        .text-center {\n            text-align: center;\n        }\n\n        .sapphire-accent {\n            color: var(--sapphire-frost);\n        }\n\n        .frost-accent {\n            color: var(--crystal-ice);\n        }\n\n        /* ============================================\n           BUTTONS\n           ============================================ */\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 1rem 2rem;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            text-decoration: none;\n            border-radius: var(--radius-lg);\n            transition: all var(--transition-base);\n            cursor: pointer;\n            position: relative;\n            overflow: hidden;\n            border: none;\n        }\n\n        .btn-primary {\n            background: var(--gradient-crystal);\n            color: var(--text-on-light);\n            box-shadow: var(--shadow-glow-sapphire);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-crystal);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--sapphire-frost);\n            border: 2px solid var(--sapphire-frost);\n        }\n\n        .btn-secondary:hover {\n            background: var(--sapphire-frost);\n            color: var(--text-on-light);\n        }\n\n        /* ============================================\n           ANIMATIONS\n           ============================================ */\n        @keyframes crystal-float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg);\n            }\n            25% {\n                transform: translate(20px, -20px) rotate(5deg);\n            }\n            50% {\n                transform: translate(0, -40px) rotate(0deg);\n            }\n            75% {\n                transform: translate(-20px, -20px) rotate(-5deg);\n            }\n        }\n\n        @keyframes crystal-shimmer {\n            0%, 100% {\n                opacity: 0.6;\n                transform: scale(1);\n            }\n            50% {\n                opacity: 0.8;\n                transform: scale(1.05);\n            }\n        }\n\n        @keyframes frost-drift {\n            0%, 100% {\n                transform: translateY(0) translateX(0);\n            }\n            50% {\n                transform: translateY(-30px) translateX(15px);\n            }\n        }\n\n        @keyframes pulse-glow {\n            0%, 100% {\n                box-shadow: 0 0 20px rgba(138, 154, 216, 0.3);\n            }\n            50% {\n                box-shadow: 0 0 40px rgba(138, 154, 216, 0.6);\n            }\n        }\n\n        @keyframes fade-up {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes fade-in {\n            from {\n                opacity: 0;\n            }\n            to {\n                opacity: 1;\n            }\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            position: relative;\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        .hero-bg {\n            position: absolute;\n            inset: 0;\n            overflow: hidden;\n        }\n\n        .crystal-blob {\n            position: absolute;\n            border-radius: var(--radius-crystal-1);\n            opacity: 0.15;\n            filter: blur(60px);\n            animation: crystal-float 20s ease-in-out infinite;\n        }\n\n        .crystal-blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-sapphire);\n            top: -150px;\n            right: -100px;\n            animation-delay: 0s;\n            border-radius: var(--radius-crystal-1);\n        }\n\n        .crystal-blob-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-crystal);\n            bottom: -100px;\n            left: -100px;\n            animation-delay: -5s;\n            border-radius: var(--radius-crystal-2);\n        }\n\n        .crystal-blob-3 {\n            width: 350px;\n            height: 350px;\n            background: var(--gradient-icy);\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            animation-delay: -10s;\n            border-radius: var(--radius-crystal-3);\n        }\n\n        .crystal-blob-4 {\n            width: 250px;\n            height: 250px;\n            background: var(--gradient-frost);\n            bottom: 20%;\n            right: 15%;\n            animation-delay: -15s;\n            border-radius: var(--radius-crystal-4);\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 10;\n            max-width: 800px;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 0.5rem 1rem;\n            background: rgba(138, 154, 216, 0.1);\n            border: 1px solid rgba(138, 154, 216, 0.3);\n            border-radius: var(--radius-lg);\n            font-size: 0.875rem;\n            color: var(--sapphire-frost);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero h1 {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-subtitle {\n            font-size: clamp(1.125rem, 2vw, 1.375rem);\n            color: var(--text-secondary);\n            margin-bottom: var(--spacing-lg);\n            max-width: 600px;\n        }\n\n        .hero-cta {\n            display: flex;\n            gap: var(--spacing-sm);\n            flex-wrap: wrap;\n        }\n\n        .hero-stats {\n            display: flex;\n            gap: var(--spacing-lg);\n            margin-top: var(--spacing-lg);\n            padding-top: var(--spacing-md);\n            border-top: 1px solid rgba(138, 154, 216, 0.2);\n        }\n\n        .hero-stat {\n            text-align: center;\n        }\n\n        .hero-stat-value {\n            font-family: var(--font-display);\n            font-size: 2.5rem;\n            font-weight: 400;\n            color: var(--sapphire-frost);\n            line-height: 1;\n        }\n\n        .hero-stat-label {\n            font-size: 0.875rem;\n            color: var(--text-muted);\n            margin-top: var(--spacing-xs);\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            background: var(--noir-dark);\n        }\n\n        .section-header {\n            text-align: center;\n            max-width: 700px;\n            margin: 0 auto var(--spacing-lg);\n        }\n\n        .section-label {\n            display: inline-block;\n            font-size: 0.75rem;\n            text-transform: uppercase;\n            letter-spacing: 0.2em;\n            color: var(--sapphire-frost);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .problem-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: var(--spacing-md);\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .problem-card {\n            background: var(--noir-mid);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-lg);\n            border-left: 3px solid rgba(138, 154, 216, 0.3);\n            transition: all var(--transition-base);\n        }\n\n        .problem-card:hover {\n            border-left-color: var(--sapphire-frost);\n            transform: translateX(5px);\n            box-shadow: var(--shadow-glow-sapphire);\n        }\n\n        .problem-icon {\n            width: 48px;\n            height: 48px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: rgba(138, 154, 216, 0.1);\n            border-radius: var(--radius-md);\n            margin-bottom: var(--spacing-sm);\n            color: var(--sapphire-frost);\n        }\n\n        .solution-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .solution-card {\n            background: var(--gradient-noir);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-lg);\n            border-left: 3px solid var(--sapphire-light);\n            transition: all var(--transition-base);\n        }\n\n        .solution-card:hover {\n            border-left-color: var(--crystal-ice);\n            transform: translateX(5px);\n            box-shadow: var(--shadow-glow-frost);\n        }\n\n        .solution-icon {\n            width: 48px;\n            height: 48px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: rgba(168, 208, 232, 0.1);\n            border-radius: var(--radius-md);\n            margin-bottom: var(--spacing-sm);\n            color: var(--crystal-ice);\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            background: var(--gradient-hero);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .service-card {\n            background: var(--noir-mid);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-lg);\n            border: 1px solid rgba(138, 154, 216, 0.1);\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 3px;\n            background: var(--gradient-crystal);\n            transform: scaleX(0);\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-crystal);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--gradient-sapphire);\n            border-radius: var(--radius-md);\n            margin-bottom: var(--spacing-sm);\n            color: var(--pearl-frost);\n        }\n\n        .service-title {\n            font-family: var(--font-display);\n            font-size: 1.375rem;\n            margin-bottom: var(--spacing-xs);\n            color: var(--text-primary);\n        }\n\n        .service-description {\n            color: var(--text-secondary);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-link {\n            color: var(--sapphire-frost);\n            font-weight: 600;\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            transition: gap var(--transition-fast);\n        }\n\n        .service-link:hover {\n            gap: 1rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            background: var(--noir-dark);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .testimonial-card {\n            background: var(--noir-mid);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-lg);\n            position: relative;\n        }\n\n        .testimonial-quote {\n            position: absolute;\n            top: var(--spacing-md);\n            right: var(--spacing-md);\n            font-size: 4rem;\n            color: rgba(138, 154, 216, 0.1);\n            font-family: var(--font-display);\n            line-height: 1;\n        }\n\n        .testimonial-rating {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: var(--spacing-sm);\n            color: var(--sapphire-frost);\n        }\n\n        .testimonial-text {\n            color: var(--text-secondary);\n            margin-bottom: var(--spacing-md);\n            font-style: italic;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-crystal);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-family: var(--font-display);\n            font-size: 1.25rem;\n            color: var(--text-on-light);\n        }\n\n        .testimonial-info {\n            flex: 1;\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n            color: var(--text-primary);\n        }\n\n        .testimonial-role {\n            font-size: 0.875rem;\n            color: var(--text-muted);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            background: var(--gradient-hero);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-icon-wrapper {\n            width: 80px;\n            height: 80px;\n            margin: 0 auto var(--spacing-sm);\n            position: relative;\n        }\n\n        .differential-icon-ring {\n            position: absolute;\n            inset: 0;\n            border: 2px solid var(--sapphire-light);\n            border-radius: 50%;\n            animation: pulse-glow 2s ease-in-out infinite;\n        }\n\n        .differential-icon {\n            width: 100%;\n            height: 100%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--sapphire-frost);\n        }\n\n        .differential-title {\n            font-family: var(--font-display);\n            font-size: 1.125rem;\n            margin-bottom: var(--spacing-xs);\n            color: var(--text-primary);\n        }\n\n        .differential-text {\n            color: var(--text-secondary);\n            font-size: 0.9375rem;\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            background: var(--noir-dark);\n        }\n\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n            align-items: start;\n        }\n\n        .contact-info {\n            padding: var(--spacing-md);\n        }\n\n        .contact-item {\n            display: flex;\n            gap: var(--spacing-sm);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-icon {\n            width: 48px;\n            height: 48px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: rgba(138, 154, 216, 0.1);\n            border-radius: var(--radius-md);\n            color: var(--sapphire-frost);\n            flex-shrink: 0;\n        }\n\n        .contact-details h4 {\n            margin-bottom: 0.25rem;\n            color: var(--text-primary);\n        }\n\n        .contact-details p {\n            color: var(--text-secondary);\n            margin: 0;\n        }\n\n        .contact-form-wrapper {\n            background: var(--noir-mid);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-lg);\n            border: 1px solid rgba(138, 154, 216, 0.1);\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .form-label {\n            display: block;\n            margin-bottom: 0.5rem;\n            color: var(--text-primary);\n            font-weight: 500;\n        }\n\n        .form-input,\n        .form-textarea,\n        .form-select {\n            width: 100%;\n            padding: 0.875rem 1rem;\n            background: var(--noir-deep);\n            border: 1px solid rgba(138, 154, 216, 0.2);\n            border-radius: var(--radius-md);\n            color: var(--text-primary);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: all var(--transition-fast);\n        }\n\n        .form-input:focus,\n        .form-textarea:focus,\n        .form-select:focus {\n            outline: none;\n            border-color: var(--sapphire-frost);\n            box-shadow: 0 0 0 3px rgba(138, 154, 216, 0.1);\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            margin-top: var(--spacing-sm);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--noir-deep);\n            padding: var(--spacing-lg) 0 var(--spacing-md);\n            border-top: 1px solid rgba(138, 154, 216, 0.1);\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-lg);\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .footer-brand {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            background: var(--gradient-crystal);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-description {\n            color: var(--text-muted);\n            font-size: 0.9375rem;\n        }\n\n        .footer-links {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-links a {\n            color: var(--text-secondary);\n            transition: color var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--sapphire-frost);\n        }\n\n        .footer-bottom {\n            text-align: center;\n            padding-top: var(--spacing-md);\n            border-top: 1px solid rgba(138, 154, 216, 0.1);\n            color: var(--text-muted);\n            font-size: 0.875rem;\n        }\n\n        /* ============================================\n           SCROLL ANIMATIONS\n           ============================================ */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: all 0.6s ease;\n        }\n\n        .wow-fade-up.animated {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.6s ease;\n        }\n\n        .wow-fade-in.animated {\n            opacity: 1;\n        }\n\n        .stagger-1 { animation-delay: 0ms; }\n        .stagger-2 { animation-delay: 200ms; }\n        .stagger-3 { animation-delay: 400ms; }\n        .stagger-4 { animation-delay: 600ms; }\n        .stagger-5 { animation-delay: 800ms; }\n        .stagger-6 { animation-delay: 1000ms; }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 1024px) {\n            .contact-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .hero-stats {\n                flex-wrap: wrap;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .hero {\n                padding: var(--spacing-lg) 0;\n            }\n\n            .hero-cta {\n                flex-direction: column;\n            }\n\n            .hero-cta .btn {\n                width: 100%;\n                justify-content: center;\n            }\n\n            .section {\n                padding: var(--spacing-lg) 0;\n            }\n\n            .problem-grid,\n            .solution-grid,\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .crystal-blob {\n                opacity: 0.1;\n            }\n\n            .crystal-blob-1 {\n                width: 300px;\n                height: 300px;\n            }\n\n            .crystal-blob-2 {\n                width: 250px;\n                height: 250px;\n            }\n        }\n\n        @media (max-width: 480px) {\n            h1 {\n                font-size: 2rem;\n            }\n\n            h2 {\n                font-size: 1.75rem;\n            }\n\n            .btn {\n                padding: 0.875rem 1.5rem;\n            }\n\n            .hero-stats {\n                gap: var(--spacing-md);\n            }\n\n            .hero-stat-value {\n                font-size: 2rem;\n            }\n        }\n\n        /* ============================================\n           ACCESSIBILITY\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *,\n            *::before,\n            *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n\n            .crystal-blob {\n                animation: none;\n            }\n        }\n\n        /* Focus visible styles */\n        :focus-visible {\n            outline: 2px solid var(--sapphire-frost);\n            outline-offset: 2px;\n        }\n\n        /* Skip link */\n        .skip-link {\n            position: absolute;\n            top: -40px;\n            left: 0;\n            background: var(--sapphire-dark);\n            color: var(--pearl-frost);\n            padding: 0.5rem 1rem;\n            z-index: 9999;\n            transition: top var(--transition-fast);\n        }\n\n        .skip-link:focus {\n            top: 0;\n        }\n    </style>\n</head>\n<body>\n    <a href=\"#main\" class=\"skip-link\">Pular para o conteúdo principal</a>\n\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Harmoniser</a>\n            <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Toggle menu\">\n                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                    <path d=\"M3 12h18M3 6h18M3 18h18\"/>\n                </svg>\n            </button>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#home\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#services\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#testimonials\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#differentials\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contact\" class=\"nav-link\">Contato</a></li>\n            </ul>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-bg\">\n            <div class=\"crystal-blob crystal-blob-1\"></div>\n            <div class=\"crystal-blob crystal-blob-2\"></div>\n            <div class=\"crystal-blob crystal-blob-3\"></div>\n            <div class=\"crystal-blob crystal-blob-4\"></div>\n        </div>\n        <div class=\"container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge stagger-1\">\n                    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                        <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                    </svg>\n                    Estética de Alta Performance\n                </div>\n                <h1 class=\"stagger-2\">Sua Beleza Elevada à Perfeição</h1>\n                <p class=\"hero-subtitle stagger-3\">Harmonização facial e estética avançada com resultados naturais e sofisticados. Transforme sua autoestima com tratamentos personalizados.</p>\n                <div class=\"hero-cta stagger-4\">\n                    <a href=\"#contact\" class=\"btn btn-primary\">\n                        Agendar Consulta\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                    <a href=\"#services\" class=\"btn btn-secondary\">\n                        Conhecer Tratamentos\n                    </a>\n                </div>\n                <div class=\"hero-stats stagger-5\">\n                    <div class=\"hero-stat\">\n                        <div class=\"hero-stat-value\">500+</div>\n                        <div class=\"hero-stat-label\">Clientes Satisfeitos</div>\n                    </div>\n                    <div class=\"hero-stat\">\n                        <div class=\"hero-stat-value\">8+</div>\n                        <div class=\"hero-stat-label\">Anos de Experiência</div>\n                    </div>\n                    <div class=\"hero-stat\">\n                        <div class=\"hero-stat-value\">100%</div>\n                        <div class=\"hero-stat-label\">Resultados Naturais</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\" id=\"problem-solution\">\n        <div class=\"container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-label\">Sua Jornada</span>\n                <h2>Entendemos Suas Necessidades</h2>\n                <p>Sabemos que buscar tratamentos estéticos é uma decisão importante. Na Clínica Harmoniser, combinamos expertise técnica com olhar artístico para resultados que refletem sua essência.</p>\n            </div>\n\n            <div class=\"problem-grid\">\n                <div class=\"problem-card wow-fade-up stagger-1\">\n                    <div class=\"problem-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            <path d=\"M8 14s1.5 2 4 2 4-2 4-2\"/>\n                            <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"/>\n                            <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"/>\n                        </svg>\n                    </div>\n                    <h3>Insegurança com Aparência</h3>\n                    <p>Sinta-se confiante com sua imagem realçando seus traços naturais, não os mascarando.</p>\n                </div>\n                <div class=\"problem-card wow-fade-up stagger-2\">\n                    <div class=\"problem-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 8v4L12 16\"/>\n                            <path d=\"M12 2L2 7L12 12L22 7L12 2Z\"/>\n                            <path d=\"M2 17L12 22L22 17\"/>\n                        </svg>\n                    </div>\n                    <h3>Resultados Artificiais</h3>\n                    <p>Nossa abordagem privilegia a naturalidade e harmonia com seus traços originais.</p>\n                </div>\n                <div class=\"problem-card wow-fade-up stagger-3\">\n                    <div class=\"problem-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z\"/>\n                            <line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"/>\n                            <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"/>\n                        </svg>\n                    </div>\n                    <h3>Medo de Procedimentos</h3>\n                    <p>Técnicas minimamente invasivas com recuperação rápida e desconforto mínimo.</p>\n                </div>\n            </div>\n\n            <div class=\"solution-grid\">\n                <div class=\"solution-card wow-fade-up stagger-1\">\n                    <div class=\"solution-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/>\n                        </svg>\n                    </div>\n                    <h3>Olhar Artístico Personalizado</h3>\n                    <p>Cada tratamento é planejado exclusivamente para harmonizar com seus traços únicos.</p>\n                </div>\n                <div class=\"solution-card wow-fade-up stagger-2\">\n                    <div class=\"solution-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/>\n                            <polyline points=\"22 4 12 14.01 9 11.01\"/>\n                        </svg>\n                    </div>\n                    <h3>Tecnologia Avançada</h3>\n                    <p>Utilizamos os melhores produtos e técnicas disponíveis no mercado estético.</p>\n                </div>\n                <div class=\"solution-card wow-fade-up stagger-3\">\n                    <div class=\"solution-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3\"/>\n                        </svg>\n                    </div>\n                    <h3>Acompanhamento Completo</h3>\n                    <p>Suporte total antes, durante e depois do tratamento para sua tranquilidade.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"services\">\n        <div class=\"container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-label\">Tratamentos</span>\n                <h2>Procedimentos Especializados</h2>\n                <p>Oferecemos uma gama completa de tratamentos estéticos faciais com foco em harmonização natural e resultados sofisticados.</p>\n            </div>\n\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up stagger-1\">\n                    <div class=\"service-icon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3 class=\"service-title\">Harmonização Facial</h3>\n                    <p class=\"service-description\">Equilibrio estético dos traços faciais através de preenchedores e toxina botulínica para resultados naturais e harmoniosos.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up stagger-2\">\n                    <div class=\"service-icon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"