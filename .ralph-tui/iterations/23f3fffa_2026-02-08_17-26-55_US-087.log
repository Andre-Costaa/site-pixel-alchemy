ht=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"/>\n                            </svg>\n                        </div>\n                        <div class=\"contact-details\">\n                            <h4>WhatsApp</h4>\n                            <p>(16) 99716-2770</p>\n                        </div>\n                    </div>\n\n                    <div class=\"contact-item\">\n                        <div class=\"contact-icon\">\n                            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z\"/>\n                            </svg>\n                        </div>\n                        <div class=\"contact-details\">\n                            <h4>Segurança</h4>\n                            <p>Procedimentos certificados</p>\n                            <p>Ambiente estéril e seguro</p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"contact-form-wrapper wow-fade-up\">\n                    <form class=\"contact-form\" id=\"contactForm\">\n                        <div class=\"form-group\">\n                            <label for=\"name\" class=\"form-label\">Nome completo</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" class=\"form-input\" placeholder=\"Digite seu nome\" required>\n                        </div>\n\n                        <div class=\"form-group\">\n                            <label for=\"e