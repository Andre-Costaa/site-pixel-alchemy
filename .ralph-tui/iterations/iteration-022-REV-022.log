rão Preto - SP\n              - text: \"CEP: 14050-380\"\n        - generic [ref=e249]:\n          - img [ref=e251]\n          - generic [ref=e253]:\n            - generic [ref=e254]: Telefone\n            - generic [ref=e255]: (16) 3442-3577\n        - generic [ref=e256]:\n          - img [ref=e258]\n          - generic [ref=e260]:\n            - generic [ref=e261]: Horário de Funcionamento\n            - generic [ref=e262]:\n              - text: \"Segunda a Sexta: 8h às 19h\"\n              - text: \"Sábado: 8h às 14h\"\n      - generic [ref=e264]:\n        - heading \"Agende sua Consulta\" [level=3] [ref=e265]\n        - generic [ref=e266]:\n          - generic [ref=e267]: Nome Completo\n          - textbox \"Nome Completo\" [ref=e268]:\n            - /placeholder: Seu nome\n        - generic [ref=e269]:\n          - generic [ref=e270]: Telefone\n          - textbox \"Telefone\" [ref=e271]:\n            - /placeholder: (00) 00000-0000\n        - generic [ref=e272]:\n          - generic [ref=e273]: Serviço Desejado\n          - combobox \"Serviço Desejado\" [ref=e274]:\n            - option \"Selecione o serviço\" [selected]\n            - option \"Consulta Clínica\"\n            - option \"Vacinação\"\n            - option \"Cirurgia\"\n            - option \"Exames Laboratoriais\"\n            - option \"Radiologia\"\n            - option \"Nutrição\"\n            - option \"Outro\"\n        - generic [ref=e275]:\n          - generic [ref=e276]: Mensagem (opcional)\n          - textbox \"Mensagem (opcional)\" [ref=e277]:\n            - /placeholder: Conte-nos mais sobre seu pet...\n        - button \"Solicitar Agendamento\" [ref=e278] [cursor=pointer]:\n          - text: Solicitar Agendamento\n          - img [ref=e279]\n  - contentinfo [ref=e281]:\n    - generic [ref=e282]:\n      - generic [ref=e283]:\n        - generic [ref=e284]:\n          - generic [ref=e285]:\n            - img [ref=e286]\n            - text: Snoopy Veterinary Clinic\n          - paragra