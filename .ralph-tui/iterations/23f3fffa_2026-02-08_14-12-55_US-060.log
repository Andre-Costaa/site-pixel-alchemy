              <option value=\"Protocolos Exclusivos\">Protocolos Exclusivos</option>\n                            </select>\n                        </div>\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"message\">Mensagem</label>\n                            <textarea id=\"message\" name=\"message\" class=\"form-textarea\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                        </div>\n                        <button type=\"submit\" class=\"form-submit\">\n                            Enviar WhatsApp\n                            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M22 2L11 13\"/>\n                                <path d=\"M22 2l-7 20-4-9-9-4 20-7z\"/>\n                            </svg>\n                        </button>\n                    </form>\n                    <div class=\"contact-info\">\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                    <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/>\n                                    <circle cx=\"12\" cy=\"10\" r=\"3\"/>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-title\">Endereço</div>\n                            <div class=\"contact-item-text\">R. João Penteado, 1545 - Jardim America<br>Ribeirão Preto - SP, 14020-180</div>\n                        </div>\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                    <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"/>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-title\">Telefone/WhatsApp</div>\n                            <div class=\"contact-item-text\">(16) 99240-4658</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-grid\">\n                <div class=\"footer-brand\">\n                    <div class=\"footer-logo\">Dra Thamyres Branco</div>\n                    <p>Harmonização Facial e Estética Avançada em Ribeirão Preto. Resultados naturais que realçam sua beleza única.</p>\n                </div>\n                <div class=\"footer-column\">\n                    <h4 class=\"footer-title\">Links Rápidos</h4>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#home\">Início</a></li>\n                        <li><a href=\"#services\">Serviços</a></li>\n                        <li><a href=\"#testimonials\">Depoimentos</a></li>\n                        <li><a href=\"#contact\">Contato</a></li>\n                    </ul>\n                </div>\n                <div class=\"footer-column\">\n                    <h4 class=\"footer-title\">Serviços</h4>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#services\">Harmonização Facial</a></li>\n                        <li><a href=\"#services\">Toxina Botulínica</a></li>\n                        <li><a href=\"#services\">Preenchedores</a></li>\n                        <li><a href=\"#services\">Bioestimuladores</a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"footer-bottom\">\n                <p>&copy; 2025 Dra Thamyres Branco. Todos os direitos reservados.</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION SCROLL EFFECT\n        // ============================================\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                nav.classList.add('scrolled');\n            } else {\n                nav.classList.remove('scrolled');\n            }\n\n            if (currentScroll > lastScroll && currentScroll > 200) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // ============================================\n        // MOBILE MENU TOGGLE\n        // ============================================\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close menu when clicking on links\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL FOR ANCHOR LINKS\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER FOR SCROLL ANIMATIONS\n        // ============================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('animated');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n            observer.observe(el);\n        });\n\n        // Apply delay variations\n        document.querySelectorAll('[data-delay]').forEach(el => {\n            const delay = el.getAttribute('data-delay');\n            el.style.transitionDelay = `${delay}ms`;\n        });\n\n        // ============================================\n        // CONTACT FORM - WHATSAPP INTEGRATION\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const formData = new FormData(contactForm);\n            const name = formData.get('name');\n            const phone = formData.get('phone');\n            const service = formData.get('service');\n            const message = formData.get('message');\n\n            const whatsappNumber = '5516992404658';\n            const text = `Olá! Meu nome é ${name}.\\nTelefone: ${phone}\\nServiço de interesse: ${service}\\n\\nMensagem: ${message || 'Gostaria de agendar uma consulta.'}`;\n\n            const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;\n            window.open(whatsappUrl, '_blank');\n        });\n\n        // ============================================\n        // PARALLAX EFFECT ON HERO BLOBS\n        // ============================================\n        document.addEventListener('mousemove', (e) => {\n            const blobs = document.querySelectorAll('.hero-blob');\n            const x = (e.clientX / window.innerWidth - 0.5) * 20;\n            const y = (e.clientY / window.innerHeight - 0.5) * 20;\n\n            blobs.forEach((blob, index) => {\n                const speed = (index + 1) * 0.5;\n                blob.style.transform = `translate(${x * speed}px, ${y * speed}px)`;\n            });\n        });\n\n        // ============================================\n        // PREFERS REDUCED MOTION\n        // ============================================\n        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n            document.querySelectorAll('.hero-blob').forEach(blob => {\n                blob.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"27c2c3a8-a944-44a8-8cfe-2211aac214ba","uuid":"c02cafb6-92d0-407a-933e-fb1426baa994"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_0193fc92711d4e7fa18ae0e3","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-thamyres-branco-harmonizacao-facial/index.html"}]},"parent_tool_use_id":null,"session_id":"27c2c3a8-a944-44a8-8cfe-2211aac214ba","uuid":"eb127f6b-1cd7-46c7-8be6-88297d74bb2b","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-thamyres-branco-harmonizacao-facial/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra Thamyres Branco | Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra Thamyres Branco - Atendimento especializado em harmonização facial e estética avançada em Ribeirão Preto. Agende sua consulta.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        /* ============================================\n           CSS RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        :root {\n            /* Amethyst Noir & Platinum Palette */\n            --color-amethyst: #6B3A82;\n            --color-amethyst-light: #8B4A9E;\n            --color-amethyst-dark: #4B2A62;\n            --color-amethyst-deep: #2B1A42;\n            --color-amethyst-mystic: #1A0E28;\n\n            --color-platinum: #C8C8D0;\n            --color-platinum-light: #D8D8E0;\n            --color-platinum-dark: #A8A8B0;\n            --color-platinum-shimmer: #E8E8F0;\n\n            --color-marble: #FAFAFC;\n            --color-marble-warm: #F5F5F8;\n            --color-white: #FFFFFF;\n\n            --color-onyx: #1A1A1E;\n            --color-charcoal: #2A2A30;\n            --color-stone: #3A3A40;\n\n            --color-text-dark: #1A1A1E;\n            --color-text-muted: #6A6A70;\n            --color-text-light: #FAFAFC;\n\n            /* Gradients */\n            --gradient-amethyst: linear-gradient(135deg, #6B3A82 0%, #4B2A62 100%);\n            --gradient-amethyst-rich: linear-gradient(135deg, #8B4A9E 0%, #6B3A82 50%, #4B2A62 100%);\n            --gradient-platinum: linear-gradient(135deg, #C8C8D0 0%, #A8A8B0 100%);\n            --gradient-mystic: linear-gradient(135deg, #6B3A82 0%, #C8C8D0 100%);\n            --gradient-marble: linear-gradient(135deg, #FAFAFC 0%, #F5F5F8 100%);\n            --gradient-shimmer: linear-gradient(90deg, transparent, rgba(200, 200, 208, 0.4), transparent);\n\n            /* Typography */\n            --font-display: 'Playfair Display', Georgia, serif;\n            --font-body: 'Space Grotesk', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Border Radius - Geode/Crystal Shapes */\n            --radius-geode-1: 72% 28% 48% 52% / 52% 38% 62% 48%;\n            --radius-geode-2: 48% 52% 68% 32% / 38% 62% 38% 62%;\n            --radius-geode-3: 62% 38% 42% 58% / 58% 42% 52% 48%;\n            --radius-geode-4: 38% 62% 52% 48% / 42% 58% 48% 52%;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(26, 26, 30, 0.08);\n            --shadow-md: 0 8px 24px rgba(26, 26, 30, 0.12);\n            --shadow-lg: 0 16px 48px rgba(26, 26, 30, 0.16);\n            --shadow-platinum: 0 8px 32px rgba(200, 200, 208, 0.35);\n            --shadow-amethyst: 0 8px 32px rgba(107, 58, 130, 0.35);\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.6;\n            color: var(--color-text-dark);\n            background-color: var(--color-marble);\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 700;\n            line-height: 1.2;\n            color: var(--color-amethyst-mystic);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            letter-spacing: -0.01em;\n        }\n\n        h3 {\n            font-size: clamp(1.25rem, 2.5vw, 1.75rem);\n        }\n\n        p {\n            font-size: 1rem;\n            line-height: 1.7;\n            color: var(--color-text-muted);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            background: rgba(250, 250, 252, 0.95);\n            backdrop-filter: blur(20px);\n            border-bottom: 1px solid rgba(107, 58, 130, 0.1);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav.scrolled {\n            box-shadow: 0 4px 20px rgba(107, 58, 130, 0.1);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 1rem 2rem;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-amethyst);\n            letter-spacing: -0.02em;\n        }\n\n        .nav-logo span {\n            color: var(--color-platinum-dark);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: 2rem;\n            list-style: none;\n        }\n\n        .nav-link {\n            font-weight: 500;\n            color: var(--color-text-dark);\n            position: relative;\n            padding: 0.5rem 0;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-amethyst);\n            transition: width var(--transition-base);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--gradient-amethyst);\n            color: var(--color-white) !important;\n            padding: 0.75rem 1.5rem;\n            border-radius: 50px;\n            font-weight: 600;\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-amethyst);\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            cursor: pointer;\n            padding: 5px;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-amethyst);\n            transition: var(--transition-base);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            position: relative;\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            overflow: hidden;\n            background: var(--gradient-marble);\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-geode-1);\n            filter: blur(60px);\n            opacity: 0.4;\n            animation: geode-float 20s ease-in-out infinite;\n        }\n\n        .hero-blob-1 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-amethyst);\n            top: 10%;\n            left: -5%;\n            animation-delay: 0s;\n        }\n\n        .hero-blob-2 {\n            width: 350px;\n            height: 350px;\n            background: var(--gradient-platinum);\n            top: 50%;\n            right: -5%;\n            animation-delay: -5s;\n            border-radius: var(--radius-geode-2);\n        }\n\n        .hero-blob-3 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(135deg, #8B4A9E 0%, #C8C8D0 100%);\n            bottom: 10%;\n            left: 30%;\n            animation-delay: -10s;\n            border-radius: var(--radius-geode-3);\n            opacity: 0.3;\n        }\n\n        .hero-blob-4 {\n            width: 250px;\n            height: 250px;\n            background: linear-gradient(135deg, #6B3A82 0%, #A8A8B0 100%);\n            top: 30%;\n            right: 20%;\n            animation-delay: -15s;\n            border-radius: var(--radius-geode-4);\n            opacity: 0.25;\n        }\n\n        @keyframes geode-float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(90deg) scale(1.1);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(180deg) scale(0.9);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(270deg) scale(1.05);\n            }\n        }\n\n        .hero-container {\n            position: relative;\n            z-index: 10;\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 6rem 2rem 4rem;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: center;\n        }\n\n        .hero-content {\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fade-up 0.8s ease forwards;\n        }\n\n        @keyframes fade-up {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .hero-badge {\n            display: inline-block;\n            background: var(--gradient-amethyst);\n            color: var(--color-white);\n            padding: 0.5rem 1.25rem;\n            border-radius: 50px;\n            font-size: 0.875rem;\n            font-weight: 600;\n            margin-bottom: 1.5rem;\n            box-shadow: var(--shadow-amethyst);\n        }\n\n        .hero-title {\n            margin-bottom: 1.5rem;\n            color: var(--color-amethyst-mystic);\n        }\n\n        .hero-title span {\n            background: var(--gradient-mystic);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-description {\n            font-size: 1.125rem;\n            margin-bottom: 2rem;\n            max-width: 500px;\n        }\n\n        .hero-ctas {\n            display: flex;\n            gap: 1rem;\n            flex-wrap: wrap;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            border-radius: 50px;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all var(--transition-base);\n            border: none;\n            font-family: var(--font-body);\n            font-size: 1rem;\n        }\n\n        .btn-primary {\n            background: var(--gradient-amethyst);\n            color: var(--color-white);\n            box-shadow: var(--shadow-amethyst);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 12px 40px rgba(107, 58, 130, 0.4);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-amethyst);\n            border: 2px solid var(--color-amethyst);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-amethyst);\n            color: var(--color-white);\n        }\n\n        .hero-image {\n            position: relative;\n            opacity: 0;\n            transform: translateX(30px);\n            animation: fade-right 0.8s ease 0.2s forwards;\n        }\n\n        @keyframes fade-right {\n            to {\n                opacity: 1;\n                transform: translateX(0);\n            }\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            border-radius: var(--radius-geode-1);\n            overflow: hidden;\n            box-shadow: var(--shadow-lg);\n        }\n\n        .hero-image img {\n            width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        .hero-float-card {\n            position: absolute;\n            background: var(--color-white);\n            padding: 1rem 1.5rem;\n            border-radius: 20px;\n            box-shadow: var(--shadow-lg);\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n            z-index: 10;\n        }\n\n        .hero-float-card-1 {\n            top: 10%;\n            left: -30px;\n            animation: float-card 6s ease-in-out infinite;\n        }\n\n        .hero-float-card-2 {\n            bottom: 15%;\n            right: -30px;\n            animation: float-card 6s ease-in-out infinite -3s;\n        }\n\n        @keyframes float-card {\n            0%, 100% {\n                transform: translateY(0);\n            }\n            50% {\n                transform: translateY(-15px);\n            }\n        }\n\n        .float-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-amethyst);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-white);\n        }\n\n        .float-text strong {\n            display: block;\n            color: var(--color-amethyst);\n            font-size: 1.25rem;\n        }\n\n        .float-text span {\n            font-size: 0.875rem;\n            color: var(--color-text-muted);\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-white);\n        }\n\n        .section-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .section-tag {\n            display: inline-block;\n            background: var(--gradient-amethyst);\n            color: var(--color-white);\n            padding: 0.5rem 1.25rem;\n            border-radius: 50px;\n            font-size: 0.875rem;\n            font-weight: 600;\n            margin-bottom: 1rem;\n        }\n\n        .section-title {\n            margin-bottom: 1rem;\n        }\n\n        .section-description {\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        .ps-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 2rem;\n        }\n\n        .ps-card {\n            background: var(--color-marble);\n            padding: 2.5rem;\n            border-radius: 30px;\n            border-left: 4px solid var(--color-amethyst);\n            transition: all var(--transition-base);\n        }\n\n        .ps-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-md);\n        }\n\n        .ps-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-amethyst);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-white);\n            font-size: 1.5rem;\n            margin-bottom: 1.5rem;\n        }\n\n        .ps-card.solution {\n            border-left-color: var(--color-platinum-dark);\n        }\n\n        .ps-card.solution .ps-icon {\n            background: var(--gradient-platinum);\n        }\n\n        .ps-title {\n            font-size: 1.5rem;\n            margin-bottom: 1rem;\n            color: var(--color-amethyst-mystic);\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--gradient-marble);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .service-card {\n            background: var(--color-white);\n            padding: 2.5rem;\n            border-radius: 30px;\n            text-align: center;\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-amethyst);\n            transform: scaleX(0);\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-card:hover {\n            transform: translateY(-10px);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .service-icon {\n            width: 80px;\n            height: 80px;\n            background: var(--gradient-amethyst);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin: 0 auto 1.5rem;\n            font-size: 2rem;\n            color: var(--color-white);\n        }\n\n        .service-title {\n            margin-bottom: 1rem;\n            color: var(--color-amethyst-mystic);\n        }\n\n        .service-description {\n            font-size: 0.9375rem;\n            margin-bottom: 1.5rem;\n        }\n\n        .service-link {\n            color: var(--color-amethyst);\n            font-weight: 600;\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .service-link:hover {\n            gap: 1rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-amethyst-mystic);\n            color: var(--color-white);\n        }\n\n        .testimonials .section-title,\n        .testimonials .section-description {\n            color: var(--color-white);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(10px);\n            padding: 2.5rem;\n            border-radius: 30px;\n            border: 1px solid rgba(255, 255, 255, 0.1);\n        }\n\n        .testimonial-stars {\n            color: #FFD700;\n            margin-bottom: 1rem;\n            font-size: 1.25rem;\n        }\n\n        .testimonial-quote {\n            font-size: 1rem;\n            line-height: 1.8;\n            margin-bottom: 1.5rem;\n            color: var(--color-platinum-light);\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-platinum);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 700;\n            color: var(--color-amethyst-mystic);\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n            color: var(--color-white);\n        }\n\n        .testimonial-role {\n            font-size: 0.875rem;\n            color: var(--color-platinum-dark);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-white);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: 2rem;\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            display: inline-block;\n            margin-bottom: 1.5rem;\n        }\n\n        .differential-icon {\n            width: 80px;\n            height: 80px;\n            background: var(--gradient-amethyst);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 2rem;\n            color: var(--color-white);\n            position: relative;\n            z-index: 2;\n        }\n\n        .differential-ring {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 100%;\n            height: 100%;\n            border: 2px solid var(--color-amethyst);\n            border-radius: 50%;\n            animation: pulse-ring 2s ease-out infinite;\n        }\n\n        @keyframes pulse-ring {\n            0% {\n                transform: translate(-50%, -50%) scale(1);\n                opacity: 1;\n            }\n            100% {\n                transform: translate(-50%, -50%) scale(1.5);\n                opacity: 0;\n            }\n        }\n\n        .differential-title {\n            margin-bottom: 0.75rem;\n            color: var(--color-amethyst-mystic);\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--gradient-marble);\n        }\n\n        .contact-container {\n            max-width: 800px;\n            margin: 0 auto;\n        }\n\n        .contact-card {\n            background: var(--color-white);\n            border-radius: 40px;\n            padding: 4rem;\n            box-shadow: var(--shadow-lg);\n        }\n\n        .contact-form {\n            display: grid;\n            gap: 1.5rem;\n        }\n\n        .form-group {\n            display: grid;\n            gap: 0.5rem;\n        }\n\n        .form-label {\n            font-weight: 600;\n            color: var(--color-amethyst-mystic);\n        }\n\n        .form-input,\n        .form-select,\n        .form-textarea {\n            width: 100%;\n            padding: 1rem 1.25rem;\n            border: 2px solid var(--color-platinum-shimmer);\n            border-radius: 15px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: all var(--transition-fast);\n            background: var(--color-marble);\n        }\n\n        .form-input:focus,\n        .form-select:focus,\n        .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-amethyst);\n            box-shadow: 0 0 0 4px rgba(107, 58, 130, 0.1);\n        }\n\n        .form-textarea {\n            min-height: 150px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            background: var(--gradient-amethyst);\n            color: var(--color-white);\n            padding: 1.25rem 2.5rem;\n            border: none;\n            border-radius: 50px;\n            font-weight: 600;\n            font-size: 1.125rem;\n            cursor: pointer;\n            transition: all var(--transition-base);\n            box-shadow: var(--shadow-amethyst);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 12px 40px rgba(107, 58, 130, 0.4);\n        }\n\n        .contact-info {\n            margin-top: 3rem;\n            padding-top: 3rem;\n            border-top: 1px solid var(--color-platinum-shimmer);\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 2rem;\n        }\n\n        .contact-item {\n            text-align: center;\n        }\n\n        .contact-item-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-amethyst);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin: 0 auto 1rem;\n            color: var(--color-white);\n        }\n\n        .contact-item-title {\n            font-weight: 600;\n            margin-bottom: 0.5rem;\n            color: var(--color-amethyst-mystic);\n        }\n\n        .contact-item-text {\n            color: var(--color-text-muted);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--color-amethyst-mystic);\n            color: var(--color-white);\n            padding: 4rem 2rem 2rem;\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-grid {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: 4rem;\n            margin-bottom: 3rem;\n        }\n\n        .footer-brand .footer-logo {\n            font-family: var(--font-display);\n            font-size: 1.75rem;\n            font-weight: 700;\n            margin-bottom: 1rem;\n            color: var(--color-white);\n        }\n\n        .footer-brand p {\n            color: var(--color-platinum-light);\n            max-width: 300px;\n        }\n\n        .footer-title {\n            font-weight: 600;\n            margin-bottom: 1.5rem;\n            color: var(--color-white);\n        }\n\n        .footer-links {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.75rem;\n        }\n\n        .footer-links a {\n            color: var(--color-platinum-light);\n            transition: color var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-white);\n        }\n\n        .footer-bottom {\n            padding-top: 2rem;\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            text-align: center;\n            color: var(--color-platinum-dark);\n        }\n\n        /* ============================================\n           SCROLL ANIMATIONS\n           ============================================ */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: all 0.6s ease;\n        }\n\n        .wow-fade-up.animated {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.6s ease;\n        }\n\n        .wow-fade-in.animated {\n            opacity: 1;\n        }\n\n        /* Delay variations */\n        .wow-delay-1 { animation-delay: 0.1s; }\n        .wow-delay-2 { animation-delay: 0.2s; }\n        .wow-delay-3 { animation-delay: 0.3s; }\n        .wow-delay-4 { animation-delay: 0.4s; }\n        .wow-delay-5 { animation-delay: 0.5s; }\n        .wow-delay-6 { animation-delay: 0.6s; }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 1024px) {\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-description {\n                margin-left: auto;\n                margin-right: auto;\n            }\n\n            .hero-ctas {\n                justify-content: center;\n            }\n\n            .hero-image {\n                order: -1;\n                margin-bottom: 2rem;\n            }\n\n            .hero-float-card {\n                display: none;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .footer-grid {\n                grid-template-columns: 1fr 1fr;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                right: 0;\n                background: var(--color-white);\n                flex-direction: column;\n                padding: 2rem;\n                gap: 1rem;\n                transform: translateX(-100%);\n                transition: transform var(--transition-base);\n                box-shadow: var(--shadow-lg);\n            }\n\n            .nav-menu.active {\n                transform: translateX(0);\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .ps-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-grid {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .contact-info {\n                grid-template-columns: 1fr;\n            }\n\n            .contact-card {\n                padding: 2rem;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .hero-ctas {\n                flex-direction: column;\n            }\n\n            .btn {\n                width: 100%;\n                justify-content: center;\n            }\n        }\n\n        /* ============================================\n           ACCESSIBILITY\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *,\n            *::before,\n            *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        .btn:focus-visible,\n        .nav-link:focus-visible,\n        .form-input:focus-visible,\n        .form-select:focus-visible,\n        .form-textarea:focus-visible {\n            outline: 3px solid var(--color-amethyst);\n            outline-offset: 2px;\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra Thamyres<span>Branco</span></a>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#home\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#services\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#testimonials\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#differentials\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contact\" class=\"nav-link nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <div class=\"nav-toggle\" id=\"navToggle\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-blob hero-blob-1\"></div>\n        <div class=\"hero-blob hero-blob-2\"></div>\n        <div class=\"hero-blob hero-blob-3\"></div>\n        <div class=\"hero-blob hero-blob-4\"></div>\n\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <span class=\"hero-badge\">Harmonização Facial em Ribeirão Preto</span>\n                <h1 class=\"hero-title\">\n                    Sua beleza natural,<br>\n                    <span>elevada à perfeição</span>\n                </h1>\n                <p class=\"hero-description\">\n                    Atendimento especializado em harmonização facial e estética avançada.\n                    Resultados naturais que realçam sua beleza única.\n                </p>\n                <div class=\"hero-ctas\">\n                    <a href=\"#contact\" class=\"btn btn-primary\">\n                        Agendar Consulta\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                    <a href=\"#services\" class=\"btn btn-secondary\">Conhecer Serviços</a>\n                </div>\n            </div>\n            <div class=\"hero-image\">\n                <div class=\"hero-image-wrapper\">\n                    <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=600&h=700&fit=crop\" alt=\"Dra Thamyres Branco - Harmonização Facial\">\n                </div>\n                <div class=\"hero-float-card hero-float-card-1\">\n                    <div class=\"float-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"float-text\">\n                        <strong>+5.000</strong>\n                        <span>Clientes Satisfeitos</span>\n                    </div>\n                </div>\n                <div class=\"hero-float-card hero-float-card-2\">\n                    <div class=\"float-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/>\n                            <polyline points=\"22 4 12 14.01 9 11.01\"/>\n                        </svg>\n                    </div>\n                    <div class=\"float-text\">\n                        <strong>Certificada</strong>\n                        <span>Profissional Qualificada</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"problem-solution\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Por que nos escolher</span>\n                <h2 class=\"section-title\">Sua confiança é nossa prioridade</h2>\n                <p class=\"section-description\">Compreendemos suas preocupações e oferecemos soluções seguras e eficazes.</p>\n            </div>\n            <div class=\"ps-grid\">\n                <div class=\"ps-card wow-fade-up\">\n                    <div class=\"ps-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/>\n                            <line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/>\n                        </svg>\n                    </div>\n                    <h3 class=\"ps-title\">Medo de resultados artificiais?</h3>\n                    <p>Muitas pessoas evitam procedimentos estéticos por receio de parecer artificiais. Nossa abordagem prioriza resultados sutis e naturais.</p>\n                </div>\n                <div class=\"ps-card solution wow-fade-up\" data-delay=\"200\">\n                    <div class=\"ps-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/>\n                            <polyline points=\"22 4 12 14.01 9 11.01\"/>\n                        </svg>\n                    </div>\n                    <h3 class=\"ps-title\">Harmonização que valoriza você</h3>\n                    <p>Técnicas avançadas que realçam seus traços naturais, proporcionando uma aparência descansada e rejuvenescida sem perder sua identidade.</p>\n                </div>\n                <div class=\"ps-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"ps-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"16\"/>\n                            <line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\"/>\n                        </svg>\n                    </div>\n                    <h3 class=\"ps-title\">Insegurança com o procedimento?</h3>\n                    <p>A segurança é nossa prioridade. Utilizamos apenas produtos aprovados pela ANVISA e seguimos rigorosos protocolos de assepsia.</p>\n                </div>\n                <div class=\"ps-card solution wow-fade-up\" data-delay=\"600\">\n                    <div class=\"ps-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/>\n                        </svg>\n                    </div>\n                    <h3 class=\"ps-title\">Cuidado individualizado</h3>\n                    <p>Cada rosto é único. Desenvolvemos um plano personalizado considerando suas características, objetivos e expectativas.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"services\" id=\"services\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Nossos Serviços</span>\n                <h2 class=\"section-title\">Procedimentos especializados</h2>\n                <p class=\"section-description\">Técnicas avançadas para realçar sua beleza natural com segurança e excelência.</p>\n            </div>\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">\n                        <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L2 7l10 5 10-5-10-5z\"/>\n                            <path d=\"M2 17l10 5 10-5\"/>\n                            <path d=\"M2 12l10 5 10-5\"/>\n                        </svg>\n                    </div>\n                    <h3 class=\"service-title\">Harmonização Facial</h3>\n                    <p class=\"service-description\">Equilíbrio e proporção dos traços faciais para uma aparência harmoniosa e natural.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"100\">\n                    <div class=\"service-icon\">\n                        <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M4.9 19.1C1 15.2 1 8.8 4.9 4.9\"/>\n                            <path d=\"M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5\"/>\n                            <circle cx=\"12\" cy=\"12\" r=\"2\"/>\n                            <path d=\"M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5\"/>\n                            <path d=\"M19.1 4.9C23 8.8 23 15.1 19.1 19\"/>\n                        </svg>\n                    </div>\n                    <h3 class=\"service-title\">Toxina Botulínica</h3>\n                    <p class=\"service-description\">Suaviza linhas de expressão e previne rugas, proporcionando aspecto rejuvenescido.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"service-icon\">\n                        <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z\"/>\n                            <path d=\"M12 6v6l4 2\"/>\n                        </svg>\n                    </div>\n                    <h3 class=\"service-title\">Preenchedores Faciais</h3>\n                    <p class=\"service-description\">Restaura volume e contorno facial, corrigindo sulcos e proporcionando rejuvenescimento.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais\n                        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strok