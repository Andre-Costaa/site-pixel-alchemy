ização facial e estética avançada em Ribeirão Preto. Agende sua consulta.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        /* ============================================\n           CSS RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        :root {\n            /* Amethyst Noir & Platinum Palette */\n            --color-amethyst: #6B3A82;\n            --color-amethyst-light: #8B4A9E;\n            --color-amethyst-dark: #4B2A62;\n            --color-amethyst-deep: #2B1A42;\n            --color-amethyst-mystic: #1A0E28;\n\n            --color-platinum: #C8C8D0;\n            --color-platinum-light: #D8D8E0;\n            --color-platinum-dark: #A8A8B0;\n            --color-platinum-shimmer: #E8E8F0;\n\n            --color-marble: #FAFAFC;\n            --color-marble-warm: #F5F5F8;\n            --color-white: #FFFFFF;\n\n            --color-onyx: #1A1A1E;\n            --color-charcoal: #2A2A30;\n            --color-stone: #3A3A40;\n\n            --color-text-dark: #1A1A1E;\n            --color-text-muted: #6A6A70;\n            --color-text-light: #FAFAFC;\n\n            /* Gradients */\n            --gradient-amethyst: linear-gradient(135deg, #6B3A82 0%, #4B2A62 100%);\n            --gradient-amethyst-rich: linear-gradient(135deg, #8B4A9E 0%, #6B3A82 50%, #4B2A62 100%);\n            --gradient-platinum: linear-gradient(135deg, #C8C8D0 0%, #A8A8B0 100%);\n            --gradient-mystic: linear-gradient(135deg, #6B3A82 0%, #C8C8D0 100%);\n            --gradient-marble: linear-gradient(135deg, #FAFAFC 0%, #F5F5F8 100%);\n            --gradient-shimmer: linear-gradient(90deg, transparent, rgba(200, 200, 208, 0.4), transparent);\n\n            /* Typography */\n            --font-display: 'Playfair Display', Georgia, serif;\n            --font-body: 'Space Grotesk', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Border Radius - Geode/Crystal Shapes */\n            --radius-geode-1: 72% 28% 48% 52% / 52% 38% 62% 48%;\n            --radius-geode-2: 48% 52% 68% 32% / 38% 62% 38% 62%;\n            --radius-geode-3: 62% 38% 42% 58% / 58% 42% 52% 48%;\n            --radius-geode-4: 38% 62% 52% 48% / 42% 58% 48% 52%;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(26, 26, 30, 0.08);\n            --shadow-md: 0 8px 24px rgba(26, 26, 30, 0.12);\n            --shadow-lg: 0 16px 48px rgba(26, 26, 30, 0.16);\n            --shadow-platinum: 0 8px 32px rgba(200, 200, 208, 0.35);\n            --shadow-amethyst: 0 8px 32px rgba(107, 58, 130, 0.35);\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.6;\n            color: var(--color-text-dark);\n            background-color: var(--color-marble);\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        /* ============================================\n           TYPOGRAPHY","numLines":100,"startLine":1,"totalLines":1735}}}
