">\n                <div class=\"testimonial-card wow-fade-up\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-quote\">\"Excelente profissional! Resultado superou minhas expectativas. Fui muito bem atendida e o procedimento foi super tranquilo.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div>\n                            <div class=\"testimonial-name\">Maria Clara</div>\n                            <div class=\"testimonial-role\">Harmonização Facial</div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"100\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-quote\">\"Profissional dedicada e atenciosa. Amei o resultado do preenchimento labial, ficou muito natural. Recomendo!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AS</div>\n                        <div>\n                            <div class=\"testimonial-name\">Ana Silva</div>\n                            <div class=\"testimonial-role\">Preenchimento Labial</div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-quote\">\"A Dra Thamyres é excepcional! Soube exatamente o que eu precisava. O resultado da toxina foi incrivelmente natural.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">JO</div>\n                        <div>\n                            <div class=\"testimonial-name\">Juliana Oliveira</div>\n                            <div class=\"testimonial-role\">Toxina Botulínica</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"differentials\" id=\"differentials\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Diferenciais</span>\n                <h2 class=\"section-title\">Por que escolher a Dra Thamyres Branco</h2>\n                <p class=\"section-description\">Compromisso com excelência e segurança em cada procedimento.</p>\n            </div>\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">\n                            <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/>\n                                <polyline points=\"22 4 12 14.01 9 11.01\"/>\n                            </svg>\n                        </div>\n                        <div class=\"differential-ring\"></div>\n                    </div>\n                    <h3 class=\"differential-title\">Profissional Certificada</h3>\n                    <p>Formação especializada e atualização constante com as técnicas mais modernas.</p>\n                </div>\n                <div class=\"differential-item wow-fade-up\" data-delay=\"100\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon\">\n                            <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M12 22