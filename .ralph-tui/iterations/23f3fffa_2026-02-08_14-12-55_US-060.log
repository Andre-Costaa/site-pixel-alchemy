rimson+Pro:wght@400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n    <style>\n        /* ============================================\n           CSS RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        :root {\n            /* Regal Burgundy & Gold Noir Palette */\n            --color-burgundy: #7B2A3E;\n            --color-burgundy-light: #9B3A52;\n            --color-burgundy-dark: #5B1A2E;\n            --color-burgundy-deep: #3B0A1E;\n\n            --color-gold: #C9A86C;\n            --color-gold-light: #DCC0A8;\n            --color-gold-dark: #A88A6E;\n            --color-gold-shimmer: #E8DCC8;\n\n            --color-cream: #FAF7F2;\n            --color-cream-warm: #F5EFE4;\n            --color-ivory: #FFFEFA;\n\n            --color-burgundy-black: #1A1518;\n            --color-burgundy-charcoal: #2A2025;\n            --color-burgundy-stone: #3A3035;\n\n            --color-text-dark: #1A1518;\n            --color-text-muted: #6A5558;\n            --color-text-light: #FAF7F2;\n\n            /* Gradients */\n            --gradient-burgundy: linear-gradient(135deg, #7B2A3E 0%, #5B1A2E 100%);\n            --gradient-burgundy-rich: linear-gradient(135deg, #9B3A52 0%, #7B2A3E 50%, #5B1A2E 100%);\n            --gradient-gold: linear-gradient(135deg, #C9A86C 0%, #A88A6E 100%);\n            --gradient-royal: linear-gradient(135deg, #7B2A3E 0%, #C9A86C 100%);\n            --gradient-cream: linear-gradient(135deg, #FAF7F2 0%, #F5EFE4 100%);\n            --gradient-shimmer: linear-gradient(90deg, transparent, rgba(201, 168, 108, 0.4), transparent);\n\n            /* Typography */\n            --font-display: 'Crimson Pro', Georgia, serif;\n            --font-body: 'Manrope', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Border Radius - Crown Shapes */\n            --radius-crown-1: 65% 35% 45% 55% / 50% 45% 55% 50%;\n            --radius-crown-2: 50% 50% 40% 60% / 45% 55% 45% 55%;\n            --radius-crown-3: 55% 45% 55% 45% / 40% 60% 40% 60%;\n            --radius-crown-4: 40% 60% 50% 50% / 55% 45% 55% 45%;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(26, 21, 24, 0.08);\n            --shadow-md: 0 8px 24px rgba(26, 21, 24, 0.12);\n            --shadow-lg: 0 16px 48px rgba(26, 21, 24, 0.16);\n            --shadow-gold: 0 8px 32px rgba(201, 168, 108, 0.35);\n            --shadow-burgundy: 0 8px 32px rgba(123, 42, 62, 0.35);\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.6;\n            color: var(--color-text-dark);\n            background-color: var(--color-cream);\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 700;\n            line-height: 1.2;\n            color: var(--color-burgundy-black);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            letter-spacing: -0.01em;\n        }\n\n        h3 {\n            font-size: clamp(1.25rem, 2.5vw, 1.75rem);\n        }\n\n        p {\n            font-size: 1rem;\n            line-height: 1.7;\n            color: var(--color-text-muted);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            background: rgba(250, 247, 242, 0.95);\n            backdrop-filter: blur(20px);\n            border-bottom: 1px solid rgba(123, 42, 62, 0.1);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);","numLines":150,"startLine":1,"totalLines":1834}}}
