{"type":"assistant","message":{"id":"msg_202602090242247835d13c5d9a43c8","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_a840025544554c7bad8218fd","name":"Write","input":{"file_path":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-katia-miyoshi-harmonizacao-facial-dentista/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Katia Miyoshi | Harmonização Facial - Dentista em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Katia Miyoshi - Dentista especializada em harmonização facial e estética avançada em Ribeirão Preto. Atendimento personalizado com técnicas modernas.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           CSS VARIABLES - Pearl Noir & Brushed Titanium\n           ============================================ */\n        :root {\n            /* Primary Palette - Pearl Tones */\n            --color-pearl: #E8E4E0;\n            --color-pearl-light: #F0ECE8;\n            --color-pearl-soft: #F8F4F0;\n            --color-pearl-warm: #ECE8E4;\n\n            /* Accent Palette - Brushed Titanium */\n            --color-titanium: #A8A8B0;\n            --color-titanium-light: #B8B8C0;\n            --color-titanium-mid: #C8C8D0;\n            --color-titanium-dark: #9898A0;\n            --color-titanium-deep: #888890;\n            --color-titanium-shimmer: #D8D8E0;\n\n            /* Dark Palette - Soft Noir */\n            --color-noir: #1A1A1A;\n            --color-noir-charcoal: #2A2A2A;\n            --color-noir-deep: #0F0F12;\n\n            /* Warmth Accent - Champagne Shimmer */\n            --color-champagne-shimmer: #D4C8C0;\n            --color-champagne-soft: #E0D4CC;\n\n            /* Text Colors */\n            --color-text-primary: #1A1A1A;\n            --color-text-secondary: #4A4A4A;\n            --color-text-muted: #7A7A7A;\n            --color-text-on-dark: #F8F4F0;\n\n            /* Gradients */\n            --gradient-pearl: linear-gradient(135deg, var(--color-pearl) 0%, var(--color-pearl-soft) 100%);\n            --gradient-titanium: linear-gradient(135deg, var(--color-titanium) 0%, var(--color-titanium-light) 100%);\n            --gradient-noir: linear-gradient(135deg, var(--color-noir) 0%, var(--color-noir-charcoal) 100%);\n            --gradient-hero: linear-gradient(135deg, #F8F4F0 0%, #E8E4E0 50%, #E0DCD8 100%);\n\n            /* Pearl Tooth Border Radius Shapes */\n            --radius-pearl-1: 65% 35% 50% 50% / 50% 50% 65% 35%;\n            --radius-pearl-2: 50% 50% 65% 35% / 35% 65% 50% 50%;\n            --radius-pearl-3: 55% 45% 40% 60% / 50% 50% 55% 45%;\n            --radius-pearl-4: 45% 55% 60% 40% / 50% 50% 45% 55%;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Typography */\n            --font-display: 'Cormorant Garamond', Georgia, serif;\n            --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(26, 26, 26, 0.08);\n            --shadow-medium: 0 8px 30px rgba(26, 26, 26, 0.12);\n            --shadow-strong: 0 12px 40px rgba(26, 26, 26, 0.16);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.7;\n            color: var(--color-text-primary);\n            background: var(--color-pearl-soft);\n            overflow-x: hidden;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-noir);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-secondary);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-sm) var(--spacing-md);\n            background: rgba(248, 244, 240, 0.95);\n            backdrop-filter: blur(20px);\n            transition: transform 0.3s ease;\n            box-shadow: 0 2px 20px rgba(26, 26, 26, 0.06);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-noir);\n            text-decoration: none;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-secondary);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-titanium);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover {\n            color: var(--color-noir);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.75rem 1.5rem;\n            background: var(--color-noir);\n            color: var(--color-text-on-dark) !important;\n            border-radius: 50px;\n            transition: all var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            background: var(--color-noir-charcoal);\n            transform: translateY(-2px);\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 6px;\n            cursor: pointer;\n            padding: 8px;\n        }\n\n        .nav-toggle span {\n            width: 28px;\n            height: 2px;\n            background: var(--color-noir);\n            transition: all 0.3s ease;\n            border-radius: 2px;\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            padding: calc(var(--spacing-xl) + 60px) var(--spacing-md) var(--spacing-xl);\n            background: var(--gradient-hero);\n            position: relative;\n            overflow: hidden;\n            display: flex;\n            align-items: center;\n        }\n\n        .hero-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n            align-items: center;\n            position: relative;\n            z-index: 2;\n        }\n\n        .hero-content {\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease forwards;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 0.5rem 1rem;\n            background: rgba(168, 168, 176, 0.15);\n            border-radius: 50px;\n            font-size: 0.85rem;\n            font-weight: 500;\n            color: var(--color-text-secondary);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-badge-dot {\n            width: 8px;\n            height: 8px;\n            background: var(--color-titanium);\n            border-radius: 50%;\n            animation: pulse 2s infinite;\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            line-height: 1.1;\n        }\n\n        .hero-title span {\n            display: block;\n            background: var(--gradient-titanium);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: 1.25rem;\n            color: var(--color-text-secondary);\n            margin-bottom: var(--spacing-md);\n            max-width: 500px;\n        }\n\n        .hero-cta {\n            display: flex;\n            gap: var(--spacing-sm);\n            flex-wrap: wrap;\n        }\n\n        .btn-primary {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            background: var(--color-noir);\n            color: var(--color-text-on-dark);\n            text-decoration: none;\n            font-weight: 600;\n            border-radius: 50px;\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n            box-shadow: var(--shadow-soft);\n        }\n\n        .btn-primary::before {\n            content: '';\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            width: 0;\n            height: 0;\n            background: rgba(248, 244, 240, 0.2);\n            border-radius: 50%;\n            transform: translate(-50%, -50%);\n            transition: width 0.6s, height 0.6s;\n        }\n\n        .btn-primary:hover::before {\n            width: 300px;\n            height: 300px;\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .btn-secondary {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            background: transparent;\n            color: var(--color-noir);\n            text-decoration: none;\n            font-weight: 600;\n            border: 2px solid var(--color-titanium);\n            border-radius: 50px;\n            transition: all var(--transition-base);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-titanium);\n            color: var(--color-text-on-dark);\n            transform: translateY(-3px);\n        }\n\n        /* Hero Visual */\n        .hero-visual {\n            position: relative;\n            height: 600px;\n        }\n\n        .hero-image-container {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 400px;\n            height: 500px;\n            border-radius: var(--radius-pearl-1);\n            overflow: hidden;\n            box-shadow: var(--shadow-strong);\n        }\n\n        .hero-image {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n        }\n\n        /* Floating Pearl Blobs */\n        .blob {\n            position: absolute;\n            opacity: 0.15;\n            filter: blur(60px);\n            animation: float 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-titanium);\n            border-radius: var(--radius-pearl-1);\n            top: -100px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .blob-2 {\n            width: 300px;\n            height: 300px;\n            background: var(--gradient-pearl);\n            border-radius: var(--radius-pearl-2);\n            bottom: -50px;\n            left: -50px;\n            animation-delay: -5s;\n        }\n\n        .blob-3 {\n            width: 250px;\n            height: 250px;\n            background: linear-gradient(135deg, var(--color-champagne-shimmer) 0%, var(--color-pearl) 100%);\n            border-radius: var(--radius-pearl-3);\n            top: 50%;\n            left: 10%;\n            animation-delay: -10s;\n        }\n\n        .blob-4 {\n            width: 200px;\n            height: 200px;\n            background: var(--gradient-titanium);\n            border-radius: var(--radius-pearl-4);\n            bottom: 20%;\n            right: 10%;\n            animation-delay: -15s;\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-pearl-soft);\n        }\n\n        .section-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .section-tag {\n            display: inline-block;\n            padding: 0.5rem 1.5rem;\n            background: rgba(168, 168, 176, 0.15);\n            color: var(--color-text-secondary);\n            font-size: 0.85rem;\n            font-weight: 600;\n            letter-spacing: 0.1em;\n            text-transform: uppercase;\n            border-radius: 50px;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: var(--spacing-md);\n        }\n\n        .problem-card, .solution-card {\n            padding: var(--spacing-md);\n            background: white;\n            border-radius: 24px;\n            position: relative;\n            overflow: hidden;\n            transition: all var(--transition-base);\n        }\n\n        .problem-card {\n            border-left: 4px solid var(--color-titanium-dark);\n        }\n\n        .solution-card {\n            border-left: 4px solid var(--color-noir);\n        }\n\n        .problem-card:hover, .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .card-icon {\n            width: 60px;\n            height: 60px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            border-radius: 50%;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .problem-card .card-icon {\n            background: rgba(168, 168, 176, 0.15);\n        }\n\n        .solution-card .card-icon {\n            background: rgba(26, 26, 26, 0.08);\n        }\n\n        .card-icon svg {\n            width: 28px;\n            height: 28px;\n            stroke-width: 1.5;\n        }\n\n        .problem-card .card-icon svg {\n            stroke: var(--color-titanium-dark);\n        }\n\n        .solution-card .card-icon svg {\n            stroke: var(--color-noir);\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: white;\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n        }\n\n        .service-card {\n            padding: var(--spacing-md);\n            background: var(--color-pearl-soft);\n            border-radius: 24px;\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-titanium);\n            transform: scaleX(0);\n            transform-origin: left;\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-strong);\n        }\n\n        .service-icon {\n            width: 64px;\n            height: 64px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: white;\n            border-radius: 20px;\n            margin-bottom: var(--spacing-sm);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .service-icon svg {\n            width: 32px;\n            height: 32px;\n            stroke: var(--color-titanium-dark);\n            stroke-width: 1.5;\n        }\n\n        .service-card h3 {\n            font-size: 1.25rem;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        .service-card p {\n            font-size: 0.95rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-titanium-dark);\n            text-decoration: none;\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: all var(--transition-fast);\n        }\n\n        .service-link:hover {\n            gap: 0.75rem;\n        }\n\n        .service-link svg {\n            width: 18px;\n            height: 18px;\n            stroke-width: 2;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-noir);\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonials h2, .testimonials h3 {\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonials p {\n            color: rgba(248, 244, 240, 0.8);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n        }\n\n        .testimonial-card {\n            padding: var(--spacing-md);\n            background: rgba(255, 255, 255, 0.05);\n            border-radius: 24px;\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n        }\n\n        .testimonial-stars {\n            display: flex;\n            gap: 4px;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .testimonial-stars svg {\n            width: 20px;\n            height: 20px;\n            fill: var(--color-champagne-shimmer);\n        }\n\n        .testimonial-quote {\n            font-style: italic;\n            margin-bottom: var(--spacing-sm);\n            line-height: 1.6;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 48px;\n            height: 48px;\n            border-radius: 50%;\n            background: var(--gradient-titanium);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: var(--color-noir);\n        }\n\n        .testimonial-info h4 {\n            font-size: 1rem;\n            font-weight: 600;\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonial-info span {\n            font-size: 0.85rem;\n            color: rgba(248, 244, 240, 0.6);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-pearl-soft);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n        }\n\n        .differential-item {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .differential-icon-ring {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 80px;\n            height: 80px;\n            border: 2px solid var(--color-titanium);\n            border-radius: 50%;\n            opacity: 0.3;\n            animation: ringPulse 2s infinite;\n        }\n\n        .differential-icon {\n            width: 64px;\n            height: 64px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: white;\n            border-radius: 50%;\n            box-shadow: var(--shadow-soft);\n            position: relative;\n            z-index: 1;\n        }\n\n        .differential-icon svg {\n            width: 28px;\n            height: 28px;\n            stroke: var(--color-titanium-dark);\n            stroke-width: 1.5;\n        }\n\n        .differential-item h3 {\n            font-size: 1.1rem;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        .differential-item p {\n            font-size: 0.9rem;\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: white;\n        }\n\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n        }\n\n        .contact-info h3 {\n            font-size: 1.5rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-info p {\n            font-size: 1.1rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-details {\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-md);\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-sm);\n        }\n\n        .contact-item-icon {\n            width: 48px;\n            height: 48px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--color-pearl-soft);\n            border-radius: 50%;\n            flex-shrink: 0;\n        }\n\n        .contact-item-icon svg {\n            width: 24px;\n            height: 24px;\n            stroke: var(--color-titanium-dark);\n            stroke-width: 1.5;\n        }\n\n        .contact-item-content h4 {\n            font-size: 1rem;\n            margin-bottom: 0.25rem;\n        }\n\n        .contact-item-content p {\n            font-size: 0.95rem;\n            color: var(--color-text-secondary);\n        }\n\n        .contact-form {\n            padding: var(--spacing-md);\n            background: var(--color-pearl-soft);\n            border-radius: 24px;\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .form-label {\n            display: block;\n            font-weight: 600;\n            margin-bottom: 0.5rem;\n            font-size: 0.9rem;\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 1rem;\n            background: white;\n            border: 2px solid var(--color-pearl);\n            border-radius: 12px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: all var(--transition-fast);\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-titanium);\n            box-shadow: 0 0 0 4px rgba(168, 168, 176, 0.1);\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1rem 2rem;\n            background: var(--color-noir);\n            color: var(--color-text-on-dark);\n            border: none;\n            border-radius: 50px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all var(--transition-base);\n        }\n\n        .form-submit:hover {\n            background: var(--color-noir-charcoal);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            padding: var(--spacing-lg) var(--spacing-md) var(--spacing-md);\n            background: var(--color-noir);\n            color: var(--color-text-on-dark);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-grid {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: var(--spacing-lg);\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .footer-brand h3 {\n            color: var(--color-text-on-dark);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-brand p {\n            color: rgba(248, 244, 240, 0.7);\n        }\n\n        .footer-links h4 {\n            color: var(--color-text-on-dark);\n            margin-bottom: var(--spacing-sm);\n            font-size: 1rem;\n        }\n\n        .footer-links ul {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-links a {\n            color: rgba(248, 244, 240, 0.7);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-text-on-dark);\n        }\n\n        .footer-bottom {\n            padding-top: var(--spacing-md);\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            text-align: center;\n            color: rgba(248, 244, 240, 0.5);\n            font-size: 0.9rem;\n        }\n\n        /* ============================================\n           ANIMATIONS\n           ============================================ */\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(3deg);\n            }\n        }\n\n        @keyframes pulse {\n            0%, 100% {\n                opacity: 1;\n            }\n            50% {\n                opacity: 0.5;\n            }\n        }\n\n        @keyframes ringPulse {\n            0% {\n                transform: translate(-50%, -50%) scale(1);\n                opacity: 0.3;\n            }\n            50% {\n                transform: translate(-50%, -50%) scale(1.2);\n                opacity: 0.1;\n            }\n            100% {\n                transform: translate(-50%, -50%) scale(1);\n                opacity: 0.3;\n            }\n        }\n\n        /* Scroll Animations */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: all 0.6s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        /* Staggered delays */\n        .wow-delay-1 { transition-delay: 0ms; }\n        .wow-delay-2 { transition-delay: 200ms; }\n        .wow-delay-3 { transition-delay: 400ms; }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 1024px) {\n            .services-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .testimonials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                right: 0;\n                flex-direction: column;\n                background: var(--color-pearl-soft);\n                padding: var(--spacing-md);\n                gap: var(--spacing-sm);\n                transform: translateX(-100%);\n                transition: transform 0.3s ease;\n                box-shadow: var(--shadow-medium);\n            }\n\n            .nav-menu.active {\n                transform: translateX(0);\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-visual {\n                height: 400px;\n            }\n\n            .hero-image-container {\n                width: 300px;\n                height: 380px;\n            }\n\n            .hero-cta {\n                justify-content: center;\n            }\n\n            .problem-solution-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .services-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .testimonials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .contact-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-grid {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n        }\n\n        @media (max-width: 480px) {\n            h1 {\n                font-size: 2.5rem;\n            }\n\n            .hero {\n                padding: calc(var(--spacing-lg) + 60px) var(--spacing-sm) var(--spacing-lg);\n            }\n\n            .blob-1, .blob-2, .blob-3, .blob-4 {\n                display: none;\n            }\n\n            .hero-image-container {\n                width: 100%;\n                max-width: 300px;\n            }\n        }\n\n        /* ============================================\n           ACCESSIBILITY\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        .btn-primary:focus, .btn-secondary:focus,\n        .form-input:focus, .form-select:focus, .form-textarea:focus,\n        .form-submit:focus {\n            outline: 3px solid var(--color-titanium);\n            outline-offset: 2px;\n        }\n\n        /* Skip Link */\n        .skip-link {\n            position: absolute;\n            top: -40px;\n            left: 0;\n            background: var(--color-noir);\n            color: white;\n            padding: 8px 16px;\n            text-decoration: none;\n            z-index: 9999;\n        }\n\n        .skip-link:focus {\n            top: 0;\n        }\n    </style>\n</head>\n<body>\n    <!-- Skip Link for Accessibility -->\n    <a href=\"#main-content\" class=\"skip-link\">Pular para o conteúdo principal</a>\n\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Katia Miyoshi</a>\n\n            <ul class=\"nav-menu\" id=\"nav-menu\">\n                <li><a href=\"#home\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contato\" class=\"nav-link nav-cta\">Agendar Consulta</a></li>\n            </ul>\n\n            <div class=\"nav-toggle\" id=\"nav-toggle\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <!-- Animated Blobs -->\n        <div class=\"blob blob-1\"></div>\n        <div class=\"blob blob-2\"></div>\n        <div class=\"blob blob-3\"></div>\n        <div class=\"blob blob-4\"></div>\n\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge\">\n                    <span class=\"hero-badge-dot\"></span>\n                    Dentista Especializada em Harmonização Facial\n                </div>\n\n                <h1 class=\"hero-title\">\n                    Sua melhor versão começa com um sorriso confiante\n                    <span>Harmonização Facial & Estética Avançada</span>\n                </h1>\n\n                <p class=\"hero-subtitle\">\n                    Combinando precisão odontológica e arte estética para realçar sua beleza natural com resultados harmoniosos e seguros.\n                </p>\n\n                <div class=\"hero-cta\">\n                    <a href=\"#contato\" class=\"btn-primary\">\n                        Agendar Consulta\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                            <polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                    <a href=\"#servicos\" class=\"btn-secondary\">\n                        Conhecer Tratamentos\n                    </a>\n                </div>\n            </div>\n\n            <div class=\"hero-visual\">\n                <div class=\"hero-image-container\">\n                    <img src=\"https://images.unsplash.com/photo-1606811841689-23dfddce3e95?w=800&q=80\"\n                         alt=\"Dra. Katia Miyoshi - Profissional de harmonização facial\"\n                         class=\"hero-image\">\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"problem-solution\" id=\"problema-solucao\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Transformação Real</span>\n                <h2>Sua Confiança, Nossa Prioridade</h2>\n            </div>\n\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card wow-fade-up wow-delay-1\">\n                    <div class=\"card-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                            <path d=\"M16 16s-1.5-2-4-2-4 2-4 2\"></path>\n                            <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"></line>\n                            <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"></line>\n                        </svg>\n                    </div>\n                    <h3>O Desafio</h3>\n                    <p>Perder a confiança devido a sinais de envelhecimento, assimetrias faciais ou insatisfação com os lábios e contorno facial pode afetar sua autoestima e bem-estar.</p>\n                </div>\n\n                <div class=\"solution-card wow-fade-up wow-delay-2\">\n                    <div class=\"card-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path>\n                            <polyline points=\"22 4 12 14.01 9 11.01\"></polyline>\n                        </svg>\n                    </div>\n                    <h3>A Solução</h3>\n                    <p>Com abordagem integrada entre odontologia e estética, oferecemos tratamentos que harmonizam seus traços faciais com naturalidade e segurança, recuperando sua autoconfiança.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"services\" id=\"servicos\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Tratamentos</span>\n                <h2>Procedimentos Especializados</h2>\n                <p>Técnicas avançadas com resultados naturais e duradouros</p>\n            </div>\n\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up wow-delay-1\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M12 2L2 7l10 5 10-5-10-5z\"></path>\n                            <path d=\"M2 17l10 5 10-5\"></path>\n                            <path d=\"M2 12l10 5 10-5\"></path>\n                        </svg>\n                    </div>\n                    <h3>Harmonização Facial</h3>\n                    <p>Equilíbrio estético dos traços faciais combinando preenchedores e toxina botulínica para resultados harmônicos.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                            <polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up wow-delay-2\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M9 18V5l12-2v13\"></path>\n                            <circle cx=\"6\" cy=\"18\" r=\"3\"></circle>\n                            <circle cx=\"18\" cy=\"16\" r=\"3\"></circle>\n                        </svg>\n                    </div>\n                    <h3>Toxina Botulínica</h3>\n                    <p>Suavização de rugas e linhas de expressão com técnica refinada para movimentos naturais da face.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                            <polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up wow-delay-3\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M12 2.69l5.74 5.88-5.74 5.88-5.74-5.88z\"></path>\n                            <path d=\"M5 19.5h14\"></path>\n                        </svg>\n                    </div>\n                    <h3>Preenchedores Faciais</h3>\n                    <p>Restauração de volume e contorno facial com ácido hialurônico de alta qualidade.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                            <polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up wow-delay-1\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"></path>\n                        </svg>\n                    </div>\n                    <h3>Preenchimento Labial</h3>\n                    <p>Volume e contorno para lábios com técnicas que preservam a naturalidade e movimento.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                            <polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up wow-delay-2\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                            <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line>\n                            <line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line>\n                        </svg>\n                    </div>\n                    <h3>Bioestimuladores</h3>\n                    <p>Estímulo de colágeno para rejuvenescimento progressivo e natural da pele.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                            <polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up wow-delay-3\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon>\n                        </svg>\n                    </div>\n                    <h3>Protocolos Exclusivos</h3>\n                    <p>Planos de tratamento personalizados combinando diferentes técnicas para resultados únicos.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                            <polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"testimonials\" id=\"depoimentos\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Depoimentos</span>\n                <h2>O Que Nossas Pacientes Dizem</h2>\n                <p style=\"color: rgba(248, 244, 240, 0.7);\">Histórias reais de transformação e confiança</p>\n            </div>\n\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up wow-delay-1\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    </div>\n                    <p class=\"testimonial-quote\">\"A Dra. Katia transformou minha autoestima. O preenchimento labial ficou super natural, exatamente como eu queria. Profissional incrível!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Mariana Costa</h4>\n                            <span>Paciente há 2 anos</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up wow-delay-2\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    </div>\n                    <p class=\"testimonial-quote\">\"Faço harmonização facial há um ano e os resultados são fantásticos. A Dra. Katia tem uma abordagem delicada e muito profissional.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">RF</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Renata Fernandes</h4>\n                            <span>Paciente há 1 ano</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up wow-delay-3\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    </div>\n                    <p class=\"testimonial-quote\">\"Excelente profissional! A toxina botulínica ficou perfeita, com expressão preservada. Recomendo de olhos fechados!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AS</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Ana Silva</h4>\n                            <span>Paciente há 3 anos</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"differentials\" id=\"diferenciais\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Por Que Nos Escolher</span>\n                <h2>Diferenciais Exclusivos</h2>\n            </div>\n\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up wow-delay-1\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon-ring\"></div>\n                        <div class=\"differential-icon\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"></path>\n                                <circle cx=\"12\" cy=\"7\" r=\"4\"></circle>\n                            </svg>\n                        </div>\n                    </div>\n                    <h3>Profissional Certificada</h3>\n                    <p>Dra. Katia Miyoshi é dentista com especialização em procedimentos estéticos faciais.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up wow-delay-2\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon-ring\"></div>\n                        <div class=\"differential-icon\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M12 2L2 7l10 5 10-5-10-5z\"></path>\n                                <path d=\"M2 17l10 5 10-5\"></path>\n                                <path d=\"M2 12l10 5 10-5\"></path>\n                            </svg>\n                        </div>\n                    </div>\n                    <h3>Abordagem Integral</h3>\n                    <p>Combinamos odontologia e estética para resultados harmoniosos e equilibrados.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up wow-delay-3\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon-ring\"></div>\n                        <div class=\"differential-icon\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"></path>\n                            </svg>\n                        </div>\n                    </div>\n                    <h3>Produtos de Qualidade</h3>\n                    <p>Utilizamos apenas preenchedores e toxina botulínica de alta qualidade e segurança.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up wow-delay-1\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon-ring\"></div>\n                        <div class=\"differential-icon\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                                <polyline points=\"12 6 12 12 16 14\"></polyline>\n                            </svg>\n                        </div>\n                    </div>\n                    <h3>Atendimento Pontual</h3>\n                    <p>Respeito ao seu tempo com agendamentos organizados e sem esperas prolongadas.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up wow-delay-2\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon-ring\"></div>\n                        <div class=\"differential-icon\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path>\n                            </svg>\n                        </div>\n                    </div>\n                    <h3>Ambiente Seguro</h3>\n                    <p>Clínica com rigorosos padrões de biossegurança e assepsia para sua proteção.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up wow-delay-3\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon-ring\"></div>\n                        <div class=\"differential-icon\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"></path>\n                            </svg>\n                        </div>\n                    </div>\n                    <h3>Acompanhamento</h3>\n                    <p>Suporte contínuo antes, durante e após os procedimentos para sua tranquilidade.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"contact\" id=\"contato\">\n        <div class=\"section-container\">\n            <div class=\"contact-grid\">\n                <div class=\"contact-info\">\n                    <h3>Agende Sua Consulta</h3>\n                    <p>Entre em contato para transformar sua autoestima com procedimentos estéticos de alta qualidade.</p>\n\n                    <div class=\"contact-details\">\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                    <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n                                    <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-content\">\n                                <h4>Endereço</h4>\n                                <p>Av. Braz Olaia Acosta, 727 - Sala 108<br>Jardim California, Ribeirão Preto - SP<br>CEP: 14026-040</p>\n                            </div>\n                        </div>\n\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                    <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-content\">\n                                <h4>WhatsApp</h4>\n                                <p>(16) 92000-3886</p>\n                            </div>\n                        </div>\n\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                    <rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"></rect>\n                                    <path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"></path>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-content\">\n                                <h4>Horário de Atendimento</h4>\n                                <p>Segunda a Sexta: 9h às 18h<br>Sábado: 9h às 13h</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"contact-form-wrapper\">\n                    <form class=\"contact-form\" id=\"contactForm\">\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"name\">Nome Completo</label>\n                            <input type=\"text\" id=\"name\" class=\"form-input\" placeholder=\"Seu nome\" required>\n                        </div>\n\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"email\">E-mail</label>\n                            <input type=\"email\" id=\"email\" class=\"form-input\" placeholder=\"seu@email.com\" required>\n                        </div>\n\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"service\">Serviço de Interesse</label>\n                            <select id=\"service\" class=\"form-select\" required>\n                                <option value=\"\">Selecione um procedimento</option>\n                                <option value=\"harmonizacao\">Harmonização Facial</option>\n                                <option value=\"botox\">Toxina Botulínica</option>\n                                <option value=\"preenchedores\">Preenchedores Faciais</option>\n                                <option value=\"labios\">Preenchimento Labial</option>\n                                <option value=\"bioestimuladores\">Bioestimuladores</option>\n                                <option value=\"protocolos\">Protocolos Exclusivos</option>\n                            </select>\n                        </div>\n\n                        <div class=\"form-group\">\n                            <label class=\"form-label\" for=\"message\">Mensagem</label>\n                            <textarea id=\"message\" class=\"form-textarea\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                        </div>\n\n                        <button type=\"submit\" class=\"form-submit\">Enviar Mensagem via WhatsApp</button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-grid\">\n                <div class=\"footer-brand\">\n                    <h3>Dra. Katia Miyoshi</h3>\n                    <p>Dentista especializada em harmonização facial e estética avançada em Ribeirão Preto. Transformando vidas através da autoestima.</p>\n                </div>\n\n                <div class=\"footer-links\">\n                    <h4>Links Rápidos</h4>\n                    <ul>\n                        <li><a href=\"#home\">Início</a></li>\n                        <li><a href=\"#servicos\">Serviços</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                        <li><a href=\"#contato\">Contato</a></li>\n                    </ul>\n                </div>\n\n                <div class=\"footer-links\">\n                    <h4>Redes Sociais</h4>\n                    <ul>\n                        <li><a href=\"#\">Instagram</a></li>\n                        <li><a href=\"#\">Facebook</a></li>\n                        <li><a href=\"#\">WhatsApp</a></li>\n                    </ul>\n                </div>\n            </div>\n\n            <div class=\"footer-bottom\">\n                <p>&copy; 2026 Dra. Katia Miyoshi. Todos os direitos reservados. | CRO/SP: [Número]</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION SCROLL EFFECT\n        // ============================================\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                } else {\n                    nav.classList.remove('hidden');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // ============================================\n        // MOBILE MENU TOGGLE\n        // ============================================\n        const navToggle = document.getElementById('nav-toggle');\n        const navMenu = document.getElementById('nav-menu');\n\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close menu when clicking on a link\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL FOR ANCHOR LINKS\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const offsetTop = target.offsetTop - 70;\n                    window.scrollTo({\n                        top: offsetTop,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER FOR SCROLL ANIMATIONS\n        // ============================================\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('visible');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // CONTACT FORM SUBMISSION TO WHATSAPP\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const email = document.getElementById('email').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceNames = {\n                'harmonizacao': 'Harmonização Facial',\n                'botox': 'Toxina Botulínica',\n                'preenchedores': 'Preenchedores Faciais',\n                'labios': 'Preenchimento Labial',\n                'bioestimuladores': 'Bioestimuladores',\n                'protocolos': 'Protocolos Exclusivos'\n            };\n\n            const whatsappMessage = `Olá! Me chamo ${name}.%0A%0A` +\n                `Gostaria de agendar uma consulta para: ${serviceNames[service] || 'Consulta Geral'}%0A%0A` +\n                `Mensagem: ${message || 'Gostaria de mais informações.'}%0A%0A` +\n                `E-mail: ${email}`;\n\n            const whatsappURL = `https://wa.me/5516920003886?text=${whatsappMessage}`;\n\n            window.open(whatsappURL, '_blank');\n        });\n\n        // ============================================\n        // REDUCED MOTION PREFERENCE CHECK\n        // ============================================\n        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n        if (prefersReducedMotion.matches) {\n            document.querySelectorAll('.blob').forEach(blob => {\n                blob.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"e24519df-3281-4631-b02d-6280a3fc859b","uuid":"cd1bcd70-cb51-4a98-b0e2-3d0a76b371e8"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a840025544554c7bad8218fd","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-katia-miyoshi-harmonizacao-facial-dentista/index.html"}]},"parent_tool_use_id":null,"session_id":"e24519df-3281-4631-b02d-6280a3fc859b","uuid":"0f4d0b41-19e4-445a-be76-46321200a349","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-katia-miyoshi-harmonizacao-facial-dentista/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Katia Miyoshi | Harmonização Facial - Dentista em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Katia Miyoshi - Dentista especializada em harmonização facial e estética avançada em Ribeirão Preto. Atendimento personalizado com técnicas modernas.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           CSS VARIABLES - Pearl Noir & Brushed Titanium\n           ============================================ */\n        :root {\n            /* Primary Palette - Pearl Tones */\n            --color-pearl: #E8E4E0;\n            --color-pearl-light: #F0ECE8;\n            --color-pearl-soft: #F8F4F0;\n            --color-pearl-warm: #ECE8E4;\n\n            /* Accent Palette - Brushed Titanium */\n            --color-titanium: #A8A8B0;\n            --color-titanium-light: #B8B8C0;\n            --color-titanium-mid: #C8C8D0;\n            --color-titanium-dark: #9898A0;\n            --color-titanium-deep: #888890;\n            --color-titanium-shimmer: #D8D8E0;\n\n            /* Dark Palette - Soft Noir */\n            --color-noir: #1A1A1A;\n            --color-noir-charcoal: #2A2A2A;\n            --color-noir-deep: #0F0F12;\n\n            /* Warmth Accent - Champagne Shimmer */\n            --color-champagne-shimmer: #D4C8C0;\n            --color-champagne-soft: #E0D4CC;\n\n            /* Text Colors */\n            --color-text-primary: #1A1A1A;\n            --color-text-secondary: #4A4A4A;\n            --color-text-muted: #7A7A7A;\n            --color-text-on-dark: #F8F4F0;\n\n            /* Gradients */\n            --gradient-pearl: linear-gradient(135deg, var(--color-pearl) 0%, var(--color-pearl-soft) 100%);\n            --gradient-titanium: linear-gradient(135deg, var(--color-titanium) 0%, var(--color-titanium-light) 100%);\n            --gradient-noir: linear-gradient(135deg, var(--color-noir) 0%, var(--color-noir-charcoal) 100%);\n            --gradient-hero: linear-gradient(135deg, #F8F4F0 0%, #E8E4E0 50%, #E0DCD8 100%);\n\n            /* Pearl Tooth Border Radius Shapes */\n            --radius-pearl-1: 65% 35% 50% 50% / 50% 50% 65% 35%;\n            --radius-pearl-2: 50% 50% 65% 35% / 35% 65% 50% 50%;\n            --radius-pearl-3: 55% 45% 40% 60% / 50% 50% 55% 45%;\n            --radius-pearl-4: 45% 55% 60% 40% / 50% 50% 45% 55%;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Typography */\n            --font-display: 'Cormorant Garamond', Georgia, serif;\n            --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(26, 26, 26, 0.08);\n            --shadow-medium: 0 8px 30px rgba(26, 26, 26, 0.12);\n            --shadow-strong: 0 12px 40px rgba(26, 26, 26, 0.16);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.7;\n            color: var(--color-text-primary);\n            background: var(--color-pearl-soft);\n            overflow-x: hidden;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-noir);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-secondary);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-sm) var(--spacing-md);\n            background: rgba(248, 244, 240, 0.95);\n            backdrop-filter: blur(20px);\n            transition: transform 0.3s ease;\n            box-shadow: 0 2px 20px rgba(26, 26, 26, 0.06);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-noir);\n            text-decoration: none;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-secondary);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-titanium);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover {\n            color: var(--color-noir);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.75rem 1.5rem;\n            background: var(--color-noir);\n            color: var(--color-text-on-dark) !important;\n            border-radius: 50px;\n            transition: all var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            background: var(--color-noir-charcoal);\n            transform: translateY(-2px);\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 6px;\n            cursor: pointer;\n            padding: 8px;\n        }\n\n        .nav-toggle span {\n            width: 28px;\n            height: 2px;\n            background: var(--color-noir);\n            transition: all 0.3s ease;\n            border-radius: 2px;\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            padding: calc(var(--spacing-xl) + 60px) var(--spacing-md) var(--spacing-xl);\n            background: var(--gradient-hero);\n            position: relative;\n            overflow: hidden;\n            display: flex;\n            align-items: center;\n        }\n\n        .hero-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n            align-items: center;\n            position: relative;\n            z-index: 2;\n        }\n\n        .hero-content {\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease forwards;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            padding: 0.5rem 1rem;\n            background: rgba(168, 168, 176, 0.15);\n            border-radius: 50px;\n            font-size: 0.85rem;\n            font-weight: 500;\n            color: var(--color-text-secondary);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-badge-dot {\n            width: 8px;\n            height: 8px;\n            background: var(--color-titanium);\n            border-radius: 50%;\n            animation: pulse 2s infinite;\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            line-height: 1.1;\n        }\n\n        .hero-title span {\n            display: block;\n            background: var(--gradient-titanium);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: 1.25rem;\n            color: var(--color-text-secondary);\n            margin-bottom: var(--spacing-md);\n            max-width: 500px;\n        }\n\n        .hero-cta {\n            display: flex;\n            gap: var(--spacing-sm);\n            flex-wrap: wrap;\n        }\n\n        .btn-primary {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            background: var(--color-noir);\n            color: var(--color-text-on-dark);\n            text-decoration: none;\n            font-weight: 600;\n            border-radius: 50px;\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n            box-shadow: var(--shadow-soft);\n        }\n\n        .btn-primary::before {\n            content: '';\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            width: 0;\n            height: 0;\n            background: rgba(248, 244, 240, 0.2);\n            border-radius: 50%;\n            transform: translate(-50%, -50%);\n            transition: width 0.6s, height 0.6s;\n        }\n\n        .btn-primary:hover::before {\n            width: 300px;\n            height: 300px;\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .btn-secondary {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            background: transparent;\n            color: var(--color-noir);\n            text-decoration: none;\n            font-weight: 600;\n            border: 2px solid var(--color-titanium);\n            border-radius: 50px;\n            transition: all var(--transition-base);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-titanium);\n            color: var(--color-text-on-dark);\n            transform: translateY(-3px);\n        }\n\n        /* Hero Visual */\n        .hero-visual {\n            position: relative;\n            height: 600px;\n        }\n\n        .hero-image-container {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 400px;\n            height: 500px;\n            border-radius: var(--radius-pearl-1);\n            overflow: hidden;\n            box-shadow: var(--shadow-strong);\n        }\n\n        .hero-image {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n        }\n\n        /* Floating Pearl Blobs */\n        .blob {\n            position: absolute;\n            opacity: 0.15;\n            filter: blur(60px);\n            animation: float 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-titanium);\n            border-radius: var(--radius-pearl-1);\n            top: -100px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .blob-2 {\n            width: 300px;\n            height: 300px;\n            background: var(--gradient-pearl);\n            border-radius: var(--radius-pearl-2);\n            bottom: -50px;\n            left: -50px;\n            animation-delay: -5s;\n        }\n\n        .blob-3 {\n            width: 250px;\n            height: 250px;\n            background: linear-gradient(135deg, var(--color-champagne-shimmer) 0%, var(--color-pearl) 100%);\n            border-radius: var(--radius-pearl-3);\n            top: 50%;\n            left: 10%;\n            animation-delay: -10s;\n        }\n\n        .blob-4 {\n            width: 200px;\n            height: 200px;\n            background: var(--gradient-titanium);\n            border-radius: var(--radius-pearl-4);\n            bottom: 20%;\n            right: 10%;\n            animation-delay: -15s;\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-pearl-soft);\n        }\n\n        .section-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .section-tag {\n            display: inline-block;\n            padding: 0.5rem 1.5rem;\n            background: rgba(168, 168, 176, 0.15);\n            color: var(--color-text-secondary);\n            font-size: 0.85rem;\n            font-weight: 600;\n            letter-spacing: 0.1em;\n            text-transform: uppercase;\n            border-radius: 50px;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: var(--spacing-md);\n        }\n\n        .problem-card, .solution-card {\n            padding: var(--spacing-md);\n            background: white;\n            border-radius: 24px;\n            position: relative;\n            overflow: hidden;\n            transition: all var(--transition-base);\n        }\n\n        .problem-card {\n            border-left: 4px solid var(--color-titanium-dark);\n        }\n\n        .solution-card {\n            border-left: 4px solid var(--color-noir);\n        }\n\n        .problem-card:hover, .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .card-icon {\n            width: 60px;\n            height: 60px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            border-radius: 50%;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .problem-card .card-icon {\n            background: rgba(168, 168, 176, 0.15);\n        }\n\n        .solution-card .card-icon {\n            background: rgba(26, 26, 26, 0.08);\n        }\n\n        .card-icon svg {\n            width: 28px;\n            height: 28px;\n            stroke-width: 1.5;\n        }\n\n        .problem-card .card-icon svg {\n            stroke: var(--color-titanium-dark);\n        }\n\n        .solution-card .card-icon svg {\n            stroke: var(--color-noir);\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: white;\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n        }\n\n        .service-card {\n            padding: var(--spacing-md);\n            background: var(--color-pearl-soft);\n            border-radius: 24px;\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-titanium);\n            transform: scaleX(0);\n            transform-origin: left;\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-strong);\n        }\n\n        .service-icon {\n            width: 64px;\n            height: 64px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: white;\n            border-radius: 20px;\n            margin-bottom: var(--spacing-sm);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .service-icon svg {\n            width: 32px;\n            height: 32px;\n            stroke: var(--color-titanium-dark);\n            stroke-width: 1.5;\n        }\n\n        .service-card h3 {\n            font-size: 1.25rem;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        .service-card p {\n            font-size: 0.95rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-titanium-dark);\n            text-decoration: none;\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: all var(--transition-fast);\n        }\n\n        .service-link:hover {\n            gap: 0.75rem;\n        }\n\n        .service-link svg {\n            width: 18px;\n            height: 18px;\n            stroke-width: 2;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-noir);\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonials h2, .testimonials h3 {\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonials p {\n            color: rgba(248, 244, 240, 0.8);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n        }\n\n        .testimonial-card {\n            padding: var(--spacing-md);\n            background: rgba(255, 255, 255, 0.05);\n            border-radius: 24px;\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n        }\n\n        .testimonial-stars {\n            display: flex;\n            gap: 4px;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .testimonial-stars svg {\n            width: 20px;\n            height: 20px;\n            fill: var(--color-champagne-shimmer);\n        }\n\n        .testimonial-quote {\n            font-style: italic;\n            margin-bottom: var(--spacing-sm);\n            line-height: 1.6;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 48px;\n            height: 48px;\n            border-radius: 50%;\n            background: var(--gradient-titanium);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: var(--color-noir);\n        }\n\n        .testimonial-info h4 {\n            font-size: 1rem;\n            font-weight: 600;\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonial-info span {\n            font-size: 0.85rem;\n            color: rgba(248, 244, 240, 0.6);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-pearl-soft);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n        }\n\n        .differential-item {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .differential-icon-ring {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 80px;\n            height: 80px;\n            border: 2px solid var(--color-titanium);\n            border-radius: 50%;\n            opacity: 0.3;\n            animation: ringPulse 2s infinite;\n        }\n\n        .differential-icon {\n            width: 64px;\n            height: 64px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: white;\n            border-radius: 50%;\n            box-shadow: var(--shadow-soft);\n            position: relative;\n            z-index: 1;\n        }\n\n        .differential-icon svg {\n            width: 28px;\n            height: 28px;\n            stroke: var(--color-titanium-dark);\n            stroke-width: 1.5;\n        }\n\n        .differential-item h3 {\n            font-size: 1.1rem;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        .differential-item p {\n            font-size: 0.9rem;\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: white;\n        }\n\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n        }\n\n        .contact-info h3 {\n            font-size: 1.5rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-info p {\n            font-size: 1.1rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-details {\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-md);\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-sm);\n        }\n\n        .contact-item-icon {\n            width: 48px;\n            height: 48px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background: var(--color-pearl-soft);\n            border-radius: 50%;\n            flex-shrink: 0;\n        }\n\n        .contact-item-icon svg {\n            width: 24px;\n            height: 24px;\n            stroke: var(--color-titanium-dark);\n            stroke-width: 1.5;\n        }\n\n        .contact-item-content h4 {\n            font-size: 1rem;\n            margin-bottom: 0.25rem;\n        }\n\n        .contact-item-content p {\n            font-size: 0.95rem;\n            color: var(--color-text-secondary);\n        }\n\n        .contact-form {\n            padding: var(--spacing-md);\n            background: var(--color-pearl-soft);\n            border-radius: 24px;\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .form-label {\n            display: block;\n            font-weight: 600;\n            margin-bottom: 0.5rem;\n            font-size: 0.9rem;\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 1rem;\n            background: white;\n            border: 2px solid var(--color-pearl);\n            border-radius: 12px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: all var(--transition-fast);\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-titanium);\n            box-shadow: 0 0 0 4px rgba(168, 168, 176, 0.1);\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1rem 2rem;\n            background: var(--color-noir);\n            color: var(--color-text-on-dark);\n            border: none;\n            border-radius: 50px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all var(--transition-base);\n        }\n\n        .form-submit:hover {\n            background: var(--color-noir-charcoal);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-medium);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            padding: var(--spacing-lg) var(--spacing-md) var(--spacing-md);\n            background: var(--color-noir);\n            color: var(--color-text-on-dark);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-grid {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: var(--spacing-lg);\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .footer-brand h3 {\n            color: var(--color-text-on-dark);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-brand p {\n            color: rgba(248, 244, 240, 0.7);\n        }\n\n        .footer-links h4 {\n            color: var(--color-text-on-dark);\n            margin-bottom: var(--spacing-sm);\n            font-size: 1rem;\n        }\n\n        .footer-links ul {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-links a {\n            color: rgba(248, 244, 240, 0.7);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-text-on-dark);\n        }\n\n        .footer-bottom {\n            padding-top: var(--spacing-md);\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            text-align: center;\n            color: rgba(248, 244, 240, 0.5);\n            font-size: 0.9rem;\n        }\n\n        /* ============================================\n           ANIMATIONS\n           ============================================ */\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @keyframes float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(3deg);\n            }\n        }\n\n        @keyframes pulse {\n            0%, 100% {\n                opacity: 1;\n            }\n            50% {\n                opacity: 0.5;\n            }\n        }\n\n        @keyframes ringPulse {\n            0% {\n                transform: translate(-50%, -50%) scale(1);\n                opacity: 0.3;\n            }\n            50% {\n                transform: translate(-50%, -50%) scale(1.2);\n                opacity: 0.1;\n            }\n            100% {\n                transform: translate(-50%, -50%) scale(1);\n                opacity: 0.3;\n            }\n        }\n\n        /* Scroll Animations */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: all 0.6s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        /* Staggered delays */\n        .wow-delay-1 { transition-delay: 0ms; }\n        .wow-delay-2 { transition-delay: 200ms; }\n        .wow-delay-3 { transition-delay: 400ms; }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 1024px) {\n            .services-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .testimonials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                right: 0;\n                flex-direction: column;\n                background: var(--color-pearl-soft);\n                padding: var(--spacing-md);\n                gap: var(--spacing-sm);\n                transform: translateX(-100%);\n                transition: transform 0.3s ease;\n                box-shadow: var(--shadow-medium);\n            }\n\n            .nav-menu.active {\n                transform: translateX(0);\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-visual {\n                height: 400px;\n            }\n\n            .hero-image-container {\n                width: 300px;\n                height: 380px;\n            }\n\n            .hero-cta {\n                justify-content: center;\n            }\n\n            .problem-solution-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .services-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .testimonials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .contact-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-grid {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n        }\n\n        @media (max-width: 480px) {\n            h1 {\n                font-size: 2.5rem;\n            }\n\n            .hero {\n                padding: calc(var(--spacing-lg) + 60px) var(--spacing-sm) var(--spacing-lg);\n            }\n\n            .blob-1, .blob-2, .blob-3, .blob-4 {\n                display: none;\n            }\n\n            .hero-image-container {\n                width: 100%;\n                max-width: 300px;\n            }\n        }\n\n        /* ============================================\n           ACCESSIBILITY\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        .btn-primary:focus, .btn-secondary:focus,\n        .form-input:focus, .form-select:focus, .form-textarea:focus,\n        .form-submit:focus {\n            outline: 3px solid var(--color-titanium);\n            outline-offset: 2px;\n        }\n\n        /* Skip Link */\n        .skip-link {\n            position: absolute;\n            top: -40px;\n            left: 0;\n            background: var(--color-noir);\n            color: white;\n            padding: 8px 16px;\n            text-decoration: none;\n            z-index: 9999;\n        }\n\n        .skip-link:focus {\n            top: 0;\n        }\n    </style>\n</head>\n<body>\n    <!-- Skip Link for Accessibility -->\n    <a href=\"#main-content\" class=\"skip-link\">Pular para o conteúdo principal</a>\n\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Katia Miyoshi</a>\n\n            <ul class=\"nav-menu\" id=\"nav-menu\">\n                <li><a href=\"#home\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contato\" class=\"nav-link nav-cta\">Agendar Consulta</a></li>\n            </ul>\n\n            <div class=\"nav-toggle\" id=\"nav-toggle\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <!-- Animated Blobs -->\n        <div class=\"blob blob-1\"></div>\n        <div class=\"blob blob-2\"></div>\n        <div class=\"blob blob-3\"></div>\n        <div class=\"blob blob-4\"></div>\n\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge\">\n                    <span class=\"hero-badge-dot\"></span>\n                    Dentista Especializada em Harmonização Facial\n                </div>\n\n                <h1 class=\"hero-title\">\n                    Sua melhor versão começa com um sorriso confiante\n                    <span>Harmonização Facial & Estética Avançada</span>\n                </h1>\n\n                <p class=\"hero-subtitle\">\n                    Combinando precisão odontológica e arte estética para realçar sua beleza natural com resultados harmoniosos e seguros.\n                </p>\n\n                <div class=\"hero-cta\">\n                    <a href=\"#contato\" class=\"btn-primary\">\n                        Agendar Consulta\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                            <polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                    <a href=\"#servicos\" class=\"btn-secondary\">\n                        Conhecer Tratamentos\n                    </a>\n                </div>\n            </div>\n\n            <div class=\"hero-visual\">\n                <div class=\"hero-image-container\">\n                    <img src=\"https://images.unsplash.com/photo-1606811841689-23dfddce3e95?w=800&q=80\"\n                         alt=\"Dra. Katia Miyoshi - Profissional de harmonização facial\"\n                         class=\"hero-image\">\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"problem-solution\" id=\"problema-solucao\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Transformação Real</span>\n                <h2>Sua Confiança, Nossa Prioridade</h2>\n            </div>\n\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card wow-fade-up wow-delay-1\">\n                    <div class=\"card-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                            <path d=\"M16 16s-1.5-2-4-2-4 2-4 2\"></path>\n                            <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"></line>\n                            <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"></line>\n                        </svg>\n                    </div>\n                    <h3>O Desafio</h3>\n                    <p>Perder a confiança devido a sinais de envelhecimento, assimetrias faciais ou insatisfação com os lábios e contorno facial pode afetar sua autoestima e bem-estar.</p>\n                </div>\n\n                <div class=\"solution-card wow-fade-up wow-delay-2\">\n                    <div class=\"card-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path>\n                            <polyline points=\"22 4 12 14.01 9 11.01\"></polyline>\n                        </svg>\n                    </div>\n                    <h3>A Solução</h3>\n                    <p>Com abordagem integrada entre odontologia e estética, oferecemos tratamentos que harmonizam seus traços faciais com naturalidade e segurança, recuperando sua autoconfiança.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"services\" id=\"servicos\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Tratamentos</span>\n                <h2>Procedimentos Especializados</h2>\n                <p>Técnicas avançadas com resultados naturais e duradouros</p>\n            </div>\n\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up wow-delay-1\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M12 2L2 7l10 5 10-5-10-5z\"></path>\n                            <path d=\"M2 17l10 5 10-5\"></path>\n                            <path d=\"M2 12l10 5 10-5\"></path>\n                        </svg>\n                    </div>\n                    <h3>Harmonização Facial</h3>\n                    <p>Equilíbrio estético dos traços faciais combinando preenchedores e toxina botulínica para resultados harmônicos.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                            <polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up wow-delay-2\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M9 18V5l12-2v13\"></path>\n                            <circle cx=\"6\" cy=\"18\" r=\"3\"></circle>\n                            <circle cx=\"18\" cy=\"16\" r=\"3\"></circle>\n                        </svg>\n                    </div>\n                    <h3>Toxina Botulínica</h3>\n                    <p>Suavização de rugas e linhas de expressão com técnica refinada para movimentos naturais da face.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                            <polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up wow-delay-3\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M12 2.69l5.74 5.88-5.74 5.88-5.74-5.88z\"></path>\n                            <path d=\"M5 19.5h14\"></path>\n                        </svg>\n                    </div>\n                    <h3>Preenchedores Faciais</h3>\n                    <p>Restauração de volume e contorno facial com ácido hialurônico de alta qualidade.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                            <polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up wow-delay-1\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"></path>\n                        </svg>\n                    </div>\n                    <h3>Preenchimento Labial</h3>\n                    <p>Volume e contorno para lábios com técnicas que preservam a naturalidade e movimento.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                            <polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up wow-delay-2\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                            <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line>\n                            <line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line>\n                        </svg>\n                    </div>\n                    <h3>Bioestimuladores</h3>\n                    <p>Estímulo de colágeno para rejuvenescimento progressivo e natural da pele.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                            <polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up wow-delay-3\">\n                    <div class=\"service-icon\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon>\n                        </svg>\n                    </div>\n                    <h3>Protocolos Exclusivos</h3>\n                    <p>Planos de tratamento personalizados combinando diferentes técnicas para resultados únicos.</p>\n                    <a href=\"#contato\" class=\"service-link\">\n                        Saiba mais\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n                            <polyline points=\"12 5 19 12 12 19\"></polyline>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"testimonials\" id=\"depoimentos\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Depoimentos</span>\n                <h2>O Que Nossas Pacientes Dizem</h2>\n                <p style=\"color: rgba(248, 244, 240, 0.7);\">Histórias reais de transformação e confiança</p>\n            </div>\n\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up wow-delay-1\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    </div>\n                    <p class=\"testimonial-quote\">\"A Dra. Katia transformou minha autoestima. O preenchimento labial ficou super natural, exatamente como eu queria. Profissional incrível!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Mariana Costa</h4>\n                            <span>Paciente há 2 anos</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up wow-delay-2\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    </div>\n                    <p class=\"testimonial-quote\">\"Faço harmonização facial há um ano e os resultados são fantásticos. A Dra. Katia tem uma abordagem delicada e muito profissional.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">RF</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Renata Fernandes</h4>\n                            <span>Paciente há 1 ano</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up wow-delay-3\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                        <svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>\n                    </div>\n                    <p class=\"testimonial-quote\">\"Excelente profissional! A toxina botulínica ficou perfeita, com expressão preservada. Recomendo de olhos fechados!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AS</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Ana Silva</h4>\n                            <span>Paciente há 3 anos</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"differentials\" id=\"diferenciais\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Por Que Nos Escolher</span>\n                <h2>Diferenciais Exclusivos</h2>\n            </div>\n\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up wow-delay-1\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon-ring\"></div>\n                        <div class=\"differential-icon\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"></path>\n                                <circle cx=\"12\" cy=\"7\" r=\"4\"></circle>\n                            </svg>\n                        </div>\n                    </div>\n                    <h3>Profissional Certificada</h3>\n                    <p>Dra. Katia Miyoshi é dentista com especialização em procedimentos estéticos faciais.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up wow-delay-2\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon-ring\"></div>\n                        <div class=\"differential-icon\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M12 2L2 7l10 5 10-5-10-5z\"></path>\n                                <path d=\"M2 17l10 5 10-5\"></path>\n                                <path d=\"M2 12l10 5 10-5\"></path>\n                            </svg>\n                        </div>\n                    </div>\n                    <h3>Abordagem Integral</h3>\n                    <p>Combinamos odontologia e estética para resultados harmoniosos e equilibrados.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up wow-delay-3\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon-ring\"></div>\n                        <div class=\"differential-icon\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"></path>\n                            </svg>\n                        </div>\n                    </div>\n                    <h3>Produtos de Qualidade</h3>\n                    <p>Utilizamos apenas preenchedores e toxina botulínica de alta qualidade e segurança.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up wow-delay-1\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon-ring\"></div>\n                        <div class=\"differential-icon\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                                <polyline points=\"12 6 12 12 16 14\"></polyline>\n                            </svg>\n                        </div>\n                    </div>\n                    <h3>Atendimento Pontual</h3>\n                    <p>Respeito ao seu tempo com agendamentos organizados e sem esperas prolongadas.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up wow-delay-2\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon-ring\"></div>\n                        <div class=\"differential-icon\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path>\n                            </svg>\n                        </div>\n                    </div>\n                    <h3>Ambiente Seguro</h3>\n                    <p>Clínica com rigorosos padrões de biossegurança e assepsia para sua proteção.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up wow-delay-3\">\n                    <div class=\"differential-icon-wrapper\">\n                        <div class=\"differential-icon-ring\"></div>\n                        <div class=\"differential-icon\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"></path>\n                            </svg>\n                        </div>\n                    </div>\n                    <h3>Acompanhamento</h3>\n                    <p>Suporte contínuo antes, durante e após os procedimentos para sua tranquilidade.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"contact\" id=\"contato\">\n        <div class=\"section-container\">\n            <div class=\"contact-grid\">\n                <div class=\"contact-info\">\n                    <h3>Agende Sua Consulta</h3>\n                    <p>Entre em contato para transformar sua autoestima com procedimentos estéticos de alta qualidade.</p>\n\n                    <div class=\"contact-details\">\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                    <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0