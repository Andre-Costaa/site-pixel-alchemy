{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_15b11bc24b3a466c93332e3b","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-paula-meirelles/index.html"}]},"parent_tool_use_id":null,"session_id":"2ed0ea99-7e37-4320-8594-34538afe20bd","uuid":"60ffeb35-5a54-4523-a1fc-5dd8ec82920e","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-paula-meirelles/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Paula Meirelles | Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Paula Meirelles - Especialista em harmonização facial em Ribeirão Preto. Transforme sua beleza natural com tratamentos personalizados. Agende: (16) 99302-4881\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ========================================\n           CSS VARIABLES & ROOT STYLES\n        ======================================== */\n        :root {\n            /* Colors - Velvet Plum & Gold Noir Palette */\n            --color-plum: #8B4A6B;\n            --color-plum-light: #A85D82;\n            --color-plum-dark: #6B3A52;\n            --color-plum-deep: #4A2838;\n            --color-plum-mist: #F8EDF5;\n            --color-gold: #C9A86C;\n            --color-gold-light: #D4BA8A;\n            --color-gold-dark: #A88A52;\n            --color-gold-glow: #E8D4A8;\n            --color-pearl: #FDF8F4;\n            --color-pearl-warm: #F8F0EA;\n            --color-cream: #FAF5F1;\n            --color-charcoal: #1A1A1A;\n            --color-charcoal-light: #4A4A4A;\n            --color-taupe: #8A8580;\n            --color-taupe-light: #A8A39E;\n\n            /* Gradients */\n            --gradient-plum: linear-gradient(135deg, #8B4A6B 0%, #A85D82 100%);\n            --gradient-plum-soft: linear-gradient(135deg, #A85D82 0%, #F8EDF5 100%);\n            --gradient-gold: linear-gradient(135deg, #C9A86C 0%, #D4BA8A 100%);\n            --gradient-luxury: linear-gradient(135deg, #8B4A6B 0%, #C9A86C 100%);\n            --gradient-fade: linear-gradient(180deg, rgba(253,248,244,0) 0%, rgba(253,248,244,1) 100%);\n            --gradient-warm: linear-gradient(135deg, #F8EDF5 0%, #FAF5F1 100%);\n\n            /* Typography */\n            --font-display: 'Playfair Display', Georgia, serif;\n            --font-body: 'Outfit', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n            --spacing-xxl: 8rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 16px;\n            --radius-lg: 24px;\n            --radius-pill: 100px;\n            --radius-petal: 68% 32% 42% 58% / 52% 38% 62% 48%;\n            --radius-petal-2: 48% 52% 58% 42% / 38% 62% 48% 52%;\n            --radius-petal-3: 58% 42% 48% 52% / 62% 38% 52% 48%;\n\n            /* Shadows */\n            --shadow-soft: 0 8px 32px rgba(139, 74, 107, 0.15);\n            --shadow-glow: 0 8px 48px rgba(139, 74, 107, 0.25);\n            --shadow-elegant: 0 16px 64px rgba(26, 26, 26, 0.08);\n            --shadow-floating: 0 20px 60px rgba(139, 74, 107, 0.2);\n            --shadow-gold: 0 8px 32px rgba(201, 168, 108, 0.2);\n\n            /* Transitions */\n            --transition-fast: 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-base: 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-slow: 0.8s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n\n        /* ========================================\n           RESET & BASE STYLES\n        ======================================== */\n        *, *::before, *::after {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        html {\n            scroll-behavior: smooth;\n            font-size: 16px;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background: var(--color-pearl);\n            color: var(--color-charcoal);\n            line-height: 1.7;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        img {\n            max-width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-fast);\n        }\n\n        ul {\n            list-style: none;\n        }\n\n        /* ========================================\n           TYPOGRAPHY\n        ======================================== */\n        h1, h2, h3, h4 {\n            font-family: var(--font-display);\n            font-weight: 500;\n            line-height: 1.2;\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 8vw, 5rem);\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 5vw, 3.5rem);\n            letter-spacing: -0.01em;\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 3vw, 2rem);\n        }\n\n        .text-plum { color: var(--color-plum); }\n        .text-gold { color: var(--color-gold); }\n\n        /* ========================================\n           NAVIGATION\n        ======================================== */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            background: rgba(253, 248, 244, 0.95);\n            backdrop-filter: blur(20px);\n            z-index: 1000;\n            transition: transform var(--transition-base);\n            box-shadow: 0 1px 0 rgba(139, 74, 107, 0.1);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 1rem 2rem;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            color: var(--color-charcoal);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: 2rem;\n            align-items: center;\n        }\n\n        .nav-link {\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-charcoal-light);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-plum);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.75rem 1.5rem;\n            background: var(--color-plum);\n            color: white;\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: all var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            background: var(--color-plum-dark);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .mobile-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            cursor: pointer;\n            padding: 5px;\n        }\n\n        .mobile-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-charcoal);\n            transition: var(--transition-fast);\n        }\n\n        /* ========================================\n           HERO SECTION\n        ======================================== */\n        .hero {\n            position: relative;\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            overflow: hidden;\n            background: var(--gradient-warm);\n        }\n\n        .hero-petals {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            overflow: hidden;\n            z-index: 1;\n        }\n\n        .petal {\n            position: absolute;\n            border-radius: var(--radius-petal);\n            filter: blur(60px);\n            opacity: 0.5;\n            animation: petal-float 20s ease-in-out infinite;\n        }\n\n        .petal-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-plum);\n            top: -10%;\n            right: -5%;\n            animation-delay: 0s;\n        }\n\n        .petal-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-plum-soft);\n            bottom: -5%;\n            left: -10%;\n            animation-delay: -6s;\n            border-radius: var(--radius-petal-2);\n        }\n\n        .petal-3 {\n            width: 350px;\n            height: 350px;\n            background: var(--gradient-gold);\n            top: 40%;\n            left: 30%;\n            animation-delay: -12s;\n            opacity: 0.35;\n            border-radius: var(--radius-petal-3);\n        }\n\n        .petal-4 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(135deg, #E8D4A8 0%, #F8EDF5 100%);\n            top: 20%;\n            left: 10%;\n            animation-delay: -3s;\n            opacity: 0.3;\n            border-radius: var(--radius-petal);\n        }\n\n        @keyframes petal-float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(90deg) scale(1.05);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(180deg) scale(0.95);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(270deg) scale(1.02);\n            }\n        }\n\n        .hero-container {\n            position: relative;\n            z-index: 2;\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 8rem 2rem 4rem;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: center;\n        }\n\n        .hero-content {\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fade-up 0.8s ease forwards 0.2s;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 0.5rem 1rem;\n            background: var(--color-plum-mist);\n            color: var(--color-plum);\n            border-radius: var(--radius-pill);\n            font-size: 0.85rem;\n            font-weight: 600;\n            margin-bottom: 1.5rem;\n        }\n\n        .hero-badge svg {\n            width: 16px;\n            height: 16px;\n        }\n\n        .hero-title {\n            margin-bottom: 1.5rem;\n            color: var(--color-charcoal);\n        }\n\n        .hero-title span {\n            background: var(--gradient-plum);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: 1.25rem;\n            color: var(--color-charcoal-light);\n            margin-bottom: 2rem;\n            line-height: 1.6;\n        }\n\n        .hero-cta {\n            display: flex;\n            gap: 1rem;\n            flex-wrap: wrap;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            font-size: 1rem;\n            transition: all var(--transition-fast);\n            cursor: pointer;\n            border: none;\n        }\n\n        .btn svg {\n            width: 20px;\n            height: 20px;\n        }\n\n        .btn-primary {\n            background: var(--color-plum);\n            color: white;\n        }\n\n        .btn-primary:hover {\n            background: var(--color-plum-dark);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-plum);\n            border: 2px solid var(--color-plum);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-plum-mist);\n        }\n\n        .hero-image {\n            position: relative;\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fade-up 0.8s ease forwards 0.4s;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            border-radius: var(--radius-lg);\n            overflow: hidden;\n        }\n\n        .hero-image img {\n            width: 100%;\n            height: auto;\n            border-radius: var(--radius-lg);\n        }\n\n        .hero-image-decoration {\n            position: absolute;\n            width: 200px;\n            height: 200px;\n            background: var(--gradient-gold);\n            border-radius: var(--radius-petal);\n            filter: blur(40px);\n            opacity: 0.3;\n            top: -20px;\n            right: -20px;\n            animation: petal-float 15s ease-in-out infinite reverse;\n        }\n\n        .floating-cards {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n        }\n\n        .float-card {\n            position: absolute;\n            background: white;\n            padding: 1rem 1.5rem;\n            border-radius: var(--radius-md);\n            box-shadow: var(--shadow-floating);\n            display: flex;\n            align-items: center;\n            gap: 0.75rem;\n            animation: float 6s ease-in-out infinite;\n        }\n\n        .float-card-1 {\n            top: 10%;\n            left: -30px;\n            animation-delay: 0s;\n        }\n\n        .float-card-2 {\n            bottom: 15%;\n            right: -20px;\n            animation-delay: -3s;\n        }\n\n        .float-card-icon {\n            width: 40px;\n            height: 40px;\n            background: var(--color-plum-mist);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-plum);\n        }\n\n        .float-card-text {\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-charcoal);\n        }\n\n        @keyframes float {\n            0%, 100% {\n                transform: translateY(0);\n            }\n            50% {\n                transform: translateY(-15px);\n            }\n        }\n\n        @keyframes fade-up {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        /* ========================================\n           PROBLEM/SOLUTION SECTION\n        ======================================== */\n        .problem-solution {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-pearl);\n        }\n\n        .section-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .section-tag {\n            display: inline-block;\n            padding: 0.5rem 1rem;\n            background: var(--color-plum-mist);\n            color: var(--color-plum);\n            border-radius: var(--radius-pill);\n            font-size: 0.85rem;\n            font-weight: 600;\n            margin-bottom: 1rem;\n        }\n\n        .section-title {\n            margin-bottom: 1rem;\n        }\n\n        .section-description {\n            font-size: 1.1rem;\n            color: var(--color-charcoal-light);\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 3rem;\n        }\n\n        .problem-card, .solution-card {\n            background: white;\n            padding: 2.5rem;\n            border-radius: var(--radius-lg);\n            position: relative;\n            overflow: hidden;\n            transition: all var(--transition-base);\n        }\n\n        .problem-card {\n            border-left: 4px solid var(--color-charcoal-light);\n        }\n\n        .problem-card:hover {\n            box-shadow: var(--shadow-elegant);\n        }\n\n        .solution-card {\n            border-left: 4px solid var(--color-plum);\n        }\n\n        .solution-card:hover {\n            box-shadow: var(--shadow-glow);\n            transform: translateY(-5px);\n        }\n\n        .card-icon {\n            width: 60px;\n            height: 60px;\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n        }\n\n        .problem-card .card-icon {\n            background: var(--color-charcoal-light);\n            color: white;\n        }\n\n        .solution-card .card-icon {\n            background: var(--gradient-plum);\n            color: white;\n        }\n\n        .card-title {\n            margin-bottom: 1rem;\n            font-size: 1.5rem;\n        }\n\n        .card-text {\n            color: var(--color-charcoal-light);\n            line-height: 1.7;\n        }\n\n        .solution-list {\n            margin-top: 1.5rem;\n        }\n\n        .solution-list li {\n            display: flex;\n            align-items: center;\n            gap: 0.75rem;\n            margin-bottom: 0.75rem;\n            color: var(--color-charcoal-light);\n        }\n\n        .solution-list li svg {\n            width: 20px;\n            height: 20px;\n            color: var(--color-plum);\n            flex-shrink: 0;\n        }\n\n        /* ========================================\n           SERVICES SECTION\n        ======================================== */\n        .services {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-cream);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n            margin-top: var(--spacing-lg);\n        }\n\n        .service-card {\n            background: white;\n            padding: 2rem;\n            border-radius: var(--radius-lg);\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-floating);\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 4px;\n            background: var(--gradient-plum);\n            transform: scaleX(0);\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--color-plum-mist);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n            color: var(--color-plum);\n            transition: all var(--transition-base);\n        }\n\n        .service-card:hover .service-icon {\n            background: var(--gradient-plum);\n            color: white;\n        }\n\n        .service-card:hover .service-icon svg {\n            transform: scale(1.1);\n        }\n\n        .service-icon svg {\n            width: 28px;\n            height: 28px;\n            transition: transform var(--transition-base);\n        }\n\n        .service-title {\n            margin-bottom: 0.75rem;\n            font-size: 1.25rem;\n        }\n\n        .service-description {\n            color: var(--color-charcoal-light);\n            font-size: 0.95rem;\n            margin-bottom: 1.5rem;\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-plum);\n            font-weight: 600;\n            font-size: 0.9rem;\n        }\n\n        .service-link svg {\n            width: 16px;\n            height: 16px;\n            transition: transform var(--transition-fast);\n        }\n\n        .service-link:hover svg {\n            transform: translateX(5px);\n        }\n\n        /* ========================================\n           TESTIMONIALS SECTION\n        ======================================== */\n        .testimonials {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-plum);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .testimonials::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background: url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\");\n            opacity: 0.5;\n        }\n\n        .testimonials .section-container {\n            position: relative;\n            z-index: 2;\n        }\n\n        .testimonials .section-title,\n        .testimonials .section-description {\n            color: white;\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n            margin-top: var(--spacing-lg);\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.1);\n            backdrop-filter: blur(10px);\n            padding: 2rem;\n            border-radius: var(--radius-lg);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            transition: all var(--transition-base);\n        }\n\n        .testimonial-card:hover {\n            background: rgba(255, 255, 255, 0.15);\n            transform: translateY(-5px);\n        }\n\n        .testimonial-stars {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: 1rem;\n        }\n\n        .testimonial-stars svg {\n            width: 18px;\n            height: 18px;\n            fill: var(--color-gold);\n        }\n\n        .testimonial-text {\n            color: rgba(255, 255, 255, 0.9);\n            font-style: italic;\n            margin-bottom: 1.5rem;\n            line-height: 1.6;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-gold);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: white;\n        }\n\n        .testimonial-info h4 {\n            font-size: 1rem;\n            color: white;\n            margin-bottom: 0.25rem;\n        }\n\n        .testimonial-info p {\n            font-size: 0.85rem;\n            color: rgba(255, 255, 255, 0.7);\n        }\n\n        /* ========================================\n           DIFFERENTIALS SECTION\n        ======================================== */\n        .differentials {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-pearl);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n            margin-top: var(--spacing-lg);\n        }\n\n        .differential-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n            padding: 1.5rem;\n            border-radius: var(--radius-md);\n            transition: all var(--transition-base);\n        }\n\n        .differential-item:hover {\n            background: white;\n            box-shadow: var(--shadow-soft);\n        }\n\n        .differential-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-plum);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            flex-shrink: 0;\n            position: relative;\n        }\n\n        .differential-icon::before {\n            content: '';\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            border-radius: 50%;\n            border: 2px solid var(--color-plum);\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% {\n                transform: scale(1);\n                opacity: 1;\n            }\n            50% {\n                transform: scale(1.2);\n                opacity: 0;\n            }\n        }\n\n        .differential-icon svg {\n            width: 24px;\n            height: 24px;\n            position: relative;\n            z-index: 2;\n        }\n\n        .differential-content h3 {\n            font-size: 1.1rem;\n            margin-bottom: 0.5rem;\n        }\n\n        .differential-content p {\n            color: var(--color-charcoal-light);\n            font-size: 0.9rem;\n        }\n\n        /* ========================================\n           CONTACT SECTION\n        ======================================== */\n        .contact {\n            padding: var(--spacing-xl) 2rem;\n            background: var(--color-cream);\n        }\n\n        .contact-wrapper {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            margin-top: var(--spacing-lg);\n        }\n\n        .contact-info {\n            display: flex;\n            flex-direction: column;\n            gap: 2rem;\n        }\n\n        .contact-info-title {\n            margin-bottom: 1rem;\n        }\n\n        .contact-info-text {\n            color: var(--color-charcoal-light);\n            line-height: 1.7;\n        }\n\n        .contact-details {\n            display: flex;\n            flex-direction: column;\n            gap: 1.5rem;\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n        }\n\n        .contact-item-icon {\n            width: 45px;\n            height: 45px;\n            background: var(--color-plum-mist);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-plum);\n            flex-shrink: 0;\n        }\n\n        .contact-item-icon svg {\n            width: 20px;\n            height: 20px;\n        }\n\n        .contact-item-content h4 {\n            font-size: 1rem;\n            margin-bottom: 0.25rem;\n        }\n\n        .contact-item-content p {\n            color: var(--color-charcoal-light);\n            font-size: 0.95rem;\n        }\n\n        .contact-form-wrapper {\n            background: white;\n            padding: 2.5rem;\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-elegant);\n        }\n\n        .contact-form-title {\n            margin-bottom: 1.5rem;\n        }\n\n        .form-group {\n            margin-bottom: 1.5rem;\n        }\n\n        .form-label {\n            display: block;\n            margin-bottom: 0.5rem;\n            font-weight: 500;\n            font-size: 0.9rem;\n        }\n\n        .form-input,\n        .form-select,\n        .form-textarea {\n            width: 100%;\n            padding: 0.875rem 1rem;\n            border: 2px solid var(--color-taupe-light);\n            border-radius: var(--radius-md);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: all var(--transition-fast);\n            background: var(--color-pearl);\n        }\n\n        .form-input:focus,\n        .form-select:focus,\n        .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-plum);\n            background: white;\n        }\n\n        .form-textarea {\n            resize: vertical;\n            min-height: 120px;\n        }\n\n        .btn-submit {\n            width: 100%;\n            padding: 1rem 2rem;\n            background: var(--color-plum);\n            color: white;\n            border: none;\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: all var(--transition-fast);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 0.5rem;\n        }\n\n        .btn-submit:hover {\n            background: var(--color-plum-dark);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .btn-whatsapp {\n            background: #25D366;\n        }\n\n        .btn-whatsapp:hover {\n            background: #1DA851;\n        }\n\n        /* ========================================\n           FOOTER\n        ======================================== */\n        .footer {\n            padding: 3rem 2rem;\n            background: var(--color-charcoal);\n            color: white;\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: 3rem;\n        }\n\n        .footer-brand h3 {\n            margin-bottom: 1rem;\n        }\n\n        .footer-brand p {\n            color: var(--color-taupe-light);\n            line-height: 1.7;\n        }\n\n        .footer-links h4,\n        .footer-contact h4 {\n            margin-bottom: 1rem;\n            font-size: 1rem;\n        }\n\n        .footer-links ul {\n            display: flex;\n            flex-direction: column;\n            gap: 0.5rem;\n        }\n\n        .footer-links a {\n            color: var(--color-taupe-light);\n            font-size: 0.9rem;\n        }\n\n        .footer-links a:hover {\n            color: var(--color-plum-light);\n        }\n\n        .footer-contact p {\n            color: var(--color-taupe-light);\n            font-size: 0.9rem;\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-bottom {\n            max-width: 1200px;\n            margin: 2rem auto 0;\n            padding-top: 2rem;\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            text-align: center;\n            color: var(--color-taupe-light);\n            font-size: 0.85rem;\n        }\n\n        /* ========================================\n           ANIMATIONS\n        ======================================== */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: all 0.6s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.6s ease;\n        }\n\n        .wow-fade-in.visible {\n            opacity: 1;\n        }\n\n        .wow-scale-up {\n            opacity: 0;\n            transform: scale(0.9);\n            transition: all 0.6s ease;\n        }\n\n        .wow-scale-up.visible {\n            opacity: 1;\n            transform: scale(1);\n        }\n\n        /* Stagger delays */\n        .delay-100 { transition-delay: 0.1s; }\n        .delay-200 { transition-delay: 0.2s; }\n        .delay-300 { transition-delay: 0.3s; }\n        .delay-400 { transition-delay: 0.4s; }\n        .delay-500 { transition-delay: 0.5s; }\n        .delay-600 { transition-delay: 0.6s; }\n\n        /* ========================================\n           RESPONSIVE DESIGN\n        ======================================== */\n        @media (max-width: 1024px) {\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-cta {\n                justify-content: center;\n            }\n\n            .hero-image {\n                order: -1;\n                margin-bottom: 2rem;\n            }\n\n            .floating-cards {\n                display: none;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .contact-wrapper {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                display: none;\n                position: absolute;\n                top: 100%;\n                left: 0;\n                width: 100%;\n                background: white;\n                flex-direction: column;\n                padding: 2rem;\n                gap: 1rem;\n                box-shadow: var(--shadow-elegant);\n            }\n\n            .nav-menu.active {\n                display: flex;\n            }\n\n            .mobile-toggle {\n                display: flex;\n            }\n\n            .problem-solution-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .hero-cta {\n                flex-direction: column;\n                width: 100%;\n            }\n\n            .btn {\n                width: 100%;\n                justify-content: center;\n            }\n        }\n\n        /* Reduced motion */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <div class=\"nav-logo\">Dra. Paula Meirelles</div>\n            <div class=\"mobile-toggle\" id=\"mobileToggle\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#home\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#services\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#testimonials\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#contact\" class=\"nav-link\">Contato</a></li>\n                <li><a href=\"#contact\" class=\"nav-cta\">Agendar</a></li>\n            </ul>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-petals\">\n            <div class=\"petal petal-1\"></div>\n            <div class=\"petal petal-2\"></div>\n            <div class=\"petal petal-3\"></div>\n            <div class=\"petal petal-4\"></div>\n        </div>\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                        <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                    </svg>\n                    Especialista em Harmonização Facial\n                </div>\n                <h1 class=\"hero-title\">\n                    Realce sua <span>beleza natural</span> com tratamentos exclusivos\n                </h1>\n                <p class=\"hero-subtitle\">\n                    Transforme sua aparência com procedimentos estéticos avançados e personalizados. Resultados naturais que valorizam seus traços únicos.\n                </p>\n                <div class=\"hero-cta\">\n                    <a href=\"#contact\" class=\"btn btn-primary\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"/>\n                            <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/>\n                            <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/>\n                            <line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/>\n                        </svg>\n                        Agendar Consulta\n                    </a>\n                    <a href=\"#services\" class=\"btn btn-secondary\">\n                        Conhecer Tratamentos\n                    </a>\n                </div>\n            </div>\n            <div class=\"hero-image\">\n                <div class=\"hero-image-wrapper\">\n                    <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=800&q=80\" alt=\"Harmonização Facial\">\n                </div>\n                <div class=\"hero-image-decoration\"></div>\n                <div class=\"floating-cards\">\n                    <div class=\"float-card float-card-1\">\n                        <div class=\"float-card-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" width=\"20\" height=\"20\">\n                                <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                            </svg>\n                        </div>\n                        <span class=\"float-card-text\">+5.000 atendimentos</span>\n                    </div>\n                    <div class=\"float-card float-card-2\">\n                        <div class=\"float-card-icon\">\n                            <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" width=\"20\" height=\"20\">\n                                <path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/>\n                            </svg>\n                        </div>\n                        <span class=\"float-card-text\">Certificada</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"problem-solution\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Sua Jornada</span>\n                <h2 class=\"section-title\">Transforme sua autoestima</h2>\n                <p class=\"section-description\">Entenda como podemos ajudá-lo a alcançar a aparência que você sempre desejou</p>\n            </div>\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card wow-fade-up\">\n                    <div class=\"card-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" width=\"28\" height=\"28\">\n                            <path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z\"/>\n                        </svg>\n                    </div>\n                    <h3 class=\"card-title\">O Desafio</h3>\n                    <p class=\"card-text\">\n                        Com o tempo, os sinais de envelhecimento facial se tornam mais evidentes. Linhas de expressão, perda de volume e assimetrias podem afetar sua confiança e bem-estar.\n                    </p>\n                </div>\n                <div class=\"solution-card wow-fade-up delay-200\">\n                    <div class=\"card-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" width=\"28\" height=\"28\">\n                            <path d=\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z\"/>\n                        </svg>\n                    </div>\n                    <h3 class=\"card-title\">A Solução</h3>\n                    <p class=\"card-text\">\n                        Com técnicas avançadas de harmonização facial, realizo uma análise personalizada para realçar seus traços naturais e proporcionar resultados harmônicos e naturais.\n                    </p>\n                    <ul class=\"solution-list\">\n                        <li>\n                            <svg viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                                <path d=\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z\"/>\n                            </svg>\n                            Análise facial personalizada\n                        </li>\n                        <li>\n                            <svg viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                                <path d=\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z\"/>\n                            </svg>\n                            Procedimentos seguros e certificadoss\n                        </li>\n                        <li>\n                            <svg viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                                <path d=\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z\"/>\n                            </svg>\n                            Resultados naturais e duradouros\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"services\" id=\"services\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Tratamentos</span>\n                <h2 class=\"section-title\">Procedimentos Especializados</h2>\n                <p class=\"section-description\">Técnicas avançadas para realçar sua beleza natural com segurança e excelência</p>\n            </div>\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            <path d=\"M8 14s1.5 2 4 2 4-2 4-2\"/>\n                            <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"/>\n                            <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"/>\n                        </svg>\n                    </div>\n                    <h3 class=\"service-title\">Harmonização Facial</h3>\n                    <p class=\"service-description\">Equilibre seus traços faciais com preenchedores e toxina botulínica para uma aparência harmônica e natural.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n                <div class=\"service-card wow-fade-up delay-100\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3 class=\"service-title\">Toxina Botulínica</h3>\n                    <p class=\"service-description\">Suavize linhas de expressão e previna novos sinais de envelhecimento com aplicação estratégica.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais