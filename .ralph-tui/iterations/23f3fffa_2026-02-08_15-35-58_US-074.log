r(--color-champagne) 0%, var(--color-champagne-light) 50%, var(--color-champagne-mid) 100%);\n            --gradient-pearl: linear-gradient(135deg, var(--color-pearl) 0%, var(--color-pearl-light) 100%);\n            --gradient-noir: linear-gradient(145deg, var(--color-noir) 0%, var(--color-noir-charcoal) 100%);\n            --gradient-warm: linear-gradient(180deg, var(--color-ivory) 0%, var(--color-cream) 100%);\n            --gradient-luxe: linear-gradient(145deg, var(--color-champagne-deep) 0%, var(--color-champagne) 30%, var(--color-pearl-light) 70%, var(--color-ivory) 100%);\n\n            /* Typography */\n            --font-display: 'Cormorant Garamond', Georgia, serif;\n            --font-body: 'Plus Jakarta Sans', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 1.5rem;\n            --spacing-lg: 2rem;\n            --spacing-xl: 3rem;\n            --spacing-2xl: 4rem;\n            --spacing-3xl: 6rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 12px;\n            --radius-lg: 20px;\n            --radius-xl: 30px;\n            --radius-ellipse-1: 70% 30% 50% 50% / 50% 50% 70% 30%;\n            --radius-ellipse-2: 50% 50% 70% 30% / 30% 70% 50% 50%;\n            --radius-ellipse-3: 60% 40% 40% 60% / 40% 60% 60% 40%;\n            --radius-ellipse-4: 40% 60% 60% 40% / 60% 40% 40% 60%;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.3s ease;\n            --transition-slow: 0.5s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(201, 168, 108, 0.08);\n            --shadow-md: 0 4px 16px rgba(201, 168, 108, 0.12);\n            --shadow-lg: 0 8px 32px rgba(201, 168, 108, 0.16);\n            --shadow-champagne: 0 4px 20px rgba(201, 168, 108, 0.25);\n            --shadow-pearl: 0 4px 20px rgba(232, 228, 220, 0.4);\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background: var(--gradient-warm);\n            color: var(--color-noir);\n            line-height: 1.6;\n            overflow-x: hidden;\n        }\n\n        /* Typography */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-noir);\n        }\n\n        h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); }\n        h2 { font-size: clamp(2rem, 4vw, 3rem); }\n        h3 { font-size: clamp(1.25rem, 2.5vw, 1.75rem); }\n\n        p {\n            font-size: clamp(0.95rem, 1.2vw, 1.1rem);\n            color: var(--color-noir-soft);\n            opacity: 0.9;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* Navigation */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-md) var(--spacing-lg);\n            background: rgba(250, 250, 248, 0.95);\n            backdrop-filter: blur(10px);\n            border-bottom: 1px solid rgba(201, 168, 108, 0.15);\n            transition: transform 0.3s ease, padding 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-champagne-dark);\n        }\n\n        .nav-links {\n            display: flex;\n            gap: var(--spacing-lg);\n            list-style: none;\n        }\n\n        .nav-links a {\n            font-weight: 500;\n            font-size: 0.95rem;\n            color: var(--color-noir);\n            position: relative;\n        }\n\n        .nav-links a::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-champagne);\n            transition: width var(--transition-base);\n        }\n\n        .nav-links a:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.6rem 1.4rem;\n            background: var(--gradient-champagne);\n            color: white;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            transition: var(--transition-base);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-champagne);\n        }\n\n        .nav-menu-btn {\n            display: none;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: var(--spacing-xs);\n        }\n\n        .nav-menu-btn span {\n            display: block;\n            width: 24px;\n            height: 2px;\n            background: var(--color-champagne-dark);\n            margin: 4px 0;\n            transition: var(--transition-base);\n        }\n\n        /* Hero Section */\n        .hero {\n            position: relative;\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-xl);\n            overflow: hidden;\n        }\n\n        .hero-blobs {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            top: 0;\n            left: 0;\n            pointer-events: none;\n            z-index: 0;\n        }\n\n        .hero-blob {\n            position: absolute;\n            opacity: 0.12;\n            animation: blob-float 20s ease-in-out infinite;\n        }\n\n        .hero-blob-1 {\n            width: 500px;\n            height: 500px;\n            top: -150px;\n            right: -100px;\n            background: var(--gradient-champagne);\n            border-radius: var(--radius-ellipse-1);\n            animation-delay: 0s;\n        }\n\n        .hero-blob-2 {\n            width: 400px;\n            height: 400px;\n            bottom: -100px;\n            left: -50px;\n            background: var(--gradient-pearl);\n            border-radius: var(--radius-ellipse-2);\n            animation-delay: -5s;\n        }\n\n        .hero-blob-3 {\n            width: 300px;\n            height: 300px;\n            top: 50%;\n            left: 10%;\n            background: linear-gradient(135deg, var(--color-blush) 0%, var(--color-pearl-light) 100%);\n            border-radius: var(--radius-ellipse-3);\n            animation-delay: -10s;\n            opacity: 0.08;\n        }\n\n        .hero-blob-4 {\n            width: 350px;\n            height: 350px;\n            bottom: 20%;\n            right: 15%;\n            background: linear-gradient(135deg, var(--color-champagne-light) 0%, var(--color-blush-light) 100%);\n            border-radius: var(--radius-ellipse-4);\n            animation-delay: -15s;\n            opacity: 0.1;\n        }\n\n        @keyframes blob-float {\n            0%, 100% {\n                transform: translate(0, 0) scale(1) rotate(0deg);\n            }\n            25% {\n                transform: translate(20px, -30px) scale(1.05) rotate(3deg);\n            }\n            50% {\n                transform: translate(-15px, 20px) scale(0.95) rotate(-3deg);\n            }\n            75% {\n                transform: translate(25px, 15px) scale(1.02) rotate(2deg);\n            }\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 1;\n            max-width: 900px;\n            text-align: center;\n        }\n\n        .hero-badge {\n            display: inline-block;\n            padding: 0.5rem 1.2rem;\n            background: var(--gradient-pearl);\n            color: var(--color-champagne-dark);\n            border-radius: 50px;\n            font-size: 0.85rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-md);\n            animation: fade-in-up 0.8s ease forwards;\n            animation-delay: 0ms;\n            opacity: 0;\n        }\n\n        .hero h1 {\n            margin-bottom: var(--spacing-md);\n            animation: fade-in-up 0.8s ease forwards;\n            animation-delay: 200ms;\n            opacity: 0;\n        }\n\n        .hero-subtitle {\n            font-size: clamp(1.1rem, 2vw, 1.35rem);\n            color: var(--color-noir-soft);\n            margin-bottom: var(--spacing-lg);\n            max-width: 700px;\n            margin-left: auto;\n            margin-right: auto;\n            animation: fade-in-up 0.8s ease forwards;\n            animation-delay: 400ms;\n            opacity: 0;\n        }\n\n        .hero-cta {\n            display: inline-flex;\n            gap: var(--spacing-md);\n            animation: fade-in-up 0.8s ease forwards;\n            animation-delay: 600ms;\n            opacity: 0;\n        }\n\n        .btn-primary {\n            padding: 1rem 2rem;\n            background: var(--gradient-champagne);\n            color: white;\n            border: none;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-champagne);\n        }\n\n        .btn-secondary {\n            padding: 1rem 2rem;\n            background: transparent;\n            color: var(--color-champagne-dark);\n            border: 2px solid var(--color-champagne);\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-champagne);\n            color: white;\n        }\n\n        @keyframes fade-in-up {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        /* Section Styles */\n        .section {\n            padding: var(--spacing-3xl) var(--spacing-lg);\n            position: relative;\n        }\n\n        .section-header {\n            text-align: center;\n            max-width: 700px;\n            margin: 0 auto var(--spacing-2xl);\n        }\n\n        .section-tag {\n            display: inline-block;\n            padding: 0.4rem 1rem;\n            background: var(--gradient-pearl);\n            color: var(--color-champagne-dark);\n            border-radius: 50px;\n            font-size: 0.8rem;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .section-title {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .section-subtitle {\n            font-size: 1.05rem;\n            color: var(--color-noir-soft);\n        }\n\n        /* Problem/Solution Section */\n        .problem-solution {\n            background: var(--color-ivory);\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-xl);\n            max-width: 1100px;\n            margin: 0 auto;\n        }\n\n        .problem-card, .solution-card {\n            background: white;\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            position: relative;\n            overflow: hidden;\n            transition: var(--transition-base);\n        }\n\n        .problem-card::before {\n            content: '';\n            position: absolute;\n            left: 0;\n            top: 0;\n            bottom: 0;\n            width: 4px;\n            background: linear-gradient(180deg, var(--color-noir) 0%, var(--color-noir-soft) 100%);\n        }\n\n        .solution-card::before {\n            content: '';\n            position: absolute;\n            left: 0;\n            top: 0;\n            bottom: 0;\n            width: 4px;\n            background: var(--gradient-champagne);\n        }\n\n        .problem-card:hover, .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-md);\n        }\n\n        .card-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-pearl);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-md);\n            font-size: 1.5rem;\n        }\n\n        .solution-card .card-icon {\n            background: var(--gradient-champagne);\n        }\n\n        .card-title {\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.4rem;\n        }\n\n        .card-list {\n            list-style: none;\n            margin-top: var(--spacing-md);\n        }\n\n        .card-list li {\n            padding: var(--spacing-xs) 0;\n            padding-left: 1.5rem;\n            position: relative;\n            font-size: 0.95rem;\n            color: var(--color-noir-soft);\n        }\n\n        .card-list li::before {\n            content: '•';\n            position: absolute;\n            left: 0;\n            color: var(--color-champagne);\n            font-weight: bold;\n        }\n\n        /* Services Section */\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .service-card {\n            background: white;\n            padding: var(--spacing-lg);\n            border-radius: var(--radius-lg);\n            text-align: center;\n            transition: var(--transition-base);\n            border: 1px solid rgba(201, 168, 108, 0.1);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-champagne);\n            transform: scaleX(0);\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .service-icon {\n            width: 70px;\n            height: 70px;\n            margin: 0 auto var(--spacing-md);\n            background: var(--gradient-pearl);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 2rem;\n        }\n\n        .service-title {\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.3rem;\n        }\n\n        .service-description {\n            font-size: 0.95rem;\n            color: var(--color-noir-soft);\n        }\n\n        /* Testimonials Section */\n        .testimonials {\n            background: var(--gradient-noir);\n            color: white;\n        }\n\n        .testimonials .section-title,\n        .testimonials .section-subtitle {\n            color: white;\n        }\n\n        .testimonials .section-subtitle {\n            opacity: 0.8;\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(10px);\n            padding: var(--spacing-lg);\n            border-radius: var(--radius-lg);\n            border: 1px solid rgba(201, 168, 108, 0.2);\n        }\n\n        .testimonial-stars {\n            color: var(--color-champagne);\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.1rem;\n        }\n\n        .testimonial-text {\n            color: rgba(255, 255, 255, 0.9);\n            font-style: italic;\n            margin-bottom: var(--spacing-md);\n            font-size: 0.95rem;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 45px;\n            height: 45px;\n            border-radius: 50%;\n            background: var(--gradient-champagne);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: white;\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n            font-size: 0.95rem;\n        }\n\n        .testimonial-role {\n            font-size: 0.85rem;\n            opacity: 0.7;\n        }\n\n        /* Differentials Section */\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .differential-item {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-md);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-md);\n            transition: var(--transition-base);\n        }\n\n        .differential-item:hover {\n            background: white;\n            box-shadow: var(--shadow-sm);\n        }\n\n        .differential-icon {\n            width: 55px;\n            height: 55px;\n            min-width: 55px;\n            background: var(--gradient-pearl);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.5rem;\n            position: relative;\n        }\n\n        .differential-icon::after {\n            content: '';\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            border-radius: var(--radius-md);\n            border: 2px solid var(--color-champagne);\n            opacity: 0;\n            animation: pulse-ring 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse-ring {\n            0% {\n                transform: scale(1);\n                opacity: 0.5;\n            }\n            100% {\n                transform: scale(1.3);\n                opacity: 0;\n            }\n        }\n\n        .differential-content h4 {\n            font-size: 1.1rem;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        .differential-content p {\n            font-size: 0.9rem;\n        }\n\n        /* Contact Section */\n        .contact {\n            background: var(--color-ivory);\n        }\n\n        .contact-container {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-2xl);\n            max-width: 1100px;\n            margin: 0 auto;\n        }\n\n        .contact-info {\n            padding: var(--spacing-lg);\n        }\n\n        .contact-info h3 {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-info p {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-details {\n            margin-top: var(--spacing-lg);\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n            margin-bottom: var(--spacing-md);\n            padding: var(--spacing-sm);\n            background: white;\n            border-radius: var(--radius-md);\n            transition: var(--transition-base);\n        }\n\n        .contact-item:hover {\n            box-shadow: var(--shadow-sm);\n        }\n\n        .contact-item-icon {\n            width: 40px;\n            height: 40px;\n            background: var(--gradient-pearl);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.2rem;\n        }\n\n        .contact-item-text h4 {\n            font-size: 0.9rem;\n            font-weight: 600;\n        }\n\n        .contact-item-text p {\n            font-size: 0.85rem;\n            margin: 0;\n        }\n\n        .contact-form {\n            background: white;\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-md);\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-label {\n            display: block;\n            font-weight: 500;\n            margin-bottom: var(--spacing-xs);\n            font-size: 0.9rem;\n        }\n\n        .form-input,\n        .form-select,\n        .form-textarea {\n            width: 100%;\n            padding: 0.8rem 1rem;\n            border: 1px solid var(--color-sand);\n            border-radius: var(--radius-md);\n            font-family: var(--font-body);\n            font-size: 0.95rem;\n            transition: var(--transition-base);\n            background: var(--color-ivory);\n        }\n\n        .form-input:focus,\n        .form-select:focus,\n        .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-champagne);\n            box-shadow: 0 0 0 3px rgba(201, 168, 108, 0.1);\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1rem;\n            background: var(--gradient-champagne);\n            color: white;\n            border: none;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-champagne);\n        }\n\n        /* Footer */\n        .footer {\n            background: var(--gradient-noir);\n            color: white;\n            padding: var(--spacing-2xl) var(--spacing-lg) var(--spacing-lg);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: var(--spacing-xl);\n            margin-bottom: var(--spacing-xl);\n        }\n\n        .footer-brand h3 {\n            color: white;\n            font-size: 1.5rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-brand p {\n            color: rgba(255, 255, 255, 0.7);\n            font-size: 0.9rem;\n        }\n\n        .footer-links h4 {\n            color: white;\n            font-size: 1rem;\n            margin-bottom: var(--spacing-sm);\n            font-family: var(--font-body);\n        }\n\n        .footer-links ul {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: var(--spacing-xs);\n        }\n\n        .footer-links a {\n            color: rgba(255, 255, 255, 0.7);\n            font-size: 0.9rem;\n            transition: var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-champagne);\n        }\n\n        .footer-bottom {\n            text-align: center;\n            padding-top: var(--spacing-lg);\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n        }\n\n        .footer-bottom p {\n            color: rgba(255, 255, 255, 0.5);\n            font-size: 0.85rem;\n        }\n\n        /* Scroll Animations */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        /* Responsive Design */\n        @media (max-width: 1024px) {\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .problem-solution-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .contact-container {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-content {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-links {\n                display: none;\n            }\n\n            .nav-menu-btn {\n                display: block;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .hero-cta {\n                flex-direction: column;\n            }\n\n            .section {\n                padding: var(--spacing-2xl) var(--spacing-md);\n            }\n        }\n\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Polyana Alves</a>\n            <ul class=\"nav-links\">\n                <li><a href=\"#inicio\">Início</a></li>\n                <li><a href=\"#servicos\">Serviços</a></li>\n                <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                <li><a href=\"#contato\">Contato</a></li>\n            </ul>\n            <a href=\"#contato\" class=\"nav-cta\">Agendar Consulta</a>\n            <button class=\"nav-menu-btn\" id=\"navMenuBtn\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-blobs\">\n            <div class=\"hero-blob hero-blob-1\"></div>\n            <div class=\"hero-blob hero-blob-2\"></div>\n            <div class=\"hero-blob hero-blob-3\"></div>\n            <div class=\"hero-blob hero-blob-4\"></div>\n        </div>\n        <div class=\"hero-content\">\n            <div class=\"hero-badge\">✨ Estética Avançada em Ribeirão Preto</div>\n            <h1>Harmonização Facial com Resultados Naturais</h1>\n            <p class=\"hero-subtitle\">Realce sua beleza única com procedimentos estéticos personalizados. Tecnologia avançada e atendimento humanizado para transformar sua autoestima.</p>\n            <div class=\"hero-cta\">\n                <a href=\"#contato\" class=\"btn-primary\">Agendar Avaliação</a>\n                <a href=\"#servicos\" class=\"btn-secondary\">Conhecer Procedimentos</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\">\n        <div class=\"section-header wow-fade-up\">\n            <span class=\"section-tag\">Transformação Real</span>\n            <h2 class=\"section-title\">Sua Beleza, Potencializada</h2>\n            <p class=\"section-subtitle\">Entendemos suas preocupações e oferecemos soluções que valorizam seus traços naturais</p>\n        </div>\n        <div class=\"problem-solution-grid\">\n            <div class=\"problem-card wow-fade-up\">\n                <div class=\"card-icon\">😔</div>\n                <h3 class=\"card-title\">Desafios Comuns</h3>\n                <p>Questões que afetam sua autoestima e confiança:</p>\n                <ul class=\"card-list\">\n                    <li>Sinais de envelhecimento facial</li>\n                    <li>Perda de contorno e volume</li>\n                    <li>Rugas e linhas de expressão</li>\n                    <li>Assimetrias faciais</li>\n                    <li>Aspecto cansado</li>\n                </ul>\n            </div>\n            <div class=\"solution-card wow-fade-up\">\n                <div class=\"card-icon\">✨</div>\n                <h3 class=\"card-title\">Nossa Solução</h3>\n                <p>Procedimentos personalizados para resultados naturais:</p>\n                <ul class=\"card-list\">\n                    <li>Harmonização facial equilibrada</li>\n                    <li>Restauração de volume e contorno</li>\n                    <li>Suavização de rugas e linhas</li>\n                    <li>Correção de assimetrias</li>\n                    <li>Aspecto descansado e rejuvenescido</li>\n                </ul>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"section-header wow-fade-up\">\n            <span class=\"section-tag\">Procedimentos</span>\n            <h2 class=\"section-title\">Tratamentos Especializados</h2>\n            <p class=\"section-subtitle\">Tecnologia de ponta e técnicas avançadas para resultados excepcionais</p>\n        </div>\n        <div class=\"services-grid\">\n            <div class=\"service-card wow-fade-up\">\n                <div class=\"service-icon\">💉</div>\n                <h3 class=\"service-title\">Harmonização Facial</h3>\n                <p class=\"service-description\">Equilibre seus traços faciais com preenchedores de ácido hialurônico para um resultado natural e harmonioso.</p>\n            </div>\n            <div class=\"service-card wow-fade-up\">\n                <div class=\"service-icon\">🌟</div>\n                <h3 class=\"service-title\">Toxina Botulínica</h3>\n                <p class=\"service-description\">Suavize rugas e linhas de expressão com aplicações estratégicas que preservam sua naturalidade.</p>\n            </div>\n            <div class=\"service-card wow-fade-up\">\n                <div class=\"service-icon\">💋</div>\n                <h3 class=\"service-title\">Preenchimento Labial</h3>\n                <p class=\"service-description\">Destaque seus lábios com volume e contorno personalizado, realçando sua beleza natural.</p>\n            </div>\n            <div class=\"service-card wow-fade-up\">\n                <div class=\"service-icon\">✨</div>\n                <h3 class=\"service-title\">Preenchedores Faciais</h3>\n                <p class=\"service-description\">Restaure volume e contorno facial em áreas como maçãs do rosto, mandíbula e temporas.</p>\n            </div>\n            <div class=\"service-card wow-fade-up\">\n                <div class=\"service-icon\">🔬</div>\n                <h3 class=\"service-title\">Bioestimuladores</h3>\n                <p class=\"service-description\">Estimule o colágeno natural para uma pele mais firme, luminosa e rejuvenescida.</p>\n            </div>\n            <div class=\"service-card wow-fade-up\">\n                <div class=\"service-icon\">💎</div>\n                <h3 class=\"service-title\">Protocolos Exclusivos</h3>\n                <p class=\"service-description\">Tratamentos personalizados combinando técnicas para resultados únicos e naturais.</p>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"section-header wow-fade-up\">\n            <span class=\"section-tag\">Depoimentos</span>\n            <h2 class=\"section-title\">O Que Dizem Nossas Clientes</h2>\n            <p class=\"section-subtitle\">Histórias reais de transformação e satisfação</p>\n        </div>\n        <div class=\"testimonials-grid\">\n            <div class=\"testimonial-card wow-fade-up\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"A Dra. Polyana é maravilhosa! Fez minha harmonização facial com um resultado super natural. Fiquei muito feliz com o procedimento.\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">MC</div>\n                    <div>\n                        <div class=\"testimonial-name\">Maria Clara</div>\n                        <div class=\"testimonial-role\">Empresária</div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"testimonial-card wow-fade-up\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"Excelente profissional! Atendimento impecável desde a primeira consulta. Resultado além das minhas expectativas.\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">AS</div>\n                    <div>\n                        <div class=\"testimonial-name\">Ana Silva</div>\n                        <div class=\"testimonial-role\">Advogada</div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"testimonial-card wow-fade-up\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"Me senti muito segura durante todo o processo. A Dra. Polyana tem mãos de fada e um olhar refinado para estética.\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">JO</div>\n                    <div>\n                        <div class=\"testimonial-name\">Juliana Oliveira</div>\n                        <div class=\"testimonial-role\">Professora</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\">\n        <div class=\"section-header wow-fade-up\">\n            <span class=\"section-tag\">Diferenciais</span>\n            <h2 class=\"section-title\">Por Que Escolher a Dra. Polyana Alves</h2>\n            <p class=\"section-subtitle\">Compromisso com excelência e resultados naturais</p>\n        </div>\n        <div class=\"differentials-grid\">\n            <div class=\"differential-item wow-fade-up\">\n                <div class=\"differential-icon\">🎯</div>\n                <div class=\"differential-content\">\n                    <h4>Atendimento Personalizado</h4>\n                    <p>Cada rosto é único. Procedimentos personalizados de acordo com suas características e objetivos.</p>\n                </div>\n            </div>\n            <div class=\"differential-item wow-fade-up\">\n                <div class=\"differential-icon\">🔬</div>\n                <div class=\"differential-content\">\n                    <h4>Tecnologia Avançada</h4>\n                    <p>Utilizamos produtos de alta qualidade e técnicas modernas para resultados superiores.</p>\n                </div>\n            </div>\n            <div class=\"differential-item wow-fade-up\">\n                <div class=\"differential-icon\">💎</div>\n                <div class=\"differential-content\">\n                    <h4>Resultados Naturais</h4>\n                    <p>Nossa filosofia é realçar sua beleza natural, nunca transformar além do que você é.</p>\n                </div>\n            </div>\n            <div class=\"differential-item wow-fade-up\">\n                <div class=\"differential-icon\">🏥</div>\n                <div class=\"differential-content\">\n                    <h4>Ambiente Seguro</h4>\n                    <p>Clínica equipada seguindo todos os protocolos de segurança e biossegurança.</p>\n                </div>\n            </div>\n            <div class=\"differential-item wow-fade-up\">\n                <div class=\"differential-icon\">📋</div>\n                <div class=\"differential-content\">\n                    <h4>Avaliação Completa</h4>\n                    <p>Análise detalhada antes de qualquer procedimento para garantir as melhores indicações.</p>\n                </div>\n            </div>\n            <div class=\"differential-item wow-fade-up\">\n                <div class=\"differential-icon\">🤝</div>\n                <div class=\"differential-content\">\n                    <h4>Acompanhamento</h4>\n                    <p>Suporte contínuo antes, durante e após os procedimentos para sua tranquilidade.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"section-header wow-fade-up\">\n            <span class=\"section-tag\">Contato</span>\n            <h2 class=\"section-title\">Agende Sua Consulta</h2>\n            <p class=\"section-subtitle\">Entre em contato e transforme sua autoestima hoje mesmo</p>\n        </div>\n        <div class=\"contact-container\">\n            <div class=\"contact-info wow-fade-up\">\n                <h3>Informações de Contato</h3>\n                <p>Estamos prontos para atendê-la e esclarecer todas as dúvidas sobre nossos procedimentos estéticos.</p>\n                <div class=\"contact-details\">\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">📍</div>\n                        <div class=\"contact-item-text\">\n                            <h4>Endereço</h4>\n                            <p>Av. Cel. Fernando Ferreira Leite, 1520<br>Nova Aliança, Ribeirão Preto - SP<br>CEP: 14026-020</p>\n                        </div>\n                    </div>\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">📱</div>\n                        <div class=\"contact-item-text\">\n                            <h4>WhatsApp</h4>\n                            <p>(16) 99740-1577</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"contact-form wow-fade-up\">\n                <form id=\"contactForm\">\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"name\">Nome Completo</label>\n                        <input type=\"text\" id=\"name\" name=\"name\" class=\"form-input\" placeholder=\"Seu nome\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"phone\">Telefone</label>\n                        <input type=\"tel\" id=\"phone\" name=\"phone\" class=\"form-input\" placeholder=\"(00) 00000-0000\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"service\">Procedimento de Interesse</label>\n                        <select id=\"service\" name=\"service\" class=\"form-select\" required>\n                            <option value=\"\">Selecione uma opção</option>\n                            <option value=\"harmonizacao\">Harmonização Facial</option>\n                            <option value=\"botox\">Toxina Botulínica</option>\n                            <option value=\"labial\">Preenchimento Labial</option>\n                            <option value=\"preenchedores\">Preenchedores Faciais</option>\n                            <option value=\"bioestimuladores\">Bioestimuladores</option>\n                            <option value=\"outro\">Outro Procedimento</option>\n                        </select>\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"message\">Mensagem</label>\n                        <textarea id=\"message\" name=\"message\" class=\"form-textarea\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                    </div>\n                    <button type=\"submit\" class=\"form-submit\">Enviar Mensagem</button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-brand\">\n                    <h3>Dra. Polyana Alves</h3>\n                    <p>Harmonização Facial e Estética Avançada em Ribeirão Preto. Transformando vidas através da autoestima.</p>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Links Rápidos</h4>\n                    <ul>\n                        <li><a href=\"#inicio\">Início</a></li>\n                        <li><a href=\"#servicos\">Serviços</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                        <li><a href=\"#contato\">Contato</a></li>\n                    </ul>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Procedimentos</h4>\n                    <ul>\n                        <li><a href=\"#servicos\">Harmonização Facial</a></li>\n                        <li><a href=\"#servicos\">Toxina Botulínica</a></li>\n                        <li><a href=\"#servicos\">Preenchimento Labial</a></li>\n                        <li><a href=\"#servicos\">Bioestimuladores</a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"footer-bottom\">\n                <p>&copy; 2026 Dra. Polyana Alves. Todos os direitos reservados.</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // Navigation scroll effect\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                } else {\n                    nav.classList.remove('hidden');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // Intersection Observer for scroll animations\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('visible');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up').forEach(el => {\n            observer.observe(el);\n        });\n\n        // Form submission to WhatsApp\n        const contactForm = document.getElementById('contactForm');\n        contactForm.addEventListener('submit', function(e) {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service');\n            const serviceText = service.options[service.selectedIndex].text;\n            const message = document.getElementById('message').value;\n\n            const whatsappMessage = `Olá! Meu nome é ${name}.\\nTelefone: ${phone}\\nInteresse: ${serviceText}\\n\\n${message}`;\n            const whatsappUrl = `https://wa.me/5516997401577?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappUrl, '_blank');\n        });\n\n        // Mobile menu toggle\n        const navMenuBtn = document.getElementById('navMenuBtn');\n        const navLinks = document.querySelector('.nav-links');\n\n        navMenuBtn.addEventListener('click', () => {\n            navLinks.style.display = navLinks.style.display === 'flex' ? 'none' : 'flex';\n        });\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"10f89b6f-c004-432d-b5bf-928c5779826d","uuid":"2408d70e-7ff1-43cb-b4ad-ccc28f5f0833"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_7d642c6db3b641ffaf26b5a4","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-polyana-alves/index.html"}]},"parent_tool_use_id":null,"session_id":"10f89b6f-c004-432d-b5bf-928c5779826d","uuid":"f6ba455d-70ed-4516-b0ac-fdfad72cea3c","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-polyana-alves/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Polyana Alves | Harmonização Facial e Estética Avançada em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Polyana Alves - Harmonização Facial e Estética Avançada em Ribeirão Preto. Atendimento especializado com resultados naturais e sofisticados.\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            /* Golden Champagne & Pearl Noir Palette */\n            --color-champagne: #C9A86C;\n            --color-champagne-light: #D9B87C;\n            --color-champagne-mid: #E0C090;\n            --color-champagne-dark: #A88A50;\n            --color-champagne-deep: #886A30;\n\n            --color-pearl: #E8E4DC;\n            --color-pearl-light: #F0ECE4;\n            --color-pearl-dark: #D8D4CC;\n            --color-pearl-mist: #F8F6F2;\n\n            --color-noir: #1A1A1A;\n            --color-noir-charcoal: #2A2A2A;\n            --color-noir-soft: #3A3A3A;\n\n            --color-ivory: #FAFAF8;\n            --color-cream: #F5F3F0;\n            --color-sand: #EDEBE6;\n\n            --color-blush: #E8DCD4;\n            --color-blush-light: #F0E4DC;\n\n            /* Gradients */\n            --gradient-champagne: linear-gradient(135deg, var(--color-champagne) 0%, var(--color-champagne-light) 50%, var(--color-champagne-mid) 100%);\n            --gradient-pearl: linear-gradient(135deg, var(--color-pearl) 0%, var(--color-pearl-light) 100%);\n            --gradient-noir: linear-gradient(145deg, var(--color-noir) 0%, var(--color-noir-charcoal) 100%);\n            --gradient-warm: linear-gradient(180deg, var(--color-ivory) 0%, var(--color-cream) 100%);\n            --gradient-luxe: linear-gradient(145deg, var(--color-champagne-deep) 0%, var(--color-champagne) 30%, var(--color-pearl-light) 70%, var(--color-ivory) 100%);\n\n            /* Typography */\n            --font-display: 'Cormorant Garamond', Georgia, serif;\n            --font-body: 'Plus Jakarta Sans', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 1.5rem;\n            --spacing-lg: 2rem;\n            --spacing-xl: 3rem;\n            --spacing-2xl: 4rem;\n            --spacing-3xl: 6rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 12px;\n            --radius-lg: 20px;\n            --radius-xl: 30px;\n            --radius-ellipse-1: 70% 30% 50% 50% / 50% 50% 70% 30%;\n            --radius-ellipse-2: 50% 50% 70% 30% / 30% 70% 50% 50%;\n            --radius-ellipse-3: 60% 40% 40% 60% / 40% 60% 60% 40%;\n            --radius-ellipse-4: 40% 60% 60% 40% / 60% 40% 40% 60%;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.3s ease;\n            --transition-slow: 0.5s ease;\n\n            /* Shadows */\n            --shadow-sm: 0 2px 8px rgba(201, 168, 108, 0.08);\n            --shadow-md: 0 4px 16px rgba(201, 168, 108, 0.12);\n            --shadow-lg: 0 8px 32px rgba(201, 168, 108, 0.16);\n            --shadow-champagne: 0 4px 20px rgba(201, 168, 108, 0.25);\n            --shadow-pearl: 0 4px 20px rgba(232, 228, 220, 0.4);\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background: var(--gradient-warm);\n            color: var(--color-noir);\n            line-height: 1.6;\n            overflow-x: hidden;\n        }\n\n        /* Typography */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-noir);\n        }\n\n        h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); }\n        h2 { font-size: clamp(2rem, 4vw, 3rem); }\n        h3 { font-size: clamp(1.25rem, 2.5vw, 1.75rem); }\n\n        p {\n            font-size: clamp(0.95rem, 1.2vw, 1.1rem);\n            color: var(--color-noir-soft);\n            opacity: 0.9;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* Navigation */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-md) var(--spacing-lg);\n            background: rgba(250, 250, 248, 0.95);\n            backdrop-filter: blur(10px);\n            border-bottom: 1px solid rgba(201, 168, 108, 0.15);\n            transition: transform 0.3s ease, padding 0.3s ease;\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-champagne-dark);\n        }\n\n        .nav-links {\n            display: flex;\n            gap: var(--spacing-lg);\n            list-style: none;\n        }\n\n        .nav-links a {\n            font-weight: 500;\n            font-size: 0.95rem;\n            color: var(--color-noir);\n            position: relative;\n        }\n\n        .nav-links a::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-champagne);\n            transition: width var(--transition-base);\n        }\n\n        .nav-links a:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.6rem 1.4rem;\n            background: var(--gradient-champagne);\n            color: white;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            transition: var(--transition-base);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-champagne);\n        }\n\n        .nav-menu-btn {\n            display: none;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: var(--spacing-xs);\n        }\n\n        .nav-menu-btn span {\n            display: block;\n            width: 24px;\n            height: 2px;\n            background: var(--color-champagne-dark);\n            margin: 4px 0;\n            transition: var(--transition-base);\n        }\n\n        /* Hero Section */\n        .hero {\n            position: relative;\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-xl);\n            overflow: hidden;\n        }\n\n        .hero-blobs {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            top: 0;\n            left: 0;\n            pointer-events: none;\n            z-index: 0;\n        }\n\n        .hero-blob {\n            position: absolute;\n            opacity: 0.12;\n            animation: blob-float 20s ease-in-out infinite;\n        }\n\n        .hero-blob-1 {\n            width: 500px;\n            height: 500px;\n            top: -150px;\n            right: -100px;\n            background: var(--gradient-champagne);\n            border-radius: var(--radius-ellipse-1);\n            animation-delay: 0s;\n        }\n\n        .hero-blob-2 {\n            width: 400px;\n            height: 400px;\n            bottom: -100px;\n            left: -50px;\n            background: var(--gradient-pearl);\n            border-radius: var(--radius-ellipse-2);\n            animation-delay: -5s;\n        }\n\n        .hero-blob-3 {\n            width: 300px;\n            height: 300px;\n            top: 50%;\n            left: 10%;\n            background: linear-gradient(135deg, var(--color-blush) 0%, var(--color-pearl-light) 100%);\n            border-radius: var(--radius-ellipse-3);\n            animation-delay: -10s;\n            opacity: 0.08;\n        }\n\n        .hero-blob-4 {\n            width: 350px;\n            height: 350px;\n            bottom: 20%;\n            right: 15%;\n            background: linear-gradient(135deg, var(--color-champagne-light) 0%, var(--color-blush-light) 100%);\n            border-radius: var(--radius-ellipse-4);\n            animation-delay: -15s;\n            opacity: 0.1;\n        }\n\n        @keyframes blob-float {\n            0%, 100% {\n                transform: translate(0, 0) scale(1) rotate(0deg);\n            }\n            25% {\n                transform: translate(20px, -30px) scale(1.05) rotate(3deg);\n            }\n            50% {\n                transform: translate(-15px, 20px) scale(0.95) rotate(-3deg);\n            }\n            75% {\n                transform: translate(25px, 15px) scale(1.02) rotate(2deg);\n            }\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 1;\n            max-width: 900px;\n            text-align: center;\n        }\n\n        .hero-badge {\n            display: inline-block;\n            padding: 0.5rem 1.2rem;\n            background: var(--gradient-pearl);\n            color: var(--color-champagne-dark);\n            border-radius: 50px;\n            font-size: 0.85rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-md);\n            animation: fade-in-up 0.8s ease forwards;\n            animation-delay: 0ms;\n            opacity: 0;\n        }\n\n        .hero h1 {\n            margin-bottom: var(--spacing-md);\n            animation: fade-in-up 0.8s ease forwards;\n            animation-delay: 200ms;\n            opacity: 0;\n        }\n\n        .hero-subtitle {\n            font-size: clamp(1.1rem, 2vw, 1.35rem);\n            color: var(--color-noir-soft);\n            margin-bottom: var(--spacing-lg);\n            max-width: 700px;\n            margin-left: auto;\n            margin-right: auto;\n            animation: fade-in-up 0.8s ease forwards;\n            animation-delay: 400ms;\n            opacity: 0;\n        }\n\n        .hero-cta {\n            display: inline-flex;\n            gap: var(--spacing-md);\n            animation: fade-in-up 0.8s ease forwards;\n            animation-delay: 600ms;\n            opacity: 0;\n        }\n\n        .btn-primary {\n            padding: 1rem 2rem;\n            background: var(--gradient-champagne);\n            color: white;\n            border: none;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-champagne);\n        }\n\n        .btn-secondary {\n            padding: 1rem 2rem;\n            background: transparent;\n            color: var(--color-champagne-dark);\n            border: 2px solid var(--color-champagne);\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-champagne);\n            color: white;\n        }\n\n        @keyframes fade-in-up {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        /* Section Styles */\n        .section {\n            padding: var(--spacing-3xl) var(--spacing-lg);\n            position: relative;\n        }\n\n        .section-header {\n            text-align: center;\n            max-width: 700px;\n            margin: 0 auto var(--spacing-2xl);\n        }\n\n        .section-tag {\n            display: inline-block;\n            padding: 0.4rem 1rem;\n            background: var(--gradient-pearl);\n            color: var(--color-champagne-dark);\n            border-radius: 50px;\n            font-size: 0.8rem;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .section-title {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .section-subtitle {\n            font-size: 1.05rem;\n            color: var(--color-noir-soft);\n        }\n\n        /* Problem/Solution Section */\n        .problem-solution {\n            background: var(--color-ivory);\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-xl);\n            max-width: 1100px;\n            margin: 0 auto;\n        }\n\n        .problem-card, .solution-card {\n            background: white;\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            position: relative;\n            overflow: hidden;\n            transition: var(--transition-base);\n        }\n\n        .problem-card::before {\n            content: '';\n            position: absolute;\n            left: 0;\n            top: 0;\n            bottom: 0;\n            width: 4px;\n            background: linear-gradient(180deg, var(--color-noir) 0%, var(--color-noir-soft) 100%);\n        }\n\n        .solution-card::before {\n            content: '';\n            position: absolute;\n            left: 0;\n            top: 0;\n            bottom: 0;\n            width: 4px;\n            background: var(--gradient-champagne);\n        }\n\n        .problem-card:hover, .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-md);\n        }\n\n        .card-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-pearl);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-md);\n            font-size: 1.5rem;\n        }\n\n        .solution-card .card-icon {\n            background: var(--gradient-champagne);\n        }\n\n        .card-title {\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.4rem;\n        }\n\n        .card-list {\n            list-style: none;\n            margin-top: var(--spacing-md);\n        }\n\n        .card-list li {\n            padding: var(--spacing-xs) 0;\n            padding-left: 1.5rem;\n            position: relative;\n            font-size: 0.95rem;\n            color: var(--color-noir-soft);\n        }\n\n        .card-list li::before {\n            content: '•';\n            position: absolute;\n            left: 0;\n            color: var(--color-champagne);\n            font-weight: bold;\n        }\n\n        /* Services Section */\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .service-card {\n            background: white;\n            padding: var(--spacing-lg);\n            border-radius: var(--radius-lg);\n            text-align: center;\n            transition: var(--transition-base);\n            border: 1px solid rgba(201, 168, 108, 0.1);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-champagne);\n            transform: scaleX(0);\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-lg);\n        }\n\n        .service-icon {\n            width: 70px;\n            height: 70px;\n            margin: 0 auto var(--spacing-md);\n            background: var(--gradient-pearl);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 2rem;\n        }\n\n        .service-title {\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.3rem;\n        }\n\n        .service-description {\n            font-size: 0.95rem;\n            color: var(--color-noir-soft);\n        }\n\n        /* Testimonials Section */\n        .testimonials {\n            background: var(--gradient-noir);\n            color: white;\n        }\n\n        .testimonials .section-title,\n        .testimonials .section-subtitle {\n            color: white;\n        }\n\n        .testimonials .section-subtitle {\n            opacity: 0.8;\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(10px);\n            padding: var(--spacing-lg);\n            border-radius: var(--radius-lg);\n            border: 1px solid rgba(201, 168, 108, 0.2);\n        }\n\n        .testimonial-stars {\n            color: var(--color-champagne);\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.1rem;\n        }\n\n        .testimonial-text {\n            color: rgba(255, 255, 255, 0.9);\n            font-style: italic;\n            margin-bottom: var(--spacing-md);\n            font-size: 0.95rem;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 45px;\n            height: 45px;\n            border-radius: 50%;\n            background: var(--gradient-champagne);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: white;\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n            font-size: 0.95rem;\n        }\n\n        .testimonial-role {\n            font-size: 0.85rem;\n            opacity: 0.7;\n        }\n\n        /* Differentials Section */\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .differential-item {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-md);\n            padding: var(--spacing-md);\n            border-radius: var(--radius-md);\n            transition: var(--transition-base);\n        }\n\n        .differential-item:hover {\n            background: white;\n            box-shadow: var(--shadow-sm);\n        }\n\n        .differential-icon {\n            width: 55px;\n            height: 55px;\n            min-width: 55px;\n            background: var(--gradient-pearl);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.5rem;\n            position: relative;\n        }\n\n        .differential-icon::after {\n            content: '';\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            border-radius: var(--radius-md);\n            border: 2px solid var(--color-champagne);\n            opacity: 0;\n            animation: pulse-ring 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse-ring {\n            0% {\n                transform: scale(1);\n                opacity: 0.5;\n            }\n            100% {\n                transform: scale(1.3);\n                opacity: 0;\n            }\n        }\n\n        .differential-content h4 {\n            font-size: 1.1rem;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        .differential-content p {\n            font-size: 0.9rem;\n        }\n\n        /* Contact Section */\n        .contact {\n            background: var(--color-ivory);\n        }\n\n        .contact-container {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-2xl);\n            max-width: 1100px;\n            margin: 0 auto;\n        }\n\n        .contact-info {\n            padding: var(--spacing-lg);\n        }\n\n        .contact-info h3 {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-info p {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-details {\n            margin-top: var(--spacing-lg);\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n            margin-bottom: var(--spacing-md);\n            padding: var(--spacing-sm);\n            background: white;\n            border-radius: var(--radius-md);\n            transition: var(--transition-base);\n        }\n\n        .contact-item:hover {\n            box-shadow: var(--shadow-sm);\n        }\n\n        .contact-item-icon {\n            width: 40px;\n            height: 40px;\n            background: var(--gradient-pearl);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.2rem;\n        }\n\n        .contact-item-text h4 {\n            font-size: 0.9rem;\n            font-weight: 600;\n        }\n\n        .contact-item-text p {\n            font-size: 0.85rem;\n            margin: 0;\n        }\n\n        .contact-form {\n            background: white;\n            padding: var(--spacing-xl);\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-md);\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-label {\n            display: block;\n            font-weight: 500;\n            margin-bottom: var(--spacing-xs);\n            font-size: 0.9rem;\n        }\n\n        .form-input,\n        .form-select,\n        .form-textarea {\n            width: 100%;\n            padding: 0.8rem 1rem;\n            border: 1px solid var(--color-sand);\n            border-radius: var(--radius-md);\n            font-family: var(--font-body);\n            font-size: 0.95rem;\n            transition: var(--transition-base);\n            background: var(--color-ivory);\n        }\n\n        .form-input:focus,\n        .form-select:focus,\n        .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-champagne);\n            box-shadow: 0 0 0 3px rgba(201, 168, 108, 0.1);\n        }\n\n        .form-textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1rem;\n            background: var(--gradient-champagne);\n            color: white;\n            border: none;\n            border-radius: var(--radius-md);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-champagne);\n        }\n\n        /* Footer */\n        .footer {\n            background: var(--gradient-noir);\n            color: white;\n            padding: var(--spacing-2xl) var(--spacing-lg) var(--spacing-lg);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: var(--spacing-xl);\n            margin-bottom: var(--spacing-xl);\n        }\n\n        .footer-brand h3 {\n            color: white;\n            font-size: 1.5rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-brand p {\n            color: rgba(255, 255, 255, 0.7);\n            font-size: 0.9rem;\n        }\n\n        .footer-links h4 {\n            color: white;\n            font-size: 1rem;\n            margin-bottom: var(--spacing-sm);\n            font-family: var(--font-body);\n        }\n\n        .footer-links ul {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: var(--spacing-xs);\n        }\n\n        .footer-links a {\n            color: rgba(255, 255, 255, 0.7);\n            font-size: 0.9rem;\n            transition: var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-champagne);\n        }\n\n        .footer-bottom {\n            text-align: center;\n            padding-top: var(--spacing-lg);\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n        }\n\n        .footer-bottom p {\n            color: rgba(255, 255, 255, 0.5);\n            font-size: 0.85rem;\n        }\n\n        /* Scroll Animations */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.6s ease, transform 0.6s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        /* Responsive Design */\n        @media (max-width: 1024px) {\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .problem-solution-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .contact-container {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-content {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-links {\n                display: none;\n            }\n\n            .nav-menu-btn {\n                display: block;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .hero-cta {\n                flex-direction: column;\n            }\n\n            .section {\n                padding: var(--spacing-2xl) var(--spacing-md);\n            }\n        }\n\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Polyana Alves</a>\n            <ul class=\"nav-links\">\n                <li><a href=\"#inicio\">Início</a></li>\n                <li><a href=\"#servicos\">Serviços</a></li>\n                <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                <li><a href=\"#contato\">Contato</a></li>\n            </ul>\n            <a href=\"#contato\" class=\"nav-cta\">Agendar Consulta</a>\n            <button class=\"nav-menu-btn\" id=\"navMenuBtn\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-blobs\">\n            <div class=\"hero-blob hero-blob-1\"></div>\n            <div class=\"hero-blob hero-blob-2\"></div>\n            <div class=\"hero-blob hero-blob-3\"></div>\n            <div class=\"hero-blob hero-blob-4\"></div>\n        </div>\n        <div class=\"hero-content\">\n            <div class=\"hero-badge\">✨ Estética Avançada em Ribeirão Preto</div>\n            <h1>Harmonização Facial com Resultados Naturais</h1>\n            <p class=\"hero-subtitle\">Realce sua beleza única com procedimentos estéticos personalizados. Tecnologia avançada e atendimento humanizado para transformar sua autoestima.</p>\n            <div class=\"hero-cta\">\n                <a href=\"#contato\" class=\"btn-primary\">Agendar Avaliação</a>\n                <a href=\"#servicos\" class=\"btn-secondary\">Conhecer Procedimentos</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\">\n        <div class=\"section-header wow-fade-up\">\n            <span class=\"section-tag\">Transformação Real</span>\n            <h2 class=\"section-title\">Sua Beleza, Potencializada</h2>\n            <p class=\"section-subtitle\">Entendemos suas preocupações e oferecemos soluções que valorizam seus traços naturais</p>\n        </div>\n        <div class=\"problem-solution-grid\">\n            <div class=\"problem-card wow-fade-up\">\n                <div class=\"card-icon\">😔</div>\n                <h3 class=\"card-title\">Desafios Comuns</h3>\n                <p>Questões que afetam sua autoestima e confiança:</p>\n                <ul class=\"card-list\">\n                    <li>Sinais de envelhecimento facial</li>\n                    <li>Perda de contorno e volume</li>\n                    <li>Rugas e linhas de expressão</li>\n                    <li>Assimetrias faciais</li>\n                    <li>Aspecto cansado</li>\n                </ul>\n            </div>\n            <div class=\"solution-card wow-fade-up\">\n                <div class=\"card-icon\">✨</div>\n                <h3 class=\"card-title\">Nossa Solução</h3>\n                <p>Procedimentos personalizados para resultados naturais:</p>\n                <ul class=\"card-list\">\n                    <li>Harmonização facial equilibrada</li>\n                    <li>Restauração de volume e contorno</li>\n                    <li>Suavização de rugas e linhas</li>\n                    <li>Correção de assimetrias</li>\n                    <li>Aspecto descansado e rejuvenescido</li>\n                </ul>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"section-header wow-fade-up\">\n            <span class=\"section-tag\">Procedimentos</span>\n            <h2 class=\"section-title\">Tratamentos Especializados</h2>\n            <p class=\"section-subtitle\">Tecnologia de ponta e técnicas avançadas para resultados excepcionais</p>\n        </div>\n        <div class=\"services-grid\">\n            <div class=\"service-card wow-fade-up\">\n                <div class=\"service-icon\">💉</div>\n                <h3 class=\"service-title\">Harmonização Facial</h3>\n                <p class=\"service-description\">Equilibre seus traços faciais com preenchedores de ácido hialurônico para um resultado natural e harmonioso.</p>\n            </div>\n            <div class=\"service-card wow-fade-up\">\n                <div class=\"service-icon\">🌟</div>\n                <h3 class=\"service-title\">Toxina Botulínica</h3>\n                <p class=\"service-description\">Suavize rugas e linhas de expressão com aplicações estratégicas que preservam sua naturalidade.</p>\n            </div>\n            <div class=\"service-card wow-fade-up\">\n                <div class=\"service-icon\">💋</div>\n                <h3 class=\"service-title\">Preenchimento Labial</h3>\n                <p class=\"service-description\">Destaque seus lábios com volume e contorno personalizado, realçando sua beleza natural.</p>\n            </div>\n            <div class=\"service-card wow-fade-up\">\n                <div class=\"service-icon\">✨</div>\n                <h3 class=\"service-title\">Preenchedores Faciais</h3>\n                <p class=\"service-description\">Restaure volume e contorno facial em áreas como maçãs do rosto, mandíbula e temporas.</p>\n            </div>\n            <div class=\"service-card wow-fade-up\">\n                <div class=\"service-icon\">🔬</div>\n                <h3 class=\"service-title\">Bioestimuladores</h3>\n                <p class=\"service-description\">Estimule o colágeno natural para uma pele mais firme, luminosa e rejuvenescida.</p>\n            </div>\n            <div class=\"service-card wow-fade-up\">\n                <div class=\"service-icon\">💎</div>\n                <h3 class=\"service-title\">Protocolos Exclusivos</h3>\n                <p class=\"service-description\">Tratamentos personalizados combinando técnicas para resultados únicos e naturais.</p>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"section-header wow-fade-up\">\n            <span class=\"section-tag\">Depoimentos</span>\n            <h2 class=\"section-title\">O Que Dizem Nossas Clientes</h2>\n            <p class=\"section-subtitle\">Histórias reais de transformação e satisfação</p>\n        </div>\n        <div class=\"testimonials-grid\">\n            <div class=\"testimonial-card wow-fade-up\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"A Dra. Polyana é maravilhosa! Fez minha harmonização facial com um resultado super natural. Fiquei muito feliz com o procedimento.\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">MC</div>\n                    <div>\n                        <div class=\"testimonial-name\">Maria Clara</div>\n                        <div class=\"testimonial-role\">Empresária</div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"testimonial-card wow-fade-up\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"Excelente profissional! Atendimento impecável desde a primeira consulta. Resultado além das minhas expectativas.\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">AS</div>\n                    <div>\n                        <div class=\"testimonial-name\">Ana Silva</div>\n                        <div class=\"testimonial-role\">Advogada</div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"testimonial-card wow-fade-up\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"Me senti muito segura durante todo o processo. A Dra. Polyana tem mãos de fada e um olhar refinado para estética.\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">JO</div>\n                    <div>\n                        <div class=\"testimonial-name\">Juliana Oliveira</div>\n                        <div class=\"testimonial-role\">Professora</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\">\n        <div class=\"section-header wow-fade-up\">\n            <span class=\"section-tag\">Diferenciais</span>\n            <h2 class=\"section-title\">Por Que Escolher a Dra. Polyana Alves</h2>\n            <p class=\"section-subtitle\">Compromisso com excelência e resultados naturais</p>\n        </div>\n        <div class=\"differentials-grid\">\n            <div class=\"differential-item wow-fade-up\">\n                <div class=\"differential-icon\">🎯</div>\n                <div class=\"differential-content\">\n                    <h4>Atendimento Personalizado</h4>\n                    <p>Cada rosto é único. Procedimentos personalizados de acordo com suas características e objetivos.</p>\n                </div>\n            </div>\n            <div class=\"differential-item wow-fade-up\">\n                <div class=\"differential-icon\">🔬</div>\n                <div class=\"differential-content\">\n                    <h4>Tecnologia Avançada</h4>\n                    <p>Utilizamos produtos de alta qualidade e técnicas modernas para resultados superiores.</p>\n                </div>\n            </div>\n            <div class=\"differential-item wow-fade-up\">\n                <div class=\"differential-icon\">💎</div>\n                <div class=\"differential-content\">\n                    <h4>Resultados Naturais</h4>\n                    <p>Nossa filosofia é realçar sua beleza natural, nunca transformar além do que você é.</p>\n                </div>\n            </div>\n            <div class=\"differential-item wow-fade-up\">\n                <div class=\"differential-icon\">🏥</div>\n                <div class=\"differential-content\">\n                    <h4>Ambiente Seguro</h4>\n                    <p>Clínica equipada seguindo todos os protocolos de segurança e biossegurança.</p>\n                </div>\n            </div>\n            <div class=\"differential-item wow-fade-up\">\n                <div class=\"differential-icon\">📋</div>\n                <div class=\"differential-content\">\n                    <h4>Avaliação Completa</h4>\n                    <p>Análise detalhada antes de qualquer procedimento para garantir as melhores indicações.</p>\n                </div>\n            </div>\n            <div class=\"differential-item wow-fade-up\">\n                <div class=\"differential-icon\">🤝</div>\n                <div class=\"differential-content\">\n                    <h4>Acompanhamento</h4>\n                    <p>Suporte contínuo antes, durante e após os procedimentos para sua tranquilidade.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"section-header wow-fade-up\">\n            <span class=\"section-tag\">Contato</span>\n            <h2 class=\"section-title\">Agende Sua Consulta</h2>\n            <p class=\"section-subtitle\">Entre em contato e transforme sua autoestima hoje mesmo</p>\n        </div>\n        <div class=\"contact-container\">\n            <div class=\"contact-info wow-fade-up\">\n                <h3>Informações de Contato</h3>\n                <p>Estamos prontos para atendê-la e esclarecer todas as dúvidas sobre nossos procedimentos estéticos.</p>\n                <div class=\"contact-details\">\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">📍</div>\n                        <div class=\"contact-item-text\">\n                            <h4>Endereço</h4>\n                            <p>Av. Cel. Fernando Ferreira Leite, 1520<br>Nova Aliança, Ribeirão Preto - SP<br>CEP: 14026-020</p>\n                        </div>\n                    </div>\n                    <div class=\"contact-item\">\n                        <div class=\"contact-item-icon\">📱</div>\n                        <div class=\"contact-item-text\">\n                            <h4>WhatsApp</h4>\n                            <p>(16) 99740-1577</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"contact-form wow-fade-up\">\n                <form id=\"contactForm\">\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"name\">Nome Completo</label>\n                        <input type=\"text\" id=\"name\" name=\"name\" class=\"form-input\" placeholder=\"Seu nome\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"phone\">Telefone</label>\n                        <input type=\"tel\" id=\"phone\" name=\"phone\" class=\"form-input\" placeholder=\"(00) 00000-0000\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"service\">Procedimento de Interesse</label>\n                        <select id=\"service\" name=\"service\" class=\"form-select\" required>\n                            <option value=\"\">Selecione uma opção</option>\n                            <option value=\"harmonizacao\">Harmonização Facial</option>\n                            <option value=\"botox\">Toxina Botulínica</option>\n                            <option value=\"labial\">Preenchimento Labial</option>\n                            <option value=\"preenchedores\">Preenchedores Faciais</option>\n                            <option value=\"bioestimuladores\">Bioestimuladores</option>\n                            <option value=\"outro\">Outro Procedimento</option>\n                        </select>\n                    </div>\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" for=\"message\">Mensagem</label>\n                        <textarea id=\"message\" name=\"message\" class=\"form-textarea\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                    </div>\n                    <button type=\"submit\" class=\"form-submit\">Enviar Mensagem</button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-brand\">\n                    <h3>Dra. Polyana Alves</h3>\n                    <p>Harmonização Facial e Estética Avançada em Ribeirão Preto. Transformando vidas através da autoestima.</p>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Links Rápidos</h4>\n                    <ul>\n                        <li><a href=\"#inicio\">Início</a></li>\n                        <li><a href=\"#servicos\">Serviços</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                        <li><a href=\"#contato\">Contato</a></li>\n                    </ul>\n                </div>\n                <div class=\"footer-links\">\n                    <h4>Procedimentos</h4>\n                    <ul>\n                        <li><a href=\"#servicos\">Harmonização Facial</a></li>\n                        <li><a href=\"#servicos\">Toxina Botulínica</a></li>\n                        <li><a href=\"#servicos\">Preenchimento Labial</a></li>\n                        <li><a href=\"#servicos\">Bioestimuladores</a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"footer-bottom\">\n                <p>&copy; 2026 Dra. Polyana Alves. Todos os direitos reservados.</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // Navigation scroll effect\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                } else {\n                    nav.classList.remove('hidden');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // Intersection Observer for scroll animations\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('visible');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up').forEach(el => {\n            observer.observe(el);\n        });\n\n        // Form submission to WhatsApp\n        const contactForm = document.getElementById('contactForm');\n        contactForm.addEventListener('submit', function(e) {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service');\n            const serviceText = service.options[service.selectedIndex].text;\n            const message = document.getElementById('message').value;\n\n            const whatsappMessage = `Olá! Meu nome é ${name}.\\nTelefone: ${phone}\\nInteresse: ${serviceText}\\n\\n${message}`;\n            const whatsappUrl = `https://wa.me/5516997401577?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappUrl, '_blank');\n        });\n\n        // Mobile menu toggle\n        const navMenuBtn = document.getElementById('navMenuBtn');\n        const navLinks = document.querySelector('.nav-links');\n\n        navMenuBtn.addEventListener('click', () => {\n            navLinks.style.display = navLinks.style.display === 'flex' ? 'none' : 'flex';\n        });\n    </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null}}
