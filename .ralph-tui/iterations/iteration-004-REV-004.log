ric [ref=e101]:\n      - generic [ref=e102]:\n        - img [ref=e103]\n        - text: Nossos Serviços\n      - heading \"Cuidado Completo para seu Pet\" [level=2] [ref=e105]\n      - paragraph [ref=e106]: Oferecemos uma gama completa de serviços veterinários para todas as necessidades do seu animalzinho.\n    - generic [ref=e107]:\n      - generic [ref=e108]:\n        - img [ref=e110]\n        - heading \"Emergências 24h\" [level=3] [ref=e112]\n        - paragraph [ref=e113]: Atendimento de urgência disponível a qualquer hora, todos os dias. Seu pet nunca ficará sem cuidado quando precisar.\n        - link \"Saiba mais\" [ref=e114] [cursor=pointer]:\n          - /url: \"#contato\"\n          - text: Saiba mais\n          - img [ref=e115]\n      - generic [ref=e117]:\n        - img [ref=e119]\n        - heading \"Consultas Clínicas\" [level=3] [ref=e122]\n        - paragraph [ref=e123]: Avaliação completa da saúde do seu pet com veterinários experientes e dedicados ao bem-estar animal.\n        - link \"Saiba mais\" [ref=e124] [cursor=pointer]:\n          - /url: \"#contato\"\n          - text: Saiba mais\n          - img [ref=e125]\n      - generic [ref=e127]:\n        - img [ref=e129]\n        - heading \"Cirurgias\" [level=3] [ref=e132]\n        - paragraph [ref=e133]: Procedimentos cirúrgicos seguros com equipamentos modernos e anestesistas dedicados.\n        - link \"Saiba mais\" [ref=e134] [cursor=pointer]:\n          - /url: \"#contato\"\n          - text: Saiba mais\n          - img [ref=e135]\n      - generic [ref=e137]:\n        - img [ref=e139]\n        - heading \"Exames Laboratoriais\" [level=3] [ref=e141]\n        - paragraph [ref=e142]: Laboratório completo para análises clínicas rápidas e precisas, sem necessidade de deslocamento.\n        - link \"Saiba mais\" [ref=e143] [cursor=pointer]:\n          - /url: \"#contato\"\n          - text: Saiba mais\n          - img [ref=e144]\n      - generic [ref=e146]:\n        - img [ref=e148]\n        - heading \"Diagnóstico por Imagem\" [level=3] [ref=e151]\n        - paragraph [ref=e152]: Raio-X digital e ultrassonografia para diagnósticos precisos e rápidos na própria clínica.\n        - link \"Saiba mais\" [ref=e153] [cursor=pointer]:\n          - /url: \"#contato\"\n          - text: Saiba mais\n          - img [ref=e154]\n      - generic [ref=e156]:\n        - img [ref=e158]\n        - heading \"Vacinação e Prevenção\" [level=3] [ref=e160]\n        - paragraph [ref=e161]: Programa completo de vacinação e preventivos para proteger seu pet contra doenças e parasitas.\n        - link \"Saiba mais\" [ref=e162] [cursor=pointer]:\n          - /url: \"#contato\"\n          - text: Saiba mais\n          - img [ref=e163]\n  - generic [ref=e169]:\n    - generic [ref=e170]:\n      - generic [ref=e171]:\n        - img [ref=e172]\n        - text: Depoimentos\n      - heading \"O Que Dizem Sobre Nós\" [level=2] [ref=e174]\n      - paragraph [ref=e175]: A satisfação dos nossos clientes e seus pets é o nosso maior compromisso.\n    - generic [ref=e176]:\n      - generic [ref=e177]:\n        - generic [ref=e178]:\n          - img [ref=e179]\n          - img [ref=e181]\n          - img [ref=e183]\n          - img [ref=e185]\n          - img [ref=e187]\n        - paragraph [ref=e189]: \"\\\"Atendimento excepcional! O Dr. Pedro salvou a vida do meu Max durante uma emergência à noite. Gratidão eterna à equipe da Soer.\\\"\"\n        - generic [ref=e190]:\n          - img \"Maria Silva\" [ref=e191]\n          - generic [ref=e192]:\n            - heading \"Maria Silva\" [level=4] [ref=e193]\n            - paragraph [ref=e194]: Tutora do Max (Golden)\n      - generic [ref=e195]:\n        - generic [ref=e196]:\n          - img [ref=e197]\n          - img [ref=e199]\n          - img [ref=e201]\n          - img [ref=e203]\n          - img [ref=e205]\n        - paragraph [ref=e207]: \"\\\"Levo meus três gatos há 5 anos. A atenção e carinho com que tratam cada um é incrível. Recomendo de olho