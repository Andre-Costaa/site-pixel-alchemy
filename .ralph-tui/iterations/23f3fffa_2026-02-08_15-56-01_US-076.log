{"type":"assistant","message":{"id":"msg_20260209030115678b8d7f205f4c1c","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_c2eb52907db94dafb925baf0","name":"Write","input":{"file_path":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-brenda-dick-harmonizacao-facial-e-odontologia-especializ/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Brenda Dick | Harmonização Facial e Odontologia Especializada em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Brenda Dick - Odontologia especializada e harmonização facial em Ribeirão Preto. Atendimento personalizado com técnicas modernas de odontologia estética.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           CSS VARIABLES - Bronze & Celadon Noir\n           ============================================ */\n        :root {\n            /* Primary Palette - Bronze Metallic */\n            --color-bronze: #B8874A;\n            --color-bronze-light: #D4A868;\n            --color-bronze-mid: #C89855;\n            --color-bronze-dark: #A0783A;\n            --color-bronze-deep: #886028;\n            --color-bronze-shimmer: #E0C090;\n\n            /* Accent Palette - Celadon Ceramic */\n            --color-celadon: #7AA892;\n            --color-celadon-light: #98C0AA;\n            --color-celadon-dark: #629878;\n            --color-celadon-deep: #4A7860;\n            --color-celadon-mist: #D0E8E0;\n            --color-celadon-pale: #E8F0EC;\n\n            /* Dark Palette - Soft Noir */\n            --color-noir: #1A1A1A;\n            --color-noir-charcoal: #2A2A2A;\n            --color-noir-deep: #0F0F12;\n\n            /* Warmth Accent - Ivory */\n            --color-ivory: #FAFAF6;\n            --color-ivory-warm: #F5F5F0;\n            --color-cream: #F0ECE8;\n\n            /* Text Colors */\n            --color-text-primary: #1A1A1A;\n            --color-text-secondary: #4A4A4A;\n            --color-text-muted: #7A7A7A;\n            --color-text-on-dark: #F5F5F0;\n\n            /* Gradients */\n            --gradient-bronze: linear-gradient(135deg, var(--color-bronze) 0%, var(--color-bronze-light) 100%);\n            --gradient-celadon: linear-gradient(135deg, var(--color-celadon) 0%, var(--color-celadon-light) 100%);\n            --gradient-noir: linear-gradient(135deg, var(--color-noir) 0%, var(--color-noir-charcoal) 100%);\n            --gradient-hero: linear-gradient(135deg, #FAFAF6 0%, #F0ECE8 50%, #E8E4E0 100%);\n            --gradient-bronze-celadon: linear-gradient(135deg, var(--color-bronze) 0%, var(--color-celadon) 100%);\n\n            /* Ceramic Curve Border Radius Shapes */\n            --radius-curve-1: 72% 28% 48% 52% / 52% 38% 62% 48%;\n            --radius-curve-2: 48% 52% 68% 32% / 38% 62% 38% 62%;\n            --radius-curve-3: 62% 38% 42% 58% / 58% 42% 52% 48%;\n            --radius-curve-4: 38% 62% 52% 48% / 42% 58% 48% 52%;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Typography */\n            --font-display: 'Playfair Display', Georgia, serif;\n            --font-body: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(26, 26, 26, 0.08);\n            --shadow-medium: 0 8px 30px rgba(26, 26, 26, 0.12);\n            --shadow-strong: 0 12px 40px rgba(26, 26, 26, 0.16);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.7;\n            color: var(--color-text-primary);\n            background: var(--color-ivory);\n            overflow-x: hidden;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-noir);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-secondary);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-sm) var(--spacing-md);\n            background: rgba(250, 250, 246, 0.95);\n            backdrop-filter: blur(20px);\n            transition: transform 0.3s ease;\n            box-shadow: 0 2px 20px rgba(26, 26, 26, 0.06);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-noir);\n            text-decoration: none;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-secondary);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-bronze-celadon);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover {\n            color: var(--color-noir);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--gradient-bronze);\n            color: white !important;\n            padding: 0.75rem 1.5rem;\n            border-radius: 50px;\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 8px 20px rgba(184, 135, 74, 0.3);\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-noir);\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-curve-1);\n            opacity: 0.15;\n            filter: blur(60px);\n            animation: float 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-bronze);\n            top: -200px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .blob-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-celadon);\n            bottom: -150px;\n            left: -100px;\n            animation-delay: -5s;\n            border-radius: var(--radius-curve-2);\n        }\n\n        .blob-3 {\n            width: 300px;\n            height: 300px;\n            background: var(--gradient-bronze-celadon);\n            top: 50%;\n            left: 20%;\n            animation-delay: -10s;\n            border-radius: var(--radius-curve-3);\n            opacity: 0.1;\n        }\n\n        .blob-4 {\n            width: 250px;\n            height: 250px;\n            background: linear-gradient(135deg, var(--color-celadon-light) 0%, var(--color-bronze-light) 100%);\n            bottom: 20%;\n            right: 15%;\n            animation-delay: -15s;\n            border-radius: var(--radius-curve-4);\n            opacity: 0.08;\n        }\n\n        @keyframes float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(90deg) scale(1.1);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(180deg) scale(0.9);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(270deg) scale(1.05);\n            }\n        }\n\n        .hero-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            text-align: center;\n            position: relative;\n            z-index: 10;\n        }\n\n        .hero-badge {\n            display: inline-block;\n            padding: 0.5rem 1.5rem;\n            background: rgba(184, 135, 74, 0.1);\n            border: 1px solid var(--color-bronze);\n            border-radius: 50px;\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-bronze-dark);\n            margin-bottom: var(--spacing-md);\n            opacity: 0;\n            animation: fadeInUp 0.8s ease forwards;\n            animation-delay: 0ms;\n        }\n\n        .hero-title {\n            font-size: clamp(2.5rem, 7vw, 5rem);\n            font-weight: 700;\n            line-height: 1.1;\n            margin-bottom: var(--spacing-md);\n            color: var(--color-noir);\n            opacity: 0;\n            animation: fadeInUp 0.8s ease forwards;\n            animation-delay: 200ms;\n        }\n\n        .hero-title span {\n            background: var(--gradient-bronze-celadon);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: clamp(1.1rem, 2vw, 1.4rem);\n            color: var(--color-text-secondary);\n            max-width: 700px;\n            margin: 0 auto var(--spacing-lg);\n            line-height: 1.6;\n            opacity: 0;\n            animation: fadeInUp 0.8s ease forwards;\n            animation-delay: 400ms;\n        }\n\n        .hero-cta {\n            display: inline-flex;\n            gap: var(--spacing-sm);\n            opacity: 0;\n            animation: fadeInUp 0.8s ease forwards;\n            animation-delay: 600ms;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            text-decoration: none;\n            border-radius: 50px;\n            transition: all var(--transition-base);\n            cursor: pointer;\n            border: none;\n        }\n\n        .btn-primary {\n            background: var(--gradient-bronze);\n            color: white;\n            box-shadow: 0 4px 15px rgba(184, 135, 74, 0.3);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 8px 25px rgba(184, 135, 74, 0.4);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-noir);\n            border: 2px solid var(--color-bronze);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-bronze);\n            color: white;\n            transform: translateY(-3px);\n        }\n\n        .hero-image {\n            margin-top: var(--spacing-xl);\n            position: relative;\n            opacity: 0;\n            animation: fadeInUp 0.8s ease forwards;\n            animation-delay: 800ms;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            max-width: 800px;\n            margin: 0 auto;\n            border-radius: var(--radius-curve-1);\n            overflow: hidden;\n            box-shadow: var(--shadow-strong);\n        }\n\n        .hero-image-wrapper img {\n            width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        .hero-image-decoration {\n            position: absolute;\n            width: 200px;\n            height: 200px;\n            border: 3px solid var(--color-bronze);\n            border-radius: var(--radius-curve-3);\n            top: -20px;\n            right: -20px;\n            z-index: -1;\n        }\n\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-ivory);\n        }\n\n        .section-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .section-label {\n            display: inline-block;\n            font-family: var(--font-body);\n            font-size: 0.85rem;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 2px;\n            color: var(--color-bronze);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .problem-card {\n            background: white;\n            padding: var(--spacing-md);\n            border-radius: 20px;\n            border-left: 4px solid var(--color-bronze-dark);\n            box-shadow: var(--shadow-soft);\n            transition: all var(--transition-base);\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .problem-card.animated {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .problem-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-medium);\n            border-left-color: var(--color-celadon);\n        }\n\n        .problem-card h3 {\n            color: var(--color-noir);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .solution-card {\n            background: var(--gradient-noir);\n            padding: var(--spacing-md);\n            border-radius: 20px;\n            border-left: 4px solid var(--color-celadon);\n            box-shadow: var(--shadow-medium);\n            transition: all var(--transition-base);\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .solution-card.animated {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-strong);\n            border-left-color: var(--color-bronze);\n        }\n\n        .solution-card h3 {\n            color: var(--color-text-on-dark);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .solution-card p {\n            color: var(--color-ivory);\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-celadon-pale);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .service-card {\n            background: white;\n            border-radius: 20px;\n            padding: var(--spacing-md);\n            box-shadow: var(--shadow-soft);\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .service-card.animated {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-bronze-celadon);\n            transform: scaleX(0);\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover {\n            transform: translateY(-10px);\n            box-shadow: var(--shadow-strong);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--color-celadon-mist);\n            border-radius: var(--radius-curve-1);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.5rem;\n        }\n\n        .service-card h3 {\n            color: var(--color-noir);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-bronze);\n            text-decoration: none;\n            font-weight: 600;\n            margin-top: var(--spacing-sm);\n            transition: gap var(--transition-fast);\n        }\n\n        .service-link:hover {\n            gap: 1rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--gradient-noir);\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonials h2 {\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(184, 135, 74, 0.2);\n            border-radius: 20px;\n            padding: var(--spacing-md);\n            transition: all var(--transition-base);\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .testimonial-card.animated {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .testimonial-card:hover {\n            background: rgba(255, 255, 255, 0.08);\n            border-color: var(--color-bronze);\n            transform: translateY(-5px);\n        }\n\n        .testimonial-stars {\n            color: var(--color-bronze);\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.2rem;\n        }\n\n        .testimonial-text {\n            color: var(--color-ivory);\n            font-style: italic;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-bronze-celadon);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: white;\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n            color: var(--color-text-on-dark);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-ivory);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .differential-item {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-sm);\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .differential-item.animated {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .differential-icon {\n            width: 50px;\n            height: 50px;\n            min-width: 50px;\n            background: var(--gradient-celadon);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.2rem;\n            position: relative;\n        }\n\n        .differential-icon::after {\n            content: '';\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            border-radius: 50%;\n            border: 2px solid var(--color-celadon);\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% {\n                transform: scale(1);\n                opacity: 1;\n            }\n            50% {\n                transform: scale(1.2);\n                opacity: 0;\n            }\n        }\n\n        .differential-content h4 {\n            color: var(--color-noir);\n            margin-bottom: 0.5rem;\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-cream);\n        }\n\n        .contact-container {\n            max-width: 800px;\n            margin: 0 auto;\n        }\n\n        .contact-form {\n            background: white;\n            padding: var(--spacing-lg);\n            border-radius: 20px;\n            box-shadow: var(--shadow-medium);\n            margin-top: var(--spacing-lg);\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-label {\n            display: block;\n            font-weight: 600;\n            margin-bottom: 0.5rem;\n            color: var(--color-noir);\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 1rem;\n            border: 2px solid var(--color-celadon-mist);\n            border-radius: 10px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: border-color var(--transition-fast);\n            background: var(--color-ivory);\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-bronze);\n        }\n\n        .form-textarea {\n            min-height: 150px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1.2rem;\n            background: var(--gradient-bronze);\n            color: white;\n            border: none;\n            border-radius: 50px;\n            font-family: var(--font-body);\n            font-size: 1.1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all var(--transition-base);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 8px 25px rgba(184, 135, 74, 0.4);\n        }\n\n        .contact-info {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .contact-info-item {\n            text-align: center;\n            padding: var(--spacing-md);\n            background: var(--color-celadon-pale);\n            border-radius: 15px;\n        }\n\n        .contact-info-item h4 {\n            color: var(--color-bronze-dark);\n            margin-bottom: 0.5rem;\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            padding: var(--spacing-lg) var(--spacing-md);\n            background: var(--color-noir);\n            color: var(--color-text-on-dark);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            text-align: center;\n        }\n\n        .footer-logo {\n            font-family: var(--font-display);\n            font-size: 2rem;\n            font-weight: 700;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .footer-links {\n            display: flex;\n            justify-content: center;\n            gap: var(--spacing-md);\n            margin-bottom: var(--spacing-md);\n            flex-wrap: wrap;\n        }\n\n        .footer-link {\n            color: var(--color-text-muted);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n        }\n\n        .footer-link:hover {\n            color: var(--color-bronze);\n        }\n\n        .footer-copy {\n            color: var(--color-text-muted);\n            font-size: 0.9rem;\n        }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 768px) {\n            .nav-menu {\n                display: none;\n                position: absolute;\n                top: 100%;\n                left: 0;\n                right: 0;\n                background: rgba(250, 250, 246, 0.98);\n                flex-direction: column;\n                padding: var(--spacing-md);\n                box-shadow: var(--shadow-medium);\n            }\n\n            .nav-menu.active {\n                display: flex;\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n\n            .hero-cta {\n                flex-direction: column;\n                align-items: stretch;\n            }\n\n            .btn {\n                justify-content: center;\n            }\n\n            .problem-solution-grid,\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .blob-1, .blob-2 {\n                width: 300px;\n                height: 300px;\n            }\n\n            .blob-3, .blob-4 {\n                width: 200px;\n                height: 200px;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .hero {\n                padding: var(--spacing-lg) var(--spacing-sm);\n            }\n\n            .section-header {\n                padding: 0 var(--spacing-sm);\n            }\n\n            .contact-form {\n                padding: var(--spacing-md);\n            }\n        }\n\n        /* ============================================\n           ACCESSIBILITY - REDUCED MOTION\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *,\n            *::before,\n            *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Brenda Dick</a>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#inicio\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#sobre\" class=\"nav-link\">Sobre</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#contato\" class=\"nav-link nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Toggle navigation\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-blob blob-1\"></div>\n        <div class=\"hero-blob blob-2\"></div>\n        <div class=\"hero-blob blob-3\"></div>\n        <div class=\"hero-blob blob-4\"></div>\n\n        <div class=\"hero-container\">\n            <span class=\"hero-badge\">✦ Odontologia Especializada & Harmonização Facial</span>\n            <h1 class=\"hero-title\">\n                Dra. Brenda Dick\n                <br><span>Harmonização Facial</span> e Odontologia\n            </h1>\n            <p class=\"hero-subtitle\">\n                Transforme seu sorriso e sua autoestima com tratamentos especializados em harmonização facial e odontologia estética em Ribeirão Preto.\n            </p>\n            <div class=\"hero-cta\">\n                <a href=\"#contato\" class=\"btn btn-primary\">Agendar Consulta</a>\n                <a href=\"#servicos\" class=\"btn btn-secondary\">Conhecer Tratamentos</a>\n            </div>\n            <div class=\"hero-image\">\n                <div class=\"hero-image-wrapper\">\n                    <div class=\"hero-image-decoration\"></div>\n                    <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=800&q=80\" alt=\"Harmonização Facial e Odontologia Estética\">\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"problem-solution\" id=\"sobre\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">A Experiência</span>\n                <h2>Sua Transformação Começa Aqui</h2>\n                <p>Entendemos suas necessidades e oferecemos soluções personalizadas</p>\n            </div>\n\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card wow-animate\">\n                    <h3>😔 Insegurança com o Sorriso</h3>\n                    <p>Sente-se desconfortável ao sorrir em fotos ou reuniões sociais? A aparência dos seus dentes afeta sua autoconfiança?</p>\n                </div>\n                <div class=\"problem-card wow-animate\" style=\"animation-delay: 0.2s;\">\n                    <h3>😤 Perda de Expressão Facial</h3>\n                    <p>Notou que seu rosto parece mais cansado ou sem vitalidade? A perda de volume facial pode envelhecer sua aparência.</p>\n                </div>\n                <div class=\"problem-card wow-animate\" style=\"animation-delay: 0.4s;\">\n                    <h3>🤔 Tratamentos Sem Personalização</h3>\n                    <p>Já fez tratamentos que não atenderam suas expectativas? Cada rosto é único e merece uma abordagem individualizada.</p>\n                </div>\n                <div class=\"solution-card wow-animate\" style=\"animation-delay: 0.6s;\">\n                    <h3>✨ Harmonização Facial Personalizada</h3>\n                    <p>Análise facial completa para criar harmonia e equilíbrio natural, realçando sua beleza única.</p>\n                </div>\n                <div class=\"solution-card wow-animate\" style=\"animation-delay: 0.8s;\">\n                    <h3>🦷 Odontologia Estética Avançada</h3>\n                    <p>Tecnologia de ponta para transformar seu sorriso com resultados naturais e duradouros.</p>\n                </div>\n                <div class=\"solution-card wow-animate\" style=\"animation-delay: 1s;\">\n                    <h3>💎 Atendimento Exclusivo</h3>\n                    <p>Acompanhamento personalizado do início ao fim, com foco em seu conforto e satisfação.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"services\" id=\"servicos\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">Especialidades</span>\n                <h2>Tratamentos que Transformam</h2>\n                <p>Soluções completas para sua harmonização facial e saúde bucal</p>\n            </div>\n\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-animate\">\n                    <div class=\"service-icon\">✦</div>\n                    <h3>Harmonização Facial</h3>\n                    <p>Equilíbrio e simetria facial através de técnicas avançadas que realçam sua beleza natural com resultados sutis e elegantes.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-animate\" style=\"animation-delay: 0.2s;\">\n                    <div class=\"service-icon\">◈</div>\n                    <h3>Toxina Botulínica</h3>\n                    <p>Suavização de rugas e linhas de expressão com aplicação estratégica para um aspecto descansado e rejuvenescido.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-animate\" style=\"animation-delay: 0.4s;\">\n                    <div class=\"service-icon\">❖</div>\n                    <h3>Preenchedores Faciais</h3>\n                    <p>Restauração de volume e contorno facial com ácido hialurônico de alta qualidade para resultados naturais.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-animate\" style=\"animation-delay: 0.6s;\">\n                    <div class=\"service-icon\">◆</div>\n                    <h3>Preenchimento Labial</h3>\n                    <p>Contorno e volume labial personalizado para criar lábios naturais, harmônicos e atraentes.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-animate\" style=\"animation-delay: 0.8s;\">\n                    <div class=\"service-icon\">⬡</div>\n                    <h3>Bioestimuladores</h3>\n                    <p>Estimulação de colágeno para firmeza e qualidade da pele com resultados progressivos e duradouros.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-animate\" style=\"animation-delay: 1s;\">\n                    <div class=\"service-icon\">⌬</div>\n                    <h3>Odontologia Estética</h3>\n                    <p>Lentes de contato dental, facetas e clareamento para um sorriso perfeito e radiante.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"testimonials\" id=\"depoimentos\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">Depoimentos</span>\n                <h2>O Que Nossas Pacientes Dizem</h2>\n                <p>Histórias reais de transformação e satisfação</p>\n            </div>\n\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-animate\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"A Dra. Brenda transformou minha autoestima! A harmonização facial ficou super natural e exatamente como eu queria. Profissional incrível!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div>\n                            <div class=\"testimonial-name\">Maria Clara</div>\n                            <small style=\"color: var(--color-text-muted);\">Harmonização Facial</small>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-animate\" style=\"animation-delay: 0.2s;\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Finalmente encontrei uma profissional que entendeu o que eu queria. Meu sorriso ficou perfeito e o atendimento foi impecável do início ao fim.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AS</div>\n                        <div>\n                            <div class=\"testimonial-name\">Ana Silva</div>\n                            <small style=\"color: var(--color-text-muted);\">Odontologia Estética</small>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-animate\" style=\"animation-delay: 0.4s;\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"O preenchimento labial ficou super natural e delicado. A Dra. Brenda tem mãos de fada e muito conhecimento técnico. Recomendo muito!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">PL</div>\n                        <div>\n                            <div class=\"testimonial-name\">Patrícia Lima</div>\n                            <small style=\"color: var(--color-text-muted);\">Preenchimento Labial</small>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"differentials\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">Diferenciais</span>\n                <h2>Por Que Escolher a Dra. Brenda Dick</h2>\n            </div>\n\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-animate\">\n                    <div class=\"differential-icon\">✦</div>\n                    <div class=\"differential-content\">\n                        <h4>Formação Especializada</h4>\n                        <p>Atualização constante com as técnicas mais modernas de harmonização facial e odontologia estética.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-animate\" style=\"animation-delay: 0.2s;\">\n                    <div class=\"differential-icon\">◈</div>\n                    <div class=\"differential-content\">\n                        <h4>Atendimento Personalizado</h4>\n                        <p>Cada paciente é único: tratamentos individualizados respeitando suas características e objetivos.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-animate\" style=\"animation-delay: 0.4s;\">\n                    <div class=\"differential-icon\">❖</div>\n                    <div class=\"differential-content\">\n                        <h4>Tecnologia Avançada</h4>\n                        <p>Equipamentos de última geração para procedimentos seguros, precisos e com resultados excelentes.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-animate\" style=\"animation-delay: 0.6s;\">\n                    <div class=\"differential-icon\">◆</div>\n                    <div class=\"differential-content\">\n                        <h4>Ambiente Acolhedor</h4>\n                        <p>Espaço confortável e higienizado para que você se sinta segura e tranquila durante todo o atendimento.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-animate\" style=\"animation-delay: 0.8s;\">\n                    <div class=\"differential-icon\">⬡</div>\n                    <div class=\"differential-content\">\n                        <h4>Resultados Naturais</h4>\n                        <p>Foco em realçar sua beleza natural com equilíbrio e harmonia, sem exageros ou aparência artificial.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-animate\" style=\"animation-delay: 1s;\">\n                    <div class=\"differential-icon\">⌬</div>\n                    <div class=\"differential-content\">\n                        <h4>Acompanhamento Completo</h4>\n                        <p>Suporte total antes, durante e após os procedimentos para sua segurança e satisfação total.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"contact\" id=\"contato\">\n        <div class=\"contact-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">Contato</span>\n                <h2>Agende Sua Consulta</h2>\n                <p>Entre em contato e transforme seu sorriso hoje mesmo</p>\n            </div>\n\n            <form class=\"contact-form\" id=\"contactForm\">\n                <div class=\"form-group\">\n                    <label class=\"form-label\" for=\"name\">Nome Completo</label>\n                    <input type=\"text\" id=\"name\" name=\"name\" class=\"form-input\" placeholder=\"Seu nome\" required>\n                </div>\n                <div class=\"form-group\">\n                    <label class=\"form-label\" for=\"email\">E-mail</label>\n                    <input type=\"email\" id=\"email\" name=\"email\" class=\"form-input\" placeholder=\"seu@email.com\" required>\n                </div>\n                <div class=\"form-group\">\n                    <label class=\"form-label\" for=\"service\">Tratamento de Interesse</label>\n                    <select id=\"service\" name=\"service\" class=\"form-select\" required>\n                        <option value=\"\">Selecione um tratamento</option>\n                        <option value=\"harmonizacao-facial\">Harmonização Facial</option>\n                        <option value=\"toxina-botulinica\">Toxina Botulínica</option>\n                        <option value=\"preenchedores\">Preenchedores Faciais</option>\n                        <option value=\"labial\">Preenchimento Labial</option>\n                        <option value=\"bioestimuladores\">Bioestimuladores</option>\n                        <option value=\"odontologia-estetica\">Odontologia Estética</option>\n                        <option value=\"outro\">Outro</option>\n                    </select>\n                </div>\n                <div class=\"form-group\">\n                    <label class=\"form-label\" for=\"message\">Mensagem</label>\n                    <textarea id=\"message\" name=\"message\" class=\"form-textarea\" placeholder=\"Conte-nos sobre suas expectativas...\" required></textarea>\n                </div>\n                <button type=\"submit\" class=\"form-submit\">Enviar Mensagem via WhatsApp</button>\n            </form>\n\n            <div class=\"contact-info\">\n                <div class=\"contact-info-item\">\n                    <h4>📍 Endereço</h4>\n                    <p>Av. Braz Olaia Acosta, 1900 - Sala 410<br>Nova Aliança, Ribeirão Preto - SP<br>CEP: 14026-040</p>\n                </div>\n                <div class=\"contact-info-item\">\n                    <h4>📱 WhatsApp</h4>\n                    <p>(16) 99371-8919<br><small>Atendimento imediato</small></p>\n                </div>\n                <div class=\"contact-info-item\">\n                    <h4>⏰ Horário</h4>\n                    <p>Segunda a Sexta<br>09:00 - 18:00</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-logo\">Dra. Brenda Dick</div>\n            <div class=\"footer-links\">\n                <a href=\"#inicio\" class=\"footer-link\">Início</a>\n                <a href=\"#sobre\" class=\"footer-link\">Sobre</a>\n                <a href=\"#servicos\" class=\"footer-link\">Serviços</a>\n                <a href=\"#depoimentos\" class=\"footer-link\">Depoimentos</a>\n                <a href=\"#contato\" class=\"footer-link\">Contato</a>\n            </div>\n            <p class=\"footer-copy\">© 2026 Dra. Brenda Dick - Odontologia Especializada e Harmonização Facial. Todos os direitos reservados.</p>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION SCROLL EFFECT\n        // ============================================\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                } else {\n                    nav.classList.remove('hidden');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // ============================================\n        // MOBILE MENU TOGGLE\n        // ============================================\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close menu when clicking a link\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function (e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER FOR SCROLL ANIMATIONS\n        // ============================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('animated');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        // Observe all animated elements\n        document.querySelectorAll('.wow-animate').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // FORM SUBMISSION - WHATSAPP INTEGRATION\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n        const whatsappNumber = '5516993718919';\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const formData = new FormData(contactForm);\n            const name = formData.get('name');\n            const email = formData.get('email');\n            const service = formData.get('service');\n            const message = formData.get('message');\n\n            const serviceNames = {\n                'harmonizacao-facial': 'Harmonização Facial',\n                'toxina-botulinica': 'Toxina Botulínica',\n                'preenchedores': 'Preenchedores Faciais',\n                'labial': 'Preenchimento Labial',\n                'bioestimuladores': 'Bioestimuladores',\n                'odontologia-estetica': 'Odontologia Estética',\n                'outro': 'Outro'\n            };\n\n            const whatsappMessage = `Olá Dra. Brenda Dick!\n\nMeu nome é *${name}*.\n\nGostaria de agendar uma consulta para: *${serviceNames[service] || service}*.\n\nMensagem: ${message}\n\nE-mail: ${email}`;\n\n            const whatsappURL = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappURL, '_blank');\n        });\n\n        // ============================================\n        // HERO PARALLAX EFFECT\n        // ============================================\n        const heroBlobs = document.querySelectorAll('.hero-blob');\n\n        document.addEventListener('mousemove', (e) => {\n            const mouseX = e.clientX / window.innerWidth;\n            const mouseY = e.clientY / window.innerHeight;\n\n            heroBlobs.forEach((blob, index) => {\n                const speed = (index + 1) * 20;\n                const x = (mouseX - 0.5) * speed;\n                const y = (mouseY - 0.5) * speed;\n\n                blob.style.transform = `translate(${x}px, ${y}px)`;\n            });\n        });\n\n        // ============================================\n        // LAZY LOADING FOR IMAGES\n        // ============================================\n        if ('IntersectionObserver' in window) {\n            const imageObserver = new IntersectionObserver((entries) => {\n                entries.forEach(entry => {\n                    if (entry.isIntersecting) {\n                        const img = entry.target;\n                        if (img.dataset.src) {\n                            img.src = img.dataset.src;\n                            img.removeAttribute('data-src');\n                        }\n                        imageObserver.unobserve(img);\n                    }\n                });\n            });\n\n            document.querySelectorAll('img[data-src]').forEach(img => {\n                imageObserver.observe(img);\n            });\n        }\n\n        // ============================================\n        // PREFERRED REDUCED MOTION CHECK\n        // ============================================\n        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n        if (prefersReducedMotion.matches) {\n            // Disable parallax effect\n            document.removeEventListener('mousemove', () => {});\n\n            // Disable floating animations\n            heroBlobs.forEach(blob => {\n                blob.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"8676b3eb-c729-4b4a-bd7a-dc643bff46cb","uuid":"420677f5-bd27-4ff5-8777-202601b083ac"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c2eb52907db94dafb925baf0","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-brenda-dick-harmonizacao-facial-e-odontologia-especializ/index.html"}]},"parent_tool_use_id":null,"session_id":"8676b3eb-c729-4b4a-bd7a-dc643bff46cb","uuid":"401874ef-ee05-4209-962a-6888d53b87ce","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-brenda-dick-harmonizacao-facial-e-odontologia-especializ/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Brenda Dick | Harmonização Facial e Odontologia Especializada em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Brenda Dick - Odontologia especializada e harmonização facial em Ribeirão Preto. Atendimento personalizado com técnicas modernas de odontologia estética.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           CSS VARIABLES - Bronze & Celadon Noir\n           ============================================ */\n        :root {\n            /* Primary Palette - Bronze Metallic */\n            --color-bronze: #B8874A;\n            --color-bronze-light: #D4A868;\n            --color-bronze-mid: #C89855;\n            --color-bronze-dark: #A0783A;\n            --color-bronze-deep: #886028;\n            --color-bronze-shimmer: #E0C090;\n\n            /* Accent Palette - Celadon Ceramic */\n            --color-celadon: #7AA892;\n            --color-celadon-light: #98C0AA;\n            --color-celadon-dark: #629878;\n            --color-celadon-deep: #4A7860;\n            --color-celadon-mist: #D0E8E0;\n            --color-celadon-pale: #E8F0EC;\n\n            /* Dark Palette - Soft Noir */\n            --color-noir: #1A1A1A;\n            --color-noir-charcoal: #2A2A2A;\n            --color-noir-deep: #0F0F12;\n\n            /* Warmth Accent - Ivory */\n            --color-ivory: #FAFAF6;\n            --color-ivory-warm: #F5F5F0;\n            --color-cream: #F0ECE8;\n\n            /* Text Colors */\n            --color-text-primary: #1A1A1A;\n            --color-text-secondary: #4A4A4A;\n            --color-text-muted: #7A7A7A;\n            --color-text-on-dark: #F5F5F0;\n\n            /* Gradients */\n            --gradient-bronze: linear-gradient(135deg, var(--color-bronze) 0%, var(--color-bronze-light) 100%);\n            --gradient-celadon: linear-gradient(135deg, var(--color-celadon) 0%, var(--color-celadon-light) 100%);\n            --gradient-noir: linear-gradient(135deg, var(--color-noir) 0%, var(--color-noir-charcoal) 100%);\n            --gradient-hero: linear-gradient(135deg, #FAFAF6 0%, #F0ECE8 50%, #E8E4E0 100%);\n            --gradient-bronze-celadon: linear-gradient(135deg, var(--color-bronze) 0%, var(--color-celadon) 100%);\n\n            /* Ceramic Curve Border Radius Shapes */\n            --radius-curve-1: 72% 28% 48% 52% / 52% 38% 62% 48%;\n            --radius-curve-2: 48% 52% 68% 32% / 38% 62% 38% 62%;\n            --radius-curve-3: 62% 38% 42% 58% / 58% 42% 52% 48%;\n            --radius-curve-4: 38% 62% 52% 48% / 42% 58% 48% 52%;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n\n            /* Typography */\n            --font-display: 'Playfair Display', Georgia, serif;\n            --font-body: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(26, 26, 26, 0.08);\n            --shadow-medium: 0 8px 30px rgba(26, 26, 26, 0.12);\n            --shadow-strong: 0 12px 40px rgba(26, 26, 26, 0.16);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.7;\n            color: var(--color-text-primary);\n            background: var(--color-ivory);\n            overflow-x: hidden;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-noir);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-secondary);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-sm) var(--spacing-md);\n            background: rgba(250, 250, 246, 0.95);\n            backdrop-filter: blur(20px);\n            transition: transform 0.3s ease;\n            box-shadow: 0 2px 20px rgba(26, 26, 26, 0.06);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-noir);\n            text-decoration: none;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-secondary);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-bronze-celadon);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover {\n            color: var(--color-noir);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--gradient-bronze);\n            color: white !important;\n            padding: 0.75rem 1.5rem;\n            border-radius: 50px;\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 8px 20px rgba(184, 135, 74, 0.3);\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-noir);\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-curve-1);\n            opacity: 0.15;\n            filter: blur(60px);\n            animation: float 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-bronze);\n            top: -200px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .blob-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-celadon);\n            bottom: -150px;\n            left: -100px;\n            animation-delay: -5s;\n            border-radius: var(--radius-curve-2);\n        }\n\n        .blob-3 {\n            width: 300px;\n            height: 300px;\n            background: var(--gradient-bronze-celadon);\n            top: 50%;\n            left: 20%;\n            animation-delay: -10s;\n            border-radius: var(--radius-curve-3);\n            opacity: 0.1;\n        }\n\n        .blob-4 {\n            width: 250px;\n            height: 250px;\n            background: linear-gradient(135deg, var(--color-celadon-light) 0%, var(--color-bronze-light) 100%);\n            bottom: 20%;\n            right: 15%;\n            animation-delay: -15s;\n            border-radius: var(--radius-curve-4);\n            opacity: 0.08;\n        }\n\n        @keyframes float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(90deg) scale(1.1);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(180deg) scale(0.9);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(270deg) scale(1.05);\n            }\n        }\n\n        .hero-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            text-align: center;\n            position: relative;\n            z-index: 10;\n        }\n\n        .hero-badge {\n            display: inline-block;\n            padding: 0.5rem 1.5rem;\n            background: rgba(184, 135, 74, 0.1);\n            border: 1px solid var(--color-bronze);\n            border-radius: 50px;\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-bronze-dark);\n            margin-bottom: var(--spacing-md);\n            opacity: 0;\n            animation: fadeInUp 0.8s ease forwards;\n            animation-delay: 0ms;\n        }\n\n        .hero-title {\n            font-size: clamp(2.5rem, 7vw, 5rem);\n            font-weight: 700;\n            line-height: 1.1;\n            margin-bottom: var(--spacing-md);\n            color: var(--color-noir);\n            opacity: 0;\n            animation: fadeInUp 0.8s ease forwards;\n            animation-delay: 200ms;\n        }\n\n        .hero-title span {\n            background: var(--gradient-bronze-celadon);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: clamp(1.1rem, 2vw, 1.4rem);\n            color: var(--color-text-secondary);\n            max-width: 700px;\n            margin: 0 auto var(--spacing-lg);\n            line-height: 1.6;\n            opacity: 0;\n            animation: fadeInUp 0.8s ease forwards;\n            animation-delay: 400ms;\n        }\n\n        .hero-cta {\n            display: inline-flex;\n            gap: var(--spacing-sm);\n            opacity: 0;\n            animation: fadeInUp 0.8s ease forwards;\n            animation-delay: 600ms;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            text-decoration: none;\n            border-radius: 50px;\n            transition: all var(--transition-base);\n            cursor: pointer;\n            border: none;\n        }\n\n        .btn-primary {\n            background: var(--gradient-bronze);\n            color: white;\n            box-shadow: 0 4px 15px rgba(184, 135, 74, 0.3);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 8px 25px rgba(184, 135, 74, 0.4);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-noir);\n            border: 2px solid var(--color-bronze);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-bronze);\n            color: white;\n            transform: translateY(-3px);\n        }\n\n        .hero-image {\n            margin-top: var(--spacing-xl);\n            position: relative;\n            opacity: 0;\n            animation: fadeInUp 0.8s ease forwards;\n            animation-delay: 800ms;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            max-width: 800px;\n            margin: 0 auto;\n            border-radius: var(--radius-curve-1);\n            overflow: hidden;\n            box-shadow: var(--shadow-strong);\n        }\n\n        .hero-image-wrapper img {\n            width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        .hero-image-decoration {\n            position: absolute;\n            width: 200px;\n            height: 200px;\n            border: 3px solid var(--color-bronze);\n            border-radius: var(--radius-curve-3);\n            top: -20px;\n            right: -20px;\n            z-index: -1;\n        }\n\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-ivory);\n        }\n\n        .section-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .section-label {\n            display: inline-block;\n            font-family: var(--font-body);\n            font-size: 0.85rem;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 2px;\n            color: var(--color-bronze);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .problem-card {\n            background: white;\n            padding: var(--spacing-md);\n            border-radius: 20px;\n            border-left: 4px solid var(--color-bronze-dark);\n            box-shadow: var(--shadow-soft);\n            transition: all var(--transition-base);\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .problem-card.animated {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .problem-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-medium);\n            border-left-color: var(--color-celadon);\n        }\n\n        .problem-card h3 {\n            color: var(--color-noir);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .solution-card {\n            background: var(--gradient-noir);\n            padding: var(--spacing-md);\n            border-radius: 20px;\n            border-left: 4px solid var(--color-celadon);\n            box-shadow: var(--shadow-medium);\n            transition: all var(--transition-base);\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .solution-card.animated {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .solution-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-strong);\n            border-left-color: var(--color-bronze);\n        }\n\n        .solution-card h3 {\n            color: var(--color-text-on-dark);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .solution-card p {\n            color: var(--color-ivory);\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-celadon-pale);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .service-card {\n            background: white;\n            border-radius: 20px;\n            padding: var(--spacing-md);\n            box-shadow: var(--shadow-soft);\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .service-card.animated {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-bronze-celadon);\n            transform: scaleX(0);\n            transition: transform var(--transition-base);\n        }\n\n        .service-card:hover {\n            transform: translateY(-10px);\n            box-shadow: var(--shadow-strong);\n        }\n\n        .service-card:hover::before {\n            transform: scaleX(1);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--color-celadon-mist);\n            border-radius: var(--radius-curve-1);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.5rem;\n        }\n\n        .service-card h3 {\n            color: var(--color-noir);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-bronze);\n            text-decoration: none;\n            font-weight: 600;\n            margin-top: var(--spacing-sm);\n            transition: gap var(--transition-fast);\n        }\n\n        .service-link:hover {\n            gap: 1rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--gradient-noir);\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonials h2 {\n            color: var(--color-text-on-dark);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .testimonial-card {\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(184, 135, 74, 0.2);\n            border-radius: 20px;\n            padding: var(--spacing-md);\n            transition: all var(--transition-base);\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .testimonial-card.animated {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .testimonial-card:hover {\n            background: rgba(255, 255, 255, 0.08);\n            border-color: var(--color-bronze);\n            transform: translateY(-5px);\n        }\n\n        .testimonial-stars {\n            color: var(--color-bronze);\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.2rem;\n        }\n\n        .testimonial-text {\n            color: var(--color-ivory);\n            font-style: italic;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-bronze-celadon);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: white;\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n            color: var(--color-text-on-dark);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-ivory);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .differential-item {\n            display: flex;\n            align-items: flex-start;\n            gap: var(--spacing-sm);\n            opacity: 0;\n            transform: translateY(30px);\n        }\n\n        .differential-item.animated {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .differential-icon {\n            width: 50px;\n            height: 50px;\n            min-width: 50px;\n            background: var(--gradient-celadon);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.2rem;\n            position: relative;\n        }\n\n        .differential-icon::after {\n            content: '';\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            border-radius: 50%;\n            border: 2px solid var(--color-celadon);\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% {\n                transform: scale(1);\n                opacity: 1;\n            }\n            50% {\n                transform: scale(1.2);\n                opacity: 0;\n            }\n        }\n\n        .differential-content h4 {\n            color: var(--color-noir);\n            margin-bottom: 0.5rem;\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--color-cream);\n        }\n\n        .contact-container {\n            max-width: 800px;\n            margin: 0 auto;\n        }\n\n        .contact-form {\n            background: white;\n            padding: var(--spacing-lg);\n            border-radius: 20px;\n            box-shadow: var(--shadow-medium);\n            margin-top: var(--spacing-lg);\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-label {\n            display: block;\n            font-weight: 600;\n            margin-bottom: 0.5rem;\n            color: var(--color-noir);\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 1rem;\n            border: 2px solid var(--color-celadon-mist);\n            border-radius: 10px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: border-color var(--transition-fast);\n            background: var(--color-ivory);\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-bronze);\n        }\n\n        .form-textarea {\n            min-height: 150px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1.2rem;\n            background: var(--gradient-bronze);\n            color: white;\n            border: none;\n            border-radius: 50px;\n            font-family: var(--font-body);\n            font-size: 1.1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all var(--transition-base);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 8px 25px rgba(184, 135, 74, 0.4);\n        }\n\n        .contact-info {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-lg);\n        }\n\n        .contact-info-item {\n            text-align: center;\n            padding: var(--spacing-md);\n            background: var(--color-celadon-pale);\n            border-radius: 15px;\n        }\n\n        .contact-info-item h4 {\n            color: var(--color-bronze-dark);\n            margin-bottom: 0.5rem;\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            padding: var(--spacing-lg) var(--spacing-md);\n            background: var(--color-noir);\n            color: var(--color-text-on-dark);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            text-align: center;\n        }\n\n        .footer-logo {\n            font-family: var(--font-display);\n            font-size: 2rem;\n            font-weight: 700;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .footer-links {\n            display: flex;\n            justify-content: center;\n            gap: var(--spacing-md);\n            margin-bottom: var(--spacing-md);\n            flex-wrap: wrap;\n        }\n\n        .footer-link {\n            color: var(--color-text-muted);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n        }\n\n        .footer-link:hover {\n            color: var(--color-bronze);\n        }\n\n        .footer-copy {\n            color: var(--color-text-muted);\n            font-size: 0.9rem;\n        }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 768px) {\n            .nav-menu {\n                display: none;\n                position: absolute;\n                top: 100%;\n                left: 0;\n                right: 0;\n                background: rgba(250, 250, 246, 0.98);\n                flex-direction: column;\n                padding: var(--spacing-md);\n                box-shadow: var(--shadow-medium);\n            }\n\n            .nav-menu.active {\n                display: flex;\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n\n            .hero-cta {\n                flex-direction: column;\n                align-items: stretch;\n            }\n\n            .btn {\n                justify-content: center;\n            }\n\n            .problem-solution-grid,\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .blob-1, .blob-2 {\n                width: 300px;\n                height: 300px;\n            }\n\n            .blob-3, .blob-4 {\n                width: 200px;\n                height: 200px;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .hero {\n                padding: var(--spacing-lg) var(--spacing-sm);\n            }\n\n            .section-header {\n                padding: 0 var(--spacing-sm);\n            }\n\n            .contact-form {\n                padding: var(--spacing-md);\n            }\n        }\n\n        /* ============================================\n           ACCESSIBILITY - REDUCED MOTION\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *,\n            *::before,\n            *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Brenda Dick</a>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#inicio\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#sobre\" class=\"nav-link\">Sobre</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#contato\" class=\"nav-link nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Toggle navigation\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-blob blob-1\"></div>\n        <div class=\"hero-blob blob-2\"></div>\n        <div class=\"hero-blob blob-3\"></div>\n        <div class=\"hero-blob blob-4\"></div>\n\n        <div class=\"hero-container\">\n            <span class=\"hero-badge\">✦ Odontologia Especializada & Harmonização Facial</span>\n            <h1 class=\"hero-title\">\n                Dra. Brenda Dick\n                <br><span>Harmonização Facial</span> e Odontologia\n            </h1>\n            <p class=\"hero-subtitle\">\n                Transforme seu sorriso e sua autoestima com tratamentos especializados em harmonização facial e odontologia estética em Ribeirão Preto.\n            </p>\n            <div class=\"hero-cta\">\n                <a href=\"#contato\" class=\"btn btn-primary\">Agendar Consulta</a>\n                <a href=\"#servicos\" class=\"btn btn-secondary\">Conhecer Tratamentos</a>\n            </div>\n            <div class=\"hero-image\">\n                <div class=\"hero-image-wrapper\">\n                    <div class=\"hero-image-decoration\"></div>\n                    <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=800&q=80\" alt=\"Harmonização Facial e Odontologia Estética\">\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"problem-solution\" id=\"sobre\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">A Experiência</span>\n                <h2>Sua Transformação Começa Aqui</h2>\n                <p>Entendemos suas necessidades e oferecemos soluções personalizadas</p>\n            </div>\n\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card wow-animate\">\n                    <h3>😔 Insegurança com o Sorriso</h3>\n                    <p>Sente-se desconfortável ao sorrir em fotos ou reuniões sociais? A aparência dos seus dentes afeta sua autoconfiança?</p>\n                </div>\n                <div class=\"problem-card wow-animate\" style=\"animation-delay: 0.2s;\">\n                    <h3>😤 Perda de Expressão Facial</h3>\n                    <p>Notou que seu rosto parece mais cansado ou sem vitalidade? A perda de volume facial pode envelhecer sua aparência.</p>\n                </div>\n                <div class=\"problem-card wow-animate\" style=\"animation-delay: 0.4s;\">\n                    <h3>🤔 Tratamentos Sem Personalização</h3>\n                    <p>Já fez tratamentos que não atenderam suas expectativas? Cada rosto é único e merece uma abordagem individualizada.</p>\n                </div>\n                <div class=\"solution-card wow-animate\" style=\"animation-delay: 0.6s;\">\n                    <h3>✨ Harmonização Facial Personalizada</h3>\n                    <p>Análise facial completa para criar harmonia e equilíbrio natural, realçando sua beleza única.</p>\n                </div>\n                <div class=\"solution-card wow-animate\" style=\"animation-delay: 0.8s;\">\n                    <h3>🦷 Odontologia Estética Avançada</h3>\n                    <p>Tecnologia de ponta para transformar seu sorriso com resultados naturais e duradouros.</p>\n                </div>\n                <div class=\"solution-card wow-animate\" style=\"animation-delay: 1s;\">\n                    <h3>💎 Atendimento Exclusivo</h3>\n                    <p>Acompanhamento personalizado do início ao fim, com foco em seu conforto e satisfação.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"services\" id=\"servicos\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">Especialidades</span>\n                <h2>Tratamentos que Transformam</h2>\n                <p>Soluções completas para sua harmonização facial e saúde bucal</p>\n            </div>\n\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-animate\">\n                    <div class=\"service-icon\">✦</div>\n                    <h3>Harmonização Facial</h3>\n                    <p>Equilíbrio e simetria facial através de técnicas avançadas que realçam sua beleza natural com resultados sutis e elegantes.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-animate\" style=\"animation-delay: 0.2s;\">\n                    <div class=\"service-icon\">◈</div>\n                    <h3>Toxina Botulínica</h3>\n                    <p>Suavização de rugas e linhas de expressão com aplicação estratégica para um aspecto descansado e rejuvenescido.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-animate\" style=\"animation-delay: 0.4s;\">\n                    <div class=\"service-icon\">❖</div>\n                    <h3>Preenchedores Faciais</h3>\n                    <p>Restauração de volume e contorno facial com ácido hialurônico de alta qualidade para resultados naturais.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-animate\" style=\"animation-delay: 0.6s;\">\n                    <div class=\"service-icon\">◆</div>\n                    <h3>Preenchimento Labial</h3>\n                    <p>Contorno e volume labial personalizado para criar lábios naturais, harmônicos e atraentes.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-animate\" style=\"animation-delay: 0.8s;\">\n                    <div class=\"service-icon\">⬡</div>\n                    <h3>Bioestimuladores</h3>\n                    <p>Estimulação de colágeno para firmeza e qualidade da pele com resultados progressivos e duradouros.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n                <div class=\"service-card wow-animate\" style=\"animation-delay: 1s;\">\n                    <div class=\"service-icon\">⌬</div>\n                    <h3>Odontologia Estética</h3>\n                    <p>Lentes de contato dental, facetas e clareamento para um sorriso perfeito e radiante.</p>\n                    <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"testimonials\" id=\"depoimentos\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">Depoimentos</span>\n                <h2>O Que Nossas Pacientes Dizem</h2>\n                <p>Histórias reais de transformação e satisfação</p>\n            </div>\n\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-animate\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"A Dra. Brenda transformou minha autoestima! A harmonização facial ficou super natural e exatamente como eu queria. Profissional incrível!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div>\n                            <div class=\"testimonial-name\">Maria Clara</div>\n                            <small style=\"color: var(--color-text-muted);\">Harmonização Facial</small>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-animate\" style=\"animation-delay: 0.2s;\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"Finalmente encontrei uma profissional que entendeu o que eu queria. Meu sorriso ficou perfeito e o atendimento foi impecável do início ao fim.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AS</div>\n                        <div>\n                            <div class=\"testimonial-name\">Ana Silva</div>\n                            <small style=\"color: var(--color-text-muted);\">Odontologia Estética</small>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"testimonial-card wow-animate\" style=\"animation-delay: 0.4s;\">\n                    <div class=\"testimonial-stars\">★★★★★</div>\n                    <p class=\"testimonial-text\">\"O preenchimento labial ficou super natural e delicado. A Dra. Brenda tem mãos de fada e muito conhecimento técnico. Recomendo muito!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">PL</div>\n                        <div>\n                            <div class=\"testimonial-name\">Patrícia Lima</div>\n                            <small style=\"color: var(--color-text-muted);\">Preenchimento Labial</small>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"differentials\">\n        <div class=\"section-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">Diferenciais</span>\n                <h2>Por Que Escolher a Dra. Brenda Dick</h2>\n            </div>\n\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-animate\">\n                    <div class=\"differential-icon\">✦</div>\n                    <div class=\"differential-content\">\n                        <h4>Formação Especializada</h4>\n                        <p>Atualização constante com as técnicas mais modernas de harmonização facial e odontologia estética.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-animate\" style=\"animation-delay: 0.2s;\">\n                    <div class=\"differential-icon\">◈</div>\n                    <div class=\"differential-content\">\n                        <h4>Atendimento Personalizado</h4>\n                        <p>Cada paciente é único: tratamentos individualizados respeitando suas características e objetivos.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-animate\" style=\"animation-delay: 0.4s;\">\n                    <div class=\"differential-icon\">❖</div>\n                    <div class=\"differential-content\">\n                        <h4>Tecnologia Avançada</h4>\n                        <p>Equipamentos de última geração para procedimentos seguros, precisos e com resultados excelentes.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-animate\" style=\"animation-delay: 0.6s;\">\n                    <div class=\"differential-icon\">◆</div>\n                    <div class=\"differential-content\">\n                        <h4>Ambiente Acolhedor</h4>\n                        <p>Espaço confortável e higienizado para que você se sinta segura e tranquila durante todo o atendimento.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-animate\" style=\"animation-delay: 0.8s;\">\n                    <div class=\"differential-icon\">⬡</div>\n                    <div class=\"differential-content\">\n                        <h4>Resultados Naturais</h4>\n                        <p>Foco em realçar sua beleza natural com equilíbrio e harmonia, sem exageros ou aparência artificial.</p>\n                    </div>\n                </div>\n                <div class=\"differential-item wow-animate\" style=\"animation-delay: 1s;\">\n                    <div class=\"differential-icon\">⌬</div>\n                    <div class=\"differential-content\">\n                        <h4>Acompanhamento Completo</h4>\n                        <p>Suporte total antes, durante e após os procedimentos para sua segurança e satisfação total.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"contact\" id=\"contato\">\n        <div class=\"contact-container\">\n            <div class=\"section-header\">\n                <span class=\"section-label\">Contato</span>\n                <h2>Agende Sua Consulta</h2>\n                <p>Entre em contato e transforme seu sorriso hoje mesmo</p>\n            </div>\n\n            <form class=\"contact-form\" id=\"contactForm\">\n                <div class=\"form-group\">\n                    <label class=\"form-label\" for=\"name\">Nome Completo</label>\n                    <input type=\"text\" id=\"name\" name=\"name\" class=\"form-input\" placeholder=\"Seu nome\" required>\n                </div>\n                <div class=\"form-group\">\n                    <label class=\"form-label\" for=\"email\">E-mail</label>\n                    <input type=\"email\" id=\"email\" name=\"email\" class=\"form-input\" placeholder=\"seu@email.com\" required>\n                </div>\n                <div class=\"form-group\">\n                    <label class=\"form-label\" for=\"service\">Tratamento de Interesse</label>\n                    <select id=\"service\" name=\"service\" class=\"form-select\" required>\n                        <option value=\"\">Selecione um tratamento</option>\n                        <option value=\"harmonizacao-facial\">Harmonização Facial</option>\n                        <option value=\"toxina-botulinica\">Toxina Botulínica</option>\n                        <option value=\"preenchedores\">Preenchedores Faciais</option>\n                        <option value=\"labial\">Preenchimento Labial</option>\n                        <option value=\"bioestimuladores\">Bioestimuladores</option>\n                        <option value=\"odontologia-estetica\">Odontologia Estética</option>\n                        <option value=\"outro\">Outro</option>\n                    </select>\n                </div>\n                <div class=\"form-group\">\n                    <label class=\"form-label\" for=\"message\">Mensagem</label>\n                    <textarea id=\"message\" name=\"message\" class=\"form-textarea\" placeholder=\"Conte-nos sobre suas expectativas...\" required></textarea>\n                </div>\n                <button type=\"submit\" class=\"form-submit\">Enviar Mensagem via WhatsApp</button>\n            </form>\n\n            <div class=\"contact-info\">\n                <div class=\"contact-info-item\">\n                    <h4>📍 Endereço</h4>\n                    <p>Av. Braz Olaia Acosta, 1900 - Sala 410<br>Nova Aliança, Ribeirão Preto - SP<br>CEP: 14026-040</p>\n                </div>\n                <div class=\"contact-info-item\">\n                    <h4>📱 WhatsApp</h4>\n                    <p>(16) 99371-8919<br><small>Atendimento imediato</small></p>\n                </div>\n                <div class=\"contact-info-item\">\n                    <h4>⏰ Horário</h4>\n                    <p>Segunda a Sexta<br>09:00 - 18:00</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-logo\">Dra. Brenda Dick</div>\n            <div class=\"footer-links\">\n                <a href=\"#inicio\" class=\"footer-link\">Início</a>\n                <a href=\"#sobre\" class=\"footer-link\">Sobre</a>\n                <a href=\"#servicos\" class=\"footer-link\">Serviços</a>\n                <a href=\"#depoimentos\" class=\"footer-link\">Depoimentos</a>\n                <a href=\"#contato\" class=\"footer-link\">Contato</a>\n            </div>\n            <p class=\"footer-copy\">© 2026 Dra. Brenda Dick - Odontologia Especializada e Harmonização Facial. Todos os direitos reservados.</p>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION SCROLL EFFECT\n        // ============================================\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                } else {\n                    nav.classList.remove('hidden');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // ============================================\n        // MOBILE MENU TOGGLE\n        // ============================================\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close menu when clicking a link\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function (e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER FOR SCROLL ANIMATIONS\n        // ============================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('animated');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        // Observe all animated elements\n        document.querySelectorAll('.wow-animate').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // FORM SUBMISSION - WHATSAPP INTEGRATION\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n        const whatsappNumber = '5516993718919';\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const formData = new FormData(contactForm);\n            const name = formData.get('name');\n            const email = formData.get('email');\n            const service = formData.get('service');\n            const message = formData.get('message');\n\n            const serviceNames = {\n                'harmonizacao-facial': 'Harmonização Facial',\n                'toxina-botulinica': 'Toxina Botulínica',\n                'preenchedores': 'Preenchedores Faciais',\n                'labial': 'Preenchimento Labial',\n                'bioestimuladores': 'Bioestimuladores',\n                'odontologia-estetica': 'Odontologia Estética',\n                'outro': 'Outro'\n            };\n\n            const whatsappMessage = `Olá Dra. Brenda Dick!\n\nMeu nome é *${name}*.\n\nGostaria de agendar uma consulta para: *${serviceNames[service] || service}*.\n\nMensagem: ${message}\n\nE-mail: ${email}`;\n\n            const whatsappURL = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappURL, '_blank');\n        });\n\n        // ============================================\n        // HERO PARALLAX EFFECT\n        // ============================================\n        const heroBlobs = document.querySelectorAll('.hero-blob');\n\n        document.addEventListener('mousemove', (e) => {\n            const mouseX = e.clientX / window.innerWidth;\n            const mouseY = e.clientY / window.innerHeight;\n\n            heroBlobs.forEach((blob, index) => {\n                const speed = (index + 1) * 20;\n                const x = (mouseX - 0.5) * speed;\n                const y = (mouseY - 0.5) * speed;\n\n                blob.style.transform = `translate(${x}px, ${y}px)`;\n            });\n        });\n\n        // ============================================\n        // LAZY LOADING FOR IMAGES\n        // ============================================\n        if ('IntersectionObserver' in window) {\n            const imageObserver = new IntersectionObserver((entries) => {\n                entries.forEach(entry => {\n                    if (entry.isIntersecting) {\n                        const img = entry.target;\n                        if (img.dataset.src) {\n                            img.src = img.dataset.src;\n                            img.removeAttribute('data-src');\n                        }\n                        imageObserver.unobserve(img);\n                    }\n                });\n            });\n\n            document.querySelectorAll('img[data-src]').forEach(img => {\n                imageObserver.observe(img);\n            });\n        }\n\n        // ============================================\n        // PREFERRED REDUCED MOTION CHECK\n        // ============================================\n        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n        if (prefersReducedMotion.matches) {\n            // Disable parallax effect\n            document.removeEventListener('mousemove', () => {});\n\n            // Disable floating animations\n            heroBlobs.forEach(blob => {\n                blob.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null}}
