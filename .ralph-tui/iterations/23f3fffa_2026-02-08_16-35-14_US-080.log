{"type":"assistant","message":{"id":"msg_20260209033613c800b097b65e4bc0","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"text","text":"Now I'll create the complete HTML file for Dra Rozi Silva with a unique **Plum Noir & Champagne Gold** aesthetic - this is a sophisticated combination of deep plum purple with champagne gold accents that creates a bold, distinctive, and memorable look."}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"d9f25cf0-e989-4246-b5df-dbfa652ff781","uuid":"949a1fad-b912-4e04-aae1-51637f76fbba"}
{"type":"assistant","message":{"id":"msg_20260209033613c800b097b65e4bc0","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_9898750476e049b6b4de8392","name":"Write","input":{"file_path":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-rozi-silva/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra Rozi Silva | Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra Rozi Silva - Harmonização Facial especializada em Ribeirão Preto. Estética avançada com atendimento personalizado e resultados naturais.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           CSS VARIABLES - Plum Noir & Champagne Gold\n           ============================================ */\n        :root {\n            /* Primary Palette - Plum Noir */\n            --color-plum-deep: #1A0A1E;\n            --color-plum: #2D1336;\n            --color-plum-mid: #4A1F52;\n            --color-plum-light: #6B3275;\n            --color-plum-pale: #8B4A94;\n\n            /* Accent Palette - Champagne Gold */\n            --color-gold: #D4A84B;\n            --color-gold-light: #E8C270;\n            --color-gold-mid: #F0D080;\n            --color-gold-dark: #C4983C;\n            --color-gold-deep: #B48830;\n            --color-gold-shimmer: #FAF0E0;\n\n            /* Neutral Accents */\n            --color-cream: #F8F5F0;\n            --color-cream-light: #FAF8F5;\n            --color-sage-muted: #7A8B7A;\n            --color-mauve: #C9B1C9;\n\n            /* Text Colors */\n            --color-text-primary: #FAF8F5;\n            --color-text-secondary: #D0C8D0;\n            --color-text-muted: #A090A0;\n            --color-text-on-light: #2D1336;\n\n            /* Gradients */\n            --gradient-plum: linear-gradient(135deg, var(--color-plum-deep) 0%, var(--color-plum) 50%, var(--color-plum-mid) 100%);\n            --gradient-gold: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-light) 100%);\n            --gradient-hero: linear-gradient(135deg, #1A0A1E 0%, #2D1336 40%, #4A1F52 100%);\n            --gradient-accent: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-shimmer) 100%);\n            --gradient-plum-subtle: linear-gradient(135deg, var(--color-plum) 0%, var(--color-plum-mid) 100%);\n\n            /* Organic Border Radius Shapes - Petal inspired */\n            --radius-petal-1: 70% 30% 50% 50% / 50% 40% 60% 50%;\n            --radius-petal-2: 50% 50% 65% 35% / 40% 60% 40% 60%;\n            --radius-petal-3: 60% 40% 45% 55% / 55% 45% 55% 45%;\n            --radius-petal-4: 40% 60% 55% 45% / 45% 55% 45% 55%;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n            --spacing-2xl: 8rem;\n\n            /* Typography */\n            --font-display: 'Cormorant Garamond', Georgia, serif;\n            --font-body: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(26, 10, 30, 0.3);\n            --shadow-medium: 0 8px 30px rgba(26, 10, 30, 0.4);\n            --shadow-strong: 0 12px 40px rgba(26, 10, 30, 0.5);\n            --shadow-glow: 0 0 30px rgba(212, 168, 75, 0.3);\n            --shadow-gold: 0 4px 25px rgba(212, 168, 75, 0.25);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.7;\n            color: var(--color-text-primary);\n            background: var(--color-plum-deep);\n            overflow-x: hidden;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-text-primary);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-secondary);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-sm) var(--spacing-md);\n            background: rgba(26, 10, 30, 0.95);\n            backdrop-filter: blur(20px);\n            transition: transform 0.3s ease;\n            box-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-gold);\n            text-decoration: none;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-secondary);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-gold);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover {\n            color: var(--color-gold);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--gradient-gold);\n            color: var(--color-plum-deep) !important;\n            padding: 0.75rem 1.5rem;\n            border-radius: 50px;\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-gold);\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-petal-1);\n            opacity: 0.15;\n            filter: blur(60px);\n            animation: float 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-gold);\n            top: -200px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .blob-2 {\n            width: 400px;\n            height: 400px;\n            background: linear-gradient(135deg, var(--color-plum-light) 0%, var(--color-mauve) 100%);\n            bottom: -150px;\n            left: -100px;\n            animation-delay: -5s;\n            border-radius: var(--radius-petal-2);\n        }\n\n        .blob-3 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-mauve) 100%);\n            top: 50%;\n            left: 20%;\n            animation-delay: -10s;\n            border-radius: var(--radius-petal-3);\n            opacity: 0.1;\n        }\n\n        .blob-4 {\n            width: 250px;\n            height: 250px;\n            background: linear-gradient(135deg, var(--color-gold-light) 0%, var(--color-mauve) 100%);\n            bottom: 20%;\n            right: 15%;\n            animation-delay: -15s;\n            border-radius: var(--radius-petal-4);\n            opacity: 0.12;\n        }\n\n        @keyframes float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg) scale(1.05);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg) scale(0.95);\n            }\n            75% {\n                transform: translate(-30px, -20px) rotate(3deg) scale(1.02);\n            }\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 10;\n            max-width: 900px;\n            text-align: center;\n        }\n\n        .hero-badge {\n            display: inline-block;\n            padding: 0.5rem 1.5rem;\n            background: rgba(212, 168, 75, 0.15);\n            border: 1px solid rgba(212, 168, 75, 0.3);\n            border-radius: 50px;\n            color: var(--color-gold);\n            font-size: 0.85rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-md);\n            opacity: 0;\n            animation: fadeInUp 0.8s ease forwards;\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            opacity: 0;\n            animation: fadeInUp 0.8s ease 0.2s forwards;\n        }\n\n        .hero-title .highlight {\n            background: var(--gradient-gold);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: clamp(1.1rem, 2vw, 1.3rem);\n            color: var(--color-text-secondary);\n            max-width: 700px;\n            margin: 0 auto var(--spacing-lg);\n            opacity: 0;\n            animation: fadeInUp 0.8s ease 0.4s forwards;\n        }\n\n        .hero-cta-group {\n            display: flex;\n            gap: var(--spacing-sm);\n            justify-content: center;\n            flex-wrap: wrap;\n            opacity: 0;\n            animation: fadeInUp 0.8s ease 0.6s forwards;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            border-radius: 50px;\n            cursor: pointer;\n            transition: var(--transition-base);\n            border: none;\n        }\n\n        .btn-primary {\n            background: var(--gradient-gold);\n            color: var(--color-plum-deep);\n            box-shadow: var(--shadow-gold);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 8px 35px rgba(212, 168, 75, 0.4);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-gold);\n            border: 2px solid var(--color-gold);\n        }\n\n        .btn-secondary:hover {\n            background: rgba(212, 168, 75, 0.1);\n            transform: translateY(-3px);\n        }\n\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        /* ============================================\n           SECTIONS COMMON\n           ============================================ */\n        .section {\n            padding: var(--spacing-xl) var(--spacing-md);\n            position: relative;\n        }\n\n        .section-dark {\n            background: var(--color-plum-deep);\n        }\n\n        .section-mid {\n            background: var(--color-plum);\n        }\n\n        .section-light {\n            background: var(--color-cream);\n            color: var(--color-text-on-light);\n        }\n\n        .section-light h2,\n        .section-light h3,\n        .section-light p {\n            color: var(--color-text-on-light);\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .section-badge {\n            display: inline-block;\n            padding: 0.4rem 1rem;\n            background: rgba(212, 168, 75, 0.15);\n            border-radius: 50px;\n            color: var(--color-gold);\n            font-size: 0.8rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .section-light .section-badge {\n            background: rgba(45, 19, 54, 0.1);\n            color: var(--color-plum);\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            background: var(--gradient-plum);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .ps-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n            align-items: center;\n        }\n\n        .ps-content {\n            position: relative;\n            z-index: 10;\n        }\n\n        .ps-problem {\n            padding: var(--spacing-md);\n            background: rgba(255, 100, 100, 0.08);\n            border-radius: 20px;\n            margin-bottom: var(--spacing-md);\n            border-left: 4px solid rgba(255, 100, 100, 0.4);\n        }\n\n        .ps-problem h3 {\n            color: #FF8A8A;\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .ps-solution {\n            padding: var(--spacing-md);\n            background: rgba(212, 168, 75, 0.1);\n            border-radius: 20px;\n            border-left: 4px solid var(--color-gold);\n        }\n\n        .ps-solution h3 {\n            color: var(--color-gold);\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .ps-image {\n            position: relative;\n        }\n\n        .ps-image-wrapper {\n            position: relative;\n            border-radius: 30px;\n            overflow: hidden;\n            box-shadow: var(--shadow-strong);\n        }\n\n        .ps-image-wrapper img {\n            width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        .ps-image-decoration {\n            position: absolute;\n            width: 200px;\n            height: 200px;\n            background: var(--gradient-gold);\n            border-radius: var(--radius-petal-1);\n            opacity: 0.2;\n            filter: blur(40px);\n            top: -50px;\n            right: -50px;\n            animation: float 15s ease-in-out infinite;\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            background: var(--color-plum-deep);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .service-card {\n            background: var(--gradient-plum-subtle);\n            border-radius: 24px;\n            padding: var(--spacing-md);\n            position: relative;\n            overflow: hidden;\n            transition: var(--transition-base);\n            border: 1px solid rgba(212, 168, 75, 0.1);\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            background: var(--gradient-gold);\n            opacity: 0;\n            transition: var(--transition-base);\n            z-index: 0;\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            border-color: rgba(212, 168, 75, 0.3);\n        }\n\n        .service-card:hover::before {\n            opacity: 0.05;\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-gold);\n            border-radius: 16px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-sm);\n            position: relative;\n            z-index: 1;\n        }\n\n        .service-icon svg {\n            width: 30px;\n            height: 30px;\n            color: var(--color-plum-deep);\n        }\n\n        .service-card h3 {\n            position: relative;\n            z-index: 1;\n            margin-bottom: 0.5rem;\n        }\n\n        .service-card p {\n            position: relative;\n            z-index: 1;\n            font-size: 0.95rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            background: var(--color-cream);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .testimonial-card {\n            background: white;\n            border-radius: 24px;\n            padding: var(--spacing-md);\n            box-shadow: 0 4px 20px rgba(45, 19, 54, 0.08);\n            transition: var(--transition-base);\n        }\n\n        .testimonial-card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 8px 30px rgba(45, 19, 54, 0.12);\n        }\n\n        .testimonial-stars {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .testimonial-stars svg {\n            width: 18px;\n            height: 18px;\n            color: var(--color-gold);\n        }\n\n        .testimonial-text {\n            font-style: italic;\n            color: var(--color-text-on-light);\n            margin-bottom: var(--spacing-sm);\n            line-height: 1.8;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-gold);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: var(--color-plum-deep);\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n            color: var(--color-plum);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            background: var(--gradient-plum);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-icon {\n            width: 80px;\n            height: 80px;\n            margin: 0 auto var(--spacing-sm);\n            background: var(--gradient-gold);\n            border-radius: 24px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n        }\n\n        .differential-icon svg {\n            width: 40px;\n            height: 40px;\n            color: var(--color-plum-deep);\n        }\n\n        .differential-item h3 {\n            font-size: 1.2rem;\n            margin-bottom: 0.5rem;\n        }\n\n        .differential-item p {\n            font-size: 0.9rem;\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            background: var(--color-plum-deep);\n        }\n\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n            align-items: start;\n        }\n\n        .contact-info h2 {\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .contact-info p {\n            font-size: 1.1rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-details {\n            margin-top: var(--spacing-lg);\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-item-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-gold);\n            border-radius: 14px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n        }\n\n        .contact-item-icon svg {\n            width: 24px;\n            height: 24px;\n            color: var(--color-plum-deep);\n        }\n\n        .contact-item-text h4 {\n            font-size: 1rem;\n            margin-bottom: 0.25rem;\n            color: var(--color-gold);\n        }\n\n        .contact-item-text p {\n            font-size: 0.95rem;\n            margin-bottom: 0;\n        }\n\n        .contact-form-wrapper {\n            background: var(--gradient-plum-subtle);\n            padding: var(--spacing-md);\n            border-radius: 24px;\n            border: 1px solid rgba(212, 168, 75, 0.2);\n        }\n\n        .contact-form {\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-sm);\n        }\n\n        .form-group {\n            display: flex;\n            flex-direction: column;\n            gap: 0.5rem;\n        }\n\n        .form-group label {\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-gold);\n        }\n\n        .form-group input,\n        .form-group select,\n        .form-group textarea {\n            padding: 1rem;\n            background: rgba(26, 10, 30, 0.5);\n            border: 1px solid rgba(212, 168, 75, 0.2);\n            border-radius: 12px;\n            color: var(--color-text-primary);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: var(--transition-fast);\n        }\n\n        .form-group input:focus,\n        .form-group select:focus,\n        .form-group textarea:focus {\n            outline: none;\n            border-color: var(--color-gold);\n            box-shadow: 0 0 0 3px rgba(212, 168, 75, 0.1);\n        }\n\n        .form-group textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            background: var(--gradient-gold);\n            color: var(--color-plum-deep);\n            padding: 1rem 2rem;\n            border: none;\n            border-radius: 50px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--color-plum-deep);\n            padding: var(--spacing-lg) var(--spacing-md) var(--spacing-md);\n            border-top: 1px solid rgba(212, 168, 75, 0.1);\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: 1fr auto;\n            gap: var(--spacing-lg);\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .footer-brand h3 {\n            color: var(--color-gold);\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-brand p {\n            font-size: 0.9rem;\n        }\n\n        .footer-links {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .footer-links a {\n            color: var(--color-text-secondary);\n            transition: var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-gold);\n        }\n\n        .footer-bottom {\n            text-align: center;\n            padding-top: var(--spacing-md);\n            border-top: 1px solid rgba(212, 168, 75, 0.1);\n        }\n\n        .footer-bottom p {\n            font-size: 0.85rem;\n            margin-bottom: 0;\n        }\n\n        /* ============================================\n           ANIMATIONS & INTERACTIONS\n           ============================================ */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(40px);\n            transition: opacity 0.8s ease, transform 0.8s ease;\n        }\n\n        .wow-fade-up.wow-visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.8s ease;\n        }\n\n        .wow-fade-in.wow-visible {\n            opacity: 1;\n        }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 0;\n                right: -100%;\n                width: 70%;\n                height: 100vh;\n                background: var(--color-plum);\n                flex-direction: column;\n                padding: var(--spacing-lg) var(--spacing-md);\n                transition: right 0.3s ease;\n                box-shadow: -10px 0 30px rgba(0, 0, 0, 0.3);\n            }\n\n            .nav-menu.active {\n                right: 0;\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n\n            .nav-toggle.active span:nth-child(1) {\n                transform: rotate(45deg) translate(6px, 6px);\n            }\n\n            .nav-toggle.active span:nth-child(2) {\n                opacity: 0;\n            }\n\n            .nav-toggle.active span:nth-child(3) {\n                transform: rotate(-45deg) translate(6px, -6px);\n            }\n\n            .ps-grid,\n            .contact-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .hero-cta-group {\n                flex-direction: column;\n            }\n\n            .hero-cta-group .btn {\n                width: 100%;\n                justify-content: center;\n            }\n\n            .footer-content {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .footer-links {\n                justify-content: center;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .section {\n                padding: var(--spacing-lg) var(--spacing-sm);\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        /* ============================================\n           REDUCED MOTION\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *,\n            *::before,\n            *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n\n            .hero-blob {\n                animation: none;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra Rozi Silva</a>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#inicio\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contato\" class=\"nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Toggle menu\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-blob blob-1\"></div>\n        <div class=\"hero-blob blob-2\"></div>\n        <div class=\"hero-blob blob-3\"></div>\n        <div class=\"hero-blob blob-4\"></div>\n\n        <div class=\"hero-content\">\n            <span class=\"hero-badge\">Harmonização Facial em Ribeirão Preto</span>\n            <h1 class=\"hero-title\">\n                Sua melhor versão com <span class=\"highlight\">resultados naturais</span> e elegância\n            </h1>\n            <p class=\"hero-subtitle\">\n                Transforme sua aparência com tratamentos de harmonização facial personalizados.\n                Dra Rozi Silva combina técnica avançada e sensibilidade estética para realçar sua beleza única.\n            </p>\n            <div class=\"hero-cta-group\">\n                <a href=\"#contato\" class=\"btn btn-primary\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect>\n                        <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"></line>\n                        <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"></line>\n                        <line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"></line>\n                    </svg>\n                    Agendar Consulta\n                </a>\n                <a href=\"#servicos\" class=\"btn btn-secondary\">\n                    Conhecer Tratamentos\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\" id=\"problema-solucao\">\n        <div class=\"container\">\n            <div class=\"ps-grid\">\n                <div class=\"ps-content wow-fade-up\">\n                    <span class=\"section-badge\">Por que nos escolher</span>\n                    <h2>Sua beleza natural valorizada</h2>\n\n                    <div class=\"ps-problem\">\n                        <h3>\n                            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                                <line x1=\"15\" y1=\"9\" x2=\"9\" y2=\"15\"></line>\n                                <line x1=\"9\" y1=\"9\" x2=\"15\" y2=\"15\"></line>\n                            </svg>\n                            O desafio\n                        </h3>\n                        <p>Muitas pessoas se sentem inseguras com os sinais de envelhecimento ou assimetrias faciais. Procuram tratamentos que ofereçam resultados visíveis, mas temem aparência artificial ou exagerada.</p>\n                    </div>\n\n                    <div class=\"ps-solution\">\n                        <h3>\n                            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <polyline points=\"20 6 9 17 4 12\"></polyline>\n                            </svg>\n                            Nossa solução\n                        </h3>\n                        <p>Com Dra Rozi Silva, você recebe tratamentos personalizados que respeitam suas características únicas. Usamos técnicas avançadas para resultados naturais, sutis e harmoniosos com sua expressão.</p>\n                    </div>\n                </div>\n\n                <div class=\"ps-image wow-fade-in\" data-delay=\"200\">\n                    <div class=\"ps-image-wrapper\">\n                        <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=800&q=80\" alt=\"Tratamento estático facial profissional\">\n                        <div class=\"ps-image-decoration\"></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-badge\">Nossos Tratamentos</span>\n                <h2>Procedimentos especializados</h2>\n                <p>Técnicas avançadas para realçar sua beleza natural com segurança e excelência</p>\n            </div>\n\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\" data-delay=\"0\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\"></path>\n                        </svg>\n                    </div>\n                    <h3>Harmonização Facial</h3>\n                    <p>Equilíbrio estético do rosto através de preenchedores e toxina botulínica, com foco em naturalidade e harmonia.</p>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"100\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                            <path d=\"M8 14s1.5 2 4 2 4-2 4-2\"></path>\n                            <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"></line>\n                            <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"></line>\n                        </svg>\n                    </div>\n                    <h3>Botox Terapêutico</h3>\n                    <p>Suavização de rugas e linhas de expressão com resultados naturais que preservam sua expressividade.</p>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z\"></path>\n                        </svg>\n                    </div>\n                    <h3>Preenchimento Labial</h3>\n                    <p>Volume e contorno dos lábios com técnicas que proporcionam aparência natural e sensual.</p>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"300\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"></path>\n                        </svg>\n                    </div>\n                    <h3>Bioestimuladores</h3>\n                    <p>Tratamento que estimula o colágeno natural, devolvendo firmeza e vitalidade à pele.</p>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2.5a.5.5 0 0 1 .5.5 3 3 0 0 0 3 3 .5.5 0 0 1 0 1 3 3 0 0 0-3 3 .5.5 0 0 1-1 0 3 3 0 0 0-3-3 .5.5 0 0 1 0-1 3 3 0 0 0 3-3 .5.5 0 0 1 .5-.5z\"></path>\n                        </svg>\n                    </div>\n                    <h3>Protocolo Skinbooster</h3>\n                    <p>Hidratação profunda e melhora da qualidade da pele para um aspecto luminoso e rejuvenescido.</p>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"500\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect>\n                            <line x1=\"3\" y1=\"9\" x2=\"21\" y2=\"9\"></line>\n                            <line x1=\"9\" y1=\"21\" x2=\"9\" y2=\"9\"></line>\n                        </svg>\n                    </div>\n                    <h3>Rinomodelação</h3>\n                    <p>Correção estética do nariz sem cirurgia, com preenchedores para harmonizar o perfil facial.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-badge\">Depoimentos</span>\n                <h2>O que nossas pacientes dizem</h2>\n                <p>Histórias reais de transformação e satisfação</p>\n            </div>\n\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"0\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"Fiz harmonização facial com a Dra Rozi e o resultado superou minhas expectativas. Ela é super atenciosa e explicou tudo detalhadamente. O resultado ficou muito natural!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div>\n                            <div class=\"testimonial-name\">Maria Clara</div>\n                            <p style=\"margin-bottom: 0; font-size: 0.85rem;\">Harmonização Facial</p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"100\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"Excelente profissional! Fiz preenchimento labial e ficou perfeito. Muito delicada e cuidadosa. O ambiente da clínica é super aconchegante e limpo.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AS</div>\n                        <div>\n                            <div class=\"testimonial-name\">Amanda Santos</div>\n                            <p style=\"margin-bottom: 0; font-size: 0.85rem;\">Preenchimento Labial</p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"Já fiz vários procedimentos com a Dra Rozi e sempre fico muito satisfeita. Ela tem uma mão leve e sabe exatamente o que fazer para melhorar cada rosto.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">JO</div>\n                        <div>\n                            <div class=\"testimonial-name\">Juliana Oliveira</div>\n                            <p style=\"margin-bottom: 0; font-size: 0.85rem;\">Bioestimuladores</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\" id=\"diferenciais\">\n        <div class=\"container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-badge\">Diferenciais</span>\n                <h2>Por que escolher Dra Rozi Silva</h2>\n                <p>Compromisso com excelência e resultados naturais</p>\n            </div>\n\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up\" data-delay=\"0\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"></path>\n                            <circle cx=\"12\" cy=\"7\" r=\"4\"></circle>\n                        </svg>\n                    </div>\n                    <h3>Atendimento Personalizado</h3>\n                    <p>Cada paciente é única. Desenvolvemos um plano de tratamento individualizado.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"100\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon>\n                        </svg>\n                    </div>\n                    <h3>Resultados Naturais</h3>\n                    <p>Foco em realçar sua beleza natural, nunca criar aparência artificial.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"200\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path>\n                        </svg>\n                    </div>\n                    <h3>Produtos Certificados</h3>\n                    <p>Utilizamos apenas produtos de alta qualidade com procedência garantida.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"300\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                            <polyline points=\"12 6 12 12 16 14\"></polyline>\n                        </svg>\n                    </div>\n                    <h3>Pontualidade</h3>\n                    <p>Respeito pelo seu tempo com agendamentos cumpridos rigorosamente.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"400\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"></rect>\n                            <line x1=\"8\" y1=\"21\" x2=\"16\" y2=\"21\"></line>\n                            <line x1=\"12\" y1=\"17\" x2=\"12\" y2=\"21\"></line>\n                        </svg>\n                    </div>\n                    <h3>Ambiente Aconchegante</h3>\n                    <p>Clínica preparada para oferecer conforto e segurança durante o atendimento.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"500\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path>\n                            <polyline points=\"22 4 12 14.01 9 11.01\"></polyline>\n                        </svg>\n                    </div>\n                    <h3>Acompanhamento Pós-Procedimento</h3>\n                    <p>Suporte contínuo para garantir sua satisfação e bem-estar.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"container\">\n            <div class=\"contact-grid\">\n                <div class=\"contact-info wow-fade-up\">\n                    <span class=\"section-badge\">Entre em Contato</span>\n                    <h2>Agende sua consulta</h2>\n                    <p>Estamos prontos para ajudá-lo a alcançar seus objetivos estéticos. Entre em contato e agende sua avaliação gratuita.</p>\n\n                    <div class=\"contact-details\">\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                    <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n                                    <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-text\">\n                                <h4>Endereço</h4>\n                                <p>Av. Pres. Kennedy, 935 - sala 04 - Ribeirânia<br>Ribeirão Preto - SP, 14096-340</p>\n                            </div>\n                        </div>\n\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                    <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-text\">\n                                <h4>WhatsApp</h4>\n                                <p>(16) 99146-5509</p>\n                            </div>\n                        </div>\n\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                    <rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"></rect>\n                                    <path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"></path>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-text\">\n                                <h4>Horário de Atendimento</h4>\n                                <p>Segunda a Sexta: 9h às 18h<br>Sábado: 9h às 13h</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"contact-form-wrapper wow-fade-in\" data-delay=\"200\">\n                    <form class=\"contact-form\" id=\"contactForm\">\n                        <div class=\"form-group\">\n                            <label for=\"name\">Nome completo</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" required placeholder=\"Seu nome\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"phone\">Telefone/WhatsApp</label>\n                            <input type=\"tel\" id=\"phone\" name=\"phone\" required placeholder=\"(16) 99999-9999\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"service\">Tratamento de interesse</label>\n                            <select id=\"service\" name=\"service\" required>\n                                <option value=\"\">Selecione um tratamento</option>\n                                <option value=\"harmonizacao\">Harmonização Facial</option>\n                                <option value=\"botox\">Botox</option>\n                                <option value=\"labial\">Preenchimento Labial</option>\n                                <option value=\"bioestimulador\">Bioestimuladores</option>\n                                <option value=\"skinbooster\">Skinbooster</option>\n                                <option value=\"rinomodelacao\">Rinomodelação</option>\n                                <option value=\"outro\">Outro</option>\n                            </select>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"message\">Mensagem</label>\n                            <textarea id=\"message\" name=\"message\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                        </div>\n                        <button type=\"submit\" class=\"form-submit\">Enviar via WhatsApp</button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-brand\">\n                    <h3>Dra Rozi Silva</h3>\n                    <p>Harmonização Facial e Estética Avançada em Ribeirão Preto</p>\n                </div>\n                <ul class=\"footer-links\">\n                    <li><a href=\"#inicio\">Início</a></li>\n                    <li><a href=\"#servicos\">Serviços</a></li>\n                    <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                    <li><a href=\"#contato\">Contato</a></li>\n                </ul>\n            </div>\n            <div class=\"footer-bottom\">\n                <p>&copy; 2024 Dra Rozi Silva. Todos os direitos reservados.</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION SCROLL EFFECT\n        // ============================================\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > lastScroll && currentScroll > 100) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // ============================================\n        // MOBILE MENU TOGGLE\n        // ============================================\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n\n        navToggle.addEventListener('click', () => {\n            navToggle.classList.toggle('active');\n            navMenu.classList.toggle('active');\n        });\n\n        // Close menu when clicking a link\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navToggle.classList.remove('active');\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function (e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER ANIMATIONS\n        // ============================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || 0;\n                    setTimeout(() => {\n                        entry.target.classList.add('wow-visible');\n                    }, delay);\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // CONTACT FORM - WHATSAPP INTEGRATION\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const formData = new FormData(contactForm);\n            const name = formData.get('name');\n            const phone = formData.get('phone');\n            const service = formData.get('service');\n            const message = formData.get('message');\n\n            const serviceNames = {\n                'harmonizacao': 'Harmonização Facial',\n                'botox': 'Botox',\n                'labial': 'Preenchimento Labial',\n                'bioestimulador': 'Bioestimuladores',\n                'skinbooster': 'Skinbooster',\n                'rinomodelacao': 'Rinomodelação',\n                'outro': 'Outro tratamento'\n            };\n\n            const whatsappMessage = `Olá! Meu nome é ${name}.\\nTelefone: ${phone}\\nTratamento de interesse: ${serviceNames[service] || service}\\n\\nMensagem: ${message || 'Gostaria de agendar uma consulta.'}`;\n\n            const whatsappUrl = `https://wa.me/5516991465509?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappUrl, '_blank');\n        });\n\n        // ============================================\n        // STAGGERED ANIMATION ON PAGE LOAD\n        // ============================================\n        window.addEventListener('load', () => {\n            document.body.classList.add('loaded');\n        });\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"d9f25cf0-e989-4246-b5df-dbfa652ff781","uuid":"fe92ae63-7b83-4cb9-83cf-8c9ae3e6cb7d"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_9898750476e049b6b4de8392","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-rozi-silva/index.html"}]},"parent_tool_use_id":null,"session_id":"d9f25cf0-e989-4246-b5df-dbfa652ff781","uuid":"b500ceb3-aacd-4786-891c-332d3e351aa4","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-rozi-silva/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra Rozi Silva | Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra Rozi Silva - Harmonização Facial especializada em Ribeirão Preto. Estética avançada com atendimento personalizado e resultados naturais.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           CSS VARIABLES - Plum Noir & Champagne Gold\n           ============================================ */\n        :root {\n            /* Primary Palette - Plum Noir */\n            --color-plum-deep: #1A0A1E;\n            --color-plum: #2D1336;\n            --color-plum-mid: #4A1F52;\n            --color-plum-light: #6B3275;\n            --color-plum-pale: #8B4A94;\n\n            /* Accent Palette - Champagne Gold */\n            --color-gold: #D4A84B;\n            --color-gold-light: #E8C270;\n            --color-gold-mid: #F0D080;\n            --color-gold-dark: #C4983C;\n            --color-gold-deep: #B48830;\n            --color-gold-shimmer: #FAF0E0;\n\n            /* Neutral Accents */\n            --color-cream: #F8F5F0;\n            --color-cream-light: #FAF8F5;\n            --color-sage-muted: #7A8B7A;\n            --color-mauve: #C9B1C9;\n\n            /* Text Colors */\n            --color-text-primary: #FAF8F5;\n            --color-text-secondary: #D0C8D0;\n            --color-text-muted: #A090A0;\n            --color-text-on-light: #2D1336;\n\n            /* Gradients */\n            --gradient-plum: linear-gradient(135deg, var(--color-plum-deep) 0%, var(--color-plum) 50%, var(--color-plum-mid) 100%);\n            --gradient-gold: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-light) 100%);\n            --gradient-hero: linear-gradient(135deg, #1A0A1E 0%, #2D1336 40%, #4A1F52 100%);\n            --gradient-accent: linear-gradient(135deg, var(--color-gold) 0%, var(--color-gold-shimmer) 100%);\n            --gradient-plum-subtle: linear-gradient(135deg, var(--color-plum) 0%, var(--color-plum-mid) 100%);\n\n            /* Organic Border Radius Shapes - Petal inspired */\n            --radius-petal-1: 70% 30% 50% 50% / 50% 40% 60% 50%;\n            --radius-petal-2: 50% 50% 65% 35% / 40% 60% 40% 60%;\n            --radius-petal-3: 60% 40% 45% 55% / 55% 45% 55% 45%;\n            --radius-petal-4: 40% 60% 55% 45% / 45% 55% 45% 55%;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n            --spacing-2xl: 8rem;\n\n            /* Typography */\n            --font-display: 'Cormorant Garamond', Georgia, serif;\n            --font-body: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(26, 10, 30, 0.3);\n            --shadow-medium: 0 8px 30px rgba(26, 10, 30, 0.4);\n            --shadow-strong: 0 12px 40px rgba(26, 10, 30, 0.5);\n            --shadow-glow: 0 0 30px rgba(212, 168, 75, 0.3);\n            --shadow-gold: 0 4px 25px rgba(212, 168, 75, 0.25);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.7;\n            color: var(--color-text-primary);\n            background: var(--color-plum-deep);\n            overflow-x: hidden;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-text-primary);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-secondary);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-sm) var(--spacing-md);\n            background: rgba(26, 10, 30, 0.95);\n            backdrop-filter: blur(20px);\n            transition: transform 0.3s ease;\n            box-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-gold);\n            text-decoration: none;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-secondary);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-gold);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover {\n            color: var(--color-gold);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--gradient-gold);\n            color: var(--color-plum-deep) !important;\n            padding: 0.75rem 1.5rem;\n            border-radius: 50px;\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-gold);\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-petal-1);\n            opacity: 0.15;\n            filter: blur(60px);\n            animation: float 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-gold);\n            top: -200px;\n            right: -100px;\n            animation-delay: 0s;\n        }\n\n        .blob-2 {\n            width: 400px;\n            height: 400px;\n            background: linear-gradient(135deg, var(--color-plum-light) 0%, var(--color-mauve) 100%);\n            bottom: -150px;\n            left: -100px;\n            animation-delay: -5s;\n            border-radius: var(--radius-petal-2);\n        }\n\n        .blob-3 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-mauve) 100%);\n            top: 50%;\n            left: 20%;\n            animation-delay: -10s;\n            border-radius: var(--radius-petal-3);\n            opacity: 0.1;\n        }\n\n        .blob-4 {\n            width: 250px;\n            height: 250px;\n            background: linear-gradient(135deg, var(--color-gold-light) 0%, var(--color-mauve) 100%);\n            bottom: 20%;\n            right: 15%;\n            animation-delay: -15s;\n            border-radius: var(--radius-petal-4);\n            opacity: 0.12;\n        }\n\n        @keyframes float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(5deg) scale(1.05);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(-5deg) scale(0.95);\n            }\n            75% {\n                transform: translate(-30px, -20px) rotate(3deg) scale(1.02);\n            }\n        }\n\n        .hero-content {\n            position: relative;\n            z-index: 10;\n            max-width: 900px;\n            text-align: center;\n        }\n\n        .hero-badge {\n            display: inline-block;\n            padding: 0.5rem 1.5rem;\n            background: rgba(212, 168, 75, 0.15);\n            border: 1px solid rgba(212, 168, 75, 0.3);\n            border-radius: 50px;\n            color: var(--color-gold);\n            font-size: 0.85rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-md);\n            opacity: 0;\n            animation: fadeInUp 0.8s ease forwards;\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            opacity: 0;\n            animation: fadeInUp 0.8s ease 0.2s forwards;\n        }\n\n        .hero-title .highlight {\n            background: var(--gradient-gold);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .hero-subtitle {\n            font-size: clamp(1.1rem, 2vw, 1.3rem);\n            color: var(--color-text-secondary);\n            max-width: 700px;\n            margin: 0 auto var(--spacing-lg);\n            opacity: 0;\n            animation: fadeInUp 0.8s ease 0.4s forwards;\n        }\n\n        .hero-cta-group {\n            display: flex;\n            gap: var(--spacing-sm);\n            justify-content: center;\n            flex-wrap: wrap;\n            opacity: 0;\n            animation: fadeInUp 0.8s ease 0.6s forwards;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            border-radius: 50px;\n            cursor: pointer;\n            transition: var(--transition-base);\n            border: none;\n        }\n\n        .btn-primary {\n            background: var(--gradient-gold);\n            color: var(--color-plum-deep);\n            box-shadow: var(--shadow-gold);\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 8px 35px rgba(212, 168, 75, 0.4);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-gold);\n            border: 2px solid var(--color-gold);\n        }\n\n        .btn-secondary:hover {\n            background: rgba(212, 168, 75, 0.1);\n            transform: translateY(-3px);\n        }\n\n        @keyframes fadeInUp {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        /* ============================================\n           SECTIONS COMMON\n           ============================================ */\n        .section {\n            padding: var(--spacing-xl) var(--spacing-md);\n            position: relative;\n        }\n\n        .section-dark {\n            background: var(--color-plum-deep);\n        }\n\n        .section-mid {\n            background: var(--color-plum);\n        }\n\n        .section-light {\n            background: var(--color-cream);\n            color: var(--color-text-on-light);\n        }\n\n        .section-light h2,\n        .section-light h3,\n        .section-light p {\n            color: var(--color-text-on-light);\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .section-badge {\n            display: inline-block;\n            padding: 0.4rem 1rem;\n            background: rgba(212, 168, 75, 0.15);\n            border-radius: 50px;\n            color: var(--color-gold);\n            font-size: 0.8rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .section-light .section-badge {\n            background: rgba(45, 19, 54, 0.1);\n            color: var(--color-plum);\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            background: var(--gradient-plum);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .ps-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n            align-items: center;\n        }\n\n        .ps-content {\n            position: relative;\n            z-index: 10;\n        }\n\n        .ps-problem {\n            padding: var(--spacing-md);\n            background: rgba(255, 100, 100, 0.08);\n            border-radius: 20px;\n            margin-bottom: var(--spacing-md);\n            border-left: 4px solid rgba(255, 100, 100, 0.4);\n        }\n\n        .ps-problem h3 {\n            color: #FF8A8A;\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .ps-solution {\n            padding: var(--spacing-md);\n            background: rgba(212, 168, 75, 0.1);\n            border-radius: 20px;\n            border-left: 4px solid var(--color-gold);\n        }\n\n        .ps-solution h3 {\n            color: var(--color-gold);\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .ps-image {\n            position: relative;\n        }\n\n        .ps-image-wrapper {\n            position: relative;\n            border-radius: 30px;\n            overflow: hidden;\n            box-shadow: var(--shadow-strong);\n        }\n\n        .ps-image-wrapper img {\n            width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        .ps-image-decoration {\n            position: absolute;\n            width: 200px;\n            height: 200px;\n            background: var(--gradient-gold);\n            border-radius: var(--radius-petal-1);\n            opacity: 0.2;\n            filter: blur(40px);\n            top: -50px;\n            right: -50px;\n            animation: float 15s ease-in-out infinite;\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            background: var(--color-plum-deep);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .service-card {\n            background: var(--gradient-plum-subtle);\n            border-radius: 24px;\n            padding: var(--spacing-md);\n            position: relative;\n            overflow: hidden;\n            transition: var(--transition-base);\n            border: 1px solid rgba(212, 168, 75, 0.1);\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            background: var(--gradient-gold);\n            opacity: 0;\n            transition: var(--transition-base);\n            z-index: 0;\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            border-color: rgba(212, 168, 75, 0.3);\n        }\n\n        .service-card:hover::before {\n            opacity: 0.05;\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-gold);\n            border-radius: 16px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-sm);\n            position: relative;\n            z-index: 1;\n        }\n\n        .service-icon svg {\n            width: 30px;\n            height: 30px;\n            color: var(--color-plum-deep);\n        }\n\n        .service-card h3 {\n            position: relative;\n            z-index: 1;\n            margin-bottom: 0.5rem;\n        }\n\n        .service-card p {\n            position: relative;\n            z-index: 1;\n            font-size: 0.95rem;\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            background: var(--color-cream);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .testimonial-card {\n            background: white;\n            border-radius: 24px;\n            padding: var(--spacing-md);\n            box-shadow: 0 4px 20px rgba(45, 19, 54, 0.08);\n            transition: var(--transition-base);\n        }\n\n        .testimonial-card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 8px 30px rgba(45, 19, 54, 0.12);\n        }\n\n        .testimonial-stars {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .testimonial-stars svg {\n            width: 18px;\n            height: 18px;\n            color: var(--color-gold);\n        }\n\n        .testimonial-text {\n            font-style: italic;\n            color: var(--color-text-on-light);\n            margin-bottom: var(--spacing-sm);\n            line-height: 1.8;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-gold);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: var(--color-plum-deep);\n        }\n\n        .testimonial-name {\n            font-weight: 600;\n            color: var(--color-plum);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            background: var(--gradient-plum);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: var(--spacing-md);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-icon {\n            width: 80px;\n            height: 80px;\n            margin: 0 auto var(--spacing-sm);\n            background: var(--gradient-gold);\n            border-radius: 24px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n        }\n\n        .differential-icon svg {\n            width: 40px;\n            height: 40px;\n            color: var(--color-plum-deep);\n        }\n\n        .differential-item h3 {\n            font-size: 1.2rem;\n            margin-bottom: 0.5rem;\n        }\n\n        .differential-item p {\n            font-size: 0.9rem;\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            background: var(--color-plum-deep);\n        }\n\n        .contact-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n            align-items: start;\n        }\n\n        .contact-info h2 {\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .contact-info p {\n            font-size: 1.1rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-details {\n            margin-top: var(--spacing-lg);\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n            margin-bottom: var(--spacing-md);\n        }\n\n        .contact-item-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-gold);\n            border-radius: 14px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n        }\n\n        .contact-item-icon svg {\n            width: 24px;\n            height: 24px;\n            color: var(--color-plum-deep);\n        }\n\n        .contact-item-text h4 {\n            font-size: 1rem;\n            margin-bottom: 0.25rem;\n            color: var(--color-gold);\n        }\n\n        .contact-item-text p {\n            font-size: 0.95rem;\n            margin-bottom: 0;\n        }\n\n        .contact-form-wrapper {\n            background: var(--gradient-plum-subtle);\n            padding: var(--spacing-md);\n            border-radius: 24px;\n            border: 1px solid rgba(212, 168, 75, 0.2);\n        }\n\n        .contact-form {\n            display: flex;\n            flex-direction: column;\n            gap: var(--spacing-sm);\n        }\n\n        .form-group {\n            display: flex;\n            flex-direction: column;\n            gap: 0.5rem;\n        }\n\n        .form-group label {\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-gold);\n        }\n\n        .form-group input,\n        .form-group select,\n        .form-group textarea {\n            padding: 1rem;\n            background: rgba(26, 10, 30, 0.5);\n            border: 1px solid rgba(212, 168, 75, 0.2);\n            border-radius: 12px;\n            color: var(--color-text-primary);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            transition: var(--transition-fast);\n        }\n\n        .form-group input:focus,\n        .form-group select:focus,\n        .form-group textarea:focus {\n            outline: none;\n            border-color: var(--color-gold);\n            box-shadow: 0 0 0 3px rgba(212, 168, 75, 0.1);\n        }\n\n        .form-group textarea {\n            min-height: 120px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            background: var(--gradient-gold);\n            color: var(--color-plum-deep);\n            padding: 1rem 2rem;\n            border: none;\n            border-radius: 50px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--color-plum-deep);\n            padding: var(--spacing-lg) var(--spacing-md) var(--spacing-md);\n            border-top: 1px solid rgba(212, 168, 75, 0.1);\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: 1fr auto;\n            gap: var(--spacing-lg);\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .footer-brand h3 {\n            color: var(--color-gold);\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-brand p {\n            font-size: 0.9rem;\n        }\n\n        .footer-links {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .footer-links a {\n            color: var(--color-text-secondary);\n            transition: var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-gold);\n        }\n\n        .footer-bottom {\n            text-align: center;\n            padding-top: var(--spacing-md);\n            border-top: 1px solid rgba(212, 168, 75, 0.1);\n        }\n\n        .footer-bottom p {\n            font-size: 0.85rem;\n            margin-bottom: 0;\n        }\n\n        /* ============================================\n           ANIMATIONS & INTERACTIONS\n           ============================================ */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(40px);\n            transition: opacity 0.8s ease, transform 0.8s ease;\n        }\n\n        .wow-fade-up.wow-visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-in {\n            opacity: 0;\n            transition: opacity 0.8s ease;\n        }\n\n        .wow-fade-in.wow-visible {\n            opacity: 1;\n        }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 0;\n                right: -100%;\n                width: 70%;\n                height: 100vh;\n                background: var(--color-plum);\n                flex-direction: column;\n                padding: var(--spacing-lg) var(--spacing-md);\n                transition: right 0.3s ease;\n                box-shadow: -10px 0 30px rgba(0, 0, 0, 0.3);\n            }\n\n            .nav-menu.active {\n                right: 0;\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n\n            .nav-toggle.active span:nth-child(1) {\n                transform: rotate(45deg) translate(6px, 6px);\n            }\n\n            .nav-toggle.active span:nth-child(2) {\n                opacity: 0;\n            }\n\n            .nav-toggle.active span:nth-child(3) {\n                transform: rotate(-45deg) translate(6px, -6px);\n            }\n\n            .ps-grid,\n            .contact-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .hero-cta-group {\n                flex-direction: column;\n            }\n\n            .hero-cta-group .btn {\n                width: 100%;\n                justify-content: center;\n            }\n\n            .footer-content {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .footer-links {\n                justify-content: center;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .section {\n                padding: var(--spacing-lg) var(--spacing-sm);\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        /* ============================================\n           REDUCED MOTION\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *,\n            *::before,\n            *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n\n            .hero-blob {\n                animation: none;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra Rozi Silva</a>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#inicio\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contato\" class=\"nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Toggle menu\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"inicio\">\n        <div class=\"hero-blob blob-1\"></div>\n        <div class=\"hero-blob blob-2\"></div>\n        <div class=\"hero-blob blob-3\"></div>\n        <div class=\"hero-blob blob-4\"></div>\n\n        <div class=\"hero-content\">\n            <span class=\"hero-badge\">Harmonização Facial em Ribeirão Preto</span>\n            <h1 class=\"hero-title\">\n                Sua melhor versão com <span class=\"highlight\">resultados naturais</span> e elegância\n            </h1>\n            <p class=\"hero-subtitle\">\n                Transforme sua aparência com tratamentos de harmonização facial personalizados.\n                Dra Rozi Silva combina técnica avançada e sensibilidade estética para realçar sua beleza única.\n            </p>\n            <div class=\"hero-cta-group\">\n                <a href=\"#contato\" class=\"btn btn-primary\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect>\n                        <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"></line>\n                        <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"></line>\n                        <line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"></line>\n                    </svg>\n                    Agendar Consulta\n                </a>\n                <a href=\"#servicos\" class=\"btn btn-secondary\">\n                    Conhecer Tratamentos\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\" id=\"problema-solucao\">\n        <div class=\"container\">\n            <div class=\"ps-grid\">\n                <div class=\"ps-content wow-fade-up\">\n                    <span class=\"section-badge\">Por que nos escolher</span>\n                    <h2>Sua beleza natural valorizada</h2>\n\n                    <div class=\"ps-problem\">\n                        <h3>\n                            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                                <line x1=\"15\" y1=\"9\" x2=\"9\" y2=\"15\"></line>\n                                <line x1=\"9\" y1=\"9\" x2=\"15\" y2=\"15\"></line>\n                            </svg>\n                            O desafio\n                        </h3>\n                        <p>Muitas pessoas se sentem inseguras com os sinais de envelhecimento ou assimetrias faciais. Procuram tratamentos que ofereçam resultados visíveis, mas temem aparência artificial ou exagerada.</p>\n                    </div>\n\n                    <div class=\"ps-solution\">\n                        <h3>\n                            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <polyline points=\"20 6 9 17 4 12\"></polyline>\n                            </svg>\n                            Nossa solução\n                        </h3>\n                        <p>Com Dra Rozi Silva, você recebe tratamentos personalizados que respeitam suas características únicas. Usamos técnicas avançadas para resultados naturais, sutis e harmoniosos com sua expressão.</p>\n                    </div>\n                </div>\n\n                <div class=\"ps-image wow-fade-in\" data-delay=\"200\">\n                    <div class=\"ps-image-wrapper\">\n                        <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=800&q=80\" alt=\"Tratamento estático facial profissional\">\n                        <div class=\"ps-image-decoration\"></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-badge\">Nossos Tratamentos</span>\n                <h2>Procedimentos especializados</h2>\n                <p>Técnicas avançadas para realçar sua beleza natural com segurança e excelência</p>\n            </div>\n\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\" data-delay=\"0\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\"></path>\n                        </svg>\n                    </div>\n                    <h3>Harmonização Facial</h3>\n                    <p>Equilíbrio estético do rosto através de preenchedores e toxina botulínica, com foco em naturalidade e harmonia.</p>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"100\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                            <path d=\"M8 14s1.5 2 4 2 4-2 4-2\"></path>\n                            <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"></line>\n                            <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"></line>\n                        </svg>\n                    </div>\n                    <h3>Botox Terapêutico</h3>\n                    <p>Suavização de rugas e linhas de expressão com resultados naturais que preservam sua expressividade.</p>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z\"></path>\n                        </svg>\n                    </div>\n                    <h3>Preenchimento Labial</h3>\n                    <p>Volume e contorno dos lábios com técnicas que proporcionam aparência natural e sensual.</p>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"300\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"></path>\n                        </svg>\n                    </div>\n                    <h3>Bioestimuladores</h3>\n                    <p>Tratamento que estimula o colágeno natural, devolvendo firmeza e vitalidade à pele.</p>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2.5a.5.5 0 0 1 .5.5 3 3 0 0 0 3 3 .5.5 0 0 1 0 1 3 3 0 0 0-3 3 .5.5 0 0 1-1 0 3 3 0 0 0-3-3 .5.5 0 0 1 0-1 3 3 0 0 0 3-3 .5.5 0 0 1 .5-.5z\"></path>\n                        </svg>\n                    </div>\n                    <h3>Protocolo Skinbooster</h3>\n                    <p>Hidratação profunda e melhora da qualidade da pele para um aspecto luminoso e rejuvenescido.</p>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"500\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect>\n                            <line x1=\"3\" y1=\"9\" x2=\"21\" y2=\"9\"></line>\n                            <line x1=\"9\" y1=\"21\" x2=\"9\" y2=\"9\"></line>\n                        </svg>\n                    </div>\n                    <h3>Rinomodelação</h3>\n                    <p>Correção estética do nariz sem cirurgia, com preenchedores para harmonizar o perfil facial.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-badge\">Depoimentos</span>\n                <h2>O que nossas pacientes dizem</h2>\n                <p>Histórias reais de transformação e satisfação</p>\n            </div>\n\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"0\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"Fiz harmonização facial com a Dra Rozi e o resultado superou minhas expectativas. Ela é super atenciosa e explicou tudo detalhadamente. O resultado ficou muito natural!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div>\n                            <div class=\"testimonial-name\">Maria Clara</div>\n                            <p style=\"margin-bottom: 0; font-size: 0.85rem;\">Harmonização Facial</p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"100\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"Excelente profissional! Fiz preenchimento labial e ficou perfeito. Muito delicada e cuidadosa. O ambiente da clínica é super aconchegante e limpo.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">AS</div>\n                        <div>\n                            <div class=\"testimonial-name\">Amanda Santos</div>\n                            <p style=\"margin-bottom: 0; font-size: 0.85rem;\">Preenchimento Labial</p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"></path></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"Já fiz vários procedimentos com a Dra Rozi e sempre fico muito satisfeita. Ela tem uma mão leve e sabe exatamente o que fazer para melhorar cada rosto.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">JO</div>\n                        <div>\n                            <div class=\"testimonial-name\">Juliana Oliveira</div>\n                            <p style=\"margin-bottom: 0; font-size: 0.85rem;\">Bioestimuladores</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\" id=\"diferenciais\">\n        <div class=\"container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-badge\">Diferenciais</span>\n                <h2>Por que escolher Dra Rozi Silva</h2>\n                <p>Compromisso com excelência e resultados naturais</p>\n            </div>\n\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up\" data-delay=\"0\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"></path>\n                            <circle cx=\"12\" cy=\"7\" r=\"4\"></circle>\n                        </svg>\n                    </div>\n                    <h3>Atendimento Personalizado</h3>\n                    <p>Cada paciente é única. Desenvolvemos um plano de tratamento individualizado.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"100\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon>\n                        </svg>\n                    </div>\n                    <h3>Resultados Naturais</h3>\n                    <p>Foco em realçar sua beleza natural, nunca criar aparência artificial.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"200\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path>\n                        </svg>\n                    </div>\n                    <h3>Produtos Certificados</h3>\n                    <p>Utilizamos apenas produtos de alta qualidade com procedência garantida.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"300\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                            <polyline points=\"12 6 12 12 16 14\"></polyline>\n                        </svg>\n                    </div>\n                    <h3>Pontualidade</h3>\n                    <p>Respeito pelo seu tempo com agendamentos cumpridos rigorosamente.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"400\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"></rect>\n                            <line x1=\"8\" y1=\"21\" x2=\"16\" y2=\"21\"></line>\n                            <line x1=\"12\" y1=\"17\" x2=\"12\" y2=\"21\"></line>\n                        </svg>\n                    </div>\n                    <h3>Ambiente Aconchegante</h3>\n                    <p>Clínica preparada para oferecer conforto e segurança durante o atendimento.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"500\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path>\n                            <polyline points=\"22 4 12 14.01 9 11.01\"></polyline>\n                        </svg>\n                    </div>\n                    <h3>Acompanhamento Pós-Procedimento</h3>\n                    <p>Suporte contínuo para garantir sua satisfação e bem-estar.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"container\">\n            <div class=\"contact-grid\">\n                <div class=\"contact-info wow-fade-up\">\n                    <span class=\"section-badge\">Entre em Contato</span>\n                    <h2>Agende sua consulta</h2>\n                    <p>Estamos prontos para ajudá-lo a alcançar seus objetivos estéticos. Entre em contato e agende sua avaliação gratuita.</p>\n\n                    <div class=\"contact-details\">\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                    <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path>\n                                    <circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-text\">\n                                <h4>Endereço</h4>\n                                <p>Av. Pres. Kennedy, 935 - sala 04 - Ribeirânia<br>Ribeirão Preto - SP, 14096-340</p>\n                            </div>\n                        </div>\n\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                    <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-text\">\n                                <h4>WhatsApp</h4>\n                                <p>(16) 99146-5509</p>\n                            </div>\n                        </div>\n\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                    <rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"></rect>\n                                    <path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"></path>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-text\">\n                                <h4>Horário de Atendimento</h4>\n                                <p>Segunda a Sexta: 9h às 18h<br>Sábado: 9h às 13h</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"contact-form-wrapper wow-fade-in\" data-delay=\"200\">\n                    <form class=\"contact-form\" id=\"contactForm\">\n                        <div class=\"form-group\">\n                            <label for=\"name\">Nome completo</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" required placeholder=\"Seu nome\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"phone\">Telefone/WhatsApp</label>\n                            <input type=\"tel\" id=\"phone\" name=\"phone\" required placeholder=\"(16) 99999-9999\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"service\">Tratamento de interesse</label>\n                            <select id=\"service\" name=\"service\" required>\n                                <option value=\"\">Selecione um tratamento</option>\n                                <option value=\"harmonizacao\">Harmonização Facial</option>\n                                <option value=\"botox\">Botox</option>\n                                <option value=\"labial\">Preenchimento Labial</option>\n                                <option value=\"bioestimulador\">Bioestimuladores</option>\n                                <option value=\"skinbooster\">Skinbooster</option>\n                                <option value=\"rinomodelacao\">Rinomodelação</option>\n                                <option value=\"outro\">Outro</option>\n                            </select>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"message\">Mensagem</label>\n                            <textarea id=\"message\" name=\"message\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                        </div>\n                        <button type=\"submit\" class=\"form-submit\">Enviar via WhatsApp</button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-brand\">\n                    <h3>Dra Rozi Silva</h3>\n                    <p>Harmonização Facial e Estética Avançada em Ribeirão Preto</p>\n                </div>\n                <ul class=\"footer-links\">\n                    <li><a href=\"#inicio\">Início</a></li>\n                    <li><a href=\"#servicos\">Serviços</a></li>\n                    <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                    <li><a href=\"#contato\">Contato</a></li>\n                </ul>\n            </div>\n            <div class=\"footer-bottom\">\n                <p>&copy; 2024 Dra Rozi Silva. Todos os direitos reservados.</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION SCROLL EFFECT\n        // ============================================\n        let lastScroll = 0;\n        const nav = document.getElementById('nav');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > lastScroll && currentScroll > 100) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // ============================================\n        // MOBILE MENU TOGGLE\n        // ============================================\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n\n        navToggle.addEventListener('click', () => {\n            navToggle.classList.toggle('active');\n            navMenu.classList.toggle('active');\n        });\n\n        // Close menu when clicking a link\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navToggle.classList.remove('active');\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function (e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER ANIMATIONS\n        // ============================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || 0;\n                    setTimeout(() => {\n                        entry.target.classList.add('wow-visible');\n                    }, delay);\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up, .wow-fade-in').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // CONTACT FORM - WHATSAPP INTEGRATION\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const formData = new FormData(contactForm);\n            const name = formData.get('name');\n            const phone = formData.get('phone');\n            const service = formData.get('service');\n            const message = formData.get('message');\n\n            const serviceNames = {\n                'harmonizacao': 'Harmonização Facial',\n                'botox': 'Botox',\n                'labial': 'Preenchimento Labial',\n                'bioestimulador': 'Bioestimuladores',\n                'skinbooster': 'Skinbooster',\n                'rinomodelacao': 'Rinomodelação',\n                'outro': 'Outro tratamento'\n            };\n\n            const whatsappMessage = `Olá! Meu nome é ${name}.\\nTelefone: ${phone}\\nTratamento de interesse: ${serviceNames[service] || service}\\n\\nMensagem: ${message || 'Gostaria de agendar uma consulta.'}`;\n\n            const whatsappUrl = `https://wa.me/5516991465509?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappUrl, '_blank');\n        });\n\n        // ============================================\n        // STAGGERED ANIMATION ON PAGE LOAD\n        // ============================================\n        window.addEventListener('load', () => {\n            document.body.classList.add('loaded');\n        });\n    </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null}}
