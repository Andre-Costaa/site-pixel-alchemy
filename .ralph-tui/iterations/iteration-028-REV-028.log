n      - generic [ref=e202]:\n        - generic [ref=e203]:\n          - img [ref=e204]\n          - img [ref=e206]\n          - img [ref=e208]\n          - img [ref=e210]\n          - img [ref=e212]\n        - paragraph [ref=e214]: \"\\\"Após muita procura, finalmente encontrei uma clínica 100% focada em gatos. A Luna tem pavor de veterinário, mas aqui foi diferente.\\\"\"\n        - generic [ref=e215]:\n          - generic [ref=e216]: AF\n          - generic [ref=e217]:\n            - generic [ref=e218]: Ana Fernanda\n            - generic [ref=e219]: Tutora da Luna\n  - generic [ref=e221]:\n    - generic [ref=e222]:\n      - generic [ref=e223]: Diferenciais\n      - heading \"Por que escolher a Di Gato?\" [level=2] [ref=e224]\n      - paragraph [ref=e225]: O que nos torna diferentes das demais clínicas veterinárias.\n    - generic [ref=e226]:\n      - generic [ref=e227]:\n        - img [ref=e229]\n        - heading \"Exclusivo para Felinos\" [level=3] [ref=e233]\n        - paragraph [ref=e234]: Ambiente 100% dedicado a gatos, sem presença de cães que possam causar estresse.\n      - generic [ref=e235]:\n        - img [ref=e237]\n        - heading \"Atendimento Gentle\" [level=3] [ref=e239]\n        - paragraph [ref=e240]: Técnicas de contenção amigável que priorizam o bem-estar do seu gato.\n      - generic [ref=e241]:\n        - img [ref=e243]\n        - heading \"Sem Tempo de Pressa\" [level=3] [ref=e246]\n        - paragraph [ref=e247]: Cada consulta tem o tempo necessário para examinar com calma e carinho.\n      - generic [ref=e248]:\n        - img [ref=e250]\n        - heading \"Especialização\" [level=3] [ref=e252]\n        - paragraph [ref=e253]: Equipe atualizada com as melhores práticas em medicina felina.\n  - generic [ref=e256]:\n    - generic [ref=e257]:\n      - heading \"Agende uma visita\" [level=3] [ref=e258]\n      - paragraph [ref=e259]: Entre em contato para agendar uma consulta ou tirar dúvidas. Estamos prontos para cuidar do seu gato com todo carinho.\n      - generic [ref=e260]:\n        - generic [ref=e261]:\n          - img [ref=e263]\n          - generic [ref=e266]:\n            - heading \"Endereço\" [level=4] [ref=e267]\n            - paragraph [ref=e268]:\n              - text: R. São Sebastião, 1678 - Vila Seixas\n              - text: Ribeirão Preto - SP, 14020-023\n        - generic [ref=e269]:\n          - img [ref=e271]\n          - generic [ref=e273]:\n            - heading \"Telefone\" [level=4] [ref=e274]\n            - paragraph [ref=e275]: (16) 3610-2425\n        - generic [ref=e276]:\n          - img [ref=e278]\n          - generic [ref=e281]:\n            - heading \"Horário\" [level=4] [ref=e282]\n            - paragraph [ref=e283]:\n              - text: \"Segunda a Sexta: 8h às 19h\"\n              - text: \"Sábados: 8h às 14h\"\n    - generic [ref=e284]:\n      - heading \"Envie uma mensagem\" [level=4] [ref=e285]\n      - paragraph [ref=e286]: Preencha o formulário e entraremos em contato\n      - generic [ref=e287]:\n        - generic [ref=e288]:\n          - generic [ref=e289]: Seu Nome\n          - textbox \"Seu Nome\" [ref=e290]:\n            - /placeholder: Digite seu nome\n        - generic [ref=e291]:\n          - generic [ref=e292]: Telefone\n          - textbox \"Telefone\" [ref=e293]:\n            - /placeholder: (00) 00000-0000\n        - generic [ref=e294]:\n          - generic [ref=e295]: Serviço de Interesse\n          - combobox \"Serviço de Interesse\" [ref=e296]:\n            - option \"Selecione uma opção\" [selected]\n            - option \"Consulta de Rotina\"\n            - option \"Cirurgia\"\n            - option \"Exames Laboratoriais\"\n            - option \"Dermatologia\"\n            - option \"Odontologia\"\n            - option \"Outro\"\n        - generic [ref=e297]:\n          - generic [ref=e298]: Mensagem\n          - textbox \"Mensagem\" [ref=e299]:\n            - /placeholder: Conte-nos sobre seu gato ou o que precisa...\n        - button \"En