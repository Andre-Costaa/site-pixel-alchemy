ter]:\n          - /url: \"#contato\"\n          - text: Agendar\n          - img [ref=e140]\n      - generic [ref=e142]:\n        - img [ref=e144]\n        - heading \"Exames Laboratoriais\" [level=3] [ref=e147]\n        - paragraph [ref=e148]: Análises clínicas completas com resultados rápidos e precisos para diagnóstico assertivo.\n        - link \"Agendar\" [ref=e149] [cursor=pointer]:\n          - /url: \"#contato\"\n          - text: Agendar\n          - img [ref=e150]\n      - generic [ref=e152]:\n        - img [ref=e154]\n        - heading \"Ecografia e Raios-X\" [level=3] [ref=e160]\n        - paragraph [ref=e161]: Imagens diagnósticas de alta resolução para avaliações internas precisas.\n        - link \"Agendar\" [ref=e162] [cursor=pointer]:\n          - /url: \"#contato\"\n          - text: Agendar\n          - img [ref=e163]\n      - generic [ref=e165]:\n        - img [ref=e167]\n        - heading \"Banho e Tosa\" [level=3] [ref=e169]\n        - paragraph [ref=e170]: Serviços de higiene e estética com produtos hipoalergênicos e profissionais carinhosos.\n        - link \"Agendar\" [ref=e171] [cursor=pointer]:\n          - /url: \"#contato\"\n          - text: Agendar\n          - img [ref=e172]\n  - generic [ref=e175]:\n    - generic [ref=e176]:\n      - generic [ref=e177]: Depoimentos\n      - heading \"O que dizem sobre nós\" [level=2] [ref=e178]\n      - paragraph [ref=e179]: A satisfação dos nossos clientes e a saúde dos seus pets são o nosso maior incentivo.\n    - generic [ref=e180]:\n      - generic [ref=e181]:\n        - generic [ref=e182]:\n          - img [ref=e183]\n          - img [ref=e185]\n          - img [ref=e187]\n          - img [ref=e189]\n          - img [ref=e191]\n        - paragraph [ref=e193]: \"\\\"A equipe da Mr. Dog e Cia trata meu Thor como se fosse filho deles. Sempre muito atenciosos e profissionais. Recomendo de olhos fechados!\\\"\"\n        - generic [ref=e194]:\n          - img \"Maria Silva\" [ref=e196]\n          - g