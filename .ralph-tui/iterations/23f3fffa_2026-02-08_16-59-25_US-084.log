                  </svg>\n  1695→                    </a>\n  1696→                </div>\n  1697→            </div>\n  1698→        </div>\n  1699→    </footer>\n  1700→\n  1701→    <script>\n  1702→        // ============================================\n  1703→        // NAVIGATION\n  1704→        // ============================================\n  1705→        const nav = document.getElementById('nav');\n  1706→        const navToggle = document.getElementById('navToggle');\n  1707→        const navMenu = document.getElementById('navMenu');\n  1708→        let lastScrollY = window.scrollY;\n  1709→\n  1710→        window.addEventListener('scroll', () => {\n  1711→            if (window.scrollY > lastScrollY && window.scrollY > 100) {\n  1712→                nav.classList.add('hidden');\n  1713→            } else {\n  1714→                nav.classList.remove('hidden');\n  1715→            }\n  1716→            lastScrollY = window.scrollY;\n  1717→        });\n  1718→\n  1719→        navToggle.addEventListener('click', () => {\n  1720→            navMenu.classList.toggle('active');\n  1721→        });\n  1722→\n  1723→        document.querySelectorAll('.nav-link').forEach(link => {\n  1724→            link.addEventListener('click', () => {\n  1725→                navMenu.classList.remove('active');\n  1726→            });\n  1727→        });\n  1728→\n  1729→        // ============================================\n  1730→        // SMOOTH SCROLL\n  1731→        // ============================================\n  1732→        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n  1733→            anchor.addEventListener('click', function (e) {\n  1734→                e.preventDefault();\n  1735→                const target = document.querySelector(this.getAttribute('href'));\n  1736→                if (target) {\n  1737→                    const navHeight = nav.offsetHeight;\n  1738→                    const targetPosition = target.offsetTop - navHeight;\n  1739→                    window.scrollTo({\n  1740→                        top: targetPosition,\n  1741→                        behavior: 'smooth'\n  1742→                    });\n  1743→                }\n  1744→            });\n  1745→        });\n  1746→\n  1747→        // ============================================\n  1748→        // INTERSECTION OBSERVER (WOW ANIMATIONS)\n  1749→        // ============================================\n  1750→        const observerOptions = {\n  1751→            threshold: 0.1,\n  1752→            rootMargin: '0px 0px -50px 0px'\n  1753→        };\n  1754→\n  1755→        const observer = new IntersectionObserver((entries) => {\n  1756→            entries.forEach(entry => {\n  1757→                if (entry.isIntersecting) {\n  1758→                    const delay = entry.target.dataset.delay || 0;\n  1759→                    setTimeout(() => {\n  1760→                        entry.target.classList.add('visible');\n  1761→                    }, delay);\n  1762→                    observer.unobserve(entry.target);\n  1763→                }\n  1764→            });\n  1765→        }, observerOptions);\n  1766→\n  1767→        document.querySelectorAll('.wow-fade-up').forEach(el => {\n  1768→            observer.observe(el);\n  1769→        });\n  1770→\n  1771→        // ============================================\n  1772→        // CONTACT FORM (WHATSAPP)\n  1773→        // ============================================\n  1774→        const contactForm = document.getElementById('contactForm');\n  1775→        contactForm.addEventListener('submit', function(e) {\n  1776→            e.preventDefault();\n  1777→\n  1778→            const name = document.getElementById('name').value;\n  1779→            const email = document.getElementById('email').value;\n  1780→            const phone = document.getElementById('phone').value;\n  1781→            const service = document.getElementById('service').value;\n  1782→            const message = document.getElementById('message').value;\n  1783→\n  1784→            const serviceNames = {\n  1785→                'harmonizacao': 'Harmonização Facial',\n  1786→                'botulina': 'Toxina Botulínica',\n  1787→                'preenchedores': 'Preenchedores Faciais',\n  1788→                'labial': 'Preenchimento Labial',\n  1789→                'bioestimuladores': 'Bioestimuladores',\n  1790→                'protocolos': 'Protocolos Personalizados'\n  1791→            };\n  1792→\n  1793→            const whatsappMessage = `Olá! Meu nome é ${name}.\\n\\nEmail: ${email}\\nTelefone: ${phone}\\nServiço de interesse: ${serviceNames[service] || service}\\n\\nMensagem: ${message || 'Gostaria de agendar uma consulta.'}`;\n  1794→\n  1795→            const whatsappUrl = `https://wa.me/5516996370230?text=${encodeURIComponent(whatsappMessage)}`;\n  1796→\n  1797→            window.open(whatsappUrl, '_blank');\n  1798→        });\n  1799→\n  1800→        // ============================================\n  1801→        // HERO PARALLAX\n  1802→        // ============================================\n  1803→        const hero = document.querySelector('.hero');\n  1804→        const blobs = document.querySelectorAll('.hero-blob');\n  1805→\n  1806→        if (window.innerWidth > 768) {\n  1807→            hero.addEventListener('mousemove', (e) => {\n  1808→                const { clientX, clientY } = e;\n  1809→                const { innerWidth, innerHeight } = window;\n  1810→\n  1811→                const xPercent = (clientX / innerWidth - 0.5) * 2;\n  1812→                const yPercent = (clientY / innerHeight - 0.5) * 2;\n  1813→\n  1814→                blobs.forEach((blob, index) => {\n  1815→                    const speed = (index + 1) * 20;\n  1816→                    const x = xPercent * speed;\n  1817→                    const y = yPercent * speed;\n  1818→                    blob.style.transform = `translate(${x}px, ${y}px)`;\n  1819→                });\n  1820→            });\n  1821→        }\n  1822→\n  1823→        // ============================================\n  1824→        // PREFERRED REDUCED MOTION\n  1825→        // ============================================\n  1826→        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n  1827→        if (prefersReducedMotion.matches) {\n  1828→            document.querySelectorAll('.hero-blob').forEach(blob => {\n  1829→                blob.style.animation = 'none';\n  1830→            });\n  1831→        }\n  1832→    </script>\n  1833→</body>\n  1834→</html>\n  1835→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"382169d9-2791-4e15-9f28-829208aba45c","uuid":"82504710-af7c-41d9-8662-31027d12c245","tool_use_result":{"type":"text","file":{"filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-manoela-zuccolotto-harmonizacao-facial-mzucca-estetica-a/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Manoela Zuccolotto | Harmonização Facial - MZucca Estética Avançada</title>\n    <meta name=\"description\" content=\"Dra. Manoela Zuccolotto - Harmonização Facial e Estética Avançada em Ribeirão Preto. MZucca Estética Avançada - Atendimento especializado com resultados naturais.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=Satoshi:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           CSS VARIABLES - Moonstone Noir & Antique Silver\n           ============================================ */\n        :root {\n            /* Primary Palette - Moonstone Opalescent */\n            --color-moonstone: #E8E8F0;\n            --color-moonstone-pearl: #F0F0F8;\n            --color-moonstone-iridescent: #F5F5FA;\n            --color-moonstone-blue: #D8D8E8;\n            --color-moonstone-lavender: #E8E8F5;\n            --color-moonstone-pink: #F0E8F0;\n\n            /* Accent Palette - Antique Silver */\n            --color-silver: #B8B8C8;\n            --color-silver-light: #C8C8D8;\n            --color-silver-mid: #D0D0E0;\n            --color-silver-dark: #A8A8B8;\n            --color-silver-deep: #888898;\n            --color-silver-shimmer: #E0E0F0;\n            --color-silver-tarnished: #9898A8;\n\n            /* Noir Palette - Midnight Deep */\n            --color-midnight: #0A0A12;\n            --color-midnight-light: #12121A;\n            --color-midnight-deep: #050508;\n            --color-charcoal: #1A1A22;\n            --color-noir: #08080F;\n\n            /* Labradentite Blue Accents */\n            --color-labradentite: #4A5A8A;\n            --color-labradentite-light: #6A7AAA;\n            --color-labradentite-deep: #2A3A6A;\n\n            /* Text Colors */\n            --color-text-primary: #F0F0F8;\n            --color-text-secondary: #C8C8D8;\n            --color-text-muted: #8888A0;\n            --color-text-on-light: #1A1A22;\n\n            /* Gradients */\n            --gradient-moonstone: linear-gradient(135deg, var(--color-moonstone-pearl) 0%, var(--color-moonstone-blue) 50%, var(--color-moonstone-lavender) 100%);\n            --gradient-silver: linear-gradient(135deg, var(--color-silver-dark) 0%, var(--color-silver) 50%, var(--color-silver-light) 100%);\n            --gradient-hero: linear-gradient(135deg, var(--color-midnight-deep) 0%, var(--color-midnight) 40%, var(--color-midnight-light) 100%);\n            --gradient-aurora: linear-gradient(135deg, var(--color-labradentite) 0%, var(--color-moonstone-lavender) 50%, var(--color-labradentite-light) 100%);\n            --gradient-noir: linear-gradient(135deg, var(--color-midnight-deep) 0%, var(--color-midnight) 50%, var(--color-charcoal) 100%);\n            --gradient-iridescent: linear-gradient(135deg, var(--color-moonstone-pearl) 0%, var(--color-moonstone-lavender) 25%, var(--color-moonstone-blue) 50%, var(--color-moonstone-pink) 75%, var(--color-moonstone-pearl) 100%);\n\n            /* Aurora Wave Border Radius - Moonstone/Iridescence inspired */\n            --radius-aurora-1: 68% 32% 48% 52% / 52% 42% 58% 48%;\n            --radius-aurora-2: 48% 52% 68% 32% / 42% 58% 42% 58%;\n            --radius-aurora-3: 58% 42% 42% 58% / 52% 48% 52% 48%;\n            --radius-aurora-4: 42% 58% 52% 48% / 48% 52% 48% 52%;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n            --spacing-2xl: 8rem;\n\n            /* Typography */\n            --font-display: 'Bodoni Moda', Georgia, serif;\n            --font-body: 'Satoshi', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(10, 10, 18, 0.4);\n            --shadow-medium: 0 8px 30px rgba(10, 10, 18, 0.5);\n            --shadow-strong: 0 12px 40px rgba(10, 10, 18, 0.6);\n            --shadow-glow: 0 0 30px rgba(184, 184, 200, 0.2);\n            --shadow-silver: 0 4px 25px rgba(184, 184, 200, 0.15);\n            --shadow-iridescent: 0 0 40px rgba(232, 232, 240, 0.3);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.7;\n            color: var(--color-text-primary);\n            background: var(--color-midnight-deep);\n            overflow-x: hidden;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-text-primary);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-secondary);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-sm) var(--spacing-md);\n            background: rgba(10, 10, 18, 0.95);\n            backdrop-filter: blur(20px);\n            transition: transform 0.3s ease;\n            box-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.4rem;\n            font-weight: 700;\n            color: var(--color-moonstone-pearl);\n            text-decoration: none;\n            letter-spacing: 0.02em;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-secondary);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-silver);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover {\n            color: var(--color-moonstone-pearl);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            background: var(--gradient-silver);\n            color: var(--color-midnight-deep) !important;\n            padding: 0.75rem 1.5rem;\n            border-radius: 50px;\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-moonstone-pearl);\n            transition: var(--transition-fast);\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            padding: var(--spacing-xl) var(--spacing-md);\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        .hero-blob {\n            position: absolute;\n            border-radius: var(--radius-aurora-1);\n            opacity: 0.12;\n            filter: blur(80px);\n            animation: aurora-float 25s ease-in-out infinite;\n        }\n\n        @keyframes aurora-float {\n            0%, 100% {\n                transform: translate(0, 0) rotate(0deg) scale(1);\n            }\n            25% {\n                transform: translate(30px, -30px) rotate(90deg) scale(1.1);\n            }\n            50% {\n                transform: translate(-20px, 20px) rotate(180deg) scale(0.9);\n            }\n            75% {\n                transform: translate(20px, 30px) rotate(270deg) scale(1.05);\n            }\n        }\n\n        .blob-1 {\n            width: 600px;\n            height: 600px;\n            background: var(--gradient-iridescent);\n            top: -250px;\n            right: -150px;\n            animation-delay: 0s;\n        }\n\n        .blob-2 {\n            width: 500px;\n            height: 500px;\n            background: linear-gradient(135deg, var(--color-moonstone-blue) 0%, var(--color-labradentite) 100%);\n            bottom: -200px;\n            left: -150px;\n            animation-delay: -8s;\n            border-radius: var(--radius-aurora-2);\n        }\n\n        .blob-3 {\n            width: 350px;\n            height: 350px;\n            background: linear-gradient(135deg, var(--color-silver-light) 0%, var(--color-moonstone-lavender) 100%);\n            top: 40%;\n            left: 15%;\n            animation-delay: -16s;\n            border-radius: var(--radius-aurora-3);\n            opacity: 0.08;\n        }\n\n        .blob-4 {\n            width: 280px;\n            height: 280px;\n            background: var(--gradient-aurora);\n            bottom: 30%;\n            right: 20%;\n            animation-delay: -12s;\n            border-radius: var(--radius-aurora-4);\n            opacity: 0.1;\n        }\n\n        .hero-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-xl);\n            align-items: center;\n            position: relative;\n            z-index: 10;\n        }\n\n        .hero-content {\n            opacity: 0;\n            animation: fade-up 1s ease forwards;\n            animation-delay: 0ms;\n        }\n\n        @keyframes fade-up {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .hero-subtitle {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 600;\n            letter-spacing: 0.15em;\n            text-transform: uppercase;\n            color: var(--color-labradentite-light);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            line-height: 1.1;\n        }\n\n        .hero-title span {\n            background: var(--gradient-iridescent);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n            display: inline-block;\n        }\n\n        .hero-description {\n            font-size: 1.1rem;\n            line-height: 1.8;\n            margin-bottom: var(--spacing-lg);\n            max-width: 500px;\n        }\n\n        .hero-cta {\n            display: flex;\n            gap: var(--spacing-sm);\n            flex-wrap: wrap;\n        }\n\n        .btn-primary {\n            background: var(--gradient-silver);\n            color: var(--color-midnight-deep);\n            padding: 1rem 2rem;\n            border-radius: 50px;\n            font-family: var(--font-body);\n            font-weight: 600;\n            font-size: 0.95rem;\n            text-decoration: none;\n            transition: var(--transition-base);\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            border: none;\n            cursor: pointer;\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-moonstone-pearl);\n            padding: 1rem 2rem;\n            border: 2px solid var(--color-silver-dark);\n            border-radius: 50px;\n            font-family: var(--font-body);\n            font-weight: 600;\n            font-size: 0.95rem;\n            text-decoration: none;\n            transition: var(--transition-base);\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-silver-dark);\n            color: var(--color-midnight-deep);\n            transform: translateY(-3px);\n        }\n\n        .hero-visual {\n            position: relative;\n            opacity: 0;\n            animation: fade-up 1s ease forwards;\n            animation-delay: 200ms;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            border-radius: var(--radius-aurora-1);\n            overflow: hidden;\n            box-shadow: var(--shadow-iridescent);\n        }\n\n        .hero-image {\n            width: 100%;\n            height: auto;\n            display: block;\n            border-radius: var(--radius-aurora-1);\n        }\n\n        .hero-floating-card {\n            position: absolute;\n            background: rgba(232, 232, 240, 0.1);\n            backdrop-filter: blur(20px);\n            border: 1px solid rgba(232, 232, 240, 0.2);\n            border-radius: 20px;\n            padding: 1.5rem;\n            box-shadow: var(--shadow-soft);\n        }\n\n        .floating-card-1 {\n            top: 10%;\n            left: -40px;\n            animation: float 6s ease-in-out infinite;\n        }\n\n        .floating-card-2 {\n            bottom: 15%;\n            right: -30px;\n            animation: float 6s ease-in-out infinite;\n            animation-delay: -3s;\n        }\n\n        @keyframes float {\n            0%, 100% {\n                transform: translateY(0);\n            }\n            50% {\n                transform: translateY(-20px);\n            }\n        }\n\n        .floating-card-label {\n            font-family: var(--font-body);\n            font-size: 0.75rem;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 0.1em;\n            color: var(--color-labradentite-light);\n            margin-bottom: 0.25rem;\n        }\n\n        .floating-card-value {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-moonstone-pearl);\n        }\n\n        /* ============================================\n           SECTION BASE STYLES\n           ============================================ */\n        .section {\n            padding: var(--spacing-xl) var(--spacing-md);\n            position: relative;\n        }\n\n        .section-header {\n            text-align: center;\n            max-width: 700px;\n            margin: 0 auto var(--spacing-xl);\n        }\n\n        .section-tag {\n            font-family: var(--font-body);\n            font-size: 0.85rem;\n            font-weight: 600;\n            letter-spacing: 0.15em;\n            text-transform: uppercase;\n            color: var(--color-labradentite-light);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .section-title {\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .section-description {\n            font-size: 1.05rem;\n        }\n\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(40px);\n            transition: opacity 0.8s ease, transform 0.8s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            background: var(--color-midnight);\n        }\n\n        .problem-solution-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n        }\n\n        .problem-section, .solution-section {\n            padding: var(--spacing-lg);\n            border-radius: 30px;\n        }\n\n        .problem-section {\n            background: rgba(184, 184, 200, 0.05);\n            border: 1px solid rgba(184, 184, 200, 0.1);\n        }\n\n        .solution-section {\n            background: var(--gradient-noir);\n            border: 1px solid var(--color-labradentite-deep);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .section-label {\n            font-family: var(--font-body);\n            font-size: 0.8rem;\n            font-weight: 700;\n            letter-spacing: 0.15em;\n            text-transform: uppercase;\n            margin-bottom: var(--spacing-md);\n            display: inline-block;\n        }\n\n        .problem-section .section-label {\n            color: var(--color-silver-tarnished);\n        }\n\n        .solution-section .section-label {\n            color: var(--color-labradentite-light);\n        }\n\n        .ps-card {\n            background: rgba(232, 232, 240, 0.03);\n            border: 1px solid rgba(232, 232, 240, 0.08);\n            border-left: 3px solid;\n            border-radius: 15px;\n            padding: var(--spacing-md);\n            margin-bottom: var(--spacing-md);\n            transition: var(--transition-base);\n        }\n\n        .ps-card:last-child {\n            margin-bottom: 0;\n        }\n\n        .problem-section .ps-card {\n            border-left-color: var(--color-silver-dark);\n        }\n\n        .solution-section .ps-card {\n            border-left-color: var(--color-labradentite);\n            background: rgba(74, 90, 138, 0.1);\n        }\n\n        .ps-card:hover {\n            transform: translateX(10px);\n        }\n\n        .problem-section .ps-card:hover {\n            background: rgba(184, 184, 200, 0.08);\n        }\n\n        .solution-section .ps-card:hover {\n            background: rgba(74, 90, 138, 0.15);\n        }\n\n        .ps-card-title {\n            font-family: var(--font-display);\n            font-size: 1.2rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-moonstone-pearl);\n        }\n\n        .ps-card-text {\n            font-size: 0.95rem;\n            color: var(--color-text-secondary);\n            margin: 0;\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            background: var(--gradient-noir);\n        }\n\n        .services-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n        }\n\n        .service-card {\n            background: rgba(232, 232, 240, 0.03);\n            border: 1px solid rgba(232, 232, 240, 0.08);\n            border-radius: 25px;\n            padding: var(--spacing-md);\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 3px;\n            background: var(--gradient-silver);\n            opacity: 0;\n            transition: var(--transition-base);\n        }\n\n        .service-card:hover {\n            transform: translateY(-10px);\n            background: rgba(232, 232, 240, 0.06);\n            box-shadow: var(--shadow-silver);\n        }\n\n        .service-card:hover::before {\n            opacity: 1;\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-silver);\n            border-radius: 15px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.5rem;\n        }\n\n        .service-title {\n            font-family: var(--font-display);\n            font-size: 1.3rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-xs);\n        }\n\n        .service-description {\n            font-size: 0.95rem;\n            color: var(--color-text-secondary);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-link {\n            color: var(--color-labradentite-light);\n            font-weight: 600;\n            font-size: 0.9rem;\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .service-link:hover {\n            color: var(--color-moonstone-pearl);\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            background: var(--color-midnight);\n        }\n\n        .testimonials-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n        }\n\n        .testimonial-card {\n            background: var(--gradient-noir);\n            border: 1px solid rgba(232, 232, 240, 0.1);\n            border-radius: 25px;\n            padding: var(--spacing-md);\n            position: relative;\n        }\n\n        .testimonial-stars {\n            color: var(--color-silver-light);\n            margin-bottom: var(--spacing-sm);\n            font-size: 1rem;\n        }\n\n        .testimonial-text {\n            font-size: 0.95rem;\n            font-style: italic;\n            margin-bottom: var(--spacing-md);\n            color: var(--color-text-secondary);\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: var(--gradient-silver);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-family: var(--font-display);\n            font-weight: 700;\n            color: var(--color-midnight-deep);\n            font-size: 1.1rem;\n        }\n\n        .testimonial-info {\n            flex: 1;\n        }\n\n        .testimonial-name {\n            font-family: var(--font-display);\n            font-weight: 600;\n            font-size: 1rem;\n            color: var(--color-moonstone-pearl);\n        }\n\n        .testimonial-role {\n            font-size: 0.85rem;\n            color: var(--color-text-muted);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            background: var(--gradient-noir);\n        }\n\n        .differentials-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            width: 90px;\n            height: 90px;\n            margin: 0 auto var(--spacing-sm);\n        }\n\n        .differential-icon-ring {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            border: 2px solid var(--color-labradentite);\n            border-radius: 50%;\n            opacity: 0.3;\n            animation: pulse-ring 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse-ring {\n            0%, 100% {\n                transform: scale(1);\n                opacity: 0.3;\n            }\n            50% {\n                transform: scale(1.15);\n                opacity: 0.1;\n            }\n        }\n\n        .differential-icon {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-silver);\n            border-radius: 15px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.3rem;\n            z-index: 1;\n        }\n\n        .differential-title {\n            font-family: var(--font-display);\n            font-size: 1.2rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-moonstone-pearl);\n        }\n\n        .differential-description {\n            font-size: 0.9rem;\n            color: var(--color-text-secondary);\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            background: var(--color-midnight);\n        }\n\n        .contact-container {\n            max-width: 800px;\n            margin: 0 auto;\n        }\n\n        .contact-form {\n            background: var(--gradient-noir);\n            border: 1px solid rgba(232, 232, 240, 0.1);\n            border-radius: 30px;\n            padding: var(--spacing-xl);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .form-row {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-md);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-group.full-width {\n            grid-column: 1 / -1;\n        }\n\n        .form-label {\n            display: block;\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 600;\n            margin-bottom: 0.5rem;\n            color: var(--color-moonstone-pearl);\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 1rem;\n            background: rgba(232, 232, 240, 0.05);\n            border: 1px solid rgba(232, 232, 240, 0.15);\n            border-radius: 15px;\n            font-family: var(--font-body);\n            font-size: 1rem;\n            color: var(--color-text-primary);\n            transition: var(--transition-fast);\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-labradentite-light);\n            background: rgba(232, 232, 240, 0.08);\n        }\n\n        .form-textarea {\n            min-height: 150px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1.2rem;\n            background: var(--gradient-silver);\n            color: var(--color-midnight-deep);\n            border: none;\n            border-radius: 50px;\n            font-family: var(--font-body);\n            font-weight: 700;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n        }\n\n        .form-submit:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .contact-info {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-xl);\n        }\n\n        .contact-info-item {\n            text-align: center;\n            padding: var(--spacing-md);\n            background: rgba(232, 232, 240, 0.03);\n            border: 1px solid rgba(232, 232, 240, 0.08);\n            border-radius: 20px;\n        }\n\n        .contact-info-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-silver);\n            border-radius: 15px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin: 0 auto var(--spacing-sm);\n            font-size: 1.3rem;\n        }\n\n        .contact-info-label {\n            font-family: var(--font-body);\n            font-size: 0.8rem;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 0.1em;\n            color: var(--color-labradentite-light);\n            margin-bottom: 0.5rem;\n        }\n\n        .contact-info-value {\n            color: var(--color-moonstone-pearl);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--color-midnight-deep);\n            padding: var(--spacing-xl) var(--spacing-md) var(--spacing-md);\n            border-top: 1px solid rgba(232, 232, 240, 0.1);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-top {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: var(--spacing-xl);\n            margin-bottom: var(--spacing-xl);\n        }\n\n        .footer-brand {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-moonstone-pearl);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-description {\n            font-size: 0.95rem;\n            color: var(--color-text-muted);\n            max-width: 300px;\n        }\n\n        .footer-heading {\n            font-family: var(--font-display);\n            font-size: 1rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-moonstone-pearl);\n        }\n\n        .footer-links {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-links a {\n            color: var(--color-text-secondary);\n            font-size: 0.9rem;\n            transition: var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-labradentite-light);\n        }\n\n        .footer-bottom {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding-top: var(--spacing-md);\n            border-top: 1px solid rgba(232, 232, 240, 0.08);\n        }\n\n        .footer-copyright {\n            font-size: 0.85rem;\n            color: var(--color-text-muted);\n        }\n\n        .footer-social {\n            display: flex;\n            gap: var(--spacing-sm);\n        }\n\n        .footer-social a {\n            width: 40px;\n            height: 40px;\n            background: rgba(232, 232, 240, 0.05);\n            border: 1px solid rgba(232, 232, 240, 0.1);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: var(--transition-fast);\n        }\n\n        .footer-social a:hover {\n            background: var(--gradient-silver);\n            border-color: transparent;\n        }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 1024px) {\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-cta {\n                justify-content: center;\n            }\n\n            .hero-visual {\n                display: none;\n            }\n\n            .services-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .testimonials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .footer-top {\n                grid-template-columns: 1fr 1fr;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                display: none;\n                position: absolute;\n                top: 100%;\n                left: 0;\n                right: 0;\n                background: rgba(10, 10, 18, 0.98);\n                flex-direction: column;\n                padding: var(--spacing-md);\n                gap: var(--spacing-sm);\n            }\n\n            .nav-menu.active {\n                display: flex;\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n\n            .problem-solution-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .services-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .testimonials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .form-row {\n                grid-template-columns: 1fr;\n            }\n\n            .contact-info {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-top {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-bottom {\n                flex-direction: column;\n                gap: var(--spacing-sm);\n                text-align: center;\n            }\n        }\n\n        /* ============================================\n           ACCESSIBILITY\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        .btn-focus:focus, .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: 2px solid var(--color-labradentite-light);\n            outline-offset: 2px;\n        }\n\n        /* Skip link */\n        .skip-link {\n            position: absolute;\n            top: -40px;\n            left: 0;\n            background: var(--color-midnight-deep);\n            color: var(--color-moonstone-pearl);\n            padding: 8px 16px;\n            z-index: 9999;\n            transition: top 0.3s;\n        }\n\n        .skip-link:focus {\n            top: 0;\n        }\n    </style>\n</head>\n<body>\n    <a href=\"#main-content\" class=\"skip-link\">Pular para o conteúdo principal</a>\n\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">MZucca Estética</a>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#home\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contato\" class=\"nav-link nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Menu\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-blob blob-1\"></div>\n        <div class=\"hero-blob blob-2\"></div>\n        <div class=\"hero-blob blob-3\"></div>\n        <div class=\"hero-blob blob-4\"></div>\n\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <p class=\"hero-subtitle\">MZucca Estética Avançada</p>\n                <h1 class=\"hero-title\">\n                    Harmonização Facial com\n                    <span>Resultados Naturais</span>\n                </h1>\n                <p class=\"hero-description\">\n                    Transforme sua aparência com procedimentos estéticos avançados e personalizados.\n                    Dra. Manoela Zuccolotto especialista em harmonização facial em Ribeirão Preto.\n                </p>\n                <div class=\"hero-cta\">\n                    <a href=\"#contato\" class=\"btn-primary\">\n                        Agendar Consulta\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                    <a href=\"#servicos\" class=\"btn-secondary\">Conhecer Serviços</a>\n                </div>\n            </div>\n\n            <div class=\"hero-visual\">\n                <div class=\"hero-image-wrapper\">\n                    <img src=\"https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=600&h=700&fit=crop&crop=face\" alt=\"Procedimento estético facial profissional\" class=\"hero-image\">\n                </div>\n                <div class=\"hero-floating-card floating-card-1\">\n                    <p class=\"floating-card-label\">Experiência</p>\n                    <p class=\"floating-card-value\">+5 anos</p>\n                </div>\n                <div class=\"hero-floating-card floating-card-2\">\n                    <p class=\"floating-card-label\">Satisfação</p>\n                    <p class=\"floating-card-value\">98%</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\" id=\"problema-solucao\">\n        <div class=\"section-header wow-fade-up\">\n            <p class=\"section-tag\">Transformação Real</p>\n            <h2 class=\"section-title\">Sua Melhor Versão</h2>\n            <p class=\"section-description\">Entendemos suas preocupações e oferecemos soluções personalizadas</p>\n        </div>\n\n        <div class=\"problem-solution-grid\">\n            <div class=\"problem-section\">\n                <p class=\"section-label\">O que você busca transformar</p>\n\n                <div class=\"ps-card wow-fade-up\">\n                    <h3 class=\"ps-card-title\">Sinais de Envelhecimento</h3>\n                    <p class=\"ps-card-text\">Rugas, linhas de expressão e perda de volume facial que afetam sua autoestima.</p>\n                </div>\n\n                <div class=\"ps-card wow-fade-up\" data-delay=\"100\">\n                    <h3 class=\"ps-card-title\">Assimetrias Faciais</h3>\n                    <p class=\"ps-card-text\">Desequilíbrios proporcionais que impactam a harmonia do seu rosto.</p>\n                </div>\n\n                <div class=\"ps-card wow-fade-up\" data-delay=\"200\">\n                    <h3 class=\"ps-card-title\">Aparência Cansada</h3>\n                    <p class=\"ps-card-text\">Olheiras, bolsas palpebrais e flacidez que transmitem cansaço.</p>\n                </div>\n            </div>\n\n            <div class=\"solution-section\">\n                <p class=\"section-label\">Como transformamos</p>\n\n                <div class=\"ps-card wow-fade-up\" data-delay=\"300\">\n                    <h3 class=\"ps-card-title\">Resultados Naturais</h3>\n                    <p class=\"ps-card-text\">Procedimentos que realçam sua beleza natural sem artificialidade.</p>\n                </div>\n\n                <div class=\"ps-card wow-fade-up\" data-delay=\"400\">\n                    <h3 class=\"ps-card-title\">Harmonia Facial</h3>\n                    <p class=\"ps-card-text\">Equilíbrio estétic