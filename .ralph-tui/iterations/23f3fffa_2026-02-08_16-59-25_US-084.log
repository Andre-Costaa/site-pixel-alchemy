   33→            --color-silver-shimmer: #E0E0F0;\n    34→            --color-silver-tarnished: #9898A8;\n    35→\n    36→            /* Noir Palette - Midnight Deep */\n    37→            --color-midnight: #0A0A12;\n    38→            --color-midnight-light: #12121A;\n    39→            --color-midnight-deep: #050508;\n    40→            --color-charcoal: #1A1A22;\n    41→            --color-noir: #08080F;\n    42→\n    43→            /* Labradentite Blue Accents */\n    44→            --color-labradentite: #4A5A8A;\n    45→            --color-labradentite-light: #6A7AAA;\n    46→            --color-labradentite-deep: #2A3A6A;\n    47→\n    48→            /* Text Colors */\n    49→            --color-text-primary: #F0F0F8;\n    50→            --color-text-secondary: #C8C8D8;\n    51→            --color-text-muted: #8888A0;\n    52→            --color-text-on-light: #1A1A22;\n    53→\n    54→            /* Gradients */\n    55→            --gradient-moonstone: linear-gradient(135deg, var(--color-moonstone-pearl) 0%, var(--color-moonstone-blue) 50%, var(--color-moonstone-lavender) 100%);\n    56→            --gradient-silver: linear-gradient(135deg, var(--color-silver-dark) 0%, var(--color-silver) 50%, var(--color-silver-light) 100%);\n    57→            --gradient-hero: linear-gradient(135deg, var(--color-midnight-deep) 0%, var(--color-midnight) 40%, var(--color-midnight-light) 100%);\n    58→            --gradient-aurora: linear-gradient(135deg, var(--color-labradentite) 0%, var(--color-moonstone-lavender) 50%, var(--color-labradentite-light) 100%);\n    59→            --gradient-noir: linear-gradient(135deg, var(--color-midnight-deep) 0%, var(--color-midnight) 50%, var(--color-charcoal) 100%);\n    60→            --gradient-iridescent: linear-gradient(135deg, var(--color-moonstone-pearl) 0%, var(--color-moonstone-lavender) 25%, var(--color-moonstone-blue) 50%, var(--color-moonstone-pink) 75%, var(--color-moonstone-pearl) 100%);\n    61→\n    62→            /* Aur