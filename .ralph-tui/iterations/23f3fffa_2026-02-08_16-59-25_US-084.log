 221→        .nav-link:hover::after {\n   222→            width: 100%;\n   223→        }\n   224→\n   225→        .nav-cta {\n   226→            background: var(--gradient-silver);\n   227→            color: var(--color-midnight-deep) !important;\n   228→            padding: 0.75rem 1.5rem;\n   229→            border-radius: 50px;\n   230→            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n   231→        }\n   232→\n   233→        .nav-cta:hover {\n   234→            transform: translateY(-2px);\n   235→            box-shadow: var(--shadow-glow);\n   236→        }\n   237→\n   238→        .nav-cta::after {\n   239→            display: none;\n   240→        }\n   241→\n   242→        .nav-toggle {\n   243→            display: none;\n   244→            flex-direction: column;\n   245→            gap: 5px;\n   246→            background: none;\n   247→            border: none;\n   248→            cursor: pointer;\n   249→            padding: 0.5rem;\n   250→        }\n   251→\n   252→        .nav-toggle span {\n   253→            width: 25px;\n   254→            height: 2px;\n   255→            background: var(--color-moonstone-pearl);\n   256→            transition: var(--transition-fast);\n   257→        }\n   258→\n   259→        /* ============================================\n   260→           HERO SECTION\n   261→           ============================================ */\n   262→        .hero {\n   263→            min-height: 100vh;\n   264→            display: flex;\n   265→            align-items: center;\n   266→            justify-content: center;\n   267→            position: relative;\n   268→            padding: var(--spacing-xl) var(--spacing-md);\n   269→            background: var(--gradient-hero);\n   270→            overflow: hidden;\n   271→        }\n   272→\n   273→        .hero-blob {\n   274→            position: absolute;\n   275→            border-radius: var(--radius-aurora-1);\n   276→            opacity: 0.12;\n   277→            filter: blur(80px);\n   278→            animation: aurora-float 25s ease-in-out infinite;\n   279→        }\n   280→\n   281→        @keyframes aurora-float {\n   282→            0%, 100% {\n   283→                transform: translate(0, 0) rotate(0deg) scale(1);\n   284→            }\n   285→            25% {\n   286→                transform: translate(30px, -30px) rotate(90deg) scale(1.1);\n   287→            }\n   288→            50% {\n   289→                transform: translate(-20px, 20px) rotate(180deg) scale(0.9);\n   290→            }\n   291→            75% {\n   292→                transform: translate(20px, 30px) rotate(270deg) scale(1.05);\n   293→            }\n   294→        }\n   295→\n   296→        .blob-1 {\n   297→            width: 600px;\n   298→            height: 600px;\n   299→            background: var(--gradient-iridescent);\n   300→            top: -250px;\n   301→            right: -150px;\n   302→            animation-delay: 0s;\n   303→        }\n   304→\n   305→        .blob-2 {\n   306→            width: 500px;\n   307→            height: 500px;\n   308→            background: linear-gradient(135deg, var(--color-moonstone-blue) 0%, var(--color-labradentite) 100%);\n   309→            bottom: -200px;\n   310→            left: -150px;\n   311→            animation-delay: -8s;\n   312→            border-radius: var(--radius-aurora-2);\n   313→        }\n   314→\n   315→        .blob-3 {\n   316→            width: 350px;\n   317→            height: 350px;\n   318→            background: linear-gradient(135deg, var(--color-silver-light) 0%, var(--color-moonstone-lavender) 100%);\n   319→            top: 40%;\n   320→            left: 15%;\n   321→            animation-delay: -16s;\n   322→            border-radius: var(--radius-aurora-3);\n   323→            opacity: 0.08;\n   324→        }\n   325→\n   326→        .blob-4 {\n   327→            width: 280px;\n   328→            height: 280px;\n   329→     