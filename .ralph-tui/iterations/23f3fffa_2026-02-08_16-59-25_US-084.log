{"type":"assistant","message":{"id":"msg_20260209040015c4c120dc715d4dcc","type":"message","role":"assistant","model":"glm-4.7","content":[{"type":"tool_use","id":"call_6749aee28bac465991287a2c","name":"Write","input":{"file_path":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/bonacci-estetica-avancada/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Bonacci Estética Avançada | Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Bonacci Estética Avançada - Harmonização Facial e Estética Avançada em Ribeirão Preto. Atendimento especializado com resultados naturais e elegantes.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=DM+Sans:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           CSS VARIABLES - Rose Gold & Velvet Noir\n           ============================================ */\n        :root {\n            /* Primary Palette - Velvet Noir */\n            --color-velvet: #2D1F1F;\n            --color-velvet-light: #3D2A2A;\n            --color-velvet-deep: #1A1212;\n            --color-burgundy: #4A1C1C;\n            --color-burgundy-light: #6B2D2D;\n            --color-wine: #7B2E3E;\n\n            /* Accent Palette - Rose Gold */\n            --color-rosegold: #D4A574;\n            --color-rosegold-light: #E8C9A8;\n            --color-rosegold-mid: #C99B6A;\n            --color-rosegold-dark: #B89065;\n            --color-rosegold-shimmer: #F0DCC8;\n\n            /* Neutral Palette - Cream & Blush */\n            --color-cream: #FDF8F5;\n            --color-cream-dark: #F5EDE7;\n            --color-blush: #F5E6E0;\n            --color-blush-light: #FAF0EB;\n            --color-sand: #E8DDD5;\n\n            /* Text Colors */\n            --color-text-primary: #2D1F1F;\n            --color-text-secondary: #5D4A4A;\n            --color-text-muted: #8B7575;\n            --color-text-on-dark: #FDF8F5;\n\n            /* Gradients */\n            --gradient-velvet: linear-gradient(135deg, var(--color-velvet-deep) 0%, var(--color-velvet) 50%, var(--color-burgundy) 100%);\n            --gradient-rosegold: linear-gradient(135deg, var(--color-rosegold-dark) 0%, var(--color-rosegold) 50%, var(--color-rosegold-light) 100%);\n            --gradient-blush: linear-gradient(135deg, var(--color-blush) 0%, var(--color-blush-light) 50%, var(--color-cream) 100%);\n            --gradient-hero: linear-gradient(180deg, var(--color-cream) 0%, var(--color-blush) 100%);\n            --gradient-wine: linear-gradient(135deg, var(--color-burgundy) 0%, var(--color-wine) 100%);\n            --gradient-shimmer: linear-gradient(90deg, var(--color-rosegold) 0%, var(--color-rosegold-shimmer) 50%, var(--color-rosegold) 100%);\n\n            /* Arch Shapes - Inspired by Architecture */\n            --radius-arch: 50% 50% 0 0 / 100% 100% 0 0;\n            --radius-arch-sm: 40% 40% 0 0 / 80% 80% 0 0;\n            --radius-arch-lg: 60% 60% 0 0 / 120% 120% 0 0;\n\n            /* Ornate Border Radius */\n            --radius-ornate: 12px;\n            --radius-ornate-lg: 20px;\n            --radius-pill: 100px;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n            --spacing-2xl: 8rem;\n\n            /* Typography */\n            --font-display: 'Playfair Display', Georgia, serif;\n            --font-body: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(45, 31, 31, 0.08);\n            --shadow-medium: 0 8px 30px rgba(45, 31, 31, 0.12);\n            --shadow-strong: 0 12px 40px rgba(45, 31, 31, 0.15);\n            --shadow-glow: 0 0 30px rgba(212, 165, 116, 0.3);\n            --shadow-rosegold: 0 4px 25px rgba(212, 165, 116, 0.2);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.7;\n            color: var(--color-text-primary);\n            background: var(--color-cream);\n            overflow-x: hidden;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-velvet);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-secondary);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-sm) var(--spacing-md);\n            background: rgba(253, 248, 245, 0.95);\n            backdrop-filter: blur(20px);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n            box-shadow: 0 1px 20px rgba(45, 31, 31, 0.05);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav.scrolled {\n            box-shadow: 0 2px 30px rgba(45, 31, 31, 0.1);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-burgundy);\n            text-decoration: none;\n            letter-spacing: 0.02em;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-secondary);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 50%;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-rosegold);\n            transition: width var(--transition-fast), left var(--transition-fast);\n        }\n\n        .nav-link:hover {\n            color: var(--color-burgundy);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n            left: 0;\n        }\n\n        .nav-cta {\n            background: var(--gradient-wine);\n            color: var(--color-cream) !important;\n            padding: 0.75rem 1.5rem;\n            border-radius: var(--radius-pill);\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glow);\n            color: var(--color-cream) !important;\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-velvet);\n            transition: var(--transition-fast);\n            border-radius: 2px;\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            position: relative;\n            padding: var(--spacing-xl) var(--spacing-md) var(--spacing-2xl);\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        .hero-decoration {\n            position: absolute;\n            pointer-events: none;\n            opacity: 0.4;\n        }\n\n        .hero-arch-1 {\n            top: -10%;\n            right: -5%;\n            width: 500px;\n            height: 600px;\n            background: var(--gradient-blush);\n            border-radius: var(--radius-arch);\n            filter: blur(60px);\n        }\n\n        .hero-arch-2 {\n            bottom: -15%;\n            left: -10%;\n            width: 400px;\n            height: 500px;\n            background: linear-gradient(135deg, var(--color-blush-light) 0%, var(--color-sand) 100%);\n            border-radius: var(--radius-arch-lg);\n            filter: blur(80px);\n        }\n\n        .hero-ornament {\n            position: absolute;\n            width: 300px;\n            height: 300px;\n            border: 1px solid rgba(212, 165, 116, 0.2);\n            border-radius: 50%;\n            top: 20%;\n            right: 15%;\n            animation: rotate-slow 30s linear infinite;\n        }\n\n        .hero-ornament::before {\n            content: '';\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            width: 200px;\n            height: 200px;\n            border: 1px solid rgba(212, 165, 116, 0.15);\n            border-radius: 50%;\n            transform: translate(-50%, -50%);\n        }\n\n        @keyframes rotate-slow {\n            from { transform: rotate(0deg); }\n            to { transform: rotate(360deg); }\n        }\n\n        .hero-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-xl);\n            align-items: center;\n            position: relative;\n            z-index: 10;\n        }\n\n        .hero-content {\n            opacity: 0;\n            animation: fade-up 1s ease forwards;\n            animation-delay: 0ms;\n        }\n\n        @keyframes fade-up {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            background: var(--color-cream);\n            border: 1px solid var(--color-rosegold);\n            padding: 0.5rem 1rem;\n            border-radius: var(--radius-pill);\n            font-family: var(--font-body);\n            font-size: 0.8rem;\n            font-weight: 600;\n            color: var(--color-burgundy);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-badge-dot {\n            width: 6px;\n            height: 6px;\n            background: var(--color-rosegold);\n            border-radius: 50%;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; transform: scale(1); }\n            50% { opacity: 0.5; transform: scale(1.2); }\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            line-height: 1.1;\n        }\n\n        .hero-title-accent {\n            background: var(--gradient-wine);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n            display: inline-block;\n        }\n\n        .hero-description {\n            font-size: 1.15rem;\n            line-height: 1.8;\n            margin-bottom: var(--spacing-lg);\n            max-width: 500px;\n            color: var(--color-text-secondary);\n        }\n\n        .hero-cta {\n            display: flex;\n            gap: var(--spacing-sm);\n            flex-wrap: wrap;\n        }\n\n        .btn-primary {\n            background: var(--gradient-wine);\n            color: var(--color-cream);\n            padding: 1rem 2rem;\n            border-radius: var(--radius-pill);\n            font-family: var(--font-body);\n            font-weight: 600;\n            font-size: 0.95rem;\n            text-decoration: none;\n            transition: var(--transition-base);\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            border: none;\n            cursor: pointer;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .btn-primary::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: -100%;\n            width: 100%;\n            height: 100%;\n            background: var(--gradient-shimmer);\n            transition: left 0.5s ease;\n        }\n\n        .btn-primary:hover::before {\n            left: 100%;\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .btn-primary span {\n            position: relative;\n            z-index: 1;\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-burgundy);\n            padding: 1rem 2rem;\n            border: 2px solid var(--color-rosegold);\n            border-radius: var(--radius-pill);\n            font-family: var(--font-body);\n            font-weight: 600;\n            font-size: 0.95rem;\n            text-decoration: none;\n            transition: var(--transition-base);\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-rosegold);\n            color: var(--color-cream);\n            transform: translateY(-3px);\n        }\n\n        .hero-visual {\n            position: relative;\n            opacity: 0;\n            animation: fade-up 1s ease forwards;\n            animation-delay: 200ms;\n        }\n\n        .hero-arch-frame {\n            position: relative;\n            border-radius: var(--radius-arch);\n            overflow: hidden;\n            box-shadow: var(--shadow-strong);\n        }\n\n        .hero-arch-inner {\n            position: relative;\n            padding: 2rem;\n            background: var(--gradient-velvet);\n        }\n\n        .hero-image {\n            width: 100%;\n            height: auto;\n            display: block;\n            border-radius: var(--radius-arch);\n        }\n\n        .hero-stat-card {\n            position: absolute;\n            background: var(--color-cream);\n            border-radius: var(--radius-ornate-lg);\n            padding: 1.25rem 1.5rem;\n            box-shadow: var(--shadow-medium);\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .hero-stat-1 {\n            top: 15%;\n            left: -30px;\n            animation: float 6s ease-in-out infinite;\n        }\n\n        .hero-stat-2 {\n            bottom: 20%;\n            right: -25px;\n            animation: float 6s ease-in-out infinite;\n            animation-delay: -3s;\n        }\n\n        @keyframes float {\n            0%, 100% { transform: translateY(0); }\n            50% { transform: translateY(-15px); }\n        }\n\n        .hero-stat-icon {\n            width: 45px;\n            height: 45px;\n            background: var(--gradient-rosegold);\n            border-radius: 12px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-cream);\n            font-size: 1.2rem;\n        }\n\n        .hero-stat-content {\n            text-align: left;\n        }\n\n        .hero-stat-value {\n            font-family: var(--font-display);\n            font-size: 1.4rem;\n            font-weight: 700;\n            color: var(--color-burgundy);\n            line-height: 1;\n        }\n\n        .hero-stat-label {\n            font-family: var(--font-body);\n            font-size: 0.75rem;\n            font-weight: 600;\n            color: var(--color-text-muted);\n            text-transform: uppercase;\n            letter-spacing: 0.05em;\n        }\n\n        /* ============================================\n           SECTION BASE STYLES\n           ============================================ */\n        .section {\n            padding: var(--spacing-xl) var(--spacing-md);\n            position: relative;\n        }\n\n        .section-header {\n            text-align: center;\n            max-width: 700px;\n            margin: 0 auto var(--spacing-xl);\n        }\n\n        .section-tag {\n            font-family: var(--font-body);\n            font-size: 0.85rem;\n            font-weight: 600;\n            letter-spacing: 0.15em;\n            text-transform: uppercase;\n            color: var(--color-rosegold-dark);\n            margin-bottom: var(--spacing-sm);\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n        }\n\n        .section-tag::before,\n        .section-tag::after {\n            content: '';\n            width: 30px;\n            height: 1px;\n            background: var(--gradient-rosegold);\n        }\n\n        .section-title {\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .section-description {\n            font-size: 1.05rem;\n        }\n\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(40px);\n            transition: opacity 0.8s ease, transform 0.8s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            background: var(--color-blush-light);\n        }\n\n        .problem-solution-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n        }\n\n        .problem-section, .solution-section {\n            padding: var(--spacing-lg);\n            border-radius: var(--radius-ornate-lg);\n        }\n\n        .problem-section {\n            background: var(--color-cream);\n            border: 1px solid var(--color-sand);\n        }\n\n        .solution-section {\n            background: var(--gradient-velvet);\n            border: 1px solid var(--color-burgundy);\n            color: var(--color-text-on-dark);\n        }\n\n        .section-label {\n            font-family: var(--font-body);\n            font-size: 0.8rem;\n            font-weight: 700;\n            letter-spacing: 0.15em;\n            text-transform: uppercase;\n            margin-bottom: var(--spacing-md);\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n        }\n\n        .problem-section .section-label {\n            color: var(--color-wine);\n        }\n\n        .solution-section .section-label {\n            color: var(--color-rosegold);\n        }\n\n        .section-label::before {\n            content: '';\n            width: 8px;\n            height: 8px;\n            border-radius: 50%;\n        }\n\n        .problem-section .section-label::before {\n            background: var(--color-wine);\n        }\n\n        .solution-section .section-label::before {\n            background: var(--color-rosegold);\n        }\n\n        .ps-card {\n            background: rgba(255, 255, 255, 0.6);\n            border: 1px solid rgba(45, 31, 31, 0.1);\n            border-radius: var(--radius-ornate);\n            padding: var(--spacing-md);\n            margin-bottom: var(--spacing-md);\n            transition: var(--transition-base);\n        }\n\n        .ps-card:last-child {\n            margin-bottom: 0;\n        }\n\n        .solution-section .ps-card {\n            background: rgba(255, 255, 255, 0.05);\n            border-color: rgba(212, 165, 116, 0.2);\n        }\n\n        .ps-card:hover {\n            transform: translateX(10px);\n        }\n\n        .problem-section .ps-card:hover {\n            background: rgba(255, 255, 255, 0.9);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .solution-section .ps-card:hover {\n            background: rgba(255, 255, 255, 0.1);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .ps-card-title {\n            font-family: var(--font-display);\n            font-size: 1.2rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-burgundy);\n        }\n\n        .solution-section .ps-card-title {\n            color: var(--color-rosegold);\n        }\n\n        .ps-card-text {\n            font-size: 0.95rem;\n            margin: 0;\n        }\n\n        .solution-section .ps-card-text {\n            color: var(--color-blush-light);\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            background: var(--color-cream);\n        }\n\n        .services-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n        }\n\n        .service-card {\n            background: var(--color-cream);\n            border: 1px solid var(--color-sand);\n            border-radius: var(--radius-ornate-lg);\n            padding: var(--spacing-md);\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-rosegold);\n            opacity: 0;\n            transition: var(--transition-base);\n        }\n\n        .service-card:hover {\n            transform: translateY(-10px);\n            box-shadow: var(--shadow-medium);\n            border-color: var(--color-rosegold);\n        }\n\n        .service-card:hover::before {\n            opacity: 1;\n        }\n\n        .service-icon {\n            width: 65px;\n            height: 65px;\n            background: var(--gradient-rosegold);\n            border-radius: var(--radius-ornate);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.5rem;\n            color: var(--color-cream);\n        }\n\n        .service-title {\n            font-family: var(--font-display);\n            font-size: 1.3rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-burgundy);\n        }\n\n        .service-description {\n            font-size: 0.95rem;\n            color: var(--color-text-secondary);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-link {\n            color: var(--color-wine);\n            font-weight: 600;\n            font-size: 0.9rem;\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .service-link:hover {\n            color: var(--color-burgundy);\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            background: var(--gradient-blush);\n        }\n\n        .testimonials-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n        }\n\n        .testimonial-card {\n            background: var(--color-cream);\n            border: 1px solid var(--color-sand);\n            border-radius: var(--radius-ornate-lg);\n            padding: var(--spacing-md);\n            position: relative;\n        }\n\n        .testimonial-card::before {\n            content: '\"';\n            font-family: var(--font-display);\n            font-size: 6rem;\n            color: var(--color-rosegold);\n            opacity: 0.2;\n            position: absolute;\n            top: 0;\n            left: 1rem;\n            line-height: 1;\n        }\n\n        .testimonial-stars {\n            color: var(--color-rosegold);\n            margin-bottom: var(--spacing-sm);\n            font-size: 1rem;\n        }\n\n        .testimonial-text {\n            font-size: 0.95rem;\n            font-style: italic;\n            margin-bottom: var(--spacing-md);\n            color: var(--color-text-secondary);\n            position: relative;\n            z-index: 1;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: var(--gradient-rosegold);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-family: var(--font-display);\n            font-weight: 700;\n            color: var(--color-cream);\n            font-size: 1.1rem;\n        }\n\n        .testimonial-info {\n            flex: 1;\n        }\n\n        .testimonial-name {\n            font-family: var(--font-display);\n            font-weight: 600;\n            font-size: 1rem;\n            color: var(--color-burgundy);\n        }\n\n        .testimonial-role {\n            font-size: 0.85rem;\n            color: var(--color-text-muted);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            background: var(--color-velvet);\n            color: var(--color-text-on-dark);\n        }\n\n        .differentials .section-title,\n        .differentials .section-description {\n            color: var(--color-text-on-dark);\n        }\n\n        .differentials-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            width: 100px;\n            height: 100px;\n            margin: 0 auto var(--spacing-sm);\n        }\n\n        .differential-icon-bg {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            background: var(--gradient-rosegold);\n            border-radius: 50%;\n            opacity: 0.15;\n            animation: pulse-ring 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse-ring {\n            0%, 100% { transform: scale(1); opacity: 0.15; }\n            50% { transform: scale(1.1); opacity: 0.08; }\n        }\n\n        .differential-icon {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 55px;\n            height: 55px;\n            background: var(--gradient-rosegold);\n            border-radius: var(--radius-ornate);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.3rem;\n            z-index: 1;\n            color: var(--color-cream);\n        }\n\n        .differential-title {\n            font-family: var(--font-display);\n            font-size: 1.2rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-rosegold);\n        }\n\n        .differential-description {\n            font-size: 0.9rem;\n            color: var(--color-blush-light);\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            background: var(--gradient-blush);\n        }\n\n        .contact-container {\n            max-width: 800px;\n            margin: 0 auto;\n        }\n\n        .contact-form {\n            background: var(--color-cream);\n            border: 1px solid var(--color-sand);\n            border-radius: var(--radius-ornate-lg);\n            padding: var(--spacing-xl);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .form-row {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-md);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-group.full-width {\n            grid-column: 1 / -1;\n        }\n\n        .form-label {\n            display: block;\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 600;\n            margin-bottom: 0.5rem;\n            color: var(--color-burgundy);\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 1rem;\n            background: var(--color-blush-light);\n            border: 1px solid var(--color-sand);\n            border-radius: var(--radius-ornate);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            color: var(--color-text-primary);\n            transition: var(--transition-fast);\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-rosegold);\n            background: var(--color-cream);\n        }\n\n        .form-textarea {\n            min-height: 150px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1.2rem;\n            background: var(--gradient-wine);\n            color: var(--color-cream);\n            border: none;\n            border-radius: var(--radius-pill);\n            font-family: var(--font-body);\n            font-weight: 700;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .form-submit::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: -100%;\n            width: 100%;\n            height: 100%;\n            background: var(--gradient-shimmer);\n            transition: left 0.5s ease;\n        }\n\n        .form-submit:hover::before {\n            left: 100%;\n        }\n\n        .form-submit:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .form-submit span {\n            position: relative;\n            z-index: 1;\n        }\n\n        .contact-info {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-xl);\n        }\n\n        .contact-info-item {\n            text-align: center;\n            padding: var(--spacing-md);\n            background: var(--color-cream);\n            border: 1px solid var(--color-sand);\n            border-radius: var(--radius-ornate);\n        }\n\n        .contact-info-icon {\n            width: 55px;\n            height: 55px;\n            background: var(--gradient-rosegold);\n            border-radius: var(--radius-ornate);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin: 0 auto var(--spacing-sm);\n            font-size: 1.3rem;\n            color: var(--color-cream);\n        }\n\n        .contact-info-label {\n            font-family: var(--font-body);\n            font-size: 0.8rem;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 0.1em;\n            color: var(--color-rosegold-dark);\n            margin-bottom: 0.5rem;\n        }\n\n        .contact-info-value {\n            color: var(--color-burgundy);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--color-velvet);\n            color: var(--color-text-on-dark);\n            padding: var(--spacing-xl) var(--spacing-md) var(--spacing-md);\n            border-top: 1px solid rgba(212, 165, 116, 0.1);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-top {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: var(--spacing-xl);\n            margin-bottom: var(--spacing-xl);\n        }\n\n        .footer-brand {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-rosegold);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-description {\n            font-size: 0.95rem;\n            color: var(--color-blush-light);\n            max-width: 300px;\n        }\n\n        .footer-heading {\n            font-family: var(--font-display);\n            font-size: 1rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-rosegold);\n        }\n\n        .footer-links {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-links a {\n            color: var(--color-blush-light);\n            font-size: 0.9rem;\n            transition: var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-rosegold);\n        }\n\n        .footer-bottom {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding-top: var(--spacing-md);\n            border-top: 1px solid rgba(212, 165, 116, 0.1);\n        }\n\n        .footer-copyright {\n            font-size: 0.85rem;\n            color: var(--color-sand);\n        }\n\n        .footer-social {\n            display: flex;\n            gap: var(--spacing-sm);\n        }\n\n        .footer-social a {\n            width: 40px;\n            height: 40px;\n            background: rgba(212, 165, 116, 0.1);\n            border: 1px solid rgba(212, 165, 116, 0.2);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: var(--transition-fast);\n        }\n\n        .footer-social a:hover {\n            background: var(--gradient-rosegold);\n            border-color: transparent;\n        }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 1024px) {\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-cta {\n                justify-content: center;\n            }\n\n            .hero-visual {\n                display: none;\n            }\n\n            .services-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .testimonials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .footer-top {\n                grid-template-columns: 1fr 1fr;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                display: none;\n                position: absolute;\n                top: 100%;\n                left: 0;\n                right: 0;\n                background: rgba(253, 248, 245, 0.98);\n                flex-direction: column;\n                padding: var(--spacing-md);\n                gap: var(--spacing-sm);\n                border-top: 1px solid var(--color-sand);\n            }\n\n            .nav-menu.active {\n                display: flex;\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n\n            .problem-solution-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .services-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .testimonials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .form-row {\n                grid-template-columns: 1fr;\n            }\n\n            .contact-info {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-top {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-bottom {\n                flex-direction: column;\n                gap: var(--spacing-sm);\n                text-align: center;\n            }\n        }\n\n        /* ============================================\n           ACCESSIBILITY\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        .btn-focus:focus, .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: 2px solid var(--color-rosegold);\n            outline-offset: 2px;\n        }\n\n        /* Skip link */\n        .skip-link {\n            position: absolute;\n            top: -40px;\n            left: 0;\n            background: var(--color-velvet);\n            color: var(--color-cream);\n            padding: 8px 16px;\n            z-index: 9999;\n            transition: top 0.3s;\n        }\n\n        .skip-link:focus {\n            top: 0;\n        }\n    </style>\n</head>\n<body>\n    <a href=\"#main-content\" class=\"skip-link\">Pular para o conteúdo principal</a>\n\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Bonacci Estética</a>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#home\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contato\" class=\"nav-link nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Menu\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-decoration hero-arch-1\"></div>\n        <div class=\"hero-decoration hero-arch-2\"></div>\n        <div class=\"hero-ornament\"></div>\n\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge\">\n                    <span class=\"hero-badge-dot\"></span>\n                    Bonacci Estética Avançada\n                </div>\n                <h1 class=\"hero-title\">\n                    Sua Beleza Natural com\n                    <span class=\"hero-title-accent\">Elegância & Sofisticação</span>\n                </h1>\n                <p class=\"hero-description\">\n                    Descubra uma versão mais radiante e confiante de si mesma. Procedimentos estéticos avançados com resultados naturais e personalizados em Ribeirão Preto.\n                </p>\n                <div class=\"hero-cta\">\n                    <a href=\"#contato\" class=\"btn-primary\">\n                        <span>Agendar Consulta</span>\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                    <a href=\"#servicos\" class=\"btn-secondary\">Conhecer Serviços</a>\n                </div>\n            </div>\n\n            <div class=\"hero-visual\">\n                <div class=\"hero-arch-frame\">\n                    <div class=\"hero-arch-inner\">\n                        <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=600&h=750&fit=crop&crop=face\" alt=\"Procedimento estético facial profissional\" class=\"hero-image\">\n                    </div>\n                </div>\n                <div class=\"hero-stat-card hero-stat-1\">\n                    <div class=\"hero-stat-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"hero-stat-content\">\n                        <p class=\"hero-stat-value\">+8 anos</p>\n                        <p class=\"hero-stat-label\">Experiência</p>\n                    </div>\n                </div>\n                <div class=\"hero-stat-card hero-stat-2\">\n                    <div class=\"hero-stat-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"hero-stat-content\">\n                        <p class=\"hero-stat-value\">99%</p>\n                        <p class=\"hero-stat-label\">Satisfação</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\" id=\"problema-solucao\">\n        <div class=\"section-header wow-fade-up\">\n            <p class=\"section-tag\">Sua Jornada de Transformação</p>\n            <h2 class=\"section-title\">O Que Você Busca</h2>\n            <p class=\"section-description\">Entendemos seus anseios e oferecemos soluções personalizadas</p>\n        </div>\n\n        <div class=\"problem-solution-grid\">\n            <div class=\"problem-section\">\n                <p class=\"section-label\">Desafios</p>\n\n                <div class=\"ps-card wow-fade-up\">\n                    <h3 class=\"ps-card-title\">Sinais do Tempo</h3>\n                    <p class=\"ps-card-text\">Rugas finas, linhas de expressão e perda de volume que revelam a passagem dos anos.</p>\n                </div>\n\n                <div class=\"ps-card wow-fade-up\" data-delay=\"100\">\n                    <h3 class=\"ps-card-title\">Desejo de Renovação</h3>\n                    <p class=\"ps-card-text\">Vontade de se sentir mais confiante e radiante, com aparência descansada e revitalizada.</p>\n                </div>\n\n                <div class=\"ps-card wow-fade-up\" data-delay=\"200\">\n                    <h3 class=\"ps-card-title\">Harmonia Facial</h3>\n                    <p class=\"ps-card-text\">Busca por equilíbrio estético que realce sua beleza natural sem artificialidade.</p>\n                </div>\n            </div>\n\n            <div class=\"solution-section\">\n                <p class=\"section-label\">Nossas Soluções</p>\n\n                <div class=\"ps-card wow-fade-up\" data-delay=\"300\">\n                    <h3 class=\"ps-card-title\">Resultados Naturais</h3>\n                    <p class=\"ps-card-text\">Procedimentos que sutlizam e realçam, mantendo sua identidade e expressão únicas.</p>\n                </div>\n\n                <div class=\"ps-card wow-fade-up\" data-delay=\"400\">\n                    <h3 class=\"ps-card-title\">Abordagem Personalizada</h3>\n                    <p class=\"ps-card-text\">Cada tratamento é desenvolvido exclusivamente para suas características e objetivos.</p>\n                </div>\n\n                <div class=\"ps-card wow-fade-up\" data-delay=\"500\">\n                    <h3 class=\"ps-card-title\">Excelência Estética</h3>\n                    <p class=\"ps-card-text\">Técnicas avançadas combinadas com refinamento e atenção aos menores detalhes.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"section-header wow-fade-up\">\n            <p class=\"section-tag\">Procedimentos Exclusivos</p>\n            <h2 class=\"section-title\">Nossos Serviços</h2>\n            <p class=\"section-description\">Tratamentos personalizados para realçar sua beleza natural</p>\n        </div>\n\n        <div class=\"services-grid\">\n            <div class=\"service-card wow-fade-up\">\n                <div class=\"service-icon\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                        <path d=\"M8 14s1.5 2 4 2 4-2 4-2\"/>\n                        <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"/>\n                        <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"/>\n                    </svg>\n                </div>\n                <h3 class=\"service-title\">Harmonização Facial</h3>\n                <p class=\"service-description\">Equilibre seus traços faciais com procedimentos minimamente invasivos para resultados naturais e harmônicos.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"100\">\n                <div class=\"service-icon\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M12 2L2 7l10 5 10-5-10-5z\"/>\n                        <path d=\"M2 17l10 5 10-5\"/>\n                        <path d=\"M2 12l10 5 10-5\"/>\n                    </svg>\n                </div>\n                <h3 class=\"service-title\">Toxina Botulínica</h3>\n                <p class=\"service-description\">Suavize linhas de expressão com aplicações precisas para uma aparência descansada e rejuvenescida.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                <div class=\"service-icon\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M12 2v20M2 12h20\"/>\n                    </svg>\n                </div>\n                <h3 class=\"service-title\">Preenchedores Faciais</h3>\n                <p class=\"service-description\">Restaure volume e contorno facial com ácido hialurônico de alta qualidade para resultados duradouros.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"300\">\n                <div class=\"service-icon\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/>\n                    </svg>\n                </div>\n                <h3 class=\"service-title\">Preenchimento Labial</h3>\n                <p class=\"service-description\">Realce seus lábios com preenchimento que mantém a naturalidade e proporção ideal do seu rosto.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n                <div class=\"service-icon\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                        <path d=\"M8 12h8\"/>\n                    </svg>\n                </div>\n                <h3 class=\"service-title\">Bioestimuladores</h3>\n                <p class=\"service-description\">Estimule o colágeno natural para firmeza e rejuvenescimento progressivo da pele.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"500\">\n                <div class=\"service-icon\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/>\n                    </svg>\n                </div>\n                <h3 class=\"service-title\">Protocolos Premium</h3>\n                <p class=\"service-description\">Planos de tratamento exclusivos desenvolvidos especificamente para suas necessidades e objetivos.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"section-header wow-fade-up\">\n            <p class=\"section-tag\">Experiências Reais</p>\n            <h2 class=\"section-title\">O Que Dizem Nossas Clientes</h2>\n            <p class=\"section-description\">Histórias de transformação e satisfação</p>\n        </div>\n\n        <div class=\"testimonials-grid\">\n            <div class=\"testimonial-card wow-fade-up\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"A Dra. Bonatti é excepcional! Fiz minha harmonização e o resultado ficou super natural e elegante. Ela tem uma sensibilidade única.\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">RF</div>\n                    <div class=\"testimonial-info\">\n                        <p class=\"testimonial-name\">Renata Ferreira</p>\n                        <p class=\"testimonial-role\">Advogada</p>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"testimonial-card wow-fade-up\" data-delay=\"100\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"Ambiente sofisticado e atendimento impecável. Fiz preenchimento labial e amei o resultado. Recomendo de olhos fechados!\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">CM</div>\n                    <div class=\"testimonial-info\">\n                        <p class=\"testimonial-name\">Carla Mendes</p>\n                        <p class=\"testimonial-role\">Empresária</p>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"testimonial-card wow-fade-up\" data-delay=\"200\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"Profissional extraordinária! A Dra. Bonatti entendeu exatamente o que eu queria. O resultado superou todas as minhas expectativas.\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">JO</div>\n                    <div class=\"testimonial-info\">\n                        <p class=\"testimonial-name\">Juliana Oliveira</p>\n                        <p class=\"testimonial-role\">Arquiteta</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\" id=\"diferenciais\">\n        <div class=\"section-header wow-fade-up\">\n            <p class=\"section-tag\">Nossa Essência</p>\n            <h2 class=\"section-title\">Por Que Escolher Bonacci</h2>\n            <p class=\"section-description\">O que nos torna únicos em Ribeirão Preto</p>\n        </div>\n\n        <div class=\"differentials-grid\">\n            <div class=\"differential-item wow-fade-up\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon-bg\"></div>\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/>\n                        </svg>\n                    </div>\n                </div>\n                <h3 class=\"differential-title\">Excelência Reconhecida</h3>\n                <p class=\"differential-description\">Especialista com formação avançada em harmonização facial</p>\n            </div>\n\n            <div class=\"differential-item wow-fade-up\" data-delay=\"100\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon-bg\"></div>\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/>\n                        </svg>\n                    </div>\n                </div>\n                <h3 class=\"differential-title\">Atendimento Sofisticado</h3>\n                <p class=\"differential-description\">Cada paciente recebe um protocolo exclusivo e personalizado</p>\n            </div>\n\n            <div class=\"differential-item wow-fade-up\" data-delay=\"200\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon-bg\"></div>\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"/>\n                            <path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"/>\n                        </svg>\n                    </div>\n                </div>\n                <h3 class=\"differential-title\">Produtos Premium</h3>\n                <p class=\"differential-description\">Utilizamos apenas preenchedores e toxinas de primeira linha</p>\n            </div>\n\n            <div class=\"differential-item wow-fade-up\" data-delay=\"300\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon-bg\"></div>\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            <polyline points=\"12 6 12 12 16 14\"/>\n                        </svg>\n                    </div>\n                </div>\n                <h3 class=\"differential-title\">Pontualidade Elegante</h3>\n                <p class=\"differential-description\">Respeito pelo seu tempo com agendamentos precisos</p>\n            </div>\n\n            <div class=\"differential-item wow-fade-up\" data-delay=\"400\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon-bg\"></div>\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n                        </svg>\n                    </div>\n                </div>\n                <h3 class=\"differential-title\">Segurança Absoluta</h3>\n                <p class=\"differential-description\">Procedimentos realizados com máxima segurança e assepsia</p>\n            </div>\n\n            <div class=\"differential-item wow-fade-up\" data-delay=\"500\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon-bg\"></div>\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"/>\n                        </svg>\n                    </div>\n                </div>\n                <h3 class=\"differential-title\">Acompanhamento Completo</h3>\n                <p class=\"differential-description\">Suporte contínuo e dedicado antes e depois dos procedimentos</p>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"section-header wow-fade-up\">\n            <p class=\"section-tag\">Entre em Contato</p>\n            <h2 class=\"section-title\">Agende Sua Consulta</h2>\n            <p class=\"section-description\">Dê o primeiro passo para sua transformação</p>\n        </div>\n\n        <div class=\"contact-container\">\n            <form class=\"contact-form\" id=\"contactForm\">\n                <div class=\"form-row\">\n                    <div class=\"form-group\">\n                        <label for=\"name\" class=\"form-label\">Nome Completo</label>\n                        <input type=\"text\" id=\"name\" name=\"name\" class=\"form-input\" placeholder=\"Seu nome\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"email\" class=\"form-label\">E-mail</label>\n                        <input type=\"email\" id=\"email\" name=\"email\" class=\"form-input\" placeholder=\"seu@email.com\" required>\n                    </div>\n                </div>\n                <div class=\"form-row\">\n                    <div class=\"form-group\">\n                        <label for=\"phone\" class=\"form-label\">Telefone</label>\n                        <input type=\"tel\" id=\"phone\" name=\"phone\" class=\"form-input\" placeholder=\"(16) 99999-9999\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"service\" class=\"form-label\">Serviço de Interesse</label>\n                        <select id=\"service\" name=\"service\" class=\"form-select\" required>\n                            <option value=\"\">Selecione</option>\n                            <option value=\"harmonizacao\">Harmonização Facial</option>\n                            <option value=\"botulina\">Toxina Botulínica</option>\n                            <option value=\"preenchedores\">Preenchedores Faciais</option>\n                            <option value=\"labial\">Preenchimento Labial</option>\n                            <option value=\"bioestimuladores\">Bioestimuladores</option>\n                            <option value=\"protocolos\">Protocolos Premium</option>\n                        </select>\n                    </div>\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"message\" class=\"form-label\">Mensagem</label>\n                    <textarea id=\"message\" name=\"message\" class=\"form-textarea\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                </div>\n                <button type=\"submit\" class=\"form-submit\"><span>Enviar via WhatsApp</span></button>\n            </form>\n\n            <div class=\"contact-info\">\n                <div class=\"contact-info-item\">\n                    <div class=\"contact-info-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/>\n                            <circle cx=\"12\" cy=\"10\" r=\"3\"/>\n                        </svg>\n                    </div>\n                    <p class=\"contact-info-label\">Endereço</p>\n                    <p class=\"contact-info-value\">Rua Milton José Robusti, 75 - Sala 1610<br>Jardim Botânico, Ribeirão Preto - SP<br>CEP: 14021-613</p>\n                </div>\n                <div class=\"contact-info-item\">\n                    <div class=\"contact-info-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"/>\n                        </svg>\n                    </div>\n                    <p class=\"contact-info-label\">Telefone</p>\n                    <p class=\"contact-info-value\">(16) 99630-9696</p>\n                </div>\n                <div class=\"contact-info-item\">\n                    <div class=\"contact-info-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/>\n                            <path d=\"M10 8h4\"/><path d=\"M10 12h4\"/><path d=\"M10 16h4\"/>\n                        </svg>\n                    </div>\n                    <p class=\"contact-info-label\">Horário</p>\n                    <p class=\"contact-info-value\">Segunda a Sexta<br>9h às 18h</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-top\">\n                <div>\n                    <p class=\"footer-brand\">Bonacci Estética Avançada</p>\n                    <p class=\"footer-description\">Harmonização facial e estética avançada com resultados naturais e elegantes em Ribeirão Preto.</p>\n                </div>\n                <div>\n                    <p class=\"footer-heading\">Links Rápidos</p>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#home\">Início</a></li>\n                        <li><a href=\"#servicos\">Serviços</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                        <li><a href=\"#contato\">Contato</a></li>\n                    </ul>\n                </div>\n                <div>\n                    <p class=\"footer-heading\">Serviços</p>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#servicos\">Harmonização Facial</a></li>\n                        <li><a href=\"#servicos\">Toxina Botulínica</a></li>\n                        <li><a href=\"#servicos\">Preenchedores</a></li>\n                        <li><a href=\"#servicos\">Bioestimuladores</a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"footer-bottom\">\n                <p class=\"footer-copyright\">© 2026 Bonacci Estética Avançada. Todos os direitos reservados.</p>\n                <div class=\"footer-social\">\n                    <a href=\"#\" aria-label=\"Instagram\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\" ry=\"5\"/>\n                            <path d=\"M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z\"/>\n                            <line x1=\"17.5\" y1=\"6.5\" x2=\"17.51\" y2=\"6.5\"/>\n                        </svg>\n                    </a>\n                    <a href=\"#\" aria-label=\"WhatsApp\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"/>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION\n        // ============================================\n        const nav = document.getElementById('nav');\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n        let lastScrollY = window.scrollY;\n\n        window.addEventListener('scroll', () => {\n            if (window.scrollY > lastScrollY && window.scrollY > 100) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n            lastScrollY = window.scrollY;\n\n            // Add shadow on scroll\n            if (window.scrollY > 50) {\n                nav.classList.add('scrolled');\n            } else {\n                nav.classList.remove('scrolled');\n            }\n        });\n\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function (e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER (WOW ANIMATIONS)\n        // ============================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || 0;\n                    setTimeout(() => {\n                        entry.target.classList.add('visible');\n                    }, delay);\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // CONTACT FORM (WHATSAPP)\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n        contactForm.addEventListener('submit', function(e) {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const email = document.getElementById('email').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceNames = {\n                'harmonizacao': 'Harmonização Facial',\n                'botulina': 'Toxina Botulínica',\n                'preenchedores': 'Preenchedores Faciais',\n                'labial': 'Preenchimento Labial',\n                'bioestimuladores': 'Bioestimuladores',\n                'protocolos': 'Protocolos Premium'\n            };\n\n            const whatsappMessage = `Olá! Meu nome é ${name}.\\n\\nEmail: ${email}\\nTelefone: ${phone}\\nServiço de interesse: ${serviceNames[service] || service}\\n\\nMensagem: ${message || 'Gostaria de agendar uma consulta.'}`;\n\n            const whatsappUrl = `https://wa.me/5516996309696?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappUrl, '_blank');\n        });\n\n        // ============================================\n        // HERO PARALLAX\n        // ============================================\n        const hero = document.querySelector('.hero');\n        const decorations = document.querySelectorAll('.hero-decoration');\n        const ornament = document.querySelector('.hero-ornament');\n\n        if (window.innerWidth > 768) {\n            hero.addEventListener('mousemove', (e) => {\n                const { clientX, clientY } = e;\n                const { innerWidth, innerHeight } = window;\n\n                const xPercent = (clientX / innerWidth - 0.5) * 2;\n                const yPercent = (clientY / innerHeight - 0.5) * 2;\n\n                decorations.forEach((deco, index) => {\n                    const speed = (index + 1) * 15;\n                    const x = xPercent * speed;\n                    const y = yPercent * speed;\n                    deco.style.transform = `translate(${x}px, ${y}px)`;\n                });\n\n                if (ornament) {\n                    const rotateSpeed = 10;\n                    ornament.style.transform = `rotate(${xPercent * rotateSpeed}deg) translateY(${yPercent * 5}px)`;\n                }\n            });\n        }\n\n        // ============================================\n        // PREFERRED REDUCED MOTION\n        // ============================================\n        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n        if (prefersReducedMotion.matches) {\n            document.querySelectorAll('.hero-decoration, .hero-ornament').forEach(el => {\n                el.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"382169d9-2791-4e15-9f28-829208aba45c","uuid":"4904f0a8-1312-4914-9f55-6f22010719a5"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6749aee28bac465991287a2c","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/bonacci-estetica-avancada/index.html"}]},"parent_tool_use_id":null,"session_id":"382169d9-2791-4e15-9f28-829208aba45c","uuid":"d302187f-4c42-4135-b118-d061bc3249d0","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/bonacci-estetica-avancada/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Bonacci Estética Avançada | Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Bonacci Estética Avançada - Harmonização Facial e Estética Avançada em Ribeirão Preto. Atendimento especializado com resultados naturais e elegantes.\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=DM+Sans:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ============================================\n           CSS VARIABLES - Rose Gold & Velvet Noir\n           ============================================ */\n        :root {\n            /* Primary Palette - Velvet Noir */\n            --color-velvet: #2D1F1F;\n            --color-velvet-light: #3D2A2A;\n            --color-velvet-deep: #1A1212;\n            --color-burgundy: #4A1C1C;\n            --color-burgundy-light: #6B2D2D;\n            --color-wine: #7B2E3E;\n\n            /* Accent Palette - Rose Gold */\n            --color-rosegold: #D4A574;\n            --color-rosegold-light: #E8C9A8;\n            --color-rosegold-mid: #C99B6A;\n            --color-rosegold-dark: #B89065;\n            --color-rosegold-shimmer: #F0DCC8;\n\n            /* Neutral Palette - Cream & Blush */\n            --color-cream: #FDF8F5;\n            --color-cream-dark: #F5EDE7;\n            --color-blush: #F5E6E0;\n            --color-blush-light: #FAF0EB;\n            --color-sand: #E8DDD5;\n\n            /* Text Colors */\n            --color-text-primary: #2D1F1F;\n            --color-text-secondary: #5D4A4A;\n            --color-text-muted: #8B7575;\n            --color-text-on-dark: #FDF8F5;\n\n            /* Gradients */\n            --gradient-velvet: linear-gradient(135deg, var(--color-velvet-deep) 0%, var(--color-velvet) 50%, var(--color-burgundy) 100%);\n            --gradient-rosegold: linear-gradient(135deg, var(--color-rosegold-dark) 0%, var(--color-rosegold) 50%, var(--color-rosegold-light) 100%);\n            --gradient-blush: linear-gradient(135deg, var(--color-blush) 0%, var(--color-blush-light) 50%, var(--color-cream) 100%);\n            --gradient-hero: linear-gradient(180deg, var(--color-cream) 0%, var(--color-blush) 100%);\n            --gradient-wine: linear-gradient(135deg, var(--color-burgundy) 0%, var(--color-wine) 100%);\n            --gradient-shimmer: linear-gradient(90deg, var(--color-rosegold) 0%, var(--color-rosegold-shimmer) 50%, var(--color-rosegold) 100%);\n\n            /* Arch Shapes - Inspired by Architecture */\n            --radius-arch: 50% 50% 0 0 / 100% 100% 0 0;\n            --radius-arch-sm: 40% 40% 0 0 / 80% 80% 0 0;\n            --radius-arch-lg: 60% 60% 0 0 / 120% 120% 0 0;\n\n            /* Ornate Border Radius */\n            --radius-ornate: 12px;\n            --radius-ornate-lg: 20px;\n            --radius-pill: 100px;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n            --spacing-2xl: 8rem;\n\n            /* Typography */\n            --font-display: 'Playfair Display', Georgia, serif;\n            --font-body: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;\n\n            /* Transitions */\n            --transition-fast: 0.2s ease;\n            --transition-base: 0.4s ease;\n            --transition-slow: 0.6s ease;\n\n            /* Shadows */\n            --shadow-soft: 0 4px 20px rgba(45, 31, 31, 0.08);\n            --shadow-medium: 0 8px 30px rgba(45, 31, 31, 0.12);\n            --shadow-strong: 0 12px 40px rgba(45, 31, 31, 0.15);\n            --shadow-glow: 0 0 30px rgba(212, 165, 116, 0.3);\n            --shadow-rosegold: 0 4px 25px rgba(212, 165, 116, 0.2);\n        }\n\n        /* ============================================\n           RESET & BASE STYLES\n           ============================================ */\n        *, *::before, *::after {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        html {\n            scroll-behavior: smooth;\n        }\n\n        body {\n            font-family: var(--font-body);\n            font-size: 16px;\n            line-height: 1.7;\n            color: var(--color-text-primary);\n            background: var(--color-cream);\n            overflow-x: hidden;\n        }\n\n        /* ============================================\n           TYPOGRAPHY\n           ============================================ */\n        h1, h2, h3, h4, h5, h6 {\n            font-family: var(--font-display);\n            font-weight: 600;\n            line-height: 1.2;\n            color: var(--color-velvet);\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 6vw, 4.5rem);\n            font-weight: 700;\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 4vw, 3rem);\n            margin-bottom: var(--spacing-md);\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 2.5vw, 2rem);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        p {\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-text-secondary);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-base);\n        }\n\n        /* ============================================\n           NAVIGATION\n           ============================================ */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            right: 0;\n            z-index: 1000;\n            padding: var(--spacing-sm) var(--spacing-md);\n            background: rgba(253, 248, 245, 0.95);\n            backdrop-filter: blur(20px);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n            box-shadow: 0 1px 20px rgba(45, 31, 31, 0.05);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav.scrolled {\n            box-shadow: 0 2px 30px rgba(45, 31, 31, 0.1);\n        }\n\n        .nav-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-burgundy);\n            text-decoration: none;\n            letter-spacing: 0.02em;\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: var(--spacing-md);\n            list-style: none;\n        }\n\n        .nav-link {\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-text-secondary);\n            text-decoration: none;\n            transition: color var(--transition-fast);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 50%;\n            width: 0;\n            height: 2px;\n            background: var(--gradient-rosegold);\n            transition: width var(--transition-fast), left var(--transition-fast);\n        }\n\n        .nav-link:hover {\n            color: var(--color-burgundy);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n            left: 0;\n        }\n\n        .nav-cta {\n            background: var(--gradient-wine);\n            color: var(--color-cream) !important;\n            padding: 0.75rem 1.5rem;\n            border-radius: var(--radius-pill);\n            transition: transform var(--transition-fast), box-shadow var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-glow);\n            color: var(--color-cream) !important;\n        }\n\n        .nav-cta::after {\n            display: none;\n        }\n\n        .nav-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            background: none;\n            border: none;\n            cursor: pointer;\n            padding: 0.5rem;\n        }\n\n        .nav-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-velvet);\n            transition: var(--transition-fast);\n            border-radius: 2px;\n        }\n\n        /* ============================================\n           HERO SECTION\n           ============================================ */\n        .hero {\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            position: relative;\n            padding: var(--spacing-xl) var(--spacing-md) var(--spacing-2xl);\n            background: var(--gradient-hero);\n            overflow: hidden;\n        }\n\n        .hero-decoration {\n            position: absolute;\n            pointer-events: none;\n            opacity: 0.4;\n        }\n\n        .hero-arch-1 {\n            top: -10%;\n            right: -5%;\n            width: 500px;\n            height: 600px;\n            background: var(--gradient-blush);\n            border-radius: var(--radius-arch);\n            filter: blur(60px);\n        }\n\n        .hero-arch-2 {\n            bottom: -15%;\n            left: -10%;\n            width: 400px;\n            height: 500px;\n            background: linear-gradient(135deg, var(--color-blush-light) 0%, var(--color-sand) 100%);\n            border-radius: var(--radius-arch-lg);\n            filter: blur(80px);\n        }\n\n        .hero-ornament {\n            position: absolute;\n            width: 300px;\n            height: 300px;\n            border: 1px solid rgba(212, 165, 116, 0.2);\n            border-radius: 50%;\n            top: 20%;\n            right: 15%;\n            animation: rotate-slow 30s linear infinite;\n        }\n\n        .hero-ornament::before {\n            content: '';\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            width: 200px;\n            height: 200px;\n            border: 1px solid rgba(212, 165, 116, 0.15);\n            border-radius: 50%;\n            transform: translate(-50%, -50%);\n        }\n\n        @keyframes rotate-slow {\n            from { transform: rotate(0deg); }\n            to { transform: rotate(360deg); }\n        }\n\n        .hero-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-xl);\n            align-items: center;\n            position: relative;\n            z-index: 10;\n        }\n\n        .hero-content {\n            opacity: 0;\n            animation: fade-up 1s ease forwards;\n            animation-delay: 0ms;\n        }\n\n        @keyframes fade-up {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n            background: var(--color-cream);\n            border: 1px solid var(--color-rosegold);\n            padding: 0.5rem 1rem;\n            border-radius: var(--radius-pill);\n            font-family: var(--font-body);\n            font-size: 0.8rem;\n            font-weight: 600;\n            color: var(--color-burgundy);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .hero-badge-dot {\n            width: 6px;\n            height: 6px;\n            background: var(--color-rosegold);\n            border-radius: 50%;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; transform: scale(1); }\n            50% { opacity: 0.5; transform: scale(1.2); }\n        }\n\n        .hero-title {\n            margin-bottom: var(--spacing-md);\n            line-height: 1.1;\n        }\n\n        .hero-title-accent {\n            background: var(--gradient-wine);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n            display: inline-block;\n        }\n\n        .hero-description {\n            font-size: 1.15rem;\n            line-height: 1.8;\n            margin-bottom: var(--spacing-lg);\n            max-width: 500px;\n            color: var(--color-text-secondary);\n        }\n\n        .hero-cta {\n            display: flex;\n            gap: var(--spacing-sm);\n            flex-wrap: wrap;\n        }\n\n        .btn-primary {\n            background: var(--gradient-wine);\n            color: var(--color-cream);\n            padding: 1rem 2rem;\n            border-radius: var(--radius-pill);\n            font-family: var(--font-body);\n            font-weight: 600;\n            font-size: 0.95rem;\n            text-decoration: none;\n            transition: var(--transition-base);\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            border: none;\n            cursor: pointer;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .btn-primary::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: -100%;\n            width: 100%;\n            height: 100%;\n            background: var(--gradient-shimmer);\n            transition: left 0.5s ease;\n        }\n\n        .btn-primary:hover::before {\n            left: 100%;\n        }\n\n        .btn-primary:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .btn-primary span {\n            position: relative;\n            z-index: 1;\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-burgundy);\n            padding: 1rem 2rem;\n            border: 2px solid var(--color-rosegold);\n            border-radius: var(--radius-pill);\n            font-family: var(--font-body);\n            font-weight: 600;\n            font-size: 0.95rem;\n            text-decoration: none;\n            transition: var(--transition-base);\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-rosegold);\n            color: var(--color-cream);\n            transform: translateY(-3px);\n        }\n\n        .hero-visual {\n            position: relative;\n            opacity: 0;\n            animation: fade-up 1s ease forwards;\n            animation-delay: 200ms;\n        }\n\n        .hero-arch-frame {\n            position: relative;\n            border-radius: var(--radius-arch);\n            overflow: hidden;\n            box-shadow: var(--shadow-strong);\n        }\n\n        .hero-arch-inner {\n            position: relative;\n            padding: 2rem;\n            background: var(--gradient-velvet);\n        }\n\n        .hero-image {\n            width: 100%;\n            height: auto;\n            display: block;\n            border-radius: var(--radius-arch);\n        }\n\n        .hero-stat-card {\n            position: absolute;\n            background: var(--color-cream);\n            border-radius: var(--radius-ornate-lg);\n            padding: 1.25rem 1.5rem;\n            box-shadow: var(--shadow-medium);\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .hero-stat-1 {\n            top: 15%;\n            left: -30px;\n            animation: float 6s ease-in-out infinite;\n        }\n\n        .hero-stat-2 {\n            bottom: 20%;\n            right: -25px;\n            animation: float 6s ease-in-out infinite;\n            animation-delay: -3s;\n        }\n\n        @keyframes float {\n            0%, 100% { transform: translateY(0); }\n            50% { transform: translateY(-15px); }\n        }\n\n        .hero-stat-icon {\n            width: 45px;\n            height: 45px;\n            background: var(--gradient-rosegold);\n            border-radius: 12px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--color-cream);\n            font-size: 1.2rem;\n        }\n\n        .hero-stat-content {\n            text-align: left;\n        }\n\n        .hero-stat-value {\n            font-family: var(--font-display);\n            font-size: 1.4rem;\n            font-weight: 700;\n            color: var(--color-burgundy);\n            line-height: 1;\n        }\n\n        .hero-stat-label {\n            font-family: var(--font-body);\n            font-size: 0.75rem;\n            font-weight: 600;\n            color: var(--color-text-muted);\n            text-transform: uppercase;\n            letter-spacing: 0.05em;\n        }\n\n        /* ============================================\n           SECTION BASE STYLES\n           ============================================ */\n        .section {\n            padding: var(--spacing-xl) var(--spacing-md);\n            position: relative;\n        }\n\n        .section-header {\n            text-align: center;\n            max-width: 700px;\n            margin: 0 auto var(--spacing-xl);\n        }\n\n        .section-tag {\n            font-family: var(--font-body);\n            font-size: 0.85rem;\n            font-weight: 600;\n            letter-spacing: 0.15em;\n            text-transform: uppercase;\n            color: var(--color-rosegold-dark);\n            margin-bottom: var(--spacing-sm);\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n        }\n\n        .section-tag::before,\n        .section-tag::after {\n            content: '';\n            width: 30px;\n            height: 1px;\n            background: var(--gradient-rosegold);\n        }\n\n        .section-title {\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .section-description {\n            font-size: 1.05rem;\n        }\n\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(40px);\n            transition: opacity 0.8s ease, transform 0.8s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        /* ============================================\n           PROBLEM/SOLUTION SECTION\n           ============================================ */\n        .problem-solution {\n            background: var(--color-blush-light);\n        }\n\n        .problem-solution-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-lg);\n        }\n\n        .problem-section, .solution-section {\n            padding: var(--spacing-lg);\n            border-radius: var(--radius-ornate-lg);\n        }\n\n        .problem-section {\n            background: var(--color-cream);\n            border: 1px solid var(--color-sand);\n        }\n\n        .solution-section {\n            background: var(--gradient-velvet);\n            border: 1px solid var(--color-burgundy);\n            color: var(--color-text-on-dark);\n        }\n\n        .section-label {\n            font-family: var(--font-body);\n            font-size: 0.8rem;\n            font-weight: 700;\n            letter-spacing: 0.15em;\n            text-transform: uppercase;\n            margin-bottom: var(--spacing-md);\n            display: inline-flex;\n            align-items: center;\n            gap: var(--spacing-xs);\n        }\n\n        .problem-section .section-label {\n            color: var(--color-wine);\n        }\n\n        .solution-section .section-label {\n            color: var(--color-rosegold);\n        }\n\n        .section-label::before {\n            content: '';\n            width: 8px;\n            height: 8px;\n            border-radius: 50%;\n        }\n\n        .problem-section .section-label::before {\n            background: var(--color-wine);\n        }\n\n        .solution-section .section-label::before {\n            background: var(--color-rosegold);\n        }\n\n        .ps-card {\n            background: rgba(255, 255, 255, 0.6);\n            border: 1px solid rgba(45, 31, 31, 0.1);\n            border-radius: var(--radius-ornate);\n            padding: var(--spacing-md);\n            margin-bottom: var(--spacing-md);\n            transition: var(--transition-base);\n        }\n\n        .ps-card:last-child {\n            margin-bottom: 0;\n        }\n\n        .solution-section .ps-card {\n            background: rgba(255, 255, 255, 0.05);\n            border-color: rgba(212, 165, 116, 0.2);\n        }\n\n        .ps-card:hover {\n            transform: translateX(10px);\n        }\n\n        .problem-section .ps-card:hover {\n            background: rgba(255, 255, 255, 0.9);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .solution-section .ps-card:hover {\n            background: rgba(255, 255, 255, 0.1);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .ps-card-title {\n            font-family: var(--font-display);\n            font-size: 1.2rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-burgundy);\n        }\n\n        .solution-section .ps-card-title {\n            color: var(--color-rosegold);\n        }\n\n        .ps-card-text {\n            font-size: 0.95rem;\n            margin: 0;\n        }\n\n        .solution-section .ps-card-text {\n            color: var(--color-blush-light);\n        }\n\n        /* ============================================\n           SERVICES SECTION\n           ============================================ */\n        .services {\n            background: var(--color-cream);\n        }\n\n        .services-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n        }\n\n        .service-card {\n            background: var(--color-cream);\n            border: 1px solid var(--color-sand);\n            border-radius: var(--radius-ornate-lg);\n            padding: var(--spacing-md);\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n            background: var(--gradient-rosegold);\n            opacity: 0;\n            transition: var(--transition-base);\n        }\n\n        .service-card:hover {\n            transform: translateY(-10px);\n            box-shadow: var(--shadow-medium);\n            border-color: var(--color-rosegold);\n        }\n\n        .service-card:hover::before {\n            opacity: 1;\n        }\n\n        .service-icon {\n            width: 65px;\n            height: 65px;\n            background: var(--gradient-rosegold);\n            border-radius: var(--radius-ornate);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: var(--spacing-sm);\n            font-size: 1.5rem;\n            color: var(--color-cream);\n        }\n\n        .service-title {\n            font-family: var(--font-display);\n            font-size: 1.3rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-burgundy);\n        }\n\n        .service-description {\n            font-size: 0.95rem;\n            color: var(--color-text-secondary);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .service-link {\n            color: var(--color-wine);\n            font-weight: 600;\n            font-size: 0.9rem;\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .service-link:hover {\n            color: var(--color-burgundy);\n        }\n\n        /* ============================================\n           TESTIMONIALS SECTION\n           ============================================ */\n        .testimonials {\n            background: var(--gradient-blush);\n        }\n\n        .testimonials-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n        }\n\n        .testimonial-card {\n            background: var(--color-cream);\n            border: 1px solid var(--color-sand);\n            border-radius: var(--radius-ornate-lg);\n            padding: var(--spacing-md);\n            position: relative;\n        }\n\n        .testimonial-card::before {\n            content: '\"';\n            font-family: var(--font-display);\n            font-size: 6rem;\n            color: var(--color-rosegold);\n            opacity: 0.2;\n            position: absolute;\n            top: 0;\n            left: 1rem;\n            line-height: 1;\n        }\n\n        .testimonial-stars {\n            color: var(--color-rosegold);\n            margin-bottom: var(--spacing-sm);\n            font-size: 1rem;\n        }\n\n        .testimonial-text {\n            font-size: 0.95rem;\n            font-style: italic;\n            margin-bottom: var(--spacing-md);\n            color: var(--color-text-secondary);\n            position: relative;\n            z-index: 1;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: var(--spacing-sm);\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: var(--gradient-rosegold);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-family: var(--font-display);\n            font-weight: 700;\n            color: var(--color-cream);\n            font-size: 1.1rem;\n        }\n\n        .testimonial-info {\n            flex: 1;\n        }\n\n        .testimonial-name {\n            font-family: var(--font-display);\n            font-weight: 600;\n            font-size: 1rem;\n            color: var(--color-burgundy);\n        }\n\n        .testimonial-role {\n            font-size: 0.85rem;\n            color: var(--color-text-muted);\n        }\n\n        /* ============================================\n           DIFFERENTIALS SECTION\n           ============================================ */\n        .differentials {\n            background: var(--color-velvet);\n            color: var(--color-text-on-dark);\n        }\n\n        .differentials .section-title,\n        .differentials .section-description {\n            color: var(--color-text-on-dark);\n        }\n\n        .differentials-grid {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-lg);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: var(--spacing-md);\n        }\n\n        .differential-icon-wrapper {\n            position: relative;\n            width: 100px;\n            height: 100px;\n            margin: 0 auto var(--spacing-sm);\n        }\n\n        .differential-icon-bg {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            background: var(--gradient-rosegold);\n            border-radius: 50%;\n            opacity: 0.15;\n            animation: pulse-ring 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse-ring {\n            0%, 100% { transform: scale(1); opacity: 0.15; }\n            50% { transform: scale(1.1); opacity: 0.08; }\n        }\n\n        .differential-icon {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 55px;\n            height: 55px;\n            background: var(--gradient-rosegold);\n            border-radius: var(--radius-ornate);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.3rem;\n            z-index: 1;\n            color: var(--color-cream);\n        }\n\n        .differential-title {\n            font-family: var(--font-display);\n            font-size: 1.2rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-xs);\n            color: var(--color-rosegold);\n        }\n\n        .differential-description {\n            font-size: 0.9rem;\n            color: var(--color-blush-light);\n        }\n\n        /* ============================================\n           CONTACT SECTION\n           ============================================ */\n        .contact {\n            background: var(--gradient-blush);\n        }\n\n        .contact-container {\n            max-width: 800px;\n            margin: 0 auto;\n        }\n\n        .contact-form {\n            background: var(--color-cream);\n            border: 1px solid var(--color-sand);\n            border-radius: var(--radius-ornate-lg);\n            padding: var(--spacing-xl);\n            box-shadow: var(--shadow-medium);\n        }\n\n        .form-row {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: var(--spacing-md);\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-group {\n            margin-bottom: var(--spacing-md);\n        }\n\n        .form-group.full-width {\n            grid-column: 1 / -1;\n        }\n\n        .form-label {\n            display: block;\n            font-family: var(--font-body);\n            font-size: 0.9rem;\n            font-weight: 600;\n            margin-bottom: 0.5rem;\n            color: var(--color-burgundy);\n        }\n\n        .form-input, .form-select, .form-textarea {\n            width: 100%;\n            padding: 1rem;\n            background: var(--color-blush-light);\n            border: 1px solid var(--color-sand);\n            border-radius: var(--radius-ornate);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            color: var(--color-text-primary);\n            transition: var(--transition-fast);\n        }\n\n        .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: none;\n            border-color: var(--color-rosegold);\n            background: var(--color-cream);\n        }\n\n        .form-textarea {\n            min-height: 150px;\n            resize: vertical;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1.2rem;\n            background: var(--gradient-wine);\n            color: var(--color-cream);\n            border: none;\n            border-radius: var(--radius-pill);\n            font-family: var(--font-body);\n            font-weight: 700;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .form-submit::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: -100%;\n            width: 100%;\n            height: 100%;\n            background: var(--gradient-shimmer);\n            transition: left 0.5s ease;\n        }\n\n        .form-submit:hover::before {\n            left: 100%;\n        }\n\n        .form-submit:hover {\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-glow);\n        }\n\n        .form-submit span {\n            position: relative;\n            z-index: 1;\n        }\n\n        .contact-info {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: var(--spacing-md);\n            margin-top: var(--spacing-xl);\n        }\n\n        .contact-info-item {\n            text-align: center;\n            padding: var(--spacing-md);\n            background: var(--color-cream);\n            border: 1px solid var(--color-sand);\n            border-radius: var(--radius-ornate);\n        }\n\n        .contact-info-icon {\n            width: 55px;\n            height: 55px;\n            background: var(--gradient-rosegold);\n            border-radius: var(--radius-ornate);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin: 0 auto var(--spacing-sm);\n            font-size: 1.3rem;\n            color: var(--color-cream);\n        }\n\n        .contact-info-label {\n            font-family: var(--font-body);\n            font-size: 0.8rem;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 0.1em;\n            color: var(--color-rosegold-dark);\n            margin-bottom: 0.5rem;\n        }\n\n        .contact-info-value {\n            color: var(--color-burgundy);\n        }\n\n        /* ============================================\n           FOOTER\n           ============================================ */\n        .footer {\n            background: var(--color-velvet);\n            color: var(--color-text-on-dark);\n            padding: var(--spacing-xl) var(--spacing-md) var(--spacing-md);\n            border-top: 1px solid rgba(212, 165, 116, 0.1);\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-top {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: var(--spacing-xl);\n            margin-bottom: var(--spacing-xl);\n        }\n\n        .footer-brand {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: var(--color-rosegold);\n            margin-bottom: var(--spacing-sm);\n        }\n\n        .footer-description {\n            font-size: 0.95rem;\n            color: var(--color-blush-light);\n            max-width: 300px;\n        }\n\n        .footer-heading {\n            font-family: var(--font-display);\n            font-size: 1rem;\n            font-weight: 600;\n            margin-bottom: var(--spacing-sm);\n            color: var(--color-rosegold);\n        }\n\n        .footer-links {\n            list-style: none;\n        }\n\n        .footer-links li {\n            margin-bottom: 0.5rem;\n        }\n\n        .footer-links a {\n            color: var(--color-blush-light);\n            font-size: 0.9rem;\n            transition: var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-rosegold);\n        }\n\n        .footer-bottom {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding-top: var(--spacing-md);\n            border-top: 1px solid rgba(212, 165, 116, 0.1);\n        }\n\n        .footer-copyright {\n            font-size: 0.85rem;\n            color: var(--color-sand);\n        }\n\n        .footer-social {\n            display: flex;\n            gap: var(--spacing-sm);\n        }\n\n        .footer-social a {\n            width: 40px;\n            height: 40px;\n            background: rgba(212, 165, 116, 0.1);\n            border: 1px solid rgba(212, 165, 116, 0.2);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: var(--transition-fast);\n        }\n\n        .footer-social a:hover {\n            background: var(--gradient-rosegold);\n            border-color: transparent;\n        }\n\n        /* ============================================\n           RESPONSIVE DESIGN\n           ============================================ */\n        @media (max-width: 1024px) {\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-cta {\n                justify-content: center;\n            }\n\n            .hero-visual {\n                display: none;\n            }\n\n            .services-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .testimonials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .footer-top {\n                grid-template-columns: 1fr 1fr;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                display: none;\n                position: absolute;\n                top: 100%;\n                left: 0;\n                right: 0;\n                background: rgba(253, 248, 245, 0.98);\n                flex-direction: column;\n                padding: var(--spacing-md);\n                gap: var(--spacing-sm);\n                border-top: 1px solid var(--color-sand);\n            }\n\n            .nav-menu.active {\n                display: flex;\n            }\n\n            .nav-toggle {\n                display: flex;\n            }\n\n            .problem-solution-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .services-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .testimonials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .form-row {\n                grid-template-columns: 1fr;\n            }\n\n            .contact-info {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-top {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-bottom {\n                flex-direction: column;\n                gap: var(--spacing-sm);\n                text-align: center;\n            }\n        }\n\n        /* ============================================\n           ACCESSIBILITY\n           ============================================ */\n        @media (prefers-reduced-motion: reduce) {\n            *, *::before, *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        .btn-focus:focus, .form-input:focus, .form-select:focus, .form-textarea:focus {\n            outline: 2px solid var(--color-rosegold);\n            outline-offset: 2px;\n        }\n\n        /* Skip link */\n        .skip-link {\n            position: absolute;\n            top: -40px;\n            left: 0;\n            background: var(--color-velvet);\n            color: var(--color-cream);\n            padding: 8px 16px;\n            z-index: 9999;\n            transition: top 0.3s;\n        }\n\n        .skip-link:focus {\n            top: 0;\n        }\n    </style>\n</head>\n<body>\n    <a href=\"#main-content\" class=\"skip-link\">Pular para o conteúdo principal</a>\n\n    <!-- Navigation -->\n    <nav class=\"nav\" id=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Bonacci Estética</a>\n            <ul class=\"nav-menu\" id=\"navMenu\">\n                <li><a href=\"#home\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#servicos\" class=\"nav-link\">Serviços</a></li>\n                <li><a href=\"#depoimentos\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#diferenciais\" class=\"nav-link\">Diferenciais</a></li>\n                <li><a href=\"#contato\" class=\"nav-link nav-cta\">Agendar Consulta</a></li>\n            </ul>\n            <button class=\"nav-toggle\" id=\"navToggle\" aria-label=\"Menu\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-decoration hero-arch-1\"></div>\n        <div class=\"hero-decoration hero-arch-2\"></div>\n        <div class=\"hero-ornament\"></div>\n\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge\">\n                    <span class=\"hero-badge-dot\"></span>\n                    Bonacci Estética Avançada\n                </div>\n                <h1 class=\"hero-title\">\n                    Sua Beleza Natural com\n                    <span class=\"hero-title-accent\">Elegância & Sofisticação</span>\n                </h1>\n                <p class=\"hero-description\">\n                    Descubra uma versão mais radiante e confiante de si mesma. Procedimentos estéticos avançados com resultados naturais e personalizados em Ribeirão Preto.\n                </p>\n                <div class=\"hero-cta\">\n                    <a href=\"#contato\" class=\"btn-primary\">\n                        <span>Agendar Consulta</span>\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                    <a href=\"#servicos\" class=\"btn-secondary\">Conhecer Serviços</a>\n                </div>\n            </div>\n\n            <div class=\"hero-visual\">\n                <div class=\"hero-arch-frame\">\n                    <div class=\"hero-arch-inner\">\n                        <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=600&h=750&fit=crop&crop=face\" alt=\"Procedimento estético facial profissional\" class=\"hero-image\">\n                    </div>\n                </div>\n                <div class=\"hero-stat-card hero-stat-1\">\n                    <div class=\"hero-stat-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"hero-stat-content\">\n                        <p class=\"hero-stat-value\">+8 anos</p>\n                        <p class=\"hero-stat-label\">Experiência</p>\n                    </div>\n                </div>\n                <div class=\"hero-stat-card hero-stat-2\">\n                    <div class=\"hero-stat-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"hero-stat-content\">\n                        <p class=\"hero-stat-value\">99%</p>\n                        <p class=\"hero-stat-label\">Satisfação</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\" id=\"problema-solucao\">\n        <div class=\"section-header wow-fade-up\">\n            <p class=\"section-tag\">Sua Jornada de Transformação</p>\n            <h2 class=\"section-title\">O Que Você Busca</h2>\n            <p class=\"section-description\">Entendemos seus anseios e oferecemos soluções personalizadas</p>\n        </div>\n\n        <div class=\"problem-solution-grid\">\n            <div class=\"problem-section\">\n                <p class=\"section-label\">Desafios</p>\n\n                <div class=\"ps-card wow-fade-up\">\n                    <h3 class=\"ps-card-title\">Sinais do Tempo</h3>\n                    <p class=\"ps-card-text\">Rugas finas, linhas de expressão e perda de volume que revelam a passagem dos anos.</p>\n                </div>\n\n                <div class=\"ps-card wow-fade-up\" data-delay=\"100\">\n                    <h3 class=\"ps-card-title\">Desejo de Renovação</h3>\n                    <p class=\"ps-card-text\">Vontade de se sentir mais confiante e radiante, com aparência descansada e revitalizada.</p>\n                </div>\n\n                <div class=\"ps-card wow-fade-up\" data-delay=\"200\">\n                    <h3 class=\"ps-card-title\">Harmonia Facial</h3>\n                    <p class=\"ps-card-text\">Busca por equilíbrio estético que realce sua beleza natural sem artificialidade.</p>\n                </div>\n            </div>\n\n            <div class=\"solution-section\">\n                <p class=\"section-label\">Nossas Soluções</p>\n\n                <div class=\"ps-card wow-fade-up\" data-delay=\"300\">\n                    <h3 class=\"ps-card-title\">Resultados Naturais</h3>\n                    <p class=\"ps-card-text\">Procedimentos que sutlizam e realçam, mantendo sua identidade e expressão únicas.</p>\n                </div>\n\n                <div class=\"ps-card wow-fade-up\" data-delay=\"400\">\n                    <h3 class=\"ps-card-title\">Abordagem Personalizada</h3>\n                    <p class=\"ps-card-text\">Cada tratamento é desenvolvido exclusivamente para suas características e objetivos.</p>\n                </div>\n\n                <div class=\"ps-card wow-fade-up\" data-delay=\"500\">\n                    <h3 class=\"ps-card-title\">Excelência Estética</h3>\n                    <p class=\"ps-card-text\">Técnicas avançadas combinadas com refinamento e atenção aos menores detalhes.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"servicos\">\n        <div class=\"section-header wow-fade-up\">\n            <p class=\"section-tag\">Procedimentos Exclusivos</p>\n            <h2 class=\"section-title\">Nossos Serviços</h2>\n            <p class=\"section-description\">Tratamentos personalizados para realçar sua beleza natural</p>\n        </div>\n\n        <div class=\"services-grid\">\n            <div class=\"service-card wow-fade-up\">\n                <div class=\"service-icon\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                        <path d=\"M8 14s1.5 2 4 2 4-2 4-2\"/>\n                        <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"/>\n                        <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"/>\n                    </svg>\n                </div>\n                <h3 class=\"service-title\">Harmonização Facial</h3>\n                <p class=\"service-description\">Equilibre seus traços faciais com procedimentos minimamente invasivos para resultados naturais e harmônicos.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"100\">\n                <div class=\"service-icon\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M12 2L2 7l10 5 10-5-10-5z\"/>\n                        <path d=\"M2 17l10 5 10-5\"/>\n                        <path d=\"M2 12l10 5 10-5\"/>\n                    </svg>\n                </div>\n                <h3 class=\"service-title\">Toxina Botulínica</h3>\n                <p class=\"service-description\">Suavize linhas de expressão com aplicações precisas para uma aparência descansada e rejuvenescida.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                <div class=\"service-icon\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M12 2v20M2 12h20\"/>\n                    </svg>\n                </div>\n                <h3 class=\"service-title\">Preenchedores Faciais</h3>\n                <p class=\"service-description\">Restaure volume e contorno facial com ácido hialurônico de alta qualidade para resultados duradouros.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"300\">\n                <div class=\"service-icon\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/>\n                    </svg>\n                </div>\n                <h3 class=\"service-title\">Preenchimento Labial</h3>\n                <p class=\"service-description\">Realce seus lábios com preenchimento que mantém a naturalidade e proporção ideal do seu rosto.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n                <div class=\"service-icon\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                        <path d=\"M8 12h8\"/>\n                    </svg>\n                </div>\n                <h3 class=\"service-title\">Bioestimuladores</h3>\n                <p class=\"service-description\">Estimule o colágeno natural para firmeza e rejuvenescimento progressivo da pele.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n\n            <div class=\"service-card wow-fade-up\" data-delay=\"500\">\n                <div class=\"service-icon\">\n                    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/>\n                    </svg>\n                </div>\n                <h3 class=\"service-title\">Protocolos Premium</h3>\n                <p class=\"service-description\">Planos de tratamento exclusivos desenvolvidos especificamente para suas necessidades e objetivos.</p>\n                <a href=\"#contato\" class=\"service-link\">Saiba mais →</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"depoimentos\">\n        <div class=\"section-header wow-fade-up\">\n            <p class=\"section-tag\">Experiências Reais</p>\n            <h2 class=\"section-title\">O Que Dizem Nossas Clientes</h2>\n            <p class=\"section-description\">Histórias de transformação e satisfação</p>\n        </div>\n\n        <div class=\"testimonials-grid\">\n            <div class=\"testimonial-card wow-fade-up\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"A Dra. Bonatti é excepcional! Fiz minha harmonização e o resultado ficou super natural e elegante. Ela tem uma sensibilidade única.\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">RF</div>\n                    <div class=\"testimonial-info\">\n                        <p class=\"testimonial-name\">Renata Ferreira</p>\n                        <p class=\"testimonial-role\">Advogada</p>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"testimonial-card wow-fade-up\" data-delay=\"100\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"Ambiente sofisticado e atendimento impecável. Fiz preenchimento labial e amei o resultado. Recomendo de olhos fechados!\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">CM</div>\n                    <div class=\"testimonial-info\">\n                        <p class=\"testimonial-name\">Carla Mendes</p>\n                        <p class=\"testimonial-role\">Empresária</p>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"testimonial-card wow-fade-up\" data-delay=\"200\">\n                <div class=\"testimonial-stars\">★★★★★</div>\n                <p class=\"testimonial-text\">\"Profissional extraordinária! A Dra. Bonatti entendeu exatamente o que eu queria. O resultado superou todas as minhas expectativas.\"</p>\n                <div class=\"testimonial-author\">\n                    <div class=\"testimonial-avatar\">JO</div>\n                    <div class=\"testimonial-info\">\n                        <p class=\"testimonial-name\">Juliana Oliveira</p>\n                        <p class=\"testimonial-role\">Arquiteta</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\" id=\"diferenciais\">\n        <div class=\"section-header wow-fade-up\">\n            <p class=\"section-tag\">Nossa Essência</p>\n            <h2 class=\"section-title\">Por Que Escolher Bonacci</h2>\n            <p class=\"section-description\">O que nos torna únicos em Ribeirão Preto</p>\n        </div>\n\n        <div class=\"differentials-grid\">\n            <div class=\"differential-item wow-fade-up\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon-bg\"></div>\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/>\n                        </svg>\n                    </div>\n                </div>\n                <h3 class=\"differential-title\">Excelência Reconhecida</h3>\n                <p class=\"differential-description\">Especialista com formação avançada em harmonização facial</p>\n            </div>\n\n            <div class=\"differential-item wow-fade-up\" data-delay=\"100\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon-bg\"></div>\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/>\n                        </svg>\n                    </div>\n                </div>\n                <h3 class=\"differential-title\">Atendimento Sofisticado</h3>\n                <p class=\"differential-description\">Cada paciente recebe um protocolo exclusivo e personalizado</p>\n            </div>\n\n            <div class=\"differential-item wow-fade-up\" data-delay=\"200\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon-bg\"></div>\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"/>\n                            <path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"/>\n                        </svg>\n                    </div>\n                </div>\n                <h3 class=\"differential-title\">Produtos Premium</h3>\n                <p class=\"differential-description\">Utilizamos apenas preenchedores e toxinas de primeira linha</p>\n            </div>\n\n            <div class=\"differential-item wow-fade-up\" data-delay=\"300\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon-bg\"></div>\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            <polyline points=\"12 6 12 12 16 14\"/>\n                        </svg>\n                    </div>\n                </div>\n                <h3 class=\"differential-title\">Pontualidade Elegante</h3>\n                <p class=\"differential-description\">Respeito pelo seu tempo com agendamentos precisos</p>\n            </div>\n\n            <div class=\"differential-item wow-fade-up\" data-delay=\"400\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon-bg\"></div>\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n                        </svg>\n                    </div>\n                </div>\n                <h3 class=\"differential-title\">Segurança Absoluta</h3>\n                <p class=\"differential-description\">Procedimentos realizados com máxima segurança e assepsia</p>\n            </div>\n\n            <div class=\"differential-item wow-fade-up\" data-delay=\"500\">\n                <div class=\"differential-icon-wrapper\">\n                    <div class=\"differential-icon-bg\"></div>\n                    <div class=\"differential-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"/>\n                        </svg>\n                    </div>\n                </div>\n                <h3 class=\"differential-title\">Acompanhamento Completo</h3>\n                <p class=\"differential-description\">Suporte contínuo e dedicado antes e depois dos procedimentos</p>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contato\">\n        <div class=\"section-header wow-fade-up\">\n            <p class=\"section-tag\">Entre em Contato</p>\n            <h2 class=\"section-title\">Agende Sua Consulta</h2>\n            <p class=\"section-description\">Dê o primeiro passo para sua transformação</p>\n        </div>\n\n        <div class=\"contact-container\">\n            <form class=\"contact-form\" id=\"contactForm\">\n                <div class=\"form-row\">\n                    <div class=\"form-group\">\n                        <label for=\"name\" class=\"form-label\">Nome Completo</label>\n                        <input type=\"text\" id=\"name\" name=\"name\" class=\"form-input\" placeholder=\"Seu nome\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"email\" class=\"form-label\">E-mail</label>\n                        <input type=\"email\" id=\"email\" name=\"email\" class=\"form-input\" placeholder=\"seu@email.com\" required>\n                    </div>\n                </div>\n                <div class=\"form-row\">\n                    <div class=\"form-group\">\n                        <label for=\"phone\" class=\"form-label\">Telefone</label>\n                        <input type=\"tel\" id=\"phone\" name=\"phone\" class=\"form-input\" placeholder=\"(16) 99999-9999\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"service\" class=\"form-label\">Serviço de Interesse</label>\n                        <select id=\"service\" name=\"service\" class=\"form-select\" required>\n                            <option value=\"\">Selecione</option>\n                            <option value=\"harmonizacao\">Harmonização Facial</option>\n                            <option value=\"botulina\">Toxina Botulínica</option>\n                            <option value=\"preenchedores\">Preenchedores Faciais</option>\n                            <option value=\"labial\">Preenchimento Labial</option>\n                            <option value=\"bioestimuladores\">Bioestimuladores</option>\n                            <option value=\"protocolos\">Protocolos Premium</option>\n                        </select>\n                    </div>\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"message\" class=\"form-label\">Mensagem</label>\n                    <textarea id=\"message\" name=\"message\" class=\"form-textarea\" placeholder=\"Conte-nos sobre suas expectativas...\"></textarea>\n                </div>\n                <button type=\"submit\" class=\"form-submit\"><span>Enviar via WhatsApp</span></button>\n            </form>\n\n            <div class=\"contact-info\">\n                <div class=\"contact-info-item\">\n                    <div class=\"contact-info-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/>\n                            <circle cx=\"12\" cy=\"10\" r=\"3\"/>\n                        </svg>\n                    </div>\n                    <p class=\"contact-info-label\">Endereço</p>\n                    <p class=\"contact-info-value\">Rua Milton José Robusti, 75 - Sala 1610<br>Jardim Botânico, Ribeirão Preto - SP<br>CEP: 14021-613</p>\n                </div>\n                <div class=\"contact-info-item\">\n                    <div class=\"contact-info-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"/>\n                        </svg>\n                    </div>\n                    <p class=\"contact-info-label\">Telefone</p>\n                    <p class=\"contact-info-value\">(16) 99630-9696</p>\n                </div>\n                <div class=\"contact-info-item\">\n                    <div class=\"contact-info-icon\">\n                        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/>\n                            <path d=\"M10 8h4\"/><path d=\"M10 12h4\"/><path d=\"M10 16h4\"/>\n                        </svg>\n                    </div>\n                    <p class=\"contact-info-label\">Horário</p>\n                    <p class=\"contact-info-value\">Segunda a Sexta<br>9h às 18h</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-top\">\n                <div>\n                    <p class=\"footer-brand\">Bonacci Estética Avançada</p>\n                    <p class=\"footer-description\">Harmonização facial e estética avançada com resultados naturais e elegantes em Ribeirão Preto.</p>\n                </div>\n                <div>\n                    <p class=\"footer-heading\">Links Rápidos</p>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#home\">Início</a></li>\n                        <li><a href=\"#servicos\">Serviços</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                        <li><a href=\"#contato\">Contato</a></li>\n                    </ul>\n                </div>\n                <div>\n                    <p class=\"footer-heading\">Serviços</p>\n                    <ul class=\"footer-links\">\n                        <li><a href=\"#servicos\">Harmonização Facial</a></li>\n                        <li><a href=\"#servicos\">Toxina Botulínica</a></li>\n                        <li><a href=\"#servicos\">Preenchedores</a></li>\n                        <li><a href=\"#servicos\">Bioestimuladores</a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"footer-bottom\">\n                <p class=\"footer-copyright\">© 2026 Bonacci Estética Avançada. Todos os direitos reservados.</p>\n                <div class=\"footer-social\">\n                    <a href=\"#\" aria-label=\"Instagram\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\" ry=\"5\"/>\n                            <path d=\"M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z\"/>\n                            <line x1=\"17.5\" y1=\"6.5\" x2=\"17.51\" y2=\"6.5\"/>\n                        </svg>\n                    </a>\n                    <a href=\"#\" aria-label=\"WhatsApp\">\n                        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"/>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION\n        // ============================================\n        const nav = document.getElementById('nav');\n        const navToggle = document.getElementById('navToggle');\n        const navMenu = document.getElementById('navMenu');\n        let lastScrollY = window.scrollY;\n\n        window.addEventListener('scroll', () => {\n            if (window.scrollY > lastScrollY && window.scrollY > 100) {\n                nav.classList.add('hidden');\n            } else {\n                nav.classList.remove('hidden');\n            }\n            lastScrollY = window.scrollY;\n\n            // Add shadow on scroll\n            if (window.scrollY > 50) {\n                nav.classList.add('scrolled');\n            } else {\n                nav.classList.remove('scrolled');\n            }\n        });\n\n        navToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function (e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER (WOW ANIMATIONS)\n        // ============================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || 0;\n                    setTimeout(() => {\n                        entry.target.classList.add('visible');\n                    }, delay);\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // CONTACT FORM (WHATSAPP)\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n        contactForm.addEventListener('submit', function(e) {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const email = document.getElementById('email').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service').value;\n            const message = document.getElementById('message').value;\n\n            const serviceNames = {\n                'harmonizacao': 'Harmonização Facial',\n                'botulina': 'Toxina Botulínica',\n                'preenchedores': 'Preenchedores Faciais',\n                'labial': 'Preenchimento Labial',\n                'bioestimuladores': 'Bioestimuladores',\n                'protocolos': 'Protocolos Premium'\n            };\n\n            const whatsappMessage = `Olá! Meu nome é ${name}.\\n\\nEmail: ${email}\\nTelefone: ${phone}\\nServiço de interesse: ${serviceNames[service] || service}\\n\\nMensagem: ${message || 'Gostaria de agendar uma consulta.'}`;\n\n            const whatsappUrl = `https://wa.me/5516996309696?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappUrl, '_blank');\n        });\n\n        // ============================================\n        // HERO PARALLAX\n        // ============================================\n        const hero = document.querySelector('.hero');\n        const decorations = document.querySelectorAll('.hero-decoration');\n        const ornament = document.querySelector('.hero-ornament');\n\n        if (window.innerWidth > 768) {\n            hero.addEventListener('mousemove', (e) => {\n                const { clientX, clientY } = e;\n                const { innerWidth, innerHeight } = window;\n\n                const xPercent = (clientX / innerWidth - 0.5) * 2;\n                const yPercent = (clientY / innerHeight - 0.5) * 2;\n\n                decorations.forEach((deco, index) => {\n                    const speed = (index + 1) * 15;\n                    const x = xPercent * speed;\n                    const y = yPercent * speed;\n                    deco.style.transform = `translate(${x}px, ${y}px)`;\n                });\n\n                if (ornament) {\n                    const rotateSpeed = 10;\n                    ornament.style.transform = `rotate(${xPercent * rotateSpeed}deg) translateY(${yPercent * 5}px)`;\n                }\n            });\n        }\n\n        // ============================================\n        // PREFERRED REDUCED MOTION\n        // ============================================\n        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n        if (prefersReducedMotion.matches) {\n            document.querySelectorAll('.hero-decoration, .hero-ornament').forEach(el => {\n                el.style.animation = 'none';\n            });\n        }\n    </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null}}
