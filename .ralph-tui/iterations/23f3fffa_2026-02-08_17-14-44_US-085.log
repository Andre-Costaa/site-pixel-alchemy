ctForm\">\n                            <div class=\"form-group\">\n                                <label for=\"name\">Nome Completo</label>\n                                <input type=\"text\" id=\"name\" name=\"name\" required placeholder=\"Seu nome\">\n                            </div>\n\n                            <div class=\"form-group\">\n                                <label for=\"phone\">Telefone / WhatsApp</label>\n                                <input type=\"tel\" id=\"phone\" name=\"phone\" required placeholder=\"(00) 00000-0000\">\n                            </div>\n\n                            <div class=\"form-group\">\n                                <label for=\"service\">Tratamento de Interesse</label>\n                                <select id=\"service\" name=\"service\" required>\n                                    <option value=\"\">Selecione uma opção</option>\n                                    <option value=\"harmonizacao-orofacial\">Harmonização Orofacial</option>\n                                    <option value=\"toxina-botulinica\">Toxina Botulínica</option>\n                                    <option value=\"preenchedores-faciais\">Preenchedores Faciais</option>\n                                    <option value=\"preenchimento-labial\">Preenchimento Labial</option>\n                                    <option value=\"bioestimuladores\">Bioestimuladores</option>\n                                    <option value=\"protocolo-personalizado\">Protocolo Personalizado</option>\n                                    <option value=\"outro\">Outro</option>\n                                </select>\n                            </div>\n\n                            <div class=\"form-group\">\n                                <label for=\"message\">Mensagem</label>\n                                <textarea id=\"message\" name=\"message\" required placeholder=\"Conte-nos sobre suas necessidades...\"></textarea>\n                            </div>\n\n                            <button type=\"submit\" class=\"btn btn-primary\">\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg>\n                                Enviar pelo WhatsApp\n                            </button>\n                        </form>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-brand\">\n                    <h3>Dra. Zulene Ferreira</h3>\n                    <p>Harmonização Orofacial em Ribeirão Preto</p>\n                    <p>Transformando vidas através da estética avançada com resultados naturais e elegantes.</p>\n                </div>\n\n                <div class=\"footer-links\">\n                    <h4>Links Rápidos</h4>\n                    <ul>\n                        <li><a href=\"#home\">Início</a></li>\n                        <li><a href=\"#sobre\">Sobre</a></li>\n                        <li><a href=\"#servicos\">Serviços</a></li>\n                        <li><a href=\"#depoimentos\">Depoimentos</a></li>\n                        <li><a href=\"#contato\">Contato</a></li>\n                    </ul>\n                </div>\n\n                <div class=\"footer-links\">\n                    <h4>Tratamentos</h4>\n                    <ul>\n                        <li><a href=\"#servicos\">Harmonização Orofacial</a></li>\n                        <li><a href=\"#servicos\">Toxina Botulínica</a></li>\n                        <li><a href=\"#servicos\">Preenchedores Faciais</a></li>\n                        <li><a href=\"#servicos\">Preenchimento Labial</a></li>\n                    </ul>\n                </div>\n\n                <div class=\"footer-links\">\n                    <h4>Contato</h4>\n                    <ul>\n                        <li><a href=\"tel:+5516997356029\">(16) 99735-6029</a></li>\n                        <li><a href=\"#contato\">R. Chile, 1711 - Sala 504</a></li>\n                        <li><a href=\"#contato\">Jardim Irajá, Ribeirão Preto - SP</a></li>\n                    </ul>\n                </div>\n            </div>\n\n            <div class=\"footer-bottom\">\n                <p>&copy; 2024 Dra. Zulene Ferreira - Harmonização Orofacial. Todos os direitos reservados.</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ============================================\n        // NAVIGATION SCROLL EFFECT\n        // ============================================\n        const nav = document.getElementById('nav');\n        let lastScroll = 0;\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                nav.classList.add('scrolled');\n            } else {\n                nav.classList.remove('scrolled');\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // ============================================\n        // MOBILE MENU TOGGLE\n        // ============================================\n        const navToggle = document.getElementById('navToggle');\n        const navLinks = document.getElementById('navLinks');\n\n        navToggle.addEventListener('click', () => {\n            navLinks.classList.toggle('active');\n        });\n\n        // Close menu when clicking on a link\n        navLinks.querySelectorAll('a').forEach(link => {\n            link.addEventListener('click', () => {\n                navLinks.classList.remove('active');\n            });\n        });\n\n        // ============================================\n        // SMOOTH SCROLL\n        // ============================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function (e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ============================================\n        // INTERSECTION OBSERVER FOR ANIMATIONS\n        // ============================================\n        const observerOptions = {\n            root: null,\n            rootMargin: '0px',\n            threshold: 0.1\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    const delay = entry.target.dataset.delay || 0;\n                    setTimeout(() => {\n                        entry.target.classList.add('visible');\n                    }, delay);\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        // Observe all animated elements\n        document.querySelectorAll('.wow-fade-up, .wow-fade-in, .wow-scale-up').forEach(el => {\n            observer.observe(el);\n        });\n\n        // ============================================\n        // CONTACT FORM - WHATSAPP INTEGRATION\n        // ============================================\n        const contactForm = document.getElementById('contactForm');\n        const whatsappNumber = '5516997356029';\n\n        contactForm.addEventListener('submit', (e) => {\n            e.preventDefault();\n\n            const name = document.getElementById('name').value;\n            const phone = document.getElementById('phone').value;\n            const service = document.getElementById('service');\n            const serviceText = service.options[service.selectedIndex].text;\n            const message = document.getElementById('message').value;\n\n            const whatsappMessage = `Olá, me chamo ${name}!\\n\\nTelefone: ${phone}\\nInteresse: ${serviceText}\\n\\nMensagem: ${message}`;\n\n            const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappUrl, '_blank');\n        });\n\n        // ============================================\n        // PARALLAX EFFECT FOR HERO BLOBS\n        // ============================================\n        let ticking = false;\n\n        window.addEventListener('mousemove', (e) => {\n            if (!ticking) {\n                window.requestAnimationFrame(() => {\n                    const blobs = document.querySelectorAll('.hero-blob');\n                    const mouseX = e.clientX / window.innerWidth;\n                    const mouseY = e.clientY / window.innerHeight;\n\n                    blobs.forEach((blob, index) => {\n                        const speed = (index + 1) * 20;\n                        const x = (mouseX - 0.5) * speed;\n                        const y = (mouseY - 0.5) * speed;\n                        blob.style.transform = `translate(${x}px, ${y}px)`;\n                    });\n\n                    ticking = false;\n                });\n\n                ticking = true;\n            }\n        });\n\n        // ============================================\n        // ACCESSIBILITY - REDUCED MOTION\n        // ============================================\n        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n        if (prefersReducedMotion.matches) {\n            // Disable parallax\n            window.removeEventListener('mousemove', () => {});\n\n            // Show all elements immediately\n            document.querySelectorAll('.wow-fade-up, .wow-fade-in, .wow-scale-up').forEach(el => {\n                el.classList.add('visible');\n            });\n        }\n\n        // ============================================\n        // PREFERS-REDUCED-MOTION LISTENER\n        // ============================================\n        prefersReducedMotion.addEventListener('change', () => {\n            if (prefersReducedMotion.matches) {\n                document.querySelectorAll('.wow-fade-up, .wow-fade-in, .wow-scale-up').forEach(el => {\n                    el.classList.add('visible');\n                });\n            }\n        });\n    </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null}}
