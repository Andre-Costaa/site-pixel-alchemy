          --color-pearl-dark: #E8E4DD;\n            --color-ivory: #FFFEFA;\n            --color-mint: #D4E5DC;\n            --color-seafoam: #C5DDD1;\n            --color-charcoal: #2A2A2A;\n            --color-charcoal-light: #4A4A4A;\n            --color-golden: #C4A77D;\n            --color-golden-light: #D8BE9A;\n            --color-coral: #E8B4A8;\n\n            /* Gradients */\n            --gradient-serene: linear-gradient(135deg, #F8F6F3 0%, #D4E5DC 50%, #FFFEFA 100%);\n            --gradient-fresh: linear-gradient(135deg, #9CBFA8 0%, #C5DDD1 100%);\n            --gradient-pearl: linear-gradient(135deg, #B8D4C2 0%, #C4A77D 100%);\n            --gradient-warm: linear-gradient(135deg, #E8B4A8 0%, #C4A77D 100%);\n\n            /* Typography */\n            --font-display: 'Playfair Display', Georgia, serif;\n            --font-body: 'Inter', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n            --spacing-xxl: 8rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 16px;\n            --radius-lg: 24px;\n            --radius-pill: 100px;\n            --radius-organic: 60% 40% 30% 70% / 60% 30% 70% 40%;\n            --radius-organic-2: 40% 60% 70% 30% / 40% 70% 30% 60%;\n\n            /* Shadows */\n            --shadow-soft: 0 8px 32px rgba(156, 191, 168, 0.15);\n            --shadow-glow: 0 8px 48px rgba(196, 167, 125, 0.2);\n            --shadow-elegant: 0 16px 64px rgba(42, 42, 42, 0.08);\n            --shadow-floating: 0 20px 60px rgba(156, 191, 168, 0.2);\n\n            /* Transitions */\n            --transition-fast: 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-base: 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-slow: 0.8s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n\n        /* ========================================\n           RESET & BASE STYLES\n        ======================================== */\n        *, *::before, *::after {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        html {\n            scroll-behavior: smooth;\n            font-size: 16px;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background: var(--color-ivory);\n            color: var(--color-charcoal);\n            line-height: 1.7;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        img {\n            max-width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-fast);\n        }\n\n        ul {\n            list-style: none;\n        }\n\n        /* ========================================\n           TYPOGRAPHY\n        ======================================== */\n        h1, h2, h3, h4 {\n            font-family: var(--font-display);\n            font-weight: 500;\n            line-height: 1.2;\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 8vw, 5rem);\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 5vw, 3.5rem);\n            letter-spacing: -0.01em;\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 3vw, 2rem);\n        }\n\n        .text-sage { color: var(--color-sage-dark); }\n        .text-golden { color: var(--color-golden); }\n        .text-coral { color: var(--color-coral); }\n\n        /* ========================================\n           NAVIGATION\n        ======================================== */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            background: rgba(255, 254, 250, 0.95);\n            backdrop-filter: blur(20px);\n            z-index: 1000;\n            transition: transform var(--transition-base);\n            box-shadow: 0 1px 0 rgba(156, 191, 168, 0.1);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 1rem 2rem;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            color: var(--color-charcoal);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: 2rem;\n            align-items: center;\n        }\n\n        .nav-link {\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-charcoal-light);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-sage-dark);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }","numLines":200,"startLine":1,"totalLines":1656}}}
