c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\"/>\n                        </svg>\n                    </a>\n                    <a href=\"https://instagram.com\" aria-label=\"Instagram\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                            <path d=\"M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z\"/>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ========================================\n        // NAVIGATION SCROLL EFFECT\n        // ========================================\n        let lastScroll = 0;\n        const nav = document.querySelector('.nav');\n        const mobileToggle = document.querySelector('.mobile-toggle');\n        const navMenu = document.querySelector('.nav-menu');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                } else {\n                    nav.classList.remove('hidden');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Mobile menu toggle\n        mobileToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close mobile menu on link click\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ========================================\n        // SMOOTH SCROLL\n        // ========================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ========================================\n        // INTERSECTION OBSERVER ANIMATIONS\n        // ========================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('visible');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up').forEach(el => {\n            el.style.setProperty('--delay', el.dataset.delay || 0);\n            observer.observe(el);\n        });\n\n        // ========================================\n        // CONTACT FORM - WHATSAPP INTEGRATION\n        // ========================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', function(e) {\n            e.preventDefault();\n\n            const formData = new FormData(contactForm);\n            const name = formData.get('name');\n            const phone = formData.get('phone');\n            const service = formData.get('service');\n            const message = formData.get('message');\n\n            const whatsappMessage = `Olá! Meu nome é ${name}.\\n\\nTelefone: ${phone}\\nTratamento de interesse: ${service}\\n\\nMensagem: ${message || 'Gostaria de agendar uma avaliação.'}`;\n\n            const whatsappUrl = `https://wa.me/5516994563928?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappUrl, '_blank');\n\n            contactForm.reset();\n        });\n\n        // ========================================\n        // PARALLAX MOUSE MOVEMENT ON BLOBS\n        // ========================================\n        const blobs = document.querySelectorAll('.blob');\n\n        document.addEventListener('mousemove', (e) => {\n            const x = (e.clientX / window.innerWidth - 0.5) * 20;\n            const y = (e.clientY / window.innerHeight - 0.5) * 20;\n\n            blobs.forEach((blob, index) => {\n                const factor = (index + 1) * 0.5;\n                blob.style.transform = `translate(${x * factor}px, ${y * factor}px)`;\n            });\n        });\n\n        // ========================================\n        // REDUCED MOTION SUPPORT\n        // ========================================\n        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n            document.querySelectorAll('.wow-fade-up').forEach(el => {\n                el.classList.add('visible');\n            });\n        }\n    </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"c94784a0-fc53-463d-a5cd-1f04e89a1935","uuid":"c7c2d493-fc82-4ff9-8f8a-53e6daceb273"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ebc955fa668d4653b295c93a","type":"tool_result","content":"File created successfully at: /home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-amanda-gaipo/index.html"}]},"parent_tool_use_id":null,"session_id":"c94784a0-fc53-463d-a5cd-1f04e89a1935","uuid":"c17616cf-7543-40dc-b740-a4d98232e6f1","tool_use_result":{"type":"create","filePath":"/home/ac/Projetos/site-pixel-alchemy/site-pixel-alchemy/site-demo/dra-amanda-gaipo/index.html","content":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Dra. Amanda Gaipo | Harmonização Facial em Ribeirão Preto</title>\n    <meta name=\"description\" content=\"Dra. Amanda Gaipo - Especialista em harmonização facial e estética avançada em Ribeirão Preto. Transforme sua beleza natural com tratamentos personalizados. Agende: (16) 99456-3928\">\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Lato:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        /* ========================================\n           CSS VARIABLES & ROOT STYLES\n        ======================================== */\n        :root {\n            /* Colors - Twilight Lavender & Mocha Palette */\n            --color-lavender: #B8A5C4;\n            --color-lavender-light: #D4C5E0;\n            --color-lavender-dark: #9A84A8;\n            --color-lavender-pale: #EBE5F0;\n            --color-mocha: #C4B5A8;\n            --color-mocha-dark: #A89484;\n            --color-mocha-light: #D9CFC6;\n            --color-champagne: #F5EDE3;\n            --color-cream: #FFFEFA;\n            --color-cream-dark: #F0EDE8;\n            --color-charcoal: #2A2A2A;\n            --color-charcoal-light: #4A4A4A;\n            --color-rose-gold: #C9A86C;\n            --color-rose-gold-light: #D9BE9A;\n\n            /* Gradients */\n            --gradient-twilight: linear-gradient(135deg, #EBE5F0 0%, #F5EDE3 50%, #FFFEFA 100%);\n            --gradient-lavender: linear-gradient(135deg, #B8A5C4 0%, #D4C5E0 100%);\n            --gradient-mocha: linear-gradient(135deg, #C4B5A8 0%, #D9CFC6 100%);\n            --gradient-warm: linear-gradient(135deg, #C9A86C 0%, #D9BE9A 100%);\n            --gradient-fade: linear-gradient(180deg, rgba(235,229,240,0) 0%, rgba(235,229,240,1) 100%);\n\n            /* Typography */\n            --font-display: 'Cormorant Garamond', Georgia, serif;\n            --font-body: 'Lato', -apple-system, sans-serif;\n\n            /* Spacing */\n            --spacing-xs: 0.5rem;\n            --spacing-sm: 1rem;\n            --spacing-md: 2rem;\n            --spacing-lg: 4rem;\n            --spacing-xl: 6rem;\n            --spacing-xxl: 8rem;\n\n            /* Border Radius */\n            --radius-sm: 8px;\n            --radius-md: 16px;\n            --radius-lg: 24px;\n            --radius-pill: 100px;\n            --radius-organic: 60% 40% 30% 70% / 60% 30% 70% 40%;\n            --radius-organic-2: 40% 60% 70% 30% / 40% 70% 30% 60%;\n            --radius-organic-3: 50% 50% 40% 60% / 50% 40% 60% 50%;\n\n            /* Shadows */\n            --shadow-soft: 0 8px 32px rgba(184, 165, 196, 0.15);\n            --shadow-glow: 0 8px 48px rgba(201, 168, 108, 0.2);\n            --shadow-elegant: 0 16px 64px rgba(42, 42, 42, 0.08);\n            --shadow-floating: 0 20px 60px rgba(184, 165, 196, 0.2);\n\n            /* Transitions */\n            --transition-fast: 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-base: 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n            --transition-slow: 0.8s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n\n        /* ========================================\n           RESET & BASE STYLES\n        ======================================== */\n        *, *::before, *::after {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        html {\n            scroll-behavior: smooth;\n            font-size: 16px;\n        }\n\n        body {\n            font-family: var(--font-body);\n            background: var(--color-cream);\n            color: var(--color-charcoal);\n            line-height: 1.7;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n\n        img {\n            max-width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n            transition: var(--transition-fast);\n        }\n\n        ul {\n            list-style: none;\n        }\n\n        /* ========================================\n           TYPOGRAPHY\n        ======================================== */\n        h1, h2, h3, h4 {\n            font-family: var(--font-display);\n            font-weight: 500;\n            line-height: 1.2;\n        }\n\n        h1 {\n            font-size: clamp(2.5rem, 8vw, 5rem);\n            letter-spacing: -0.02em;\n        }\n\n        h2 {\n            font-size: clamp(2rem, 5vw, 3.5rem);\n            letter-spacing: -0.01em;\n        }\n\n        h3 {\n            font-size: clamp(1.5rem, 3vw, 2rem);\n        }\n\n        .text-lavender { color: var(--color-lavender-dark); }\n        .text-mocha { color: var(--color-mocha-dark); }\n        .text-gold { color: var(--color-rose-gold); }\n\n        /* ========================================\n           NAVIGATION\n        ======================================== */\n        .nav {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            background: rgba(255, 254, 250, 0.95);\n            backdrop-filter: blur(20px);\n            z-index: 1000;\n            transition: transform var(--transition-base);\n            box-shadow: 0 1px 0 rgba(184, 165, 196, 0.1);\n        }\n\n        .nav.hidden {\n            transform: translateY(-100%);\n        }\n\n        .nav-container {\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 1rem 2rem;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .nav-logo {\n            font-family: var(--font-display);\n            font-size: 1.5rem;\n            font-weight: 600;\n            color: var(--color-charcoal);\n        }\n\n        .nav-menu {\n            display: flex;\n            gap: 2rem;\n            align-items: center;\n        }\n\n        .nav-link {\n            font-size: 0.9rem;\n            font-weight: 500;\n            color: var(--color-charcoal-light);\n            position: relative;\n        }\n\n        .nav-link::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            left: 0;\n            width: 0;\n            height: 2px;\n            background: var(--color-lavender-dark);\n            transition: width var(--transition-fast);\n        }\n\n        .nav-link:hover::after {\n            width: 100%;\n        }\n\n        .nav-cta {\n            padding: 0.75rem 1.5rem;\n            background: var(--color-lavender);\n            color: white;\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            font-size: 0.9rem;\n            transition: all var(--transition-fast);\n        }\n\n        .nav-cta:hover {\n            background: var(--color-lavender-dark);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .mobile-toggle {\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            cursor: pointer;\n            padding: 5px;\n        }\n\n        .mobile-toggle span {\n            width: 25px;\n            height: 2px;\n            background: var(--color-charcoal);\n            transition: var(--transition-fast);\n        }\n\n        /* ========================================\n           HERO SECTION\n        ======================================== */\n        .hero {\n            position: relative;\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            overflow: hidden;\n            background: var(--gradient-twilight);\n        }\n\n        .hero-blobs {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            overflow: hidden;\n            z-index: 1;\n        }\n\n        .blob {\n            position: absolute;\n            border-radius: var(--radius-organic);\n            filter: blur(60px);\n            opacity: 0.6;\n            animation: blob-float 20s ease-in-out infinite;\n        }\n\n        .blob-1 {\n            width: 500px;\n            height: 500px;\n            background: var(--gradient-lavender);\n            top: -10%;\n            right: -5%;\n            animation-delay: 0s;\n        }\n\n        .blob-2 {\n            width: 400px;\n            height: 400px;\n            background: var(--gradient-mocha);\n            bottom: -5%;\n            left: -10%;\n            animation-delay: -5s;\n            border-radius: var(--radius-organic-2);\n        }\n\n        .blob-3 {\n            width: 350px;\n            height: 350px;\n            background: var(--gradient-warm);\n            top: 40%;\n            left: 30%;\n            animation-delay: -10s;\n            opacity: 0.4;\n            border-radius: var(--radius-organic-3);\n        }\n\n        .blob-4 {\n            width: 300px;\n            height: 300px;\n            background: linear-gradient(135deg, #D4C5E0 0%, #F5EDE3 100%);\n            bottom: 20%;\n            right: 20%;\n            animation-delay: -15s;\n            opacity: 0.3;\n            border-radius: var(--radius-organic);\n        }\n\n        @keyframes blob-float {\n            0%, 100% {\n                transform: translate(0, 0) scale(1) rotate(0deg);\n            }\n            25% {\n                transform: translate(30px, -30px) scale(1.05) rotate(5deg);\n            }\n            50% {\n                transform: translate(-20px, 20px) scale(0.95) rotate(-5deg);\n            }\n            75% {\n                transform: translate(-30px, -20px) scale(1.02) rotate(3deg);\n            }\n        }\n\n        .hero-container {\n            position: relative;\n            z-index: 10;\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 6rem 2rem 4rem;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            align-items: center;\n        }\n\n        .hero-content {\n            animation: fade-up 1s ease-out;\n        }\n\n        .hero-badge {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 0.5rem 1rem;\n            background: rgba(184, 165, 196, 0.2);\n            border-radius: var(--radius-pill);\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-lavender-dark);\n            margin-bottom: 1.5rem;\n            animation: fade-up 1s ease-out 0.2s both;\n        }\n\n        .hero-badge svg {\n            width: 16px;\n            height: 16px;\n        }\n\n        .hero-title {\n            color: var(--color-charcoal);\n            margin-bottom: 1.5rem;\n            animation: fade-up 1s ease-out 0.4s both;\n        }\n\n        .hero-title span {\n            color: var(--color-lavender-dark);\n        }\n\n        .hero-description {\n            font-size: 1.15rem;\n            color: var(--color-charcoal-light);\n            margin-bottom: 2.5rem;\n            max-width: 500px;\n            animation: fade-up 1s ease-out 0.6s both;\n        }\n\n        .hero-ctas {\n            display: flex;\n            gap: 1rem;\n            flex-wrap: wrap;\n            animation: fade-up 1s ease-out 0.8s both;\n        }\n\n        .btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            padding: 1rem 2rem;\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: all var(--transition-fast);\n            border: none;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .btn-primary {\n            background: var(--color-lavender);\n            color: white;\n            box-shadow: var(--shadow-soft);\n        }\n\n        .btn-primary:hover {\n            background: var(--color-lavender-dark);\n            transform: translateY(-3px);\n            box-shadow: var(--shadow-floating);\n        }\n\n        .btn-secondary {\n            background: transparent;\n            color: var(--color-charcoal);\n            border: 2px solid var(--color-mocha);\n        }\n\n        .btn-secondary:hover {\n            background: var(--color-mocha);\n            color: white;\n            transform: translateY(-3px);\n        }\n\n        .btn svg {\n            width: 18px;\n            height: 18px;\n        }\n\n        .hero-image {\n            position: relative;\n            animation: fade-up 1s ease-out 0.4s both;\n        }\n\n        .hero-image-wrapper {\n            position: relative;\n            border-radius: var(--radius-lg);\n            overflow: hidden;\n            box-shadow: var(--shadow-elegant);\n        }\n\n        .hero-image-wrapper::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            background: var(--gradient-lavender);\n            opacity: 0.1;\n            z-index: 1;\n        }\n\n        .hero-image img {\n            width: 100%;\n            height: auto;\n            display: block;\n        }\n\n        .hero-floating-card {\n            position: absolute;\n            background: white;\n            padding: 1rem 1.5rem;\n            border-radius: var(--radius-md);\n            box-shadow: var(--shadow-floating);\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n            z-index: 10;\n            animation: card-float 6s ease-in-out infinite;\n        }\n\n        .hero-floating-card.card-1 {\n            top: 10%;\n            left: -20px;\n        }\n\n        .hero-floating-card.card-2 {\n            bottom: 15%;\n            right: -20px;\n            animation-delay: -3s;\n        }\n\n        .card-icon {\n            width: 40px;\n            height: 40px;\n            background: var(--gradient-lavender);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n        }\n\n        .card-icon svg {\n            width: 20px;\n            height: 20px;\n            color: white;\n        }\n\n        .card-text {\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-charcoal);\n        }\n\n        .card-text small {\n            display: block;\n            font-weight: 400;\n            color: var(--color-charcoal-light);\n            font-size: 0.75rem;\n        }\n\n        @keyframes card-float {\n            0%, 100% {\n                transform: translateY(0);\n            }\n            50% {\n                transform: translateY(-15px);\n            }\n        }\n\n        @keyframes fade-up {\n            from {\n                opacity: 0;\n                transform: translateY(30px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        /* ========================================\n           SECTIONS BASE\n        ======================================== */\n        .section {\n            padding: var(--spacing-xl) 2rem;\n            position: relative;\n        }\n\n        .section-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .section-header {\n            text-align: center;\n            margin-bottom: var(--spacing-lg);\n        }\n\n        .section-tag {\n            display: inline-block;\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--color-lavender-dark);\n            text-transform: uppercase;\n            letter-spacing: 0.1em;\n            margin-bottom: 1rem;\n        }\n\n        .section-title {\n            color: var(--color-charcoal);\n            margin-bottom: 1rem;\n        }\n\n        .section-description {\n            font-size: 1.1rem;\n            color: var(--color-charcoal-light);\n            max-width: 600px;\n            margin: 0 auto;\n        }\n\n        /* ========================================\n           PROBLEM/SOLUTION SECTION\n        ======================================== */\n        .problem-solution {\n            background: var(--color-cream);\n        }\n\n        .problem-solution-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 3rem;\n            margin-top: var(--spacing-lg);\n        }\n\n        .problem-card, .solution-card {\n            background: white;\n            padding: 2.5rem;\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-soft);\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n        }\n\n        .problem-card::before, .solution-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 4px;\n        }\n\n        .problem-card::before {\n            background: linear-gradient(90deg, var(--color-mocha-dark), var(--color-mocha));\n        }\n\n        .solution-card::before {\n            background: linear-gradient(90deg, var(--color-lavender-dark), var(--color-lavender));\n        }\n\n        .problem-card:hover, .solution-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-floating);\n        }\n\n        .card-icon-header {\n            width: 60px;\n            height: 60px;\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n        }\n\n        .problem-card .card-icon-header {\n            background: rgba(196, 181, 168, 0.2);\n        }\n\n        .solution-card .card-icon-header {\n            background: rgba(184, 165, 196, 0.2);\n        }\n\n        .card-icon-header svg {\n            width: 30px;\n            height: 30px;\n        }\n\n        .problem-card .card-icon-header svg {\n            color: var(--color-mocha-dark);\n        }\n\n        .solution-card .card-icon-header svg {\n            color: var(--color-lavender-dark);\n        }\n\n        .problem-card h3, .solution-card h3 {\n            margin-bottom: 1rem;\n            color: var(--color-charcoal);\n        }\n\n        .problem-card p, .solution-card p {\n            color: var(--color-charcoal-light);\n            line-height: 1.8;\n        }\n\n        .problem-list {\n            margin-top: 1.5rem;\n        }\n\n        .problem-list li {\n            display: flex;\n            align-items: flex-start;\n            gap: 0.75rem;\n            padding: 0.75rem 0;\n            border-bottom: 1px solid var(--color-cream-dark);\n            font-size: 0.95rem;\n            color: var(--color-charcoal-light);\n        }\n\n        .problem-list li:last-child {\n            border-bottom: none;\n        }\n\n        .problem-list svg {\n            width: 18px;\n            height: 18px;\n            flex-shrink: 0;\n            margin-top: 2px;\n        }\n\n        .problem-card .problem-list svg {\n            color: var(--color-mocha-dark);\n        }\n\n        .solution-card .problem-list svg {\n            color: var(--color-lavender-dark);\n        }\n\n        /* ========================================\n           SERVICES SECTION\n        ======================================== */\n        .services {\n            background: var(--gradient-fade);\n        }\n\n        .services-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n            margin-top: var(--spacing-lg);\n        }\n\n        .service-card {\n            background: white;\n            border-radius: var(--radius-lg);\n            padding: 2rem;\n            box-shadow: var(--shadow-soft);\n            transition: all var(--transition-base);\n            position: relative;\n            overflow: hidden;\n            cursor: pointer;\n        }\n\n        .service-card::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background: var(--gradient-lavender);\n            opacity: 0;\n            transition: opacity var(--transition-base);\n            z-index: 0;\n        }\n\n        .service-card:hover::before {\n            opacity: 0.05;\n        }\n\n        .service-card:hover {\n            transform: translateY(-8px);\n            box-shadow: var(--shadow-floating);\n        }\n\n        .service-icon {\n            width: 60px;\n            height: 60px;\n            background: var(--gradient-lavender);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-bottom: 1.5rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .service-icon svg {\n            width: 28px;\n            height: 28px;\n            color: white;\n        }\n\n        .service-card h3 {\n            margin-bottom: 0.75rem;\n            color: var(--color-charcoal);\n            position: relative;\n            z-index: 1;\n        }\n\n        .service-card p {\n            color: var(--color-charcoal-light);\n            font-size: 0.95rem;\n            line-height: 1.7;\n            margin-bottom: 1rem;\n            position: relative;\n            z-index: 1;\n        }\n\n        .service-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 0.5rem;\n            color: var(--color-lavender-dark);\n            font-weight: 600;\n            font-size: 0.9rem;\n            position: relative;\n            z-index: 1;\n            transition: all var(--transition-fast);\n        }\n\n        .service-link:hover {\n            gap: 0.75rem;\n            color: var(--color-lavender);\n        }\n\n        .service-link svg {\n            width: 16px;\n            height: 16px;\n        }\n\n        /* ========================================\n           TESTIMONIALS SECTION\n        ======================================== */\n        .testimonials {\n            background: var(--color-cream);\n        }\n\n        .testimonials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n            margin-top: var(--spacing-lg);\n        }\n\n        .testimonial-card {\n            background: white;\n            padding: 2rem;\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-soft);\n            transition: all var(--transition-base);\n        }\n\n        .testimonial-card:hover {\n            transform: translateY(-5px);\n            box-shadow: var(--shadow-floating);\n        }\n\n        .testimonial-stars {\n            display: flex;\n            gap: 0.25rem;\n            margin-bottom: 1rem;\n        }\n\n        .testimonial-stars svg {\n            width: 18px;\n            height: 18px;\n            fill: var(--color-rose-gold);\n        }\n\n        .testimonial-text {\n            font-style: italic;\n            color: var(--color-charcoal-light);\n            line-height: 1.8;\n            margin-bottom: 1.5rem;\n            font-size: 0.95rem;\n        }\n\n        .testimonial-author {\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .testimonial-avatar {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: var(--gradient-lavender);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: 600;\n            color: white;\n            font-size: 1.1rem;\n        }\n\n        .testimonial-info h4 {\n            font-size: 1rem;\n            color: var(--color-charcoal);\n            margin-bottom: 0.25rem;\n        }\n\n        .testimonial-info p {\n            font-size: 0.85rem;\n            color: var(--color-charcoal-light);\n        }\n\n        /* ========================================\n           DIFFERENTIALS SECTION\n        ======================================== */\n        .differentials {\n            background: var(--gradient-twilight);\n        }\n\n        .differentials-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 2rem;\n            margin-top: var(--spacing-lg);\n        }\n\n        .differential-item {\n            text-align: center;\n            padding: 2rem;\n            transition: all var(--transition-base);\n        }\n\n        .differential-icon {\n            width: 80px;\n            height: 80px;\n            margin: 0 auto 1.5rem;\n            background: white;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            box-shadow: var(--shadow-soft);\n            position: relative;\n        }\n\n        .differential-icon::before {\n            content: '';\n            position: absolute;\n            top: -4px;\n            left: -4px;\n            right: -4px;\n            bottom: -4px;\n            border-radius: 50%;\n            background: var(--gradient-lavender);\n            opacity: 0.3;\n            z-index: -1;\n            animation: pulse-ring 2s ease-in-out infinite;\n        }\n\n        @keyframes pulse-ring {\n            0%, 100% {\n                transform: scale(1);\n                opacity: 0.3;\n            }\n            50% {\n                transform: scale(1.1);\n                opacity: 0.1;\n            }\n        }\n\n        .differential-icon svg {\n            width: 35px;\n            height: 35px;\n            color: var(--color-lavender-dark);\n        }\n\n        .differential-item h3 {\n            margin-bottom: 0.75rem;\n            color: var(--color-charcoal);\n        }\n\n        .differential-item p {\n            color: var(--color-charcoal-light);\n            font-size: 0.95rem;\n            line-height: 1.7;\n        }\n\n        /* ========================================\n           CONTACT SECTION\n        ======================================== */\n        .contact {\n            background: var(--color-cream);\n        }\n\n        .contact-container {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4rem;\n            margin-top: var(--spacing-lg);\n        }\n\n        .contact-info h3 {\n            margin-bottom: 1.5rem;\n            color: var(--color-charcoal);\n        }\n\n        .contact-info p {\n            color: var(--color-charcoal-light);\n            margin-bottom: 2rem;\n            line-height: 1.8;\n        }\n\n        .contact-details {\n            display: flex;\n            flex-direction: column;\n            gap: 1.5rem;\n        }\n\n        .contact-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 1rem;\n        }\n\n        .contact-item-icon {\n            width: 50px;\n            height: 50px;\n            background: var(--gradient-lavender);\n            border-radius: var(--radius-md);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n        }\n\n        .contact-item-icon svg {\n            width: 24px;\n            height: 24px;\n            color: white;\n        }\n\n        .contact-item-text h4 {\n            font-size: 1rem;\n            color: var(--color-charcoal);\n            margin-bottom: 0.25rem;\n            font-family: var(--font-body);\n            font-weight: 600;\n        }\n\n        .contact-item-text p {\n            font-size: 0.95rem;\n            color: var(--color-charcoal-light);\n            margin-bottom: 0;\n        }\n\n        .contact-item-text a {\n            color: var(--color-lavender-dark);\n            font-weight: 600;\n        }\n\n        .contact-item-text a:hover {\n            color: var(--color-lavender);\n        }\n\n        .contact-form-wrapper {\n            background: white;\n            padding: 2.5rem;\n            border-radius: var(--radius-lg);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .contact-form h3 {\n            margin-bottom: 1.5rem;\n            color: var(--color-charcoal);\n        }\n\n        .form-group {\n            margin-bottom: 1.5rem;\n        }\n\n        .form-group label {\n            display: block;\n            font-weight: 600;\n            margin-bottom: 0.5rem;\n            color: var(--color-charcoal);\n            font-size: 0.9rem;\n        }\n\n        .form-group input,\n        .form-group select,\n        .form-group textarea {\n            width: 100%;\n            padding: 1rem;\n            border: 2px solid var(--color-cream-dark);\n            border-radius: var(--radius-md);\n            font-family: var(--font-body);\n            font-size: 1rem;\n            color: var(--color-charcoal);\n            transition: all var(--transition-fast);\n            background: var(--color-cream);\n        }\n\n        .form-group input:focus,\n        .form-group select:focus,\n        .form-group textarea:focus {\n            outline: none;\n            border-color: var(--color-lavender);\n            background: white;\n        }\n\n        .form-group textarea {\n            resize: vertical;\n            min-height: 120px;\n        }\n\n        .form-submit {\n            width: 100%;\n            padding: 1rem 2rem;\n            background: var(--color-lavender);\n            color: white;\n            border: none;\n            border-radius: var(--radius-pill);\n            font-size: 1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all var(--transition-fast);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 0.5rem;\n        }\n\n        .form-submit:hover {\n            background: var(--color-lavender-dark);\n            transform: translateY(-2px);\n            box-shadow: var(--shadow-soft);\n        }\n\n        .form-submit svg {\n            width: 18px;\n            height: 18px;\n        }\n\n        /* ========================================\n           FOOTER\n        ======================================== */\n        .footer {\n            background: var(--color-charcoal);\n            color: var(--color-cream);\n            padding: 4rem 2rem 2rem;\n        }\n\n        .footer-container {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .footer-content {\n            display: grid;\n            grid-template-columns: 2fr 1fr 1fr;\n            gap: 4rem;\n            margin-bottom: 3rem;\n        }\n\n        .footer-brand h3 {\n            font-size: 1.5rem;\n            margin-bottom: 1rem;\n            color: white;\n        }\n\n        .footer-brand p {\n            color: rgba(255, 255, 255, 0.7);\n            line-height: 1.8;\n            max-width: 350px;\n        }\n\n        .footer-links h4 {\n            font-family: var(--font-body);\n            font-weight: 600;\n            font-size: 1rem;\n            margin-bottom: 1.5rem;\n            color: white;\n        }\n\n        .footer-links ul {\n            display: flex;\n            flex-direction: column;\n            gap: 0.75rem;\n        }\n\n        .footer-links a {\n            color: rgba(255, 255, 255, 0.7);\n            font-size: 0.95rem;\n            transition: color var(--transition-fast);\n        }\n\n        .footer-links a:hover {\n            color: var(--color-lavender-light);\n        }\n\n        .footer-bottom {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding-top: 2rem;\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n        }\n\n        .footer-bottom p {\n            color: rgba(255, 255, 255, 0.5);\n            font-size: 0.9rem;\n        }\n\n        .footer-social {\n            display: flex;\n            gap: 1rem;\n        }\n\n        .footer-social a {\n            width: 40px;\n            height: 40px;\n            background: rgba(255, 255, 255, 0.1);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: all var(--transition-fast);\n        }\n\n        .footer-social a:hover {\n            background: var(--color-lavender);\n            transform: translateY(-3px);\n        }\n\n        .footer-social svg {\n            width: 18px;\n            height: 18px;\n            color: white;\n        }\n\n        /* ========================================\n           SCROLL ANIMATIONS\n        ======================================== */\n        .wow-fade-up {\n            opacity: 0;\n            transform: translateY(30px);\n            transition: opacity 0.8s ease, transform 0.8s ease;\n        }\n\n        .wow-fade-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        .wow-fade-up[data-delay] {\n            transition-delay: calc(var(--delay) * 1ms);\n        }\n\n        /* ========================================\n           RESPONSIVE DESIGN\n        ======================================== */\n        @media (max-width: 1024px) {\n            .hero-container {\n                grid-template-columns: 1fr;\n                text-align: center;\n            }\n\n            .hero-description {\n                margin-left: auto;\n                margin-right: auto;\n            }\n\n            .hero-ctas {\n                justify-content: center;\n            }\n\n            .hero-image {\n                order: -1;\n            }\n\n            .hero-floating-card.card-1 {\n                left: 0;\n            }\n\n            .hero-floating-card.card-2 {\n                right: 0;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n\n            .contact-container {\n                grid-template-columns: 1fr;\n            }\n\n            .footer-content {\n                grid-template-columns: 1fr;\n                gap: 2rem;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .nav-menu {\n                position: fixed;\n                top: 70px;\n                left: 0;\n                right: 0;\n                flex-direction: column;\n                background: white;\n                padding: 2rem;\n                gap: 1.5rem;\n                transform: translateY(-150%);\n                transition: transform var(--transition-base);\n                box-shadow: var(--shadow-elegant);\n            }\n\n            .nav-menu.active {\n                transform: translateY(0);\n            }\n\n            .mobile-toggle {\n                display: flex;\n            }\n\n            .problem-solution-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .services-grid,\n            .testimonials-grid,\n            .differentials-grid {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .hero-ctas {\n                flex-direction: column;\n            }\n\n            .btn {\n                width: 100%;\n                justify-content: center;\n            }\n\n            .hero-floating-card {\n                display: none;\n            }\n\n            .section {\n                padding: var(--spacing-lg) 1.5rem;\n            }\n        }\n\n        /* ========================================\n           ACCESSIBILITY\n        ======================================== */\n        @media (prefers-reduced-motion: reduce) {\n            *,\n            *::before,\n            *::after {\n                animation-duration: 0.01ms !important;\n                animation-iteration-count: 1 !important;\n                transition-duration: 0.01ms !important;\n            }\n        }\n\n        :focus-visible {\n            outline: 3px solid var(--color-lavender);\n            outline-offset: 2px;\n        }\n    </style>\n</head>\n<body>\n    <!-- Navigation -->\n    <nav class=\"nav\">\n        <div class=\"nav-container\">\n            <a href=\"#\" class=\"nav-logo\">Dra. Amanda Gaipo</a>\n            <div class=\"mobile-toggle\" aria-label=\"Toggle menu\">\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n            <ul class=\"nav-menu\">\n                <li><a href=\"#home\" class=\"nav-link\">Início</a></li>\n                <li><a href=\"#services\" class=\"nav-link\">Tratamentos</a></li>\n                <li><a href=\"#testimonials\" class=\"nav-link\">Depoimentos</a></li>\n                <li><a href=\"#contact\" class=\"nav-cta\">Agendar Consulta</a></li>\n            </ul>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero\" id=\"home\">\n        <div class=\"hero-blobs\">\n            <div class=\"blob blob-1\"></div>\n            <div class=\"blob blob-2\"></div>\n            <div class=\"blob blob-3\"></div>\n            <div class=\"blob blob-4\"></div>\n        </div>\n\n        <div class=\"hero-container\">\n            <div class=\"hero-content\">\n                <div class=\"hero-badge\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                        <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                    </svg>\n                    Harmonização Facial em Ribeirão Preto\n                </div>\n                <h1 class=\"hero-title\">Sua beleza natural, <span>potencializada</span></h1>\n                <p class=\"hero-description\">Transforme sua aparência com tratamentos estéticos personalizados que realçam seus traços naturais. Tecnologia avançada e cuidado humanizado.</p>\n                <div class=\"hero-ctas\">\n                    <a href=\"#contact\" class=\"btn btn-primary\">\n                        Agendar Avaliação\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                    <a href=\"#services\" class=\"btn btn-secondary\">\n                        Conhecer Tratamentos\n                    </a>\n                </div>\n            </div>\n\n            <div class=\"hero-image\">\n                <div class=\"hero-image-wrapper\">\n                    <img src=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=800&q=80\" alt=\"Harmonização Facial - Dra. Amanda Gaipo\">\n                </div>\n\n                <div class=\"hero-floating-card card-1\">\n                    <div class=\"card-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <div class=\"card-text\">\n                        +5.000\n                        <small>Atendimentos Realizados</small>\n                    </div>\n                </div>\n\n                <div class=\"hero-floating-card card-2\">\n                    <div class=\"card-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/>\n                            <polyline points=\"22 4 12 14.01 9 11.01\"/>\n                        </svg>\n                    </div>\n                    <div class=\"card-text\">\n                        98% Satisfação\n                        <small>Clientes Felizes</small>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Problem/Solution Section -->\n    <section class=\"section problem-solution\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Transformação Real</span>\n                <h2 class=\"section-title\">Sua autoestima merece prioridade</h2>\n                <p class=\"section-description\">Entendemos suas preocupações e oferecemos soluções que transformam não apenas sua aparência, mas sua confiança.</p>\n            </div>\n\n            <div class=\"problem-solution-grid\">\n                <div class=\"problem-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"card-icon-header\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            <path d=\"M8 14s1.5 2 4 2 4-2 4-2\"/>\n                            <line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\"/>\n                            <line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\"/>\n                        </svg>\n                    </div>\n                    <h3>O que te incomoda?</h3>\n                    <p>Muitas pessoas enfrentam inseguranças com sua aparência que afetam sua autoestima e bem-estar.</p>\n                    <ul class=\"problem-list\">\n                        <li>\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            </svg>\n                            Perda de contorno facial\n                        </li>\n                        <li>\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            </svg>\n                            Rugas e linhas de expressão\n                        </li>\n                        <li>\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            </svg>\n                            Falta de harmonia nos traços\n                        </li>\n                    </ul>\n                </div>\n\n                <div class=\"solution-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"card-icon-header\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/>\n                            <polyline points=\"22 4 12 14.01 9 11.01\"/>\n                        </svg>\n                    </div>\n                    <h3>Nossa solução para você</h3>\n                    <p>Com tecnologia avançada e abordagem personalizada, realizamos transformações naturais que realçam sua beleza única.</p>\n                    <ul class=\"problem-list\">\n                        <li>\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <polyline points=\"20 6 9 17 4 12\"/>\n                            </svg>\n                            Resultados naturais e harmoniosos\n                        </li>\n                        <li>\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <polyline points=\"20 6 9 17 4 12\"/>\n                            </svg>\n                            Procedimentos seguros e aprovados\n                        </li>\n                        <li>\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <polyline points=\"20 6 9 17 4 12\"/>\n                            </svg>\n                            Acompanhamento personalizado\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section class=\"section services\" id=\"services\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Tratamentos</span>\n                <h2 class=\"section-title\">Procedimentos especializados</h2>\n                <p class=\"section-description\">Oferecemos uma gama completa de tratamentos estéticos faciais com tecnologia de ponta.</p>\n            </div>\n\n            <div class=\"services-grid\">\n                <div class=\"service-card wow-fade-up\" data-delay=\"0\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Harmonização Facial</h3>\n                    <p>Equilíbrio estético dos traços faciais com preenchedores e toxina botulínica para uma aparência natural e harmônica.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"100\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M9 12h6M12 9v6\"/>\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                        </svg>\n                    </div>\n                    <h3>Toxina Botulínica</h3>\n                    <p>Suaviza linhas de expressão e rugas, prevenindo o envelhecimento precoce com resultados naturais.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\"/>\n                        </svg>\n                    </div>\n                    <h3>Preenchedores Faciais</h3>\n                    <p>Restaura volume e contorno facial com ácido hialurônico de alta qualidade para resultados duradouros.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"300\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"/>\n                        </svg>\n                    </div>\n                    <h3>Bioestimuladores</h3>\n                    <p>Estimula o colágeno natural da pele para rejuvenescimento progressivo e duradouro.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Preenchimento Labial</h3>\n                    <p>Realça o contorno e volume dos lábios com técnicas que proporcionam naturalidade e simetria.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n\n                <div class=\"service-card wow-fade-up\" data-delay=\"500\">\n                    <div class=\"service-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Protocolos Exclusivos</h3>\n                    <p>Tratamentos personalizados combinando técnicas avançadas para resultados únicos em cada paciente.</p>\n                    <a href=\"#contact\" class=\"service-link\">\n                        Saiba mais\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M5 12h14M12 5l7 7-7 7\"/>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"section testimonials\" id=\"testimonials\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Depoimentos</span>\n                <h2 class=\"section-title\">O que dizem nossas pacientes</h2>\n                <p class=\"section-description\">Histórias reais de transformação e satisfação com nossos tratamentos.</p>\n            </div>\n\n            <div class=\"testimonials-grid\">\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"0\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"A Dra. Amanda transformou minha autoestima. O resultado da harmonização facial ficou super natural, exatamente como eu queria. Recomendo demais!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">MC</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Marina Costa</h4>\n                            <p>Empresária, 35 anos</p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"200\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"Profissionalismo e carinho em cada atendimento. Fiz preenchimento labial e amei o resultado. A Dra. Amanda entendeu exatamente o que eu queria.\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">JS</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Juliana Silva</h4>\n                            <p>Advogada, 28 anos</p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"testimonial-card wow-fade-up\" data-delay=\"400\">\n                    <div class=\"testimonial-stars\">\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/></svg>\n                        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/></svg>\n                    </div>\n                    <p class=\"testimonial-text\">\"Há muito tempo queria fazer um tratamento estético e encontrei na Dra. Amanda a profissional que eu procurava. Atendimento impecável!\"</p>\n                    <div class=\"testimonial-author\">\n                        <div class=\"testimonial-avatar\">RF</div>\n                        <div class=\"testimonial-info\">\n                            <h4>Renata Ferreira</h4>\n                            <p>Professora, 42 anos</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Differentials Section -->\n    <section class=\"section differentials\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Diferenciais</span>\n                <h2 class=\"section-title\">Por que escolher a Dra. Amanda</h2>\n                <p class=\"section-description\">Compromisso com excelência e resultados que transformam vidas.</p>\n            </div>\n\n            <div class=\"differentials-grid\">\n                <div class=\"differential-item wow-fade-up\" data-delay=\"0\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/>\n                            <polyline points=\"22 4 12 14.01 9 11.01\"/>\n                        </svg>\n                    </div>\n                    <h3>Certificação ANVISA</h3>\n                    <p>Todos os produtos utilizados são certificados e aprovados pela ANVISA, garantindo máxima segurança.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"100\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z\"/>\n                        </svg>\n                    </div>\n                    <h3>Atendimento Personalizado</h3>\n                    <p>Cada paciente é única. Desenvolvemos protocolos exclusivos para suas necessidades específicas.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"200\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n                        </svg>\n                    </div>\n                    <h3>Ambiente Seguro</h3>\n                    <p>Clínica equipada com tecnologia de ponta e todos os protocolos de assepsia e segurança.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"300\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            <polyline points=\"12 6 12 12 16 14\"/>\n                        </svg>\n                    </div>\n                    <h3>Agilidade no Atendimento</h3>\n                    <p>Resposta rápida para agendamentos e dúvidas, sempre pronta para atender você.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"400\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"/>\n                        </svg>\n                    </div>\n                    <h3>Técnicas Avançadas</h3>\n                    <p>Atualização constante com as mais modernas técnicas e procedimentos estéticos faciais.</p>\n                </div>\n\n                <div class=\"differential-item wow-fade-up\" data-delay=\"500\">\n                    <div class=\"differential-icon\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                            <path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/>\n                        </svg>\n                    </div>\n                    <h3>Cuidado Humanizado</h3>\n                    <p>Atendimento acolhedor que valoriza seu bem-estar e conforto durante todo o processo.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section class=\"section contact\" id=\"contact\">\n        <div class=\"section-container\">\n            <div class=\"section-header wow-fade-up\">\n                <span class=\"section-tag\">Contato</span>\n                <h2 class=\"section-title\">Agende sua avaliação</h2>\n                <p class=\"section-description\">Entre em contato e transforme sua aparência com tratamentos personalizados.</p>\n            </div>\n\n            <div class=\"contact-container\">\n                <div class=\"contact-info wow-fade-up\" data-delay=\"0\">\n                    <h3>Informações de Contato</h3>\n                    <p>Estamos prontos para atender você. Agende uma consulta e descubra os melhores tratamentos para sua beleza.</p>\n\n                    <div class=\"contact-details\">\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                    <path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/>\n                                    <circle cx=\"12\" cy=\"10\" r=\"3\"/>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-text\">\n                                <h4>Endereço</h4>\n                                <p>R. Garibaldi, 2042 - Sala - Jardim Sumaré, Ribeirão Preto - SP, 14025-190</p>\n                            </div>\n                        </div>\n\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                    <path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"/>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-text\">\n                                <h4>Telefone / WhatsApp</h4>\n                                <p><a href=\"https://wa.me/5516994563928\" target=\"_blank\">(16) 99456-3928</a></p>\n                            </div>\n                        </div>\n\n                        <div class=\"contact-item\">\n                            <div class=\"contact-item-icon\">\n                                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                    <rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/>\n                                    <path d=\"M10 8h4\"/>\n                                    <path d=\"M10 12h4\"/>\n                                    <path d=\"M10 16h4\"/>\n                                    <path d=\"M6 8h.01\"/>\n                                    <path d=\"M6 12h.01\"/>\n                                    <path d=\"M6 16h.01\"/>\n                                </svg>\n                            </div>\n                            <div class=\"contact-item-text\">\n                                <h4>Horário de Atendimento</h4>\n                                <p>Segunda a Sexta: 9h às 18h</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"contact-form-wrapper wow-fade-up\" data-delay=\"200\">\n                    <form class=\"contact-form\" id=\"contactForm\">\n                        <h3>Envie uma mensagem</h3>\n\n                        <div class=\"form-group\">\n                            <label for=\"name\">Nome Completo</label>\n                            <input type=\"text\" id=\"name\" name=\"name\" required placeholder=\"Seu nome\">\n                        </div>\n\n                        <div class=\"form-group\">\n                            <label for=\"phone\">Telefone / WhatsApp</label>\n                            <input type=\"tel\" id=\"phone\" name=\"phone\" required placeholder=\"(00) 00000-0000\">\n                        </div>\n\n                        <div class=\"form-group\">\n                            <label for=\"service\">Tratamento de Interesse</label>\n                            <select id=\"service\" name=\"service\" required>\n                                <option value=\"\">Selecione uma opção</option>\n                                <option value=\"Harmonização Facial\">Harmonização Facial</option>\n                                <option value=\"Toxina Botulínica\">Toxina Botulínica</option>\n                                <option value=\"Preenchedores Faciais\">Preenchedores Faciais</option>\n                                <option value=\"Bioestimuladores\">Bioestimuladores</option>\n                                <option value=\"Preenchimento Labial\">Preenchimento Labial</option>\n                                <option value=\"Protocolos Exclusivos\">Protocolos Exclusivos</option>\n                                <option value=\"Outro\">Outro</option>\n                            </select>\n                        </div>\n\n                        <div class=\"form-group\">\n                            <label for=\"message\">Mensagem</label>\n                            <textarea id=\"message\" name=\"message\" placeholder=\"Conte-nos sobre suas necessidades...\"></textarea>\n                        </div>\n\n                        <button type=\"submit\" class=\"form-submit\">\n                            Enviar Mensagem\n                            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                                <path d=\"M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z\"/>\n                            </svg>\n                        </button>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"footer\">\n        <div class=\"footer-container\">\n            <div class=\"footer-content\">\n                <div class=\"footer-brand\">\n                    <h3>Dra. Amanda Gaipo</h3>\n                    <p>Transformando vidas através da harmonização facial e estética avançada em Ribeirão Preto.</p>\n                </div>\n\n                <div class=\"footer-links\">\n                    <h4>Tratamentos</h4>\n                    <ul>\n                        <li><a href=\"#services\">Harmonização Facial</a></li>\n                        <li><a href=\"#services\">Toxina Botulínica</a></li>\n                        <li><a href=\"#services\">Preenchedores Faciais</a></li>\n                        <li><a href=\"#services\">Bioestimuladores</a></li>\n                    </ul>\n                </div>\n\n                <div class=\"footer-links\">\n                    <h4>Links Rápidos</h4>\n                    <ul>\n                        <li><a href=\"#home\">Início</a></li>\n                        <li><a href=\"#testimonials\">Depoimentos</a></li>\n                        <li><a href=\"#contact\">Contato</a></li>\n                        <li><a href=\"https://wa.me/5516994563928\">WhatsApp</a></li>\n                    </ul>\n                </div>\n            </div>\n\n            <div class=\"footer-bottom\">\n                <p>&copy; 2024 Dra. Amanda Gaipo. Todos os direitos reservados.</p>\n                <div class=\"footer-social\">\n                    <a href=\"https://wa.me/5516994563928\" aria-label=\"WhatsApp\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                            <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\"/>\n                        </svg>\n                    </a>\n                    <a href=\"https://instagram.com\" aria-label=\"Instagram\">\n                        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                            <path d=\"M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z\"/>\n                        </svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // ========================================\n        // NAVIGATION SCROLL EFFECT\n        // ========================================\n        let lastScroll = 0;\n        const nav = document.querySelector('.nav');\n        const mobileToggle = document.querySelector('.mobile-toggle');\n        const navMenu = document.querySelector('.nav-menu');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n\n            if (currentScroll > 100) {\n                if (currentScroll > lastScroll) {\n                    nav.classList.add('hidden');\n                } else {\n                    nav.classList.remove('hidden');\n                }\n            }\n\n            lastScroll = currentScroll;\n        });\n\n        // Mobile menu toggle\n        mobileToggle.addEventListener('click', () => {\n            navMenu.classList.toggle('active');\n        });\n\n        // Close mobile menu on link click\n        document.querySelectorAll('.nav-link').forEach(link => {\n            link.addEventListener('click', () => {\n                navMenu.classList.remove('active');\n            });\n        });\n\n        // ========================================\n        // SMOOTH SCROLL\n        // ========================================\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function(e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    const navHeight = nav.offsetHeight;\n                    const targetPosition = target.offsetTop - navHeight;\n                    window.scrollTo({\n                        top: targetPosition,\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n\n        // ========================================\n        // INTERSECTION OBSERVER ANIMATIONS\n        // ========================================\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('visible');\n                    observer.unobserve(entry.target);\n                }\n            });\n        }, observerOptions);\n\n        document.querySelectorAll('.wow-fade-up').forEach(el => {\n            el.style.setProperty('--delay', el.dataset.delay || 0);\n            observer.observe(el);\n        });\n\n        // ========================================\n        // CONTACT FORM - WHATSAPP INTEGRATION\n        // ========================================\n        const contactForm = document.getElementById('contactForm');\n\n        contactForm.addEventListener('submit', function(e) {\n            e.preventDefault();\n\n            const formData = new FormData(contactForm);\n            const name = formData.get('name');\n            const phone = formData.get('phone');\n            const service = formData.get('service');\n            const message = formData.get('message');\n\n            const whatsappMessage = `Olá! Meu nome é ${name}.\\n\\nTelefone: ${phone}\\nTratamento de interesse: ${service}\\n\\nMensagem: ${message || 'Gostaria de agendar uma avaliação.'}`;\n\n            const whatsappUrl = `https://wa.me/5516994563928?text=${encodeURIComponent(whatsappMessage)}`;\n\n            window.open(whatsappUrl, '_blank');\n\n            contactForm.reset();\n        });\n\n        // ========================================\n        // PARALLAX MOUSE MOVEMENT ON BLOBS\n        // ========================================\n        const blobs = document.querySelectorAll('.blob');\n\n        document.addEventListener('mousemove', (e) => {\n            const x = (e.clientX / window.innerWidth - 0.5) * 20;\n            const y = (e.clientY / window.innerHeight - 0.5) * 20;\n\n            blobs.forEach((blob, index) => {\n                const factor = (index + 1) * 0.5;\n                blob.style.transform = `translate(${x * factor}px, ${y * factor}px)`;\n            });\n        });\n\n        // ========================================\n        // REDUCED MOTION SUPPORT\n        // ========================================\n        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n            document.querySelectorAll('.wow-fade-up').forEach(el => {\n                el.classList.add('visible');\n            });\n        }\n    </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null}}
